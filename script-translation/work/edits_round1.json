  {"sid": "da0112:T00006", "old": "「잠ㄲ……!」", "new": "「기다……!」", "cat": "글자", "reason": "자모 ㄲ은 CP932에 없어 빌드에서 깨진다. 같은 장 하즈키의 待っ――도 '기다――'"},
  {"sid": "da0112:T00008", "old": "해머로 후려치는 듯한 횡방향의 격풍.", "new": "해머로 후려치는 듯한, 옆에서 몰아치는 격풍.", "cat": "글자·번역투", "reason": "'횡'은 캐리어 표에 없는 음절(blocked). '횡방향의'는 기술 문서투"},
  {"sid": "da0112:T00009", "old": "전부 날려\n버려진다.", "new": "전부 날아가\n버린다.", "cat": "번역투", "reason": "吹き飛ばされる를 '날려 버려진다'로 옮긴 이중 피동"},
  {"sid": "da0112:T00011", "old": "우리도 날려 버려졌다.", "new": "우리도 날아가 버렸다.", "cat": "번역투", "reason": "이중 피동"},
  {"sid": "da0112:T00026", "old": "존재하지 않을 터인 마인.", "new": "존재할 리 없는 마인.", "cat": "번역투", "reason": "はずの를 '~할 터인'으로 직역"},
  {"sid": "da0112:T00061", "old": "폭풍에 날려 버려진다.", "new": "폭풍에 날아가 버린다.", "cat": "번역투", "reason": "이중 피동"},
  {"sid": "da0112:T00063", "old": "전부 집어삼키\n고, 잘게 부순다.", "new": "전부\n집어삼키고, 잘게 부순다.", "cat": "줄바꿈", "reason": "원문 강제 줄바꿈 자리를 그대로 옮겨 '집어삼키/고'로 낱말이 끊긴다"},
  {"sid": "da0112:T00064", "old": "무사히 있을 리가 없다.", "new": "무사할 리가 없다.", "cat": "번역투", "reason": "無事でいられる 직역"},
  {"sid": "da0112:T00068", "old": "혈풍 너머로 눈을 부릅뜬다.", "new": "혈풍 너머를 뚫어지게 바라본다.", "cat": "오역", "reason": "眼を凝らす=눈여겨 살피다. 부릅뜨다는 화가 나 눈을 크게 뜨는 것"},
  {"sid": "da0112:T00070", "old": "그저 폭심지에는, 하나의 작달막한 인영이 있었다.", "new": "다만 폭심지에는, 작달막한 그림자 하나가 있었다.", "cat": "한자어", "reason": "인영(人影)은 印影(도장 자국)으로 읽힌다(사용자 규칙, 페이트 09-19). '하나의'는 번역투"},
  {"sid": "da0112:T00073", "old": "어떻지?", "new": "어떤가?", "cat": "말투", "reason": "슈루즈베리가 하즈키에게 묻는 말. '어떻지?'는 혼잣말처럼 읽힌다"},
  {"sid": "da0112:T00086", "old": "소녀의 옆까지 걸어 다가와,", "new": "소녀의 곁으로 걸어가,", "cat": "번역투", "reason": "화자(쿠로)는 하늘에서 보고 있어 '다가와'는 방향이 틀린다"},
  {"sid": "da0112:T00088", "old": "기분 탓인지 기분 좋아 보이기도 한다.", "new": "어쩐지 기분 좋아 보이지 않는 것도 아니다.", "cat": "뉘앙스", "reason": "心なしか…見えなくもない의 이중 부정이 빠졌고 '기분'이 겹친다"},
