  {"sid": "da0112:T00002", "old": "당돌하게", "new": "느닷없이", "cat": "오역", "reason": "唐突=갑작스러움. 한국어 당돌하다는 '버릇없이 대든다'로 읽힌다(동음이의어 함정)"},
