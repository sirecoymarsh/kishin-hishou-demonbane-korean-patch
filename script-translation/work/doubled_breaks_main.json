[
 {
  "packet": "P0010_da0108",
  "id": "da0108:T00016",
  "side": "앞",
  "jp": "んく……",
  "ko": "\n꿀꺽……"
 },
 {
  "packet": "P0010_da0108",
  "id": "da0108:T00017",
  "side": "앞",
  "jp": "ごくんっ。",
  "ko": "\n꼴깍."
 },
 {
  "packet": "P0025_da0201",
  "id": "da0201:T00015",
  "side": "끝",
  "jp": "「それもあるけど……",
  "ko": "「그것도 있지만……\n　"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00062",
  "side": "끝",
  "jp": "、アズラッド。\n　邪神ズアウィアを冥府に連れ戻す任、",
  "ko": ", 아즈라드.\n　사신 즈아위아를 명부로 도로 데려가는 임무,\n　"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00067",
  "side": "끝",
  "jp": "、",
  "ko": ",\n"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00086",
  "side": "끝",
  "jp": "！？",
  "ko": "!?\n　"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00120",
  "side": "끝",
  "jp": "！\n　　時の歯車",
  "ko": "!\n　　시간의 톱니바퀴\n　　"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00125",
  "side": "끝",
  "jp": "！",
  "ko": "!\n　　"
 },
 {
  "packet": "P0060_da0505",
  "id": "da0505:T00127",
  "side": "끝",
  "jp": "より逃れ得るものはなく",
  "ko": "에게서 벗어날 수 있는 것은 없으며\n　　"
 },
 {
  "packet": "P0061_da0506",
  "id": "da0506:T00100",
  "side": "끝",
  "jp": "「アズラッド！　忌まわしいほどの\n愚者、呪わしいほどの愚物め！\n此処はお前が立てる舞台ではない！",
  "ko": "「아즈라드!　가증스러울 정도의\n어리석은 자, 저주스러울 정도의 우매한 놈 같으니!\n여기는 네놈이 설 수 있는 무대가 아니다!\n"
 },
 {
  "packet": "P0061_da0506",
  "id": "da0506:T00116",
  "side": "끝",
  "jp": "強大な魔力を内包して律動する、全長５０メートルの巨大な",
  "ko": "강대한 마력을 내포하여 율동하는 전장 50미터의 거대한\n"
 },
 {
  "packet": "P0070_da0701",
  "id": "da0701:T00045",
  "side": "끝",
  "jp": "「それは貴公とて同じこと……",
  "ko": "「그건 귀공도 마찬가지……\n"
 },
 {
  "packet": "P0070_da0701",
  "id": "da0701:T00091",
  "side": "끝",
  "jp": "！",
  "ko": "!\n　"
 },
 {
  "packet": "P0070_da0701",
  "id": "da0701:T00130",
  "side": "끝",
  "jp": "。かくも",
  "ko": ". 이토록\n"
 },
 {
  "packet": "P0071_da0701",
  "id": "da0701:T00324",
  "side": "끝",
  "jp": "「ああ……今度はもっとエゲツない",
  "ko": "「그래…… 다음엔 더 지독한\n"
 },
 {
  "packet": "P0072_da0702",
  "id": "da0702:T00027",
  "side": "끝",
  "jp": "「私の夢――",
  "ko": "「제 꿈――\n"
 },
 {
  "packet": "P0072_da0702",
  "id": "da0702:T00073",
  "side": "앞",
  "jp": "ケースの方が稀だろう」",
  "ko": "\n　케이스가 더 드물겠지」"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00047",
  "side": "끝",
  "jp": "。",
  "ko": ".\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00053",
  "side": "끝",
  "jp": "を視る。",
  "ko": "을 본다.\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00057",
  "side": "끝",
  "jp": "の憩いの冷たさに凶夢を紡ぐ。",
  "ko": "한 안식의 차가움에 흉몽을 자아낸다.\n\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00063",
  "side": "끝",
  "jp": "私は歌う。",
  "ko": "\n　\n　나는 노래한다.\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00063",
  "side": "앞",
  "jp": "私は歌う。",
  "ko": "\n　\n　나는 노래한다.\n　"
 },
 {
  "packet": "P0074_da0703",
