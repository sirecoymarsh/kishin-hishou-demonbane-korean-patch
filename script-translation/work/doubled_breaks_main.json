  "jp": "。",
  "ko": ".\n\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00083",
  "side": "앞",
  "jp": "畸形の",
  "ko": "\n　\n　기형의 "
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00085",
  "side": "끝",
  "jp": "は歌う。",
  "ko": "는 노래한다.\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00091",
  "side": "끝",
  "jp": "う。",
  "ko": "한다.\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00094",
  "side": "끝",
  "jp": "。",
  "ko": ".\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00097",
  "side": "끝",
  "jp": "。",
  "ko": ".\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00100",
  "side": "끝",
  "jp": "。",
  "ko": ".\n\n\n\n　\n　\n　"
 },
 {
  "packet": "P0074_da0703",
  "id": "da0703:T00149",
  "side": "앞",
  "jp": "憎悪の瞳。",
  "ko": "\n증오의 눈동자. "
 },
 {
  "packet": "P0075_da0704",
  "id": "da0704:T00005",
  "side": "끝",
  "jp": "がアナザーブラッドに近いというのなら\n……貴方だって、奴の編む悪夢と同質の",
  "ko": "가 어나더 블러드에 가깝다고 한다면\n……당신이야말로 녀석이 엮어 내는 악몽과 동질의\n"
 },
 {
  "packet": "P0075_da0704",
  "id": "da0704:T00009",
  "side": "끝",
  "jp": "「話してもらおう。",
  "ko": "「말해 주어야겠다.\n　"
 },
 {
  "packet": "P0075_da0704",
  "id": "da0704:T00013",
  "side": "끝",
  "jp": "「社交界に出入りするため、",
  "ko": "「사교계에 드나들기 위해\n　"
 },
 {
  "packet": "P0075_da0704",
  "id": "da0704:T00075",
  "side": "끝",
  "jp": "が戦うのは……",
  "ko": "가 싸우는 것은……\n"
 },
 {
  "packet": "P0078_da0706",
  "id": "da0706:T00034",
  "side": "끝",
  "jp": "「私は夢から醒めて、貴方は夢の中に",
  "ko": "「나는 꿈에서 깨어나고, 당신은 꿈속으로\n"
 },
 {
  "packet": "P0079_da0707",
  "id": "da0707:T00014",
  "side": "끝",
  "jp": "とはいえ――",
  "ko": "라고는 하나――\n　"
 },
 {
  "packet": "P0079_da0707",
  "id": "da0707:T00042",
  "side": "끝",
  "jp": "「動いています……機体が動いて……",
  "ko": "「움직이고 있습니다…… 기체가 움직여……\n　"
 },
 {
  "packet": "P0080_da0708",
  "id": "da0708:T00053",
  "side": "끝",
  "jp": "の銃。引き裂かれる鉄鬼の軍勢。",
  "ko": "의 총. 갈기갈기 찢기는 철귀의 군세.\n　"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00029",
  "side": "끝",
  "jp": "！\n　\n　　　時の歯車",
  "ko": "!\n　\n　　　시간의 톱니바퀴\n　　　"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00034",
  "side": "끝",
  "jp": "！",
  "ko": "!\n　\n　　　"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00036",
  "side": "끝",
  "jp": "より逃れ得るものはなく",
  "ko": "에게서 벗어날 수 있는 자는 없으며\n　　　"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00042",
  "side": "끝",
  "jp": "「無窮の空を超え",
  "ko": "「무궁한 하늘을 넘어\n　　　　　"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00061",
  "side": "끝",
  "jp": "「吹き荒め、",
  "ko": "「휘몰아쳐라,\n"
 },
 {
  "packet": "P0081_da0709",
  "id": "da0709:T00066",
  "side": "끝",
  "jp": "「――すぐに第三陣、来ます。",
  "ko": "「――곧바로 제3진, 옵니다.\n　"
 },
 {
  "packet": "P0082_da0709",
  "id": "da0709:T00181",
  "side": "끝",
  "jp": "を一気に翔け昇り、その後ろにデモンベインとアイオーンが続く。",
  "ko": " 단숨에 날아오르고, 그 뒤를 데몬베인과 아이온이 따른다.\n\n　"
 },
 {
  "packet": "P0083_da0710",
  "id": "da0710:T00011",
  "side": "끝",
  "jp": "え立つ。\n\n　その巨体は空間のほとんどを占拠し、機体に落ちる影は不気味に",
  "ko": "아 있다.\n\n　그 거체는 공간의 대부분을 점거하고, 기체에 드리운 그림자는 기분 나쁘게\n"
 },
 {
  "packet": "P0085_da0802",
  "id": "da0802:T00014",
  "side": "끝",
  "jp": "「……無限螺旋の戦いは、\n　我が血にも記されている。\n　だがな、獣よ。",
  "ko": "「……무한나선의 싸움은,\n　내 피에도 기록되어 있다.\n　하지만 말이다, 짐승이여.\n　"
 },
 {
  "packet": "P0085_da0802",
  "id": "da0802:T00052",
  "side": "끝",
  "jp": "「哀しいな。微笑ましいな――",
  "ko": "「슬프구나. 흐뭇하구나――\n　"
 },
 {
  "packet": "P0085_da0802",
  "id": "da0802:T00054",
  "side": "끝",
  "jp": "を謳ったところで、",
  "ko": " 구가한들,\n　"
 },
 {
  "packet": "P0085_da0802",
  "id": "da0802:T00195",
  "side": "끝",
  "jp": "リベル・レギスは覇王の威厳で、討ち取った敵を見下ろし、",
  "ko": "리베르 레기스는 패왕의 위엄으로 쓰러뜨린 적을 내려다보며,\n　"
 },
 {
  "packet": "P0092_da1101",
  "id": "da1101:T00021",
  "side": "끝",
  "jp": "「だが、これで終わる。\n　私の役目は終わりだ。\n　胸がすく気分だ……",
  "ko": "「하지만, 이걸로 끝난다.\n　내 역할은 끝이다.\n　가슴이 뻥 뚫리는 기분이군……\n　"
 },
 {
  "packet": "P0092_da1101",
  "id": "da1101:T00026",
  "side": "끝",
  "jp": "「魔人に……魔人に逢ったのだ。\n　何ものも到達できない高みに立つ、",
  "ko": "「마인을…… 마인을 만났던 거다.\n　그 무엇도 도달할 수 없는 고지에 선,\n　"
 },
 {
  "packet": "P0093_da1102",
  "id": "da1102:T00058",
  "side": "끝",
  "jp": "「――総てはかりそめ。\n　単なる悪夢。\n　ネロも、他のアンチクロスも、",
  "ko": "「――모든 것은 일시적인 것.\n　단순한 악몽.\n　네로도, 다른 안티크로스도,\n　"
 },
 {
  "packet": "P0095_da1201",
  "id": "da1201:T00044",
  "side": "끝",
  "jp": "「貴女は……",
  "ko": "「그대는……\n　"
 },
 {
  "packet": "P0099_da1204",
  "id": "da1204:T00012",
  "side": "끝",
  "jp": "「ようやく姿を現したか……",
  "ko": "「드디어 모습을 드러냈느냐……\n　"
 },
 {
  "packet": "P0102_da1303",
  "id": "da1303:T00033",
  "side": "끝",
  "jp": "』？",
  "ko": "』?\n　　　"
 },
 {
  "packet": "P0102_da1303",
  "id": "da1303:T00075",
  "side": "끝",
  "jp": "「何故です！\n　　　何故、九朔を生んだの！？",
  "ko": "「어째서입니까!\n　　　어째서, 쿠자쿠를 낳은 거야!?\n　　　"
 },
 {
  "packet": "P0103_da1304",
  "id": "da1304:T00070",
  "side": "끝",
  "jp": "「私は……",
  "ko": "「나는……\n"
 },
 {
  "packet": "P0104_da1305",
  "id": "da1305:T00030",
  "side": "끝",
  "jp": "を凌駕したのよ\n　……ははは……あははははっ！",
  "ko": "을 능가한 거야\n　……하하하…… 아하하하핫!\n　"
 },
 {
  "packet": "P0105_da1306",
  "id": "da1306:T00081",
  "side": "끝",
  "jp": "「そう、地獄の饗宴を",
  "ko": "「그래, 지옥의 향연을\n　"
 },
 {
  "packet": "P0106_da1306",
  "id": "da1306:T00204",
  "side": "끝",
  "jp": "「引き裂かれた世界を！　引き裂か\nれた自分を取り戻したければ！",
  "ko": "「찢어발겨진 세계를!　찢어발겨\n진 자신을 되찾고 싶다면!\n"
 }
]