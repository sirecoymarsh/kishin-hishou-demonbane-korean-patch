 "records": [
  {
   "id": "da1309:T00001",
   "source_sha256": "7d0111eb365d9c7dd0621fefcf498819be25efe4e1cb1cbe1aaf141ae4de13d9",
   "ko": "「게임 키퍼?\n　『"
  },
  {
   "id": "da1309:R00001",
   "source_sha256": "2439817fdc41bebdd900d91ce67851acf11816d61e08831bb38a1b7737fff11f",
   "ko": "클록워크 팬텀",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00002",
   "source_sha256": "85c921a16aabaf020cbdd92e81a9bc2d2882c0ca97b04561eb318b4c2d548863",
   "ko": "기계장치의 악몽"
  },
  {
   "id": "da1309:T00003",
   "source_sha256": "8a32357457301d6c7ff2a10d9876c810d1ed6baa9458d0a3a964ada4b95b2571",
   "ko": "』?"
  },
  {
   "id": "da1309:R00002",
   "source_sha256": "a1407e2c31827977a6418a657c59b8db6dc3f0b0c07c2112d37d62847cf8d666",
   "ko": "・・・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00004",
   "source_sha256": "fd7b6e7693a4333ef5399118ad4436914e890e15fbd87c637ae08a1a70697ad4",
   "ko": "나이알라토텝"
  },
  {
   "id": "da1309:T00005",
   "source_sha256": "062a345406a788f4f1ba0555be713fcc7477ace21a879f5ad79be71013968c4f",
   "ko": "?」"
  },
  {
   "id": "da1309:T00006",
   "source_sha256": "8e74e084244d69d2d3b54f33c02588ebe35bad52ae7c5830a35a188481da4f3d",
   "ko": "순식간에 변질되는 데몬베인――아니다, 더 이상 기체에서 느껴지는 기척은, 내가 아는 그것과는 아득히 동떨어져 있다."
  },
  {
   "id": "da1309:R00003",
   "source_sha256": "16f0743d46c22e155e0fc89238475a58824ee7da3dae1b471f1b1b1f7f2e9d07",
   "ko": "콕핏",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00007",
   "source_sha256": "8dc579f738134d3d31e9335b1a315dc0209a159fbbf38881e98c9a5e26d4e552",
   "ko": "조종실"
  },
  {
   "id": "da1309:T00008",
   "source_sha256": "3c912a41e18dd386ce6d2a05b73da567c32356c912a89ff2084f26325c65a42f",
   "ko": "은 모독적인 각도로 일그러지고, 지옥 같은 악의가 공간을\n　가득 채우고 있었다.\n\n　부정한 각도에서 기계/기괴한 부품이 쏟아져 내린다."
  },
  {
   "id": "da1309:T00009",
   "source_sha256": "f2918e0d43715e6d17bbe264e23d945ab28547a1b0cf87ad0530b4eea3404a36",
   "ko": "빗소리처럼 연속되는 금속음."
  },
  {
   "id": "da1309:T00010",
   "source_sha256": "7e9f4cc8a4adb929762c35db589d50f20b1cb8ecc001375ee147f8593bcb1cee",
   "ko": "「――데몬베인이, 아니야?」"
  },
  {
   "id": "da1309:R00004",
   "source_sha256": "e20ae0b446b64ec30726e8cd3cf3f0661ee7d80f0a7aa8e089c9613434decaac",
   "ko": "스크루",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00011",
   "source_sha256": "776829118fcbf5056c6965a578d33822616d43187553ef0981e23c1cbd7c3ee2",
   "ko": "나사"
  },
  {
   "id": "da1309:T00012",
   "source_sha256": "e3b21956ce958d2599e4e122f5395b8bb776552bd4ceae0c6bec80e4f73a2905",
   "ko": "가 "
  },
  {
   "id": "da1309:R00005",
   "source_sha256": "c738df21c0f62894b4fe0566bc7abe856080a066ffc8fee9e2d1fe625aeddc87",
   "ko": "기어",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00013",
   "source_sha256": "8f8342a36522012f82ec786d7442ec1892511d9de750d85de2ca7d922923895f",
   "ko": "톱니바퀴"
  },
  {
   "id": "da1309:T00014",
   "source_sha256": "e3b21956ce958d2599e4e122f5395b8bb776552bd4ceae0c6bec80e4f73a2905",
   "ko": "가 "
  },
  {
   "id": "da1309:R00006",
   "source_sha256": "75430dd194b46b52f04da5b85a52e85be3a4250739da4a0f35faae5f1d6b8751",
   "ko": "스프링",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00015",
   "source_sha256": "dbffa4b690b03437fb91465f2ad9e4e995992bd8a7a47ff3f3c3433077ba0ed5",
   "ko": "태엽"
  },
  {
   "id": "da1309:T00016",
   "source_sha256": "e3b21956ce958d2599e4e122f5395b8bb776552bd4ceae0c6bec80e4f73a2905",
   "ko": "이 "
  },
  {
   "id": "da1309:R00007",
   "source_sha256": "c9bcbe52fdbb15957ee0ef72970854daf3357a9d7e2f874781d23ead0cb89938",
   "ko": "와이어가",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00017",
   "source_sha256": "ae2a9e08aae2d5144d08bab89f7112d50fbde27f3d9771106df8620dd17051c4",
   "ko": "강선이"
  },
  {
   "id": "da1309:T00018",
   "source_sha256": "a2d79cf397ab0a6139dd9f35075272fd08145d6fb46bf90bfe415127e7a92ea9",
   "ko": " 나선을 그리며 "
  },
  {
   "id": "da1309:R00008",
   "source_sha256": "9d5ac61f7b225838033fdf7540506a708124096c71a711cd1e0b33960ac15857",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1309:T00019",
   "source_sha256": "6a42b42f4bd8d19a0cb8fa9a760a513f40012664dd831d2a5164c72041e51550",
   "ko": "빙글빙글"
  },
  {
   "id": "da1309:T00020",
   "source_sha256": "e08b522e002cb4709576707a0513e82f1d20c72b1ca2862de33c5e8355add9ae",
   "ko": " 돌고 돌고 또 돌면서, 맞물리고, 조합되어, 사람 크기만큼 자라났다."
  },
  {
   "id": "da1309:T00021",
   "source_sha256": "fdb96bc2bd418b6d7baee1c55d10db159360ded2434f8c3f87c0b24bb28d8279",
   "ko": "「그래. 나의 사랑스러운 숙적 데몬베인은, 우주에 단 하나뿐인 기체야. 우주에 단 두 사람――다이쥬지 쿠로와 그 아내 알 아지프만을 위한 기체지」"
  },
  {
   "id": "da1309:T00022",
   "source_sha256": "e8e9a91d0e041691b9144f95c61c8efa69c40e6968dd1323349c4df20e8d5acc",
   "ko": "『그것』은, 나를 등 뒤에서 껴안는다."
  },
  {
   "id": "da1309:T00023",
   "source_sha256": "f45c8755caf67a22eb10526cebd30f6421ae81f446ef2ee33d12a33c02d7f9ec",
   "ko": "소름이 끼칠 정도로 차가운 "
  },
  {
   "id": "da1309:R00009",
   "source_sha256": "0a6ca476b9397dadead2fcbb08f22a9c1628bcfe865854fa4b088d747fdc93b8",
   "ko": "몸",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00024",
   "source_sha256": "a96987f5802bb4e65bd76335b4e4fa387dffab3a619b9818add17142899153d6",
   "ko": "신체"
  },
  {
   "id": "da1309:T00025",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da1309:T00026",
   "source_sha256": "acd844e0143990c23319c5202f94c2a9b2812197fda3fde0690470a81cf21ea7",
   "ko": "심장 고동 대신 전해져 오는 것은, "
  },
  {
   "id": "da1309:R00010",
   "source_sha256": "3d8447fc9f9ffa29c91ffe3669ba975c92c5186f24eccd6e31726b075b25a56e",
   "ko": "ＴＩＣＫＴＡＣＫ　ＴＩＣＫＴＡＣＫ",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00027",
   "source_sha256": "61b4089095e57e177d5b5a2ac03c74c55c7944aaca5e9a52dc1d9639b5d15cf5",
   "ko": "기계적인 율동"
  },
  {
   "id": "da1309:T00028",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da1309:T00029",
   "source_sha256": "df2a2adbe358c47fb1678f2aadf07b7184ff438a3d1f19dd41c2f96b0ad5c573",
   "ko": "「그러니 그대의 곁에 있던 건 나야.\n나야말로 그대의 검이자, 그대의 갑옷이다」"
  },
  {
   "id": "da1309:T00030",
   "source_sha256": "5a1418419824ae690d76ddf5719c994fc5784fd6283a2768ea6b8db4cfa49474",
   "ko": "『그것』이, 나를 들여다본다."
  },
  {
   "id": "da1309:T00031",
   "source_sha256": "42b1d18f137d123805e6062927fb5554e3466ff542a38234029445f947f59177",
   "ko": "요염하게 미소 짓는 여자의 얼굴――허나 그 절반에는, 거대한 시계가\n파묻혀 있다.\n\n　여자의 "
  },
  {
   "id": "da1309:R00011",
   "source_sha256": "aba7fcaa3276ecb9099e66e1a19b7863747b1257b52a005f5bab56bebb1074d0",
   "ko": "글라스",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00032",
   "source_sha256": "7321b61b9e53a276599aab32f0830a8007a5c088994983cdbef88e660348e47b",
   "ko": "유리"
  },
  {
   "id": "da1309:T00033",
   "source_sha256": "183f11d7508e1dc6acad3c05448001815a137d967c722b2e87fffcffb49ccca5",
   "ko": " 눈동자에, 내 얼굴이 비치고 있다."
  },
  {
   "id": "da1309:T00034",
   "source_sha256": "e52823c1225b77231e9905d8650ae0fb5ea9cb7f4ce35dde7bb0f335cbcddc60",
   "ko": "초점을 맞추기 위함일까, 동공 깊숙한 곳, 무수한 톱니바퀴가 "
  },
  {
   "id": "da1309:R00012",
   "source_sha256": "dc58041b20d3c746da31941a94e675a3cc7f73a10d01386d131835d0075fab94",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1309:T00035",
   "source_sha256": "963e4f4abf641ba99d8f1cc0fb4e15bb7d510c61ba877a1aca5fddc2551821b9",
   "ko": "분주"
  },
  {
   "id": "da1309:T00036",
   "source_sha256": "d8904a96d0ee7d3d81f687b2243512c08030523c19e87151ed640a6ad1040236",
   "ko": "히 구동하고 있었다.\n\n　아아――"
  },
  {
   "id": "da1309:R00013",
   "source_sha256": "9ea63f9a0a2f922357826c8e28e39c7f3ab7af406c11c4b05f3b7f6e4ed14fd0",
   "ko": "틱톡맨",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00037",
   "source_sha256": "cabca8932be38edb94085b09070cab3d889835576dbd094aa3bdfa97635ad891",
   "ko": "기계장치 인간"
  },
  {
   "id": "da1309:T00038",
   "source_sha256": "8919a55f592c9838df42e08533efb9859448a922d06b109ad6541812a986a7c0",
   "ko": "이다."
  },
  {
   "id": "da1309:T00039",
   "source_sha256": "86c82dacae1e6e71304db13ad469a233dcb14758640f37f03d651eede3175ee2",
   "ko": "「어느 때라도, 나는 그대와 함께였던\n거야…… 아아, 귀엽고 귀여운 나의 기사 나리」"
  },
  {
   "id": "da1309:T00040",
   "source_sha256": "87386800b5a968182b7bbdf788f35da32ef5278968d7fecb20b77ff04d8f06dc",
   "ko": "「――――――――――――」"
  },
  {
   "id": "da1309:T00041",
   "source_sha256": "fe793a1b13686a9f1b24c5bd011997c97d50b1d16f3c06b4982ba1c930dae6af",
   "ko": "이것이 데몬베인이라 믿어 의심치 않았던 것의 정체라 한다면――"
  },
  {
   "id": "da1309:T00042",
   "source_sha256": "5ef5833ca8b14f06687f2f8d314f31f103d4bda171124d9a18b7b666949c4e01",
   "ko": "내 기사도의 종착점이라 한다면――"
  },
  {
   "id": "da1309:T00043",
   "source_sha256": "69575ef80bb9db6927e5dcaa1e195f05086ef4ee8bff826dcbae5dddac6ff32e",
   "ko": "내 싸움의 결말이라 한다면――"
  },
  {
   "id": "da1309:T00044",
   "source_sha256": "d931058a85ba0f53bde64bd7b6572bfd9f1fedf30b1b34ee8a16bdfde74a042c",
   "ko": "「나는………… 나는…… 윽!」"
  },
  {
   "id": "da1309:T00045",
   "source_sha256": "7af8aa76d8572fd6a78b150a5ea3c026132ce9d2a30a4498b3775bf0fbeaad42",
   "ko": "「모든 것은 "
  },
  {
   "id": "da1309:R00014",
   "source_sha256": "fd24608330586093b66f5624f72b03e6a91ae1c1e330bc1c9368e294e4c35880",
   "ko": "게임",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00046",
   "source_sha256": "a608636d6e8d4ba34fe63844c5a3f822b7e39b65f2254f29e1afa5de315ca75e",
   "ko": "장난"
  },
  {
   "id": "da1309:T00047",
   "source_sha256": "b7795c23a4a4a0e5923c9599182e85ab1713c675a124f14968bd5242a67a331a",
   "ko": ". 다이쥬지 쿠자쿠 군――\n　그대 또한, 『운명』이라는 거대한 "
  },
  {
   "id": "da1309:R00015",
   "source_sha256": "088462f65b7e8bc00db9fd7d87cf33cea200daceb9094dea9dc851b2a1851090",
   "ko": "시스템",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00048",
   "source_sha256": "81c946eaa0779951bd08ebc4db804dc22b1d2b834bbe846f1991b279690e015a",
   "ko": "기계"
  },
  {
   "id": "da1309:T00049",
   "source_sha256": "6699b5e826f76f139278bf5c91e9ff83a54073da013062e78b14dda1dd3f7d16",
   "ko": "의,\n　보잘것없는 "
  },
  {
   "id": "da1309:R00016",
   "source_sha256": "5461d30a804ce645d1361f44d672265ede0fb36d3602d183a40c5f12c2418cf1",
   "ko": "파츠",
   "ruby_action": "keep"
  },
  {
   "id": "da1309:T00050",
   "source_sha256": "c8212ffab25e892cdf92a6097c13a297be6199d50cd2b8023b049027741f729f",
   "ko": "부품"
  },
  {
   "id": "da1309:T00051",
   "source_sha256": "393163a4702c1eb2205789c745fa2ff7d3b78af9f6797f94b7a7b3e8f051e6d9",
   "ko": "에 지나지 않아」"
  },
  {
   "id": "da1309:T00052",
   "source_sha256": "c5ed6e4c279486be5b7d2955e2dfc60f0390a1f82d60535982d3ee751739bbb5",
   "ko": "혼돈이, 상냥하게 비웃는다."
  },
  {
   "id": "da1309:T00053",
   "source_sha256": "4e6e123d1bae3a54f453e6acc914336a21f63c7724bb8a62e4ae4a6afee44673",
   "ko": "「그대의 손에는 『마를 끊는 검』\n　　　　　　따윈 쥐어져 있지 않아」"
  },
  {
   "id": "da1309:T00054",
   "source_sha256": "4e00e2dc71c7ac34c9defa9c8b81e804ac175e87c62eadba188bc9364ca5c585",
   "ko": "「아…… 아아…… 아아아아……!」"
  },
  {
   "id": "da1309:T00055",
   "source_sha256": "3c4e0de6a81082ec3c4926705e96b3d8e7ce24ffe19b533ffcfbf93fe668286a",
   "ko": "――피 냄새는, 쇠녹 냄새다."
  },
  {
   "id": "da1309:T00056",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da1309:T00057",
   "source_sha256": "6f5a7484dd365786579426dd446ab03d706bfac485631ebbf875cc3f18528af1",
   "ko": "어?」"
  },
  {
   "id": "da1309:T00058",
   "source_sha256": "a130c6f2b64cf3a1c0233057987ebfca426486e9a195c390997924915aa1d2e9",
   "ko": "붉은 소녀의 "
  },
  {
   "id": "da1309:R00017",
   "source_sha256": "c55de5fb80288ba034b622baadff80a345c30e07ed7752458390d2160a4694df",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1309:T00059",
   "source_sha256": "6ef17337cf2b5d54cc860043d1888f5c658d86115c75f4b5414439c8e81d08f1",
   "ko": "기묘"
  },
  {
   "id": "da1309:T00060",
   "source_sha256": "6f911a02f38e53bf3f0d5132a74e666b00cf3522008f0f5a88888f3a5a4a94e5",
   "ko": "한 움직임."
  },
  {
   "id": "da1309:R00018",
   "source_sha256": "5d5137243694add4bef1c7443cbdff69acd7adcdb88c88ea654130824a16d455",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1309:T00061",
   "source_sha256": "ec1a950dd14354dfd9c35ba8940a011185ee0d170fcf9d8288bd5c511948383d",
   "ko": "태엽"
  },
