  },
  {
   "id": "da0107:T00073",
   "source_sha256": "7e8a222d100dbd6d943b682903cb6698831197df5c365322341ee2d87c0aa72d",
   "ko": "사무라이가 "
  },
  {
   "id": "da0107:R00011",
   "source_sha256": "def18b1f5631a74e05ec0b6234a8e199275e5d1402ba14bd2874890cc7171a98",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0107:T00074",
   "source_sha256": "1cba0068ed2989f2702a73319cb70a68180cd286fc71e9bbc16f00fed91890b4",
   "ko": "내달리"
  },
  {
   "id": "da0107:T00075",
   "source_sha256": "dcc4cf80459b3b35f9a5ee46c3d65f126a83ea3cb9a01676634f7fd159a2945d",
   "ko": "고, 은빛 섬광이 "
  },
  {
   "id": "da0107:R00012",
   "source_sha256": "def18b1f5631a74e05ec0b6234a8e199275e5d1402ba14bd2874890cc7171a98",
