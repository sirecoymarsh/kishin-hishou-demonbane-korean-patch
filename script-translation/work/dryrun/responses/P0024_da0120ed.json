   "ko": " "
  },
  {
   "id": "da0120ed:T00056",
   "source_sha256": "4c6ff2461396974940d832f3f0ce2a7624668028f9bff88ca807b1e9da44a407",
   "ko": "없"
  },
  {
   "id": "da0120ed:T00057",
   "source_sha256": "30decdf4274513937a5295af56ea082925e2c003e616f76156e9dec43f9164c6",
   "ko": "다"
  },
  {
   "id": "da0120ed:T00058",
   "source_sha256": "4c6ff2461396974940d832f3f0ce2a7624668028f9bff88ca807b1e9da44a407",
   "ko": ""
  },
  {
   "id": "da0120ed:T00059",
   "source_sha256": "631157c15452e8cefd925437a26f1d016b1a5d7575f9234fd0bf7aff0369e63d",
   "ko": "!"
  },
  {
   "id": "da0120ed:T00060",
   "source_sha256": "9103fdd09a83e693fa56faa1a9449aed3175e806481ce4119fe22b0df7607916",
   "ko": "엔트리 No.997"
  },
  {
   "id": "da0120ed:T00061",
   "source_sha256": "bc79a50c9367851ccc7fab3aecbd3d4933b08fb89d4c27db1075fe09e4cf0d77",
   "ko": "『그럼 다음으로――옛날이야기를 하지』"
  },
  {
   "id": "da0120ed:T00062",
   "source_sha256": "9df46da3bc525c01223a9dc711f42b7611177ef81799eb63225609354f6ef745",
   "ko": "머나먼, 머나먼, 옛날."
  },
  {
   "id": "da0120ed:T00063",
   "source_sha256": "357d002da0f394688cb1419f20176d91bcb478edb57c2b3d46e0e6e61015915c",
   "ko": "아득히 먼 옛날의 이야기."
  },
  {
   "id": "da0120ed:T00064",
   "source_sha256": "707ce02dfdf20182f01cfc481a3aa387a6373b7c0f04d66887a1b1200a9330f7",
   "ko": "최초의 인간이 태어나기보다도,\n　더욱 전의 이야기입니다."
  },
  {
   "id": "da0120ed:R00001",
   "source_sha256": "9e01e7b843be92a9d32129c0661107e163b54042ac97ad03fcafa75e40d331b6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0120ed:T00065",
   "source_sha256": "389bbac1b256d36df12ea23e0ea5db3f3b5a4242c671c915091732e62596b8b4",
   "ko": "어두"
  },
  {
   "id": "da0120ed:T00066",
   "source_sha256": "e4beb6013eb68a55b35eb090c1b543f0b8deef3bc20960c52c88c1e001542908",
   "ko": "운 어두운 별들 너머에서, 막 태어난 지구에 『그레이트 올드 원』이라 불리는 나쁜 신님들이 찾아왔습니다.\n\n　나쁜 신님들은 제멋대로 날뛰며 지구에 살아가는 모두를 괴롭혔습니다.\n\n　모두 모두, 울었습니다."
  },
  {
   "id": "da0120ed:T00067",
   "source_sha256": "0297c916ba68d7a861921954c6ac9cc08b4de445eab9ef977872e5bba0fbd874",
   "ko": "지구도, 아프다 아프다며 울었습니다.\n\n　하지만 그때, 하늘이 빛났습니다."
  },
  {
   "id": "da0120ed:T00068",
   "source_sha256": "1f2f7adb0478665cd3f7d6b2c8624ca4f2d687d9896ffbcab08da462cd08a196",
   "ko": "누구나가, 하늘을 올려다보았습니다."
  },
  {
   "id": "da0120ed:T00069",
   "source_sha256": "8d87ea0da3d1ea65fd7486c33c5c88150cde80a4144632924a439a703a62a59a",
   "ko": "그리고, 누구나가 그것을 보았습니다.\n\n　――착한 신님이, 내려오신 것입니다."
  },
  {
   "id": "da0120ed:T00070",
   "source_sha256": "4db4ff158b7e47f48fc9b90643e374718702a140a0f6e036e398c9058e48bcb8",
   "ko": "「설마――이런 세계에까지 찾아올 줄이야」"
  },
  {
   "id": "da0120ed:T00071",
   "source_sha256": "b264279292ea07d851020aded552521105bd5940450b8dd08b25157ba9747ff1",
   "ko": "「인간으로서 싸우고, 끝까지 싸워 내어, 인간을 넘어, 인간을 버리고, 마침내 신의 영역에 도달했는가!　사악을 토벌해 멸하기 위해, 나와 같은 "
  },
  {
   "id": "da0120ed:R00002",
   "source_sha256": "c83d09288a91cba65388da926999234b69ebe4c1dad3efd7cf413e48f4bdd85e",
   "ko": "것이",
   "ruby_action": "keep"
  },
  {
   "id": "da0120ed:T00072",
   "source_sha256": "4a558371f938b01d790207375865ed101b0826bdbda2e46b552b7910337d527a",
   "ko": "존재가"
  },
  {
   "id": "da0120ed:T00073",
   "source_sha256": "38d691c0dd1c6747942f20f2c3573664323bbba034a7db5b60bc99faebefe34b",
   "ko": " 되었는가!」"
  },
  {
   "id": "da0120ed:T00074",
   "source_sha256": "a9b501c207511d60230a98c10189fa5319b8afc41261b9fe51d0efb7c54218e4",
   "ko": "「같은 부류로 취급하지 말라는 것이다아!」"
  },
  {
   "id": "da0120ed:T00075",
   "source_sha256": "936d711f91592a1102bd2129779cea5acad7f58e3f3138bc1366d96797e8f311",
   "ko": "「동류 취급당하다니 엄청 불쾌해로보!」"
  },
  {
   "id": "da0120ed:T00076",
   "source_sha256": "fa9708ccdefe4c79d23776ae6ae590d520c1dff5d96bd3c804889a70b7e824f9",
   "ko": "그것은 찰나의 사랑을 자아내어, 영원의 시간을 계속해서 새기는――"
  },
  {
   "id": "da0120ed:T00077",
   "source_sha256": "68db3de332a9c9a3c3a1fae1ddf35730b62434993d6ccc4465a406889e9d117a",
   "ko": "생명의 노래."
  },
  {
   "id": "da0120ed:T00078",
   "source_sha256": "5ee262eaa897cc4dead1a497f320e4f4a3d367888238f8a82ec0f54f398a149c",
   "ko": "「orz」"
  }
 ],
