 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0120ed:T00001",
   "source_sha256": "f13f43037f5d3772eee61f26d064e714a1640d5371dae78e1baa5062f517cef7",
   "ko": "「……어째서?」"
  },
  {
   "id": "da0120ed:T00002",
   "source_sha256": "cac5b5c49666d8908b966c85b5b04283ac3c968575642507850a68cedf264629",
   "ko": "「…………………………………………」"
  },
  {
   "id": "da0120ed:T00003",
   "source_sha256": "b197b0daa4d0c32bef135d32ebdd926ffc28b4aed1a093e48c69682fb7705d6a",
   "ko": "「본인은…… "
  },
  {
   "id": "da0120ed:T00004",
   "source_sha256": "3c5324e26ee4eec709911635897d7f99db090818c1fea9c323e02b6521a79f04",
   "ko": "이겼다앗!」"
  },
  {
   "id": "da0120ed:T00005",
   "source_sha256": "ca550b04b92f9d4ccdb25fc6ae6e04a306f79b3820abaf151a2747d0186bf7f7",
   "ko": "「이걸로 아컴 시티도 평화로워질 거예요로보」"
  },
  {
   "id": "da0120ed:T00006",
   "source_sha256": "22da307eb8c14a181da0d678a702a36ef9b57f2130a4bdd56b4a3f1fb7c89887",
   "ko": "그런가?"
  },
  {
   "id": "da0120ed:T00007",
   "source_sha256": "4248d5b53406a83cb29878ad5a5c28b6e9411fd7c6df984c2e92814b10877201",
   "ko": "「하지만 어째서일까나…… 본인의 가슴에는 메마른 바람만이 스쳐 지나가 버리는군……」"
  },
  {
   "id": "da0120ed:T00008",
   "source_sha256": "05f36fe5df2ded809d0c7b93e9fc2855c201be9970df01996935b88224fe94de",
   "ko": "「싸움은 허무해요로보……」"
  },
  {
   "id": "da0120ed:T00009",
   "source_sha256": "2a7948265b3843030ca3ad7fc4eb9c4d302dede3fd5f83e82267aa5bf216f653",
   "ko": "「동감이다」"
  },
  {
   "id": "da0120ed:T00010",
   "source_sha256": "bd445d3907953efd2f7442ad17385c637033ebf41a0c466e746faa7299b90ca4",
   "ko": "「어이…… 이거, 어떻게 마무리 지을 생각이냐?」"
  },
  {
   "id": "da0120ed:T00011",
   "source_sha256": "221bafaa58c6156d45bf0f8cacc97e27c8f084d2ce1f4009befd9c215b92e92b",
   "ko": "「상정 외의 사태가 발생하였으므로, 이 이후의 전개는 준비되어 있지 않습니다」"
  },
  {
   "id": "da0120ed:T00012",
   "source_sha256": "57a1c224815429417ce93281814f58156db0762ab48324f392e85766649d448a",
   "ko": "「『납득할 수 없어!』라며 분노하시는 고객님께서는, 다음 중에서 마음에 드시는 엔딩을 자유롭게 선택해 주십시오」"
  },
  {
   "id": "da0120ed:T00013",
   "source_sha256": "0087f15ba304f31c27bbe1ee67f897f89db17bdc9f8c07078129022267c7ff6c",
   "ko": "엔트리 No.001"
  },
  {
   "id": "da0120ed:T00014",
   "source_sha256": "6d031ec1ff555fae0ce3287cd8bab323da13a9a1eb892415ab4c16305bf64f57",
   "ko": "『싸움은 지금부터다』」"
  },
  {
   "id": "da0120ed:T00015",
   "source_sha256": "0a284f1aa26b9bf9f7d28cb2a499d5642ff6c2588a85a1c29c38e8f8cc6628b0",
   "ko": "「후하하하!　지구의 로봇도 제법 하는구나!」"
  },
  {
   "id": "da0120ed:T00016",
   "source_sha256": "6b4b8df36e39deb34d0a37881b89ed953fcb16ed19f7a19fd908ff8e2924881e",
   "ko": "「허나 네놈이 쓰러뜨린 어나더 블러드는, "
  },
  {
   "id": "da0120ed:T00017",
   "source_sha256": "2b820ed43e12c8a7de55dda07468d1f41aebc4ce75e8f72aa0b241caf854c543",
   "ko": "우리 그류=보 512걸 중에서 가장 말석!」"
  },
  {
   "id": "da0120ed:T00018",
   "source_sha256": "1d58cf301acb2520b3cb981bce7b5302f1be9fee5098d0eee3567d584ed5f1e1",
   "ko": "「흥, 재미있군!　엘자아아앗!」"
  },
  {
   "id": "da0120ed:T00019",
   "source_sha256": "5726c8210173b2017b1ba5f7e1c0a0471f1fce0119a649d1e2203de86db63bc5",
   "ko": "「무적로보, 가라아아아아――――앗!」"
  },
  {
   "id": "da0120ed:T00020",
   "source_sha256": "25076572c6ac16120a2003e08925f22a1ba39845b7082111cbd292104b57ed2a",
   "ko": "차기작을 기대해 주십시오"
  },
  {
   "id": "da0120ed:T00021",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0120ed:T00022",
   "source_sha256": "deba42ff6e878290b04dfaa399e94b594dcd5898c6194a0a13b2b944d4a59595",
   "ko": "엔트리 No.002"
  },
  {
   "id": "da0120ed:T00023",
   "source_sha256": "794c619fdf0898efcb21909180736ebef6101f32aa4bf7519eaa03cae31b11cb",
   "ko": "『푸른 하늘에 죽은 동료의 미소』"
  },
  {
   "id": "da0120ed:T00024",
   "source_sha256": "d99f5ea0c3a0f1a72cbaefbc92d2f94f345d139a2869460371f282850e1f338b",
   "ko": "「박사니임~!\n　빨리 안 오시면 두고 갈 거예요로보~!」"
  },
  {
   "id": "da0120ed:T00025",
   "source_sha256": "d047621109675c9d7fda7726729097a23ad4a5078865710b6735617415f9243c",
   "ko": "「이런이런. 못 말리는 녀석인 것이다, 엘자는」"
  },
  {
   "id": "da0120ed:T00026",
   "source_sha256": "4b1c632ab9233118c127d10897238b747dd46f79fc7228d55bcaa0d86ecf514d",
   "ko": "……웨스트."
  },
  {
   "id": "da0120ed:T00027",
   "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
   "ko": "「……?」"
  },
  {
   "id": "da0120ed:T00028",
   "source_sha256": "e029689ed238b81f39729622403fc0c4039a535366f596304c37605692423209",
   "ko": "「지금, 행복하니……?」"
  },
  {
   "id": "da0120ed:T00029",
   "source_sha256": "427222411758cc5ff9a1bb37b05f81a9b8af0ce334f79ce46d917be80bea3897",
   "ko": "「……그래. 고맙다」"
  },
  {
   "id": "da0120ed:T00030",
   "source_sha256": "6676a8d47be7346760ef413773d8358b1ccfea76893aae963ac4030c26112d62",
   "ko": "엔트리 No.003"
  },
  {
   "id": "da0120ed:T00031",
   "source_sha256": "dc4457d5c3df4ccf3c9a08c60d303584ee4395a29225923e9da9be99afb5a8fd",
   "ko": "『범인은 이 안에』"
  },
  {
   "id": "da0120ed:T00032",
   "source_sha256": "4da13029056721f1e7c910067088f28b5bd29eebde3dcc008f0131abf468779e",
   "ko": "「당신이――――"
  },
  {
   "id": "da0120ed:T00033",
   "source_sha256": "0cc618414df772f38f09aef4274a6bb68ff5be903102033be76e547bb3e2aa81",
   "ko": "거미였군요」"
  },
  {
   "id": "da0120ed:T00034",
   "source_sha256": "d3d88064ecac471cf7389f6d02609c1f09db41d16d342552254a6c4e4c22dcf2",
   "ko": "엔트리 No.004"
  },
  {
   "id": "da0120ed:T00035",
   "source_sha256": "e7ffb8334345acc74cc1a3d3c53bb10505fdd602b03acc7180ec2c4f5dca7994",
   "ko": "『나보다 강한 녀석』"
  },
  {
   "id": "da0120ed:T00036",
   "source_sha256": "598e6dcaa5412a9a01369924c121424766175e88108d3a5fd0416bff8527af96",
   "ko": "자"
  },
  {
