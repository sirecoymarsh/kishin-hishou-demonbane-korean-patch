  },
  {
   "id": "da0706:T00026",
   "source_sha256": "0701766f9f6a28cb16c32259f563726f56a62fe830d3521c0f1e16b6c10dbc7e",
   "ko": "의 대지가 잉태한 악덕의 새끼. 나의 거성 『몽환심모』!」"
  },
  {
   "id": "da0706:T00027",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0706:R00005",
