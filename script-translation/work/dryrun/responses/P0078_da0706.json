  },
  {
   "id": "da0706:T00024",
   "source_sha256": "6dad0f0d26f542f8b8377069e9a4a9de16f1ad06e463d26a09203c0e40dc0915",
   "ko": "「그렇다. 제13봉쇄구획――"
  },
  {
   "id": "da0706:R00004",
   "source_sha256": "c9a7c0235f42f3659b176afc5f7fa0c647bca09fc817958d5b056908031deda4",
