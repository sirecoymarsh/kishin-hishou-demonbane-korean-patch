  },
  {
   "id": "da0706:T00010",
   "source_sha256": "659e44e61f5408e0ed58fa5222bad6e12b953d86c755da50383c3d0801df586c",
   "ko": "「상황 보고를!」"
  },
  {
   "id": "da0706:T00011",
   "source_sha256": "1bc904e76e519ab9916299f5406f1a845181d6cb7da7de4c2b83d2ee3984e94b",
