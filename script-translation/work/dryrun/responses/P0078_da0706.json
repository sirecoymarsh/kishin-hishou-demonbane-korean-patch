  },
  {
   "id": "da0706:T00034",
   "source_sha256": "6ff4b9034ef995e784f79a96523cee6370a984b02e99f6b1b46b1040776cfc73",
   "ko": "「나는 꿈에서 깨어나고, 당신은 꿈속으로\n"
  },
  {
   "id": "da0706:R00007",
   "source_sha256": "5ce426b6de4a813cd536f08c6a98b89f7bcf8b3b4d229635ff4f2bf72b33b168",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0706:T00035",
   "source_sha256": "74b930da18eaf23c2624cec6b2cf29e87c614a35ecaefdaa79c9591a4a2d2f03",
   "ko": "가라앉"
  },
  {
   "id": "da0706:T00036",
   "source_sha256": "9476b5f412a5406a208c35ca2118a5be8656845f96f1c50c54c1adfd011347da",
   "ko": "는다…… "
  },
  {
   "id": "da0706:R00008",
   "source_sha256": "1faeea9164c2e7a57c83767dcc254b24d839725123a3f2d5302bd8536ba1dc67",
