   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0706:T00018",
   "source_sha256": "5cb53e3de202ecbb3e7fd1e3903cb9bc748413ba5caaf013960008b13708f3f5",
   "ko": "알고"
  },
  {
   "id": "da0706:T00019",
   "source_sha256": "35a32ad8b001f3ff485efb1756fcf36efa35162e22d3477ab9e3c57e0579da38",
   "ko": " 있습니다. 적에게 마스터 테리온이 있는 이상, 다음에 둘 수는 『그것』이겠지요……」"
  },
  {
   "id": "da0706:T00020",
   "source_sha256": "97db5816219338f6ce78d408a8ef7e5a16df1066a85dbabe0de99e05782cab22",
   "ko": "「아가씨?」"
  },
  {
   "id": "da0706:T00021",
   "source_sha256": "8b24400db0f962237e0948d403ea7a0c068b340632e92c66156b088e84f2fd26",
   "ko": "「프로비던스……\n　제13봉쇄구획!\n　그리고――!」"
  },
  {
   "id": "da0706:T00022",
   "source_sha256": "eed35010e99fd483e84e0a97d8a64bfe4f7ae9a37500b182f119e5e63f94baa9",
   "ko": "「후후…… 아하……\n　아하하하하하하하하하하!」"
  },
  {
   "id": "da0706:T00023",
   "source_sha256": "6b90bb1b021499174d26b0871638552da070bbd02d6569211df58fe88e075058",
