  },
  {
   "id": "da1312:T00070",
   "source_sha256": "c9e1fb5d681dc95b426a19de03154aa959811322fcf7399843a75581e06137ef",
   "ko": "모든 게 다앗!"
  },
  {
   "id": "da1312:T00071",
   "source_sha256": "4b31753f0cfc5ee8ac29833eee8bf1cfd5fca26fe946e4c6927629b4e9c187e2",
