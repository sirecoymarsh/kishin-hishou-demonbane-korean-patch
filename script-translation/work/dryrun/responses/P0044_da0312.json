  },
  {
   "id": "da0312:T00045",
   "source_sha256": "d93a835d0f2787bcb1a759ad3a1b8fbea56d742d0b99720dbbb9ea8ace1926f8",
   "ko": "」"
  },
  {
   "id": "da0312:T00046",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0312:T00047",
   "source_sha256": "caad4a6c2fa955856370d3a596c80185db0a4eb8c77bf48c62aa4b95b8bbf5dc",
   "ko": "「소인은 "
  },
  {
   "id": "da0312:R00012",
   "source_sha256": "77fd935ee4e6a1af2813b0b154be40757a670d53e8654ebdb2d80ae130b7c9db",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0312:T00048",
   "source_sha256": "10c3914c94c2916c10fbd0e5d348b538c7287c4b6df7b618eaa3aa72eb8bc5be",
   "ko": "환영"
  },
  {
   "id": "da0312:T00049",
   "source_sha256": "2e1d8f1c58cb44c5356e2d8263664096709c28261716098fb0e8a0e49a319c74",
   "ko": ".\n　얕은 잠에서 꾸는, "
  },
  {
   "id": "da0312:R00013",
   "source_sha256": "0ddf26e15a8e302369cbcdd4561d27b91dcc4bc0381b7f31c55c0b09690da480",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0312:T00050",
   "source_sha256": "321ca02cc0eb929e5495d15de5d318d620fcf3ba2f1db0424e5656b329aad2d0",
   "ko": "어렴풋"
  },
  {
   "id": "da0312:T00051",
   "source_sha256": "15f4f2e35a39b325a23380f5f107a45371c1aa4fb93dc94452bae18e5f759a2d",
   "ko": "한 악몽에 불과하다."
  },
  {
   "id": "da0312:R00014",
   "source_sha256": "e5dd0ac3e3845fde3cffa0ca9d4642ea87f644c3dbd97d94002e5e0f1f63f2b7",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0312:T00052",
   "source_sha256": "bb64d4269bf7d8f1a9febb76cd9719b545134fd2bf425398571f2bc6f9c560de",
   "ko": "구애"
  },
  {
   "id": "da0312:T00053",
   "source_sha256": "6bf46eee5e8574a03ec7c7a03b25f26242737c520436adddb2260fde4e6a7701",
   "ko": "될 가치도 없을 터」"
  },
  {
   "id": "da0312:T00054",
   "source_sha256": "b299820a89a2d0dfbb24f906104fc9551e50e3205f9c18cbab2186df1b9a721d",
   "ko": "검은 사무라이의 투기가 차갑고 날카롭게 벼려져 간다."
  },
  {
   "id": "da0312:T00055",
   "source_sha256": "8656b40abfb967a9e6952a312de686870df17c7412005d2b49a4f6bc8ccf4705",
   "ko": "그것을 감지한 윈필드 또한 신경을 곤두세운다."
  },
  {
   "id": "da0312:T00056",
   "source_sha256": "a79e0bebca59b8d2a7b4ed7e8ca09e540231d9b666d62bba7033136f3ae3485e",
   "ko": "「이 싸움은 단순한 소인의 망집이다.\n　그대는 "
  },
  {
   "id": "da0312:R00015",
   "source_sha256": "8e12c34b9b825eddd448ccfe7885259e5440f86dd4afde7e1a9cd32cde82a2cd",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0312:T00057",
   "source_sha256": "173abd3287a3210f75e1cd3bbf4e75e69dd2e284674f737bfebd85bcb947fb4a",
   "ko": "우연히"
  },
  {
   "id": "da0312:T00058",
   "source_sha256": "7fdd8e33430a23690a588fa6f819feeea2fdad247a47d0e4572c25cbd80ed95e",
   "ko": ", 귀신에게 씌었을 뿐이지.\n　그렇다면 퇴마하는 것이 도리 아니겠느냐?」"
  },
  {
   "id": "da0312:T00059",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0312:R00016",
   "source_sha256": "98068fa109a8390208faa1d8f05ddfe43f4d08842728bea8e5e623d810b2ff46",
   "ko": "엑소시즘은",
   "ruby_action": "keep"
  },
  {
   "id": "da0312:T00060",
   "source_sha256": "f7d1bcd16c5a9d1d9b013a5fbc65e3ace571bb00ef8e9dcf2bebda9e961f56a2",
   "ko": "악마 퇴치는"
  },
  {
   "id": "da0312:T00061",
   "source_sha256": "356c51024302ee20df58461bf1e852f251fe95a1f379963c962df375d9c0a406",
   "ko": " 전문 분야가 아닙니다만」"
  },
  {
   "id": "da0312:T00062",
   "source_sha256": "a9244d46baaf5046c83881015d0e1cb94fc9dcbb68c07ccde703091448bccac3",
   "ko": "「뭘, 소인을 퇴마하는 데 염불은 필요 없다」"
  },
  {
   "id": "da0312:T00063",
   "source_sha256": "d00272dc459487c5209f2a99ce8e5eb374090a29e8e78e541a8b330491f598d5",
   "ko": "네 자루의 칼이 요사스럽게 번뜩인다."
  },
  {
   "id": "da0312:T00064",
   "source_sha256": "e5f1fc03378f7dce91510f77daa8d12b3f559f4966ef578465f85a5314f92fa2",
   "ko": "고조되는 양자의 투기는 최고조에 달해 있었다."
  },
  {
   "id": "da0312:T00065",
   "source_sha256": "ec21f497a67d6eac918df20c43d3117eaf79bee178078e82367016784f8a4829",
   "ko": "대기를 일그러뜨릴 정도의 "
  },
  {
   "id": "da0312:R00017",
   "source_sha256": "649bb9c4a591f1c70ac131662dfbe0387d5f8e8ca9ac3fa20f710e647b423101",
   "ko": "프레셔가",
   "ruby_action": "keep"
  },
  {
   "id": "da0312:T00066",
   "source_sha256": "171935884234fcdeee622f9ac6df7ac78b272127fed72306344399612879d6f2",
   "ko": "압박감이"
  },
  {
   "id": "da0312:T00067",
   "source_sha256": "025010fd74e93b7834703138c27c5f7e5dc4912cb0aba2c21972a40aa06739a2",
   "ko": " 홀을 뒤흔든다.\n\n　사무라이는 처참한 미소를 띠며 고했다."
  },
  {
   "id": "da0312:T00068",
   "source_sha256": "b5822896ae89672c1106ac87e8cd7b14a8985d19e806346759b35a498d2ee071",
   "ko": "「――그 주먹만 있으면 충분하다」"
  },
  {
   "id": "da0312:T00069",
   "source_sha256": "834886a3c42698453ffab40e21ed552f7687da9bd2c839a19a3c7abccbf1ec27",
   "ko": "대홀의 천장."
  },
  {
   "id": "da0312:T00070",
   "source_sha256": "ea0c838bd4ced059e95792c9d4dabf4aa07ff0c51ea360fe43ca6c906c8b0e29",
   "ko": "무수히 늘어선 거대한 진공관 중 하나에 걸터앉은 소녀의 모습이 있었다."
  },
  {
   "id": "da0312:T00071",
   "source_sha256": "b2b1ff6beab6515342acb5976d23855d37d4884cc15108b98155fd1e6d7dc1e5",
   "ko": "마치 떼를 쓰는 어린아이처럼 볼을 부풀리고 다리를 대롱거리고 있다."
  },
  {
   "id": "da0312:T00072",
   "source_sha256": "e2784fd5838f76c23e7e547c3428660d47cf8b71e7f1eecddf48bb998aaa38b0",
   "ko": "「……이상하네에?\n　이런 "
  },
  {
   "id": "da0312:R00018",
   "source_sha256": "6d5b720e33c28985b30772273c5598340b67f9e1edf99fba720d7c80fa9140cf",
   "ko": "시추에이션이",
   "ruby_action": "keep"
  },
  {
   "id": "da0312:T00073",
   "source_sha256": "ccd4ff23f93b9172ac0e9ff9289dea95b649b2b3c646f496b50d5d956a45f6a7",
   "ko": "전개가"
  },
  {
   "id": "da0312:T00074",
   "source_sha256": "137cbdbced692ca178a11840ed4b3991f0a3549116903757643a02d71b4a5b72",
   "ko": " 될 리가 없는데\n　말이야. 어딘가 잘못된 걸까?」"
  },
  {
   "id": "da0312:T00075",
   "source_sha256": "f4deade4fcdc82ce704a25e039be32c7c0cd91321b788b910e0e15ccd9533112",
   "ko": "검지를 머리에 콕 대고 귀엽게 고개를 갸웃한다."
  },
  {
   "id": "da0312:T00076",
   "source_sha256": "058fc2689ac2d0bce616a1e8adce5ff90426b6c53b72758f47112f53591fdcd6",
   "ko": "심각한 듯이 눈살을 찌푸리면서,"
  },
  {
   "id": "da0312:T00077",
   "source_sha256": "51715aa3508ad461a5c6f25d97dedc4ce1108c061448e3c2c5675623aea04bb1",
   "ko": "「내가 만드는 이야기가\n　이렇게 긍정적일 리가 없는데.\n　어쩐지…… 시시하네에」"
  },
  {
   "id": "da0312:T00078",
   "source_sha256": "e8aabde45c656f87fa367cd5b05d9d5e37300605f9fb31cd2c682fd88794b028",
   "ko": "하지만 아무리 흐뭇해 보이는 동작도, 그 진홍빛 눈동자에 깃든 탁한 증오를 속이지는 못한다.\n\n　피와 어둠과 죽음과 눈물과 진흙과 꿈과 피와 피와 피와 피와 피와…… 그런 것들이 결정화된, "
  },
  {
   "id": "da0312:R00019",
   "source_sha256": "a14f9355ff5bc703aa175f8a795fc49676901e44794150841f01dd2067dea8c3",
   "ko": "루비",
   "ruby_action": "keep"
  },
  {
   "id": "da0312:T00079",
   "source_sha256": "1bf5b451af8d5132a4d70302a00a2529edad253128ff6f3438f9f64b2cb9fca8",
   "ko": "홍옥"
  },
  {
   "id": "da0312:T00080",
   "source_sha256": "712e10bae3b0c225a9e85bb92f4999fed39f42ca1618811c95894172db2b691f",
   "ko": "의 눈동자다."
  },
  {
   "id": "da0312:T00081",
   "source_sha256": "b5611984cc6a1a0eec7ce99b0a5322bde1e10e12ef1fff8460e8044db6ab1f2b",
   "ko": "「조금 각본에 손을 봐 줄까나?　……응?」"
  },
  {
   "id": "da0312:T00082",
   "source_sha256": "1f319a27c5557590576228dad5412d6ef3e551740a596a69ea2278f178cd872a",
   "ko": "그녀의 의식은 이곳과는 다른 어딘가, 또 다른 악몽에서 일어난 일을 지각한다.\n\n　소녀의 얼굴에서 표정이 사라졌다."
  },
  {
   "id": "da0312:R00020",
   "source_sha256": "9e01e7b843be92a9d32129c0661107e163b54042ac97ad03fcafa75e40d331b6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0312:T00083",
   "source_sha256": "389bbac1b256d36df12ea23e0ea5db3f3b5a4242c671c915091732e62596b8b4",
   "ko": "어둡"
  },
  {
   "id": "da0312:T00084",
   "source_sha256": "9a755ee52573cae8b67f368cc3bf1739cbdf36fa8f07cedbf7d28abb554d6ca5",
   "ko": "고 차가운 목소리가 중얼거림이 되어 흘러나온다."
  },
  {
   "id": "da0312:T00085",
   "source_sha256": "50880df2f9ba533f9d2cd8aa0102d43b59399c11512fb67f897c1549c641bfcf",
   "ko": "「어째서야…… 내가 아닌 무언가의\n　의지가 개재해 있는 거지?」"
  }
 ],
