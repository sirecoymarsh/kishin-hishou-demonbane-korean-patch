{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0079_da0707",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0707:T00001",
   "source_sha256": "5c4cecfe1012db1997883e60fc3e9f67f26c19a20549725d486f9d793b4411b7",
   "ko": "『몽환심모』.\n\n　대도사 마스터 테리온이 이끄는 마술결사 『블랙 롯지』가 보유했던 이동요새."
  },
  {
   "id": "da0707:T00002",
   "source_sha256": "42b7d5601cbff6f2ccab5b3504d2d4abd6bcfcccc59865625965195a1819160a",
   "ko": "『C 계획』의 『"
  },
  {
   "id": "da0707:R00001",
   "source_sha256": "fece1cffa1ca45cb7ca80a78e9d9ac221a2075c1ea86f82268c95e37a169169b",
   "ko": "요리시로",
   "ruby_action": "keep"
  },
  {
   "id": "da0707:T00003",
   "source_sha256": "4899debed4d399648568e43a03ae48aed47608f12ab096ea869aebfb2385f2dc",
   "ko": "빙의성"
  },
  {
   "id": "da0707:T00004",
   "source_sha256": "87d0dc2d06ce9f2fb243b819b6bb18a2c6a9393f548487e1c848434d022209b1",
   "ko": "』의 역할로 전 세계를 위기로 몰아넣었던 "
  },
  {
   "id": "da0707:R00002",
   "source_sha256": "6b162ebe1479d9948e20b7e5676742f793055a997a77039feff89c52683e01ce",
   "ko": "판데모니움",
   "ruby_action": "keep"
  },
  {
   "id": "da0707:T00005",
   "source_sha256": "df9e401346d8fb9a46d9cfa3f652d67f4ba733f9362c808a6c4cde888bbe73af",
   "ko": "만마전"
  },
  {
   "id": "da0707:T00006",
   "source_sha256": "498757f0bf1908d8fdd96a61288a489aa0350b280dd89d58ac04ac078ee88014",
   "ko": ".\n\n　아니나 다를까, 지독한 걸 들고나왔군."
  },
  {
   "id": "da0707:T00007",
   "source_sha256": "69cc087f155f3201ee02147b2fc70f72c933d3ec6cfa982b7e06f698dab2de08",
   "ko": "……확실히 우리의 결전장으로는 더할 나위 없다."
  },
  {
   "id": "da0707:T00008",
   "source_sha256": "8005ec13afe3d94fee5200cafabac3d92071641d43e2a7fa27c64d97b2cebd47",
   "ko": "저쪽의 배려가 멋지게 최악이로군."
  },
  {
   "id": "da0707:T00009",
   "source_sha256": "b90514da59b349333fa3304af9f041bc7bf31277d904ee89bda102b66d74e8f5",
   "ko": "「어쩔래?」"
  },
  {
   "id": "da0707:T00010",
   "source_sha256": "50bda1c4b557941150c1cfecdb22cb423b99a20b8125930ba7b0fe029b61edec",
   "ko": "「대답하지 않아도 알고 있을 텐데」"
  },
  {
   "id": "da0707:T00011",
   "source_sha256": "125b176e9e0fe65db0dc2bbe6b1b0812e49324fabbb72cc09e576222d3ebf00f",
   "ko": "「그렇지」"
  },
  {
   "id": "da0707:T00012",
   "source_sha256": "01f1a5f6cdbcefea38a4f42be2e96a82d085442d309e01a6bce259c6db8037ab",
   "ko": "「악몽의 "
  },
  {
   "id": "da0707:R00003",
   "source_sha256": "f8d4263107526a6037f8eaf26a2922e4e0f36a6fe1ae4abf3480d01e870fb498",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0707:T00013",
   "source_sha256": "8edbfa2625f43270711bf553c1e97d8b2a95d2a5a5518999af9269ae0bb06fe3",
   "ko": "잔재"
  },
  {
   "id": "da0707:T00014",
   "source_sha256": "c6f5c87680a6c9aa494b70c632d1dcb6c059126c9b15e5575390c7948cc8834c",
   "ko": "라고는 하나――\n　"
  },
  {
   "id": "da0707:R00004",
   "source_sha256": "55182b9a0c3ba864efcc436b3a80a42c1c30eb394ebbf213e198186c0242632b",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0707:T00015",
   "source_sha256": "d9862f2ecc561d5000e760f104da194809f1a9564ea4bd50cdc137dbf7c2cb50",
   "ko": "결착"
  },
  {
   "id": "da0707:T00016",
   "source_sha256": "8148d536f3106b1b2ef8085f7a142662610e7a289ea32cf6e3dda1d145425cb3",
   "ko": "을 내는 수밖에 없지」"
  },
  {
   "id": "da0707:T00017",
   "source_sha256": "bfeb6ab4b965a2275ed885bd9e485559ccf07593e967258b257934777da056ff",
   "ko": "「이런이런」"
  },
  {
   "id": "da0707:T00018",
   "source_sha256": "73c3d74c9669427cb4a67f5269bb71448a4ce69d9302aa6e126861f0394f0cea",
   "ko": "저 검은 달의 내부, "
  },
  {
   "id": "da0707:R00005",
   "source_sha256": "69d20a5f2ac72ee6fadf915df7a44e0d4c2b741d968c34abbc16277e6d6ec76d",
   "ko": "마스터 테리온",
   "ruby_action": "keep"
  },
  {
   "id": "da0707:T00019",
   "source_sha256": "56b2223aaf4de97073bcfb5650e39766eefbf06951e111b339a556860bb4d37e",
   "ko": "짐승의 악몽"
  },
  {
   "id": "da0707:T00020",
   "source_sha256": "bc206d3a74d63833a97d2ddd6e7d2fd7ec7b9aee8c6772a7e353c1dabf34f890",
   "ko": "이 기다리고 있다."
  },
  {
   "id": "da0707:T00021",
   "source_sha256": "3f57d1c3670b37c81c8d3e8a0518b6d24382cf0b8470805c8b97627368560f68",
   "ko": "그리고 아마도 남은 안티크로스 "
  },
  {
   "id": "da0707:R00006",
   "source_sha256": "eb1e752b5cb2c59ba624693f66a74da2bcaee7e87e29652a13a1d8f830a2ed1a",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0707:T00022",
   "source_sha256": "76e547a8fa546381d67f4089ff5ee2b14ce6bae739dfb716c0446e86f4892242",
   "ko": "놈들"
  },
  {
   "id": "da0707:T00023",
   "source_sha256": "7111aaa6ff2eb58f8f6d274319910b65dc9a232382282e9e2990442a46d7e847",
   "ko": "도."
  },
  {
   "id": "da0707:T00024",
   "source_sha256": "ad4bd9f29dbd4321bd6a418588fe494e8115630864bd539fbdea043192caad9b",
   "ko": "인과율마저도 넘어 다시금 『블랙 롯지』의 광기가 세계를 침식하려 하고 있다.\n\n　게다가――『블랙 롯지』뿐만이 아니다."
  },
  {
   "id": "da0707:T00025",
   "source_sha256": "87cb613139c8c68b58c39ea56c7ea300aca277ade6fc548b757b61c1fc03e368",
   "ko": "마스터 테리온도 안티크로스도 진짜 적이 아니다."
  },
  {
   "id": "da0707:R00007",
   "source_sha256": "f58c026c179665797b00157bf4ac8d76bb0bc4ae666609165f837f7ff7226785",
   "ko": "어나더 블러드",
   "ruby_action": "keep"
  },
  {
   "id": "da0707:T00026",
   "source_sha256": "7f6b199037a2f7c9e8fa96219aed8e77e926db19befc9a5a59c0a274e34d0130",
   "ko": "피의 괴이"
  },
  {
   "id": "da0707:T00027",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0707:T00028",
   "source_sha256": "4eb8c20a6b88ce629015a2a862b64e6dee7d2557cc936aca9b6d907d5ebe7224",
   "ko": "『네크로노미콘 혈액언어판』――그 실체는 막연하여 아직도\n정체를 다 파악하지 못했다.\n\n　하지만 녀석은 알을 "
  },
  {
   "id": "da0707:R00008",
   "source_sha256": "e1e4fdf46c99c92eeb0d356d98b3041bf3bdcfa843aadb25103a4aeadfbb7e3f",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0707:T00029",
   "source_sha256": "1a126907bed9700d5245d4e6380e29c1a85606348ddd3dcd1c0e23596d746337",
   "ko": "함락시키"
  },
  {
   "id": "da0707:T00030",
   "source_sha256": "b3ca69d62a9ed6d0a566820555d4184dada1317ace2e783d517e3a9b52326cb1",
   "ko": "기 위해 세계 하나를 만들어 내 버릴 정도로, 그렇게나 무서운 적인 것이다.\n\n　진홍의 소녀――그녀의 광기 또한 지독히 깊다."
  },
  {
   "id": "da0707:T00031",
   "source_sha256": "a48da6b5f0e1386ba2c3d37f144b7ef19000adf327e7f8816dddc8842c115569",
   "ko": "「정말이지…… 성가신 일투성이야」\n\n　마음의 여유도, 시간의 유예도 없다."
  },
  {
   "id": "da0707:T00032",
   "source_sha256": "37fad26fced478b0b20c3c0d9e4dfa2225fa0a4369195e9509a88f34141b1cb2",
   "ko": "적은 만만치 않고, "
  },
  {
   "id": "da0707:R00009",
   "source_sha256": "e044a46d6095b6710697e40f22b82795ab29b4a1f1b64275c79b6d78b01db222",
   "ko": "바이러스는",
   "ruby_action": "keep"
  },
  {
   "id": "da0707:T00033",
   "source_sha256": "c2b013367cbab340866f1fc909d7b4c15b6c55db2362222139e7f639d6dea615",
   "ko": "술식은"
  },
  {
   "id": "da0707:T00034",
   "source_sha256": "7aeaa65b7f98ae528f287d1b65f64a6535c5273dec6b35b746666537a5bd5383",
   "ko": " 착실하게 알을 침식하고 있다.\n\n　하지만 그렇다 해도――우리에게도 데몬베인이 있다."
  },
  {
   "id": "da0707:T00035",
   "source_sha256": "69c04044491e127143e17b23ab84a2b3a5ddff4923f9c03874c38adb6512a19c",
   "ko": "데몬베인이 있는 한, 우리는 지지 않――"
  },
  {
   "id": "da0707:T00036",
   "source_sha256": "0cf7aa1ae8e4fbec49c8f157817ef54f831d263df2754203c58b5c94930bc1da",
   "ko": "「테케리・리~잇」"
  },
  {
   "id": "da0707:T00037",
   "source_sha256": "4c2581f29570a3486c491904267fbb8ed080fd0b1da59381220b2f4302a0e75b",
   "ko": "「……던세이니? 왜 저렇게 허둥대는 거야, 저 녀석?」"
  },
  {
   "id": "da0707:T00038",
   "source_sha256": "a12a56951786f06a09b1c20559c45984168f352a4a018283558f58c177ac352d",
   "ko": "「이봐라, 던세이니!\n　어디를 싸돌아다니고……」"
  },
  {
   "id": "da0707:T00039",
   "source_sha256": "872172e497c6a4ebfa196d84bb1d01a930e24a44b03b46e45858dfa4b84d213d",
   "ko": "「으와앗!?」"
  },
  {
   "id": "da0707:T00040",
   "source_sha256": "2b80ae9c8e1de7ae9d691b0d3016f4a8c125fe6845ea455ef96f48ee70ff79b6",
   "ko": "「~~~~윽! 이번엔 또 뭐냐!?」"
  },
  {
   "id": "da0707:T00041",
   "source_sha256": "594196769dc4ae8b6931599148a1e09abdb51350fa283a33dab4197c8189d218",
   "ko": "「아와와와와와왓!?」"
  },
  {
   "id": "da0707:T00042",
   "source_sha256": "0593d8806152595ff3c197ddd9363ad6183141c87919963d66691d711ebac05b",
   "ko": "「움직이고 있습니다…… 기체가 움직여……\n　"
  },
  {
   "id": "da0707:T00043",
   "source_sha256": "4635727ee5ebcbd104eb979b6586c1731c591443564b684292808af8b9fed557",
   "ko": "구갸아아아아아!」"
  },
  {
   "id": "da0707:T00044",
   "source_sha256": "39e2f84191b11b2002441a4865b55dfcf97577b50a7d7ca70471e054c1d4a2af",
   "ko": "「앗, 밟혔다 로보」"
  },
  {
   "id": "da0707:T00045",
   "source_sha256": "ed1a7dcefa81ced5f90f3a2a3a01972ad8a289be8f2c2cffdaa31745a4a9f6b4",
   "ko": "「뭐, 뭐뭐뭐뭐뭣!」"
  },
  {
   "id": "da0707:T00046",
   "source_sha256": "8fb3d003883b5f3cc6eaa2716d04f13ff1cc7580f7f2967993113185f4892f9e",
   "ko": "「테케리・리~!」"
  },
  {
   "id": "da0707:T00047",
   "source_sha256": "97119b526329ff05ae9f84442eb28f499f5f43868937c98b6cf9d38a260bca12",
   "ko": "정비 중인 2대의 데몬베인."
  },
  {
   "id": "da0707:T00048",
   "source_sha256": "f99923d6d32430004396a9b48e553665953308b78b1c1256fea7df9698d4f45e",
   "ko": "그중 한 대인 투 소드가 저 혼자 움직이기 시작했다."
  },
  {
   "id": "da0707:T00049",
   "source_sha256": "2a5c44ce793926302f45e41d39a7702af1bec6eeb294d1b74f76814d5f22c588",
   "ko": "토이 리애니메이터의 작업 로봇들이 후드득 털려 떨어진다."
  },
  {
   "id": "da0707:T00050",
   "source_sha256": "42f7b448ed116a988b0d20e5ff49fb4b4b2446b1a3938c89dcf30a27c7545786",
   "ko": "거대한 마력 반응."
  },
  {
   "id": "da0707:T00051",
   "source_sha256": "83a62ec22e7ab31103304b779e1ef700278349554fd435a7cdde73421b6ce4ef",
   "ko": "빛의 입자가 D 투 소드의 주위에 모여 이윽고 결정화했다."
  },
  {
   "id": "da0707:T00052",
   "source_sha256": "010d753407de73a63bd1e92a9dc4cb9af4250ea829ae1e2b2f5a16c5efe588ab",
   "ko": "샨타크."
  },
  {
   "id": "da0707:T00053",
   "source_sha256": "5fc0a2afda05e5b26935fa62157e1ea093a486f4d2b2a70acbd729cc682a4814",
   "ko": "마력은 더욱 증폭되어, 기신의 날개가 눈부시게 빛나기 시작한다――"
  },
  {
   "id": "da0707:T00054",
   "source_sha256": "204f54c9e16faab8b04a5e0847a788b3072532c771b93618cf4490a6c6703152",
   "ko": "「어이, 어이! 이런 곳에서……!」"
  },
  {
   "id": "da0707:T00055",
   "source_sha256": "e7899a4ef8bc2f8ba5ddccd138380c8440aad5e02ea4f06ccde0016dccbc4cec",
   "ko": "「크윽……!」"
  },
  {
   "id": "da0707:T00056",
   "source_sha256": "1fda99e35c4384e981341c1ede8764b72061726cd6ea93183d653313d2793d1f",
   "ko": "「테케리・리~~~~~~잇!」"
  },
  {
   "id": "da0707:T00057",
   "source_sha256": "c3611d6569d88a1d80fe2a0e17511f43ea7313ff17bd327712b99e3396b10c98",
   "ko": "……폭풍을 선물로 남기고, D 투 소드는 통로 저편으로 날아가 버렸다."
  },
  {
   "id": "da0707:T00058",
   "source_sha256": "582ae74c72aebb1dc6341ca5cda7ff82e9b2a8626b6247118d06c1c9c09e5dc5",
   "ko": "남겨진 것은 엉망진창으로 어질러진 격납고뿐이다."
  },
  {
   "id": "da0707:T00059",
   "source_sha256": "c01ae39f5f1123b85027945c12029d78d58bc2ae39c46a0a1a721f0bb66f39a5",
   "ko": "「오…… 오오오…… 우구오……」"
  },
  {
   "id": "da0707:T00060",
   "source_sha256": "d3bf30b019b766c52c57dcec2901a0178baecc3ff09e74e822b0c252f19ebf42",
   "ko": "「아아, 박사님이 알맞게\n　구워졌다 로보옷!」"
  },
  {
   "id": "da0707:T00061",
   "source_sha256": "11a27e3b9a032b8c74291147e111173f387337e68d2135d3a0afdab86e723a14",
   "ko": "「겉은 바삭. 속은 육즙 가득. 그런 본인에게 감동한 석가는, 본인의 혼을 달로 데려가 떡방아 찧기 강제노동을 강요했다」"
  },
  {
   "id": "da0707:T00062",
   "source_sha256": "b328edaa1374113ce949e9bbef0ec7299ae71c6c9b7631e1e7d2b99d582b42c2",
   "ko": "「징그러!?」"
  },
  {
   "id": "da0707:T00063",
   "source_sha256": "27e12568e0d622623c288e64afa1478e24550bf5835cfecc244196178b3c692e",
   "ko": "「어째서 투 소드가!? ……설마!」"
  },
  {
   "id": "da0707:T00064",
   "source_sha256": "bc52aa30b5f09e249738d9272bcb722ebee0f1297f3ec1a4be0ba220f0c2818b",
   "ko": "「테케리・릿, "
  },
  {
   "id": "da0707:T00065",
   "source_sha256": "71b8ad1af2137bf075a1d9b36deb0ab765b659e88b47b325d5f0c386303b1973",
   "ko": "테케리・릿」"
  },
  {
   "id": "da0707:T00066",
   "source_sha256": "2f56e329dfd7b9f67ab995dad2e5697e98376ba09dfc65c15ce44a1326d99bee",
   "ko": "「그 애송이……!」"
  },
  {
   "id": "da0707:T00067",
   "source_sha256": "2ac028e81bd78fdfaf5a5a536e4e21bb0c79aebfad856c850ac7f1787f0c5110",
   "ko": "「――오라!\n　나의 검, 데몬베인!」"
  },
  {
