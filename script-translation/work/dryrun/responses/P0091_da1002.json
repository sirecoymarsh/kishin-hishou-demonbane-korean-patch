{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0091_da1002",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da1002:T00001",
   "source_sha256": "9697f42a7c0ce50fc18c3926522485cfffe34bd8da1709f323428bf3eb018041",
   "ko": "「함정을 빠져나왔어, 대디」"
  },
  {
   "id": "da1002:T00002",
   "source_sha256": "1f4267ed581fe1e910f05a7eb645683455c53c81d835e42d12e6fbac07e1cf3a",
   "ko": "「그래…… 여기가 요새 내부인가」"
  },
  {
   "id": "da1002:T00003",
   "source_sha256": "593065b10b17ba0376f24e1c9abc83b013528ef6be1063cb64ef8a23ea3813a2",
   "ko": "「일행과 떨어져 버렸는데, "
  },
  {
   "id": "da1002:R00001",
   "source_sha256": "684471df0e2585c6114f1c1f0698a2a4c483042f6f3e07d9d801fde1ee5c153e",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1002:T00004",
   "source_sha256": "e5a97ce83e3d67251ae2903533dc35b393ff016c01f586030d725f5c75fc107f",
   "ko": "쿠로"
  },
  {
   "id": "da1002:T00005",
   "source_sha256": "ed95e99a008fc5c7d56bd8362676e0edb10c4a999315b1892bc3a1bda1d229b4",
   "ko": "네는 괜찮을까?」"
  },
  {
   "id": "da1002:T00006",
   "source_sha256": "a1e561e3fa63f188b9d2ed04e0317cf0067b6b7250982bb08dc094b44d348015",
   "ko": "「이 정도 잔재주로 어떻게 할 수 있을 만큼 만만한 아이가 아니란다, 그 녀석은」"
  },
  {
   "id": "da1002:T00007",
   "source_sha256": "7150fe44ece6d34bce785bd1e2fe03e04b170742789ef171ab3eeade9fcabaca",
   "ko": "「뭐, 그렇긴 하겠지만」"
  },
  {
   "id": "da1002:T00008",
   "source_sha256": "a941440a4c93f3e3eba281f7c08a0f67d8ab582c09e5a966d918d7e0782da385",
   "ko": "「그래, 그렇고말고――"
  },
  {
   "id": "da1002:T00009",
   "source_sha256": "20d06552a04f23024c969fe0b7718c6361e81ceb20e798338edff04d3fe3f510",
   "ko": "특히, 자네들은 뼈저리게 느끼고\n　있지 않은가?」"
  },
  {
   "id": "da1002:T00010",
   "source_sha256": "b6a0145ffe360a1a39692c0508dbfc37fc7c10561c202ae32a42f8b639f6b1b5",
   "ko": "「하하하하하하하하하……」"
  },
  {
   "id": "da1002:T00011",
   "source_sha256": "f7303b5b0d192be789677fb3f0db6c1ff61233f832961d02b380e15e02749ffa",
   "ko": "「음. 눈치채고 계셨던가, 눈치를 채셨던가. 참으로 짓궂으십니다, 심술궂으시군요, 박사」"
  },
  {
   "id": "da1002:T00012",
   "source_sha256": "b4a9a1a35d90be2865a7354bfb9bae2cad3ff8355637824eaf413664ab6d44d7",
   "ko": "「그 목소리――그때 다이쥬지 군을\n　습격했던 마술사로군?」"
  },
  {
   "id": "da1002:T00013",
   "source_sha256": "123aa82bf3e664144bba3624c66cf65409385307241b5aa7c17cc64bb5e2585a",
   "ko": "「……살아 있었나 보네」"
  },
  {
   "id": "da1002:T00014",
   "source_sha256": "79de7422adf36c0e5aff44e065ed97e09945f20ca609d96e6b6213bea7173db6",
   "ko": "「호오?　저를 기억하고 계셨습니까. 기쁩니다, 기쁘군요」"
  },
  {
   "id": "da1002:T00015",
   "source_sha256": "61ef4270d799122b5ed17ab7bff8b97495b2ab004af5d3fc8a8376a85bef4632",
   "ko": "「눈이 보이지 않는 만큼 귀와 기억력이\n좋아서 말이지. 자네도 안티크로스인가 뭔가\n하는 자겠지?」"
  },
  {
   "id": "da1002:T00016",
   "source_sha256": "8ae0356957ab7f99fa7b637b75b4e564c9055cc6eb65e075e12ec075143148a9",
   "ko": "「그렇습니다. 저는 안티크로스의 일원, 베스파시아누스. 그리고 이것이\n저의 "
  },
  {
   "id": "da1002:R00002",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나",
   "ruby_action": "keep"
  },
  {
   "id": "da1002:T00017",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신"
  },
  {
   "id": "da1002:T00018",
   "source_sha256": "c891b0ba3da0c23fad66799e3c93b22b14d8560fc7bc12864bf92880fd7895f0",
   "ko": " 사이크라노쉬!」"
  },
  {
   "id": "da1002:T00019",
   "source_sha256": "4e95eb75029c707e5507141529312f3b40ae1190e9afc1e4ade00492a379bc2a",
   "ko": "「만나 뵙게 되어 대단히, 대단히 영광입니다. 영광이고말고요, 라반 슈루즈베리 박사. 앞으로 잘 부탁드립니다」"
  },
  {
   "id": "da1002:T00020",
   "source_sha256": "b90c382e69d3551edd38cc4780e823098b70af19aa97181af8aadbf0660dfaea",
   "ko": "「이런이런.\n　나도 유명해진 모양이군」"
  },
  {
   "id": "da1002:T00021",
   "source_sha256": "27246be85c73636e5833cc77500c01db1c6bcc5a9737318bc76d8505a90e684e",
   "ko": "「달갑지 않은 것들만\n　꼬여들지만 말이야」"
  },
  {
   "id": "da1002:T00022",
   "source_sha256": "ca84bb96d1d080febde566659338ce9f3e8976a278e75dbf0131af4106c97177",
   "ko": "「하하하하. 자자, 그리 말하지 말고 아가씨. 이 늙은이의 시간 죽이기에 조금만 어울려 주게나 어울려 주시겠지요, "
  },
  {
   "id": "da1002:R00003",
   "source_sha256": "fc7a2ce19f2f22c73d96050ccf13cf56e55efd840beca4175a6c8c61cb3da4f2",
   "ko": "프로페서",
   "ruby_action": "keep"
  },
  {
   "id": "da1002:T00023",
   "source_sha256": "456e01f9206141b93706e19df0e064f793e66046e737446dcb6aab1c73fe149e",
   "ko": "교수"
  },
  {
   "id": "da1002:T00024",
   "source_sha256": "062a345406a788f4f1ba0555be713fcc7477ace21a879f5ad79be71013968c4f",
   "ko": "님?」"
  },
  {
   "id": "da1002:T00025",
   "source_sha256": "d8b21f82d44bab4d2584bf2ec79dd3090f3946e2fe691861dc744b78f025e615",
   "ko": "「세라에노의 지식을 부리는 대현자!\n　에테르의 바다를 넘는 초인!\n　라반 슈루즈베리와 한 판 둘 수 있다니\n　이 무슨 행운!　이 무슨 "
  },
  {
   "id": "da1002:R00004",
   "source_sha256": "a771fc038aea4613327c94b0b78f4420fd0a324e49ec0b2892485fb671fb7981",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1002:T00026",
   "source_sha256": "49612ef689158d07a0083ec25be071fcff3e8003e4c0e03645922f7ce095ed2d",
   "ko": "요행"
  },
  {
   "id": "da1002:T00027",
   "source_sha256": "6560fad1b5299ec45c7562b1e825f123c87101dc289a1eb71426e443d34f4c8c",
   "ko": "!」"
  },
  {
   "id": "da1002:T00028",
   "source_sha256": "946a864cb10d876fdf27c1e52fd497175202d99d3f4747a96d074ee2fa0955cf",
   "ko": "「자, 논합시다!　서로 논해 봅시다!\n　토론을!　유의미하고도 불모한 "
  },
  {
   "id": "da1002:R00005",
   "source_sha256": "ef4dfe44e1ef04b81c1011452a93af40fbaab9c63e77fd17875a1351a626c2ca",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1002:T00029",
   "source_sha256": "c91666e8aa378274b8b88c30e492ebfc96aa14cbeed7f992fda0dd7fa260b586",
   "ko": "투론"
  },
  {
   "id": "da1002:T00030",
   "source_sha256": "e00d2bd0b1e45242185a20ecc48202b21e26c82248005ce318b5741408b1fb61",
   "ko": "을!」"
  },
  {
   "id": "da1002:T00031",
   "source_sha256": "e9a345e6088747622239db50655ccfdaeff2beeae2df25d06cf6c8024d411c61",
   "ko": "「아아, 좋다, 어울려 주지.\n하지만 너무 시간을 내어 줄 수는\n없다네?　이래 봬도 바쁜 몸이라서 말이지」"
  },
  {
   "id": "da1002:T00032",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da1002:R00006",
   "source_sha256": "dd02e66eac2ba900c883ba17a07657660d82c94330bc9250c20a944e7ea39d78",
   "ko": "미드 세트",
   "ruby_action": "keep"
  },
  {
   "id": "da1002:T00033",
   "source_sha256": "3fae506d4f2b1be384ce16976b2a09ca6d2d116e1f8a98d532c9cf71a32eda4a",
   "ko": "전투 준비 완료"
  },
  {
   "id": "da1002:T00034",
   "source_sha256": "527f73ca912b77c8dd4d91262d2819ddc10a5a47f0b31e5ffcb5165537fa98e5",
   "ko": "――"
  },
  {
   "id": "da1002:R00007",
   "source_sha256": "5e5df6f4e8dd777244bc731098988f53306c3741ff115f999d934bf223371736",
   "ko": "듀얼",
   "ruby_action": "keep"
  },
  {
   "id": "da1002:T00035",
   "source_sha256": "51272a3a0ea2d3d824d6616fd3d2217ca7db6d801f9af50a3d0247ec1e41a37b",
   "ko": "승부"
  },
  {
   "id": "da1002:T00036",
   "source_sha256": "6560fad1b5299ec45c7562b1e825f123c87101dc289a1eb71426e443d34f4c8c",
   "ko": "!」"
  }
 ],
