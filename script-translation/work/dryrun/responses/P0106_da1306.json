   "ruby_action": "keep"
  },
  {
   "id": "da1306:T00200",
   "source_sha256": "d1825b7d8bb851a3ea9f9d9e9b2c8b5c1333ee85d0eb29920a02bd36b519e773",
   "ko": "시공방랑자"
  },
  {
   "id": "da1306:T00201",
   "source_sha256": "e4165fcbb75e6a2cdbece4301235ba972990bc824feb6ce90c5204e7f7be70e2",
