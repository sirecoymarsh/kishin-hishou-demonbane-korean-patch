  },
  {
   "id": "da0505:R00014",
   "source_sha256": "e6625ad31b3851e5f19784330b7627b648daa73e9931be5f189e4961fc56d6cc",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
