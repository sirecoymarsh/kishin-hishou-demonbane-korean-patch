   "ko": "아이온",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00119",
   "source_sha256": "7f3b448f058416302824538ba23307f061c08c986225ab19a3b498f65ee63fc6",
   "ko": "영겁"
  },
  {
   "id": "da0505:T00120",
   "source_sha256": "31bf4bb289d56ec6bb9d4ce66bdf43db67b160c993d9541d06641d527829f7e4",
   "ko": "!\n　　시간의 톱니바퀴\n　　"
  },
  {
   "id": "da0505:R00029",
   "source_sha256": "8ac397e74c8333ecacdeede9b35dfb1b0c55e3e37aa7991b37a9b95b9fe2071c",
   "ko": "심판",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00121",
   "source_sha256": "fc4fb7847b6d2d59fb15041adfc82ba7c139fd29638b982f76fe6574762b8bd1",
   "ko": "단죄"
  },
  {
   "id": "da0505:T00122",
   "source_sha256": "baf0ed84a0517c4534a15be00b276f7b59cefb87421de0dc54af04314079bb4c",
   "ko": "의 칼날\n　　구원의 끝에서 오는 허무」"
  },
  {
   "id": "da0505:T00123",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0505:R00030",
   "source_sha256": "029ddddfe5efb8824744a3c3d138b96882e9f8fa08a883d3b1a3aa02e0f7021c",
   "ko": "아이온",
