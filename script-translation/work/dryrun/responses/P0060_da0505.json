  },
  {
   "id": "da0505:T00124",
   "source_sha256": "7f3b448f058416302824538ba23307f061c08c986225ab19a3b498f65ee63fc6",
   "ko": "영겁"
  },
  {
   "id": "da0505:T00125",
   "source_sha256": "631157c15452e8cefd925437a26f1d016b1a5d7575f9234fd0bf7aff0369e63d",
   "ko": "!\n　　"
  },
  {
   "id": "da0505:R00031",
   "source_sha256": "00fc46018228175a1eb8fef0035fd89138d19f5086651a85c6b102d3500df270",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0505:T00126",
   "source_sha256": "8c82875ab04265373825b1b25efcc5850926815c50b871a69e755a6caf326685",
   "ko": "그대"
  },
  {
   "id": "da0505:T00127",
   "source_sha256": "ce8020ecfee1a10fa72dad86b98eaccd6c2e35612e82a5144f1698dc66b49bac",
   "ko": "에게서 벗어날 수 있는 것은 없으며\n　　"
  },
  {
   "id": "da0505:R00032",
   "source_sha256": "30decdf4274513937a5295af56ea082925e2c003e616f76156e9dec43f9164c6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0505:T00128",
   "source_sha256": "8c82875ab04265373825b1b25efcc5850926815c50b871a69e755a6caf326685",
   "ko": "그대"
  },
  {
   "id": "da0505:T00129",
   "source_sha256": "5ecc181534ce9a3304ef143df7644f21bfc5c330943b0dea2eee8b8ffa3ea301",
   "ko": "가 닿은 것은 죽음마저도 죽으리라!」"
  },
  {
   "id": "da0505:T00130",
   "source_sha256": "1154481444878bfc3b699c983571bb417ffdb606c070712ca7d0f102d2242970",
   "ko": "아즈랏드에게 창화하는 "
  },
  {
   "id": "da0505:R00033",
   "source_sha256": "2bb9df2369234dd1a09c594d05bb8f486a403b25224bff5eeb85f6e147b6bbbb",
   "ko": "페이지군",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00131",
   "source_sha256": "14dce25b1c1b98453816ea31dcbf87f0006c3fe4f2087db40fccd9cf09497735",
   "ko": "지편이군"
  },
  {
   "id": "da0505:T00132",
   "source_sha256": "1e158d893d015cbcb3a96f8e3908b9477c1a0a67c6679e86084560e57fe8f5f7",
   "ko": "."
  },
  {
   "id": "da0505:T00133",
   "source_sha256": "4d25e992fa2aa3d59775e7ed7a0770e2dff2f8ad3dd7f2db864c4d7cee26cb4f",
   "ko": "발광하는 마술 문양의 기계적 율동.\n\n　빛과 소리는 동조하여 입체 마법진을 직조하고, 공간의 성질을\n변용시켜――"
  },
  {
   "id": "da0505:T00134",
   "source_sha256": "31d0eef7137652b04509885dd80bef60d65e945d549dc6fea886f303f7afdae7",
   "ko": "실재와 비실재의 일렁임 속에 있던 거대한 그림자가 충격파와 함께\n현현했다."
  },
  {
   "id": "da0505:T00135",
   "source_sha256": "7778a764c2a4fb72ba3f2f538213a5d02e0af7a2faa4fd0a9e891d70105c610b",
   "ko": "칠흑이 확실한 질량과 두께를 얻는다."
  },
  {
   "id": "da0505:T00136",
   "source_sha256": "2fef041af4c54979b0a44458c43cd25e6aa8b06e631838da3c9f01ccbace41d8",
   "ko": "그것은 전장 50미터에 달하는 어둠빛 기신."
  },
  {
   "id": "da0505:T00137",
   "source_sha256": "5217c6092636e6f578e655935f15ef1e0a932ceac7b6264a8ad0278c698a8ae9",
   "ko": "일찍이 최강이라 칭송받았던, 『알 아지프』 본래의 귀계신――"
  },
  {
   "id": "da0505:T00138",
   "source_sha256": "da8ecded50a6ce465f503b87370883b74acc4abbda2f0859c471e81b58baed9c",
   "ko": "「아이온!」"
  },
  {
   "id": "da0505:T00139",
   "source_sha256": "91d7640678cdbcbbba1d3c263cb81578a9dad1262f88e2a56e4594456b1769ad",
   "ko": "『"
  },
  {
   "id": "da0505:R00034",
   "source_sha256": "00f62a6f4a40ed9ed3f2271148d5f1928d203693bcc3e6f088b2462e1a5f9817",
   "ko": "알 아지프",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00140",
   "source_sha256": "9cf0a83b6b19024faca7cfe4fb7e49b8429d5d188ed6244d2a85e26845b21d5a",
   "ko": "마물의 포효"
  },
  {
   "id": "da0505:T00141",
   "source_sha256": "1a7bd608ebbf9f5e8fcec6ef47c0d1717aa995f3848a5fea137f59f0901f9a87",
   "ko": "』."
  },
  {
   "id": "da0505:T00142",
   "source_sha256": "7bf8a1d92642298649cf4291eae1e69022ef6ff373396e0728b6b09bf056e477",
   "ko": "아랍의 광시인 압둘 알하자드에 의해 집필된 책."
  },
  {
   "id": "da0505:T00143",
   "source_sha256": "cdef5ae253082536315a61c4b3df5f5d547a9e922882c6cd80ab8d6706cc8e68",
   "ko": "온갖 금단의 지식이 기록된 외도법전.\n\n　『네크로노미콘』의 원서인, 소실된 것으로 알려진 마도서다.\n\n　하지만 결코 구전되지 않는 인류의 암부――"
  },
  {
   "id": "da0505:R00035",
   "source_sha256": "2dc83fbd20d852ebc57acbd21403e5d7ef037dcdcd04c98c8aca6c2caeac920e",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0505:T00144",
   "source_sha256": "ae0f56e8fa98e115575873150d7b657021ae833d0abeb461373a4145636aed33",
   "ko": "암흑"
  },
  {
   "id": "da0505:T00145",
   "source_sha256": "f48a1339ffc08fd884c0134784db66df90b04435577ac774df40187982e5620d",
   "ko": "의 역사에, 이\n무시무시한 책은 종종 모습을 드러냈다."
  },
  {
   "id": "da0505:T00146",
   "source_sha256": "60fa4ebb154b10346d5246baba16e8658b1fbf4afd759c1b28bc693d0d2f8d80",
   "ko": "어느 때는 마술의 심연을 지향하는 구도자의 손에."
  },
  {
   "id": "da0505:T00147",
   "source_sha256": "43a9bcdc8c6ce1619a14cdfccb7fc3977d8c248473f652aca677dac066c2df79",
   "ko": "어느 때는 비대해진 야심에 불타는 투쟁자의 손에."
  },
  {
   "id": "da0505:T00148",
   "source_sha256": "275fa35f2be1b380b98d523c929a200226c3728a30af849a792ec2e00fa7153a",
   "ko": "어느 때는 영혼이 공포에 오염된 희생자의 손에.\n\n　그리고 또 어느 때는――"
  },
  {
   "id": "da0505:T00149",
   "source_sha256": "2522313dc68002a7078bc71b74244865b28a9458fdffbe71f4d88d4713dfe454",
   "ko": "미래영겁 치유되지 않는 허무를, 다하지 않는 증오로 채우려는 복수자의 손에."
  },
  {
   "id": "da0505:R00036",
   "source_sha256": "e533081aa171fce47c1b7e7265e0f9503a9802e4ae1093331fb742265966d34a",
   "ko": "마스터 오브 네크로노미콘",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00150",
   "source_sha256": "b552dfbadf554308b98a24c462f3c1d086bf8ab09671a897b316cb874a78d56a",
   "ko": "『사령비법』의 주인"
  },
  {
   "id": "da0505:T00151",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0505:T00152",
   "source_sha256": "4d24d9c56ef2637fbff8ec35e5d8cd941175d683d289fc53a9b05db5511bda88",
   "ko": "그들은 그렇게 불렸다.\n\n　목적이 무엇이든, 그들은 예외 없이 세계를 침범하는 사악과의 싸움에 몸을\n던지게 되었다.\n\n　『마』의 "
  },
  {
   "id": "da0505:R00037",
   "source_sha256": "4d26caf28f7fb6a73800fe088e4ccd8897122c57d6ca48069629b32bf4fb9f29",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0505:T00153",
   "source_sha256": "46631fbed439309f1ababcf870901f88879cd0e4da6a78231632768fd17c9cbd",
   "ko": "소멸"
  },
  {
   "id": "da0505:T00154",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0505:T00155",
   "source_sha256": "3a1d138f403d5a0461d308cf4dd5bf878059e07ca4b0be1a6043c6d5aa75c4fe",
   "ko": "그것이 마도서 『알 아지프』의 의지였으니까.\n\n　사악과의 싸움에서 불타 끊어지고 다 타들어 가는 주인들의 생명."
  },
  {
   "id": "da0505:T00156",
   "source_sha256": "619087b46dad50987b7620cdf8b1b1d5e66740bf0e9e58424165531b3f9771ad",
   "ko": "그 모든 것을 그녀는 자신의 몸에 각인하고 있다."
  },
  {
   "id": "da0505:T00157",
   "source_sha256": "56fc68cf915f86947cbc948fac28f299338cbfd0c6f5010597f2bf3ad51ef55a",
   "ko": "그렇다면 그 모습을 잊을 리도 없다."
  },
  {
   "id": "da0505:T00158",
   "source_sha256": "6f1b47d7d7f4fe02f7fd58ac0fb95ff2d5addd22de44fe0be2c76fd3e3ad11fb",
   "ko": "악몽에서 깨어난 알이 목격한 것."
  },
  {
   "id": "da0505:T00159",
   "source_sha256": "8f6c7c32db137bffa1e873fa2ee3301dd0f7c1ff69d0199a0cb0b6f094dc37e8",
   "ko": "진흙탕 바다를 물리치는 빛."
  },
  {
   "id": "da0505:T00160",
   "source_sha256": "9dbd0c5939772ed148bfd260ddf8a7df2e09e86fbc37f13872f0f1209a5a2816",
   "ko": "현현하는 칠흑의 "
  },
  {
   "id": "da0505:R00038",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00161",
   "source_sha256": "c02b59808c4fdb29f5687acea640de48a9f375f3da8a73801dcdcebd0f23cac7",
   "ko": "기계신"
  },
  {
   "id": "da0505:T00162",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0505:T00163",
   "source_sha256": "01c47a4169f98e3ef464586f06683b4c17d02aed1891817a2152fbe1e247ebed",
   "ko": "소실된 줄 알았던 "
  },
  {
   "id": "da0505:R00039",
   "source_sha256": "129b734068ac051fab63a1982ad9fa8530fcd502754172bac2077b43d3a0bac1",
   "ko": "갑옷",
   "ruby_action": "keep"
  },
  {
   "id": "da0505:T00164",
   "source_sha256": "d94ededfdd015613317a5e2d858e7ed49acf3314d52c7f77ae219458fd34ae25",
   "ko": "강철"
  },
  {
   "id": "da0505:T00165",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0505:T00166",
   "source_sha256": "83d024407c97667581bc91cf371c20c62dc8ff3508e530279983ef44903ab90f",
   "ko": "그리고――그림자."
  },
  {
   "id": "da0505:T00167",
   "source_sha256": "45e1233858065fa96110c7f210bab13485ff448e0f8a3f01cc495ff283e71109",
   "ko": "그것은 "
  },
  {
   "id": "da0505:R00040",
   "source_sha256": "9e01e7b843be92a9d32129c0661107e163b54042ac97ad03fcafa75e40d331b6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0505:T00168",
   "source_sha256": "389bbac1b256d36df12ea23e0ea5db3f3b5a4242c671c915091732e62596b8b4",
   "ko": "어두"
  },
  {
   "id": "da0505:T00169",
   "source_sha256": "f67f8e15da80c8a3ee024004e79635f34eac7b760499233d671f15013c1f66ac",
   "ko": "운 어둠을 머금은 인간의 모습."
  },
  {
   "id": "da0505:T00170",
   "source_sha256": "25f70afe60a35b68809888113bf7c32b3bade136cded65a09d357ee0a134ed8e",
   "ko": "어둠에 물들면서도 여전히 『인간』으로 남아 있던 자의 등이다.\n\n\n　머나먼 날의 등이 그녀를 수호하듯 선다."
  },
  {
   "id": "da0505:T00171",
   "source_sha256": "73cb0d43a9d43adc385e8fcfd6b6549233eb3d3b3852758c359f8fe2c071c969",
   "ko": "「……아즈랏드?」"
  }
 ],
