   "ko": "바람",
   "ruby_action": "keep"
  },
  {
   "id": "da0902:T00029",
   "source_sha256": "557f510632ef9371f3d607bbacbea197d05c400139758896e28ef3d58e065aa4",
   "ko": "검풍"
  },
