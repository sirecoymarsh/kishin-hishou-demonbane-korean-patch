{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0097_da1203",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da1203:R00001",
   "source_sha256": "9e01e7b843be92a9d32129c0661107e163b54042ac97ad03fcafa75e40d331b6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00001",
   "source_sha256": "389bbac1b256d36df12ea23e0ea5db3f3b5a4242c671c915091732e62596b8b4",
   "ko": "어둡"
  },
  {
   "id": "da1203:T00002",
   "source_sha256": "4c6ff2461396974940d832f3f0ce2a7624668028f9bff88ca807b1e9da44a407",
   "ko": "고 짙은 "
  },
  {
   "id": "da1203:R00002",
   "source_sha256": "2dc83fbd20d852ebc57acbd21403e5d7ef037dcdcd04c98c8aca6c2caeac920e",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00003",
   "source_sha256": "e6a3871b1eb57cab73e0cd3e8a46faa7ff30a1302c8a3110634461b214a15459",
   "ko": "암흑"
  },
  {
   "id": "da1203:T00004",
   "source_sha256": "4f4e76d0ce0a393bf43d267b3899d1f66fa5ae55a82d89fa94fe4be3cc6d5a1c",
   "ko": "을, 추락한다."
  },
  {
   "id": "da1203:T00005",
   "source_sha256": "0a042821445bdd22e077e7aa38c30a0c052ee527c26d9d46df276c425fefa7de",
   "ko": "추락한다."
  },
  {
   "id": "da1203:T00006",
   "source_sha256": "0a042821445bdd22e077e7aa38c30a0c052ee527c26d9d46df276c425fefa7de",
   "ko": "추락한다."
  },
  {
   "id": "da1203:T00007",
   "source_sha256": "46d63cebed1519716a4d07aca1f2f94fdc352192d3a1cb2804b0efd447e76b6d",
   "ko": "추락하고,"
  },
  {
   "id": "da1203:T00008",
   "source_sha256": "46d63cebed1519716a4d07aca1f2f94fdc352192d3a1cb2804b0efd447e76b6d",
   "ko": " 추락하여,"
  },
  {
   "id": "da1203:T00009",
   "source_sha256": "6a6e88fb889526e520eb8000becda2c0c7d5a52745836d6faf9d2c73a78a22af",
   "ko": " 전락한다."
  },
  {
   "id": "da1203:T00010",
   "source_sha256": "1fff446ac9704d940e9bf6185c8930dbc5aff3a3ca8f8bba2c0a2a6cd55ecc4c",
   "ko": "「나는……」"
  },
  {
   "id": "da1203:T00011",
   "source_sha256": "2934d27333f94046b766dd4d19eda7f4f092790fa37bc4119568fd3f3f1db05f",
   "ko": "추락하면서 몸을 움직이려고 발버둥 친다."
  },
  {
   "id": "da1203:T00012",
   "source_sha256": "080073430bcc47a41027d9518b91dff49891f9603d650f972911add12719a67b",
   "ko": "하지만 힘이 들어가지 않는다."
  },
  {
   "id": "da1203:T00013",
   "source_sha256": "6d85827d1e0c6b94fc5e5159280d4ff0cd38d50a33a9257a84772c2e195b3400",
   "ko": "내 몸이 내 것이 아닌 감각."
  },
  {
   "id": "da1203:T00014",
   "source_sha256": "db21e8222f5cfc9006bc3dea98cde4c3235de567392429e0b1beaa2261e96de9",
   "ko": "현실감이, 실재감이 전혀 없다.\n\n　무겁다."
  },
  {
   "id": "da1203:T00015",
   "source_sha256": "7dd77b717e928fa7d27ae54405e78d692744b9eadb2da699a84949330cd5d3bf",
   "ko": "내 몸이 지독히 무겁다."
  },
  {
   "id": "da1203:T00016",
   "source_sha256": "31f687b1ca6153986426b402ff8caccbb459dde5f7b487648197f1b24fe1f1c5",
   "ko": "불쾌할 정도로 무겁다."
  },
  {
   "id": "da1203:T00017",
   "source_sha256": "4c182255d7a1082779bdc7ab6fb5df46783fe4c2d8f32084cab5a4b5b1f88292",
   "ko": "아아, 이 얼마나 "
  },
  {
   "id": "da1203:R00003",
   "source_sha256": "5d6fd3bcd20ddab94f856eccc87ab642097476d8a088f707133bc36eb2fb9f8b",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00018",
   "source_sha256": "77696f811f5856102991d78b3a1fdf7c1d0ece38e186945f3c02ce3484bc91f7",
   "ko": "둔중"
  },
  {
   "id": "da1203:T00019",
   "source_sha256": "31735cc2658c86663f0901f27b38c09ebcfb8df5ec667776c4dc08319e51c62a",
   "ko": "한, 살덩이의 감옥인가.\n\n　어째서――라고 생각하다, 돌연 떠올린다."
  },
  {
   "id": "da1203:T00020",
   "source_sha256": "fa1a5a0dcacfcf128ad34c95a3a980c749e152cabfaa59d37cd0948afbe4cb06",
   "ko": "붉은 기신."
  },
  {
   "id": "da1203:T00021",
   "source_sha256": "bdca64c1ff046c049888b2d1df667245b6c3948216554b84406f651a9c2b5a14",
   "ko": "부서져 흩어지는 데몬베인."
  },
  {
   "id": "da1203:T00022",
   "source_sha256": "10d93364212e8379b3499f870469f31b8aee576afb0be7cc6de64300d47393c3",
   "ko": "나는――"
  },
  {
   "id": "da1203:T00023",
   "source_sha256": "1988cf11be8d02e5ef24ea27e43c7a6f89dbbcfbf7fd7492eb2de79520fec769",
   "ko": "「나는…… 패배한 것인가……」"
  },
  {
   "id": "da1203:T00024",
   "source_sha256": "03874da8943c826d46330fa5cdd00c4810f5e38573b717621ec3a18a5a722bbd",
   "ko": "몸이 한층 더 무거워진 기분이 들었다."
  },
  {
   "id": "da1203:T00025",
   "source_sha256": "5f3a45426ba04ba48d0a3e44d96c6bbe9ebd1fe7d97c87c5785db266f02c9d17",
   "ko": "심한 두통이 뇌를 헤집어 놓는다.\n\n　이런 무거운 고통이 계속된다면 의식을 어둠에 가라앉혀 버리고 싶다."
  },
  {
   "id": "da1203:T00026",
   "source_sha256": "6145945ba58ea243e4000003a868a608e068fec844def9286e4510f1c00361da",
   "ko": "아무 생각도 하고 싶지 않다……"
  },
  {
   "id": "da1203:T00027",
   "source_sha256": "4a3abbe26781042708911cdfd8c420f1f8832da27698eb6e20bf773d1f43607c",
   "ko": "무방비해진 마음에, 그것은 왔다."
  },
  {
   "id": "da1203:T00028",
   "source_sha256": "b7021923efe5ffb17fded318270a6ee37a92ef2da54fb69c3f007feef39e2735",
   "ko": "노도처럼 흘러들어오는 대질량의 사념.\n\n　타들어 갈 듯이 뜨겁고, 부서질 정도로 격렬하며,"
  },
  {
   "id": "da1203:T00029",
   "source_sha256": "16603b5bd585a7503347cce1b0ed6fba0338982c2ff0793b0e4dbd617ba5b95c",
   "ko": " 가열차고 장절한"
  },
  {
   "id": "da1203:T00030",
   "source_sha256": "bfe3b56e08ee4e6c3eeee6eab87d291958a9bd66a05087f6f541b479027a22f7",
   "ko": " 영혼의 충동／"
  },
  {
   "id": "da1203:T00031",
   "source_sha256": "9dfb7c00356ed223e21b1b9f5f2274ee51319ca503543f2fe34790d4fd16f7bb",
   "ko": "연소／"
  },
  {
   "id": "da1203:T00032",
   "source_sha256": "93f06873ea921908e6c3f5e503872769003cdd1bac288f8916fa1b021dafa5d0",
   "ko": "격동／"
  },
  {
   "id": "da1203:T00033",
   "source_sha256": "4eb2cb2b5b9a5e937bfaeac8b12bc2da16e77143739d8d9bb8dad174fcad3650",
   "ko": "질주／"
  },
  {
   "id": "da1203:T00034",
   "source_sha256": "0fba29761abb388620245324299af4edbaa66f08c08b5d7dea225822129b205d",
   "ko": "폭발／"
  },
  {
   "id": "da1203:T00035",
   "source_sha256": "2f5474cbd0fe94a85d39af7c19df3bd440238733063dcf9838333068a21100db",
   "ko": "폭풍――\n\n　그런데도 그것은,"
  },
  {
   "id": "da1203:T00036",
   "source_sha256": "042600b8d3b34eb65c854ad5e907505811ad8bc34c222590e8549ea984082c10",
   "ko": " 강하고,"
  },
  {
   "id": "da1203:T00037",
   "source_sha256": "c38b885d4092446523d9565c7bc41c786b6ae7090eafcb61225bdd920e0d672d",
   "ko": " 상냥하고,"
  },
  {
   "id": "da1203:T00038",
   "source_sha256": "6bf9e16dde99aee3af4b9129f62ff466d512ddc84adbc80df7aec07116279b9e",
   "ko": " 쾌활하고,"
  },
  {
   "id": "da1203:T00039",
   "source_sha256": "284e14cee8d3c1cc3c38279702a84e8045eb4680de2aeefa30259617a3a86b7e",
   "ko": " 사랑스러워서――\n\n　당신은――"
  },
  {
   "id": "da1203:T00040",
   "source_sha256": "3152b7dceeaec83c54ac392c0610959b8357c81f4f5bb6a1f9c15aab49b083a5",
   "ko": "자, 그럼 "
  },
  {
   "id": "da1203:R00004",
   "source_sha256": "6f090df5f940a27b8d0ebc6bb33da6a0b5a3ef58a93f573524402a7c4ee81828",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00041",
   "source_sha256": "f3c39da61b39d310cbd4941b75d324bc5931f7e534d61f9d3d812cd31b07608d",
   "ko": "옛날이야기"
  },
  {
   "id": "da1203:T00042",
   "source_sha256": "46153d4f30dab77952dffa15a24c50d3dc039f7278a4cc966a5094cddff16e50",
   "ko": "를 시작하자."
  },
  {
   "id": "da1203:T00043",
   "source_sha256": "193719a03cb700ee72fe2eb0f5898425d53920587fea4f32e118e7168bae8282",
   "ko": "그것은 분명 영웅담이다."
  },
  {
   "id": "da1203:T00044",
   "source_sha256": "f43c65c32de0958ac78345a09502ad19cebe89df59c5f5f3d33a6fab260098c2",
   "ko": "영웅의 이야기를, 너는 싫어할까?\n\n\n　\n　\n　\n　\n　\n　　　――하지만 이것은, 지독히도 볼썽사나운 영웅의 이야기다."
  },
  {
   "id": "da1203:T00045",
   "source_sha256": "9a01f9f6d3f2d5d2c37039d0b852ec90d247b71ad05769730dc3dbb10f2c251f",
   "ko": "그 녀석은 몇 번이고 패배하고, 몇 번이고 만신창이가 되었다."
  },
  {
   "id": "da1203:T00046",
   "source_sha256": "28e2133cb36bc932e9582afbfad421fa2508f4bf1575a944e85df6b95492da94",
   "ko": "위장 속의 것을 전부 토해 내고,\n　심지어 자신이 토해 놓은 오물 속에 쓰러졌다."
  },
  {
   "id": "da1203:T00047",
   "source_sha256": "006c17c5ff2145583925e28f5a3959e4484105dda46c6f05a75da1b51d9d9e2d",
   "ko": "피투성이가 되고, 오물투성이가 되어, 그 녀석은 싸웠다."
  },
  {
   "id": "da1203:T00048",
   "source_sha256": "da993e8e98cd75c7caf4940677263ba1a334b3e2daae0244c6a577bd9e012870",
   "ko": "이를 악물고 눈물을 참으며, 겁에 질린 마음과 떨리는 몸을 채찍질하며.\n\n\n　그런 비참한 영웅의 이야기를, 너는 "
  },
  {
   "id": "da1203:R00005",
   "source_sha256": "2895ce20a7385bc2cc182870401439c7986e12de3e6b4a814eefe718fb782e64",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00049",
   "source_sha256": "c925efd1d29b1e008838b56d0c08b5c0b61ffa51d86f063c237965383ccd1994",
   "ko": "비웃"
  },
  {
   "id": "da1203:T00050",
   "source_sha256": "1fdb5ee6a88096d4636a002143e86fe272567a7e5243de9e76cb2c81ffb2ae46",
   "ko": "을까?"
  },
  {
   "id": "da1203:T00051",
   "source_sha256": "7a4316af409ba6def59c63a708b55714c21bfcf58a2c9e65679d2b15e906e540",
   "ko": "――상상해 보아라.\n\n\n\n　그토록 볼썽사납고 비참하고 멋없는 그 녀석이 짊어지게 된,\n　영웅의 신화를."
  },
  {
   "id": "da1203:T00052",
   "source_sha256": "762105999fc7bd7ee0dc3aaee60e79812f75829d1e97fc0173b8ceadad5dc02d",
   "ko": "그 녀석의 눈앞에 가로막아 선, 무한 질량의 공포와 절망을."
  },
  {
   "id": "da1203:T00053",
   "source_sha256": "077a404bd4524b565f81c9e44e2db25db0b4e9d7a9925928c23e07bd88f7cc90",
   "ko": "기적의 연속을 절대 조건으로 삼아서야 겨우 "
  },
  {
   "id": "da1203:R00006",
   "source_sha256": "d3c1ed5b65b9dc901897573cfea047dac1ada521f22260f5862bf9ba82ff869e",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00054",
   "source_sha256": "54cfdfd0f3e19ac1cc1ba6208a11f27a7274f87744c73c19d5b337e7fba00fc6",
   "ko": "실낱"
  },
  {
   "id": "da1203:T00055",
   "source_sha256": "f26a2c6768a77d997776adcbd44b9c31a57aef3820c8c93220eea8e8bb89e758",
   "ko": "같은 가능성을 찾아낼 수 있는\n승리의, 그마저도 연속을 강요당한 "
  },
  {
   "id": "da1203:R00007",
   "source_sha256": "9f4e41d5edf7b6ce11537b7c0e6ce1ff100fac8314804d10ca6221972fc45703",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00056",
   "source_sha256": "f50a5ddafe3771c51efe76594ef6983dc7b1b9477d26b65049273a8b1c33580d",
   "ko": "투쟁"
  },
  {
   "id": "da1203:T00057",
   "source_sha256": "1f25301c144f5be58a72e72267f3564167a5f54f9da9256dbcefb2a4c7a1f3b0",
   "ko": "의 나날을."
  },
  {
   "id": "da1203:T00058",
   "source_sha256": "264b1951067c67a301a82c5cbf48da7d475e0c7f795ca5bc9ca975d01df57a75",
   "ko": "그런 길을 선택하고 걸음을 내디딘 그 녀석의 결의를."
  },
  {
   "id": "da1203:T00059",
   "source_sha256": "12421738088e9e223aca62bee6504ceaaa66136be79c1fc11849fb3240c77f50",
   "ko": "그 첫걸음을 내딛기 위해 필요했던, 전 우주의 총에너지에\n　필적하는 용기의 열량을."
  },
  {
   "id": "da1203:T00060",
   "source_sha256": "79198c8d84c1187f0981aeb8edd6b203ac59ca302d6360f7fcd6110e33088cd0",
   "ko": "그런 영웅을――너는 직시할 수 있겠는가?"
  },
  {
   "id": "da1203:T00061",
   "source_sha256": "40955b8503e2f88b3bcfb2e248aeafe04530faf8d3e9c8f1afb2608ce1355c92",
   "ko": "――또다."
  },
  {
   "id": "da1203:T00062",
   "source_sha256": "df7e6d1f02069a80717a1bd2b7fdd2274dcafa94cb971588484a93584f4cfd6d",
   "ko": "「――야아, 또 만났네」"
  },
  {
   "id": "da1203:T00063",
   "source_sha256": "e517991216a33a064af1ad91673b1c4f268eba0d037daca6c7f3186bc7e9acff",
   "ko": "――또, 이 꿈."
  },
  {
   "id": "da1203:T00064",
   "source_sha256": "00bd332baaa5b34907b8356925392a0c6ee52a82c63b6dd1018c7c70bdcfe102",
   "ko": "「아핫, 그렇게 경계하지 않아도 돼.\n『지금의』 『이 나』는 너희와 싸울\n생각은 없으니까. 잠깐 들른 것뿐이야」"
  },
  {
   "id": "da1203:T00065",
   "source_sha256": "176bc76e09819ccfd110274922e23ee8f546cf9e6c2cb07802449c0e5b33835c",
   "ko": "「후우…… 역시 너희와 만날 때는,\n　이 모습이 제일 잘 어울리려나」"
  },
  {
   "id": "da1203:T00066",
   "source_sha256": "d7740f1431cd5ed670a4ff63caf72d8991b9f0722d1d380aaa64ecaa027d54de",
   "ko": "――뭐지."
  },
  {
   "id": "da1203:T00067",
   "source_sha256": "cb08187c102b65125b46af215a5a703e362208d58729b9d38f4001c3ab37afc7",
   "ko": "「그나저나, 너희와는 정말로 긴 인연이 되었군…… 아아, 이건 지금의 네 주관 시간에 맞춰서 하는 말이지만」"
  },
  {
   "id": "da1203:T00068",
   "source_sha256": "014af5eb28f04b1298ca0a932c6a85ac87021c025e45c2756ec50fd2f4fb2f8e",
   "ko": "「너희에게 『승멸』당한 『나』는――\n이걸로 414633276"
  },
  {
   "id": "da1203:R00008",
   "source_sha256": "e1e421c5cf2bb2a92e861786ae8572d9c55af31308fdede1330eb870f9b48c93",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00069",
   "source_sha256": "f7324c14e23afa4711a65c27de5438daef52870da81b7aa02fdf47647dc0234a",
   "ko": "위"
  },
  {
   "id": "da1203:T00070",
   "source_sha256": "b955f6e2465ec16b1b5a2a8306436b7d45a9ea6484c46288a5cabf493da6ee8b",
   "ko": "째야 ……"
  },
  {
   "id": "da1203:T00071",
   "source_sha256": "d9417c89d1250e6c65e355eec47146657f4ad34134222576dac8b0b06e0ff6bc",
   "ko": " 정말로 잘\n버티고 있다고 생각해. 아니아니, 빈정거림이나 비꼼\n이나 여유가 아니야. 마음속 깊이 그렇게 생각하고 있어」"
  },
  {
   "id": "da1203:T00072",
   "source_sha256": "d520a761dbde852aa804cbbf8ef53e4c71b8a298b457fd18e8c6ec0938e00ac4",
   "ko": "――뭐냐, 이 "
  },
  {
   "id": "da1203:R00009",
   "source_sha256": "d62fca5b5073ab465d648b608d0e4a2ccf32c01aba979bc1c7f015a7aa047ada",
   "ko": "이미지는",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00073",
   "source_sha256": "2892879e37b97d1b65b47ede97b4c28fbb90ff88f55275be78a2aff6a0dd68c6",
   "ko": "기억은"
  },
  {
   "id": "da1203:T00074",
   "source_sha256": "9791d56f911a6eca4154b4b41fd78d35a6712a40cdf5a05dcddf12be7132fc5a",
   "ko": "."
  },
  {
   "id": "da1203:T00075",
   "source_sha256": "4e145ec296207968cadd22962e5ded978c0a8cb6f744bac86dac81436e26ca18",
   "ko": "「……하지만, 슬슬 지쳐 가지 않아?\n　이쯤에서 한숨 돌리는 편이 좋지 않겠어?」"
  },
  {
   "id": "da1203:T00076",
   "source_sha256": "791e64a588de2278434eb8db69f55f14110373d91c0a688a75a0596e6cf6fbaf",
   "ko": "「이런이런, 성실하기도 하지.\n　……뭐 좋아.\n　그럼, 지켜보도록 할게」"
  },
  {
   "id": "da1203:T00077",
   "source_sha256": "982663d983298145c7fbd045b346af5a618367c7ce3b8b2cc6e364ee70406eba",
   "ko": "――당신은."
  },
  {
   "id": "da1203:T00078",
   "source_sha256": "35ae7edd9cd094fdf3dd72dea23b4ebc9299d416561d5720baea01f7205e7591",
   "ko": "「『마를 끊는 검』을 갖지 못한 너희가,\n　어디까지 싸울 수 있을지를――」"
  },
  {
   "id": "da1203:T00079",
   "source_sha256": "3583edf23257b9c2354580725aa499e991282057f9b230fae24fc30d138d18fb",
   "ko": "――이 광경을 보는 당신은 도대체 『무엇』이지?"
  },
  {
   "id": "da1203:T00080",
   "source_sha256": "1067db70cfa4eda89ba4b04a48150fb4fd06bf3d0081e7f5c6a5b80598627873",
   "ko": "「아…… 읏」"
  },
  {
   "id": "da1203:T00081",
   "source_sha256": "20290826a110ab232fedc5b8886ff74d14deb8e4ab240f899da0aa1ae6d48a97",
   "ko": "「어째서!　짐을 낳았느냐!　"
  },
  {
   "id": "da1203:R00010",
   "source_sha256": "fe65050b6cf95368d85f30fd366c092a15824886d51defd754887d1e968f7491",
   "ko": "・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00082",
   "source_sha256": "13bd79ebb5dc52e292f86bb838926543075fcffc7d65b6fe40f6a61a074ba7b7",
   "ko": "어머니"
  },
  {
   "id": "da1203:T00083",
   "source_sha256": "6560fad1b5299ec45c7562b1e825f123c87101dc289a1eb71426e443d34f4c8c",
   "ko": "!」"
  },
  {
   "id": "da1203:T00084",
   "source_sha256": "d18d9564b9bcdb2070c948381771cfb5993f6d9372c7cc79f2700d7c3fc10e1c",
   "ko": "「그 말로 부르지 마아아아아아아아아!」"
  },
  {
   "id": "da1203:T00085",
   "source_sha256": "742303f79b8d6545021459a0dc0f304df39445f35244e0b669256f24545b6cdd",
   "ko": "「보렴, 『"
  },
  {
   "id": "da1203:R00011",
   "source_sha256": "25b57b2614177361ac5835f61b08fa3f4116744d8275d0e97142056f7e6686a7",
   "ko": "투 소드／투 건",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00086",
   "source_sha256": "f8cc521ba37a92038ef768e668a4527c2a7d969381ad66558edf63d7338efd9e",
   "ko": "이투류"
  },
  {
   "id": "da1203:T00087",
   "source_sha256": "8013e3e5f31601265dc1a0ca7079818364a8a6543b9169e041b984e2f388dc63",
   "ko": "』.\n　서로를 거부하고, 서로를 죽이는 부모 자식의 모습을」"
  },
  {
   "id": "da1203:T00088",
   "source_sha256": "85b9ecb9467a0d2f59b4022a1b1f42f4b07fbc9cbb149359fdcd4236b0e8c691",
   "ko": "정신을 차려 보니 나는 붉은 양막 같은 것에 싸여 있었다.\n\n　내부를 채운 피 냄새."
  },
  {
   "id": "da1203:R00012",
   "source_sha256": "b224dbeb6a167ec3243a1e2b98b838b78763ab8010d9c12359360a66a9104b47",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00089",
   "source_sha256": "0131bab1f7c9b1a0a8607a7030defeb460a38bec4b3273ea63a2ed50899252a7",
   "ko": "은은"
  },
  {
   "id": "da1203:T00090",
   "source_sha256": "4f26ec16000ddb7096447d46d8f2fd7486074822e1b54ca57265cd6e3781ff91",
   "ko": "하게, 달콤한 냄새."
  },
  {
   "id": "da1203:T00091",
   "source_sha256": "e34487f277c5adf9978e8f94da542cd064e82383a11a3fb097e01835150fdadd",
   "ko": "「너무하지 않아?　제멋대로 낳아 놓고선, 방해되니까 죽이려 들다니」"
  },
  {
   "id": "da1203:T00092",
   "source_sha256": "a6cefb1fbbe22ba6d41fd96a26844591eff7575992bd7d1cc556c34c8de2657c",
   "ko": "「■■■■■■■■■■■■■■■■■」"
  },
  {
   "id": "da1203:T00093",
   "source_sha256": "a6cefb1fbbe22ba6d41fd96a26844591eff7575992bd7d1cc556c34c8de2657c",
   "ko": "「■■■■■■■■■■■■■■■■■」"
  },
  {
   "id": "da1203:T00094",
   "source_sha256": "7bb52a707ecc9e41a6cf208482bc13807f9ad6afdf1c03c6d9351c79090210bc",
   "ko": "희미하게 붉은 시야 너머에서, 빛이 두 기의 귀계신을 집어삼켰다."
  },
  {
   "id": "da1203:T00095",
   "source_sha256": "508564cbf8a10cc74b8e05a7da02cfe0db1d9b833da7954936c372647540d4bb",
   "ko": "빛 속으로 부서져 가는 기체."
  },
  {
   "id": "da1203:T00096",
   "source_sha256": "10dad34f736a73ca98927d28a58fd9fdf900656da74799b2135b2529e49f8776",
   "ko": "목소리가 비웃는다."
  },
  {
   "id": "da1203:T00097",
   "source_sha256": "0f1922fd4cc55b0d8363a830f5878f0d33f7f9984b5a1386aaad337bae8367ca",
   "ko": "쿡쿡, 하고."
  },
  {
   "id": "da1203:T00098",
   "source_sha256": "36a46210a5c2cfb8d136a0566c4245bc210a2138ffb32e4414f49153c3dd7bf9",
   "ko": "달콤한 냄새가 한층 더 짙어진 기분이 들었다."
  },
  {
   "id": "da1203:T00099",
   "source_sha256": "e1d774461fd474215ad0118cd418ad5fff588f306b642c4c933ab5f0bee6bb05",
   "ko": "「당신도 마찬가지네, 쿠자쿠?」"
  },
  {
   "id": "da1203:R00013",
   "source_sha256": "33f9af44d64303e9cd100f0a21251e4aa59d96e64134eaf9ebb4da0864e6861e",
   "ko": "루비 아이",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00100",
   "source_sha256": "5cace30a6f933bb97be8c0222299d3a45b953bec24cd2e4eb2acc0f89d70931a",
   "ko": "붉은 눈동자"
  },
  {
   "id": "da1203:T00101",
   "source_sha256": "b4cc341774022611c8fceec635bcb30d64d12b6d0c97c41f1a98d0c34b509a4f",
   "ko": "가 나를 들여다본다."
  },
  {
   "id": "da1203:T00102",
   "source_sha256": "91a4b9cfb9ef4ee1d743fa787b8ae2e56dfa777d571eaff64b976f1b57e7bda4",
   "ko": "어나더 블러드의 눈동자."
  },
  {
   "id": "da1203:T00103",
   "source_sha256": "833f357465ebaf9fbdb0d08a44e7e7db55e84d6fb7e9f2b7b7f2f5e5a4ad3df6",
   "ko": "그 안쪽에 깃든 것은 연민인가, 자애인가.\n\n　――그만둬라."
  },
  {
   "id": "da1203:T00104",
   "source_sha256": "a75b091c590c4b8a1dce30cf8f29a36399bd21be411842abd2ea925e7bab4df5",
   "ko": "「당신도 거부당했어」"
  },
  {
   "id": "da1203:T00105",
   "source_sha256": "d159e09315e8a00e54bc7b9082d0ab0943ab9476e1181c0aba1ecc59f0863c0c",
   "ko": "그만둬라."
  },
  {
   "id": "da1203:T00106",
   "source_sha256": "d159e09315e8a00e54bc7b9082d0ab0943ab9476e1181c0aba1ecc59f0863c0c",
   "ko": "그만둬라."
  },
  {
   "id": "da1203:T00107",
   "source_sha256": "c5b0b962b0bd0465658d025eadde84b216cced87a794acfe2b36466a77ab3946",
   "ko": "그만둬라.\n\n　온몸이, 온 영혼이 거부하고 있었다."
  },
  {
   "id": "da1203:T00108",
   "source_sha256": "19c0ff4544e88d986ee847f77fb66a603e9317f5965d933846e43f2b68ee1b3a",
   "ko": "어나더 블러드가 다음에 고할 말을.\n\n　그러나 몸은 움직이지 않는다."
  },
  {
   "id": "da1203:T00109",
   "source_sha256": "99b2c5bb110e1e135c5b6aafae7138145da105adaecb0c480be02119c5413426",
   "ko": "눈을 돌릴 수도, 귀를 막을 수도 없다.\n\n　그저 그 치명적인 말을,\n　목석같은 꼭두각시가 되어 겁에 질린 채 기다릴 뿐이다."
  },
  {
   "id": "da1203:T00110",
   "source_sha256": "bd5c53c730c0fb7dfd2a5bec7f37c55211e41c41a94a636c98a78c09ca1555af",
   "ko": "「쿠자쿠, 당신은……」"
  },
  {
   "id": "da1203:T00111",
   "source_sha256": "4e392f3373a833c41d89d423291393eb60733cf6589251da9da4cc51f1a32eeb",
   "ko": "「……읏…… 그, 만둬…… 읏!」"
  },
  {
   "id": "da1203:T00112",
   "source_sha256": "2975304f197a49722371e480e2bcd3a216ab65e4a0d557e6adc7c8948ddcc794",
   "ko": "황홀하게 젖어 드는 붉은 눈동자."
  },
  {
   "id": "da1203:T00113",
   "source_sha256": "e4e9c94836fcd4274747976b89381b6577d8d503c5de37fd806a42ce1f6de9a6",
   "ko": "요염하게 미소 짓는다."
  },
  {
   "id": "da1203:T00114",
   "source_sha256": "f455cb3d50b717710b3338348b74f7c62c291937e234f148f0a870c812b5e57f",
   "ko": "피 냄새는 숨이 막힐 정도로 달콤하게――"
  },
  {
   "id": "da1203:T00115",
   "source_sha256": "ea87e9e6a4482c099a95d8b4a8946620ba150bb2b51c8f062d3ff78879009986",
   "ko": "「당신은, 부모에게 버림받았어」"
  },
  {
   "id": "da1203:T00116",
   "source_sha256": "f3a341350e3f2f9d36a3ad400f11f3a2d5d70f11b4d6128b372f8df0e150df8f",
   "ko": "그 순간, 마음이 꺾였다."
  },
  {
   "id": "da1203:T00117",
   "source_sha256": "001c54b13f7ab1711ece202dcf58de00fdcc6bb339ce5d8e2a181b01b94b9390",
   "ko": "사수해야만 했던 영역이 소리를 내며 무너져 간다.\n\n　어나더 블러드의, 가학의 "
  },
  {
   "id": "da1203:R00014",
   "source_sha256": "e111419eac152658993a25440ab1d0f387cb9c5759d6b99761f36521c5129bae",
   "ko": "기쁨",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00118",
   "source_sha256": "00d49acac19adc4336950c6e8071d42d5df27ba5d29c6f4a209cdaca8a6a2c94",
   "ko": "유열"
  },
  {
   "id": "da1203:T00119",
   "source_sha256": "940e0f08517fe73a3ae62588808e01be6ec723cf4e0916a86096d0ef4bdabb92",
   "ko": "에 가득 찬 목소리가 이어진다."
  },
  {
   "id": "da1203:T00120",
   "source_sha256": "9b085fa9cc829243ff3b02d511e2f55c42ea179ecbcf46aeb199d7c35e737348",
   "ko": "「마스터 테리온의 말대로네.\n　아무리 기사도에 뜻을 두어 봤자,\n　당신의 마음은 구원받지 못해」"
  },
  {
   "id": "da1203:T00121",
   "source_sha256": "e0ad3693fdf61773408246691eb7a83ad0fea31900b66dc25a3a6aaa84e499c2",
   "ko": "「그만둬…… 그만둬 줘……」"
  },
  {
   "id": "da1203:T00122",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da1203:R00015",
   "source_sha256": "4acedc9c6ff630a66f2e9f2f4c00c97d45487b8e67ba1ea1fffb0c06f1462faf",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00123",
   "source_sha256": "b35085ee2826216aaf9d9577c3e61cb02f1ce3326936f8f79b3194aafd2e5aaf",
   "ko": "수호하"
  },
  {
   "id": "da1203:T00124",
   "source_sha256": "084f745c57adea9d9b46eb4c8a1cb99987660a33a91b303f6cfa468ad4592041",
   "ko": "고 싶은 건 "
  },
  {
   "id": "da1203:R00016",
   "source_sha256": "4acedc9c6ff630a66f2e9f2f4c00c97d45487b8e67ba1ea1fffb0c06f1462faf",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00125",
   "source_sha256": "00968739327c103976c8da8660f41f59f30f16f8013cf537c97b80b2a0f0478e",
   "ko": "비호받"
  },
  {
   "id": "da1203:T00126",
   "source_sha256": "f8be3dd5741b48336f5e3230c415a6e451a13538c61c8ce4fd6bac49cad31fa9",
   "ko": "은 적이 없기 때문이야. 사랑받지 못하니까, 사랑하는 것으로 채우려 하는 거지?　갸륵하기도 해라, 쿠자쿠」"
  },
  {
   "id": "da1203:T00127",
   "source_sha256": "7520ec0dd41e6e2c48e2225ad588b88e79795aff90a5055a3494069aab744aec",
   "ko": "「아…… 아아아…… 읏」"
  },
  {
   "id": "da1203:T00128",
   "source_sha256": "c256c88dcda6975b76d6309b9e801e0a99da65024c440c50426b48ffa5bb12c5",
   "ko": "「하지만 말이지, 소용없어, 소용없다고. 당신은 부정당한 거야. 그 사실은 변하지 않아. 뒤집을 방도가 없어. 당신이 가장 바라는 것은, 결코 주어지지 않는 거야」"
  },
  {
   "id": "da1203:T00129",
   "source_sha256": "dce5b03759abbf4b4c9db09454fa2d5a8be0001f44b56d96dad962372cf6d986",
   "ko": "「우와아아아아아아아아아!」"
  },
  {
   "id": "da1203:T00130",
   "source_sha256": "c3b53f28ff0403f7f3bcd62e0955bd138d4329818febc04996cfc3fa8111e789",
   "ko": "눈앞의 어나더 블러드를 향해 총을 난사한다.\n\n　소녀의 "
  },
  {
   "id": "da1203:R00017",
   "source_sha256": "8672303472dc637d878a093ce960c2482af58061fc1b3a6e0b9a2b1a203a2201",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00131",
   "source_sha256": "101e8536327c0f2b2dcb11a5356a110fd822d2acb494e0bc36b1ae05b4f3aec3",
   "ko": "형상"
  },
  {
   "id": "da1203:T00132",
   "source_sha256": "fa8dcedd1ed0e2a3418e7de6b0c562b0f2d0fad964fa868d022d750325c8ff3c",
   "ko": "이 피안개가 되어 허공에 녹아든다."
  },
  {
   "id": "da1203:T00133",
   "source_sha256": "cf9f3489d1c328db1a766cb6afe12c08e0f1bcdf15ea89b1b49640ed677e6649",
   "ko": "온몸이 무거워졌다."
  },
  {
   "id": "da1203:T00134",
   "source_sha256": "6917d0b547dcd3ec5d6bef6f3d661ce64d5f1b1ea2fdf35efe315dac90de2df6",
   "ko": "휘감겨 오는 피안개."
  },
  {
   "id": "da1203:T00135",
   "source_sha256": "edc26977b71b45d8ca8473ad4fe3ba1487ccf913794a01a3581247954bdeeacc",
   "ko": "가느다란 손가락이 뺨에 닿았다."
  },
  {
   "id": "da1203:T00136",
   "source_sha256": "4fb17720258d9071aee631db9ef694648dffd9576ba40801245b4ba3ac017e71",
   "ko": "다시 실체화한 어나더 블러드가 등 뒤에서 나를 껴안고 있다."
  },
  {
   "id": "da1203:T00137",
   "source_sha256": "8c7e7e7602e36d4620686ebe78efcf15c4c08492bf7b3550d1913f2374cbee73",
   "ko": "「볼썽사납네……\n　아주 볼썽사나워요, 작은 기사님?」"
  },
  {
   "id": "da1203:T00138",
   "source_sha256": "83097f56bdc5adec7bd35eda515173f5b6fba985ab4eedfc5097d3e4a399e6e7",
   "ko": "손가락이 입술을 덧그리고"
  },
  {
   "id": "da1203:T00139",
   "source_sha256": "e135c37bb7054fa3967ab17175fa8b3fbc9157107ba55f7250a25684ceae8bc1",
   "ko": "「……무엇이 다르다는 거야?」"
  },
  {
   "id": "da1203:T00140",
   "source_sha256": "8a833e355143a84295622a6615b7f675d774f9d7d1197627b2cf66ef7c313c63",
   "ko": "목덜미를 혀가 기어간다."
  },
  {
   "id": "da1203:T00141",
   "source_sha256": "a5a2c73991698e422928c68a103b8cbca6a782190110ee1cd557164ad04ce7a8",
   "ko": "「당신과 나, 무엇이 다르다는 거야?\n당신도 나와 똑같이…… 누구도 필요로 하지\n않는, 무가치한 "
  },
  {
   "id": "da1203:R00018",
   "source_sha256": "c83d09288a91cba65388da926999234b69ebe4c1dad3efd7cf413e48f4bdd85e",
   "ko": "것",
   "ruby_action": "keep"
  },
  {
   "id": "da1203:T00142",
   "source_sha256": "4a558371f938b01d790207375865ed101b0826bdbda2e46b552b7910337d527a",
   "ko": "존재"
  },
  {
   "id": "da1203:T00143",
   "source_sha256": "171c2de00a12b340b3365467766ddffc3491a9f458d4188c0b041168ca0c8c04",
   "ko": "이잖아……\n그렇지, 쿠자쿠?」"
  },
  {
   "id": "da1203:T00144",
   "source_sha256": "05ba4b6f8a34d5342be367889c5222973a0e36696e17834f8c62c0c05ab942a0",
   "ko": "입술이 눌려 온다."
  },
  {
   "id": "da1203:T00145",
   "source_sha256": "0a91a3b4c69c5354c2b9e4ed2b2362111a6048063f65ad1356c302c005d93b51",
   "ko": "불현듯 날카로운 아픔."
  },
  {
   "id": "da1203:T00146",
   "source_sha256": "87fac91997136787faf42ce8dbbee930af3dca9fe1b8e877378cde7e144efdf0",
   "ko": "송곳니가 박힌다.\n\n　목덜미를 타고 흐르는 피."
  },
  {
   "id": "da1203:T00147",
   "source_sha256": "fc61c4a96002fdbf1ca4d0e462a7d196c27bdd1b56965b51d7243c2d038f8e1b",
   "ko": "미지근하다."
  },
  {
   "id": "da1203:T00148",
   "source_sha256": "c85f58a98a3284981cdf4d0dbd5f39aa80649e30622d8cc5e7476d956f0f4724",
   "ko": "「응…… 츄…… 읏…… 후후」"
  },
  {
   "id": "da1203:T00149",
   "source_sha256": "060058c47d02b39371484ff58c5d280ae6a8f9c2fbcca1a6a9086ba6fd0b214f",
   "ko": "흐르는 피를 정성스레 핥아 내는 어나더 블러드의 혀."
  },
  {
   "id": "da1203:T00150",
   "source_sha256": "333447ddc0fee17651759f53e03cd7b404e02d0906c9718b7c7e41ff6ecc0774",
   "ko": "지독히, 뜨겁다."
  },
  {
   "id": "da1203:T00151",
   "source_sha256": "9df7c2debf485db4be155f12ed8772c3cf0a2d7a054e3fcf905f073e33dcc5a1",
   "ko": "「받아들이렴, 쿠자쿠.\n　당신에게 주어진 저주를.\n　미움받으며 태어났다는 저주를」"
  },
  {
   "id": "da1203:T00152",
   "source_sha256": "7593998181f2802931cd8373d1b111de8cca9b85d61d50eb1d153ae3b8f2c35c",
   "ko": "붕괴한 영역에 무언가가 흘러들어온다."
  },
  {
   "id": "da1203:T00153",
   "source_sha256": "a0a97a4bee59233ac521d672db780e22a2ce2bc12702ccd9d34c14c65b43c6a6",
   "ko": "뜨겁고, 검고, 걸쭉하게 들끓는 무언가가."
  },
  {
   "id": "da1203:R00019",
   "source_sha256": "8d621c5b39c3b3fc1c4421e71d03d95bf11db997394b0b9280a4826168a392f6",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da1203:T00154",
   "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
   "ko": "공허"
  },
  {
   "id": "da1203:T00155",
   "source_sha256": "65d4705f1d94a91239e4dfe802961afd62801bc5a96c64a4e84fc2be59f5fdaa",
   "ko": "해진 마음을 채운다."
  },
  {
   "id": "da1203:T00156",
   "source_sha256": "ce105bd8cd7a364db108edcaaa8127d89f9ae1b4588285bf8b6d3c989081ae4c",
   "ko": "「그리고 풀어놓으렴. 당신의 마음 깊은 곳에서 숙성된, 방순한 증오를. 검을 잃고, 갑옷이 벗겨져야만, 당신은 비로소 자유로워질 수 있어……」"
  },
  {
   "id": "da1203:T00157",
   "source_sha256": "77aa2bc306d761507316cd5566c855750b282fd41c495442e715b828a282e5ae",
   "ko": "두 기의 기신을 집어삼킨 빛."
  },
  {
   "id": "da1203:T00158",
   "source_sha256": "131e4a8d072deab741def19d31e645131335b355dcc85a60746d2ad3f1fa5886",
   "ko": "그 너머에 다른 그림자가 있다."
  },
  {
   "id": "da1203:T00159",
   "source_sha256": "799d1be1ef707c0aa66de76d553613a27ef9dcf25d1cfecbdfa5581dc7d76c90",
   "ko": "――데몬베인."
  },
  {
   "id": "da1203:T00160",
   "source_sha256": "62557e1294b5bf48d791a6a5aad7977ac321867b53e1617036da0413480e6ac7",
   "ko": "그 모습을 확인했을 때, 마지막 영역이 산산이 부서졌다."
  },
  {
   "id": "da1203:T00161",
   "source_sha256": "e2fb71dcfa4f609212c02b4dbd5501cd1dea0b7a906909d296ead18052805d9b",
   "ko": "암흑이 나를 뒤덮는다."
  },
  {
   "id": "da1203:T00162",
   "source_sha256": "4669271244f65312b03fa5ae28aa2617d5ef6b5aa6bdf9df70f618525b54e8ed",
   "ko": "「아하하하하하하하하하!\n　그래, 그거면 돼, 쿠자쿠!\n　자, 원망과 함께 노래하렴!」"
  }
 ],
