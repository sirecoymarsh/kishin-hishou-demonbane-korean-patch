{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0018_da0115",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0115:T00001",
   "source_sha256": "9fd06584cfb76ff6e7c2d148a6a2af7da9527f343a4f052b713db7ab2c2a0411",
   "ko": "「……아미티지 영감님」"
  },
  {
   "id": "da0115:T00002",
   "source_sha256": "781b21b7454ac052ebd2a1cc1c964fbfcc891d226b1589bfd4098870a906cbbc",
   "ko": "「잘 왔군, 다이쥬지」"
  },
  {
   "id": "da0115:T00003",
   "source_sha256": "2631f28f546ddf1ca98def3fc5b166f2db8ae470fc9e9527782ace7580c938f7",
   "ko": "「그리고…… 어라」"
  },
  {
   "id": "da0115:T00004",
   "source_sha256": "65581ff91ffdb211afe80e99edb052e2aca50d70f8df452c1834fd4286ab6e88",
   "ko": "「워런 라이스다.\n　직접 이야기를 나눈 적은 없었던가」"
  },
  {
   "id": "da0115:T00005",
   "source_sha256": "7819df6be239917cd27e0918c3802869a3e8a7c4a03a69c1f2004cea017400d1",
   "ko": "「아, 안녕하십니까…… 다이쥬지 쿠로입니다」"
  },
  {
   "id": "da0115:T00006",
   "source_sha256": "d9970996f4ce26b9200c5dd610969b9cf174f70617edc7e4096272b8bc3a011a",
   "ko": "「자네에 대해서는 아미티지 박사에게\n　들었네」"
  },
  {
   "id": "da0115:T00007",
   "source_sha256": "fb81901eb8fe446ca57cb01f83726953fb8c2e4c990f672cae75c56b04c24de6",
   "ko": "「하아……」"
  },
  {
   "id": "da0115:T00008",
   "source_sha256": "80fae361a6f339bf828366292b43b4f1dd79633f3c26aa0b2107dcf88c6b7fda",
   "ko": "「진성 "
  },
  {
   "id": "da0115:R00001",
   "source_sha256": "de0083c2c955d2df6f2ba9e4637d9d10b44c88cc609e5d53e0202a32ae3bb989",
   "ko": "페도필리아",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00009",
   "source_sha256": "6001c360964d3e21f876b5e3e1e655c672d24a92eec7772ad0f4af65abb57c17",
   "ko": "개자식"
  },
  {
   "id": "da0115:T00010",
   "source_sha256": "07059f74730a77eb7384c79a031f07486bce39ace0421e7969919c6febd1e254",
   "ko": "이라던가」"
  },
  {
   "id": "da0115:T00011",
   "source_sha256": "2b0917a937c8d8c1a6ca4e61eab46a756dcc484a1347d334a5dd25ec93dcb53c",
   "ko": "「뭘 불어넣은 거야!?\n　아미티지 망할 영감탱이이이――――!」"
  },
  {
   "id": "da0115:T00012",
   "source_sha256": "98e18d2c9dcd56dccdfc13874f99082e3a1634d4b1cbd80e20b52f5e32797f9a",
   "ko": "ｂ＾ー゜）"
  },
  {
   "id": "da0115:T00013",
   "source_sha256": "92be646fb428927474de514f84756182459cfb176ea64438c759a2c1f0ee1901",
   "ko": "――죽이자."
  },
  {
   "id": "da0115:T00014",
   "source_sha256": "047c28d9704b4f4c0645464c6609e92416637833380f354ef20b4b0f729c7db3",
   "ko": "「주, 주인님……\n　빨리잉, 약…… 약……\n　주세영…… 읏」"
  },
  {
   "id": "da0115:T00015",
   "source_sha256": "374572da24af64f3e690141ca2881bec8abb7e7aae45713efb94229092865424",
   "ko": "「날 함정에 빠뜨릴 찬스는 결코 놓치지 않는구나, 네놈은!?」"
  },
  {
   "id": "da0115:T00016",
   "source_sha256": "8777710ef5d32e8d020e25c4e49b11eea05252721ed7aad1f6566e4c9e02973a",
   "ko": "「프랜시스 모건입니다.\n　저는 대외적으로는 의학부에 속해 있어서,\n　음비학과와의 접점은 옅습니다만」"
  },
  {
   "id": "da0115:T00017",
   "source_sha256": "aa0bf9056c21db46295616dcd665942fb3bcbf0875242d47a7b77ece57a026cb",
   "ko": "「아아, 잘 부탁해……」"
  },
  {
   "id": "da0115:T00018",
   "source_sha256": "b04aab30d6587bfd4a0a08d0ac4ab95493bc1e06271f2ac2866a3e3bfb6344c8",
   "ko": "「덧붙여 전공은 비교해부학이라서, "
  },
  {
   "id": "da0115:R00002",
   "source_sha256": "de0083c2c955d2df6f2ba9e4637d9d10b44c88cc609e5d53e0202a32ae3bb989",
   "ko": "페도필리아는",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00019",
   "source_sha256": "988c43adbd5f7e866d236aa1eba7cecac22b3e13d9a96216c72b34c2f319f873",
   "ko": "정신병은"
  },
  {
   "id": "da0115:T00020",
   "source_sha256": "3f054d70eafab63eb465c0ce655375a2b660df4ac36de671e662b61abea2f654",
   "ko": " 전문 외입니다.\n　도움이 되지 못해 죄송합니다……」"
  },
  {
   "id": "da0115:T00021",
   "source_sha256": "a3b1f08d0fd7ad0a200dd76bfed96ff40ee08a71888e9b6494485543b3408e59",
   "ko": "――전원, 죽이자."
  },
  {
   "id": "da0115:T00022",
   "source_sha256": "6a13985666dfd3d384bc7661e3ebe2ced248c7404174c9d3e412b1369fbe9fec",
   "ko": "「병들어 있네, 대디」"
  },
  {
   "id": "da0115:T00023",
   "source_sha256": "25aa32552380290224c239cd52fa29fac9a0971178cd5e3525efae36ab2e767b",
   "ko": "「참으로 한탄스럽구나, 레이디」"
  },
  {
   "id": "da0115:T00024",
   "source_sha256": "8ed5d380c33c38fb842887132ecb9464f5e55d95d01e3d41f2c14e3887da2e30",
   "ko": "「닥쳐. 로리 "
  },
  {
   "id": "da0115:R00003",
   "source_sha256": "de9694937697c65f68f690611ade72dc171bb979f772044b04b25e41e027be17",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00025",
   "source_sha256": "043fec4b699455b6283990888b4f091a285860089f3fcca75f43b7f3fc50bc3e",
   "ko": "거느"
  },
  {
   "id": "da0115:T00026",
   "source_sha256": "a3946008dc786133d24da42737fb93e82c58a2d9a73a74058c97d650359634b4",
   "ko": "린 영감탱이」"
  },
  {
   "id": "da0115:T00027",
   "source_sha256": "888353b45d4c4b3947a78888ec74dfe89b7ea91c690bfce337f70774f3ad6399",
   "ko": "「뭐, 나도 모건 박사도\n　자네와는 한 번 만난 적이 있다네만」"
  },
  {
   "id": "da0115:T00028",
   "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
   "ko": "「……?」"
  },
  {
   "id": "da0115:T00029",
   "source_sha256": "7d525af68bd48b1370bdfecf2ca9093b584dd078df5f1391cd3660df9548948c",
   "ko": "「윌버 웨이틀리가 "
  },
  {
   "id": "da0115:R00004",
   "source_sha256": "b34cc9b424270a797f120fcc1c8c497d805f6c5d72257c1d26898321e55548fd",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00030",
   "source_sha256": "081a3f6c063f563051b41145e8624be44c65b18bc6ecb082225fb5b4436e05a7",
   "ko": "끔찍"
  },
  {
   "id": "da0115:T00031",
   "source_sha256": "c2c6142525ce68472918d092a5a8154e1306ff4e66fc13bbb91828adc7e5b784",
   "ko": "한 정체를 드러냈던 그날 밤, 우리도 대학에 있었거든」"
  },
  {
   "id": "da0115:T00032",
   "source_sha256": "0498b351f694a6332c7f83344a73f3feba1d85c786b178b2df4b3f5c2ccc3da8",
   "ko": "「……과연」"
  },
  {
   "id": "da0115:T00033",
   "source_sha256": "ce3e666f32812af8c3e76990f422757e499b712d9933ec06fa50a212b7869137",
   "ko": "「나와 라이스 교수, 모건 박사――\n『더니치의 괴이』에 관여했던 세 사람에,\n크툴루 교단과의 싸움에 몸을 던져 온\n슈루즈베리 박사. 여기에 있는 멤버는\n모두 사신의 위협을 아는 자들이다」"
  },
  {
   "id": "da0115:T00034",
   "source_sha256": "cdc28e4bdf185610f338db72b701ab1a24747d5266ebd1a26949b106e79610f3",
   "ko": "「자네도 마찬가지다――\n　마도탐정, 다이쥬지 쿠로 군」"
  },
  {
   "id": "da0115:T00035",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0115:T00036",
   "source_sha256": "9ddc4607cea16d874c4338551b285b7b725c23501da7e2bcb748a2c63cad5761",
   "ko": "「그래서…… 우는 아이도 입을 다문다는\n　특수자료실이 우리에게 "
  },
  {
   "id": "da0115:R00005",
   "source_sha256": "5d26c59885abc6d2e455ab9d631fc3b70e5ce2493dfffc543b94c4463f91d5e7",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00037",
   "source_sha256": "ba391edb2f864d7c65fff32c5cb6201a78af22c43edf28c04b4a1cfe8fac615c",
   "ko": "무슨 볼일"
  },
  {
   "id": "da0115:T00038",
   "source_sha256": "c54eae94b1f5ba181d6e4a34abf47f71bff51d9b6cd94cccd70058e4faef0bac",
   "ko": "이냐?」"
  },
  {
   "id": "da0115:T00039",
   "source_sha256": "14e1080e60c4b61d9c54d0ac9e1cd4c90f2e195365bf510c94ae91df4f8a6b33",
   "ko": "「아참, 설명하기로 했었지」"
  },
  {
   "id": "da0115:T00040",
   "source_sha256": "7cdbf59647e1f359d1cc078cdda2296bf0b4c979b58322c758b4dcc818a6e19c",
   "ko": "「그래. 이번에 자네를 이곳에 부른 것은\n　다름이 아니라네.\n　지금 아컴 시티를 떠들썩하게 만들고 있는\n　『피의 괴이』에 대해서다」"
  },
  {
   "id": "da0115:T00041",
   "source_sha256": "597748aa4eaa866b872dfaf6cbcd8be2421fa6b689eb762533bf25f1d5d8c84f",
   "ko": "「…………」\n\n　이쪽에서 "
  },
  {
   "id": "da0115:R00006",
   "source_sha256": "ec37261c182afd7b9e657a1c42339e621ace66dd649b76c711b7dc9e4a066623",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00042",
   "source_sha256": "ef89046ee45f875011623e96bbd62b52e56beb7dac7cd71b5813b55eb6c5876b",
   "ko": "물어보"
  },
  {
   "id": "da0115:T00043",
   "source_sha256": "01c84f18bf98e2d66793af415ac36be5da3e8030c3432baeda32ccdb55321547",
   "ko": "러 갈까 고민하고 있었는데…… 수고를 덜었나."
  },
  {
   "id": "da0115:T00044",
   "source_sha256": "23e7b12122e03d354a97d042838d5e2aa4514dcd5e8597a0434c193df89ecb56",
   "ko": "「그 사건은 생각했던 것 이상으로\n　심각한 사태입니다」"
  },
  {
   "id": "da0115:T00045",
   "source_sha256": "2e687e4ac9154dddba029aab6a57911d45916783ce61a802935fd01ae6667c66",
   "ko": "「……그런 모양이군」"
  },
  {
   "id": "da0115:T00046",
   "source_sha256": "388107922002e1825a99ee55ef0221886a495126c81df06532af60288e163ad7",
   "ko": "「어젯밤 일이나 방금 전 일도 신경 쓰이겠지만, 순서대로 설명해 나가도록 하지. 아미티지 박사」"
  },
  {
   "id": "da0115:T00047",
   "source_sha256": "c854fa4e5883c6a7a0d572ea3836616bc9e2912323ef05a3bc625193a98ddf72",
   "ko": "「음……」"
  },
  {
   "id": "da0115:T00048",
   "source_sha256": "cbb89daf5bcd0eaebd23d29faeec0be84a6226d43d48bda91c8a6b531307f394",
   "ko": "「『네크로노미콘』이――」"
  },
  {
   "id": "da0115:T00049",
   "source_sha256": "eec6e9bc8fa4672ad3a0bc5b58e091cbe1983bfc0735fd5ab8a7b0a32ed23e87",
   "ko": "「강탈당했다고?」"
  },
  {
   "id": "da0115:T00050",
   "source_sha256": "6865a3ccc995e6d298f64ad92e9fc2dad8a72687bcd95c83aefdd5382fc0bc3c",
   "ko": "「한심하게도 말이지」"
  },
  {
   "id": "da0115:T00051",
   "source_sha256": "1e1e3808a283c6527081e67d5e051c39986b247cbf1c5eebf32a42c6b2af45f9",
   "ko": "우리는 아미티지 영감님에게서 비밀도서관에서 일어난 사건의 전말을 들었다.\n\n　그 피의 괴물은 비밀도서관에까지 마수를 뻗치고 있었던 것이다."
  },
  {
   "id": "da0115:T00052",
   "source_sha256": "8f4129885a76edfbdd486d146cc3ccf7f92617b8382f3d3e0dc30d5b7320112d",
   "ko": "게다가 그 『네크로노미콘』을 강탈해 가다니……!"
  },
  {
   "id": "da0115:T00053",
   "source_sha256": "1c9792cdb379f27021782812438e861b6bec295d95d8031c4e6eff251e8729b1",
   "ko": "「그럼 마치 『더니치의 괴이』의 재림이잖아!?」"
  },
  {
   "id": "da0115:T00054",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0115:T00055",
   "source_sha256": "95d72deca9a6a6df9661e3861598614a4db249eb2df51b83af59a86865bbac94",
   "ko": "내 말에 "
  },
  {
   "id": "da0115:R00007",
   "source_sha256": "f500b3b07ce5e1c78cea612abb66d3588db1a3d5f643d93cef377aa44a1bb902",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00056",
   "source_sha256": "35a943e91674e6810e3dd5a0ff24ff4394f2cc1cc69507793c00df777138ff41",
   "ko": "그"
  },
  {
   "id": "da0115:T00057",
   "source_sha256": "9ecba4da9c934255a43dd2ca5db1ac0528c164cf46f219cd05cf5ca7f64ccd8b",
   "ko": " 사건에 관여했던 세 박사가 일제히 입을 다물었다."
  },
  {
   "id": "da0115:T00058",
   "source_sha256": "b1ba5acb434a84201e6a4632f035a8254ad4279d314bbeaf40b318b6821f81de",
   "ko": "무거운 침묵."
  },
  {
   "id": "da0115:T00059",
   "source_sha256": "aefd37ce046b92c571e32d9f2be90faa66b89876e150fa56c6a0c722040f4574",
   "ko": "잠시 후, 아미티지 영감님이 험악한 표정으로 고개를 끄덕인다."
  },
  {
   "id": "da0115:T00060",
   "source_sha256": "f1559411ff5a50c28d19437a370e985faf83cbd8ac4b39ce5f7461abf77e79bc",
   "ko": "「바로 그 말대로라네」"
  },
  {
   "id": "da0115:T00061",
   "source_sha256": "db1f0d380f2ba20e36506e4807098001294d5166a370ebdc81807c38601c2e2d",
   "ko": "「어?」"
  },
  {
   "id": "da0115:T00062",
   "source_sha256": "eb9cf23e97f772754e11ca6f60ca01289e487ce967c3fa6365ddd005994add80",
   "ko": "「그 냄새…… 끔찍하게도\n　또렷이 기억하고 있었습니다.\n　잊고 싶어도 잊게 해주지 않는\n　모양입니다」"
  },
  {
   "id": "da0115:T00063",
   "source_sha256": "1f6373a804a9b32bf8ca3032abf8d1966fa93083aaa9bde68f0643ca2b3933d6",
   "ko": "「……아미티지 박사께서는\n　보셨군요?」"
  },
  {
   "id": "da0115:T00064",
   "source_sha256": "6ba55fd26b9b36a7419514a5bd023c8b14b62fcc0d10ad51cee27992a0d3789b",
   "ko": "「그래. 그 피의 괴이에게 소환된 것은――윌버 웨이틀리의 형제임이 틀림없다」"
  },
  {
   "id": "da0115:T00065",
   "source_sha256": "ee445a90a39d7db797ead50e7a8ac22b81e88afddb8a4aa0a341e9fea6e7be46",
   "ko": "「뭐라고!?」"
  },
  {
   "id": "da0115:T00066",
   "source_sha256": "89f266ea718106872a5ee4bfef0572a907ee8821f89ddc51b56996daf2c07202",
   "ko": "「그럴 리가!」"
  },
  {
   "id": "da0115:T00067",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0115:R00008",
   "source_sha256": "ad00a0b322492061745b24d0a27cfeb54340097e166853622a9781f99bd15efb",
   "ko": "・・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00068",
   "source_sha256": "e33cb38f4e50ca4b744ca8cd4fa320856cd3c67fe274e41b7494b318332e7764",
   "ko": "그럴 리가 없는"
  },
  {
   "id": "da0115:T00069",
   "source_sha256": "cad8b5a8210f55579f9b117babaf6c250ec685ff04d3496854af2887b7050725",
   "ko": " 사태가 계속되고 있다네.\n　내가 조우한 괴이도 그렇다」"
  },
  {
   "id": "da0115:T00070",
   "source_sha256": "def96a9cf799263ab57188238216706daf79d06925c7b0de158130a6f6addf7a",
   "ko": "「어제 사건인가」"
  },
  {
   "id": "da0115:T00071",
   "source_sha256": "eb0d3ee6d7f26195fa87f137d2abbaf1b88f29b5ba632b34e3b4c6303e7652ad",
   "ko": "「드디어 본론으로 들어갔군」"
  },
  {
   "id": "da0115:T00072",
   "source_sha256": "32d5a93121e40baf04bf9fbba292daa194b2b82e6b2c76823df194e45980268c",
   "ko": "「내가 어젯밤 교전했던 그 괴이는――"
  },
  {
   "id": "da0115:R00009",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나를",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00073",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신을"
  },
  {
   "id": "da0115:T00074",
   "source_sha256": "dbf68877b98179c30077970244497e9b444d3a6bdff24350d50dbc3b0f88abc3",
   "ko": " 소환했다」"
  },
  {
   "id": "da0115:T00075",
   "source_sha256": "fa40d2b5a3a24e40253bf3bf6bc7726242f4f251994cd54f230c7b5adf4be3db",
   "ko": "「뭐……라고!?」"
  },
  {
   "id": "da0115:T00076",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0115:R00010",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나라고",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00077",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신이라고"
  },
  {
   "id": "da0115:T00078",
   "source_sha256": "e5a0c43b7f9a4f99a9f263f11bf3aa0e727b1fb6a2eb1e0d915cde27845970b6",
   "ko": "……!?」"
  },
  {
   "id": "da0115:T00079",
   "source_sha256": "000b57ca6ca9d1b61edd680cafd1fbfca8ab179b7c39aa6e4b267c1b9959cfd2",
   "ko": "「그 구획의 파괴 흔적은 "
  },
  {
   "id": "da0115:R00011",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00080",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신"
  },
  {
   "id": "da0115:T00081",
   "source_sha256": "abaea02a841d1ecb849089c1eee97ee1403b403a8254995f8b7315b2dfba742c",
   "ko": "의 공격에 의한 것이다."
  },
  {
   "id": "da0115:T00082",
   "source_sha256": "71efcf278e5f16f9162d26415a1cccfd41598d370d92e2e3de40a7bb9de0ab98",
   "ko": "그리고――」"
  },
  {
   "id": "da0115:T00083",
   "source_sha256": "c941785e1f653232b8561319bd71700a1d85dc859fbf23bdb1e29d864efb7aed",
   "ko": "「그 "
  },
  {
   "id": "da0115:R00012",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나가",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00084",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신이"
  },
  {
   "id": "da0115:T00085",
   "source_sha256": "32d4bbdcf4525dcf1b59256b5b3403a143060347518aaa3444334d898d3f1e43",
   "ko": " 이어받은 힘은 하스터.\n　나와 같아」"
  },
  {
   "id": "da0115:T00086",
   "source_sha256": "21cbc2216cd9810a5625bbe7b150c0db754b64cc43bcf7e16f69c45bc1901e25",
   "ko": "불길한 예감은 최악의 확신이 되어 가고 있었다."
  },
  {
   "id": "da0115:T00087",
   "source_sha256": "cc7aa15979ceec0ffe30ac8c3b12ca129cdd5ea9fe7715905c838a4e9d7e124a",
   "ko": "하스터의 마력을 이어받은 귀계신."
  },
  {
   "id": "da0115:T00088",
   "source_sha256": "148a1c4f537df7c36e851ec40a41ab22370d5a5602fc27cce428a590d063bab1",
   "ko": "그 녀석은 역시――"
  },
  {
   "id": "da0115:T00089",
   "source_sha256": "dfbd2cfe45d0d9891c42f3f7ce3fbc6ea1351d56449c241e18c07dab1f673316",
   "ko": "「성격 비틀린 망할 꼬맹이는 있었어?」"
  },
  {
   "id": "da0115:T00090",
   "source_sha256": "ce258b7d5d71afd68ab8be2f1599fc08c6d91ddd9774fd41c81d897404f24ac4",
   "ko": "「……뭔가 알고 있는 모양이군, 다이쥬지 군」"
  },
  {
   "id": "da0115:T00091",
   "source_sha256": "f9fe3fffa62913775576a6079484d2735d05dd43cdadc014db7e1508ea863655",
   "ko": "「……로드 비야키!」"
  },
  {
   "id": "da0115:T00092",
   "source_sha256": "e1d62cacf76014256acceed0ba890aea9e23e42b77f16e6241a876f2636cf29e",
   "ko": "베스파시아누스."
  },
  {
   "id": "da0115:T00093",
   "source_sha256": "bf316f0861c38056fc07a2b5d2c5d0ab4a5ad229442d6b5b3ff952f88e789bc4",
   "ko": "산달폰."
  },
  {
   "id": "da0115:T00094",
   "source_sha256": "72d8c7a6a58f3226ac586b546850c3982175033e308ce6d5bfd15b7a16595656",
   "ko": "그리고 클라우디우스.\n\n　존재할 리 없는 악몽이 이걸로 세 명."
  },
  {
   "id": "da0115:T00095",
   "source_sha256": "76a8ce93d3858e3dbeb08728d6140bf642a60742ea4bb7052774cefbe043b9e6",
   "ko": "다른 안티크로스도 되살아났다고 보는 편이 좋을지도 모른다.\n\n　하지만 어째서야……"
  },
  {
   "id": "da0115:T00096",
   "source_sha256": "e4b9d8692acd68144dcd902c15029fb61710251b526a231c39b70e193e9d3e30",
   "ko": " 어째서냐고."
  },
  {
   "id": "da0115:T00097",
   "source_sha256": "7ab1a37d2bd69b90e22e28b9bcb2362ed63dbee6bcb22be8519e4e025d99cdae",
   "ko": "세계는 사신의 음모에서 해방된 게 아니었단 말이야!?"
  },
  {
   "id": "da0115:T00098",
   "source_sha256": "ce9894dd1dcefc89d06f2aa5c3216efb39abcca28d234cd90028df3576e4a8af",
   "ko": "「아까 그 "
  },
  {
   "id": "da0115:R00013",
   "source_sha256": "7cb07290171eee19ddd9841767e50733114564820dbecf8e3797cb88a0f7464b",
   "ko": "미스터",
   "ruby_action": "keep"
  },
  {
   "id": "da0115:T00099",
   "source_sha256": "38d1c7bdc8b842bb6a7c4222de72fd250a00ade86121c0d03dc7305b8e1cece0",
   "ko": "신사"
  },
  {
   "id": "da0115:T00100",
   "source_sha256": "d2d1aafd5f49aab590360359d866eac4d164cfdf22b18f3d3cd71d09ed25d53c",
   "ko": "도 보통내기의 마술사가\n　아니다. 자네는 무엇을 알고 있지?」"
  },
  {
   "id": "da0115:T00101",
   "source_sha256": "948085f8eba7c8c6a8521405e25dadbe40d35b5602b2f925e6b6caf896629050",
   "ko": "「…………」\n\n　뭐라고 말해야 좋을까."
  },
  {
   "id": "da0115:T00102",
   "source_sha256": "c445ab998cc082f92cfadf14b1f5d165cc22923d09720a3372cc1155a4a00664",
   "ko": "존재할 리 없는 것을 어떻게 설명할 수 있단 말인가."
  },
  {
   "id": "da0115:T00103",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0115:R00014",
   "source_sha256": "b3240903b6495213199662445c04d0df4b438f83cc1cb21bb961409692e6371a",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00104",
   "source_sha256": "1df0f52452060e9b83b9cf41cb502beda2e3e5ab2264599c6f6ed417f3fcfe7e",
   "ko": "그놈"
  },
  {
   "id": "da0115:T00105",
   "source_sha256": "49848c356df4a66bbdea7ccf03dd2deacf03d5f61020b1bf89414b7ea34f6f72",
   "ko": "은……\n　아니, "
  },
  {
   "id": "da0115:R00015",
   "source_sha256": "a15080cb2a7504ce7e0c117ebd9aa5e27751c18b8f28e1eff155a5e929d6fd06",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00106",
   "source_sha256": "93f78c90d795e4c136c34c276355fc7d2924eb86181fd134054102cbfd358861",
   "ko": "그놈들"
  },
  {
   "id": "da0115:T00107",
   "source_sha256": "554b510cc31dcf2c67070f11e4d9b5945a559602e51844c5780de8561697b6c1",
   "ko": "은 이 몸과 쿠로의 적이다.\n　하지만 멸망했을 "
  },
  {
   "id": "da0115:R00016",
   "source_sha256": "6c792a3f91b2639d5e0408d3fb637e0ee57579601bed93e3d77cd6427a47f4fd",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0115:T00108",
   "source_sha256": "4472a73077c6d34fb2dc67a8da86c52b107fdd7134d101784941f50f1fcb3765",
   "ko": "터"
  },
  {
   "id": "da0115:T00109",
   "source_sha256": "0580068b40d23ab18d039c0f17cd99866d7cc7161961b1579f0edf953584ff67",
   "ko": "다」"
  },
  {
   "id": "da0115:T00110",
   "source_sha256": "d173e795b288107125fb4c0721edfc3b7e8f4bcb8262f132609241f967b0d9e8",
   "ko": "「멸망했다던 적……이라.\n　웨이틀리와 같군」"
  },
  {
   "id": "da0115:T00111",
   "source_sha256": "953f6566f87a297d3f8f91b35070b4413a4f2c7ec109ee1871c65c0b8d14c69a",
   "ko": "「역시 사태는 심각하군요」"
  },
  {
   "id": "da0115:T00112",
   "source_sha256": "d585e6a9f7d24e25c72853b51f35c51a55d0d2c7d5488cb920a1a3fe49b1d7ed",
   "ko": "「다이쥬지 쿠로.\n　그리고 마도서 『알 아지프』의 정령이여」"
  },
  {
   "id": "da0115:T00113",
   "source_sha256": "967be118d205039daa2ff5aeffb7664ceefcc7699bef8cb761232a8ff4e1a388",
   "ko": "아미티지 영감님은 진지한 눈동자로 나를 똑바로 바라보았다."
  },
  {
   "id": "da0115:T00114",
   "source_sha256": "286f7617d136f8c783ce890cb58d363fb84a9ebedc20346d65bb45addfb215b0",
   "ko": "팽팽해지는 긴장감 속에서, 나 또한 아미티지 영감님에게 시선을\n돌려준다."
  },
  {
   "id": "da0115:T00115",
   "source_sha256": "10e62e24675843941717b619c14d6912e85d6a68b32556a7fa65aab4dcaf2d72",
   "ko": "「무엇이냐」"
  }
 ],
