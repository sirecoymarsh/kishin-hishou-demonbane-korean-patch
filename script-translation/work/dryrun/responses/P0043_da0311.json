{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0043_da0311",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0311:T00001",
   "source_sha256": "597043aaa45b56ec724baa49a2dcf2aa4428005eca02e5691ef1d508f8338a4d",
   "ko": "「크…… 아아……앗」"
  },
  {
   "id": "da0311:T00002",
   "source_sha256": "269536c078b547e264ac1412f8c667c9a14d9d1319278d58c5eba351abfab9c8",
   "ko": "전신을 조여 오는 썩은 내장의 촉수."
  },
  {
   "id": "da0311:T00003",
   "source_sha256": "12f050831238dcf43f754b323d5b91576489bf5718bc3b8ce854af327490cfa0",
   "ko": "썩은 고기가 미끈거리는 감촉과 구역질을 유발하는 부패취에 루리는 "
  },
  {
   "id": "da0311:R00001",
   "source_sha256": "b95f35b771688da93e2f90ede90b2c8d8caa8bc9e8c7ff7b3448c85233bee856",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00004",
   "source_sha256": "6bbdde47dd516ebdfef93051e550cb674fc426cbdfcb5bd6ce199d771effa47e",
   "ko": "몸서리"
  },
  {
   "id": "da0311:T00005",
   "source_sha256": "2084abdee73a54318a7e01fe514dcc5f2e3187f8c360320b1a496839a4a66f69",
   "ko": "쳤다."
  },
  {
   "id": "da0311:T00006",
   "source_sha256": "879466fff606ceb1dbf0c8efc2be8d7f9054bdf986089e45a3fa9e9c3c3b5b3e",
   "ko": "그 표정에 가학적인 욕정을 자극받아 가면의 광대는 "
  },
  {
   "id": "da0311:R00002",
   "source_sha256": "2895ce20a7385bc2cc182870401439c7986e12de3e6b4a814eefe718fb782e64",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00007",
   "source_sha256": "0f55c1b29730d09eae296e101a12467fa6fb8c9c44d1f69a49f9df47be9fee35",
   "ko": "비웃"
  },
  {
   "id": "da0311:T00008",
   "source_sha256": "16a5f3b27585b6e9d0ae2d1e67d1ec73dd01024e63ff09aa46d6070ada014b5d",
   "ko": "는다."
  },
  {
   "id": "da0311:T00009",
   "source_sha256": "aec384af55a0e18b69c2093982ca89e9a7a48dc97d338f70255e0b82699c23c1",
   "ko": "「변함없이 맛있어 보여서 기쁘단다앙,\n　루리 아가씨이~?」"
  },
  {
   "id": "da0311:T00010",
   "source_sha256": "31c43e3e5a5175c7f878d61650115166fb8eaab4832083ef4a634eab5c1ca395",
   "ko": "「아아…… 크으윽……\n　당신…… 인간이 아니군요……?」"
  },
  {
   "id": "da0311:T00011",
   "source_sha256": "981ac7a0933d8fd1e320af492c9f95f49ffda1156829ee637156cbf7d8f7bfa9",
   "ko": "「실례네~, 『전』 인간이란다?」"
  },
  {
   "id": "da0311:T00012",
   "source_sha256": "54000b8eda2676968afb988f23dd8c1fb7359cec55c992c94cdcde9df6fd0657",
   "ko": "말하며 가면을 벗는다."
  },
  {
   "id": "da0311:T00013",
   "source_sha256": "931d2f5c18e03d58d63a1b9d42c7a9aa9bc98e86788e62ae056731c6adcd5373",
   "ko": "그 아래에서 드러난 맨얼굴을 보고 루리는 비명을 흘렸다."
  },
  {
   "id": "da0311:T00014",
   "source_sha256": "8adb98f413696c585d2286744802d62a40cd16cd166a749054933201d53384d2",
   "ko": "「히익…… 시, 시체……!?」"
  },
  {
   "id": "da0311:T00015",
   "source_sha256": "0bc9354ec92160a6812b02aba08c73e8f5b5dc94b043a80892e8e31bb4c153d3",
   "ko": "「어머앙?\n의외로 반응이 얌전하네잉?」"
  },
  {
   "id": "da0311:T00016",
   "source_sha256": "312d433ad8ef816dd8741c305070cb9ad49a3dafa344dde69654952107ec6cb7",
   "ko": "「아…… 아아아…… 아아아……앗」"
  },
  {
   "id": "da0311:T00017",
   "source_sha256": "8365c63f9ba1a1ae3b4a46d926d4ee993aabfc283e7e721acbff4c35c97de766",
   "ko": "「너무 흥분해서 목소리도 안 나오는 걸까나?\n　후후……」"
  },
  {
   "id": "da0311:T00018",
   "source_sha256": "755735e503b7ef60331a7b68d5f28b136392396b572f3ba0456d127694db7a34",
   "ko": "「이게 무슨…… 나쁜 꿈인가요……읏」"
  },
  {
   "id": "da0311:T00019",
   "source_sha256": "9d5b83a8aeb946d03c3c75b98194fd19f3469429bde7d556e99f997b3732b239",
   "ko": "「꿈?　꿈이라~……?\n　오호호호호호호호호호홋!」"
  },
  {
   "id": "da0311:T00020",
   "source_sha256": "de598562757f927052a160152b8b7e80dd8b0eb557776a15e7f82027716d0a17",
   "ko": "「그래…… 이건 나쁜 꿈이야. 하지만 말이지, "
  },
  {
   "id": "da0311:R00003",
   "source_sha256": "92cabe635b04a042f6f42cf8105339b21504a712e2c78e8c3c0eefdacc0a7c19",
   "ko": "퀸",
   "ruby_action": "keep"
  },
  {
   "id": "da0311:T00021",
   "source_sha256": "ab5f3c6eef8451ef0662aea8896eea9c59db79bd7f1c067afa3b03d296580b53",
   "ko": "총수"
  },
  {
   "id": "da0311:T00022",
   "source_sha256": "062a345406a788f4f1ba0555be713fcc7477ace21a879f5ad79be71013968c4f",
   "ko": "?」"
  },
  {
   "id": "da0311:T00023",
   "source_sha256": "8a9ead8f5d9a83fa76ee51d78725579b917ac0d963de71771a67d58ea9d1be74",
   "ko": "루리의 시야가 붉게 흐려진다."
  },
  {
   "id": "da0311:T00024",
   "source_sha256": "b6ed12963f4a14d1ba73999d29c3208a7707a8fcd0bc7aba695fcc27b3dfadfe",
   "ko": "피의 안개가 그녀를 감싸고 있었다.\n\n　아련한 소녀의 모습이 안개 속에 떠오른다."
  },
  {
   "id": "da0311:T00025",
   "source_sha256": "ef5227561a02faa85a148342df60f46c5175a920ce0980161da29da3150ef26c",
   "ko": "붉은 유령이 루리의 귓가에 살며시 속삭인다."
  },
  {
   "id": "da0311:T00026",
   "source_sha256": "229a8a8f4c76752ec19bf685425619d9957f14085441690027aa4281ca3ef69a",
   "ko": "「――이건 현실을 침식하는 꿈」"
  },
  {
   "id": "da0311:T00027",
   "source_sha256": "343102fe6c8c993d452c70b0abc7b3a6a1e92408b7a7741d0d5dfca30d589fa7",
   "ko": "그러나 소녀의 존재를 루리는 인식하지 못하고 있다."
  },
  {
   "id": "da0311:T00028",
   "source_sha256": "95ad3512c717c8733979491074e1615a3ebb62dc9bc6cc03926b130cfec09e8c",
   "ko": "눈동자는 여전히 광대의 썩어 문드러진 "
  },
  {
   "id": "da0311:R00004",
   "source_sha256": "a050ca136404a57e3ad168affc7ee86ddfe27548a0578ed125a618a337dbcd88",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00029",
   "source_sha256": "cd11f3660ed6891f63cb9cc89900d8436cc5ba566088448a3d2a6e232ea4e428",
   "ko": "얼굴"
  },
  {
   "id": "da0311:T00030",
   "source_sha256": "feba548cc1a15200458dc96d27d9e254dbcc47c4950eb4f1d6d839f91e42e7df",
   "ko": "을 응시하고 있다."
  },
  {
   "id": "da0311:T00031",
   "source_sha256": "279c4b9268752fdd05400414f6863fa3ce0dfed947bb3694df0953c31a20ceaf",
   "ko": "백골화된 턱을 덜그럭거리며 광대가 비웃는다."
  },
  {
   "id": "da0311:T00032",
   "source_sha256": "48b9125a79f7181d0c781dc2a7121738f341ec213ad09e6a871a2ed252d4797f",
   "ko": "「이번만큼은 구해 줄 히어로는 없단다?　쿠로 쨩은 절찬 대고전 중이고오?　메타트론은……\n아아 "
  },
  {
   "id": "da0311:R00005",
   "source_sha256": "6b06f159af5ff7405303b7572fd6cc95fa28d6db1cbb828d31fbf2f997c069e5",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00033",
   "source_sha256": "74ec94a65d17bf0cb72fae2a3ad9b09567e4fd983c5252b7fcdf1fe1fb7d78d6",
   "ko": "애초"
  },
  {
   "id": "da0311:T00034",
   "source_sha256": "5013fdeaea1dbe34e83938a1dcf01238dabdf2f74e189aa9e2ee46212f9fb31d",
   "ko": "부터 없었지 참」"
  },
  {
   "id": "da0311:T00035",
   "source_sha256": "9887b0e7749d61085565b8eba86e3fb38b47b18ddf5de7062089e9b19b0e4d08",
   "ko": "「그래, 이건 악몽인걸.\n　형편 좋은 해피 엔딩은 없어.\n　그것이―― 그것이 내가 바라는 "
  },
  {
   "id": "da0311:R00006",
   "source_sha256": "3e7ca97dd222dfece75cc1b0e619438b0296dd7b6db45fe8ff3627464f181e69",
   "ko": "세계",
   "ruby_action": "keep"
  },
  {
   "id": "da0311:T00036",
   "source_sha256": "846c39b0bcb51f41f7a9b92e4d3452d15b86f3e1cd153f8d3d2ba8ef55219731",
   "ko": "이야기"
  },
  {
   "id": "da0311:T00037",
   "source_sha256": "d93a835d0f2787bcb1a759ad3a1b8fbea56d742d0b99720dbbb9ea8ace1926f8",
   "ko": "」"
  },
  {
   "id": "da0311:T00038",
   "source_sha256": "eb10833ea58f1a2a484def95b3dfa6aa1c7b2f4db0c602cb08f0e29092aaa694",
   "ko": "「아무도 너를 구할 수 없어」"
  },
  {
   "id": "da0311:T00039",
   "source_sha256": "1cf09a4d02b43dbd56a4e8127e79139001aeb4b9bd5ed2af6f6bbc5fb26a3f03",
   "ko": "「구원받지 못하는 "
  },
  {
   "id": "da0311:R00007",
   "source_sha256": "a86df34a6f3fd760cd90b6597d0c6936a42c68e4adc46930a700d6cb24302710",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00040",
   "source_sha256": "846c39b0bcb51f41f7a9b92e4d3452d15b86f3e1cd153f8d3d2ba8ef55219731",
   "ko": "이야기"
  },
  {
   "id": "da0311:T00041",
   "source_sha256": "db34b8415ee14dbff03404e11e2b71dd079c947dc2a7bc7ab1a222a08842ae2c",
   "ko": "를…… 아름다운 사랑을 죄로"
  },
  {
   "id": "da0311:R00008",
   "source_sha256": "c15e66756f836acc97fe1b71a7a71550b17a744dcccf5855958e2e0d79a9b5a8",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00042",
   "source_sha256": "dfdb6153dcfd20400d3aff0948dbbcb5de3456db62784a19b7b509661e8ae530",
   "ko": "능욕"
  },
  {
   "id": "da0311:T00043",
   "source_sha256": "034b18407a0c98732b2b1cab4f6c15489ebd97d6ba3185fc14add424a5a194b7",
   "ko": "하고, 고결한 용기를 악의로 "
  },
  {
   "id": "da0311:R00009",
   "source_sha256": "9a5091e227e390ae9d7166cc682cba12fce70a91136bc7b3935e4fcc9832d974",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00044",
   "source_sha256": "dcd513c15472014280ec703fc5ac1cee18ef00314197cd5db3387d1564a16850",
   "ko": "더럽히"
  },
  {
   "id": "da0311:T00045",
   "source_sha256": "c88f8ae454f73f65c9cb969f79d94e68c84a2cde71c063a6a9f6613d45f3acf5",
   "ko": "고」"
  },
  {
   "id": "da0311:T00046",
   "source_sha256": "1090267cb7a0b29dfc39c745466d076fdcd7ff2c482b96baf54f2ab68149fb41",
   "ko": "「자아……\n엉망진창으로 범해 줄게엥.\n행복한 시간은 이제 "
  },
  {
   "id": "da0311:R00010",
   "source_sha256": "d4d0b8ea5ff52da02e059fa61e23adfb0e712856c08aaf1dda42e93c35820ec9",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00047",
   "source_sha256": "e957ecd57fc8e72dbbf75efcca04d344a0d21e5be42c2b68fbb9a1769d04b291",
   "ko": "끝"
  },
  {
   "id": "da0311:T00048",
   "source_sha256": "25ed245b0817edaf656b44b3d1bd7bf63d53db8dabc724542a8f33a695e49f5f",
   "ko": ". 이제부터는\n깨어나지 않는 악몽이 계속될 뿐이란다……」"
  },
  {
   "id": "da0311:T00049",
   "source_sha256": "cc5c1284bd134bca32b13b56cde3b6849214b8388da8aa7702f156c8cee778d1",
   "ko": "「예쁜 "
  },
  {
   "id": "da0311:R00011",
   "source_sha256": "a86df34a6f3fd760cd90b6597d0c6936a42c68e4adc46930a700d6cb24302710",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00050",
   "source_sha256": "846c39b0bcb51f41f7a9b92e4d3452d15b86f3e1cd153f8d3d2ba8ef55219731",
   "ko": "이야기"
  },
  {
   "id": "da0311:T00051",
   "source_sha256": "2a1136359621dcf2b6d11684bdbc6404548ee9ca2481a5cbbbc76981aa8831db",
   "ko": "를 악몽으로 "
  },
  {
   "id": "da0311:R00012",
   "source_sha256": "01e8855e938d5a455078911d78d4c1153e977690a4df6eed3affa0bea10c342d",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00052",
   "source_sha256": "779ef63fafeb4ccae5c9e40021471349972c234fc0d4b70654950e06c66896db",
   "ko": "닫아걸"
  },
  {
   "id": "da0311:T00053",
   "source_sha256": "100ab86402b5a44cb3c27151a05f7334ff5ada78be95fa18b5725a3afd23c6f9",
   "ko": "어――\n　쿠자쿠로 이어지는 모든 "
  },
  {
   "id": "da0311:R00013",
   "source_sha256": "3e7ca97dd222dfece75cc1b0e619438b0296dd7b6db45fe8ff3627464f181e69",
   "ko": "세계를",
   "ruby_action": "keep"
  },
  {
   "id": "da0311:T00054",
   "source_sha256": "dce1c696677ceba6877912e1ad2e701c05d93ac5107d3ae6617dd4f8999af797",
   "ko": "가능성을"
  },
  {
   "id": "da0311:T00055",
   "source_sha256": "b91a2aff393e9cff2f5225d7fb0c55d00eb25842978fe829c00f26eb5285564d",
   "ko": "\n　부정해 주겠어」"
  },
  {
   "id": "da0311:T00056",
   "source_sha256": "343ede0a9f8ee7ccb95915a0f7b54686c85a967d12f287545d19475774c5d08b",
   "ko": "「……재미없네」"
  },
  {
   "id": "da0311:T00057",
   "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
   "ko": "「……?」"
  },
  {
   "id": "da0311:T00058",
   "source_sha256": "257ee8fb1135e6e3f3066310965afbfe6142cbc9243e5581ebeb47dd5da04001",
   "ko": "「――――」"
  },
  {
   "id": "da0311:T00059",
   "source_sha256": "95ad3512c717c8733979491074e1615a3ebb62dc9bc6cc03926b130cfec09e8c",
   "ko": "눈동자는 여전히 광대의 썩어 문드러진 "
  },
  {
   "id": "da0311:R00014",
   "source_sha256": "a050ca136404a57e3ad168affc7ee86ddfe27548a0578ed125a618a337dbcd88",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0311:T00060",
   "source_sha256": "cd11f3660ed6891f63cb9cc89900d8436cc5ba566088448a3d2a6e232ea4e428",
   "ko": "얼굴"
  },
  {
   "id": "da0311:T00061",
   "source_sha256": "feba548cc1a15200458dc96d27d9e254dbcc47c4950eb4f1d6d839f91e42e7df",
   "ko": "을 응시하고 있다."
  },
  {
   "id": "da0311:T00062",
   "source_sha256": "7f3e75d684e7d79fedc5c3312048fcab50e4633891a7d94520420ba3670d29cf",
   "ko": "공포에 젖어 있으나 결코 눈물을 흘리지 않는 눈동자다."
  },
  {
   "id": "da0311:T00063",
   "source_sha256": "9c07b58eb41b02e11281ef10fd4ee9af13b0e75c1bcde7acc8efbd7d53bba7d2",
   "ko": "「너…… 『저번 때』는 좀 더\n　악악대며 울부짖었잖니」"
  },
  {
   "id": "da0311:T00064",
   "source_sha256": "c81aabefcaa13a60fef69882d473a420dee82b0b372f6b451c30ce65c7817154",
   "ko": "「무슨 이야기인지 모르겠습니다만――」"
  },
  {
   "id": "da0311:T00065",
   "source_sha256": "7e40d8913db5916192236befed45bef4272f558dc08f675b1806ac480011c552",
   "ko": "공포는 물론 있었다."
  },
  {
   "id": "da0311:T00066",
   "source_sha256": "94ffffb8620b2fcbf5d46432e23a1b43975b0734fc7f761993be6a027712fbf5",
   "ko": "혐오감도 있다.\n\n　하지만 가슴 깊은 곳에서 사납게 날뛰는 이 격정은 그것만으로 이루어진 것이 아님을 루리는 알았다.\n\n　그렇다."
  },
  {
   "id": "da0311:T00067",
   "source_sha256": "62a6b98f9f8cc526e834bdb102b29faa141e88721dad4ce95980428c34b293a0",
   "ko": "루리는 알고 있다.\n\n　기억에는 없다."
  },
  {
   "id": "da0311:T00068",
   "source_sha256": "dad06b1d23f8614b136977c3567e9034bfe77bec350a60a27cb8646f25ca2252",
   "ko": "경험에도 없다.\n\n　하지만 혼이―― 기억을, 경험을, 시간을, 인과마저도 배신했다.\n\n　그렇다."
  },
  {
   "id": "da0311:T00069",
   "source_sha256": "a996b14d420ad90fd974efc9b3f42dc4f5a575faa5aab81139aa032825ef9f0f",
   "ko": "나는 알고 있다――!\n\n　이것은 적이다."
  },
  {
   "id": "da0311:T00070",
   "source_sha256": "5a2ae0ee4888308afa8e86008612f37dc01f4a25cba9baca769f98cf48387b8d",
   "ko": "결코 용납할 수 없는 적이다.\n\n　인간을 모독하고, 조롱하고, 능욕하고, 학살하는 존재―― 『사악』이다."
  },
  {
   "id": "da0311:T00071",
   "source_sha256": "cdbe5122f3e7f23a05eb3b485a52717ba70a6d9aa98a1534b18c08000aad9cd1",
   "ko": "인간이…… 인간이라면, 결코 용서해서는 안 되는, 굴복해서는 안 되는 존재다.\n\n　질쏘냐."
  },
  {
   "id": "da0311:T00072",
   "source_sha256": "407de45a35f42d835b81b4549e6f42daa1a99fa500b8c2f3cf84a9442a258b08",
   "ko": "질 수 있을쏘냐."
  },
  {
   "id": "da0311:T00073",
   "source_sha256": "edcbc98e89a6490a82505e267d0508ced1edeeeb73e966223da54423669d805e",
   "ko": "왜냐하면, 나는――"
  },
  {
   "id": "da0311:T00074",
   "source_sha256": "a459a186427c0e1465e5e4c1c3b43d8389eaf0681d1bffa096e4f87676a74533",
   "ko": "「――저는 하도 루리!\n　하도라는 이름을 이은 우리가, 네놈 따위\n　사악에 굴복할 것 같나요!」"
  },
  {
   "id": "da0311:T00075",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0311:T00076",
   "source_sha256": "51a0cde25d4358f7866666cfdd3fc3929483b5f78b6f0a52d1afb6bb9691f637",
   "ko": "광대의 표정이 바뀌었다."
  },
  {
   "id": "da0311:T00077",
   "source_sha256": "ccef2ac4548a9953cd86f90bdb44c61ee242b5a0fd0790521390d8683ed3dde1",
   "ko": "표정 따위 판별할 수 있는 얼굴이 아니지만, 그럼에도 루리는 알 수 있었다."
  },
  {
   "id": "da0311:T00078",
   "source_sha256": "62a488009a96a27cbf25e23536ececa1aac4c769a1bf8dbe3dcb6943246d5acd",
   "ko": "분노와 악의가 광대 안에서 부풀어 오른다."
  },
  {
   "id": "da0311:T00079",
   "source_sha256": "b211ab71a36025911a9583b671d1f804b2b052061f993c9775a1655ae694ffe0",
   "ko": "「용감하네, 하도 총수?\n　그 오기, 언제까지 버틸지\n　시험해 줄게……!」"
  },
  {
   "id": "da0311:T00080",
   "source_sha256": "b2567a7b32fbb3a604a41ec4ea939faebb24d153de19341b88655bd1829b677e",
   "ko": "「……큭!」"
  },
  {
   "id": "da0311:T00081",
   "source_sha256": "3cfed296a00672d732f42b175aa3f57998f1b8353245ec2dd963c12218de0fed",
   "ko": "「……뭐야, 이 반응은?」"
  }
 ],
