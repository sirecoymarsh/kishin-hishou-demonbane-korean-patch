{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0047_da0401",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0401:T00001",
   "source_sha256": "3f76441ae7903037556dfed230a7661e86b3aaf17d1c294bcbbf0606abccbf2d",
   "ko": "「크오오아아아아아아아아아아\n　아아아아아아아――――앗!」"
  },
  {
   "id": "da0401:T00002",
   "source_sha256": "3602c3357c438de102ec4a7acfe441a98592ac4502787a38260dd815aab09afc",
   "ko": "「분명히 견고한 "
  },
  {
   "id": "da0401:R00001",
   "source_sha256": "3d6e7a92243d0e53d9c962602beb38e396a5f02b62d2fd759706147fb095f432",
   "ko": "리얼리티다",
   "ruby_action": "keep"
  },
  {
   "id": "da0401:T00003",
   "source_sha256": "d2ed9f43db055cfc14f8cba4185a4b2a6473118110aa3f8883409173d23170db",
   "ko": "존재력이다"
  },
  {
   "id": "da0401:T00004",
   "source_sha256": "8f3d0b372e66d3385106ba444a3b9b0f89dacdb5a526c20726f41848f2592e05",
   "ko": ".\n　하지만 실체를 지녔다면,\n　쓰러뜨릴 수도 있다」"
  },
  {
   "id": "da0401:T00005",
   "source_sha256": "3580cda0d45cd5b89eb57721ca2bf434e5ed9b8b7a241578a418731178540af8",
   "ko": "「아…… 아아…… 아아아아……」"
  },
  {
   "id": "da0401:T00006",
   "source_sha256": "17c11b2d2074f7453f9c72a92d388b842a44d516c55e5b831ff0183ce768ab27",
   "ko": "「――목마르지 않고 "
  },
  {
   "id": "da0401:R00002",
   "source_sha256": "884de28537b6ccf1aab464fff3a71a6a63edc893d24e31bd205bc6ca46367a13",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0401:T00007",
   "source_sha256": "474648a2d11632e9334be993d02ddcfcfa38146d22a3d477599467e22221d089",
   "ko": "굶주리"
  },
  {
   "id": "da0401:T00008",
   "source_sha256": "3978ecbdb9696291316bf87af699f62dede7fdf527bf89c51cbe333515f35ef3",
   "ko": "지 않고 무로 돌아가라」"
  },
  {
   "id": "da0401:T00009",
   "source_sha256": "a05243835d1c96e11a6884ca3b543964d650ecbde17a4ae7ca01c01d015b24f9",
   "ko": "크라켄이 붕괴한다."
  },
  {
   "id": "da0401:T00010",
   "source_sha256": "7c5ccec26904cfc5251d54a0e4ef11f339d869aa1287382c516c4a229473f76e",
   "ko": "산산이 부서지는 기체가, 그 끝에서부터 피의 안개로 화하여 대기에 녹아든다.\n\n　그렇다."
  },
  {
   "id": "da0401:T00011",
   "source_sha256": "46707678c621d40577beeab9f37a37a805eb64f08f229e18949fc4463bac7e9c",
   "ko": "꿈은 그저 꿈으로 흩어져 사라질 뿐이다."
  },
  {
   "id": "da0401:T00012",
   "source_sha256": "c9f2262e4af2576e25e66f804eee5aab60553fe6fbcfac37ab715f556e7f9632",
   "ko": "「칼리굴라아아앗!?」"
  },
  {
   "id": "da0401:T00013",
   "source_sha256": "7e5b8c7b87c0fed6945c1b1bffeccd082f24afa71bdb566323f1d9e9cb1a3297",
   "ko": "「한눈을 팔고 있을 때인가!」"
  },
  {
   "id": "da0401:T00014",
   "source_sha256": "3b6d85b59687b4900cd1d00844a5b49920cf9d3420d4e2aac0d784002dad5269",
   "ko": "「――읏!　젠자아아앙!」"
  },
  {
   "id": "da0401:T00015",
   "source_sha256": "97ff9602d21f711d18d7f5426d1c568a389b6e458130c82ddc57f6cf2a20a004",
   "ko": "마익기 바이아크헤를 모는 슈루즈베리와 클라우디우스의 싸움은 시계탑 상공에서 펼쳐지고 있었다."
  },
  {
   "id": "da0401:T00016",
   "source_sha256": "11a96d93d07f8d746017a203b3262ef460912aedd442e177dd20136810bd0ed9",
   "ko": "격돌하는 바람의 칼날과 바람의 칼날."
  },
  {
   "id": "da0401:T00017",
   "source_sha256": "3aaf2a3cafd9d65b1261bfb6b7b0a5434cc9792649f7b02f016befe44d431a1b",
   "ko": "「제기랄…… 네놈들 두 번이나……!\n　두 번이나 죽여 버렸겠다앗!」"
  },
  {
   "id": "da0401:T00018",
   "source_sha256": "069befb11128751b909e1973494e360b3a61c38ef493eb2b4dbd924c1d994daf",
   "ko": "「누우우!?」"
  },
  {
   "id": "da0401:T00019",
   "source_sha256": "79b9c007910654316f32cebcfb617690c16ad2d2994acf5822bbb01c998c68b4",
   "ko": "클라우디우스가 두른 바람의 결계가 풍속과 독기의 농도를 더했다."
  },
  {
   "id": "da0401:T00020",
   "source_sha256": "061bd2416c47e3058efcf3a7a616286fe953365b879007af7245666d012837b7",
   "ko": "검은 회오리바람은 그를 감싸 안아 숨겨 버린다."
  },
  {
   "id": "da0401:T00021",
   "source_sha256": "29d450fdd9c07b1380d2407faf1b0703933597b014f7405ee6cdaea0f295bd0d",
   "ko": "……마풍의 틈새로 간혹 엿보이는 그 모습이, 사람이 아닌,\n불쾌한 비늘로 뒤덮인 형언하기 어려운 것으로 보이는 것은, 과연\n착각인 것일까."
  },
  {
   "id": "da0401:T00022",
   "source_sha256": "6406a4a2074b6243f155a64199d59dddef7e1b9a1672b5346fcd177a7bdd3afa",
   "ko": "「다져 주마…… 네놈들 전원,\n　다져서 죽이고 "
  },
  {
   "id": "da0401:R00003",
   "source_sha256": "7b8a57af352a15e260e709f9058f6291c3bdc7e61a04384357c06e207ab98df4",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0401:T00023",
   "source_sha256": "363def480b9cd0cb600e0a1ff3588c6a8a0adc877cf275fd57dede164bbc5862",
   "ko": "해체"
  },
  {
   "id": "da0401:T00024",
   "source_sha256": "0d83e61a8704f261d1c03afd0581ef2f2c77543b2d743fe68ccf6d56c9329dc5",
   "ko": "해서, 한 번 더\n　죽여 주마아아아아아!」"
  },
  {
   "id": "da0401:T00025",
   "source_sha256": "645428c36bac3b0b36d81e9788872cac36b3b0079cfd16eb3f4a525d6ffe599e",
   "ko": "검은 회오리바람이 돌격해 온다."
  },
  {
   "id": "da0401:T00026",
   "source_sha256": "85822bc104583a97bc3853c2ec4134355ec2c08ce5884d7c28fd91bb0b81e2dd",
   "ko": "회오리바람에서 솟구치는 번개가 기괴한 궤적을 새기며 슈루즈베리 일행에게\n쏟아져 내린다."
  },
  {
   "id": "da0401:T00027",
   "source_sha256": "3c23fc5be5c1b5961c29a253c2db01e06aacd01f0e1907560a02a39b9f8b58d5",
   "ko": "「꺄아아아아!」"
  },
  {
   "id": "da0401:T00028",
   "source_sha256": "f82f13ae075729a853bc26e004a09665201b7f7454716a1b03f758b317787802",
   "ko": "「안 되겠군!」"
  },
  {
   "id": "da0401:T00029",
   "source_sha256": "129ba84bd80bb5f976be8ac063e489046688923c02144325a2af5db7e07e39ff",
   "ko": "전격과 독기가 마와 기의 융합체인 마익기의 감각을 어지럽힌다."
  },
  {
   "id": "da0401:T00030",
   "source_sha256": "36595ab945542f0c01ed97f4b627f574c329b5381612b085eb6e4a02fb2a5b30",
   "ko": "꼼짝할 수 없는 슈루즈베리 일행을 회오리바람이 덮친다."
  },
  {
   "id": "da0401:T00031",
   "source_sha256": "23b041121cc86ab4101b55c4387ddc304e0b40046106234d04d04e9568ee4009",
   "ko": "「얏하아아아아――――앗!」"
  },
  {
   "id": "da0401:T00032",
   "source_sha256": "56f25e4baf257658f6efb703f2d9182744a5df614027963a6e94198ff72b986e",
   "ko": "검은 광풍이 마익기를 찢어발기고 분쇄했다."
  },
  {
   "id": "da0401:T00033",
   "source_sha256": "b4fc53e3ca4dd0054ea4b1812855286f80034daf26b082ceef3f9a1c085bca91",
   "ko": "산산이 부서진 잔해가 눈 아래의 일그러진 거리로 추락해 간다.\n\n　그 기계인지 광물인지 갑각인지 알 수 없는 마익기의 파편에 섞여,\n깨진 검은 안경이 떨어지는 것을 클라우디우스는 보았다."
  },
  {
   "id": "da0401:T00034",
   "source_sha256": "31dd825b4a9541d5fbdc88796a1bb69da9a275d4d2336818d1b2868b76203a44",
   "ko": "「햐―하하하하하하!\n　꼴좋구나 노망난 영감탱이!\n　……다른 쓰레기 놈들도 기다려라.\n　전부 싸잡아서 이 내가 처죽」"
  },
  {
   "id": "da0401:T00035",
   "source_sha256": "84d4c8aeab863cc1c7f8e49d3bbd399ea74cd7885241b8ea8e8194898ed220d4",
   "ko": "「우쭐대지 마라, 애송이」"
  },
  {
   "id": "da0401:T00036",
   "source_sha256": "fc8b3813a78ad14ca02f44b935e2fc9ee084dbe16b85b14f230a34159f1c474c",
   "ko": "「――으읏!?」"
  },
  {
   "id": "da0401:T00037",
   "source_sha256": "5918b83e9243140c626ff2d9723a754b9a0e83b831e10e6cf7c9ded472e77f81",
   "ko": "머리 위에서 들려온 목소리에 얼어붙는다."
  },
  {
   "id": "da0401:T00038",
   "source_sha256": "9205bf0ff81c4d6be81ba9122bc6a9e06d80dd06f1371eef97a3d21797f956d4",
   "ko": "올려다보니 괴조 같은 그림자."
  },
  {
   "id": "da0401:T00039",
   "source_sha256": "cf80383e64c21ca7935a91931cfd0073edd53efd69a2dbc8190e6d7943271e8b",
   "ko": "파괴된 마익기에서 재빨리 뛰어 물러난 슈루즈베리다."
  },
  {
   "id": "da0401:T00040",
   "source_sha256": "c508336837aca6a4a4fd3c1f0c061e26c3e4e080396133063fe26b35cf1290a5",
   "ko": "「영감탱이!?」"
  },
  {
   "id": "da0401:T00041",
   "source_sha256": "e955b2b82d02e1a975b508889b22c133c2f9257c46d7eeba7d173d0a1a74c6d3",
   "ko": "검은 안경은 벗겨져, 그의 맨얼굴을 가리는 것은 이미 아무것도 없다."
  },
  {
   "id": "da0401:T00042",
   "source_sha256": "3e5a605e3a6431fbe73cd2fe0f2b218daf9fdbf2f1d65d11e7763737fa499be3",
   "ko": "클라우디우스와 슈루즈베리의 시선이 교차한다――아니.\n\n　그럴 수는 없다."
  },
  {
   "id": "da0401:T00043",
   "source_sha256": "1a63ce620fabc3007d4d3a8f2501ce9d2246dfe774095c307551c4b87e443b20",
   "ko": "왜냐하면――"
  },
  {
   "id": "da0401:T00044",
   "source_sha256": "297d8be4862d4b261a401e5666bb74914c3f9c4a0672ed5266ce51c43b2a1157",
   "ko": "「뭐……엇!?」"
  },
  {
   "id": "da0401:T00045",
   "source_sha256": "b89d3fff4b41492fb61f29899c394c9329787c60aba0729b4ef43f5b02a278d7",
   "ko": "「하스터의 마력. 바람뿐이라고 생각하지 마라」"
  },
  {
   "id": "da0401:T00046",
   "source_sha256": "3c3b53329aa66cb765d5d6752ce114d30e13cf0a58ed8b8d2be047d4d908b501",
   "ko": "고하는 동시에, 슈루즈베리는 포효했다."
  },
  {
   "id": "da0401:T00047",
   "source_sha256": "42d19cfc13766c0d8df5da79b843cdd2a292fa1d0ab0b006c8299005f8435dbd",
   "ko": "대기를 뒤흔드는 "
  },
  {
   "id": "da0401:R00004",
   "source_sha256": "b9a6f33686a842ff9fb09541728b956c367019de0996cbd15c4c8f9f47fb9cf8",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0401:T00048",
   "source_sha256": "68c411b217f16b775618b986689da251c38f4b759c77c73bcbc2a911c20c51bf",
   "ko": "목소리"
  },
  {
   "id": "da0401:T00049",
   "source_sha256": "e7f9ce0a28c3b6ddedd46968cc712a95587630ddf17cd6b70921e564123849ac",
   "ko": "가 아니다."
  },
  {
   "id": "da0401:T00050",
   "source_sha256": "441a6a1b924f8c7844c63cd0bd07745a4d9558c156ba6d8ce7017cf1c31f74b7",
   "ko": "아스트랄 영역을 질주하여, 영혼을 직접 뒤흔드는 마성의 목소리다.\n\n　그것은 포효이자, 통곡이자, 노래였다."
  },
  {
   "id": "da0401:T00051",
   "source_sha256": "d1f32104ecdc23ee9906e000534813018fb7a445c02891375e3706d20129f1b8",
   "ko": "「크……읏!　크아아아아아!」"
  },
  {
   "id": "da0401:T00052",
   "source_sha256": "7c61de45a8666aa00b895429078b3b95bc4a5a17cf452611511e30f7c22a8ece",
   "ko": "영혼을 부수고, "
  },
  {
   "id": "da0401:R00005",
   "source_sha256": "01df67e1d7cdbc51809b3a90688de6c6f9f4568cf270f141f3169e5f01fee77a",
   "ko": "・・・・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0401:T00053",
   "source_sha256": "cc8225e55b508234e7547919fde77024d2309d756d3b55aa017cd20a52cf1d00",
   "ko": "육체를 미치게 만드는"
  },
  {
   "id": "da0401:T00054",
   "source_sha256": "74c6c6a32c232bba932b18da9577c4a9de9d6766c3868b1ee01ed540fce945a9",
   "ko": ", 이형의 노래다."
  },
  {
   "id": "da0401:T00055",
   "source_sha256": "412252d73a884dd24ca972c0b34548010f266f3d1b5c2b9093a7552bc7627f99",
   "ko": "「크아아아아아아아아아아아아아아아\n　아아아아아아＃＄％＆（’＃＄!?」"
  },
  {
   "id": "da0401:T00056",
   "source_sha256": "e10d6dbac66b03b01011483e9a82df422affe72c65bbf89a6473a9e9485ee673",
   "ko": "클라우디우스가 "
  },
  {
   "id": "da0401:R00006",
   "source_sha256": "b750c2ece644240b0f8e138a0602b89062dcd4cb934044a963e76bf34670b76d",
   "ko": "・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0401:T00057",
   "source_sha256": "3c33e1c6be4244295442964aff169b6491e3cdd3cdd4dd1ac931aac93abe7047",
   "ko": "비등한다"
  },
  {
   "id": "da0401:T00058",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  }
 ],
 "issues": [
