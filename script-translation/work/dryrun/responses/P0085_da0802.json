  },
  {
   "id": "da0802:T00109",
   "source_sha256": "8274c1189c4e4901078e0d8e915a9259751c0e7c47afaceaa58fd1dc15e68d2c",
   "ko": "카운터로 내지른 리베르 레기스의 주먹은 "
  },
  {
   "id": "da0802:R00023",
