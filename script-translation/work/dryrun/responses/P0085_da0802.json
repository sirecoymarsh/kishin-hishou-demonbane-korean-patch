  },
  {
   "id": "da0802:T00094",
   "source_sha256": "07519e5cf2de4a84f01dcb6b987f2101b0b907600470674a9ec4e25cc4f898fc",
   "ko": "자세를 가다듬을 틈도 아껴 참격을 날린다."
  },
  {
   "id": "da0802:T00095",
   "source_sha256": "40cd268ab0aa91367426a6deff69248768ffe472154a9b20ce8a04221f9f89b0",
