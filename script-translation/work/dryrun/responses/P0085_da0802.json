 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0802:T00001",
   "source_sha256": "af318796b103fbcc2c2ab3870b5bde5c6a32a4e9fb9ea35cadac079abea1cdef",
   "ko": "「나의 성에 온 것을 환영한다.\n　용맹과감한 기사공」"
  },
  {
   "id": "da0802:T00002",
   "source_sha256": "bbef55cbf5afdd7296f52de2faff40745da43e3dfa16b84d2b7dbbdda7a2080f",
   "ko": "소년의 목소리는 몇 겹으로 메아리치며 울려 퍼졌다."
  },
  {
   "id": "da0802:T00003",
   "source_sha256": "d3546339346d20c9a22ac8bc9d879206ba62bb59c91ab2b37d4349fff11f5741",
   "ko": "대기를 전도하는 것이 아니라 영기를 전도하는 소리."
  },
  {
   "id": "da0802:T00004",
   "source_sha256": "e198a41ef281e4677b44ebe64579c5f352963483c59d9dc5d13a85842b451122",
   "ko": "정신에 직접 말을 걸어오는 듯한 "
  },
  {
   "id": "da0802:R00001",
   "source_sha256": "b9a6f33686a842ff9fb09541728b956c367019de0996cbd15c4c8f9f47fb9cf8",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00005",
   "source_sha256": "68c411b217f16b775618b986689da251c38f4b759c77c73bcbc2a911c20c51bf",
   "ko": "목소리"
  },
  {
   "id": "da0802:T00006",
   "source_sha256": "8919a55f592c9838df42e08533efb9859448a922d06b109ad6541812a986a7c0",
   "ko": "다."
  },
  {
   "id": "da0802:R00002",
   "source_sha256": "d0e26045fa4196f578a81fd4a2e894b860bdb6c8df30021aeaa501c7a22de55b",
   "ko": "리베르 레기스를",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00007",
   "source_sha256": "72c832c729d28b5ac5fac31589760a80683c865bf7ffc11e512911e9f4f2bf1c",
   "ko": "진홍의 귀계신을"
  },
  {
   "id": "da0802:T00008",
   "source_sha256": "5cb3fe5554fd905a4d33557075740d4297ee2400e270f89a065593357030b878",
   "ko": " 모는 금빛의 짐승."
  },
  {
   "id": "da0802:T00009",
   "source_sha256": "b94aa834e3bd85d48a7aa970269e9a09dc89ba0953947c033aebf30bd94def6e",
   "ko": "기사 소년은 세계의 천적의 이름을 혼으로 알고 있다."
  },
  {
   "id": "da0802:T00010",
   "source_sha256": "ee48b5af80d8e29b0c982dd4a3b2545bfa5ddb26db020ca9aab6cf175cd6a81c",
   "ko": "「……대도사 마스터 테리온」"
  },
  {
   "id": "da0802:T00011",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0802:R00003",
   "source_sha256": "b23809bf96a578e2f1bd090c387ee6bf76b00f431c6ea18868a02155a811f1f4",
   "ko": "・・・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00012",
   "source_sha256": "6f642eb363053b991aca430e244caa28878571f0ad0a6a23c21d1d3749cee3f0",
   "ko": "아직 존재할 수 없는"
  },
  {
   "id": "da0802:T00013",
   "source_sha256": "33b851a2fed4fc09949051bea17d68e872afa587fe52bd83d80c4cdaafe8b624",
   "ko": " 영웅에게까지\n　나의 이름이 알려져 있다니\n　……영광스러운 일이군」"
  },
  {
   "id": "da0802:T00014",
   "source_sha256": "ab6000c82f23875fdf0b557ca243885a0706cceb44b4ad626667578d4b4f5835",
   "ko": "「……무한나선의 싸움은,\n　내 피에도 기록되어 있다.\n　하지만 말이다, 짐승이여.\n　"
  },
  {
   "id": "da0802:R00004",
   "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
   "ko": "・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00015",
   "source_sha256": "38245b40dcbd4feb5f08169f53719232635774af3ba6797a861ecac2bde12c96",
   "ko": "존재할 수 없는"
  },
  {
   "id": "da0802:T00016",
   "source_sha256": "044db715e1d0ce0016c1fde2a34eef49c0d3aa4370f04977ff6c587636717da7",
   "ko": " 것은 네놈이다」"
  },
  {
   "id": "da0802:T00017",
   "source_sha256": "ef044f4570116eb817fbf77240448ac18a273178a88a2a0f9b87ab8889b275ed",
   "ko": "두 손바닥에 나타나는 쌍검."
  },
  {
   "id": "da0802:T00018",
   "source_sha256": "50e2d21b443b38cab40981a8e1fd7e7d596514d9cef26f12e78c804229ca76ac",
   "ko": "그 칼끝을 리베르 레기스를 향해 들이댄다."
  },
  {
   "id": "da0802:T00019",
   "source_sha256": "443e8e23c32974121e2f02be05cea39c885f130ac7a42898a01bd414aaaa202b",
   "ko": "쿠자쿠의 기백은 "
  },
  {
   "id": "da0802:R00005",
   "source_sha256": "649bb9c4a591f1c70ac131662dfbe0387d5f8e8ca9ac3fa20f710e647b423101",
   "ko": "프레셔를",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00020",
   "source_sha256": "171935884234fcdeee622f9ac6df7ac78b272127fed72306344399612879d6f2",
   "ko": "압박감을"
  },
  {
   "id": "da0802:T00021",
   "source_sha256": "dccbbeb33d028d0c3d2042ff77372fbd1a72a527803779282e74120e20802658",
   "ko": " 띠고 대홀의 공기를 진감시킨다."
  },
  {
   "id": "da0802:T00022",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0802:R00006",
   "source_sha256": "427566260604d16fb4a900e51400dd5dfac2ef749901179434735f0d0008d100",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00023",
   "source_sha256": "1cba0068ed2989f2702a73319cb70a68180cd286fc71e9bbc16f00fed91890b4",
   "ko": "신속"
  },
  {
   "id": "da0802:T00024",
   "source_sha256": "10c477b2569aa9d276ae5eb3fb76f426c74eb921f4cba1fdd04767cd6994a2cf",
   "ko": "히 "
  },
  {
   "id": "da0802:R00007",
   "source_sha256": "4c6ff2461396974940d832f3f0ce2a7624668028f9bff88ca807b1e9da44a407",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00025",
   "source_sha256": "99ae21ea6c39ccc19fba135c236c1592bb32672cbc1f79173a06296a0b9bfb67",
   "ko": "물러가"
  },
  {
   "id": "da0802:T00026",
   "source_sha256": "8d05b9fe00230a408f9051cb2cf85c3a93b764c1286268fcb466a9646261496b",
   "ko": "라. 단순한 악몽에게 볼일은 없다」"
  },
  {
   "id": "da0802:T00027",
   "source_sha256": "4bba2f22ee1006ee0aa74a59169acca65279769a4bc834505c3e77109c50d377",
   "ko": "「하하…… 매정하군. 하지만\n　그것은 이쪽이 할 말이기도 하다……」"
  },
  {
   "id": "da0802:T00028",
   "source_sha256": "891a0fddfbdf5085a05172aac3ae9d5a12962e5fa08d91fa1bc082cd04a132b5",
   "ko": "「뭐라고……?」"
  },
  {
   "id": "da0802:T00029",
   "source_sha256": "e18a11cccfcdf4e2f4480ff1ebb82f1828c75741a4956870d4b572abb8735679",
   "ko": "마스터 테리온의 기척이 변했다."
  },
  {
   "id": "da0802:T00030",
   "source_sha256": "286f3615010f45c1d8afe7ca35861e0be0177be7b50eb59ad00238aca2c9c068",
   "ko": "차갑고 날카롭게 꽂히는 "
  },
  {
   "id": "da0802:R00008",
   "source_sha256": "649bb9c4a591f1c70ac131662dfbe0387d5f8e8ca9ac3fa20f710e647b423101",
   "ko": "프레셔",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00031",
   "source_sha256": "4c822036aa3a8868bf2b26bc4d328b38dc3629b2ff020f7b35dfa78dcb145a82",
   "ko": "위압감"
  },
  {
   "id": "da0802:T00032",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0802:T00033",
   "source_sha256": "7afd2930b965c221b9b9c123c6ed998880f1a8f4351ac561a6486be5e61b937c",
   "ko": "심장을 움켜쥐이는 듯한 한기를 느낀다."
  },
  {
   "id": "da0802:T00034",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0802:R00009",
   "source_sha256": "b750c2ece644240b0f8e138a0602b89062dcd4cb934044a963e76bf34670b76d",
   "ko": "・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00035",
   "source_sha256": "dcf88c295a2a4195964104d16922e39bb42dc8f3db3e0ed3af864b534f4bf7a9",
   "ko": "신속히 물러가라"
  },
  {
   "id": "da0802:T00036",
   "source_sha256": "833064b2ef7a80ca3935a45133d3f3570797dd34f6147916ce331b540b31a09f",
   "ko": ". 귀공에게는 털끝만큼의 흥미\n도 없다. 짐과 맞붙을 수 있는 것은 오직 하나,\n다이쥬지 쿠로와 알 아지프――그\n두 사람이 모는 데몬베인뿐이다」"
  },
  {
   "id": "da0802:T00037",
   "source_sha256": "7ad2a9d7196c2993d5b9b3852abebf1c858b9560562cd5171a67c28144a9b1dc",
   "ko": "「……호오」"
  },
  {
   "id": "da0802:T00038",
   "source_sha256": "dca501b2386cb3a449102be8df8f39259595f9c13b916f936779bd93f77a86e3",
   "ko": "두 기백은 불가시의 압력이 되어 치달려, 양 기체의 중앙에서 충돌했다."
  },
  {
   "id": "da0802:T00039",
   "source_sha256": "1e67f56b2e5b745cb87678d00ec07a6964936037220d4a8970f8781bbc544d8f",
   "ko": "터져 나가는 진홍의 해면/천장을 찌르는 피기둥/쏟아지는 피의 폭우/충만하는 진홍의 안개."
  },
  {
   "id": "da0802:T00040",
   "source_sha256": "4c72b2e3b878ea5d6e019bea2d74830233ffb00bde37dcaf79cd08b5fafb7540",
   "ko": "「……아까의 잡병도 그렇고,\n『블랙 롯지』 패거리는 무척이나 "
  },
  {
   "id": "da0802:R00010",
   "source_sha256": "9d44cfbe5b7f066518fd0e1cbc1de8bb54290f8cd4b9d5402de7da2a4547e2e4",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00041",
   "source_sha256": "853d0c2a015f4e445f8efb7afaa965e619633a3d90a53a1feae79e128856fe95",
   "ko": "지저귀"
  },
  {
   "id": "da0802:T00042",
   "source_sha256": "2862beaea532ef072d5fa7a324b841c9cff3cf2fb4c6716166d340f16d20c6b7",
   "ko": "는 것을 좋아하는 모양이군. 울지만 않았어도\n총에 맞지 않았을 것을!」"
  },
  {
   "id": "da0802:T00043",
   "source_sha256": "e37392323c48c4512c8e2fa933ec6da6c632fa28131bff6a11c01389cefdb091",
   "ko": "당장이라도 덤벼들 듯한 D 투 소드."
  },
  {
   "id": "da0802:T00044",
   "source_sha256": "9c43856ec108022d88ca5d5a3ff63f9acdb35ae7a6c1aef84452853fe5ad20f8",
   "ko": "일촉즉발의 공기."
  },
  {
   "id": "da0802:T00045",
   "source_sha256": "ec02ed112523997fc511175f8ede2f85010930573e3e827ddb3d111c5e722026",
   "ko": "하지만 리베르 레기스는 자세를 잡는 기색조차 보이지 않는다.\n\n　오히려 들려오는 마스터 테리온의 목소리는, 겁에 질린 작은 동물을 "
  },
  {
   "id": "da0802:R00011",
   "source_sha256": "b4c9560cefb959453b8b3a60271b101c3445bf1e27b6e179e850a345b3e07423",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00046",
   "source_sha256": "8459c7cef15e011e1efcb514df8625c44a5542c67d54f6948aa3843c0e66367f",
   "ko": "달래"
  },
  {
   "id": "da0802:T00047",
   "source_sha256": "136f95d1c4357aff595b31e77210bc2de95d6b72082cc9c44c0daa23be7edf67",
   "ko": "고\n구슬리듯 지독히 다정하다."
  },
  {
   "id": "da0802:T00048",
   "source_sha256": "7723bddf0fa24cf1e7c990dd09f22de48cbbc7a78ca4bd4ea092c33bb8bf31b3",
   "ko": "「허세를 부릴 필요는 없다.\n　귀공의 나약함――금이 가,\n　벌거벗겨진 날것의 혼.\n　이 짐승에게는 다 훤히 보인다」"
  },
  {
   "id": "da0802:T00049",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0802:R00012",
   "source_sha256": "0cd7f7295dcb4889ae766e48ca91a49b3cbb9003920bfbefd6c4bfb38286c4f7",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00050",
   "source_sha256": "a4655f8a49afccf41cefd45e5d143e42157e44d1b6c70e2ba96a3e11ce154d4c",
   "ko": "헛소리"
  },
  {
   "id": "da0802:T00051",
   "source_sha256": "a17923b887555d3a48afeb29cfd21256a3ea6bcf2e659d383b4daaead843a5c8",
   "ko": "를……!」"
  },
  {
   "id": "da0802:T00052",
   "source_sha256": "92ad12abcd1714901f85e2ef92505edac18b64f175e8494318947e7ead58d608",
   "ko": "「슬프구나. 흐뭇하구나――\n　"
  },
  {
   "id": "da0802:R00013",
   "source_sha256": "edcd28fa7ea44051f0257ef67461b3825ba660795cc6071fba8ea223214baa1d",
   "ko": "검을",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00053",
   "source_sha256": "eda4f9e77842917f0eb3b924517f95380605bae5ae37dc6bff54f11df3ad5b65",
   "ko": "기사도를"
  },
  {
   "id": "da0802:T00054",
   "source_sha256": "50188b2f2d921ea21180fbc560119e1d27007ac8010265287421c30483a1bb91",
   "ko": " 구가한들,\n　"
  },
  {
   "id": "da0802:R00014",
   "source_sha256": "e6d39fa5cdb6c4da1727f631fbf2e4f4291f034a72be69c956751adcf44399b5",
   "ko": "마음",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00055",
   "source_sha256": "b9ba74447cbaca624042d82c3ebf3f660837db4fac4a072e6a108fbb6413d8bb",
   "ko": "혼"
  },
  {
   "id": "da0802:T00056",
   "source_sha256": "de77c92e700013835c3fc5ad8f581a6c050fa5f015b75f694fe41715cfb4847e",
   "ko": "은 "
  },
  {
   "id": "da0802:R00015",
   "source_sha256": "ba5cc6aa3faed01e4b0e2bc0fb6fc61150d9b3e08de1c40bb0f7334c99299dc5",
   "ko": "강철",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00057",
   "source_sha256": "f41b64d3c24772abd37e163145a07582f3bdd1d89ece02baf8e35bb602284149",
   "ko": "갑주"
  },
  {
   "id": "da0802:T00058",
   "source_sha256": "d5cece9cb5fd6f2af47145fe6a771e8df2d72c3415707923744558f50d252dcd",
   "ko": "로 무장할 수 없다」"
  },
  {
   "id": "da0802:T00059",
   "source_sha256": "7f6f47c61c32b19b0e852a8dcb8ca289f48494a2a4fbc8028d4d32a7a6d71b62",
   "ko": "「……더는 됐다.\n　네놈은 시시한 꿈인 채로 흩어져 사라져라」"
  },
  {
   "id": "da0802:T00060",
   "source_sha256": "26e2fed906eaf72151cbb84474dc65a7d9670cdc1ae564d1640a888b5c5b0fc9",
   "ko": "찰나, 리베르 레기스의 눈앞에서 공간이 비틀리고 일그러졌다."
  },
  {
   "id": "da0802:R00016",
   "source_sha256": "6ac4f04e742442caff21e434c5f92980e1c40ade76e6e62a47263a9452fb6e88",
   "ko": "티마이오스/크리티아스",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00061",
   "source_sha256": "6f21f04474596193a87b2ff94e69dd0cd0d9456d53b069a5deb5cd9dc01decc5",
   "ko": "단쇄술식"
  },
  {
   "id": "da0802:T00062",
   "source_sha256": "c9a25f920b80b0178a2f3df736a9bc3302097b04ded558116112d62ad1db80a3",
   "ko": "의 발동을 의미하는 초상현상."
  },
  {
   "id": "da0802:T00063",
   "source_sha256": "a72ba14708a3a32a3889276a8aa5703221071a46944f4bfd459dd9995ef94d30",
   "ko": "D 투 소드의 모습이 감쪽같이 사라졌다."
  },
  {
   "id": "da0802:T00064",
   "source_sha256": "933dbef9b95c0d63064fcbacd0ed805530c597997e265a6d950310998aa97439",
   "ko": "다음 찰나."
  },
  {
   "id": "da0802:T00065",
   "source_sha256": "3076df596b7c83e55f8bd30092e171639fc0d9aae26c8a3a749473e319aa9933",
   "ko": "D 투 소드는 리베르 레기스의 눈앞에 나타나, 쌍검의 칼날은 진홍의 기체에 닿아 있었다.\n\n　치명적인 일격."
  },
  {
   "id": "da0802:T00066",
   "source_sha256": "6885b45f6d7ca3e5b3e26af1d2e0410b681550d9071c47c35153ef2ea04fd8a4",
   "ko": "쿠자쿠는 승리를 확신한다."
  },
  {
   "id": "da0802:T00067",
   "source_sha256": "972f0dcd9218ff638eaee0964e73bd3953609cc9fdf9d342992f1bd27e9f4df6",
