  },
  {
   "id": "da0802:T00084",
   "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
   "ko": "."
  },
  {
   "id": "da0802:T00085",
   "source_sha256": "ad58e02ae3d6b0f8331aa986b4bff317950a8df8681db76fcea3f16968c1332b",
