   "source_sha256": "fe66455f5b786c26072f4e5fccef5a8b41ec90bfe239c1db9ce3dddb5f4ab7d9",
   "ko": "핸디캡",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00112",
   "source_sha256": "53edf1f646034019284ec5259f9d640da8f37c1261c88950a7bdc73ed1f412a9",
