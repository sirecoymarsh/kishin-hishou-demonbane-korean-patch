  {
   "id": "da0802:T00181",
   "source_sha256": "ac8610a3c4f97f1bf450a789d8a40a8db1ff9215cd2384bb773d76ceae90adf4",
   "ko": "부식되고 비등하는 진홍의 초강."
  },
  {
   "id": "da0802:T00182",
   "source_sha256": "32176cba87b806c25dd8b83719dffd04bd9c45fb9b35ff24ab3ac92c27431da1",
   "ko": "하지만 거기까지다.\n\n　크투가/이타콰의 신수 형태를 가지고도, 이 귀계신을\n멸하는 것은 불가능――"
  },
  {
   "id": "da0802:T00183",
   "source_sha256": "257ee8fb1135e6e3f3066310965afbfe6142cbc9243e5581ebeb47dd5da04001",
   "ko": "「――――」"
  },
  {
   "id": "da0802:T00184",
   "source_sha256": "4973e82b6344221712aa0167269c19b9f94b6b18bf68eee770ab0e1b4622a5bb",
   "ko": "하지만 이 "
  },
  {
   "id": "da0802:R00042",
   "source_sha256": "65d9ed5828d6ad1246d3516525e28b1174429ebf2da37dba35cafb0cc5cbf386",
   "ko": "그라운드 제로",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00185",
   "source_sha256": "77a000c5fbbace98f70063c273bdf7918acd7578604fd95e9d493764667be0af",
   "ko": "폭신지"
  },
  {
   "id": "da0802:T00186",
   "source_sha256": "fa8b86391a059f6368cb172c5048c6b69b9a66414e1ece0e6d232ffaf5fcf64b",
   "ko": "에 스스로 뛰어드는 기영이 있다."
  },
  {
   "id": "da0802:T00187",
   "source_sha256": "792950f090cbc2c3666bf2bd0667f0684eeae6ca7a5d12621049a70089642403",
   "ko": "데몬베인 투 소드."
  },
  {
   "id": "da0802:T00188",
   "source_sha256": "1d10845c6be5beecac31d8eb75c06ea8b6b2cd384b9c8ae06415fa06907dddb4",
   "ko": "그 오른손바닥에는 한층 더한 파멸――절대부정공간을 엮어 올리는 무한 열량을 품고 달린다/비상한다."
  },
  {
   "id": "da0802:T00189",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0802:R00043",
   "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
   "ko": "・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00190",
   "source_sha256": "bda4e57f3c7772bfd287834e488aeb34b362487f9636c1dabc99f799b0674db2",
   "ko": "웃기지 마라"
  },
  {
   "id": "da0802:T00191",
   "source_sha256": "6560fad1b5299ec45c7562b1e825f123c87101dc289a1eb71426e443d34f4c8c",
   "ko": "!」"
  },
  {
   "id": "da0802:T00192",
   "source_sha256": "6bb3581165d49098f9554c6e330ec0dba1d299d34d9a13ed4dd97d11e088abcc",
   "ko": "「――――윽!」"
  },
  {
   "id": "da0802:T00193",
   "source_sha256": "f30875fe01142e2b2db82c6b9576d1f935a2ac203ea365bd75f2f5b4cc6ff6b0",
   "ko": "심장의 방에 다시금 정적이 찾아온다."
  },
  {
   "id": "da0802:T00194",
   "source_sha256": "13fb0d931548f08447baa1d949417eda340c5c703c27f223a34199b2a1f1cb31",
   "ko": "진홍의 해면에 파문을 퍼뜨리며 서 있는 것은 진홍의 기체."
  },
  {
   "id": "da0802:T00195",
   "source_sha256": "538932c17bf96f5fe87eabf2ed35dd1e0e5a10ac374563b7954c9a931dd8d98a",
   "ko": "리베르 레기스는 패왕의 위엄으로 쓰러뜨린 적을 내려다보며,\n　"
  },
  {
   "id": "da0802:R00044",
   "source_sha256": "3a1425568e5b0aec57277e9d21db69ed25c67e37904909267a1d4def9b24ae18",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00196",
   "source_sha256": "1c62b6fb03ee0cb4e13e401577b2fff58bed673bc904c449684156c9e6a0ea5f",
   "ko": "깔보"
  },
  {
   "id": "da0802:T00197",
   "source_sha256": "62d64d02693bead2e352b592f704377be24aefc2dfab87acc47722b79b1ef8b3",
   "ko": "고 있다."
  },
  {
   "id": "da0802:T00198",
   "source_sha256": "69c50b9bb17a625944eec482992621be429bd2500a76a759158477ee8b5fc299",
   "ko": "「이럴…… 리가……」"
  },
  {
   "id": "da0802:T00199",
   "source_sha256": "bc74d02412dadd16db4d60a0b93d96fcc14e532ba990cb614659751b567089cf",
   "ko": "리베르 레기스의 발밑."
  },
  {
   "id": "da0802:T00200",
   "source_sha256": "d021b80cfe703958cb3a7d3e646b68af7ad803bfdc8a4daca11e00d7f1595fb3",
   "ko": "D 투 소드가 피의 바다로 천천히 가라앉아 간다."
  },
  {
   "id": "da0802:T00201",
   "source_sha256": "3a1268d24a4d4931d75a340e6a93ac4e52e240e371152286a069202ab3b45ba0",
   "ko": "기체는 절대영도의 손날에 베여, 반신이 소멸해 있었다."
  },
  {
   "id": "da0802:T00202",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0802:T00203",
   "source_sha256": "c5bc16190e946c4745e56767050a336a9f8d525ccad4316513323cee865d6bf8",
   "ko": "「그아아아아아아아아!」"
  },
  {
   "id": "da0802:T00204",
   "source_sha256": "214c6616a07863d9c0c168fde9ab253ec6b87e00467105801f1094abfdd16d17",
   "ko": "리베르 레기스의 왼손바닥에서 뿜어져 나오는 뇌격이 D 투 소드를 친다."
  },
  {
   "id": "da0802:T00205",
   "source_sha256": "ba642019e2ce00dedb79001acd4b07f3fdaf355192094fc0210df1b0ba3916fc",
   "ko": "기체가 터져 나가며 "
  },
  {
   "id": "da0802:R00045",
   "source_sha256": "0fc256cd359e43981a6ccd05cca823e78bcbc9db7a58d048c6f11d9cc6a430d7",
   "ko": "아조트",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00206",
   "source_sha256": "c31447b2a5eb1552deefa787cc64e00d84b52a923f5cafaea34cba65ca40bbe3",
   "ko": "수은"
  },
  {
   "id": "da0802:T00207",
   "source_sha256": "c114074454d429ad540c073cc62f361fcb4d2404252675e90e4586de2b311ed7",
   "ko": "의 피가 흩날린다."
  },
  {
   "id": "da0802:T00208",
   "source_sha256": "17b29747c77aaf3ffeb4a590af629283591ddddb251209e2383236510e3fbff0",
   "ko": "D 투 소드에게 뇌격을 퍼부으며 마스터 테리온은 외친다."
  },
  {
   "id": "da0802:T00209",
   "source_sha256": "84b66a25aa624ee13b7acef3bd3adc09195b737c99ab5d96915bcf2ab0cf65aa",
   "ko": "「무르다, 무르다, 무르다, 무르다, 무르다앗!\n　이런 것이…… 이런 시시한\n　물건이 데몬베인일 리가\n　있겠느냐!」"
  },
  {
   "id": "da0802:T00210",
   "source_sha256": "8dcf5833d628cdcc574272d046a87bbf2216fcec98902a2c4e5d2461221336ad",
   "ko": "「네놈……윽」"
  },
  {
   "id": "da0802:T00211",
   "source_sha256": "09da0ea5bfc87c954aefe520d9ddcc1501ee430b4a5fd59daf876d37c4b001cd",
   "ko": "「삼위일체에 이르지 못한 데몬베인에게\n　……무슨 의미가 있단 말이냐!」"
  },
  {
   "id": "da0802:T00212",
   "source_sha256": "fd50ffa10b09055c8cd148ce4a77e80e3a059b0e133b6e406e7d4e65d8738d05",
   "ko": "「가아아아아아아아아아아아!」"
  }
 ],
