   "source_sha256": "748a08a50eb367ad86f513eebc650c30597ddc5c36b9442d2171f5f49d262f56",
   "ko": "돈키호테",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00124",
   "source_sha256": "b894040eb4a21194ddd064b5c303bcb6f67c5ac50c088c201474c26fe0b70acd",
   "ko": "영웅광"
  },
  {
   "id": "da0802:T00125",
   "source_sha256": "b69923097cdb1f64bc430b1c27971231c5cee0e78c35596b7626858cd5846871",
   "ko": "! 그 기체, 같은 데몬베인이라고는 도저히 생각할 수 없군!」"
  },
  {
   "id": "da0802:T00126",
   "source_sha256": "76db4f27f8b3cc714dacd615971db8dce5515b554cd05c39b9336277ad00bed1",
   "ko": "「~~~~으윽!\n　네 이노오오오오오옴――!」"
  },
  {
   "id": "da0802:T00127",
   "source_sha256": "cae4c1f34938a490356f237ee07ac0374a428b903c3056a29ebe0e44a164ca1a",
   "ko": "……비교했구나."
  },
  {
   "id": "da0802:T00128",
   "source_sha256": "ad83c84364e0b75cf30594f7cedb4e69dad0531c126db576b22aa43b3a276eff",
   "ko": "또다시 나를――"
  },
  {
   "id": "da0802:R00027",
   "source_sha256": "3c9ac7038c7184d4b1adbfa6c9adafc0d5addc6580fc72f62b24080a66e393cb",
   "ko": "・・　・・・・・・・・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00129",
   "source_sha256": "3724f28b23d1cb9c8b3c3cf0d083ddfe7fb2ae6f004f2823085a05d66efbb83d",
   "ko": "나를, "
  },
  {
