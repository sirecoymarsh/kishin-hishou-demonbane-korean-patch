  },
  {
   "id": "da0802:T00068",
   "source_sha256": "555496f827298f6444d1638a37b58f6a11e0d426125ee2b455b7902cab24a413",
   "ko": "리베르 레기스의 기영을 "
  },
  {
   "id": "da0802:R00017",
   "source_sha256": "c41fc371a325102c525b48b372e16557a1104f96369e42b12441d29329bab54e",
   "ko": "로스트",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00069",
   "source_sha256": "17d3526165cf4020266d8d8b7c59502bbd9d2fa33e6df9598ae2d19f328da994",
