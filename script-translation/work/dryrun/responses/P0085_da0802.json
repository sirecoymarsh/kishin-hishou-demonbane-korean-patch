   "source_sha256": "203832f8bf480ffcfb1fc4e4e3bb62f40430598ad2b79d3b27c4bdc7f25c8d69",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0802:T00106",
   "source_sha256": "f48ed2bf98a06ecae6652053b5a86fd98c9aea4b488fc2f0e5abd306fa7d5089",
