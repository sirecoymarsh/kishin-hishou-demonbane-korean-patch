   "ko": "리치",
   "ruby_action": "keep"
  },
  {
   "id": "da0802:T00110",
   "source_sha256": "37bf92a59bb0de86341e93eb24f98e597242b763c04322b7ff78ceb643b43c72",
   "ko": "간격"
  },
