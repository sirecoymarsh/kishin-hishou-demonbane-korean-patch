  },
  {
   "id": "da0301:T00077",
   "source_sha256": "279fe2792a3378938709338ebe88e973e7d85bec6d3a4325ace41ebf42bd627b",
   "ko": "「하와와와와~~앗!?\n　지진!?"
  },
  {
   "id": "da0301:R00014",
   "source_sha256": "ec3610f870761c52810fae8a983876a3532c119b39ab773e8d1a15bcd4016582",
