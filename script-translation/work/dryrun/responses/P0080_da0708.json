  {
   "id": "da0708:T00062",
   "source_sha256": "ebfa5cf604db959fe2b4103b6723c70bfc563ee000bd9ed4ca5d2d87ea762a02",
   "ko": "엄청난"
  },
  {
   "id": "da0708:T00063",
   "source_sha256": "89e3b55e4bf8e9ac3ba81517b6722c76b4f22b23d946e6dd5249b6ff87a713cd",
   "ko": " 수의 적/적/적."
  },
  {
   "id": "da0708:T00064",
   "source_sha256": "b24660f72734c852ad86364903486606ee6e3feb8e3ef9f4251684fe2d588818",
   "ko": "「기사가 나아가는 길을 막을 수 있을 줄 아느냐!」"
  },
  {
   "id": "da0708:T00065",
   "source_sha256": "0f8405c841db3dd5557267202f8943c30b8fd3ea60f87b43649e72c7e47d6a0b",
   "ko": "하늘을 가득 메울 듯한 적군의 한복판으로 D 투 소드는\n돌격한다."
  },
  {
   "id": "da0708:T00066",
   "source_sha256": "4fc93b0401383eb73058fe8a0f2a0a8137dd81871ac07467f5340f601590ecd9",
   "ko": "다리 실드에 모이는 막대한 에너지."
  },
  {
   "id": "da0708:T00067",
   "source_sha256": "614bf2638d2e88de912ec77c53398dac6cd4b503aed0f49f5ec71149ffcb13d3",
   "ko": "시공간 왜곡 기구의 개방."
  },
  {
   "id": "da0708:T00068",
   "source_sha256": "1199018f5e39299102c2c2611fd09eb76442b2ecde8a45a0b0368290cf00dc05",
   "ko": "보랏빛 번개를 두르고 D 투 소드는 하늘을 달린다."
  },
  {
   "id": "da0708:T00069",
   "source_sha256": "fe609cb4f8d69c53705a5cd1112ebcfcdbaeeba8f23d05c34c411ac17f055a6c",
   "ko": "「나의 일격은,\n　전장을 달리는 기사의 "
  },
  {
   "id": "da0708:R00022",
   "source_sha256": "1ba50fe35870c6445d14c8befb9e71ca013ce3a8456173b5275f9ee3ae0e9fbe",
   "ko": "랜스",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00070",
   "source_sha256": "13514956593b328134092a3da31a6426fbe55480a135c68f27439bbd4ac9244b",
   "ko": "군창"
  },
  {
   "id": "da0708:T00071",
   "source_sha256": "7ae88be5f257ae68dad9faf36cfe820559c1277b33395855fbc70f2368066d6f",
   "ko": "……!」"
  },
  {
   "id": "da0708:T00072",
   "source_sha256": "ad85ab92a39d77606f2d3643c34f4889bffc55a821dde60626f121d102acdaac",
   "ko": "에너지를 나선 모양으로 방출하며 수직 방향으로 급상승."
  },
  {
   "id": "da0708:T00073",
   "source_sha256": "a19da0c210cec49cb8686f42a98a9e8e48b2e4a667b70487243b08e01c2ca6a6",
   "ko": "궤도는 높이, 『몽환심모』의 상공으로."
  },
  {
   "id": "da0708:T00074",
   "source_sha256": "b1e3ced34a35d7b1361d7101a2d03080930004d9eb0e3e6376331aebdab37a6b",
   "ko": "그 모습은 하늘로 승천하는 용을 방불케 한다."
  },
  {
   "id": "da0708:T00075",
   "source_sha256": "a920d0a60972dbbd1dd939521e2658148212958d2f8f7512464359502ee34382",
   "ko": "검은 달을 눈 아래로 내려다보는 위치에서 D 투 소드는 반전한다."
  },
  {
   "id": "da0708:T00076",
   "source_sha256": "0ae4f410db4c24cb7a1867594633d361719e3cd5634429ba6d3bd67af2089f5b",
   "ko": "필살의 파괴력을 머금은 다리를 내지르며――"
  },
  {
   "id": "da0708:T00077",
   "source_sha256": "86a475eefe3f61855ae5d280b0ea35b54f721a5c1d01eea42211bd122d2693c7",
   "ko": "「아틀란티스 스트라이크!」"
  },
  {
   "id": "da0708:T00078",
   "source_sha256": "22aa8b6c8d89d4a30b8e2c4789ed297f074deec4f1daa6dedeb0f324b225f007",
   "ko": "선언대로 D 투 소드는 적진을 꿰뚫는 "
  },
  {
   "id": "da0708:R00023",
   "source_sha256": "1ba50fe35870c6445d14c8befb9e71ca013ce3a8456173b5275f9ee3ae0e9fbe",
   "ko": "랜스로",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00079",
   "source_sha256": "44bb857ca8c173d7b51eef680e9f813bbd330511dcc61353fc7c19bd3d9bf466",
   "ko": "돌격창으로"
  },
  {
   "id": "da0708:T00080",
   "source_sha256": "07caaeaeb1ed43bf3b35188c0d53f63a20133bceb7833ac0b5f8f5901a621859",
   "ko": " 화했다."
  },
  {
   "id": "da0708:T00081",
   "source_sha256": "0805696655aed215f17afc1d1f53ba1af0e5e284a0727dfe19c0c4fbff877a99",
   "ko": "D 투 소드의 궤도상에 있던 파괴로보는 맥없이 폭쇄\n하여 흩어진다.\n\n　닿는 것, "
  },
  {
   "id": "da0708:R00024",
   "source_sha256": "dca68fa81e48ed0c4790233d4757302fe40db9c1b1aa9efb70c35a8bd9d51ae2",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0708:T00082",
   "source_sha256": "3632a77f010c8809111fed6c5ce5475e1dfb08301db5ca6591c4671e3993deac",
   "ko": "스치"
  },
  {
   "id": "da0708:T00083",
   "source_sha256": "ea1fa7f14955e29bf3683c488eb36b0b760e9def072e40dbf1f7ec8c2d6642af",
   "ko": "는 것 일체를 가루로 만들며, "
  },
  {
   "id": "da0708:R00025",
   "source_sha256": "edf34d8c8f95a92154525371c91d667007974fdd34acaafbdb022d60a068f630",
   "ko": "D 투 소드",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00084",
   "source_sha256": "c3aabe8fef45cf95aba9749bac5fdee1a0a1aa86b82ef3775832c8a0f2a1143a",
   "ko": "한 줄기 우레"
  },
  {
   "id": "da0708:T00085",
   "source_sha256": "9d019b6c467bca08053d91d1dc4ccaf97e46c453c1cb825a41658596cba9f402",
   "ko": "는 검은 달을\n향해 떨어진다."
  },
  {
   "id": "da0708:T00086",
   "source_sha256": "04af0bf7c03a4f2082d66ebdb3dbdd78546f22f72ce5a21aed84f76ef236ac25",
   "ko": "「우오오오오오오오오오오오오!」"
  },
  {
   "id": "da0708:T00087",
   "source_sha256": "1ad71dc83bdaee0a3852d45a207850fb912ad35a1419a85ac2edce1e473c4c12",
   "ko": "검은 달을 꿰뚫는다."
  },
  {
   "id": "da0708:R00026",
   "source_sha256": "6a8935c5587aa636c1a9345a016515d7aad23f1555fb04da78faafbe251ad69d",
   "ko": "나이트 오브 투 소드/투 건은",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00088",
   "source_sha256": "dd6cd14acf254f61d971933b8083d13c5768ec47bac2f3cc6a89143e0bba101f",
   "ko": "이투류의 기사는"
  },
  {
   "id": "da0708:T00089",
   "source_sha256": "de77c92e700013835c3fc5ad8f581a6c050fa5f015b75f694fe41715cfb4847e",
   "ko": ", "
  },
  {
   "id": "da0708:R00027",
   "source_sha256": "62e1d9357aa40ffe9ff0a800cb7b5cd3dc8bf8b92617d240e9d95b4b022bbf72",
   "ko": "성",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00090",
   "source_sha256": "5ec7f9ec424e2146c142ace6b5a85cb18b21bf10ff089fe713d38ba37d125c9e",
   "ko": "요새"
  },
  {
   "id": "da0708:T00091",
   "source_sha256": "3b2e79bc719379948597cf4be8f8c76f1b3296e6089b0a355b1d9b49e5503647",
   "ko": "의 "
  },
  {
   "id": "da0708:R00028",
   "source_sha256": "f928a1d8b5112862013422df7230496f194f20b6680c812512a9d4e8a2b7aa4e",
   "ko": "안",
   "ruby_action": "keep"
  },
  {
   "id": "da0708:T00092",
   "source_sha256": "5b95cb1c2764100a07868a754eeeb498259b6107844e4da2d708846fe4f8d66a",
   "ko": "뱃속"
  },
  {
   "id": "da0708:T00093",
   "source_sha256": "3834e63f2e78ba23d91c670ee491da680bfb248120bba792362626920add9b8b",
   "ko": "으로."
  },
  {
   "id": "da0708:T00094",
   "source_sha256": "4fa3292ff5094850b3010fbf34c679de935632ca780a1c7aa2772282afca041b",
   "ko": "――그리하여 첫 번째 배우가 단상 위로.\n\n　자, 달려 나가라. 달려 나가라."
  },
  {
   "id": "da0708:T00095",
   "source_sha256": "4fa4f83643e07d846d7c046aed8a083977292da1cd80d21119ab2489b5cbdce5",
   "ko": "악몽이 자아내는 무대의 대단원을 향해, 곧장."
  },
  {
   "id": "da0708:R00029",
   "source_sha256": "d753ed11243d772a454620b15540a5a511acc09306e14e7d73ef4eb7a2255914",
