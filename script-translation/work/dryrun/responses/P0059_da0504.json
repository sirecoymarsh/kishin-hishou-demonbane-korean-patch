  },
  {
   "id": "da0504:T00050",
   "source_sha256": "4198a355e5f6d9fb1ceb2bfd3d97293653b84ab515c63da3765ea52957960851",
   "ko": "／최악의 마인／산 제물.\n\n　존재／탄생조차 하지 않는 자들."
  },
  {
   "id": "da0504:T00051",
   "source_sha256": "a021d7c3e1248d05b1405ee414992ee09794fce2b9a66597a36561ae5c068bdb",
   "ko": "하지만 지금, 이곳에 적대하는 자들."
  },
  {
   "id": "da0504:T00052",
   "source_sha256": "7e5d770a3015a223b1924efc9072ea92b2be029df5960201b7b7b7186d9ab53e",
   "ko": "윌버 웨이틀리／그 형제."
  },
  {
   "id": "da0504:T00053",
   "source_sha256": "8f8b498092b852969a1e5d0d7078af75428b50222165569b134c0e7ca9eb868b",
   "ko": "『더니치의 괴이』의 원흉／바깥의 신 요그 소토스의 가증스러운\n아들들／사신(邪神)의 피를 이어받은 이형의 쌍둥이.\n\n　사신의 피를 이어받은――"
  },
  {
   "id": "da0504:T00054",
   "source_sha256": "2e60b769d46e80d2f508eb4f5ecc92a57c1e64878eb0bc755a2646dc5615b735",
   "ko": "사신 즈아위아."
  },
  {
   "id": "da0504:T00055",
   "source_sha256": "628b767605aafeb6e9e1b75947fd00d235587d0919816e8f68e3473718cc3b52",
   "ko": "이형의 신／인간이 아닌 것의 신／『"
  },
  {
   "id": "da0504:R00017",
   "source_sha256": "5c51cef06f26605b87bee46e9676ffc37e9cee04685e8016c530f7d626d7e992",
   "ko": "다크니스 던",
   "ruby_action": "keep"
  },
  {
   "id": "da0504:T00056",
   "source_sha256": "4f169313799d4c22aa13ba5ac0dacf173faa3f30668862bfece6fabd614d1f6f",
   "ko": "D∴D∴"
  },
  {
   "id": "da0504:T00057",
   "source_sha256": "6cdd02d4695d2dae0d260320814c3c132059b4ab388040f60d8a12a005be969e",
   "ko": "』에서 받든 신.\n\n　존재／탄생조차 하지 않는 신."
  },
  {
   "id": "da0504:T00058",
   "source_sha256": "462bb4a5ddfcabf5c6e6f3712d5a5e97befbaef313f8ad4dbad8cb3323abb5cf",
   "ko": "하지만 지금, 이곳에 세계를 유린하는 신."
  },
  {
   "id": "da0504:T00059",
   "source_sha256": "9bdddcd096d4d1e7d481d4ddf3995578a20882029d41668c59e9c3c5e13c55bd",
   "ko": "모든 것은 소녀의 안에 새겨진／악몽＝／현실을 침식하고／소녀를 집어삼켜／뒤바뀌려 하는＝그것은 실로 "
  },
  {
   "id": "da0504:R00018",
   "source_sha256": "46a06b5b46eb79a31f2ee4b5c0fa5c1a2da4d8c08cda9a3320553a849ba5e1ee",
   "ko": "섀도",
   "ruby_action": "keep"
  },
  {
   "id": "da0504:T00060",
   "source_sha256": "1cc19d290f3c72bcee13abfc435ed87d3db60a891cac1c189fd34d82b3193389",
   "ko": "그림자"
  },
  {
   "id": "da0504:T00061",
   "source_sha256": "0febf54f6bca7258e97313bff7cc123449ca2e5c31e2373e08babb6298907133",
   "ko": "와도 같이／＝진홍의 반점."
  },
  {
   "id": "da0504:T00062",
   "source_sha256": "71393e61e15ed613c55bfc27714b008deb83d931f0952698f10c62fb7b4aebc2",
   "ko": "『네크로노미콘 혈액언어판』."
  },
  {
   "id": "da0504:T00063",
   "source_sha256": "251cf29865159188d733e75fd2456ca286888100cf92d5dd54c22597afe855fd",
   "ko": "악몽의 현현자／모독자／능욕자／『"
  },
  {
   "id": "da0504:R00019",
   "source_sha256": "4a9f603b79c8a5a24aee4042109b49498e25b3f7803bdb1857389754e6651579",
   "ko": "네크로노미콘",
   "ruby_action": "keep"
  },
  {
   "id": "da0504:T00064",
   "source_sha256": "9d73e1a835ba58111e009c8c636f364ffa12eedd647c25a0c0750ed20b267054",
   "ko": "사본"
  },
  {
   "id": "da0504:T00065",
   "source_sha256": "0880b9a4764859edca19cd994f300cd7f7c59b41a620b79c9116a4e6ff89290d",
   "ko": "』의 이름을 지닌\n　『책』이 아닌 『책』.\n\n　그녀의 술식은 깊게, 깊게, 소녀를 침범한다／범한다."
  },
  {
   "id": "da0504:T00066",
   "source_sha256": "85557043badd6865af96993dadaf0c3b2fe4dab62cf9be420df8bbdf7574f3e7",
   "ko": "「아…… 아아아……」"
  },
  {
   "id": "da0504:T00067",
   "source_sha256": "d27b32d9a180440e6f24821b324824f1c271ea976d6c2a1e9df14044e5216923",
   "ko": "마도서 『알 아지프』는 꿈을 꾼다."
  },
  {
   "id": "da0504:T00068",
   "source_sha256": "fd91287642465e73eef3468c4f47f9d4df68dae7a4e79833479e1846d4233f49",
   "ko": "소녀의 내면에서 생겨난 악몽이 소녀를 멸망시키려 하고 있다."
  },
  {
   "id": "da0504:T00069",
   "source_sha256": "3c628c0b06e953af624333b0e0f5473d1b29374cd0d34423fd4968b5b34a27ab",
   "ko": "하지만, 그러나."
  },
  {
   "id": "da0504:T00070",
   "source_sha256": "957df08e6d2d224d4a983c5aec4d4fada68ef6749f724e2264b24cfa4b622342",
   "ko": "「아……」"
  },
  {
   "id": "da0504:T00071",
   "source_sha256": "55d0b04c19312f5a08703f6567f2746d56dc4a1b2483f5669b2a60494ecfbcbc",
   "ko": "――마도서 『알 아지프』는 꿈을 꾼다."
  },
  {
   "id": "da0504:T00072",
   "source_sha256": "421dd08c64274a3ea28a5323bd592a7afe34ff092fd6a4c1cb5ac7036f2b2cb0",
   "ko": "소녀의 내면에서 생겨나는 꿈은, 결코 악몽뿐만이 아니다."
  },
  {
   "id": "da0504:T00073",
   "source_sha256": "e028b0e4ff700b7127454147a90d5b203bd934f8566ca2c09cacfb892721efcb",
   "ko": "「――힘을, 다오!」"
  }
 ],
