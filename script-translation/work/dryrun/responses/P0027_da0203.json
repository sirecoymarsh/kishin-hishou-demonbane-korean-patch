{
 "schema": "khd-codex-correction-v1",
 "packet_id": "P0027_da0203",
 "model_id": "Gemini 4 Argon (Medium)",
 "records": [
  {
   "id": "da0203:T00001",
   "source_sha256": "2f3a1953eee9949214af00f58253ddeea45fa551f1a8b376785554c24f1230a6",
   "ko": "붉은 검섬."
  },
  {
   "id": "da0203:T00002",
   "source_sha256": "eef4afe80ae982fb16eb21ca64b1376422fced97812b55f61df154aec9071a19",
   "ko": "혈인에서 "
  },
  {
   "id": "da0203:R00001",
   "source_sha256": "74afdae5422fb6e3d4842e8b8771ea6bb428de38c2c1cb59f5e7754ebc7ea1df",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00003",
   "source_sha256": "2a377b6c93f12a8ac2d516ac43bf51aedabd1f528bea634ff29742ceb46e3179",
   "ko": "튀"
  },
  {
   "id": "da0203:T00004",
   "source_sha256": "40ad52d920f1c4bfd6a2aea186b5269085689da1821e3adebde0ba203a236d62",
   "ko": "는 피바람은, 비가 되어 거리를 물들인다."
  },
  {
   "id": "da0203:T00005",
   "source_sha256": "8e61fddba3f5bb047227d69ca91e64bdf6d435b8d7121d4b66ddd993366d60b8",
   "ko": "거리는 순식간에 찢겨 나가고, 잔해가 허공 높이 날아오른다.\n\n　이대로는 데몬베인으로 인한 피해가 커지기만 할 뿐이다."
  },
  {
   "id": "da0203:T00006",
   "source_sha256": "8d6f8c8ba099b2e54772c865682cc5db15d41c4ed04efc8234c900db462a0a69",
   "ko": "어떻게든 하지 않으면……!"
  },
  {
   "id": "da0203:T00007",
   "source_sha256": "98a6474d9d31019cfdb7cc89a8bf2d6c12322ef60da0daa820b97e5747e343e2",
   "ko": "「데몬베인의 머리다」"
  },
  {
   "id": "da0203:T00008",
   "source_sha256": "503629979da1bc91eda2f3575464b03127f59650b45868b8b4904aafdb4398e8",
   "ko": "데몬베인의 정수리에는, 아직도 그 붉은 그림자가 서 있다."
  },
  {
   "id": "da0203:T00009",
   "source_sha256": "5d167163a475098119318a745264e2d4a5a2190dc9e862f90acbb9179da060a7",
   "ko": "저토록 날뛰고 있는데도 털려 떨어질 기색은 없다."
  },
  {
   "id": "da0203:T00010",
   "source_sha256": "b1aad64a47c32d26832f5acc2d91b01f367f46c4d836f407c16221955e6c45a0",
   "ko": "「저 녀석을 제압한다」"
  },
  {
   "id": "da0203:T00011",
   "source_sha256": "7bfe754b0ce02e3d45503b82579f27581061ec0185d1f1605a78d040bfa8c7ab",
   "ko": "「그래……」\n\n　원격 조작인지, 다른 조종자가 있는 건지는 모르겠지만, 녀석이 관여하고 있는 건 틀림없어 보인다.\n\n　문제는 어떻게 접근하느냐인데――"
  },
  {
   "id": "da0203:T00012",
   "source_sha256": "bd9d847d88c6451f6a952dd4c8ba6028a06d31736c47b521bfe0eddbdcfeacd0",
   "ko": "「단숨에 파고든다!」"
  },
  {
   "id": "da0203:T00013",
   "source_sha256": "bb3b9792ccef2f863996c329b77e85565bc3b8b7407f35eec1da87a1d475b1cd",
   "ko": "「제정신이냐……」"
  },
  {
   "id": "da0203:T00014",
   "source_sha256": "8e6593115c3cfaeeabd41c0446082f4160aa0c30fe39c0ed1723717e8d67df06",
   "ko": "마기우스 윙을 지탱하는 마력을 전부 추진력으로 변환."
  },
  {
   "id": "da0203:T00015",
   "source_sha256": "5071d87e43ff828286b73978114870c6b754a751ddd8db6999e10bbf1b37b7ce",
   "ko": "최대 속도로 데몬베인에게 돌격한다.\n\n　혈인은 완전히 실체화된 공격이 아니다."
  },
  {
   "id": "da0203:T00016",
   "source_sha256": "0220df516aee7f7e82b434cf076fee1b71e7366f325d281b38e295763e484ad1",
   "ko": "참격과 참격 사이에 생기는 흔들림을 찌르면―― 돌파할 수 있어!"
  },
  {
   "id": "da0203:T00017",
   "source_sha256": "5f6376b115942408c1039309f5e626c823196b980629a1adc1384b84820c83e4",
   "ko": "「가라아아――――――――――앗!」"
  },
  {
   "id": "da0203:T00018",
   "source_sha256": "2c14695761acce97720d1dec9e204faff8fc54d3b24c2ac15ef81f9445ea90a8",
   "ko": "「!?」"
  },
  {
   "id": "da0203:T00019",
   "source_sha256": "43cabcbdd605efd79cb17283f34a8c8a7fa3f7979465b4d66bcec9894af48888",
   "ko": "참격을 날리고, 다음 참격으로 넘어가는 한순간."
  },
  {
   "id": "da0203:T00020",
   "source_sha256": "9da67723e82dbfc0f1f7d112f3766f356326e84e7afad95e605b7fc824034cf4",
   "ko": "휘둘러 끝낸 혈인의, 반쯤 액체, 반쯤 기체로 화해 있는 한 점을 노린다."
  },
  {
   "id": "da0203:T00021",
   "source_sha256": "2d7ff4a080534621d0abe5a7291c5554e63b2a0b1a7b8288a9b0c78c51229abb",
   "ko": "끈적이는 물의 저항감."
  },
  {
   "id": "da0203:T00022",
   "source_sha256": "8a9e79745675a877e1e43e1abd696587efb780b883dafc10d45641792f24777b",
   "ko": "시야가 붉게 물든다."
  },
  {
   "id": "da0203:T00023",
   "source_sha256": "86f19c23ff312798ab8008bafa964a9561c64d4e3dfc5ef66e8c32badcb6ae72",
   "ko": "돌격의 파워와 내 마력 앞에 혈액은 터져 나가며 피안개로 화한다."
  },
  {
   "id": "da0203:T00024",
   "source_sha256": "ec29d2642243a195b9e6b67166d87111d88de794fb37f0e728b25375e81811b2",
   "ko": "피안개를 가르며, 그대로 멈추지 않고 돌진한다."
  },
  {
   "id": "da0203:T00025",
   "source_sha256": "a1bfe127387c3e2884d0fa6480a3e72ccd537684dbdc31b7efa983bfc65bc363",
   "ko": "향하는 곳은 데몬베인의 정수리, 붉은 그림자."
  },
  {
   "id": "da0203:T00026",
   "source_sha256": "9eb316aa68f0b492a84c11d81176d9e811b58e3741cf1ac6c282bed3f6eb4fee",
   "ko": "「바르자이 언월도!」"
  },
  {
   "id": "da0203:T00027",
   "source_sha256": "3c518d5768f455c62a01b33a8818d72e7702e75f4e838caed68faf3b80a1585a",
   "ko": "전신을 적신 피는 언월도 소환으로 발생한 열풍에 의해 증발."
  },
  {
   "id": "da0203:T00028",
   "source_sha256": "fcf5786bcd76a4695a263d018a110acd2cc1912bc0f232b8cdf03114e2641ac7",
   "ko": "불타는 언월도를 손에 쥐고 붉은 그림자에게 베어든다."
  },
  {
   "id": "da0203:T00029",
   "source_sha256": "ac542b8cb658998d6a4728602160c2057014283c5e95ab43a5ed71df59d9e578",
   "ko": "「꺄악」"
  },
  {
   "id": "da0203:T00030",
   "source_sha256": "9f9aeaa772492cbd30bd162079e1e404a809d65f15a3e53bb6e138c7fb11a610",
   "ko": "붉은 그림자는 데몬베인의 정수리에서 뒤로 뛰어 물러나며 그 일격을 피한다."
  },
  {
   "id": "da0203:T00031",
   "source_sha256": "615399c973285d072579a2e74e29ef062708518f6d734b1a1ca0df8d6173dd58",
   "ko": "그대로 사뿐히 데몬베인의 흉부에 내려앉았다."
  },
  {
   "id": "da0203:T00032",
   "source_sha256": "a518406df9c5e442fdbc32105b6e5d8d7bd47139c029b2d97651a2bffbf9d0c6",
   "ko": "「칫……」"
  },
  {
   "id": "da0203:T00033",
   "source_sha256": "2cbe1f99cd95bbe15762439c05dd5cbe66d2c6bedd464dcda58303172695a778",
   "ko": "나도 이어서 데몬베인의 흉부에 착지한다."
  },
  {
   "id": "da0203:T00034",
   "source_sha256": "7a463b2a9e36596001e3195b70085d6b524002132a245adfef8b31c87c823e3c",
   "ko": "붉은 그림자――\n　『네크로노미콘 혈액언어판』이라 자칭하는 소녀와 처음으로 대치한다.\n\n　붉은 소녀다."
  },
  {
   "id": "da0203:T00035",
   "source_sha256": "a950326ac6fe36b1b9773a324e2f77b600969740bc2bb8abefef2036cad33c48",
   "ko": "몸에 두른 드레스도, 머리칼 색도, 눈동자 색도 전부가 진홍빛."
  },
  {
   "id": "da0203:T00036",
   "source_sha256": "c3d1f3b9a421a53e0e1f299f7f890c6dd891bdfbf73976d408b9bc509781ab23",
   "ko": "확실히 『피』라는 이름을 달기에 걸맞은 모습이다.\n\n　그리고…… 어딘가 모르게, 알을 닮았다."
  },
  {
   "id": "da0203:T00037",
   "source_sha256": "d5fd0a7e73332d11daa2470bf3825040434a0df9f8b16a6b6f484544b15d0655",
   "ko": "그녀가 자칭한 대로 『네크로노미콘』이기 때문――인가."
  },
  {
   "id": "da0203:T00038",
   "source_sha256": "98d596877f0cd3f9c14aa51ab07dacdee0cc0de0d6f1f4d70c7a03f25b22b1d1",
   "ko": "「데몬베인을 멈춰 줘야겠어」"
  },
  {
   "id": "da0203:T00039",
   "source_sha256": "2410441912f52699b232cd85721387b267c2a259e325a57f41cd909d73c1db22",
   "ko": "말하며, 나는 언월도를 고쳐 쥔다."
  },
  {
   "id": "da0203:T00040",
   "source_sha256": "be9393ed44019a3134bc962f940085fd2d667c2ab8df8c29754cc09e590d529a",
   "ko": "그러나 소녀에게 긴장감은 없다."
  },
  {
   "id": "da0203:T00041",
   "source_sha256": "be67f96c9b1c91aced043d2e118e4af0f2d96a31a4c78f78345b648de1ae4e59",
   "ko": "오히려 뺨을 붉게 물들이며 화려한 미소를 띠고 있다."
  },
  {
   "id": "da0203:T00042",
   "source_sha256": "fc35da59c3bd00e121e00aac0ce2a1dbfda3da2d7fe157a06d14d5f902206b47",
   "ko": "「생각했던 대로 예쁜 "
  },
  {
   "id": "da0203:R00002",
   "source_sha256": "fb8e646fc2624863eafe8da67aa8c5b12d57e75ab9e7d3df0be6c3d244a5ea7a",
   "ko": "사람",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00043",
   "source_sha256": "2fda6b57c855f91e96046ee82ae284d1c96a96d9092d7f5adae4cf91822268bc",
   "ko": "남성"
  },
  {
   "id": "da0203:T00044",
   "source_sha256": "d6405f7fc94a7f0b5fe81e4418a992461a01612206762fa48d6489acd140262c",
   "ko": "이네,\n　마스터 오브 네크로노미콘. 기뻐라」"
  },
  {
   "id": "da0203:T00045",
   "source_sha256": "17818eb9a4b2cb1141803c0df488a7775481ace8eb892475055bb473a1411833",
   "ko": "「……무슨 뚱딴지같은 소리야」"
  },
  {
   "id": "da0203:T00046",
   "source_sha256": "3b58d9759412dffdd9e02a6b6d3bf1f3abef0895bd4b36f16902a1384808efe3",
   "ko": "「적의 페이스에 말려들지 마라, 쿠로」"
  },
  {
   "id": "da0203:T00047",
   "source_sha256": "98f6d9093eff90d04b5c4647759db0b990c18663bf494e4f2a78f696c87aad77",
   "ko": "「그런 "
  },
  {
   "id": "da0203:R00003",
   "source_sha256": "7d9ef6f790be558dd88cc1dbb69daa19a57a8084413aa8a6684643d330c636f2",
   "ko": "센스 없",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00048",
   "source_sha256": "d872555c50d301a5d8779538519b72bebeda54dcf335d37c52fc0bfceee35e0e",
   "ko": "볼품없"
  },
  {
   "id": "da0203:T00049",
   "source_sha256": "4c6ff2461396974940d832f3f0ce2a7624668028f9bff88ca807b1e9da44a407",
   "ko": "는 "
  },
  {
   "id": "da0203:R00004",
   "source_sha256": "074efa7a5212f3f8def5214053dc751da74c24b72ef031cdb97b29454a702ac8",
   "ko": "슈트",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00050",
   "source_sha256": "2d4722dc99b3232196988ec4f1dc0177046270f4ffc644a9807c071945d0caed",
   "ko": "술의"
  },
  {
   "id": "da0203:T00051",
   "source_sha256": "926e80d20063d42e85fe553d66a2c24f8afe8430a5eae569d5b7483ea272ffd4",
   "ko": "만 입고 있지 않았더라면,\n　더 멋졌을 텐데」"
  },
  {
   "id": "da0203:T00052",
   "source_sha256": "e764415a39e76550a0adf0ae6d2f22983f462704c7b9ad90b60db4beae40dbb0",
   "ko": "「뭐야아앗!?」"
  },
  {
   "id": "da0203:T00053",
   "source_sha256": "575c1363a64f7a051c1d3cfee5d4ccc021d535300f3f8582540dc862d7b81910",
   "ko": "「페이스에 말려들지 마라」"
  },
  {
   "id": "da0203:T00054",
   "source_sha256": "1e72180e53e34a994220f8dd6d3536857b9fd587daa9fd62dc3bfe7bfbe24cc5",
   "ko": "「있지, 탐정님?」"
  },
  {
   "id": "da0203:T00055",
   "source_sha256": "2c14695761acce97720d1dec9e204faff8fc54d3b24c2ac15ef81f9445ea90a8",
   "ko": "「!?」"
  },
  {
   "id": "da0203:T00056",
   "source_sha256": "ddd4ec048b89ac70ac9d4862d2be80e5612f72e56f9af86b2ef5df7fb292decc",
   "ko": "소녀의 모습이 붉은 바람이 되어 감쪽같이 사라졌다."
  },
  {
   "id": "da0203:T00057",
   "source_sha256": "b0598f37ecf9fd84c846b5380d4cb5a731bbd32c6f4c3f4aa251d0c1a1657465",
   "ko": "정신을 차려 보니, 닿을 듯이 가까운 코앞에 소녀의 얼굴이 있었다."
  },
  {
   "id": "da0203:T00058",
   "source_sha256": "9207722e59d40b0d9bfa0e5b91d2dcfac6e42efd1512e240570915056edf5542",
   "ko": "촉촉이 젖은, "
  },
  {
   "id": "da0203:R00005",
   "source_sha256": "c68abdd3585c6a2a847e664ae57a9c9d347178ed6eb6a2010a2e07feb870c3ad",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00059",
   "source_sha256": "140e9766f5ff4cd881fe6804a19e468ec16942f77f1aa255b20429d754f4a229",
   "ko": "장난기"
  },
  {
   "id": "da0203:T00060",
   "source_sha256": "200a5eaa7dfc5d92855896d66779d670553c8756c60c1fa5266326693acaad99",
   "ko": " 어린 눈동자가 나를 들여다본다."
  },
  {
   "id": "da0203:T00061",
   "source_sha256": "fc5b2caff4b9400a28deffe23a269f26d6a2d91e7881c0fcafe3426643810846",
   "ko": "「어머님 같은 건 홱 버려 버리고,\n　나의 "
  },
  {
   "id": "da0203:R00006",
   "source_sha256": "717edcb4905f7fd4f971cd5a9836181d7c8d6208d65b6faef7ac520be1e1f157",
   "ko": "마스터가",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00062",
   "source_sha256": "b4f3e6a0973ce227d9bc0532cef6afe53bf6c585e59a9f05315cd588649a3b60",
   "ko": "주인님이"
  },
  {
   "id": "da0203:T00063",
   "source_sha256": "abb580288cdc533ea3e6c1b0c9a66f3affe0b82352778e8452225a0585e51ca5",
   "ko": " 되지 않을래?」"
  },
  {
   "id": "da0203:T00064",
   "source_sha256": "76bd6447aa85b29a99985f3924905ba45b72a64b2a288d69f710184f0cc93048",
   "ko": "「어느 틈에……」"
  },
  {
   "id": "da0203:T00065",
   "source_sha256": "2499f8879cc9c245d699ed8ca50af99aafe1c83fae8e60634f9266c746a267a1",
   "ko": "「이이이…… 발칙한 것이이이잇!」"
  },
  {
   "id": "da0203:T00066",
   "source_sha256": "97dbc7d819158851a4fc1a2ece65a485b18d9439979019386aa689374e9e9efc",
   "ko": "알이 술식에 강제 개입하여, 『아틀락 나차』를 발동시킨다."
  },
  {
   "id": "da0203:T00067",
   "source_sha256": "242a5eec30fa0ee737e7babee81100cb2b4c46dceb88f8dd6bcb486157d60147",
   "ko": "내 머리카락이 급격하게 자라나 사방팔방에서 붉은 소녀에게 덮쳐든다."
  },
  {
   "id": "da0203:T00068",
   "source_sha256": "7459fb2fba6f84562a0b7f3ade1863302baed64c58c9c38067ec2a7538d4f944",
   "ko": "하지만 마력의 실에 구속되기 직전, 소녀는 피웅덩이가 되어 무너져 내린다.\n\n　피웅덩이는 장갑 위를 흘러, 콕핏 근처에서 다시 실체화."
  },
  {
   "id": "da0203:T00069",
   "source_sha256": "f6a1b98290870e007a38490adf3803f8ac5525cb423dd0357e43d3a881f3d926",
   "ko": "피웅덩이가 인간 형태를 "
  },
  {
   "id": "da0203:R00007",
   "source_sha256": "a0dee8e3e5ff9bba4994ccc5ecd353b1925736a44c99e6591316c5b50bd66ae0",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00070",
   "source_sha256": "43135e6558669e0d8438d95d62b310d77e51bc13fcde29128ffa03a18f838f4b",
   "ko": "본뜨"
  },
  {
   "id": "da0203:T00071",
   "source_sha256": "8a80546b46d43f773ad6c3438769292319fdd2c197e499ca99c0ff14d91b25b9",
   "ko": "고, "
  },
  {
   "id": "da0203:R00008",
   "source_sha256": "a14f9355ff5bc703aa175f8a795fc49676901e44794150841f01dd2067dea8c3",
   "ko": "루비",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00072",
   "source_sha256": "1bf5b451af8d5132a4d70302a00a2529edad253128ff6f3438f9f64b2cb9fca8",
   "ko": "홍옥"
  },
  {
   "id": "da0203:T00073",
   "source_sha256": "f58eefcaa47f0002af86ea13ee7de4726a8a5c3a3e155f2af915856304a8e59f",
   "ko": "의 빛을 띠고, 생명의 빛을 띠며,\n결정화되어, 다시 소녀의 모습으로."
  },
  {
   "id": "da0203:T00074",
   "source_sha256": "605bc9d6b2ed94e340a66d902d022fae10a1da49a0039de88974106fe215d608",
   "ko": "「큭…… "
  },
  {
   "id": "da0203:R00009",
   "source_sha256": "f2c21a4a79ef6c16a314410b33d3c96ac78e0830c63bda9088eed79b615d0500",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00075",
   "source_sha256": "28f995288781c6f0919e519dc03e71fcbd15350bfba422d6207b761c72978623",
   "ko": "성가"
  },
  {
   "id": "da0203:T00076",
   "source_sha256": "c3a4f61202cadc168a62fbda2d481c00f3bcd58cc28299403b382a2b6594ca7f",
   "ko": "시군!」"
  },
  {
   "id": "da0203:T00077",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0203:R00010",
   "source_sha256": "87042097d2ee79a49bf8ca7e3c47218ec5fe897db356c56d91a2a947ae720e55",
   "ko": "ＳＭ",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00078",
   "source_sha256": "13151ef01645c94dcb4409342d346066d33152460547bda51edd043b7716ed15",
   "ko": "결박"
  },
  {
   "id": "da0203:T00079",
   "source_sha256": "ca84e3f327d7de1c1e1766796c12e2282d45190aca031c61bcc73bf0d7473319",
   "ko": "이 취향이야?」"
  },
  {
   "id": "da0203:T00080",
   "source_sha256": "a43ce7ce935991fe50604b5ca37dc558db8bfc58716b66a7155f738fdc5028fb",
   "ko": "재구성된 소녀의 등 뒤, 콕핏의 해치가 열렸다."
  },
  {
   "id": "da0203:T00081",
   "source_sha256": "f446a30d5d88e2607c48b6c7256d7e962364d923a1984acd741d3e2374c266e8",
   "ko": "콕핏 안쪽에는――"
  },
  {
   "id": "da0203:T00082",
   "source_sha256": "341c92ca92b3f9652bfe64ec893f6d8b3955d98552719e9926686135269cb5e6",
   "ko": "「!?　아차……!」"
  },
  {
   "id": "da0203:T00083",
   "source_sha256": "258e61abe059ca54e4273532d9ff9fb110a57732d9ac6751a695481259bc806b",
   "ko": "정신을 차렸을 때는 사지가 구속되어 있었다."
  },
  {
   "id": "da0203:T00084",
   "source_sha256": "d4d39ab0fc89da05b2dc7f7e90408507e0491fe534ebc6533acad3df3bf7ff3e",
   "ko": "콕핏에서 뻗어 나온 하얀 실――"
  },
  {
   "id": "da0203:T00085",
   "source_sha256": "cae9fa9a0cef1a7aec561148b5cc2d19d7c8ae0ade5e0d50c83fc72a5ea83df7",
   "ko": "마력으로 짜인 "
  },
  {
   "id": "da0203:R00011",
   "source_sha256": "9d60f7f8b8026571ecfcaae81ff0e1c760b66ee5c7995ea60073e71ab04d2cfc",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00086",
   "source_sha256": "0053a539b3dba025dc46731f02aaada506a450abb07c6ca78faee0fbb0ca8641",
   "ko": "거미"
  },
  {
   "id": "da0203:T00087",
   "source_sha256": "7605311004ff42e717bc71c6e8e2f427e7ed75f88807c254722059bd4d07bd96",
   "ko": "줄에 의해서!"
  },
  {
   "id": "da0203:T00088",
   "source_sha256": "6d8d66aa6829974f9b51680ae536a0846bfe306f8b79a9b9c0fce8ce68b0db2a",
   "ko": "「아틀락 나차……!」"
  },
  {
   "id": "da0203:T00089",
   "source_sha256": "ba1bb01e8b34390452a920944787c101766663c2bb0470dc4c5aceb23d216c3c",
   "ko": "콕핏에 숨어 있던 것은 인간과 거미를 합성해 놓은 듯한 형태의 괴물…… 페이지 몬스터로서의 아틀락 나차였다.\n\n　일찍이――라기보단 『전생』――아컴 시티 온 곳에 흩어져 버렸던 알의 페이지가, 괴이가 되어 사건을 일으킨 적이 있었다."
  },
  {
   "id": "da0203:T00090",
   "source_sha256": "0058825772853a7d9c0b18371c6ccf306afde2ea926616995f8d4b902601e561",
   "ko": "이 아틀락 나차도 그런 것들 중 하나다.\n\n　하지만 지금의 알은 완전하기에, 페이지 몬스터만이 날뛰는 일은 있을 수 없다……"
  },
  {
   "id": "da0203:T00091",
   "source_sha256": "9ff1d538c498c5fbeaeb4f872665ca8315c3c2fdc62d9f1b3530a42be6baff4f",
   "ko": " 또다시 「있을 수 없는」 일인가!"
  },
  {
   "id": "da0203:T00092",
   "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
   "ko": "「"
  },
  {
   "id": "da0203:R00012",
   "source_sha256": "fbee93633a78678bb2ab39997c8f5127a4b27206b9c3db9bca41590bc2f8c58c",
   "ko": "디스펠을",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00093",
   "source_sha256": "671eab875b919f2bbaa4f425e551d3c2709400784ec11520bb337743c067a77c",
   "ko": "해주를"
  },
  {
   "id": "da0203:T00094",
   "source_sha256": "d120f2f953f4226825ac0f19a47db773388c0b984f4e9881fcd92dac83935a08",
   "ko": "……"
  },
  {
   "id": "da0203:T00095",
   "source_sha256": "ddf49fab1cce9c80e5818546df8471bda63c4b2b595257651ac30311b3758da0",
   "ko": "후구우웅음!?」"
  },
  {
   "id": "da0203:T00096",
   "source_sha256": "8c30b99fefc5e9420b161efc1c80763ea64eda574527f2a6732ed0c68f9602cd",
   "ko": "알 또한 거미줄에 전신이 "
  },
  {
   "id": "da0203:R00013",
   "source_sha256": "e7637f6e20f680344f0705c868045e5a619fc2241393fa1cad51eb52e582bccd",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00097",
   "source_sha256": "26b9c4d2448e01e48844c03a46ce419830293176f30bfe9ec116ccbfff82bf1b",
   "ko": "휘감"
  },
  {
   "id": "da0203:T00098",
   "source_sha256": "e0e2f1f112f529d1759e316aef3ef7943dc40338aa6f36b9894b8243c494b8c6",
   "ko": "겨, "
  },
  {
   "id": "da0203:R00014",
   "source_sha256": "771a52653949a0062733ea072769333893ed9acd513ed5777d603d4fafdb7380",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00099",
   "source_sha256": "b5dd2e786d797dbcc7fb017552db1c1431fd74eeb024354d79be86f768e1379f",
   "ko": "누에고치"
  },
  {
   "id": "da0203:T00100",
   "source_sha256": "fbd5fa4c03fdbf6ff45a582000536ac078c6adb6c883120d8701f13d2f99d778",
   "ko": "처럼 되고 만다."
  },
  {
   "id": "da0203:T00101",
   "source_sha256": "b0a20029f12a886e0c9854717c80dd9eb98a28fa4322214366aa1d8ff0748864",
   "ko": "이거 좀 위험한데!?"
  },
  {
   "id": "da0203:T00102",
   "source_sha256": "ffbdefc2dc0fcc2870e61b92442fa39fc57c1a0ed5e64384b04eec1c6e14f393",
   "ko": "「큭!　마기우스 윙……!」"
  },
  {
   "id": "da0203:T00103",
   "source_sha256": "11e44732c9de3544106f54e17aaa2e2909a499bf71da98d0050d42e088c3d080",
   "ko": "「잠깐만 얌전히 있어 줘」"
  },
  {
   "id": "da0203:T00104",
   "source_sha256": "275b4c6c67d499e657c39cad6e22311fbfae73a857b6c2d127a8ff828ef9883f",
   "ko": "「그윽!　……읏!?」\n\n　거미줄에 묶인 사지에 통증이 인다."
  },
  {
   "id": "da0203:T00105",
   "source_sha256": "bf43df92049cbe189673a90d417c45c33b81f50e944ead78d62bedff257a9038",
   "ko": "거미줄을 통해 마력이 주입되고 있는 것이다."
  },
  {
   "id": "da0203:T00106",
   "source_sha256": "b4abd36e964af070e5d640aa1278364d21a6c487091fa93bde48d3f45fe02e65",
   "ko": "그 마력에 반응하여, 술의에 마술문자가 떠오른다.\n\n　마술문자는 끝없이 증식하여, 순식간에 술의 전체를 가득 메웠다."
  },
  {
   "id": "da0203:T00107",
   "source_sha256": "7450dfc603a1e6c8893539af579496da85860df59e55cc36263d3f158ea4ea04",
   "ko": "변화는 계속 이어진다."
  },
  {
   "id": "da0203:T00108",
   "source_sha256": "618c0df13d38c847116b36dc0d4651c2089cc4f46955c6b8e4cf0c2ede66f66b",
   "ko": "마술문자는 배열을 바꾸면서, 정사각형으로 구획된 칸――\n마『방』진을 그린다."
  },
  {
   "id": "da0203:T00109",
   "source_sha256": "951d1929d80e8cbc5ca4ea05e2eeb6eee9214ba07acce55f498dd38d6bfc9e27",
   "ko": "칸 하나하나에는 주술적 문양이 적혀 있다."
  },
  {
   "id": "da0203:T00110",
   "source_sha256": "cd9211be60ad5f27463f498d0cc4878ddc0a3bc02185d5cfab3cbf77c135bd0b",
   "ko": "「아이테르 표에 의한 암호 해독."
  },
  {
   "id": "da0203:R00015",
   "source_sha256": "f71a24e1b8fb2fec805d9a7c0b707cf3dc649fcc6d5ea941357ed6968bd59140",
   "ko": "해킹",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00111",
   "source_sha256": "d879420a9d1873415af749999a1a23c4b097dfd2e60c1d79018a252156b893fc",
   "ko": "술식 개입"
  },
  {
   "id": "da0203:T00112",
   "source_sha256": "19e91375244963223e5894c601a6cc7028bf0e9754a9d7bb0fe4ef2b751a3423",
   "ko": "……」"
  },
  {
   "id": "da0203:T00113",
   "source_sha256": "55e6e0b6ac594e956dd332dd43d8ed3b5f11ecd5824b5a12a975aa23c61e5136",
   "ko": "아틀락 나차가 한층 더 실을 토해 낸다."
  },
  {
   "id": "da0203:T00114",
   "source_sha256": "fe019a3fd782dcb1573a88004d83f0150198399daa93a311c83bb9fbe8a225dd",
   "ko": "새로운 실은 촉수처럼 꿈틀거리며 마방진의 칸에 닿는다."
  },
  {
   "id": "da0203:T00115",
   "source_sha256": "a3b7fc9ec9c8383b269bde355a8ba80ebf1ae52648cd7bb7e9039838184836dd",
   "ko": "그때마다 거기에 적힌 마술문양은 형태를 바꾼다."
  },
  {
   "id": "da0203:T00116",
   "source_sha256": "fb7a0a2a555471f92eb9ae21436fd44add56a30626af0c6ffc1bbcd33d202112",
   "ko": "이윽고 거미줄이 빛이 되어 흩어져 사라졌다."
  },
  {
   "id": "da0203:T00117",
   "source_sha256": "dd679c519ca998f55d146cddca1d3315ac5638827ae0f4483c37cda0d8d8e1bb",
   "ko": "술법이 완성된 것이다.\n\n　모든 칸이 똑같은 문양으로 맞춰져 있었다."
  },
  {
   "id": "da0203:T00118",
   "source_sha256": "fd4073c4ecb9690cbeee44e4784a03b5a18d12c7e1cc0d046b1cce3f0f1a36c0",
   "ko": "그리고――"
  },
  {
   "id": "da0203:T00119",
   "source_sha256": "f284d39bf15eba46dfa1fe16345486d2e65a794d9ee76b31231a30dde1c788b1",
   "ko": "「어……?」"
  },
  {
   "id": "da0203:T00120",
   "source_sha256": "7dedd5c5b41eecff9b13d6674d3addb186f1b451017c674eea0d7864be5c101f",
   "ko": "술의가 무너져 내리며, 단순한 마도서의 "
  },
  {
   "id": "da0203:R00016",
   "source_sha256": "2bb9df2369234dd1a09c594d05bb8f486a403b25224bff5eeb85f6e147b6bbbb",
   "ko": "페이지로",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00121",
   "source_sha256": "14dce25b1c1b98453816ea31dcbf87f0006c3fe4f2087db40fccd9cf09497735",
   "ko": "종잇조각으로"
  },
  {
   "id": "da0203:T00122",
   "source_sha256": "3c43cde0f00ba77b2d23984848267106263f693ceda99408ed82a6397924305e",
   "ko": " 분해되었다."
  },
  {
   "id": "da0203:T00123",
   "source_sha256": "9d2fcf2ad520059e8b75202e737fbbb59e1667a7f9c265e1fc3d474ce58fe070",
   "ko": "무슨 일이 일어났는지 한순간 이해하지 못한 나는, 그저 종잇조각 한가운데에 파묻혀 멍하니 있을 뿐이다.\n\n　보니 알 또한 원래의 "
  },
  {
   "id": "da0203:R00017",
   "source_sha256": "4c14fd476de3b66d18d2e79072e1a5979f4fd0c97d02e1814f8e1780e69f4918",
   "ko": "사이즈로",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00124",
   "source_sha256": "c8900ba2f5a4ed5aa4ff9954b0ded2a9c7613775ecb3201238bb0ce599d6f1a4",
   "ko": "체형으로"
  },
  {
   "id": "da0203:T00125",
   "source_sha256": "97828bc05ec2e68323fbb89b1dbe1b6ee97e1f914e30efd5f91abb7986b2b6a4",
   "ko": " 돌아와 있다."
  },
  {
   "id": "da0203:T00126",
   "source_sha256": "5e696371811a8b8b23f1ad51499421321769220ff056b541b3869086e60b94f7",
   "ko": "「……"
  },
  {
   "id": "da0203:R00018",
   "source_sha256": "fbee93633a78678bb2ab39997c8f5127a4b27206b9c3db9bca41590bc2f8c58c",
   "ko": "디스펠이라고",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00127",
   "source_sha256": "671eab875b919f2bbaa4f425e551d3c2709400784ec11520bb337743c067a77c",
   "ko": "해주라고"
  },
  {
   "id": "da0203:T00128",
   "source_sha256": "214284d037f8be4bf0d1f9f69b83129651de6b5783c7dce2347de5f29e518724",
   "ko": "?」"
  },
  {
   "id": "da0203:T00129",
   "source_sha256": "72fea0c8d12fb879129dffeb107fd1f70f92c54a1afa88fb7d10d375a945bf22",
   "ko": "믿기 힘든 일이다."
  },
  {
   "id": "da0203:T00130",
   "source_sha256": "a393f0a12b9fc6482838a683e03317406778967fc5470bdb8e0ba8aba4dd33d8",
   "ko": "『알 아지프』가 짠 강력하고 견고한 마술을 이토록 손쉽게 해주하다니."
  },
  {
   "id": "da0203:T00131",
   "source_sha256": "b15da977c07f98b321ac4c90805736df978c674fe15773e3cec8453bc969a4ad",
   "ko": "「말했잖아?\n　나는 『네크로노미콘』이라고."
  },
  {
   "id": "da0203:R00019",
   "source_sha256": "62f083b66f85bb7e91aeeefb564b5a6991560448a77d686a51788b9945d35e81",
   "ko": "오리지널",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00132",
   "source_sha256": "4da921e3249cf37f25e9927129f9bd2d5bb5d89489adb525d35aa2d7c84b9452",
   "ko": "어머님"
  },
  {
   "id": "da0203:T00133",
   "source_sha256": "57783f645bea6cf678f4c931e44ae4e399494a9702d7c5056bb157453c00ef07",
   "ko": "의 술법 구성 정도는 해독할 수 있어」"
  },
  {
   "id": "da0203:T00134",
   "source_sha256": "55ac26147c0bebca26ef709d564f51f02401649922851fbe415aba8420a71ff9",
   "ko": "「……읏!　쿠로!」"
  },
  {
   "id": "da0203:T00135",
   "source_sha256": "e15995e975c1ee1f8b006a28193b82ad7c72f998e5c530b8a12b7be706876df0",
   "ko": "「그렇게는 안 둬」"
  },
  {
   "id": "da0203:T00136",
   "source_sha256": "036d750c1943c2f5fd9bd7256d40797f32caee1449aff6f592d6da177fce3c23",
   "ko": "다시 마기우스 스타일이 되는 것보다도 빠르게, 소녀는 움직였다.\n\n　붉은 반짝임이 일섬한다."
  },
  {
   "id": "da0203:T00137",
   "source_sha256": "a021e57562487ec7e0e50b074eeef13c06c3001b13080ab47a91127a18a8663b",
   "ko": "붉은 소녀의 손끝에서 쏘아진 그것은 일직선으로 알의 가슴팍으로."
  },
  {
   "id": "da0203:T00138",
   "source_sha256": "deee232520e2949fe2c8c51db5243545ecc037ed85f92852828c7d0201be5ec5",
   "ko": "「뭐……읏」"
  },
  {
   "id": "da0203:T00139",
   "source_sha256": "5b5495d09ce4db0e872d667d6a415dcbdad9d3a945512c3a0d2b0c16b7bb7633",
   "ko": "깊숙이 박힌다."
  },
  {
   "id": "da0203:T00140",
   "source_sha256": "45e1233858065fa96110c7f210bab13485ff448e0f8a3f01cc495ff283e71109",
   "ko": "그것은 "
  },
  {
   "id": "da0203:R00020",
   "source_sha256": "62fc9b08007c20e9b44e53c3f4bafd89409fb71d837015b1fb2cad4bbf38777b",
   "ko": "",
   "ruby_action": "omit_redundant"
  },
  {
   "id": "da0203:T00141",
   "source_sha256": "3117f4ac75807375ba814dfc9a9b618f57f20f43605fa456dafb2302ce688dff",
   "ko": "매끈"
  },
  {
   "id": "da0203:T00142",
   "source_sha256": "bc57ff3e364899cbc189a35c03f2eee51591328736c3193cf32a9e8c3cb26469",
   "ko": "거리는 듯한 붉은빛으로 빛나는 단검…… 아니, 아니다.\n\n　이것은 『열쇠』다."
  },
  {
   "id": "da0203:T00143",
   "source_sha256": "4190ea6912cca7413653662099bf2f9f676444d53485a92fffd231ad527000dd",
   "ko": "『열쇠』를 중심으로, 방금 전과 같은 마방진이 알의 몸으로 퍼져 나간다."
  },
  {
   "id": "da0203:T00144",
   "source_sha256": "48084e51ac424dd9f5f0a1a7a353e68c01e350304d6b7339eee6b335a19aa2b1",
   "ko": "「아…… 아아아아아아아!」"
  },
  {
   "id": "da0203:T00145",
   "source_sha256": "e2edbcf8d0412710afc4c4f8efdc431f34898026d20c29abec33cdaacc5be11d",
   "ko": "갑자기 알이 괴로워하기 시작했다."
  },
  {
   "id": "da0203:T00146",
   "source_sha256": "c8f03c2fd974e6926fed48b95e12e7f766c18b827ea87204eb53ae885130bb34",
   "ko": "『열쇠』가 꽂힌 가슴을 움켜쥐고, 그 자리에 무릎을 꿇는다."
  },
  {
   "id": "da0203:T00147",
   "source_sha256": "98565d934d8923873638d343350cc676d9474b918e300a6937d5e946449df8df",
   "ko": "가슴에서 흘러내리는 것은 피가 아니다."
  },
  {
   "id": "da0203:T00148",
   "source_sha256": "96969f2f8576f3e358bf66e3477e0e3b649d71006aadb5cfbfe9befa53f5de2c",
   "ko": "이것은…… 알에게서 흘러넘치는 것은 마술문자."
  },
  {
   "id": "da0203:T00149",
   "source_sha256": "e2bf1503dee96095e7bbb7e36b58eb93f542509a2badcee8f49323ea187e3574",
   "ko": "마술문자로 구성된 문자열, 『술식』이다.\n\n　알을 구축하는 술식이 지금 해독되려 하고 있는 것이다……!"
  },
  {
   "id": "da0203:T00150",
   "source_sha256": "f2700992ca4e4ffd709b60113222398d007063bb82a7b7719f01ad921a14a542",
   "ko": "「『네크로노미콘』 라틴어판은\n　나의 피가 되었지만, 이것만으로는\n　부족해. 그러니까, 어머님……」"
  },
  {
   "id": "da0203:T00151",
   "source_sha256": "c48c39f9cd0b7709c4fc5188bec7d17a159a5d1d354023be190bfa4dac1a8111",
   "ko": "「당신을 가져가겠어. 당신을 흡수하면,\n　나는 "
  },
  {
   "id": "da0203:R00021",
   "source_sha256": "62f083b66f85bb7e91aeeefb564b5a6991560448a77d686a51788b9945d35e81",
   "ko": "오리지널",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00152",
   "source_sha256": "e57e54128c5fb60905f42a9949963b861a6f4218c2c54a1c856c97b85fc596b2",
   "ko": "진짜"
  },
  {
   "id": "da0203:T00153",
   "source_sha256": "21dd9335220a9e99921bc08b6066412ce85877dcdff2b447d126afb2269611cf",
   "ko": "에 가까워져……!」"
  },
  {
   "id": "da0203:T00154",
   "source_sha256": "ef799ca3fcd3861524fe2e3c5c67eb28f6fc6e28a215709a9ba7e6a2b857e6b6",
   "ko": "「역시 미스캐토닉 대학에 숨어든 건 너였냐!」"
  },
  {
   "id": "da0203:T00155",
   "source_sha256": "40673fd30db87706af9e926341fd6fa7a1aa910ace8e49978049e994baa05f9b",
   "ko": "「비켜 줄래, 탐정님?\n　나, 딱히 당신을 다치게 할 생각은 없어」"
  },
  {
   "id": "da0203:T00156",
   "source_sha256": "398b5a0f05932f1ce0bfa06a1eaa09738fd62dbdbb6c6e5289d064900708fc0e",
   "ko": "「그렇게는 안 되지…… 이 녀석과 나는 "
  },
  {
   "id": "da0203:R00022",
   "source_sha256": "a4f44df5bc0e22b95ea0c84e091cd3fdf621995611b6e95ab8dbb9225d12d2fc",
   "ko": "파트너",
   "ruby_action": "keep"
  },
  {
   "id": "da0203:T00157",
   "source_sha256": "9385c24bdf4ab4a09b14bcee4a5c8efa8e0a0f7aad4d40bf482f4fd28321eb0f",
   "ko": "일심동체"
  },
  {
   "id": "da0203:T00158",
   "source_sha256": "ee1c746b75225d8d6fe1e8f74c86bb4848ee722340ada33b851cb0ac64d86ac5",
   "ko": "라서 말이야.\n　네 멋대로 하게 두진 않겠어!」"
  }
 ],
