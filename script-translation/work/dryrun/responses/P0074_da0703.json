  },
  {
   "id": "da0703:T00147",
   "source_sha256": "367ae7b95570cbe8dbc7905faee145fbd3088bc3db515657dbb3838d2871e424",
   "ko": "을 하고 있군. "
  },
  {
   "id": "da0703:R00041",
   "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
