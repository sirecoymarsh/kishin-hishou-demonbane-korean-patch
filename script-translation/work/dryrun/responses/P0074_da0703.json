 "records": [
  {
   "id": "da0703:T00001",
   "source_sha256": "d92f1f9c5c93254fe8639ddc33c7394e5eaccda5e382d0eda19088a4bbe69156",
   "ko": "「『토이 리애니메이터』 풀가동! 난쟁이 아저씨들, 힘내라아~앗!」"
  },
  {
   "id": "da0703:T00002",
   "source_sha256": "c73f3dee2f99b25a8f457ba6444a5c97f552893428f11a606e515813d6ab87fb",
   "ko": "「후하하하하하! 자, 이 회로를 달면 데몬베인의 성능은 수 배로 뛰어오르는 대가로, 우리는 인간으로서 소중한 무언가를 잃는다!」"
  },
  {
   "id": "da0703:T00003",
   "source_sha256": "b47ff0c4b25e8776e5aae1ca5ad0351edb3969e75703806090fa922c71f0e3e7",
   "ko": "「산더미만큼 말이지」"
  },
  {
   "id": "da0703:T00004",
   "source_sha256": "34b4e7cd97d727c0870f61d6449474306bd7548b450a0fd90a3ef8cd5228772d",
   "ko": "「쓸 데 없 는 짓 하 지 마 라」"
  },
  {
   "id": "da0703:T00005",
   "source_sha256": "35d2f429e5e1d80f71e749afc8399f7292b912a2f91a7e14f265f5f6f7a34e7b",
   "ko": "「부구보옷」"
  },
  {
   "id": "da0703:T00006",
   "source_sha256": "575bdeec9c3fdce478e26bf7f6a4e5b9a48d462bad56efe97a38484c6e4d4645",
   "ko": "「앗, 와이어도 빨리 감기도\n　쓰지 않은 진짜 타격이 정통으로」"
  },
  {
   "id": "da0703:T00007",
   "source_sha256": "bfcd80affb77515c52ed38a690c54aca62917b327b340862d4d43f44b6ca4acf",
   "ko": "토이 리애니메이터의 소형 로봇 군단이, 2대의 데몬베인을 수복, 조정하기 위해 기체에 몰려든다."
  },
  {
   "id": "da0703:T00008",
   "source_sha256": "21175c0f626f3759aff88214fb4dbf7fdb6a0c5de47032e0c28ad75aada99369",
   "ko": "그 모습을 쿠자쿠는 가만히 지켜보고 있었다.\n\n　데몬베인 투 소드의 파손 부위에 눈을 돌린다."
  },
  {
   "id": "da0703:T00009",
   "source_sha256": "ed72358bea352e57297b40ee835b13a2b02ec8ae774a60734b8a00ed37089320",
   "ko": "심각한 데미지는 아니다."
  },
  {
   "id": "da0703:T00010",
   "source_sha256": "ba673fbb55e66fdf992e3e95868f6612af81b35474c645562a26dce8be954136",
   "ko": "토이 리애니메이터의 시스템이라면 금방 수복할 수 있겠지.\n\n　시선은 투 소드에서 떨어져 또 한 대의 데몬베인에게로."
  },
  {
   "id": "da0703:T00011",
   "source_sha256": "5c957cd7286b4e8c2476d04bb28b24fb589d01de213003a1a8b76dd694fda9d1",
   "ko": "다이쥬지 쿠로와 알 아지프가 모는 기체."
  },
  {
   "id": "da0703:R00001",
   "source_sha256": "b750c2ece644240b0f8e138a0602b89062dcd4cb934044a963e76bf34670b76d",
   "ko": "・・・・",
   "ruby_action": "keep"
  },
  {
   "id": "da0703:T00012",
   "source_sha256": "60d3f2aa481d3e30cb0f4593b47252cbafc25945d00ddfd4789503c74d7702b6",
   "ko": "한때의"
  },
  {
   "id": "da0703:T00013",
   "source_sha256": "30e291eb48010c69c847b63596a83c8a865f5b4c9a9ecdfdfff7585bdf48a1a8",
   "ko": ", 데몬베인."
  },
  {
   "id": "da0703:T00014",
   "source_sha256": "fe01fbc44703ec949c41aec974d5f8ef5dfb2170329c2b84c37970b07cf47111",
   "ko": "그것을 올려다보는 소년의 눈동자에 여러 감정이 떠오른다."
  },
  {
   "id": "da0703:T00015",
   "source_sha256": "36c66c68580c92da4d2b93ecf4f53bcdf0d4bcb2459cbf9aa4a1f2d3dc63755d",
   "ko": "외경."
  },
  {
   "id": "da0703:T00016",
   "source_sha256": "4431f73384cbb80d2366cfc0561dadba6435aa1a934db63179f3a6c8bf8c5666",
   "ko": " 동경."
  },
  {
   "id": "da0703:T00017",
   "source_sha256": "0b02fdb008a97887b5ae246049b5b75f5af056cae13616b15d5b6ee79760ed44",
   "ko": " 당혹."
  },
  {
   "id": "da0703:T00018",
   "source_sha256": "c1831cb1fa3e5f5853710227d1d701ba9c41c7dfb424f77142140c32799e83be",
   "ko": " 초조"
  },
  {
   "id": "da0703:T00019",
   "source_sha256": "2845b0b16f9cad9f600d2189c3db4041ac03b61fc775937215ca7141b33b590b",
   "ko": "…… 외포마저도."
  },
  {
   "id": "da0703:T00020",
   "source_sha256": "cb36d5c0301beee4817b62d1874eefa9931de3e3b27bd7ed614ed7f09416274a",
   "ko": "「……데몬베인, 인가」"
  },
  {
   "id": "da0703:T00021",
   "source_sha256": "9fb776fecbb341b5f5906066722ecde5fc56534a6c99ab93908b56f4f0b573d4",
   "ko": "「그래. 인간을 위한 "
  },
  {
   "id": "da0703:R00002",
   "source_sha256": "73ac229cabfac277c315b4b0d1eb76959473af07f58c11d00bb82a06b250745a",
   "ko": "데우스 마키나",
   "ruby_action": "keep"
  },
  {
   "id": "da0703:T00022",
   "source_sha256": "762524a979d84688362b8dc00d54c75a1be10d7917ed188fd55985924c885e49",
   "ko": "귀계신"
  },
  {
   "id": "da0703:T00023",
   "source_sha256": "16f44a85dbe8bfdefc982e8d45f2ebc75d98b77e0f0223e218465671d30048cc",
   "ko": ".\n　신의 섭리마저도 끊어 낸\n　무구한 칼날. 『"
  },
  {
   "id": "da0703:R00003",
   "source_sha256": "faad4663917e9f697861dd8f8351f4b75876f086445f4735d2e147048b1329b2",
   "ko": "데몬베인",
   "ruby_action": "keep"
  },
  {
   "id": "da0703:T00024",
   "source_sha256": "f37a461cecf32165de8e5b8ede7b5229ecf164423d042e304d8dd55fed7e2a65",
   "ko": "마를 끊는 검"
  },
  {
   "id": "da0703:T00025",
   "source_sha256": "daba613ba569fa9b0cb4875e149fe89cf960c624cdf1ca841cdef5d2c93ef2d1",
   "ko": "』이다」"
  },
  {
   "id": "da0703:T00026",
   "source_sha256": "3b0d050e4e989eed97a3ea46301a4e27b6187bc745218ac8c3c32b5b267dbc58",
   "ko": "「……윽!」"
  },
  {
   "id": "da0703:T00027",
   "source_sha256": "a1c64cd1a295a09544f32804fefe9a85156aa35414b8b92bdef816e8559d6b6d",
   "ko": "뒤돌아보는 소년의 시선 끝."
  },
  {
   "id": "da0703:T00028",
   "source_sha256": "f9b3080ab22fe70c52d4462e9ea69ec31ea0a9fbe9afee2d0ed6777b2e3afcae",
   "ko": "어둠 너머에서 흑의의 남자가 모습을 드러낸다."
  },
  {
   "id": "da0703:T00029",
   "source_sha256": "5e696371811a8b8b23f1ad51499421321769220ff056b541b3869086e60b94f7",
   "ko": "「……"
  },
  {
   "id": "da0703:R00004",
   "source_sha256": "e533081aa171fce47c1b7e7265e0f9503a9802e4ae1093331fb742265966d34a",
   "ko": "마스터 오브 네크로노미콘",
   "ruby_action": "keep"
  },
  {
   "id": "da0703:T00030",
   "source_sha256": "b552dfbadf554308b98a24c462f3c1d086bf8ab09671a897b316cb874a78d56a",
   "ko": "『사령비법』의 주인"
  },
  {
   "id": "da0703:T00031",
   "source_sha256": "d93a835d0f2787bcb1a759ad3a1b8fbea56d742d0b99720dbbb9ea8ace1926f8",
   "ko": "」"
  },
  {
   "id": "da0703:T00032",
   "source_sha256": "93ceadad1f77583c12e8a8cc79aac3c0bd914d22276d5e42434436c9f20478c9",
   "ko": "「과거의 주인이지만 말이다」"
  },
  {
   "id": "da0703:T00033",
   "source_sha256": "6d1d9b3cba17505c9b8f57f10835e9f7d51fff3ffcd5b42626d64f2bb5adc22f",
   "ko": "「그리고 마도서 『알 아지프』에\n　새겨진 기억의 현현」"
  },
  {
   "id": "da0703:T00034",
   "source_sha256": "97099ff0bce27fbd9a0f7a65dc6d5ded5cb3da53074abb8471802f62bbdf3f24",
   "ko": "「그래.\n　나는 그 아이가 꾸는 『꿈』이다.\n　그저 환영이지」"
  },
  {
   "id": "da0703:T00035",
   "source_sha256": "e9b74252badab10d1f9ffc7f57dd861a9274b8c93091211fd2c6106194856ccf",
   "ko": "「……하지만 그대는?\n　또 한 대의 데몬베인을 모는 그대는\n　도대체 누구인가?」"
  },
  {
   "id": "da0703:T00036",
   "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
   "ko": "「…………」"
  },
  {
   "id": "da0703:T00037",
   "source_sha256": "3349d03f0bf4405655ea5c5d1f48dbcfdbe22f9caf677895a8221170513f0225",
   "ko": "「나 같은 환영이 아니다.\n　그대는 확실히 피와 살과 혼을 지니고\n　이곳에 실재한다」"
  },
  {
   "id": "da0703:T00038",
   "source_sha256": "1fff446ac9704d940e9bf6185c8930dbc5aff3a3ca8f8bba2c0a2a6cd55ecc4c",
   "ko": "「나는……」"
  },
  {
   "id": "da0703:T00039",
   "source_sha256": "b531bc82ff0eed1007e9781fad283ab43fb030b1c63e33e5e1cd8d65d51fca79",
   "ko": "「……그대의 성질은 저 괴이――\n『네크로노미콘 혈액언어판』에 가깝다」"
  },
  {
   "id": "da0703:T00040",
   "source_sha256": "2efa646fdff1379b445b97a1ba0f8f18a243b263b0161f837613f0638fdfe1c8",
   "ko": "「……윽!」"
  },
  {
   "id": "da0703:T00041",
   "source_sha256": "fba142c7f490d9dd2a05eda0ffbb2cb2c5653ce15a4968d9be5fcc8622e11c4a",
   "ko": "「다시 한번 묻겠다――그대는, 누구냐?」"
  },
  {
   "id": "da0703:T00042",
   "source_sha256": "28dcba4341bc5d7924b9f09d6f87b707b95be1e3d6194f76d6257e57fa351b62",
   "ko": "――나는, "
  },
  {
   "id": "da0703:R00005",
   "source_sha256": "43875788c668dd0af31729d8fdb7f13c77e95d418de16d255783e14be5b7cc1c",
   "ko": "히루코",
   "ruby_action": "keep"
  },
