[
 {
  "sid": "da0111:T00158",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "간직한 앨리슨은, 그 소년",
  "post": " 심상치 않은 무언",
  "jp": "魔術の才を秘めるアリスンは、あの少年に常ならざるものを\n感じ取る。\n\n　それは少年の内部に渦巻く術式――膨大な知識のうね",
  "prev_kind": "text",
  "prev_ko": "「…………」"
 },
 {
  "sid": "da0115:T00051",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "우리는 아미티지 영감님",
  "post": " 비밀도서관에서 일",
  "jp": "俺たちはアーミティッジの爺さんから、秘密図書館で起こった事件の顛末を聞いた。\n\n　あの血の化け物は、秘密図書館にまで魔の",
  "prev_kind": "text",
  "prev_ko": "「한심하게도 말이지」"
 },
 {
  "sid": "da0115:T00127",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "아니면,\n　아미티지 영감님",
  "post": " 오는 것이 대부분",
  "jp": "確かに仕事の依頼は姫さんか、\n　アーミティッジの爺さんからのものがほとんどだ。",
  "prev_kind": "text",
  "prev_ko": "를 넘겨주고 있지 않은가」"
 },
 {
  "sid": "da0203:T00148",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "이것은…… 알",
  "post": " 흘러넘치는 것은 ",
  "jp": "これは……アルから溢れ出すのは魔術文字。",
  "prev_kind": "text",
  "prev_ko": "내리는 것은 피가 아니다."
 },
 {
  "sid": "da0301:T00003",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "",
  "post": " 붉은 그림자가 뛰",
  "jp": "から、紅い影が飛び出した。",
  "prev_kind": "text",
  "prev_ko": "피로 물든 녀석"
 },
 {
  "sid": "da0301:T00018",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "데몬베인",
  "post": " 소년의 노성이 들",
  "jp": "デモンベインから少年の怒声が聴こえる。",
  "prev_kind": "text",
  "prev_ko": "는가, 어나더 블러드!」"
 },
 {
  "sid": "da0301:T00040",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "데몬베인",
  "post": " 시선을 돌린다.",
  "jp": "デモンベインから視線を逸らす。",
  "prev_kind": "text",
  "prev_ko": "「재미있는 걸 보여 줄게」"
 },
 {
  "sid": "da0302:T00018",
  "kind": "text",
  "speaker": "ドクター・ウェスト",
  "pre": "「그것은 일체의 친족",
  "post": " 들어 본 적도 본",
  "jp": "「それは一切の親族に、聞いたことも見たこともない奇怪な妹であった」",
  "prev_kind": "text",
  "prev_ko": "\n　여동생이 몸을 흔든다."
 },
 {
  "sid": "da0302:T00033",
  "kind": "text",
  "speaker": "九郎",
  "pre": "\n\n　그때 알과 붉은 소녀",
  "post": " 흘러넘친 술식에 ",
  "jp": "「そうだ……アル」\n\n　あのときアルと紅の少女からあふれ出た術式に呑まれ、気付けばこの世界にいた。",
  "prev_kind": "text",
  "prev_ko": "하지만 오감은 확실하다."
 },
 {
  "sid": "da0306:T00036",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "클라우디우스",
  "post": " 검은 바람이 뿜어",
  "jp": "クラウディウスから黒い風が噴き出す。",
  "prev_kind": "text",
  "prev_ko": "자군. 하지만 말이야……」"
 },
 {
  "sid": "da0405:T00148",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "\n\n　『알 아지프』는 루리",
  "post": " 마력을 되찾는다.",
  "jp": "続けて、空いた方の手に『アル・アジフ』が再び顕現する。\n\n　『アル・アジフ』は瑠璃から魔力を取り戻す。",
  "prev_kind": "text",
  "prev_ko": "자루의 스틱으로 돌아갔다."
 },
 {
  "sid": "da0503:T00067",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "(『히어로』",
  "post": " 검을 빼앗는다)",
  "jp": "（『ヒーロー』から剣を取り上げる）",
  "prev_kind": "text",
  "prev_ko": "흥미로운 듯 걸어 다닌다)"
 },
 {
  "sid": "da0503:T00098",
  "kind": "text",
  "speaker": "(지문)",
  "pre": "끄덕이고, 관객 중 한 명",
  "post": " ",
  "jp": "紅の少女は頷き、観客の一人から",
  "prev_kind": "text",
  "prev_ko": "「……만들어졌다구?」"
 },
 {
  "sid": "da0505:T00117",
  "kind": "text",
  "speaker": "(지문)",
  "pre": " 『알 아지프』",
  "post": "는 소실된 주문――",
  "jp": "『アル・アジフ』からは失われた呪文――",
  "prev_kind": "text",
  "prev_ko": "그의 발밑에서 잠든"
 },
 {
  "sid": "da0505:T00127",
  "kind": "text",
  "speaker": "アズラッド",
  "pre": "",
  "post": " 벗어날 수 있는 ",
  "jp": "より逃れ得るものはなく",
  "prev_kind": "text",
  "prev_ko": "그대"
 },
 {
  "sid": "da0709:T00036",
  "kind": "text",
  "speaker": "アズラッド",
  "pre": "",
  "post": " 벗어날 수 있는 ",
  "jp": "より逃れ得るものはなく",
  "prev_kind": "text",
  "prev_ko": "그대"
 },
 {
  "sid": "da1305:T00049",
  "kind": "text",
  "speaker": "アナザーブラッド",
  "pre": "「……그러니까 나는 당신",
  "post": " 빼앗겠어.\n　모든",
  "jp": "「……だから私は貴方から奪うわ。\n　何もかも。貴方が存在したという\n　事実自体を。そして――」",
  "prev_kind": "text",
  "prev_ko": "「크…… 학…… 읏!」"
 },
 {
  "sid": "da1309:T00134",
  "kind": "text",
  "speaker": "ナイア",
  "pre": "「쿠자쿠 군",
  "post": " 그대를 떼어냈을 ",
  "jp": "「九朔君から君を分けたとき、",
  "prev_kind": "text",
  "prev_ko": " 섞인 목소리가 답한다."
 }
]