     "ko": "능욕",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00043",
     "kind": "본문",
     "jp": "して、気高い勇気を悪意で",
     "ko": "하고, 고결한 용기를 악의로 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00009",
     "kind": "루비 읽기",
     "jp": "けが",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
