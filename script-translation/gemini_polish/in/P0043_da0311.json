{
 "packet": "P0043_da0311",
 "units": [
  {
   "uid": "da0311:U00001",
   "speaker": "瑠璃",
   "jp": "「く……ぁぁ……っ」",
   "cells": [
    {
     "sid": "da0311:T00001",
     "kind": "본문",
     "jp": "「く……ぁぁ……っ」",
     "ko": "「크…… 아아……앗」"
    }
   ]
  },
  {
   "uid": "da0311:U00002",
   "speaker": "(지문)",
   "jp": "全身を締め付ける腐った内臓の触手。腐肉がぬめる感触と、吐き気をもよおす腐臭に、瑠璃は〈おのの〉慄いた。その表情に嗜虐的な劣情を刺激され、仮面の道化師は〈わら〉嗤う。",
   "cells": [
    {
     "sid": "da0311:T00002",
     "kind": "본문",
     "jp": "全身を締め付ける腐った内臓の触手。",
     "ko": "전신을 조여 오는 썩은 내장의 촉수."
    },
    {
     "sid": "da0311:T00003",
     "kind": "본문",
     "jp": "腐肉がぬめる感触と、吐き気をもよおす腐臭に、瑠璃は",
     "ko": "썩은 고기가 미끈거리는 감촉과 구역질을 유발하는 부패취에 루리는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00001",
     "kind": "루비 읽기",
     "jp": "おのの",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00004",
     "kind": "본문",
     "jp": "慄",
     "ko": "몸서리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00005",
     "kind": "본문",
     "jp": "いた。",
     "ko": "쳤다."
    },
    {
     "sid": "da0311:T00006",
     "kind": "본문",
     "jp": "その表情に嗜虐的な劣情を刺激され、仮面の道化師は",
     "ko": "그 표정에 가학적인 욕정을 자극받아 가면의 광대는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00002",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00007",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00008",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    }
   ]
  },
  {
   "uid": "da0311:U00003",
   "speaker": "ティベリウス",
   "jp": "「相変わらず美味しそうで嬉しいわぁん、\n　瑠璃お嬢ちゃまぁ？」",
   "cells": [
    {
     "sid": "da0311:T00009",
     "kind": "본문",
     "jp": "「相変わらず美味しそうで嬉しいわぁん、\n　瑠璃お嬢ちゃまぁ？」",
     "ko": "「변함없이 맛있어 보여서 기쁘단다앙,\n　루리 아가씨이~?」"
    }
   ]
  },
  {
   "uid": "da0311:U00004",
   "speaker": "瑠璃",
   "jp": "「あぁ……くぅぅ……\n　貴方……人間じゃない……？」",
   "cells": [
    {
     "sid": "da0311:T00010",
     "kind": "본문",
     "jp": "「あぁ……くぅぅ……\n　貴方……人間じゃない……？」",
     "ko": "「아아…… 크으윽……\n　당신…… 인간이 아니군요……?」"
    }
   ]
  },
  {
   "uid": "da0311:U00005",
   "speaker": "ティベリウス",
   "jp": "「失礼ねぇ、『元』人間よ？」",
   "cells": [
    {
     "sid": "da0311:T00011",
     "kind": "본문",
     "jp": "「失礼ねぇ、『元』人間よ？」",
     "ko": "「실례네~, 『전』 인간이란다?」"
    }
   ]
  },
  {
   "uid": "da0311:U00006",
   "speaker": "(지문)",
   "jp": "言って、仮面を外す。その下から現れた素顔を見て、瑠璃は悲鳴を漏らした。",
   "cells": [
    {
     "sid": "da0311:T00012",
     "kind": "본문",
     "jp": "言って、仮面を外す。",
     "ko": "말하며 가면을 벗는다."
    },
    {
     "sid": "da0311:T00013",
     "kind": "본문",
     "jp": "その下から現れた素顔を見て、瑠璃は悲鳴を漏らした。",
     "ko": "그 아래에서 드러난 맨얼굴을 보고 루리는 비명을 흘렸다."
    }
   ]
  },
  {
   "uid": "da0311:U00007",
   "speaker": "瑠璃",
   "jp": "「ひぃっ……し、死体……っ！？」",
   "cells": [
    {
     "sid": "da0311:T00014",
     "kind": "본문",
     "jp": "「ひぃっ……し、死体……っ！？」",
     "ko": "「히익…… 시, 시체……!?」"
    }
   ]
  },
  {
   "uid": "da0311:U00008",
   "speaker": "ティベリウス",
   "jp": "「あらぁん？\n意外に反応が大人しいわねぇん？」",
   "cells": [
    {
     "sid": "da0311:T00015",
     "kind": "본문",
     "jp": "「あらぁん？\n意外に反応が大人しいわねぇん？」",
     "ko": "「어머앙?\n의외로 반응이 얌전하네잉?」"
    }
   ]
  },
  {
   "uid": "da0311:U00009",
   "speaker": "瑠璃",
   "jp": "「あ……あぁぁ……あああ……っ」",
   "cells": [
    {
     "sid": "da0311:T00016",
     "kind": "본문",
     "jp": "「あ……あぁぁ……あああ……っ」",
     "ko": "「아…… 아아아…… 아아아……앗」"
    }
   ]
  },
  {
   "uid": "da0311:U00010",
   "speaker": "ティベリウス",
   "jp": "「昂奮し過ぎて声も出ないのかしら？\n　ふふ……」",
   "cells": [
    {
     "sid": "da0311:T00017",
     "kind": "본문",
     "jp": "「昂奮し過ぎて声も出ないのかしら？\n　ふふ……」",
     "ko": "「너무 흥분해서 목소리도 안 나오는 걸까나?\n　후후……」"
    }
   ]
  },
  {
   "uid": "da0311:U00011",
   "speaker": "瑠璃",
   "jp": "「何の……悪い夢ですか……っ」",
   "cells": [
    {
     "sid": "da0311:T00018",
     "kind": "본문",
     "jp": "「何の……悪い夢ですか……っ」",
     "ko": "「이게 무슨…… 나쁜 꿈인가요……읏」"
    }
   ]
  },
  {
   "uid": "da0311:U00012",
   "speaker": "ティベリウス",
   "jp": "「夢？　夢ねえ……？\n　おほほほほほほほほほほっ！」",
   "cells": [
    {
     "sid": "da0311:T00019",
     "kind": "본문",
     "jp": "「夢？　夢ねえ……？\n　おほほほほほほほほほほっ！」",
     "ko": "「꿈?　꿈이라~……?\n　오호호호호호호호호호홋!」"
    }
   ]
  },
  {
   "uid": "da0311:U00013",
   "speaker": "アナザーブラッド",
   "jp": "「そう……これは悪い夢よ。でもね、〈クィーン〉総帥？」",
   "cells": [
    {
     "sid": "da0311:T00020",
     "kind": "본문",
     "jp": "「そう……これは悪い夢よ。でもね、",
     "ko": "「그래…… 이건 나쁜 꿈이야. 하지만 말이지, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00003",
     "kind": "루비 읽기",
     "jp": "クィーン",
     "ko": "퀸",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00021",
     "kind": "본문",
     "jp": "総帥",
     "ko": "총수",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00022",
     "kind": "본문",
     "jp": "？」",
     "ko": "?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0311:U00014",
   "speaker": "(지문)",
   "jp": "瑠璃の視界が紅く曇る。血の霧が彼女を包み込んでいた。\n\n　茫洋とした少女の姿が霧の中に浮かび上がる。紅の幽霊が、瑠璃の耳元にそっと囁きかける。",
   "cells": [
    {
     "sid": "da0311:T00023",
     "kind": "본문",
     "jp": "瑠璃の視界が紅く曇る。",
     "ko": "루리의 시야가 붉게 흐려진다."
    },
    {
     "sid": "da0311:T00024",
     "kind": "본문",
     "jp": "血の霧が彼女を包み込んでいた。\n\n　茫洋とした少女の姿が霧の中に浮かび上がる。",
     "ko": "피의 안개가 그녀를 감싸고 있었다.\n\n　아련한 소녀의 모습이 안개 속에 떠오른다."
    },
    {
     "sid": "da0311:T00025",
     "kind": "본문",
     "jp": "紅の幽霊が、瑠璃の耳元にそっと囁きかける。",
     "ko": "붉은 유령이 루리의 귓가에 살며시 속삭인다."
    }
   ]
  },
  {
   "uid": "da0311:U00015",
   "speaker": "アナザーブラッド",
   "jp": "「――これは現実を侵す夢」",
   "cells": [
    {
     "sid": "da0311:T00026",
     "kind": "본문",
     "jp": "「――これは現実を侵す夢」",
     "ko": "「――이건 현실을 침식하는 꿈」"
    }
   ]
  },
  {
   "uid": "da0311:U00016",
   "speaker": "(지문)",
   "jp": "しかし少女の存在を、瑠璃は認識していない。瞳は依然、道化師の腐り落ちた〈かお〉貌を見つめている。白骨化した顎をカタカタさせて、道化師が嗤う。",
   "cells": [
    {
     "sid": "da0311:T00027",
     "kind": "본문",
     "jp": "しかし少女の存在を、瑠璃は認識していない。",
     "ko": "그러나 소녀의 존재를 루리는 인식하지 못하고 있다."
    },
    {
     "sid": "da0311:T00028",
     "kind": "본문",
     "jp": "瞳は依然、道化師の腐り落ちた",
     "ko": "눈동자는 여전히 광대의 썩어 문드러진 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00004",
     "kind": "루비 읽기",
     "jp": "かお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00029",
     "kind": "본문",
     "jp": "貌",
     "ko": "얼굴",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00030",
     "kind": "본문",
     "jp": "を見つめている。",
     "ko": "을 응시하고 있다."
    },
    {
     "sid": "da0311:T00031",
     "kind": "본문",
     "jp": "白骨化した顎をカタカタさせて、道化師が嗤う。",
     "ko": "백골화된 턱을 덜그럭거리며 광대가 비웃는다."
    }
   ]
  },
  {
   "uid": "da0311:U00017",
   "speaker": "ティベリウス",
   "jp": "「今度ばかりは助けてくれるヒーローは居ないわよ？　九郎ちゃんは絶賛大苦戦中だしぃ？　メタトロンは……\nあぁ〈はな〉端っから居ないんだったわね」",
   "cells": [
    {
     "sid": "da0311:T00032",
     "kind": "본문",
     "jp": "「今度ばかりは助けてくれるヒーローは居ないわよ？　九郎ちゃんは絶賛大苦戦中だしぃ？　メタトロンは……\nあぁ",
     "ko": "「이번만큼은 구해 줄 히어로는 없단다?　쿠로 쨩은 절찬 대고전 중이고오?　메타트론은……\n아아 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00005",
     "kind": "루비 읽기",
     "jp": "はな",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00033",
     "kind": "본문",
     "jp": "端",
     "ko": "애초",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00034",
     "kind": "본문",
     "jp": "っから居ないんだったわね」",
     "ko": "부터 없었지 참」"
    }
   ]
  },
  {
   "uid": "da0311:U00018",
   "speaker": "アナザーブラッド",
   "jp": "「そう、これは悪夢だもの。\n　都合の良いハッピーエンドはないの。\n　それが――それが私の望む〈セカイ〉物語」",
   "cells": [
    {
     "sid": "da0311:T00035",
     "kind": "본문",
     "jp": "「そう、これは悪夢だもの。\n　都合の良いハッピーエンドはないの。\n　それが――それが私の望む",
     "ko": "「그래, 이건 악몽인걸.\n　형편 좋은 해피 엔딩은 없어.\n　그것이―― 그것이 내가 바라는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00006",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00036",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00037",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0311:U00019",
   "speaker": "ティベリウス",
   "jp": "「誰もアンタを救えない」",
   "cells": [
    {
     "sid": "da0311:T00038",
     "kind": "본문",
     "jp": "「誰もアンタを救えない」",
     "ko": "「아무도 너를 구할 수 없어」"
    }
   ]
  },
  {
   "uid": "da0311:U00020",
   "speaker": "アナザーブラッド",
   "jp": "「救われない〈モノガタリ〉物語を……美しい愛を罪で〈おか〉凌辱して、気高い勇気を悪意で〈けが〉穢して」",
   "cells": [
    {
     "sid": "da0311:T00039",
     "kind": "본문",
     "jp": "「救われない",
     "ko": "「구원받지 못하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00007",
     "kind": "루비 읽기",
     "jp": "モノガタリ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00040",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00041",
     "kind": "본문",
     "jp": "を……美しい愛を罪で",
     "ko": "를…… 아름다운 사랑을 죄로",
