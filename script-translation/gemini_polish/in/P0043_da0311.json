    {
     "sid": "da0311:T00044",
     "kind": "본문",
     "jp": "穢",
     "ko": "더럽히",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00045",
     "kind": "본문",
     "jp": "して」",
     "ko": "고」"
    }
   ]
  },
  {
   "uid": "da0311:U00021",
   "speaker": "ティベリウス",
   "jp": "「さあ……\nグチャグチャに犯してあげるわぁん。\n幸せな時間はもうお〈しま〉終い。あとは\n醒めない悪夢が続くだけよ……」",
   "cells": [
    {
     "sid": "da0311:T00046",
     "kind": "본문",
     "jp": "「さあ……\nグチャグチャに犯してあげるわぁん。\n幸せな時間はもうお",
     "ko": "「자아……\n엉망진창으로 범해 줄게엥.\n행복한 시간은 이제 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00010",
     "kind": "루비 읽기",
     "jp": "しま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00047",
     "kind": "본문",
     "jp": "終",
     "ko": "끝",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00048",
     "kind": "본문",
     "jp": "い。あとは\n醒めない悪夢が続くだけよ……」",
     "ko": ". 이제부터는\n깨어나지 않는 악몽이 계속될 뿐이란다……」"
    }
   ]
  },
  {
   "uid": "da0311:U00022",
   "speaker": "アナザーブラッド",
   "jp": "「綺麗な〈モノガタリ〉物語を悪夢で〈とざ〉鎖し――\n　九朔に繋がる総ての〈セカイ〉可能性を\n　否定してやる」",
   "cells": [
    {
     "sid": "da0311:T00049",
     "kind": "본문",
     "jp": "「綺麗な",
     "ko": "「예쁜 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00011",
     "kind": "루비 읽기",
     "jp": "モノガタリ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00050",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00051",
     "kind": "본문",
     "jp": "を悪夢で",
     "ko": "를 악몽으로 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00012",
     "kind": "루비 읽기",
     "jp": "とざ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00052",
     "kind": "본문",
     "jp": "鎖",
     "ko": "닫아걸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00053",
     "kind": "본문",
     "jp": "し――\n　九朔に繋がる総ての",
     "ko": "어――\n　쿠자쿠로 이어지는 모든 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00013",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00054",
     "kind": "본문",
     "jp": "可能性",
     "ko": "가능성을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00055",
     "kind": "본문",
     "jp": "を\n　否定してやる」",
     "ko": "\n　부정해 주겠어」"
    }
   ]
  },
  {
   "uid": "da0311:U00023",
   "speaker": "ティベリウス",
   "jp": "「……面白くないわね」",
   "cells": [
    {
     "sid": "da0311:T00056",
     "kind": "본문",
     "jp": "「……面白くないわね」",
     "ko": "「……재미없네」"
    }
   ]
  },
  {
   "uid": "da0311:U00024",
   "speaker": "アナザーブラッド",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da0311:T00057",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0311:U00025",
   "speaker": "瑠璃",
   "jp": "「――――」",
   "cells": [
    {
     "sid": "da0311:T00058",
     "kind": "본문",
     "jp": "「――――」",
     "ko": "「――――」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0311:U00026",
   "speaker": "(지문)",
   "jp": "瞳は依然、道化師の腐り落ちた〈かお〉貌を見つめている。恐怖に潤み、だが決して涙を零さない瞳だ。",
   "cells": [
    {
     "sid": "da0311:T00059",
     "kind": "본문",
     "jp": "瞳は依然、道化師の腐り落ちた",
     "ko": "눈동자는 여전히 광대의 썩어 문드러진 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0311:R00014",
     "kind": "루비 읽기",
     "jp": "かお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0311:T00060",
     "kind": "본문",
     "jp": "貌",
     "ko": "얼굴",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0311:T00061",
     "kind": "본문",
     "jp": "を見つめている。",
     "ko": "을 응시하고 있다."
    },
    {
     "sid": "da0311:T00062",
     "kind": "본문",
     "jp": "恐怖に潤み、だが決して涙を零さない瞳だ。",
     "ko": "공포에 젖어 있으나 결코 눈물을 흘리지 않는 눈동자다."
    }
   ]
  },
  {
   "uid": "da0311:U00027",
   "speaker": "ティベリウス",
   "jp": "「アンタ……『前ンとき』はもっと\n　ぎゃあぎゃあ泣き喚いたじゃない」",
   "cells": [
    {
     "sid": "da0311:T00063",
     "kind": "본문",
     "jp": "「アンタ……『前ンとき』はもっと\n　ぎゃあぎゃあ泣き喚いたじゃない」",
     "ko": "「너…… 『저번 때』는 좀 더\n　악악대며 울부짖었잖니」"
    }
   ]
  },
  {
   "uid": "da0311:U00028",
   "speaker": "瑠璃",
   "jp": "「何の話か解かりませんが――」",
   "cells": [
    {
     "sid": "da0311:T00064",
     "kind": "본문",
     "jp": "「何の話か解かりませんが――」",
     "ko": "「무슨 이야기인지 모르겠습니다만――」"
    }
   ]
  },
  {
   "uid": "da0311:U00029",
   "speaker": "(지문)",
   "jp": "恐怖は無論あった。嫌悪感もある。\n\n　だが胸の奥で荒れ狂うこの激情は、それだけによって成るものではないことを瑠璃は知った。\n\n　そう。瑠璃は識っている。\n\n　記憶には、無い。経験にも、無い。\n\n　だが魂が――記憶を、経験を、時間を、因果をも裏切った。\n\n　そう。私は識っている――！\n\n　これは敵だ。決して相容れぬ敵だ。\n\n　人間を冒涜し、嘲弄し、凌辱し、虐殺する存在――『邪悪』だ。人間が……人間であるならば、決して赦してはならない、屈しては\nならない存在だ。\n\n　負けるものか。負けるわけにいくものか。何故なら、私は――",
   "cells": [
    {
     "sid": "da0311:T00065",
     "kind": "본문",
     "jp": "恐怖は無論あった。",
     "ko": "공포는 물론 있었다."
    },
    {
     "sid": "da0311:T00066",
     "kind": "본문",
     "jp": "嫌悪感もある。\n\n　だが胸の奥で荒れ狂うこの激情は、それだけによって成るものではないことを瑠璃は知った。\n\n　そう。",
     "ko": "혐오감도 있다.\n\n　하지만 가슴 깊은 곳에서 사납게 날뛰는 이 격정은 그것만으로 이루어진 것이 아님을 루리는 알았다.\n\n　그렇다."
    },
    {
     "sid": "da0311:T00067",
     "kind": "본문",
     "jp": "瑠璃は識っている。\n\n　記憶には、無い。",
     "ko": "루리는 알고 있다.\n\n　기억에는 없다."
    },
    {
     "sid": "da0311:T00068",
     "kind": "본문",
     "jp": "経験にも、無い。\n\n　だが魂が――記憶を、経験を、時間を、因果をも裏切った。\n\n　そう。",
     "ko": "경험에도 없다.\n\n　하지만 혼이―― 기억을, 경험을, 시간을, 인과마저도 배신했다.\n\n　그렇다."
    },
    {
     "sid": "da0311:T00069",
     "kind": "본문",
     "jp": "私は識っている――！\n\n　これは敵だ。",
     "ko": "나는 알고 있다――!\n\n　이것은 적이다."
    },
    {
     "sid": "da0311:T00070",
     "kind": "본문",
     "jp": "決して相容れぬ敵だ。\n\n　人間を冒涜し、嘲弄し、凌辱し、虐殺する存在――『邪悪』だ。",
     "ko": "결코 용납할 수 없는 적이다.\n\n　인간을 모독하고, 조롱하고, 능욕하고, 학살하는 존재―― 『사악』이다."
    },
    {
     "sid": "da0311:T00071",
     "kind": "본문",
     "jp": "人間が……人間であるならば、決して赦してはならない、屈しては\nならない存在だ。\n\n　負けるものか。",
     "ko": "인간이…… 인간이라면, 결코 용서해서는 안 되는, 굴복해서는 안 되는 존재다.\n\n　질쏘냐."
    },
    {
     "sid": "da0311:T00072",
     "kind": "본문",
     "jp": "負けるわけにいくものか。",
     "ko": "질 수 있을쏘냐."
    },
    {
     "sid": "da0311:T00073",
     "kind": "본문",
     "jp": "何故なら、私は――",
     "ko": "왜냐하면, 나는――"
    }
   ]
  },
  {
   "uid": "da0311:U00030",
   "speaker": "瑠璃",
   "jp": "「――わたくしは覇道瑠璃！\n　覇道を冠する我々が、お前のような\n　邪悪に屈するものですか！」",
   "cells": [
    {
     "sid": "da0311:T00074",
     "kind": "본문",
     "jp": "「――わたくしは覇道瑠璃！\n　覇道を冠する我々が、お前のような\n　邪悪に屈するものですか！」",
     "ko": "「――저는 하도 루리!\n　하도라는 이름을 이은 우리가, 네놈 따위\n　사악에 굴복할 것 같나요!」"
    }
   ]
  },
  {
   "uid": "da0311:U00031",
   "speaker": "(지문)",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0311:T00075",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0311:U00032",
   "speaker": "(지문)",
   "jp": "道化師の表情が変わった。表情など判別できる貌ではないが、それでも瑠璃には判った。怒りと悪意が道化師の中で膨れ上がる。",
   "cells": [
    {
     "sid": "da0311:T00076",
     "kind": "본문",
     "jp": "道化師の表情が変わった。",
     "ko": "광대의 표정이 바뀌었다."
    },
    {
     "sid": "da0311:T00077",
     "kind": "본문",
     "jp": "表情など判別できる貌ではないが、それでも瑠璃には判った。",
     "ko": "표정 따위 판별할 수 있는 얼굴이 아니지만, 그럼에도 루리는 알 수 있었다."
    },
    {
     "sid": "da0311:T00078",
     "kind": "본문",
     "jp": "怒りと悪意が道化師の中で膨れ上がる。",
     "ko": "분노와 악의가 광대 안에서 부풀어 오른다."
    }
   ]
  },
  {
   "uid": "da0311:U00033",
   "speaker": "ティベリウス",
   "jp": "「勇ましいわね、覇道総帥？\n　そのやせ我慢、いつまでもつか\n　試してあげるわ……！」",
   "cells": [
    {
     "sid": "da0311:T00079",
     "kind": "본문",
     "jp": "「勇ましいわね、覇道総帥？\n　そのやせ我慢、いつまでもつか\n　試してあげるわ……！」",
     "ko": "「용감하네, 하도 총수?\n　그 오기, 언제까지 버틸지\n　시험해 줄게……!」"
    }
   ]
  },
  {
   "uid": "da0311:U00034",
   "speaker": "瑠璃",
   "jp": "「……くっ！」",
   "cells": [
    {
     "sid": "da0311:T00080",
     "kind": "본문",
     "jp": "「……くっ！」",
     "ko": "「……큭!」"
    }
   ]
  },
  {
   "uid": "da0311:U00035",
   "speaker": "アナザーブラッド",
   "jp": "「……何なの、この反応は？」",
   "cells": [
    {
     "sid": "da0311:T00081",
     "kind": "본문",
     "jp": "「……何なの、この反応は？」",
     "ko": "「……뭐야, 이 반응은?」"
    }
   ]
  }
 ]
}