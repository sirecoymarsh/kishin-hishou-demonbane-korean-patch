{
 "packet": "P0018_da0115",
 "units": [
  {
   "uid": "da0115:U00001",
   "speaker": "九郎",
   "jp": "「……アーミティッジの爺さん」",
   "cells": [
    {
     "sid": "da0115:T00001",
     "kind": "본문",
     "jp": "「……アーミティッジの爺さん」",
     "ko": "「……아미티지 영감님」"
    }
   ]
  },
  {
   "uid": "da0115:U00002",
   "speaker": "アーミティッジ",
   "jp": "「よく来たな、大十字」",
   "cells": [
    {
     "sid": "da0115:T00002",
     "kind": "본문",
     "jp": "「よく来たな、大十字」",
     "ko": "「잘 왔군, 다이쥬지」"
    }
   ]
  },
  {
   "uid": "da0115:U00003",
   "speaker": "九郎",
   "jp": "「それに……えーと」",
   "cells": [
    {
     "sid": "da0115:T00003",
     "kind": "본문",
     "jp": "「それに……えーと」",
     "ko": "「그리고…… 어라」"
    }
   ]
  },
  {
   "uid": "da0115:U00004",
   "speaker": "ライス",
   "jp": "「ウォーラン・ライスだ。\n　直接、話をしたことはなかったかな」",
   "cells": [
    {
     "sid": "da0115:T00004",
     "kind": "본문",
     "jp": "「ウォーラン・ライスだ。\n　直接、話をしたことはなかったかな」",
     "ko": "「워런 라이스다.\n　직접 이야기를 나눈 적은 없었던가」"
    }
   ]
  },
  {
   "uid": "da0115:U00005",
   "speaker": "九郎",
   "jp": "「あ、ども……大十字九郎です」",
   "cells": [
    {
     "sid": "da0115:T00005",
     "kind": "본문",
     "jp": "「あ、ども……大十字九郎です」",
     "ko": "「아, 안녕하십니까…… 다이쥬지 쿠로입니다」"
    }
   ]
  },
  {
   "uid": "da0115:U00006",
   "speaker": "ライス",
   "jp": "「君のことはアーミティッジ博士から\n　聞いているよ」",
   "cells": [
    {
     "sid": "da0115:T00006",
     "kind": "본문",
     "jp": "「君のことはアーミティッジ博士から\n　聞いているよ」",
     "ko": "「자네 이야기는 아미티지 박사에게\n　들었네」"
    }
   ]
  },
  {
   "uid": "da0115:U00007",
   "speaker": "九郎",
   "jp": "「はあ……」",
   "cells": [
    {
     "sid": "da0115:T00007",
     "kind": "본문",
     "jp": "「はあ……」",
     "ko": "「하아……」"
    }
   ]
  },
  {
   "uid": "da0115:U00008",
   "speaker": "ライス",
   "jp": "「真性の〈ペドフィリア〉下衆野郎だとか」",
   "cells": [
    {
     "sid": "da0115:T00008",
     "kind": "본문",
     "jp": "「真性の",
     "ko": "「진성 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00001",
     "kind": "루비 읽기",
     "jp": "ペドフィリア",
     "ko": "페도필리아",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00009",
     "kind": "본문",
     "jp": "下衆野郎",
     "ko": "개자식",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00010",
     "kind": "본문",
     "jp": "だとか」",
     "ko": "이라던가」"
    }
   ]
  },
  {
   "uid": "da0115:U00009",
   "speaker": "九郎",
   "jp": "「なに吹き込みやがった！？\n　アーミティッジのクソ爺ぃぃぃ――――っ！」",
   "cells": [
    {
     "sid": "da0115:T00011",
     "kind": "본문",
     "jp": "「なに吹き込みやがった！？\n　アーミティッジのクソ爺ぃぃぃ――――っ！」",
     "ko": "「뭘 불어넣은 거야!?\n　아미티지 망할 영감탱이이이――――!」"
    }
   ]
  },
  {
   "uid": "da0115:U00010",
   "speaker": "アーミティッジ",
   "jp": "ｂ＾ー゜）",
   "cells": [
    {
     "sid": "da0115:T00012",
     "kind": "본문",
     "jp": "ｂ＾ー゜）",
     "ko": "ｂ＾ー゜）",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0115:U00011",
   "speaker": "(지문)",
   "jp": "――殺そう。",
   "cells": [
    {
     "sid": "da0115:T00013",
     "kind": "본문",
     "jp": "――殺そう。",
     "ko": "――죽이자."
    }
   ]
  },
  {
   "uid": "da0115:U00012",
   "speaker": "アル",
   "jp": "「ご、ご主人様……\n　はやくぅ、おクスリ……おクスリ……\n　頂戴ぃ……ぃッ」",
   "cells": [
    {
     "sid": "da0115:T00014",
     "kind": "본문",
     "jp": "「ご、ご主人様……\n　はやくぅ、おクスリ……おクスリ……\n　頂戴ぃ……ぃッ」",
     "ko": "「주, 주인님……\n　빨리잉, 약…… 약……\n　주세영…… 읏」"
    }
   ]
  },
  {
   "uid": "da0115:U00013",
   "speaker": "九郎",
   "jp": "「俺を陥れるチャンスは決して逃さないなキサマッ！？」",
   "cells": [
    {
     "sid": "da0115:T00015",
     "kind": "본문",
     "jp": "「俺を陥れるチャンスは決して逃さないなキサマッ！？」",
     "ko": "「날 함정에 빠뜨릴 찬스는 결코 놓치지 않는구나, 네놈은!?」"
    }
   ]
  },
  {
   "uid": "da0115:U00014",
   "speaker": "モーガン",
   "jp": "「フランシス・モーガンです。\n　私は表向き医学部に属してますので、\n　陰秘学科との接点は薄いですが」",
   "cells": [
    {
     "sid": "da0115:T00016",
     "kind": "본문",
     "jp": "「フランシス・モーガンです。\n　私は表向き医学部に属してますので、\n　陰秘学科との接点は薄いですが」",
     "ko": "「프랜시스 모건입니다.\n　저는 대외적으로는 의학부에 속해 있어서,\n　음비학과와의 접점은 옅습니다만」"
    }
   ]
  },
  {
   "uid": "da0115:U00015",
   "speaker": "九郎",
   "jp": "「ああ、よろしく……」",
   "cells": [
    {
     "sid": "da0115:T00017",
     "kind": "본문",
     "jp": "「ああ、よろしく……」",
     "ko": "「아아, 잘 부탁해……」"
    }
   ]
  },
  {
   "uid": "da0115:U00016",
   "speaker": "モーガン",
   "jp": "「ちなみに専攻は比較解剖学ですので、〈ペドフィリア〉精神病は専門外です。\n　お役に立てず、申し訳ありません……」",
   "cells": [
    {
     "sid": "da0115:T00018",
     "kind": "본문",
     "jp": "「ちなみに専攻は比較解剖学ですので、",
     "ko": "「덧붙여 전공은 비교해부학이라서, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00002",
     "kind": "루비 읽기",
     "jp": "ペドフィリア",
     "ko": "페도필리아는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00019",
     "kind": "본문",
     "jp": "精神病",
     "ko": "정신병은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00020",
     "kind": "본문",
     "jp": "は専門外です。\n　お役に立てず、申し訳ありません……」",
     "ko": " 전문 외입니다.\n　도움이 되지 못해 죄송합니다……」"
    }
   ]
  },
  {
   "uid": "da0115:U00017",
   "speaker": "(지문)",
   "jp": "――全員、殺そう。",
   "cells": [
    {
     "sid": "da0115:T00021",
     "kind": "본문",
     "jp": "――全員、殺そう。",
     "ko": "――전원, 죽이자."
    }
   ]
  },
  {
   "uid": "da0115:U00018",
   "speaker": "ハヅキ",
   "jp": "「病んでいるよね、ダディ」",
   "cells": [
    {
     "sid": "da0115:T00022",
     "kind": "본문",
     "jp": "「病んでいるよね、ダディ」",
     "ko": "「병들어 있네, 대디」"
    }
   ]
  },
  {
   "uid": "da0115:U00019",
   "speaker": "シュリュズベリイ",
   "jp": "「実に嘆かわしいな、レディ」",
   "cells": [
    {
     "sid": "da0115:T00023",
     "kind": "본문",
     "jp": "「実に嘆かわしいな、レディ」",
     "ko": "「참으로 한탄스럽구나, 레이디」"
    }
   ]
  },
  {
   "uid": "da0115:U00020",
   "speaker": "九郎",
   "jp": "「黙れ。幼女〈はべ〉侍らした爺ィ」",
   "cells": [
    {
     "sid": "da0115:T00024",
     "kind": "본문",
     "jp": "「黙れ。幼女",
     "ko": "「닥쳐. 로리 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00003",
     "kind": "루비 읽기",
     "jp": "はべ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00025",
     "kind": "본문",
     "jp": "侍",
     "ko": "거느",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00026",
     "kind": "본문",
     "jp": "らした爺ィ」",
     "ko": "린 영감탱이」"
    }
   ]
  },
  {
   "uid": "da0115:U00021",
   "speaker": "ライス",
   "jp": "「まあ、私もモーガン博士も、\n　君とは一度だけ会っているんだがね」",
   "cells": [
    {
     "sid": "da0115:T00027",
     "kind": "본문",
     "jp": "「まあ、私もモーガン博士も、\n　君とは一度だけ会っているんだがね」",
     "ko": "「뭐, 나도 모건 박사도\n　자네와는 한 번 만난 적이 있다네만」"
    }
   ]
  },
  {
   "uid": "da0115:U00022",
   "speaker": "九郎",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da0115:T00028",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0115:U00023",
   "speaker": "ライス",
   "jp": "「ウィルバー・ウェイトリイが〈おぞ〉悍ましい正体を明らかにしたあの夜、私たちも大学にいたのだ」",
   "cells": [
    {
     "sid": "da0115:T00029",
     "kind": "본문",
     "jp": "「ウィルバー・ウェイトリイが",
     "ko": "「윌버 웨이틀리가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00004",
     "kind": "루비 읽기",
     "jp": "おぞ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00030",
     "kind": "본문",
     "jp": "悍",
     "ko": "끔찍",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00031",
     "kind": "본문",
     "jp": "ましい正体を明らかにしたあの夜、私たちも大学にいたのだ」",
     "ko": "한 정체를 드러냈던 그날 밤, 우리도 대학에 있었거든」"
    }
   ]
  },
  {
   "uid": "da0115:U00024",
   "speaker": "九郎",
   "jp": "「……なるほど」",
   "cells": [
    {
     "sid": "da0115:T00032",
     "kind": "본문",
     "jp": "「……なるほど」",
     "ko": "「……과연」"
    }
   ]
  },
  {
   "uid": "da0115:U00025",
   "speaker": "アーミティッジ",
   "jp": "「私に、ライス教授、モーガン博士――\n『ダンウィッチの怪』に関わった三人に、\nクトゥルー教団との戦いに身を投じてきた\nシュリュズベリイ博士。ここにいるメンバー\nはいずれも邪神の脅威を識る者たちだ」",
   "cells": [
    {
     "sid": "da0115:T00033",
     "kind": "본문",
     "jp": "「私に、ライス教授、モーガン博士――\n『ダンウィッチの怪』に関わった三人に、\nクトゥルー教団との戦いに身を投じてきた\nシュリュズベリイ博士。ここにいるメンバー\nはいずれも邪神の脅威を識る者たちだ」",
     "ko": "「나와 라이스 교수, 모건 박사――\n『더니치의 괴이』에 관여했던 세 사람에,\n크툴루 교단과의 싸움에 몸을 던져 온\n슈루즈베리 박사. 여기에 있는 멤버는\n모두 사신의 위협을 아는 자들이다」"
    }
   ]
  },
  {
   "uid": "da0115:U00026",
   "speaker": "シュリュズベリイ",
   "jp": "「君も同じだ――\n　魔導探偵、大十字九郎君」",
   "cells": [
    {
     "sid": "da0115:T00034",
     "kind": "본문",
     "jp": "「君も同じだ――\n　魔導探偵、大十字九郎君」",
     "ko": "「자네도 마찬가지다――\n　마도탐정, 다이쥬지 쿠로 군」"
    }
   ]
  },
  {
   "uid": "da0115:U00027",
   "speaker": "九郎",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0115:T00035",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0115:U00028",
   "speaker": "アル",
   "jp": "「それで……泣く子も黙る\n　特殊資料室が我等に〈なによう〉何用だ？」",
   "cells": [
    {
     "sid": "da0115:T00036",
     "kind": "본문",
     "jp": "「それで……泣く子も黙る\n　特殊資料室が我等に",
     "ko": "「그래서…… 우는 아이도 입을 다문다는\n　특수자료실이 우리에게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00005",
     "kind": "루비 읽기",
     "jp": "なによう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00037",
     "kind": "본문",
     "jp": "何用",
     "ko": "무슨 볼일",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00038",
     "kind": "본문",
     "jp": "だ？」",
     "ko": "이냐?」"
    }
   ]
  },
  {
   "uid": "da0115:U00029",
   "speaker": "シュリュズベリイ",
   "jp": "「そうそう。説明するんだったな」",
   "cells": [
    {
     "sid": "da0115:T00039",
     "kind": "본문",
     "jp": "「そうそう。説明するんだったな」",
     "ko": "「아참, 설명하기로 했었지」"
    }
   ]
  },
  {
   "uid": "da0115:U00030",
   "speaker": "アーミティッジ",
   "jp": "「そう。今回、君を此処に呼んだのは\n　他でもない。\n　今、アーカムシティを騒がしている\n　『血の怪異』についてだ」",
   "cells": [
    {
     "sid": "da0115:T00040",
     "kind": "본문",
     "jp": "「そう。今回、君を此処に呼んだのは\n　他でもない。\n　今、アーカムシティを騒がしている\n　『血の怪異』についてだ」",
     "ko": "「그래. 이번에 자네를 이곳에 부른 것은\n　다름이 아니라네.\n　지금 아컴 시티를 떠들썩하게 만들고 있는\n　『피의 괴이』에 대해서다」"
    }
   ]
  },
  {
   "uid": "da0115:U00031",
   "speaker": "九郎",
   "jp": "「…………」\n\n　こっちから〈たず〉訊ねに行こうかと悩んでいたが……手間が省けたか。",
   "cells": [
    {
     "sid": "da0115:T00041",
     "kind": "본문",
     "jp": "「…………」\n\n　こっちから",
     "ko": "「…………」\n\n　이쪽에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00006",
     "kind": "루비 읽기",
     "jp": "たず",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00042",
     "kind": "본문",
     "jp": "訊",
     "ko": "물어보",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00043",
     "kind": "본문",
     "jp": "ねに行こうかと悩んでいたが……手間が省けたか。",
     "ko": "러 갈까 고민하고 있었는데…… 수고를 덜었나."
    }
   ]
  },
  {
   "uid": "da0115:U00032",
   "speaker": "モーガン",
   "jp": "「あの事件は思っていた以上に、\n　深刻な事態なのです」",
   "cells": [
    {
     "sid": "da0115:T00044",
     "kind": "본문",
     "jp": "「あの事件は思っていた以上に、\n　深刻な事態なのです」",
     "ko": "「그 사건은 생각했던 것 이상으로\n　심각한 사태입니다」"
    }
   ]
  },
  {
   "uid": "da0115:U00033",
   "speaker": "アル",
   "jp": "「……そのようだな」",
   "cells": [
    {
     "sid": "da0115:T00045",
     "kind": "본문",
     "jp": "「……そのようだな」",
     "ko": "「……그런 모양이군」"
    }
   ]
  },
  {
   "uid": "da0115:U00034",
   "speaker": "シュリュズベリイ",
   "jp": "「昨夜の件や、ついさっきのことも気になるだろうが、順を追って説明してゆこう。アーミティッジ博士」",
   "cells": [
    {
     "sid": "da0115:T00046",
     "kind": "본문",
     "jp": "「昨夜の件や、ついさっきのことも気になるだろうが、順を追って説明してゆこう。アーミティッジ博士」",
     "ko": "「어젯밤 일이나 방금 전 일도 신경 쓰이겠지만, 순서대로 설명해 나가도록 하지. 아미티지 박사」"
    }
   ]
  },
  {
   "uid": "da0115:U00035",
   "speaker": "アーミティッジ",
   "jp": "「うむ……」",
   "cells": [
    {
     "sid": "da0115:T00047",
     "kind": "본문",
     "jp": "「うむ……」",
     "ko": "「음……」"
    }
   ]
  },
  {
   "uid": "da0115:U00036",
   "speaker": "九郎",
   "jp": "「『ネクロノミコン』が――」",
   "cells": [
    {
     "sid": "da0115:T00048",
     "kind": "본문",
     "jp": "「『ネクロノミコン』が――」",
     "ko": "「『네크로노미콘』이――」"
    }
   ]
  },
  {
   "uid": "da0115:U00037",
   "speaker": "アル",
   "jp": "「奪われた？」",
   "cells": [
    {
     "sid": "da0115:T00049",
     "kind": "본문",
     "jp": "「奪われた？」",
     "ko": "「강탈당했다고?」"
    }
   ]
  },
  {
   "uid": "da0115:U00038",
   "speaker": "アーミティッジ",
   "jp": "「情けないことにな」",
   "cells": [
    {
     "sid": "da0115:T00050",
     "kind": "본문",
     "jp": "「情けないことにな」",
     "ko": "「한심하게도 말이지」"
    }
   ]
  },
  {
   "uid": "da0115:U00039",
   "speaker": "(지문)",
   "jp": "俺たちはアーミティッジの爺さんから、秘密図書館で起こった事件の顛末を聞いた。\n\n　あの血の化け物は、秘密図書館にまで魔の手を伸ばしていたのだ。しかも、あの『ネクロノミコン』を奪って……！",
   "cells": [
    {
     "sid": "da0115:T00051",
     "kind": "본문",
     "jp": "俺たちはアーミティッジの爺さんから、秘密図書館で起こった事件の顛末を聞いた。\n\n　あの血の化け物は、秘密図書館にまで魔の手を伸ばしていたのだ。",
     "ko": "우리는 아미티지 영감님에게서 비밀도서관에서 일어난 사건의 전말을 들었다.\n\n　그 피의 괴물은 비밀도서관에까지 마수를 뻗치고 있었다."
    },
    {
     "sid": "da0115:T00052",
     "kind": "본문",
     "jp": "しかも、あの『ネクロノミコン』を奪って……！",
     "ko": "게다가 그 『네크로노미콘』을 강탈해 가다니……!"
    }
   ]
  },
  {
   "uid": "da0115:U00040",
   "speaker": "九郎",
   "jp": "「それじゃあ、まるで『ダンウィッチの怪』の再来じゃないか！？」",
   "cells": [
    {
     "sid": "da0115:T00053",
     "kind": "본문",
     "jp": "「それじゃあ、まるで『ダンウィッチの怪』の再来じゃないか！？」",
     "ko": "「그럼 마치 『더니치의 괴이』의 재림이잖아!?」"
    }
   ]
  },
  {
   "uid": "da0115:U00041",
   "speaker": "アーミティッジ",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0115:T00054",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0115:U00042",
   "speaker": "(지문)",
   "jp": "俺の言葉に〈か〉彼の事件に関わった、三博士が一斉に押し黙った。重い沈黙。ややあって、アーミティッジの爺さんが険しい表情で頷く。",
   "cells": [
    {
     "sid": "da0115:T00055",
     "kind": "본문",
     "jp": "俺の言葉に",
     "ko": "내 말에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00007",
     "kind": "루비 읽기",
     "jp": "か",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00056",
     "kind": "본문",
     "jp": "彼",
     "ko": "그",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00057",
     "kind": "본문",
     "jp": "の事件に関わった、三博士が一斉に押し黙った。",
     "ko": " 사건에 관여했던 세 박사가 일제히 입을 다물었다."
    },
    {
     "sid": "da0115:T00058",
     "kind": "본문",
     "jp": "重い沈黙。",
     "ko": "무거운 침묵."
    },
    {
     "sid": "da0115:T00059",
     "kind": "본문",
     "jp": "ややあって、アーミティッジの爺さんが険しい表情で頷く。",
     "ko": "잠시 후, 아미티지 영감님이 험악한 표정으로 고개를 끄덕인다."
    }
   ]
  },
  {
   "uid": "da0115:U00043",
   "speaker": "アーミティッジ",
   "jp": "「まさにその通りなのだよ」",
   "cells": [
    {
     "sid": "da0115:T00060",
     "kind": "본문",
     "jp": "「まさにその通りなのだよ」",
     "ko": "「바로 그 말대로라네」"
    }
   ]
  },
  {
   "uid": "da0115:U00044",
   "speaker": "九郎",
   "jp": "「えっ？」",
   "cells": [
    {
     "sid": "da0115:T00061",
     "kind": "본문",
     "jp": "「えっ？」",
     "ko": "「어?」"
    }
   ]
  },
  {
   "uid": "da0115:U00045",
   "speaker": "モーガン",
   "jp": "「あの臭い……忌々しいことに\n　はっきりと憶えていました。\n　忘れたくても、忘れさせてくれない\n　ようです」",
   "cells": [
    {
     "sid": "da0115:T00062",
     "kind": "본문",
     "jp": "「あの臭い……忌々しいことに\n　はっきりと憶えていました。\n　忘れたくても、忘れさせてくれない\n　ようです」",
     "ko": "「그 냄새…… 끔찍하게도\n　또렷이 기억하고 있었습니다.\n　잊고 싶어도 잊게 해주지 않는\n　모양입니다」"
    }
   ]
  },
  {
   "uid": "da0115:U00046",
   "speaker": "ライス",
   "jp": "「……アーミティッジ博士は\n　見たんですな？」",
   "cells": [
    {
     "sid": "da0115:T00063",
     "kind": "본문",
     "jp": "「……アーミティッジ博士は\n　見たんですな？」",
     "ko": "「……아미티지 박사께서는\n　보셨군요?」"
    }
   ]
  },
  {
   "uid": "da0115:U00047",
   "speaker": "アーミティッジ",
   "jp": "「ああ。あの血の怪異に招喚されたのは――ウィルバー・ウェイトリイの兄弟に相違ない」",
   "cells": [
    {
     "sid": "da0115:T00064",
     "kind": "본문",
     "jp": "「ああ。あの血の怪異に招喚されたのは――ウィルバー・ウェイトリイの兄弟に相違ない」",
     "ko": "「그래. 그 피의 괴이에게 소환된 것은――윌버 웨이틀리의 형제임이 틀림없다」"
    }
   ]
  },
  {
   "uid": "da0115:U00048",
   "speaker": "アル",
   "jp": "「何だと！？」",
   "cells": [
    {
     "sid": "da0115:T00065",
     "kind": "본문",
     "jp": "「何だと！？」",
     "ko": "「뭐라고!?」"
    }
   ]
  },
  {
   "uid": "da0115:U00049",
   "speaker": "九郎",
   "jp": "「そんな馬鹿な！」",
   "cells": [
    {
     "sid": "da0115:T00066",
     "kind": "본문",
     "jp": "「そんな馬鹿な！」",
     "ko": "「그럴 리가!」"
    }
   ]
  },
  {
   "uid": "da0115:U00050",
   "speaker": "シュリュズベリイ",
   "jp": "「〈・・・・・・〉そんな馬鹿な事態が続いているのだよ。\n　私が遭遇した怪異もそうだ」",
   "cells": [
    {
     "sid": "da0115:T00067",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0115:R00008",
     "kind": "루비 읽기",
     "jp": "・・・・・・",
     "ko": "・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00068",
     "kind": "본문",
     "jp": "そんな馬鹿な",
     "ko": "그럴 리가 없는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00069",
     "kind": "본문",
     "jp": "事態が続いているのだよ。\n　私が遭遇した怪異もそうだ」",
     "ko": " 사태가 계속되고 있다네.\n　내가 조우한 괴이도 그렇다」"
    }
   ]
  },
  {
   "uid": "da0115:U00051",
   "speaker": "九郎",
   "jp": "「昨日の事件か」",
   "cells": [
    {
     "sid": "da0115:T00070",
     "kind": "본문",
     "jp": "「昨日の事件か」",
     "ko": "「어제 사건인가」"
    }
   ]
  },
  {
   "uid": "da0115:U00052",
   "speaker": "アル",
   "jp": "「ようやく本題に入ったな」",
   "cells": [
    {
     "sid": "da0115:T00071",
     "kind": "본문",
     "jp": "「ようやく本題に入ったな」",
     "ko": "「드디어 본론으로 들어갔군」"
    }
   ]
  },
  {
   "uid": "da0115:U00053",
   "speaker": "シュリュズベリイ",
   "jp": "「私が昨夜、交戦したあの怪異は――〈デウス・マキナ〉鬼械神を招喚した」",
   "cells": [
    {
     "sid": "da0115:T00072",
     "kind": "본문",
     "jp": "「私が昨夜、交戦したあの怪異は――",
     "ko": "「내가 어젯밤 교전했던 그 괴이는――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00009",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00073",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00074",
     "kind": "본문",
     "jp": "を招喚した」",
     "ko": " 소환했다」"
    }
   ]
  },
  {
   "uid": "da0115:U00054",
   "speaker": "九郎",
   "jp": "「なぁ……ッ！？」",
   "cells": [
    {
     "sid": "da0115:T00075",
     "kind": "본문",
     "jp": "「なぁ……ッ！？」",
     "ko": "「뭐……라고!?」"
    }
   ]
  },
  {
   "uid": "da0115:U00055",
   "speaker": "アル",
   "jp": "「〈デウス・マキナ〉鬼械神だと……！？」",
   "cells": [
    {
     "sid": "da0115:T00076",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0115:R00010",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나라고",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00077",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신이라고",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00078",
     "kind": "본문",
     "jp": "だと……！？」",
     "ko": "……!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0115:U00056",
   "speaker": "シュリュズベリイ",
   "jp": "「あの区画の破壊痕は、〈デウス・マキナ〉鬼械神の攻撃によるものだ。そして――」",
   "cells": [
    {
     "sid": "da0115:T00079",
     "kind": "본문",
     "jp": "「あの区画の破壊痕は、",
     "ko": "「그 구획의 파괴 흔적은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00011",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00080",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00081",
     "kind": "본문",
     "jp": "の攻撃によるものだ。",
     "ko": "의 공격으로 생긴 것이다."
    },
    {
     "sid": "da0115:T00082",
     "kind": "본문",
     "jp": "そして――」",
     "ko": "그리고――」"
    }
   ]
  },
  {
   "uid": "da0115:U00057",
   "speaker": "ハヅキ",
   "jp": "「あの〈デウス・マキナ〉鬼械神が享けている力はハスター。\n　私と同じ」",
   "cells": [
    {
     "sid": "da0115:T00083",
     "kind": "본문",
     "jp": "「あの",
     "ko": "「그 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0115:R00012",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0115:T00084",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0115:T00085",
     "kind": "본문",
     "jp": "が享けている力はハスター。\n　私と同じ」",
     "ko": " 이어받은 힘은 하스터.\n　나와 같아」"
    }
   ]
  },
  {
   "uid": "da0115:U00058",
   "speaker": "(지문)",
   "jp": "悪い予感は、最悪の確信になりつつあった。ハスターの魔力を享けた鬼械神。そいつはやはり――",
   "cells": [
    {
     "sid": "da0115:T00086",
     "kind": "본문",
     "jp": "悪い予感は、最悪の確信になりつつあった。",
     "ko": "불길한 예감은 최악의 확신이 되어 가고 있었다."
    },
    {
     "sid": "da0115:T00087",
     "kind": "본문",
     "jp": "ハスターの魔力を享けた鬼械神。",
     "ko": "하스터의 마력을 이어받은 귀계신."
    },
    {
     "sid": "da0115:T00088",
     "kind": "본문",
     "jp": "そいつはやはり――",
     "ko": "그 녀석은 역시――"
    }
   ]
  },
  {
   "uid": "da0115:U00059",
   "speaker": "九郎",
   "jp": "「性格捻じ曲がったクソガキはいたか？」",
   "cells": [
    {
     "sid": "da0115:T00089",
     "kind": "본문",
     "jp": "「性格捻じ曲がったクソガキはいたか？」",
     "ko": "「성격 비틀린 망할 꼬맹이는 있었어?」"
    }
   ]
  },
  {
   "uid": "da0115:U00060",
   "speaker": "シュリュズベリイ",
   "jp": "「……何か知っているようだな、大十字君」",
   "cells": [
    {
     "sid": "da0115:T00090",
     "kind": "본문",
     "jp": "「……何か知っているようだな、大十字君」",
     "ko": "「……뭔가 알고 있는 모양이군, 다이쥬지 군」"
    }
   ]
  },
  {
   "uid": "da0115:U00061",
   "speaker": "アル",
   "jp": "「……ロードビヤーキー！」",
   "cells": [
    {
     "sid": "da0115:T00091",
     "kind": "본문",
     "jp": "「……ロードビヤーキー！」",
     "ko": "「……로드 비야키!」"
    }
   ]
  },
  {
   "uid": "da0115:U00062",
   "speaker": "(지문)",
   "jp": "ウェスパシアヌス。サンダルフォン。そしてクラウディウス。\n\n　存在しないはずの悪夢が、これで３人。他のアンチクロスも甦っているとみた方が良いかも知れない。\n\n　でも何故だ……何故なんだ。世界は邪神の陰謀から解放されたんじゃなかったのか！？",
   "cells": [
    {
     "sid": "da0115:T00092",
     "kind": "본문",
     "jp": "ウェスパシアヌス。",
     "ko": "베스파시아누스."
    },
    {
     "sid": "da0115:T00093",
     "kind": "본문",
     "jp": "サンダルフォン。",
     "ko": "산달폰."
    },
    {
     "sid": "da0115:T00094",
     "kind": "본문",
     "jp": "そしてクラウディウス。\n\n　存在しないはずの悪夢が、これで３人。",
     "ko": "그리고 클라우디우스.\n\n　존재할 리 없는 악몽이 이걸로 세 명."
    },
    {
     "sid": "da0115:T00095",
     "kind": "본문",
     "jp": "他のアンチクロスも甦っているとみた方が良いかも知れない。\n\n　でも何故だ……",
     "ko": "다른 안티크로스도 되살아났다고 보는 편이 좋을지도 모른다.\n\n　하지만 어째서야……"
    },
    {
     "sid": "da0115:T00096",
     "kind": "본문",
     "jp": "何故なんだ。",
     "ko": " 어째서냐고."
    },
    {
     "sid": "da0115:T00097",
     "kind": "본문",
     "jp": "世界は邪神の陰謀から解放されたんじゃなかったのか！？",
     "ko": "세계는 사신의 음모에서 해방된 게 아니었단 말이야!?"
    }
   ]
  },
  {
   "uid": "da0115:U00063",
   "speaker": "シュリュズベリイ",
