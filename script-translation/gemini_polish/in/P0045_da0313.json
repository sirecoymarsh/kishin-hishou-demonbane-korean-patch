{
 "packet": "P0045_da0313",
 "units": [
  {
   "uid": "da0313:U00001",
   "speaker": "ライカ",
   "jp": "「やめて！　やめて！\n　やめてぇぇぇぇ！」",
   "cells": [
    {
     "sid": "da0313:T00001",
     "kind": "본문",
     "jp": "「やめて！　やめて！\n　やめてぇぇぇぇ！」",
     "ko": "「그만해!　그만해!\n　그만해에에에에!」"
    }
   ]
  },
  {
   "uid": "da0313:U00002",
   "speaker": "(지문)",
   "jp": "ライカは走る。走り続ける。\n\n　心臓は耳を〈ろう〉聾するほど激しく鼓動し、肺腑は切実に酸素を求め、\n四肢は持ち上げるのもやっとで、いつ動かなくなってもおかしくない。\n\n　それでも走り続ける。子どもたちを助けるために。あるいは――何かに急き立てられて。\n\n　\n　\n　　　　　決して辿り着けない無限の距離を、走り続ける――",
   "cells": [
    {
     "sid": "da0313:T00002",
     "kind": "본문",
     "jp": "ライカは走る。",
     "ko": "라이카는 달린다."
    },
    {
     "sid": "da0313:T00003",
     "kind": "본문",
     "jp": "走り続ける。\n\n　心臓は耳を",
     "ko": "계속 달린다.\n\n　심장은 귀가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0313:R00001",
     "kind": "루비 읽기",
     "jp": "ろう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0313:T00004",
     "kind": "본문",
     "jp": "聾",
     "ko": "먹먹해",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0313:T00005",
     "kind": "본문",
     "jp": "するほど激しく鼓動し、肺腑は切実に酸素を求め、\n四肢は持ち上げるのもやっとで、いつ動かなくなってもおかしくない。\n\n　それでも走り続ける。",
     "ko": "질 정도로 거세게 고동치고, 폐부는 절실히 산소를 갈구하며, 사지는 들어 올리는 것조차 겨우여서 언제 움직이지 않게 되어도 이상하지 않다.\n\n　그럼에도 계속 달린다."
    },
    {
     "sid": "da0313:T00006",
     "kind": "본문",
     "jp": "子どもたちを助けるために。",
     "ko": "아이들을 구하기 위해서."
    },
    {
     "sid": "da0313:T00007",
     "kind": "본문",
     "jp": "あるいは――何かに急き立てられて。\n\n　\n　\n　　　　　決して辿り着けない無限の距離を、走り続ける――",
     "ko": "혹은―― 무언가에 내몰리듯 재촉당하여.\n\n　\n　\n　　　　　결코 다다를 수 없는 무한한 거리를, 계속 달린다――"
    }
   ]
  },
  {
   "uid": "da0313:U00003",
   "speaker": "(지문)",
   "jp": "彼女を急き立てるものは何か。愛する者を救いたい――その想いに匹敵して、心を圧迫する何か。冷たく、熱く、重く、激しいこの痛みの正体は何なのか。",
   "cells": [
    {
     "sid": "da0313:T00008",
     "kind": "본문",
     "jp": "彼女を急き立てるものは何か。",
     "ko": "그녀를 재촉하는 것은 무엇인가."
    },
    {
     "sid": "da0313:T00009",
     "kind": "본문",
     "jp": "愛する者を救いたい――その想いに匹敵して、心を圧迫する何か。",
     "ko": "사랑하는 자를 구하고 싶다―― 그 마음에 필적하여 마음을 압박하는 무언가."
    },
    {
     "sid": "da0313:T00010",
     "kind": "본문",
     "jp": "冷たく、熱く、重く、激しいこの痛みの正体は何なのか。",
     "ko": "차갑고, 뜨겁고, 무겁고, 격렬한 이 아픔의 정체는 무엇인가."
    }
   ]
  },
  {
   "uid": "da0313:U00004",
   "speaker": "ライカ",
   "jp": "「あああ……あああああああっ！」",
   "cells": [
    {
     "sid": "da0313:T00011",
     "kind": "본문",
     "jp": "「あああ……あああああああっ！」",
     "ko": "「아아아…… 아아아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da0313:U00005",
   "speaker": "リューガ",
   "jp": "「無駄だ！　貴方は何も救えない！　誰も救えない！」",
   "cells": [
    {
     "sid": "da0313:T00012",
     "kind": "본문",
     "jp": "「無駄だ！　貴方は何も救えない！　誰も救えない！」",
     "ko": "「소용없다!　당신은 아무것도 구할 수 없어!　아무도 구할 수 없어!」"
    }
   ]
  },
  {
   "uid": "da0313:U00006",
   "speaker": "リューガ",
   "jp": "「それが貴方の――！」",
   "cells": [
    {
     "sid": "da0313:T00013",
     "kind": "본문",
     "jp": "「それが貴方の――！」",
     "ko": "「그것이 당신의――!」"
    }
   ]
  },
  {
   "uid": "da0313:U00007",
   "speaker": "リューガ",
   "jp": "「消えることの無い罪だ！〈オレ〉己が消させない！」",
   "cells": [
    {
     "sid": "da0313:T00014",
     "kind": "본문",
     "jp": "「消えることの無い罪だ！",
     "ko": "「사라지지 않는 죄다!",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0313:R00002",
     "kind": "루비 읽기",
     "jp": "オレ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0313:T00015",
     "kind": "본문",
     "jp": "己",
     "ko": "내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0313:T00016",
     "kind": "본문",
     "jp": "が消させない！」",
     "ko": "가 사라지게 두지 않는다!」"
    }
   ]
  },
  {
   "uid": "da0313:U00008",
   "speaker": "ライカ",
   "jp": "「ああ……ぁぁぁ……」",
   "cells": [
    {
     "sid": "da0313:T00017",
     "kind": "본문",
     "jp": "「ああ……ぁぁぁ……」",
     "ko": "「아아…… 아아아……」"
    }
   ]
  },
  {
   "uid": "da0313:U00009",
   "speaker": "(지문)",
   "jp": "ついに心が敗れた。心が折れれば、身体もくずおれる。その場に膝を突き、頭を抱えて、ライカは泣き崩れた。",
   "cells": [
    {
     "sid": "da0313:T00018",
     "kind": "본문",
     "jp": "ついに心が敗れた。",
     "ko": "마침내 마음이 패배했다."
    },
    {
     "sid": "da0313:T00019",
     "kind": "본문",
     "jp": "心が折れれば、身体もくずおれる。",
     "ko": "마음이 꺾이면 몸도 무너져 내린다."
    },
    {
     "sid": "da0313:T00020",
     "kind": "본문",
     "jp": "その場に膝を突き、頭を抱えて、ライカは泣き崩れた。",
     "ko": "그 자리에 무릎을 꿇고 머리를 감싸 쥐며 라이카는 울며 무너져 내렸다."
    }
   ]
  },
  {
   "uid": "da0313:U00010",
   "speaker": "(지문)",
   "jp": "子どもたちの悲鳴は止まない。",
   "cells": [
    {
     "sid": "da0313:T00021",
     "kind": "본문",
     "jp": "子どもたちの悲鳴は止まない。",
     "ko": "아이들의 비명은 그치지 않는다."
    }
   ]
  },
  {
   "uid": "da0313:U00011",
   "speaker": "ライカ",
   "jp": "「ごめんなさい……ごめんなさい……\n　ごめんなさい……」",
   "cells": [
    {
     "sid": "da0313:T00022",
     "kind": "본문",
     "jp": "「ごめんなさい……ごめんなさい……\n　ごめんなさい……」",
     "ko": "「미안해…… 미안해……\n　미안해……」"
    }
   ]
  },
  {
   "uid": "da0313:U00012",
   "speaker": "リューガ",
   "jp": "「そうだ……貴方はそうやって何もかも\n　見捨てて、自分だけが逃げ延びるのさ……」",
   "cells": [
    {
     "sid": "da0313:T00023",
     "kind": "본문",
     "jp": "「そうだ……貴方はそうやって何もかも\n　見捨てて、自分だけが逃げ延びるのさ……」",
     "ko": "「그래…… 당신은 그렇게 모든 걸\n　저버리고, 자신만 도망쳐 살아남는 거야……」"
    }
   ]
  },
  {
   "uid": "da0313:U00013",
   "speaker": "ライカ",
   "jp": "「ごめんな……さい……ぃ……っ」",
   "cells": [
    {
     "sid": "da0313:T00024",
     "kind": "본문",
     "jp": "「ごめんな……さい……ぃ……っ」",
     "ko": "「미안…… 해…… 어…… 흑」"
    }
   ]
  },
  {
   "uid": "da0313:U00014",
   "speaker": "リューガ",
   "jp": "「泣いてるのはあの子達が可哀相だから\n　じゃない……自分が可哀相なんだよね？\n　そうなんだろう……」",
   "cells": [
    {
     "sid": "da0313:T00025",
     "kind": "본문",
     "jp": "「泣いてるのはあの子達が可哀相だから\n　じゃない……自分が可哀相なんだよね？\n　そうなんだろう……」",
     "ko": "「우는 건 저 아이들이 불쌍해서가\n　아니야…… 자신이 불쌍한 거지?\n　그렇잖아……」"
    }
   ]
  },
  {
   "uid": "da0313:U00015",
   "speaker": "ライカ",
   "jp": "「うぁぁ……ううう……ああぁぁぁ……」",
   "cells": [
    {
     "sid": "da0313:T00026",
     "kind": "본문",
     "jp": "「うぁぁ……ううう……ああぁぁぁ……」",
     "ko": "「우아아…… 우우우…… 아아아아아……」"
    }
   ]
  },
  {
   "uid": "da0313:U00016",
   "speaker": "リューガ",
   "jp": "「――ライカ姉さん」",
   "cells": [
    {
     "sid": "da0313:T00027",
     "kind": "본문",
     "jp": "「――ライカ姉さん」",
     "ko": "「――라이카 누나」"
    }
   ]
  },
  {
   "uid": "da0313:U00017",
   "speaker": "ライカ子ども",
   "jp": "「そうね、ライカ」",
   "cells": [
    {
     "sid": "da0313:T00028",
     "kind": "본문",
     "jp": "「そうね、ライカ」",
     "ko": "「그렇네, 라이카」"
    }
   ]
  },
  {
   "uid": "da0313:U00018",
   "speaker": "ライカ",
   "jp": "「――――？」",
   "cells": [
    {
     "sid": "da0313:T00029",
     "kind": "본문",
     "jp": "「――――？」",
     "ko": "「――――?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0313:U00019",
   "speaker": "ライカ子ども",
   "jp": "「泣いているだけなのね？」",
   "cells": [
    {
     "sid": "da0313:T00030",
     "kind": "본문",
     "jp": "「泣いているだけなのね？」",
     "ko": "「울고만 있는 거네?」"
    }
   ]
  },
  {
   "uid": "da0313:U00020",
   "speaker": "ライカ",
   "jp": "「――え？」",
   "cells": [
    {
     "sid": "da0313:T00031",
     "kind": "본문",
     "jp": "「――え？」",
     "ko": "「――어?」"
    }
   ]
  },
  {
   "uid": "da0313:U00021",
   "speaker": "ライカ",
   "jp": "「そうやって耳を塞いで、目を閉ざして、\n　ただ泣き叫んでいれば良いの？」",
   "cells": [
    {
     "sid": "da0313:T00032",
     "kind": "본문",
     "jp": "「そうやって耳を塞いで、目を閉ざして、\n　ただ泣き叫んでいれば良いの？」",
     "ko": "「그렇게 귀를 막고, 눈을 감고서,\n　그저 울부짖고만 있으면 되는 거야?」"
    }
   ]
  },
  {
   "uid": "da0313:U00022",
   "speaker": "ライカ",
   "jp": "「あなたは……？」",
   "cells": [
    {
     "sid": "da0313:T00033",
     "kind": "본문",
     "jp": "「あなたは……？」",
     "ko": "「너는……?」"
    }
   ]
  },
  {
   "uid": "da0313:U00023",
   "speaker": "ライカ",
   "jp": "「それでもみんなは、『私』を信じて\n　待っているのに」",
   "cells": [
    {
     "sid": "da0313:T00034",
     "kind": "본문",
     "jp": "「それでもみんなは、『私』を信じて\n　待っているのに」",
     "ko": "「그런데도 아이들은, 『나』를 믿고\n　기다리고 있는데」"
    }
   ]
  },
  {
   "uid": "da0313:U00024",
   "speaker": "ライカ",
   "jp": "「……みんな」",
   "cells": [
    {
     "sid": "da0313:T00035",
     "kind": "본문",
     "jp": "「……みんな」",
     "ko": "「……얘들아」"
    }
   ]
  },
  {
   "uid": "da0313:U00025",
   "speaker": "ジョージ",
   "jp": "「ねえ……ちゃん……」",
   "cells": [
    {
     "sid": "da0313:T00036",
     "kind": "본문",
     "jp": "「ねえ……ちゃん……」",
     "ko": "「누…… 나……」"
    }
   ]
  },
  {
   "uid": "da0313:U00026",
   "speaker": "コリン",
   "jp": "「……おねえ……ちゃん」",
   "cells": [
    {
     "sid": "da0313:T00037",
     "kind": "본문",
     "jp": "「……おねえ……ちゃん」",
     "ko": "「……누…… 나」"
    }
   ]
  },
  {
   "uid": "da0313:U00027",
   "speaker": "アリスン",
   "jp": "「ライカ……お姉ちゃん……っ！」",
   "cells": [
    {
     "sid": "da0313:T00038",
     "kind": "본문",
     "jp": "「ライカ……お姉ちゃん……っ！」",
     "ko": "「라이카…… 언니…… 흑!」"
    }
   ]
  },
  {
   "uid": "da0313:U00028",
   "speaker": "ライカ",
   "jp": "「みんな……みんな……\n　みんなっっ！」",
   "cells": [
    {
     "sid": "da0313:T00039",
     "kind": "본문",
     "jp": "「みんな……みんな……\n　みんなっっ！」",
     "ko": "「얘들아…… 얘들아……\n　얘들아아!」"
    }
   ]
  },
  {
   "uid": "da0313:U00029",
   "speaker": "ライカ",
   "jp": "「『私』はまた……裏切るの？」",
   "cells": [
    {
     "sid": "da0313:T00040",
     "kind": "본문",
     "jp": "「『私』はまた……裏切るの？」",
     "ko": "「『나』는 또다시…… 배신하는 거야?」"
    }
   ]
  },
  {
   "uid": "da0313:U00030",
   "speaker": "ライカ",
   "jp": "「でも私には、何の力も……ッ！」",
   "cells": [
    {
     "sid": "da0313:T00041",
     "kind": "본문",
     "jp": "「でも私には、何の力も……ッ！」",
     "ko": "「하지만 나에겐, 아무런 힘도……읏!」"
    }
   ]
  },
  {
   "uid": "da0313:U00031",
   "speaker": "ライカ",
   "jp": "「――在るよ」",
   "cells": [
    {
     "sid": "da0313:T00042",
     "kind": "본문",
     "jp": "「――在るよ」",
     "ko": "「――있어」"
    }
   ]
  },
  {
   "uid": "da0313:U00032",
   "speaker": "ライカ",
   "jp": "「え？」",
   "cells": [
    {
     "sid": "da0313:T00043",
     "kind": "본문",
     "jp": "「え？」",
     "ko": "「어?」"
    }
   ]
  },
  {
   "uid": "da0313:U00033",
   "speaker": "ライカ",
   "jp": "「力なら、此処に在るよ」",
   "cells": [
    {
     "sid": "da0313:T00044",
     "kind": "본문",
     "jp": "「力なら、此処に在るよ」",
     "ko": "「힘이라면, 여기에 있어」"
    }
   ]
  },
  {
   "uid": "da0313:U00034",
   "speaker": "ライカ",
   "jp": "「あなたは……誰なの？」",
   "cells": [
    {
     "sid": "da0313:T00045",
     "kind": "본문",
     "jp": "「あなたは……誰なの？」",
     "ko": "「너는…… 누구야?」"
    }
   ]
  },
  {
   "uid": "da0313:U00035",
   "speaker": "ライカ",
   "jp": "「私は――」",
   "cells": [
    {
     "sid": "da0313:T00046",
     "kind": "본문",
     "jp": "「私は――」",
     "ko": "「나는――」"
    }
   ]
  },
  {
   "uid": "da0313:U00036",
   "speaker": "ライカ",
   "jp": "「『私』」",
   "cells": [
    {
     "sid": "da0313:T00047",
     "kind": "본문",
     "jp": "「『私』」",
     "ko": "「『나』」"
    }
   ]
  },
  {
   "uid": "da0313:U00037",
   "speaker": "ライカ",
   "jp": "「私は知っている。\n　　　『私』は識っている。\n　　　暗黒神話を撃ち破る、〈コウトウムケイ〉荒唐無稽な〈オトギバナシ〉御伽噺を」",
   "cells": [
    {
     "sid": "da0313:T00048",
     "kind": "본문",
     "jp": "「私は知っている。\n　　　『私』は識っている。\n　　　暗黒神話を撃ち破る、",
     "ko": "「나는 알고 있어.\n　　　『나』는 알고 있어.\n　　　암흑신화를 깨부수는,",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0313:R00003",
     "kind": "루비 읽기",
     "jp": "コウトウムケイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0313:T00049",
     "kind": "본문",
     "jp": "荒唐無稽",
     "ko": "황당무계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0313:T00050",
