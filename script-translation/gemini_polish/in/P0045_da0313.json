  {
   "uid": "da0313:U00038",
   "speaker": "ライカ",
   "jp": "「……あ」",
   "cells": [
    {
     "sid": "da0313:T00053",
     "kind": "본문",
     "jp": "「……あ」",
     "ko": "「……아」"
    }
   ]
  },
  {
   "uid": "da0313:U00039",
   "speaker": "ライカ",
   "jp": "「私……識っている。\n　誰にも消せない、いのちの歌を」",
   "cells": [
    {
     "sid": "da0313:T00054",
     "kind": "본문",
     "jp": "「私……識っている。\n　誰にも消せない、いのちの歌を」",
     "ko": "「나…… 알고 있어.\n　누구도 지울 수 없는, 생명의 노래를」"
    }
   ]
  },
  {
   "uid": "da0313:U00040",
   "speaker": "ライカ",
   "jp": "「これは夢。現実を侵す悪夢。\n　だけど夢ならば――もっと荒唐無稽な\n　夢で塗り替えてしまえば良い」",
   "cells": [
    {
     "sid": "da0313:T00055",
     "kind": "본문",
     "jp": "「これは夢。現実を侵す悪夢。\n　だけど夢ならば――もっと荒唐無稽な\n　夢で塗り替えてしまえば良い」",
     "ko": "「이것은 꿈. 현실을 침식하는 악몽.\n　하지만 꿈이라면―― 좀 더 황당무계한\n　꿈으로 덧칠해 버리면 돼」"
    }
   ]
  },
  {
   "uid": "da0313:U00041",
   "speaker": "ライカ",
   "jp": "「私は『私』に記憶をあげる。\n　　決して折れない剣をあげる」",
   "cells": [
    {
     "sid": "da0313:T00056",
     "kind": "본문",
     "jp": "「私は『私』に記憶をあげる。\n　　決して折れない剣をあげる」",
     "ko": "「나는 『나』에게 기억을 줄게.\n　　결코 부러지지 않는 검을 줄게」"
    }
   ]
  },
  {
   "uid": "da0313:U00042",
   "speaker": "ライカ",
   "jp": "「私は『私』に心をあげる。\n　　『私』を信じる強さをあげる」",
   "cells": [
    {
     "sid": "da0313:T00057",
     "kind": "본문",
     "jp": "「私は『私』に心をあげる。\n　　『私』を信じる強さをあげる」",
     "ko": "「나는 『나』에게 마음을 줄게.\n　　『나』를 믿는 강함을 줄게」"
    }
   ]
  },
  {
   "uid": "da0313:U00043",
   "speaker": "ライカ（メタトロン装甲なし）＆ライカ",
   "jp": "「「聖約の言葉は一つ――」」",
   "cells": [
    {
     "sid": "da0313:T00058",
     "kind": "본문",
     "jp": "「「聖約の言葉は一つ――」」",
     "ko": "「「성약의 말은 하나――」」"
    }
   ]
  },
