   ]
  },
  {
   "uid": "da0204:U00002",
   "speaker": "ウィンフィールド",
   "jp": "「……増えましたね」",
   "cells": [
    {
     "sid": "da0204:T00002",
     "kind": "본문",
     "jp": "「……増えましたね」",
     "ko": "「……늘어났군요」"
    }
   ]
  },
  {
   "uid": "da0204:U00003",
   "speaker": "瑠璃",
   "jp": "「あんな恐ろしいものが２体も……」",
   "cells": [
    {
     "sid": "da0204:T00003",
     "kind": "본문",
     "jp": "「あんな恐ろしいものが２体も……」",
     "ko": "「저토록 무서운 것이 2대나……」"
    }
   ]
  },
  {
   "uid": "da0204:U00004",
   "speaker": "ハヅキ",
   "jp": "「同じ機体？　ううん、ちょっとだけ違う」",
   "cells": [
    {
     "sid": "da0204:T00004",
     "kind": "본문",
     "jp": "「同じ機体？　ううん、ちょっとだけ違う」",
     "ko": "「같은 기체?　아아니, 조금 달라」"
    }
   ]
  },
  {
   "uid": "da0204:U00005",
   "speaker": "クラウディウス",
   "jp": "「ケッ……厄介なのが来たみたいだな」",
   "cells": [
    {
     "sid": "da0204:T00005",
     "kind": "본문",
     "jp": "「ケッ……厄介なのが来たみたいだな」",
     "ko": "「쳇…… 성가신 게 온 모양이군」"
    }
   ]
  },
  {
   "uid": "da0204:U00006",
   "speaker": "シュリュズベリイ",
   "jp": "「君はアレが何ものなのか、\n　知っているようだな」",
   "cells": [
    {
     "sid": "da0204:T00006",
     "kind": "본문",
     "jp": "「君はアレが何ものなのか、\n　知っているようだな」",
     "ko": "「자네는 저것이 무엇인지,\n　알고 있는 모양이군」"
    }
   ]
  },
  {
   "uid": "da0204:U00007",
   "speaker": "クラウディウス",
   "jp": "「あの女の『ヤツ』も、新しい『ヤツ』も\n　気に喰わねえ。吐き気がすんぜ……。\n　アーアーアッ。ムカつく。クソムカつく。\n　ブッ〈バラ〉解体してやりてぇ」",
   "cells": [
    {
     "sid": "da0204:T00007",
     "kind": "본문",
     "jp": "「あの女の『ヤツ』も、新しい『ヤツ』も\n　気に喰わねえ。吐き気がすんぜ……。\n　アーアーアッ。ムカつく。クソムカつく。\n　ブッ",
     "ko": "「저 여자의 『녀석』도, 새로운 『녀석』도\n　마음에 안 들어. 구역질이 난다고…….\n　아아아앗. 짜증 나. 졸라 짜증 나.\n　확 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0204:R00001",
     "kind": "루비 읽기",
     "jp": "バラ",
     "ko": "조각내",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0204:T00008",
     "kind": "본문",
     "jp": "解体",
     "ko": "해체해",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0204:T00009",
     "kind": "본문",
     "jp": "してやりてぇ」",
     "ko": " 버리고 싶군」"
    }
   ]
  },
  {
   "uid": "da0204:U00008",
   "speaker": "シュリュズベリイ",
   "jp": "「カルシウム不足だな。\n　バランスの良い食生活を心がけたまえ」",
   "cells": [
    {
     "sid": "da0204:T00010",
     "kind": "본문",
     "jp": "「カルシウム不足だな。\n　バランスの良い食生活を心がけたまえ」",
     "ko": "「칼슘 부족이군.\n　균형 잡힌 식생활에 유의하게나」"
    }
   ]
  },
  {
   "uid": "da0204:U00009",
   "speaker": "クラウディウス",
   "jp": "「ウゼぇんだよ、爺ィ……\n　そろそろ、始まるみたいだからな。\n　ケリつけさせてもらうぜ」",
   "cells": [
    {
     "sid": "da0204:T00011",
     "kind": "본문",
     "jp": "「ウゼぇんだよ、爺ィ……\n　そろそろ、始まるみたいだからな。\n　ケリつけさせてもらうぜ」",
     "ko": "「시끄럽다고, 영감탱이……\n　슬슬 시작되는 모양이니 말이야.\n　결판을 내주마」"
    }
   ]
  },
  {
   "uid": "da0204:U00010",
   "speaker": "シュリュズベリイ",
   "jp": "「……始まる？」",
   "cells": [
    {
     "sid": "da0204:T00012",
     "kind": "본문",
     "jp": "「……始まる？」",
     "ko": "「……시작된다?」"
    }
   ]
  },
  {
   "uid": "da0204:U00011",
   "speaker": "クラウディウス",
   "jp": "「これから死ぬ奴が気にすることじゃねえさ」",
   "cells": [
    {
     "sid": "da0204:T00013",
     "kind": "본문",
     "jp": "「これから死ぬ奴が気にすることじゃねえさ」",
     "ko": "「이제 곧 죽을 녀석이 신경 쓸 일은 아니지」"
    }
   ]
  },
  {
   "uid": "da0204:U00012",
   "speaker": "シュリュズベリイ",
   "jp": "「〈あいにく〉生憎だが、まだまだ人生を\n　謳歌するつもりでね」",
   "cells": [
    {
     "sid": "da0204:T00014",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0204:R00002",
     "kind": "루비 읽기",
     "jp": "あいにく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0204:T00015",
     "kind": "본문",
     "jp": "生憎",
     "ko": "공교롭게도",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0204:T00016",
     "kind": "본문",
     "jp": "だが、まだまだ人生を\n　謳歌するつもりでね」",
     "ko": ", 아직은 한창 인생을\n　구가할 생각이라서 말이네」"
    }
   ]
  },
  {
   "uid": "da0204:U00013",
   "speaker": "クラウディウス",
   "jp": "「人生太く短く……だろ？\n　寝たきりになる前にトドメ刺してやるって。\n　遠慮するな、クソ爺ィ」",
   "cells": [
    {
     "sid": "da0204:T00017",
     "kind": "본문",
     "jp": "「人生太く短く……だろ？\n　寝たきりになる前にトドメ刺してやるって。\n　遠慮するな、クソ爺ィ」",
     "ko": "「인생은 굵고 짧게……잖아?\n　몸져눕기 전에 숨통을 끊어 주겠다니까.\n　사양하지 마라, 망할 영감탱이」"
    }
   ]
  },
  {
   "uid": "da0204:U00014",
   "speaker": "シュリュズベリイ",
   "jp": "「欲張りな性分でね。\n　太く長く生きるさ」",
   "cells": [
    {
     "sid": "da0204:T00018",
     "kind": "본문",
     "jp": "「欲張りな性分でね。\n　太く長く生きるさ」",
     "ko": "「욕심 많은 성미라서 말이네.\n　굵고 길게 살 거라네」"
    }
   ]
  },
  {
   "uid": "da0204:U00015",
   "speaker": "クラウディウス",
   "jp": "「死ね。今すぐ死ね」",
   "cells": [
    {
     "sid": "da0204:T00019",
     "kind": "본문",
     "jp": "「死ね。今すぐ死ね」",
     "ko": "「죽어. 지금 당장 죽어」"
    }
   ]
  },
  {
   "uid": "da0204:U00016",
   "speaker": "シュリュズベリイ",
   "jp": "「レディ！」",
   "cells": [
    {
     "sid": "da0204:T00020",
     "kind": "본문",
     "jp": "「レディ！」",
     "ko": "「레이디!」"
    }
   ]
  },
  {
   "uid": "da0204:U00017",
   "speaker": "ハヅキ",
   "jp": "「征くよ！　――この『セラエノ断章』〈バイアクヘー〉魔翼形態を甘く見ないでね、〈ニセモノ〉贋物！」",
   "cells": [
    {
     "sid": "da0204:T00021",
     "kind": "본문",
     "jp": "「征くよ！　――この『セラエノ断章』",
     "ko": "「간다!　――이 『세라에노 단장』",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0204:R00003",
     "kind": "루비 읽기",
     "jp": "バイアクヘー",
