     "kind": "본문",
     "jp": "魔翼",
     "ko": "마익",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0204:T00023",
     "kind": "본문",
     "jp": "形態を甘く見ないでね、",
     "ko": " 형태를 얕보지 마, ",
     "ruby_edge": "뒤"
    },
