    {
     "sid": "da0301:T00084",
     "kind": "본문",
     "jp": "「ライカお姉ちゃん！\n　何かこっちに来るよ！？」",
     "ko": "「라이카 누나!\n　뭔가 이쪽으로 오는데!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00043",
   "speaker": "ライカ",
   "jp": "「た、竜巻！？　二重の！？」",
