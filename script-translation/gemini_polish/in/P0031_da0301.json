  },
  {
   "uid": "da0301:U00038",
   "speaker": "ソーニャ",
   "jp": "「はわわわわ～～っ！？\n　地震！？〈ハリケーン〉台風！？\n　それとも、それとも……っ！\n　自称・原理主義者の\n　テロルですかぁ～～っ！？」",
   "cells": [
    {
     "sid": "da0301:T00077",
     "kind": "본문",
     "jp": "「はわわわわ～～っ！？\n　地震！？",
     "ko": "「하와와와와~~앗!?\n　지진!?",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00014",
     "kind": "루비 읽기",
     "jp": "ハリケーン",
     "ko": "허리케인",
     "lock": "루비 읽기 칸은 고치지 않는다"
