    },
    {
     "sid": "da0301:T00093",
     "kind": "본문",
     "jp": "みと同じ\n　……いや、それ以上だ！」",
     "ko": "과 같은\n　……아니, 그 이상이야!」"
    }
   ]
  },
  {
   "uid": "da0301:U00048",
   "speaker": "アーミティッジ",
   "jp": "「……異空間に位置する、\n　この資料室にまで干渉してくるのか！」",
   "cells": [
    {
     "sid": "da0301:T00094",
     "kind": "본문",
     "jp": "「……異空間に位置する、\n　この資料室にまで干渉してくるのか！」",
