{
 "packet": "P0031_da0301",
 "units": [
  {
   "uid": "da0301:U00001",
   "speaker": "(지문)",
   "jp": "破壊された〈ブラッド〉血染めのヤツから、紅い影が飛び出した。アルを〈かか〉抱えた紅の少女だった。\n\n　その背中からは紅の〈はね〉翅が広がっている。血煙で編んだ蝶の翅だ。",
   "cells": [
    {
     "sid": "da0301:T00001",
     "kind": "본문",
     "jp": "破壊された",
     "ko": "파괴된 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00001",
     "kind": "루비 읽기",
     "jp": "ブラッド",
     "ko": "블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00002",
     "kind": "본문",
     "jp": "血染めのヤツ",
     "ko": "피로 물든 녀석",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00003",
     "kind": "본문",
     "jp": "から、紅い影が飛び出した。",
     "ko": "에게서 붉은 그림자가 뛰쳐나왔다."
    },
    {
     "sid": "da0301:T00004",
     "kind": "본문",
     "jp": "アルを",
     "ko": "알을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00002",
     "kind": "루비 읽기",
     "jp": "かか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00005",
     "kind": "본문",
     "jp": "抱",
     "ko": "껴안",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00006",
     "kind": "본문",
     "jp": "えた紅の少女だった。\n\n　その背中からは紅の",
     "ko": "은 붉은 소녀였다.\n\n　그 등에서는 붉은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00003",
     "kind": "루비 읽기",
     "jp": "はね",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00007",
     "kind": "본문",
     "jp": "翅",
     "ko": "날개",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00008",
     "kind": "본문",
     "jp": "が広がっている。",
     "ko": "가 펼쳐져 있다."
    },
    {
     "sid": "da0301:T00009",
     "kind": "본문",
     "jp": "血煙で編んだ蝶の翅だ。",
     "ko": "피안개로 짠 나비의 날개다."
    }
   ]
  },
  {
   "uid": "da0301:U00002",
   "speaker": "アナザーブラッド",
   "jp": "「さすがは、さすがは〈トゥーソード／トゥーガン〉二闘流！\n　勇敢な騎士殿！　気高き銃士殿！〈おんみ〉御身の剣と銃を前にして、\n　逃げおおせる悪は存在しない！」",
   "cells": [
    {
     "sid": "da0301:T00010",
     "kind": "본문",
     "jp": "「さすがは、さすがは",
     "ko": "「과연, 과연 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00004",
     "kind": "루비 읽기",
     "jp": "トゥーソード／トゥーガン",
     "ko": "투 소드/투 건",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00011",
     "kind": "본문",
     "jp": "二闘流",
     "ko": "이투류",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00012",
     "kind": "본문",
     "jp": "！\n　勇敢な騎士殿！　気高き銃士殿！",
     "ko": "!\n　용감한 기사공!　고결한 총사공!",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00005",
     "kind": "루비 읽기",
     "jp": "おんみ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00013",
     "kind": "본문",
     "jp": "御身",
     "ko": "그대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00014",
     "kind": "본문",
     "jp": "の剣と銃を前にして、\n　逃げおおせる悪は存在しない！」",
     "ko": "의 검과 총을 마주하고서,\n　도망칠 수 있는 악은 존재하지 않아!」"
    }
   ]
  },
  {
   "uid": "da0301:U00003",
   "speaker": "九朔",
   "jp": "「まだ〈ざ〉戯れるか、アナザーブラッド！」",
   "cells": [
    {
     "sid": "da0301:T00015",
     "kind": "본문",
     "jp": "「まだ",
     "ko": "「아직도 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00006",
     "kind": "루비 읽기",
     "jp": "ざ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00016",
     "kind": "본문",
     "jp": "戯",
     "ko": "수작을 부리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00017",
     "kind": "본문",
     "jp": "れるか、アナザーブラッド！」",
     "ko": "는가, 어나더 블러드!」"
    }
   ]
  },
  {
   "uid": "da0301:U00004",
   "speaker": "(지문)",
   "jp": "デモンベインから少年の怒声が聴こえる。それを嘲笑うかのように、紅の少女は機体の周囲をひらひらと\n舞った。",
   "cells": [
    {
     "sid": "da0301:T00018",
     "kind": "본문",
     "jp": "デモンベインから少年の怒声が聴こえる。",
     "ko": "데몬베인에게서 소년의 노성이 들려온다."
    },
    {
     "sid": "da0301:T00019",
     "kind": "본문",
     "jp": "それを嘲笑うかのように、紅の少女は機体の周囲をひらひらと\n舞った。",
     "ko": "그것을 비웃기라도 하듯, 붉은 소녀는 기체 주위를 팔랑팔랑 춤추듯 날았다."
    }
   ]
  },
  {
   "uid": "da0301:U00005",
   "speaker": "アナザーブラッド",
   "jp": "「やっぱり喧嘩じゃ勝ち目ないわね。\n　私、女の子だし。だから、ね？」",
   "cells": [
    {
     "sid": "da0301:T00020",
     "kind": "본문",
     "jp": "「やっぱり喧嘩じゃ勝ち目ないわね。\n　私、女の子だし。だから、ね？」",
     "ko": "「역시 싸움으로는 승산이 없네.\n　나, 여자아이기도 하고. 그러니까, 말이지?」"
    }
   ]
  },
  {
   "uid": "da0301:U00006",
   "speaker": "アル",
   "jp": "「くっ……ぁ……」",
   "cells": [
    {
     "sid": "da0301:T00021",
     "kind": "본문",
     "jp": "「くっ……ぁ……」",
     "ko": "「큭…… 아……」"
    }
   ]
  },
  {
   "uid": "da0301:U00007",
   "speaker": "九郎",
   "jp": "「アル！」",
   "cells": [
    {
     "sid": "da0301:T00022",
     "kind": "본문",
     "jp": "「アル！」",
     "ko": "「알!」"
    }
   ]
  },
  {
   "uid": "da0301:U00008",
   "speaker": "(지문)",
   "jp": "少女はデモンベインの眼の高さで滞空。アルを盾にするように、自らの躰の前に抱く。苦痛のためか、アルはぐったりとしたまま動かない。",
   "cells": [
    {
     "sid": "da0301:T00023",
     "kind": "본문",
     "jp": "少女はデモンベインの眼の高さで滞空。",
     "ko": "소녀는 데몬베인의 눈높이에서 체공한다."
    },
    {
     "sid": "da0301:T00024",
     "kind": "본문",
     "jp": "アルを盾にするように、自らの躰の前に抱く。",
     "ko": "알을 방패 삼듯 자신의 몸 앞에 안는다."
    },
    {
     "sid": "da0301:T00025",
     "kind": "본문",
     "jp": "苦痛のためか、アルはぐったりとしたまま動かない。",
     "ko": "고통 때문인지 알은 축 늘어진 채 움직이지 않는다."
    }
   ]
  },
  {
   "uid": "da0301:U00009",
   "speaker": "九朔",
   "jp": "「人質のつもりか！」",
   "cells": [
    {
     "sid": "da0301:T00026",
     "kind": "본문",
     "jp": "「人質のつもりか！」",
     "ko": "「인질로 삼을 셈이냐!」"
    }
   ]
  },
  {
   "uid": "da0301:U00010",
   "speaker": "アナザーブラッド",
   "jp": "「人質？　ふふ、そう見える？」",
   "cells": [
    {
     "sid": "da0301:T00027",
     "kind": "본문",
     "jp": "「人質？　ふふ、そう見える？」",
     "ko": "「인질?　후후, 그렇게 보여?」"
    }
   ]
  },
  {
   "uid": "da0301:U00011",
   "speaker": "九朔",
   "jp": "「卑劣な！」",
   "cells": [
    {
     "sid": "da0301:T00028",
     "kind": "본문",
     "jp": "「卑劣な！」",
     "ko": "「비열한!」"
    }
   ]
  },
  {
   "uid": "da0301:U00012",
   "speaker": "アナザーブラッド",
   "jp": "「そいつぁ褒め言葉だぜぃ……\n　と答えておくわ。悪党の礼儀として。でもね」",
   "cells": [
    {
     "sid": "da0301:T00029",
     "kind": "본문",
     "jp": "「そいつぁ褒め言葉だぜぃ……\n　と答えておくわ。悪党の礼儀として。",
     "ko": "「그거 칭찬이구만유……\n　라고 답해 둘게. 악당의 예의로서."
    },
    {
     "sid": "da0301:T00030",
     "kind": "본문",
     "jp": "でもね」",
     "ko": "하지만 말이지」"
    }
   ]
  },
  {
   "uid": "da0301:U00013",
   "speaker": "九郎",
   "jp": "「ッッ！？」",
   "cells": [
    {
     "sid": "da0301:T00031",
     "kind": "본문",
     "jp": "「ッッ！？」",
     "ko": "「으읏!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00014",
   "speaker": "九朔",
   "jp": "「……！？　なっ……なっ！」",
   "cells": [
    {
     "sid": "da0301:T00032",
     "kind": "본문",
     "jp": "「……！？　なっ……なっ！」",
     "ko": "「……!?　무…… 무슨!」"
    }
   ]
  },
  {
   "uid": "da0301:U00015",
   "speaker": "(지문)",
   "jp": "紅の少女は乱暴にアルの服を剥ぐ。わずかに膨らむ乳房が晒された。ふたつの乳房の中央に、血の彩の『鍵』。",
   "cells": [
    {
     "sid": "da0301:T00033",
     "kind": "본문",
     "jp": "紅の少女は乱暴にアルの服を剥ぐ。",
     "ko": "붉은 소녀는 난폭하게 알의 옷을 벗겨 낸다."
    },
    {
     "sid": "da0301:T00034",
     "kind": "본문",
     "jp": "わずかに膨らむ乳房が晒された。",
     "ko": "살짝 부풀어 오른 가슴이 드러났다."
    },
    {
     "sid": "da0301:T00035",
     "kind": "본문",
     "jp": "ふたつの乳房の中央に、血の彩の『鍵』。",
     "ko": "두 가슴 중앙에, 핏빛 『열쇠』."
    }
   ]
  },
  {
   "uid": "da0301:U00016",
   "speaker": "(지문)",
   "jp": "『鍵』は深く突き刺さり、放射線状に広がる紅い痣を、アルの白い肌に刻んでいた。",
   "cells": [
    {
     "sid": "da0301:T00036",
     "kind": "본문",
     "jp": "『鍵』は深く突き刺さり、放射線状に広がる紅い痣を、アルの白い肌に刻んでいた。",
     "ko": "『열쇠』는 깊숙이 박혀, 방사형으로 퍼지는 붉은 반점을 알의 하얀 피부에 새기고 있었다."
    }
   ]
  },
  {
   "uid": "da0301:U00017",
   "speaker": "アナザーブラッド",
   "jp": "「時間稼ぎは終わってるの」",
   "cells": [
    {
     "sid": "da0301:T00037",
     "kind": "본문",
     "jp": "「時間稼ぎは終わってるの」",
     "ko": "「시간 벌기는 끝났어」"
    }
   ]
  },
  {
   "uid": "da0301:U00018",
   "speaker": "九朔",
   "jp": "「な、何を考えておるッ！」",
   "cells": [
    {
     "sid": "da0301:T00038",
     "kind": "본문",
     "jp": "「な、何を考えておるッ！」",
     "ko": "「무, 무슨 속셈이냐!」"
    }
   ]
  },
  {
   "uid": "da0301:U00019",
   "speaker": "アナザーブラッド",
   "jp": "「面白いものを見せてあげる」",
   "cells": [
    {
     "sid": "da0301:T00039",
     "kind": "본문",
     "jp": "「面白いものを見せてあげる」",
     "ko": "「재미있는 걸 보여 줄게」"
    }
   ]
  },
  {
   "uid": "da0301:U00020",
   "speaker": "(지문)",
   "jp": "デモンベインから視線を逸らす。艶然とした少女の微笑みが、俺に向けられる。",
   "cells": [
    {
     "sid": "da0301:T00040",
     "kind": "본문",
     "jp": "デモンベインから視線を逸らす。",
     "ko": "데몬베인에게서 시선을 돌린다."
    },
    {
     "sid": "da0301:T00041",
     "kind": "본문",
     "jp": "艶然とした少女の微笑みが、俺に向けられる。",
     "ko": "요염한 소녀의 미소가 나를 향한다."
    }
   ]
  },
  {
   "uid": "da0301:U00021",
   "speaker": "アナザーブラッド",
   "jp": "「――探偵さんにも」",
   "cells": [
    {
     "sid": "da0301:T00042",
     "kind": "본문",
     "jp": "「――探偵さんにも」",
     "ko": "「――탐정님에게도」"
    }
   ]
  },
  {
   "uid": "da0301:U00022",
   "speaker": "(지문)",
   "jp": "次の瞬間。『鍵』が外れる音が、頭の中で幾重にも木霊した。続けて、本の〈ページ〉頁をめくる音。",
   "cells": [
    {
     "sid": "da0301:T00043",
     "kind": "본문",
     "jp": "次の瞬間。",
     "ko": "다음 순간."
    },
    {
     "sid": "da0301:T00044",
     "kind": "본문",
     "jp": "『鍵』が外れる音が、頭の中で幾重にも木霊した。",
     "ko": "『열쇠』가 풀리는 소리가 머릿속에서 몇 겹으로 메아리쳤다."
    },
    {
     "sid": "da0301:T00045",
     "kind": "본문",
     "jp": "続けて、本の",
     "ko": "이어서, 책의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00007",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00046",
     "kind": "본문",
     "jp": "頁",
     "ko": "책장을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00047",
     "kind": "본문",
     "jp": "をめくる音。",
     "ko": " 넘기는 소리."
    }
   ]
  },
  {
   "uid": "da0301:U00023",
   "speaker": "九郎",
   "jp": "「……っ！？　あ、アルッ！？」",
   "cells": [
    {
     "sid": "da0301:T00048",
     "kind": "본문",
     "jp": "「……っ！？　あ、アルッ！？」",
     "ko": "「……읏!?　아, 알!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00024",
   "speaker": "九朔",
   "jp": "「これはっ！？」",
   "cells": [
    {
     "sid": "da0301:T00049",
     "kind": "본문",
     "jp": "「これはっ！？」",
     "ko": "「이건!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00025",
   "speaker": "(지문)",
   "jp": "晒し出されたアルの胸元が、魔導書の〈ページ〉紙片になってめくれ、〈ほど〉解けてゆく。\n\n　溢れ出す〈ページ〉断片は紙吹雪となって吹き荒れ、やがて螺旋を描き、\n紅の少女とアルを囲んだ。\n\n　螺旋の中心、アルを抱いたまま少女は〈わら〉嗤う。",
   "cells": [
    {
     "sid": "da0301:T00050",
     "kind": "본문",
     "jp": "晒し出されたアルの胸元が、魔導書の",
     "ko": "드러난 알의 가슴팍이 마도서의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00008",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00051",
     "kind": "본문",
     "jp": "紙片",
     "ko": "종잇조각이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00052",
     "kind": "본문",
     "jp": "になってめくれ、",
     "ko": " 되어 넘어가며, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00009",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00053",
     "kind": "본문",
     "jp": "解",
     "ko": "풀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00054",
     "kind": "본문",
     "jp": "けてゆく。\n\n　溢れ出す",
     "ko": "려 간다.\n\n　흘러넘치는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00010",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00055",
     "kind": "본문",
     "jp": "断片",
     "ko": "단편은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00056",
     "kind": "본문",
     "jp": "は紙吹雪となって吹き荒れ、やがて螺旋を描き、\n紅の少女とアルを囲んだ。\n\n　螺旋の中心、アルを抱いたまま少女は",
     "ko": " 종이눈보라가 되어 휘몰아치더니, 이윽고 나선을 그리며 붉은 소녀와 알을 에워쌌다.\n\n　나선의 중심, 알을 안은 채 소녀는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00011",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00057",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00058",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    }
   ]
  },
  {
   "uid": "da0301:U00026",
   "speaker": "九朔",
   "jp": "「何をした！？\n　アナザーブラッド！」",
   "cells": [
    {
     "sid": "da0301:T00059",
     "kind": "본문",
     "jp": "「何をした！？\n　アナザーブラッド！」",
     "ko": "「무슨 짓을 한 거냐!?\n　어나더 블러드!」"
    }
   ]
  },
  {
   "uid": "da0301:U00027",
   "speaker": "アナザーブラッド",
   "jp": "「『鍵』が開いたのよ！\n　さあ、『アル・アジフ』の物語が\n　世界に満ちるわ！」",
   "cells": [
    {
     "sid": "da0301:T00060",
     "kind": "본문",
     "jp": "「『鍵』が開いたのよ！\n　さあ、『アル・アジフ』の物語が\n　世界に満ちるわ！」",
     "ko": "「『열쇠』가 열린 거야!\n　자, 『알 아지프』의 이야기가\n　세계에 차오른다!」"
    }
   ]
  },
  {
   "uid": "da0301:U00028",
   "speaker": "九郎",
   "jp": "「！？」",
   "cells": [
    {
     "sid": "da0301:T00061",
     "kind": "본문",
     "jp": "「！？」",
     "ko": "「!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0301:U00029",
   "speaker": "(지문)",
   "jp": "紅の少女の胸が裂けた。噴き出す鮮血は血風となり、紙片の渦と絡み合うような竜巻と化す。",
   "cells": [
    {
     "sid": "da0301:T00062",
     "kind": "본문",
     "jp": "紅の少女の胸が裂けた。",
     "ko": "붉은 소녀의 가슴이 갈라졌다."
    },
    {
     "sid": "da0301:T00063",
     "kind": "본문",
     "jp": "噴き出す鮮血は血風となり、紙片の渦と絡み合うような竜巻と化す。",
     "ko": "뿜어져 나오는 선혈은 피바람이 되어, 종잇조각의 소용돌이와 뒤엉키는 듯한 회오리로 화한다."
    }
   ]
  },
  {
   "uid": "da0301:U00030",
   "speaker": "(지문)",
   "jp": "アルの断片が描く螺旋。それに交わる血風の螺旋。",
   "cells": [
    {
     "sid": "da0301:T00064",
     "kind": "본문",
     "jp": "アルの断片が描く螺旋。",
     "ko": "알의 단편이 그리는 나선."
    },
    {
     "sid": "da0301:T00065",
     "kind": "본문",
     "jp": "それに交わる血風の螺旋。",
     "ko": "그에 교차하는 피바람의 나선."
    }
   ]
  },
  {
   "uid": "da0301:U00031",
   "speaker": "(지문)",
   "jp": "アルと紅の少女が編む二重螺旋はみるみる膨張し、\n　辺り一帯を――否、アーカムシティを――それも否、\n　をも呑み込もうとしていた〈・・〉『世界』！",
   "cells": [
    {
     "sid": "da0301:T00066",
     "kind": "본문",
     "jp": "アルと紅の少女が編む二重螺旋はみるみる膨張し、\n　辺り一帯を――否、アーカムシティを――それも否、\n　をも呑み込もうとしていた",
     "ko": "알과 붉은 소녀가 엮어 내는 이중나선은 순식간에 팽창하여,\n　주변 일대를―― 아니, 아컴 시티를―― 그것도 아니,",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00012",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00067",
     "kind": "본문",
     "jp": "『世界』",
     "ko": "『세계』",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00068",
     "kind": "본문",
     "jp": "！",
     "ko": "마저도 집어삼키려 하고 있었다!"
    }
   ]
  },
  {
   "uid": "da0301:U00032",
   "speaker": "アナザーブラッド",
   "jp": "「そうだ！　これが！\n　これが私の『物語』だ！〈・・・・・・・〉此処から始まる！」",
   "cells": [
    {
     "sid": "da0301:T00069",
     "kind": "본문",
     "jp": "「そうだ！　これが！\n　これが私の『物語』だ！",
     "ko": "「그래!　이것이!\n　이것이 나의 『이야기』다!",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0301:R00013",
     "kind": "루비 읽기",
     "jp": "・・・・・・・",
     "ko": "・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0301:T00070",
     "kind": "본문",
     "jp": "此処から始まる",
     "ko": "여기서부터 시작된다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0301:T00071",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0301:U00033",
   "speaker": "ストーン",
   "jp": "「うおおおおおおおお！？\n　飛ばされているぅぅぅぅ！？」",
   "cells": [
    {
     "sid": "da0301:T00072",
     "kind": "본문",
     "jp": "「うおおおおおおおお！？\n　飛ばされているぅぅぅぅ！？」",
     "ko": "「우오오오오오오오오!?\n　날아가고 있어어어어어!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00034",
   "speaker": "ネス",
   "jp": "「厄日だぁぁぁぁぁ――――――！」",
   "cells": [
    {
     "sid": "da0301:T00073",
     "kind": "본문",
     "jp": "「厄日だぁぁぁぁぁ――――――！」",
     "ko": "「재수 없는 날이다아아아아――――――!」"
    }
   ]
  },
  {
   "uid": "da0301:U00035",
   "speaker": "瑠璃",
   "jp": "「こ、今度はなに！？\n　何が起こってるの！？」",
   "cells": [
    {
     "sid": "da0301:T00074",
     "kind": "본문",
     "jp": "「こ、今度はなに！？\n　何が起こってるの！？」",
     "ko": "「이, 이번엔 뭐야!?\n　무슨 일이 일어나고 있는 거야!?」"
    }
   ]
  },
  {
   "uid": "da0301:U00036",
   "speaker": "ウィンフィールド",
   "jp": "「瑠璃お嬢様！」",
   "cells": [
    {
     "sid": "da0301:T00075",
     "kind": "본문",
     "jp": "「瑠璃お嬢様！」",
     "ko": "「루리 아가씨!」"
