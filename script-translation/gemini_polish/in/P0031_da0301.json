    },
    {
     "sid": "da0301:T00098",
     "kind": "본문",
     "jp": "が」",
     "ko": "가」"
    }
   ]
  },
  {
   "uid": "da0301:U00051",
   "speaker": "シュリュズベリイ",
   "jp": "「しかし、これでは世界を\n　書き換えてしまう！」",
   "cells": [
    {
     "sid": "da0301:T00099",
     "kind": "본문",
     "jp": "「しかし、これでは世界を\n　書き換えてしまう！」",
     "ko": "「하지만, 이래서는 세계를\n　고쳐 써 버리고 말아!」"
    }
   ]
  },
  {
   "uid": "da0301:U00052",
   "speaker": "クラウディウス",
   "jp": "「あーあ、始まっちまったか。\n　しゃあねえ、そろそろお〈いとま〉暇させてもらうわぁ」",
