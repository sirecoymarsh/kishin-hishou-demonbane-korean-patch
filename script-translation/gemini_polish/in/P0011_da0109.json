{
 "packet": "P0011_da0109",
 "units": [
  {
   "uid": "da0109:U00001",
   "speaker": "(지문)",
   "jp": "教会からの帰り道を、アルと２人並んで歩く。静かな夜だ。街の喧騒は遠く、ジリジリ……と切れかかった街灯の、明滅する\n音が聴こえる。夜道には人の気配は無く、さっきから誰ともすれ違わない。",
   "cells": [
    {
     "sid": "da0109:T00001",
     "kind": "본문",
     "jp": "教会からの帰り道を、アルと２人並んで歩く。",
     "ko": "교회에서 돌아오는 길을, 알과 둘이 나란히 걷는다."
    },
    {
     "sid": "da0109:T00002",
     "kind": "본문",
     "jp": "静かな夜だ。",
     "ko": "조용한 밤이다."
    },
    {
     "sid": "da0109:T00003",
     "kind": "본문",
     "jp": "街の喧騒は遠く、ジリジリ……と切れかかった街灯の、明滅する\n音が聴こえる。",
     "ko": "거리의 소음은 멀고, 지지지…… 하며 수명이 다해 가는 가로등이, 명멸하는\n소리가 들린다."
    },
    {
     "sid": "da0109:T00004",
     "kind": "본문",
     "jp": "夜道には人の気配は無く、さっきから誰ともすれ違わない。",
     "ko": "밤길에는 인기척이 없어, 아까부터 누구와도 마주치지 않는다."
    }
   ]
  },
  {
   "uid": "da0109:U00002",
   "speaker": "アル",
   "jp": "「九郎」",
   "cells": [
    {
     "sid": "da0109:T00005",
     "kind": "본문",
     "jp": "「九郎」",
     "ko": "「쿠로」"
    }
   ]
  },
  {
   "uid": "da0109:U00003",
   "speaker": "九郎",
   "jp": "「ああ、分かっている」俺たちは足を止めた。前方の薄闇を〈じ〉凝っと睨みつける。粘つくような夜気が気持ち悪い。周囲の建物が圧し掛かってくるような威圧感を感じる。\n\n　そして何よりも雄弁なのは、さっきから鼻を突く鉄の臭い――血臭。",
   "cells": [
    {
     "sid": "da0109:T00006",
     "kind": "본문",
     "jp": "「ああ、分かっている」",
     "ko": "「아아, 알고 있어」"
    },
    {
     "sid": "da0109:T00007",
     "kind": "본문",
     "jp": "俺たちは足を止めた。",
     "ko": "우리는 걸음을 멈추었다."
    },
    {
     "sid": "da0109:T00008",
     "kind": "본문",
     "jp": "前方の薄闇を",
     "ko": "전방의 어스름을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00001",
     "kind": "루비 읽기",
     "jp": "じ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00009",
     "kind": "본문",
     "jp": "凝",
     "ko": "가만히",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00010",
     "kind": "본문",
     "jp": "っと睨みつける。",
     "ko": " 노려본다."
    },
    {
     "sid": "da0109:T00011",
     "kind": "본문",
     "jp": "粘つくような夜気が気持ち悪い。",
     "ko": "끈적거리는 듯한 밤공기가 기분 나쁘다."
    },
    {
     "sid": "da0109:T00012",
     "kind": "본문",
     "jp": "周囲の建物が圧し掛かってくるような威圧感を感じる。\n\n　そして何よりも雄弁なのは、さっきから鼻を突く鉄の臭い",
     "ko": "주위의 건물이 짓눌러 오는 듯한 위압감이 느껴진다.\n\n　그리고 무엇보다 많은 것을 말해 주는 건, 아까부터 코를 찌르는 쇠 냄새"
    },
    {
     "sid": "da0109:T00013",
     "kind": "본문",
     "jp": "――血臭。",
     "ko": "――피 냄새."
    }
   ]
  },
  {
   "uid": "da0109:U00004",
   "speaker": "九郎",
   "jp": "「はんっ。まさか向こうからお出ましとはな。\n　どんな風の吹き回しだ？」",
   "cells": [
    {
     "sid": "da0109:T00014",
     "kind": "본문",
     "jp": "「はんっ。まさか向こうからお出ましとはな。\n　どんな風の吹き回しだ？」",
     "ko": "「흥. 설마 저쪽에서 행차하실 줄이야.\n　무슨 바람이 불었담?」"
    }
   ]
  },
  {
   "uid": "da0109:U00005",
   "speaker": "(지문)",
   "jp": "脳の奥で、世界がひび割れる音を聴く。現実の壁を破り、怪異がこちらの世界に流れ込むのだ。",
   "cells": [
    {
     "sid": "da0109:T00015",
     "kind": "본문",
     "jp": "脳の奥で、世界がひび割れる音を聴く。",
     "ko": "뇌 깊은 곳에서, 세계가 갈라지는 소리를 듣는다."
    },
    {
     "sid": "da0109:T00016",
     "kind": "본문",
     "jp": "現実の壁を破り、怪異がこちらの世界に流れ込むのだ。",
     "ko": "현실의 벽을 부수고, 괴이가 이쪽 세계로 흘러들어 온다."
    }
   ]
  },
  {
   "uid": "da0109:U00006",
   "speaker": "(지문)",
   "jp": "血生臭い風が吹く。ロウソクの火が風に吹き消されるように、街灯が一斉に消えた。\n\n　辺りは闇に包まれる。そしてその闇の中、例によって紅い影が立っていた。",
   "cells": [
    {
     "sid": "da0109:T00017",
     "kind": "본문",
     "jp": "血生臭い風が吹く。",
     "ko": "피비린내 나는 바람이 분다."
    },
    {
     "sid": "da0109:T00018",
     "kind": "본문",
     "jp": "ロウソクの火が風に吹き消されるように、街灯が一斉に消えた。\n\n　辺りは闇に包まれる。",
     "ko": "촛불이 바람에 꺼지듯이, 가로등이 일제히 꺼졌다.\n\n　주위는 어둠에 휩싸인다."
    },
    {
     "sid": "da0109:T00019",
     "kind": "본문",
     "jp": "そしてその闇の中、例によって紅い影が立っていた。",
     "ko": "그리고 그 어둠 속, 여느 때처럼 붉은 그림자가 서 있었다."
    }
   ]
  },
  {
   "uid": "da0109:U00007",
   "speaker": "九郎",
   "jp": "「よう、〈トマト・ジュース〉血溜まり野郎」\n\n　血の化け物は人のカタチを真似ていた。こんな風に何かの真似をすることは、今までにもあった。元が不定形だから変幻自在なのだろう。紅い影の、のっぺらぼうな顔が、にたりと嗤った。周囲を包む〈プレッシャー〉威圧感が指向性を得る。",
   "cells": [
    {
     "sid": "da0109:T00020",
     "kind": "본문",
     "jp": "「よう、",
     "ko": "「여어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00002",
     "kind": "루비 읽기",
     "jp": "トマト・ジュース",
     "ko": "토마토 주스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00021",
     "kind": "본문",
     "jp": "血溜まり野郎",
     "ko": "피웅덩이 자식",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00022",
     "kind": "본문",
     "jp": "」\n\n　血の化け物は人のカタチを真似ていた。",
     "ko": "」\n\n　피의 괴물은 사람의 형태를 흉내 내고 있었다."
    },
    {
     "sid": "da0109:T00023",
     "kind": "본문",
     "jp": "こんな風に何かの真似をすることは、今までにもあった。",
     "ko": "이런 식으로 무언가를 흉내 내는 일은, 지금까지도 있었다."
    },
    {
     "sid": "da0109:T00024",
     "kind": "본문",
     "jp": "元が不定形だから変幻自在なのだろう。",
     "ko": "원래가 부정형이니만큼 변화무쌍한 것이리라."
    },
    {
     "sid": "da0109:T00025",
     "kind": "본문",
     "jp": "紅い影の、のっぺらぼうな顔が、にたりと嗤った。",
     "ko": "붉은 그림자의, 이목구비 없는 얼굴이, 씨익 비웃었다."
    },
    {
     "sid": "da0109:T00026",
     "kind": "본문",
     "jp": "周囲を包む",
     "ko": "주위를 감싸는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00003",
     "kind": "루비 읽기",
     "jp": "プレッシャー",
     "ko": "프레셔가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00027",
     "kind": "본문",
     "jp": "威圧感",
     "ko": "위압감이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00028",
     "kind": "본문",
     "jp": "が指向性を得る。",
     "ko": " 지향성을 얻는다."
    }
   ]
  },
  {
   "uid": "da0109:U00008",
   "speaker": "九郎",
   "jp": "「アル！」",
   "cells": [
    {
     "sid": "da0109:T00029",
     "kind": "본문",
     "jp": "「アル！」",
     "ko": "「알!」"
    }
   ]
  },
  {
   "uid": "da0109:U00009",
   "speaker": "アル",
   "jp": "「承知！」",
   "cells": [
    {
     "sid": "da0109:T00030",
     "kind": "본문",
     "jp": "「承知！」",
     "ko": "「알겠다!」"
    }
   ]
  },
  {
   "uid": "da0109:U00010",
   "speaker": "(지문)",
   "jp": "地面が爆ぜるのと、宙に舞い上がるのは同時。アルの姿が無数の紙束となって〈ほど〉解け、紙吹雪となって俺の周囲を\n取り囲む。",
   "cells": [
    {
     "sid": "da0109:T00031",
     "kind": "본문",
     "jp": "地面が爆ぜるのと、宙に舞い上がるのは同時。",
     "ko": "지면이 터져 나가는 것과, 허공으로 솟구쳐 오르는 것은 동시."
    },
    {
     "sid": "da0109:T00032",
     "kind": "본문",
     "jp": "アルの姿が無数の紙束となって",
     "ko": "알의 모습이 무수한 종이 뭉치가 되어 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00004",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00033",
     "kind": "본문",
     "jp": "解",
     "ko": "풀어",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00034",
     "kind": "본문",
     "jp": "け、紙吹雪となって俺の周囲を\n取り囲む。",
     "ko": "지고, 종이 눈보라가 되어 내 주위를\n에워싼다."
    }
   ]
  },
  {
   "uid": "da0109:U00011",
   "speaker": "(지문)",
   "jp": "俺とアルの意識が〈リンク〉繋がる。周囲を舞うアルの〈ページ〉断片が俺の全身を包み込み、術衣を編む。",
   "cells": [
    {
     "sid": "da0109:T00035",
     "kind": "본문",
     "jp": "俺とアルの意識が",
     "ko": "나와 알의 의식이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00005",
     "kind": "루비 읽기",
     "jp": "リンク",
     "ko": "링크",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00036",
     "kind": "본문",
     "jp": "繋がる",
     "ko": "이어진다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00037",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0109:T00038",
     "kind": "본문",
     "jp": "周囲を舞うアルの",
     "ko": "주위를 춤추듯 나는 알의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00006",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00039",
     "kind": "본문",
     "jp": "断片",
     "ko": "단편이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00040",
     "kind": "본문",
     "jp": "が俺の全身を包み込み、術衣を編む。",
     "ko": " 내 전신을 감싸 안으며, 술의를 엮어 낸다."
    }
   ]
  },
  {
   "uid": "da0109:U00012",
   "speaker": "(지문)",
   "jp": "俺はマギウス・スタイルに変身した。",
   "cells": [
    {
     "sid": "da0109:T00041",
     "kind": "본문",
     "jp": "俺はマギウス・スタイルに変身した。",
     "ko": "나는 마기우스 스타일로 변신했다."
    }
   ]
  },
  {
   "uid": "da0109:U00013",
   "speaker": "(지문)",
   "jp": "上空。月を背景に紅い影が舞う。俺が跳躍するのと同時に、こっちに向かって飛びかかってきたのだ。させはしない！",
   "cells": [
    {
     "sid": "da0109:T00042",
     "kind": "본문",
     "jp": "上空。月を背景に紅い影が舞う。",
     "ko": "상공. 달을 배경으로 붉은 그림자가 춤춘다."
    },
    {
     "sid": "da0109:T00043",
     "kind": "본문",
     "jp": "俺が跳躍するのと同時に、こっちに向かって飛びかかってきたのだ。",
     "ko": "내가 도약하는 순간, 이쪽을 향해 덤벼들었다."
    },
    {
     "sid": "da0109:T00044",
     "kind": "본문",
     "jp": "させはしない！",
     "ko": "당할까 보냐!"
    }
   ]
  },
  {
   "uid": "da0109:U00014",
   "speaker": "九郎",
   "jp": "「バルザイの〈えんげつとう〉偃月刀！」",
   "cells": [
    {
     "sid": "da0109:T00045",
     "kind": "본문",
     "jp": "「バルザイの",
     "ko": "「바르자이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00007",
     "kind": "루비 읽기",
     "jp": "えんげつとう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00046",
     "kind": "본문",
     "jp": "偃月刀",
     "ko": "언월도",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00047",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0109:U00015",
   "speaker": "(지문)",
   "jp": "右手を横に払う動きに合わせ、炎が一閃する。空中で燃え広がる炎の〈ライン〉直線より、一本の刀が生じた。そいつを掴み取り、落ちてくる影を斬り棄てる。",
   "cells": [
    {
     "sid": "da0109:T00048",
     "kind": "본문",
     "jp": "右手を横に払う動きに合わせ、炎が一閃する。",
     "ko": "오른손을 옆으로 휘두르는 동작에 맞춰, 불꽃이 번쩍인다."
    },
    {
     "sid": "da0109:T00049",
     "kind": "본문",
     "jp": "空中で燃え広がる炎の",
     "ko": "허공에서 타오르며 번지는 불꽃의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00008",
     "kind": "루비 읽기",
     "jp": "ライン",
     "ko": "라인",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00050",
     "kind": "본문",
     "jp": "直線",
     "ko": "직선",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00051",
     "kind": "본문",
     "jp": "より、一本の刀が生じた。",
     "ko": "에서, 한 자루의 칼이 생겨났다."
    },
    {
     "sid": "da0109:T00052",
     "kind": "본문",
     "jp": "そいつを掴み取り、落ちてくる影を斬り棄てる。",
     "ko": "그것을 움켜잡고, 떨어져 내리는 그림자를 베어 버린다."
    }
   ]
  },
  {
   "uid": "da0109:U00016",
   "speaker": "九郎",
   "jp": "「――――！」\n\n　手応えは水を斬る感触。刃に残る炎が、紅い影に燃え移った。",
   "cells": [
    {
     "sid": "da0109:T00053",
     "kind": "본문",
     "jp": "「――――！」\n\n　手応えは水を斬る感触。",
     "ko": "「――――!」\n\n　물이라도 벤 듯한 감촉이 손에 전해진다."
    },
    {
     "sid": "da0109:T00054",
     "kind": "본문",
     "jp": "刃に残る炎が、紅い影に燃え移った。",
     "ko": "칼날에 남은 불꽃이, 붉은 그림자에 옮겨붙었다."
    }
   ]
  },
  {
   "uid": "da0109:U00017",
   "speaker": "(지문)",
   "jp": "紅い影は瞬く間に炎に包まれる。",
   "cells": [
    {
     "sid": "da0109:T00055",
     "kind": "본문",
     "jp": "紅い影は瞬く間に炎に包まれる。",
     "ko": "붉은 그림자는 순식간에 불꽃에 휩싸인다."
    }
   ]
  },
  {
   "uid": "da0109:U00018",
   "speaker": "アル",
   "jp": "「九郎！」",
   "cells": [
    {
     "sid": "da0109:T00056",
     "kind": "본문",
     "jp": "「九郎！」",
     "ko": "「쿠로!」"
    }
   ]
  },
  {
   "uid": "da0109:U00019",
   "speaker": "九郎",
   "jp": "「なっ！？」",
   "cells": [
    {
     "sid": "da0109:T00057",
     "kind": "본문",
     "jp": "「なっ！？」",
     "ko": "「뭣!?」"
    }
   ]
  },
  {
   "uid": "da0109:U00020",
   "speaker": "(지문)",
   "jp": "炎の中から一本の手が突き出ている。こちらに向かって広げられた掌が、不気味に脈動していた。",
   "cells": [
    {
     "sid": "da0109:T00058",
     "kind": "본문",
     "jp": "炎の中から一本の手が突き出ている。",
     "ko": "불꽃 속에서 한쪽 손이 불쑥 뻗어 나와 있다."
    },
    {
     "sid": "da0109:T00059",
     "kind": "본문",
     "jp": "こちらに向かって広げられた掌が、不気味に脈動していた。",
     "ko": "이쪽을 향해 펼쳐진 손바닥이, 기분 나쁘게 맥동하고 있었다."
    }
   ]
  },
  {
   "uid": "da0109:U00021",
   "speaker": "ウェスパシアヌス",
   "jp": "「――ガルバ」",
   "cells": [
    {
     "sid": "da0109:T00060",
     "kind": "본문",
     "jp": "「――ガルバ」",
     "ko": "「――갈바」"
    }
   ]
  },
  {
   "uid": "da0109:U00022",
   "speaker": "(지문)",
   "jp": "掌が急速に、醜悪に膨張する。人の頭ほどの大きさに腫れ上がった掌に裂け目が生じた。\n\n　――口だ。口腔の奥から、唾液を滴らせた長い舌が伸びる。",
   "cells": [
    {
     "sid": "da0109:T00061",
     "kind": "본문",
     "jp": "掌が急速に、醜悪に膨張する。",
     "ko": "손바닥이 급속도로, 추악하게 팽창한다."
    },
    {
     "sid": "da0109:T00062",
     "kind": "본문",
     "jp": "人の頭ほどの大きさに腫れ上がった掌に裂け目が生じた。\n\n　――口だ。",
     "ko": "사람 머리만 한 크기로 부풀어 오른 손바닥에 균열이 생겼다.\n\n　――입이다."
    },
    {
     "sid": "da0109:T00063",
     "kind": "본문",
     "jp": "口腔の奥から、唾液を滴らせた長い舌が伸びる。",
     "ko": "입 안 깊은 곳에서, 침을 뚝뚝 흘리는 긴 혀가 뻗어 나온다."
    }
   ]
  },
  {
   "uid": "da0109:U00023",
   "speaker": "九郎",
   "jp": "「ぐぅぅぅっ！？」\n\n　不覚にも舌に絡まりつかれ、身動きが取れなくなる。笑い声が爆炎の向こうから聞こえる。",
   "cells": [
    {
     "sid": "da0109:T00064",
     "kind": "본문",
     "jp": "「ぐぅぅぅっ！？」\n\n　不覚にも舌に絡まりつかれ、身動きが取れなくなる。",
     "ko": "「그으으윽!?」\n\n　방심한 틈에 혀에 휘감겨, 몸을 움직일 수 없게 된다."
    },
    {
     "sid": "da0109:T00065",
     "kind": "본문",
     "jp": "笑い声が爆炎の向こうから聞こえる。",
     "ko": "웃음소리가 폭염 너머에서 들려온다."
    }
   ]
  },
  {
   "uid": "da0109:U00024",
   "speaker": "ウェスパシアヌス",
   "jp": "「ははは……相変わらず乱暴だなあ。\n野蛮だなあ。マスター・オブ・ネクロノミコン？」",
   "cells": [
    {
     "sid": "da0109:T00066",
     "kind": "본문",
     "jp": "「ははは……相変わらず乱暴だなあ。\n野蛮だなあ。マスター・オブ・ネクロノミコン？」",
     "ko": "「하하하…… 여전히 난폭하구나.\n야만스러워라. 마스터 오브 네크로노미콘?」"
    }
   ]
  },
  {
   "uid": "da0109:U00025",
   "speaker": "アル",
   "jp": "「汝は……〈まさか〉真逆！」",
   "cells": [
    {
     "sid": "da0109:T00067",
     "kind": "본문",
     "jp": "「汝は……",
     "ko": "「그대는…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00009",
     "kind": "루비 읽기",
     "jp": "まさか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00068",
     "kind": "본문",
     "jp": "真逆",
     "ko": "설마",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00069",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0109:U00026",
   "speaker": "(지문)",
   "jp": "舌が俺の躰を振り回す。充分に遠心力がついたところで離され、地面に叩きつけられる。",
   "cells": [
    {
     "sid": "da0109:T00070",
     "kind": "본문",
     "jp": "舌が俺の躰を振り回す。",
     "ko": "혀가 내 몸을 휘두른다."
    },
    {
     "sid": "da0109:T00071",
     "kind": "본문",
     "jp": "充分に遠心力がついたところで離され、地面に叩きつけられる。",
     "ko": "원심력이 충분히 붙은 순간 혀가 나를 놓아 버려, 그대로 지면에 내동댕이쳐진다."
    }
   ]
  },
  {
   "uid": "da0109:U00027",
   "speaker": "九郎",
   "jp": "「ぐはぁッ！　……ぐっ」",
   "cells": [
    {
     "sid": "da0109:T00072",
     "kind": "본문",
     "jp": "「ぐはぁッ！　……ぐっ」",
     "ko": "「그하악!　……큭」"
    }
   ]
  },
  {
   "uid": "da0109:U00028",
   "speaker": "(지문)",
   "jp": "痛む躰に鞭打って身を起こす。",
   "cells": [
    {
     "sid": "da0109:T00073",
     "kind": "본문",
     "jp": "痛む躰に鞭打って身を起こす。",
     "ko": "쑤시는 몸을 다그치며 몸을 일으킨다."
    }
   ]
  },
  {
   "uid": "da0109:U00029",
   "speaker": "(지문)",
   "jp": "爆炎が晴れた。声の主がゆっくりと地面に降り立つ。\n\n　俺は……俺たちはこいつを知っている。俺たち〈・・〉だけが知っている。だけど――！",
   "cells": [
    {
     "sid": "da0109:T00074",
     "kind": "본문",
     "jp": "爆炎が晴れた。",
     "ko": "폭염이 걷혔다."
    },
    {
     "sid": "da0109:T00075",
     "kind": "본문",
     "jp": "声の主がゆっくりと地面に降り立つ。\n\n　俺は……俺たちはこいつを知っている。",
     "ko": "목소리의 주인이 천천히 지면에 내려선다.\n\n　나는…… 우리는 이 녀석을 알고 있다."
    },
    {
     "sid": "da0109:T00076",
     "kind": "본문",
     "jp": "俺たち",
     "ko": "우리",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00010",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00077",
     "kind": "본문",
     "jp": "だけ",
     "ko": "만이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00078",
     "kind": "본문",
     "jp": "が知っている。",
     "ko": " 알고 있다."
    },
    {
     "sid": "da0109:T00079",
     "kind": "본문",
     "jp": "だけど――！",
     "ko": "하지만――!"
    }
   ]
  },
  {
   "uid": "da0109:U00030",
   "speaker": "アル",
   "jp": "「――何故だ！\n　何故、汝が此処に居る！？」",
   "cells": [
    {
     "sid": "da0109:T00080",
     "kind": "본문",
     "jp": "「――何故だ！\n　何故、汝が此処に居る！？」",
     "ko": "「――어째서냐!\n　어째서, 네놈이 이곳에 있는 것이냐!?」"
    }
   ]
  },
  {
   "uid": "da0109:U00031",
   "speaker": "ウェスパシアヌス",
   "jp": "「何故？　何故かだと？　さて、何故だ？\n　何故なんだろうなぁ。あまり深く考えた\n　ことはなかった。なかったよ。だがまあ\n　良い。良いな？」",
   "cells": [
    {
     "sid": "da0109:T00081",
     "kind": "본문",
     "jp": "「何故？　何故かだと？　さて、何故だ？\n　何故なんだろうなぁ。あまり深く考えた\n　ことはなかった。なかったよ。だがまあ\n　良い。良いな？」",
     "ko": "「어째서?　어째서냐고?　글쎄, 어째서일까?\n　어째서일까나. 그다지 깊이 생각해 본\n　적은 없었지. 없었어. 하지만 뭐\n　좋지 않은가. 좋지?」"
    }
   ]
  },
  {
   "uid": "da0109:U00032",
   "speaker": "(지문)",
   "jp": "あり得ない。何故なら俺たちの記憶にあるこいつは……〈・・・・・・・・・〉失われた時間の存在だからだ！",
   "cells": [
    {
     "sid": "da0109:T00082",
     "kind": "본문",
     "jp": "あり得ない。",
     "ko": "있을 수 없다."
    },
    {
     "sid": "da0109:T00083",
     "kind": "본문",
     "jp": "何故なら俺たちの記憶にあるこいつは……",
     "ko": "왜냐하면 우리의 기억에 있는 이 녀석은……",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00011",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・",
     "ko": "・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00084",
     "kind": "본문",
     "jp": "失われた時間の存在",
     "ko": "잃어버린 시간의 존재",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00085",
     "kind": "본문",
     "jp": "だからだ！",
     "ko": "이기 때문이다!"
    }
   ]
  },
  {
   "uid": "da0109:U00033",
   "speaker": "ウェスパシアヌス",
   "jp": "「やあ、大十字九郎君にアル・アジフ。\n　久しい……本当に久しいなぁ。〈・・〉前世以来か？」",
   "cells": [
    {
     "sid": "da0109:T00086",
     "kind": "본문",
     "jp": "「やあ、大十字九郎君にアル・アジフ。\n　久しい……本当に久しいなぁ。",
     "ko": "「여어, 다이쥬지 쿠로 군에 알 아지프.\n　오래간만이군…… 정말로 오래간만이야.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00012",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00087",
     "kind": "본문",
     "jp": "前世",
     "ko": "전생",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00088",
     "kind": "본문",
     "jp": "以来か？」",
     "ko": " 이래인가?」"
    }
   ]
  },
  {
   "uid": "da0109:U00034",
   "speaker": "九郎＆ちびアル",
   "jp": "「――ウェスパシアヌス！」",
   "cells": [
    {
     "sid": "da0109:T00089",
     "kind": "본문",
     "jp": "「――ウェスパシアヌス！」",
     "ko": "「――베스파시아누스!」"
    }
   ]
  },
  {
   "uid": "da0109:U00035",
   "speaker": "ウェスパシアヌス",
   "jp": "「その通り！いやあ、嬉しいな。\n　憶えていてくれて実に嬉しい」",
   "cells": [
    {
     "sid": "da0109:T00090",
     "kind": "본문",
     "jp": "「その通り！いやあ、嬉しいな。\n　憶えていてくれて実に嬉しい」",
     "ko": "「바로 그렇다! 이야아, 기쁘구나.\n　기억해 주어서 실로 기뻐」"
    }
   ]
  },
  {
   "uid": "da0109:U00036",
   "speaker": "ウェスパシアヌス",
   "jp": "「私はこの世界では無かったことになっているからね。実を言うととてもとても寂しい想いをしていたんだ。いやはや歳は取りたくないものだな……おおっと」",
   "cells": [
    {
     "sid": "da0109:T00091",
     "kind": "본문",
     "jp": "「私はこの世界では無かったことになっているからね。実を言うととてもとても寂しい想いをしていたんだ。いやはや歳は取りたくないものだな……",
     "ko": "「나는 이 세계에서는 존재하지 않았던 걸로 되어 있으니까 말이지. 사실은 아주아주 외로웠단다. 이거 참, 나이는 먹고 싶지 않군…… "
    },
    {
     "sid": "da0109:T00092",
     "kind": "본문",
     "jp": "おおっと」",
     "ko": "어이쿠」"
    }
   ]
  },
  {
   "uid": "da0109:U00037",
   "speaker": "ウェスパシアヌス",
   "jp": "「はははは、ほらほらほら。見てくれたまえ。ガルバも喜んでおる」",
   "cells": [
    {
     "sid": "da0109:T00093",
     "kind": "본문",
     "jp": "「はははは、ほらほらほら。",
     "ko": "「하하하하, 자자, 봐라."
    },
    {
     "sid": "da0109:T00094",
     "kind": "본문",
     "jp": "見てくれたまえ。",
     "ko": "봐 주게나."
    },
    {
     "sid": "da0109:T00095",
     "kind": "본문",
     "jp": "ガルバも喜んでおる」",
     "ko": "갈바도 기뻐하고 있단다」"
    }
   ]
  },
  {
   "uid": "da0109:U00038",
   "speaker": "(지문)",
   "jp": "腫れ上がった右手の人面疽に顔を寄せ、好々爺のような笑顔を\n見せる。\n\n　まぎれもない。記憶の中にあるのと同じ、下卑た笑みだ。\n\n　人面疽は黄色い汚液を涙のように両目から垂らしながら、\nけたたましく〈わら〉嗤っている。",
   "cells": [
    {
     "sid": "da0109:T00096",
     "kind": "본문",
     "jp": "腫れ上がった右手の人面疽に顔を寄せ、好々爺のような笑顔を\n見せる。\n\n　まぎれもない。",
     "ko": "부풀어 오른 오른손의 인면창에 얼굴을 가까이 대고, 인자한 노인네 같은 미소를\n보인다.\n\n　틀림없다."
    },
    {
     "sid": "da0109:T00097",
     "kind": "본문",
     "jp": "記憶の中にあるのと同じ、下卑た笑みだ。\n\n　人面疽は黄色い汚液を涙のように両目から垂らしながら、\nけたたましく",
     "ko": "기억 속에 있는 것과 똑같은, 천박한 웃음이다.\n\n　인면창은 누런 오물을 눈물처럼 두 눈에서 흘려 대면서,\n요란하게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00013",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00098",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00099",
     "kind": "본문",
     "jp": "っている。",
     "ko": "고 있다."
    }
   ]
  },
  {
   "uid": "da0109:U00039",
   "speaker": "九郎",
   "jp": "「くっ……！」",
   "cells": [
    {
     "sid": "da0109:T00100",
     "kind": "본문",
     "jp": "「くっ……！」",
     "ko": "「큭……!」"
    }
   ]
  },
  {
   "uid": "da0109:U00040",
   "speaker": "ウェスパシアヌス",
   "jp": "「さてと……遊んでくれるかね？\n　くれないかね？　くれるよねえ？」",
   "cells": [
    {
     "sid": "da0109:T00101",
     "kind": "본문",
     "jp": "「さてと……遊んでくれるかね？\n　くれないかね？　くれるよねえ？」",
     "ko": "「자 그럼…… 놀아 주겠나?\n　안 놀아 주려나?　놀아 주겠지?」"
    }
   ]
  },
  {
   "uid": "da0109:U00041",
   "speaker": "(지문)",
   "jp": "ごもりっ。男の全身がわななく。\n\n　左手の甲、巨大な水疱が生まれる。膨張する水疱は限界に達すると同時に裂け、大量の汁を滝のように\n流した。\n\n　裂けた水疱の下から現れたのは、物憂げな表情を浮かべる、\n異形の貌だった。\n\n　そして〈マント〉外套の下、躰には大きな穴が開いていた。虚ろな空洞は深淵の闇を湛えている。〈らんらん〉爛々と光る眼と紅い唇が、闇の中に浮かび上がっていた。\n\n　――ウェスパシアヌス。\n\n　今ではない時間、此処ではない世界で俺たちが戦った、\n　悪の魔術結社『ブラックロッジ』。その頂点に立つ〈アンチクロス〉七頭、最悪の魔術師のひとり。三体の使い魔を体内に飼う、邪法の魔術師。\n\n　そう。存在するはずがない。なのに何故――！",
   "cells": [
    {
     "sid": "da0109:T00102",
     "kind": "본문",
     "jp": "ごもりっ。",
     "ko": "꾸르륵."
    },
    {
     "sid": "da0109:T00103",
     "kind": "본문",
     "jp": "男の全身がわななく。\n\n　左手の甲、巨大な水疱が生まれる。",
     "ko": "남자의 전신이 바르르 떨린다.\n\n　왼손등, 거대한 수포가 생겨난다."
    },
    {
     "sid": "da0109:T00104",
     "kind": "본문",
     "jp": "膨張する水疱は限界に達すると同時に裂け、大量の汁を滝のように\n流した。\n\n　裂けた水疱の下から現れたのは、物憂げな表情を浮かべる、\n異形の貌だった。\n\n　そして",
     "ko": "팽창하는 수포는 한계에 달하자 갈라지며, 대량의 진물을 폭포처럼\n쏟아 냈다.\n\n　갈라진 수포 아래에서 나타난 것은, 나른한 표정을 띤,\n이형의 얼굴이었다.\n\n　그리고 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00014",
     "kind": "루비 읽기",
     "jp": "マント",
     "ko": "망토",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00105",
     "kind": "본문",
     "jp": "外套",
     "ko": "외투",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00106",
     "kind": "본문",
     "jp": "の下、躰には大きな穴が開いていた。",
     "ko": " 아래, 몸에는 커다란 구멍이 뚫려 있었다."
    },
    {
     "sid": "da0109:T00107",
     "kind": "본문",
     "jp": "虚ろな空洞は深淵の闇を湛えている。",
     "ko": "텅 빈 공동은 심연의 어둠을 머금고 있다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00015",
     "kind": "루비 읽기",
     "jp": "らんらん",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00108",
     "kind": "본문",
     "jp": "爛々",
     "ko": "형형",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00109",
     "kind": "본문",
     "jp": "と光る眼と紅い唇が、闇の中に浮かび上がっていた。\n\n　――ウェスパシアヌス。\n\n　今ではない時間、此処ではない世界で俺たちが戦った、\n　悪の魔術結社『ブラックロッジ』。",
     "ko": "하게 빛나는 눈과 붉은 입술이, 어둠 속에 떠올라 있었다.\n\n　――베스파시아누스.\n\n　지금이 아닌 시간, 이곳이 아닌 세계에서 우리가 싸웠던,\n　악의 마술결사 『블랙 로지』."
    },
    {
     "sid": "da0109:T00110",
     "kind": "본문",
     "jp": "その頂点に立つ",
     "ko": "그 정점에 서는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00016",
     "kind": "루비 읽기",
     "jp": "アンチクロス",
     "ko": "안티크로스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00111",
     "kind": "본문",
     "jp": "七頭",
     "ko": "칠두",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00112",
     "kind": "본문",
     "jp": "、最悪の魔術師のひとり。",
     "ko": ", 최악의 마술사 중 한 명."
    },
    {
     "sid": "da0109:T00113",
     "kind": "본문",
     "jp": "三体の使い魔を体内に飼う、邪法の魔術師。\n\n　そう。存在するはずがない。",
     "ko": "사역마 세 마리를 몸속에 기르며, 사악한 술법을 쓰는 마술사.\n\n　그래. 존재할 리가 없다."
    },
    {
     "sid": "da0109:T00114",
     "kind": "본문",
     "jp": "なのに何故――！",
     "ko": "그런데 어째서――!"
    }
   ]
  },
  {
   "uid": "da0109:U00042",
   "speaker": "九郎",
   "jp": "「お前は何なんだッ！？」",
   "cells": [
    {
     "sid": "da0109:T00115",
     "kind": "본문",
     "jp": "「お前は何なんだッ！？」",
     "ko": "「네 녀석은 정체가 뭐야!?」"
    }
   ]
  },
  {
   "uid": "da0109:U00043",
   "speaker": "(지문)",
   "jp": "腹に開いた紅い口が闇を吐き出した。黒い水銀の奔流の如く溢れ出すソレらは、明らかな敵意を持って\n俺たちに向かって流れ込んでくる。波打つその姿は、黒い大蛇を連想させる。",
   "cells": [
    {
     "sid": "da0109:T00116",
     "kind": "본문",
     "jp": "腹に開いた紅い口が闇を吐き出した。",
     "ko": "배에 뚫린 붉은 입이 어둠을 토해 냈다."
    },
    {
     "sid": "da0109:T00117",
     "kind": "본문",
     "jp": "黒い水銀の奔流の如く溢れ出すソレらは、明らかな敵意を持って\n俺たちに向かって流れ込んでくる。",
     "ko": "검은 수은의 격류처럼 넘쳐흐르는 그것들은, 명백한 적의를 품고\n우리를 향해 밀려들어 온다."
    },
    {
     "sid": "da0109:T00118",
     "kind": "본문",
     "jp": "波打つその姿は、黒い大蛇を連想させる。",
     "ko": "물결치는 그 모습은, 검은 구렁이를 연상시킨다."
    }
   ]
  },
  {
   "uid": "da0109:U00044",
   "speaker": "アル",
   "jp": "「無形の落とし子！」",
   "cells": [
    {
     "sid": "da0109:T00119",
     "kind": "본문",
     "jp": "「無形の落とし子！」",
     "ko": "「무형의 사생아!」"
    }
   ]
  },
  {
   "uid": "da0109:U00045",
   "speaker": "九郎",
   "jp": "「マギウス・ウィング！」\n\n\n　押し寄せる黒の粘液を、飛翔することで〈かわ〉躱す。",
   "cells": [
    {
     "sid": "da0109:T00120",
     "kind": "본문",
     "jp": "「マギウス・ウィング！」\n\n\n　押し寄せる黒の粘液を、飛翔することで",
     "ko": "「마기우스 윙!」\n\n\n　밀려드는 검은 점액을, 비상하여 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00017",
     "kind": "루비 읽기",
     "jp": "かわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00121",
     "kind": "본문",
     "jp": "躱",
     "ko": "피한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00122",
     "kind": "본문",
     "jp": "す。",
     "ko": "다."
    }
   ]
  },
  {
   "uid": "da0109:U00046",
   "speaker": "(지문)",
   "jp": "だが闇は至る場所から偽足を伸ばし、逃れる俺の足首を捕まえた。",
   "cells": [
    {
     "sid": "da0109:T00123",
     "kind": "본문",
     "jp": "だが闇は至る場所から偽足を伸ばし、逃れる俺の足首を捕まえた。",
     "ko": "하지만 어둠은 도처에서 위족을 뻗어, 달아나는 내 발목을 붙잡았다."
    }
   ]
  },
  {
   "uid": "da0109:U00047",
   "speaker": "九郎",
   "jp": "「しまった！」",
   "cells": [
    {
     "sid": "da0109:T00124",
     "kind": "본문",
     "jp": "「しまった！」",
     "ko": "「아차!」"
    }
   ]
  },
  {
   "uid": "da0109:U00048",
   "speaker": "(지문)",
   "jp": "粘液は逆流し、一気に俺の躰を駆け上る。蛇に呑み込まれる獲物のように、俺たちは黒い奔流の中に引きずり込まれた。",
   "cells": [
    {
     "sid": "da0109:T00125",
     "kind": "본문",
     "jp": "粘液は逆流し、一気に俺の躰を駆け上る。",
     "ko": "점액은 역류하여, 단숨에 내 몸을 타고 기어오른다."
    },
    {
     "sid": "da0109:T00126",
     "kind": "본문",
     "jp": "蛇に呑み込まれる獲物のように、俺たちは黒い奔流の中に引きずり込まれた。",
     "ko": "뱀에게 삼켜지는 먹잇감처럼, 우리는 검은 격류 속으로 끌려 들어갔다."
    }
   ]
  },
  {
   "uid": "da0109:U00049",
   "speaker": "九郎",
   "jp": "「……ッ！　……ぁ……ああ……！」",
   "cells": [
    {
     "sid": "da0109:T00127",
     "kind": "본문",
     "jp": "「……ッ！　……ぁ……ああ……！」",
     "ko": "「……윽!　……아…… 아아……!」"
    }
   ]
  },
  {
   "uid": "da0109:U00050",
   "speaker": "アル",
   "jp": "「あ……ぁぁ……んん……\n　ぐ……あぁぁッ！」",
   "cells": [
    {
     "sid": "da0109:T00128",
     "kind": "본문",
     "jp": "「あ……ぁぁ……んん……\n　ぐ……あぁぁッ！」",
     "ko": "「아…… 아아…… 으음……\n　그…… 아아악!」"
    }
   ]
  },
  {
   "uid": "da0109:U00051",
   "speaker": "(지문)",
   "jp": "黒い奔流――無形の落とし子の群れは、俺たちの〈なか〉内部へと侵入\nしようと荒れ狂う。肉体のみならず精神をも蝕み、貪り侵そうとするのだ。",
   "cells": [
    {
     "sid": "da0109:T00129",
     "kind": "본문",
     "jp": "黒い奔流――無形の落とし子の群れは、俺たちの",
     "ko": "검은 격류――무형의 사생아 무리는, 우리 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00018",
     "kind": "루비 읽기",
     "jp": "なか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00130",
     "kind": "본문",
     "jp": "内部",
     "ko": "안",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00131",
     "kind": "본문",
     "jp": "へと侵入\nしようと荒れ狂う。",
     "ko": "으로 침입하려 미친 듯이 날뛴다."
    },
    {
     "sid": "da0109:T00132",
     "kind": "본문",
     "jp": "肉体のみならず精神をも蝕み、貪り侵そうとするのだ。",
     "ko": "육체뿐 아니라 정신마저 좀먹고, 탐욕스럽게 파고들려 한다."
    }
   ]
  },
  {
   "uid": "da0109:U00052",
   "speaker": "(지문)",
   "jp": "〈マギウス・ウィング〉黒翼で全身を包み、幾重にも防禦の呪紋を張り巡らせるが、\n怒涛の如く押し寄せる闇を押し止めるが精一杯……！",
   "cells": [
    {
     "sid": "da0109:R00019",
     "kind": "루비 읽기",
     "jp": "マギウス・ウィング",
     "ko": "마기우스 윙",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00133",
     "kind": "본문",
     "jp": "黒翼",
     "ko": "흑익",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00134",
     "kind": "본문",
     "jp": "で全身を包み、幾重にも防禦の呪紋を張り巡らせるが、\n怒涛の如く押し寄せる闇を押し止めるが精一杯……！",
     "ko": "으로 전신을 감싸고, 겹겹이 방어의 주술 문양을 펼쳐 두르지만,\n노도처럼 밀려드는 어둠을 막아 내는 것이 고작……!"
    }
   ]
  },
  {
   "uid": "da0109:U00053",
   "speaker": "ウェスパシアヌス",
   "jp": "「はははっ、どうしたどうした！？\n　君たちはあの〈グランドマスター〉大導師を倒した\n　のではなかったのかね？\n　まったくもって、だらしない。\n　だらしないぞ！」",
   "cells": [
    {
     "sid": "da0109:T00135",
     "kind": "본문",
     "jp": "「はははっ、どうしたどうした！？\n　君たちはあの",
     "ko": "「하하하, 왜 그러지 왜 그래!?\n　자네들은 그 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0109:R00020",
     "kind": "루비 읽기",
     "jp": "グランドマスター",
     "ko": "그랜드 마스터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0109:T00136",
     "kind": "본문",
     "jp": "大導師",
     "ko": "대도사",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0109:T00137",
     "kind": "본문",
     "jp": "を倒した\n　のではなかったのかね？\n　まったくもって、だらしない。\n　だらしないぞ！」",
     "ko": "를 쓰러뜨린\n　것이 아니었던가?\n　실로 한심하기 짝이 없군.\n　한심하군그래!」"
    }
   ]
  },
  {
   "uid": "da0109:U00054",
   "speaker": "(지문)",
   "jp": "――大導師！その名前が出てくるとは、やはりこいつ……！\n\n　どうやら俺たちには計り知れない何かが、裏で起こっているようだ。",
   "cells": [
    {
     "sid": "da0109:T00138",
     "kind": "본문",
     "jp": "――大導師！",
     "ko": "――대도사!"
    },
    {
     "sid": "da0109:T00139",
     "kind": "본문",
     "jp": "その名前が出てくるとは、やはりこいつ……！\n\n　どうやら俺たちには計り知れない何かが、裏で起こっているようだ。",
     "ko": "그 이름이 나오다니, 역시 이 녀석……!\n\n　아무래도 우리로서는 헤아릴 수 없는 무언가가, 뒤에서 벌어지고 있는 모양이다."
    }
   ]
  },
  {
   "uid": "da0109:U00055",
   "speaker": "ウェスパシアヌス",
   "jp": "「それにこんなところで、手こずっている場合\n　ではないのではないかね？」",
   "cells": [
    {
     "sid": "da0109:T00140",
     "kind": "본문",
     "jp": "「それにこんなところで、手こずっている場合\n　ではないのではないかね？」",
     "ko": "「게다가 이런 곳에서, 쩔쩔매고 있을 때가\n　아니지 않겠나?」"
    }
   ]
  },
  {
   "uid": "da0109:U00056",
   "speaker": "九郎",
   "jp": "「な……に？」",
   "cells": [
    {
     "sid": "da0109:T00141",
     "kind": "본문",
     "jp": "「な……に？」",
     "ko": "「뭐……라고?」"
    }
   ]
  },
  {
   "uid": "da0109:U00057",
   "speaker": "ウェスパシアヌス",
   "jp": "「現世に甦った悪夢は、\n　私だけではないのだよ……？」",
   "cells": [
    {
     "sid": "da0109:T00142",
     "kind": "본문",
     "jp": "「現世に甦った悪夢は、\n　私だけではないのだよ……？」",
     "ko": "「현세에 되살아난 악몽은,\n　나뿐만이 아니란다……?」"
    }
   ]
  },
  {
   "uid": "da0109:U00058",
   "speaker": "ライカ",
   "jp": "「……な、何なの、これ……？」",
   "cells": [
    {
     "sid": "da0109:T00143",
     "kind": "본문",
     "jp": "「……な、何なの、これ……？」",
     "ko": "「……뭐, 뭐야, 이거……?」"
    }
   ]
  },
  {
   "uid": "da0109:U00059",
   "speaker": "ジョージ",
   "jp": "「ら、ライカ姉ちゃん……ッ」",
   "cells": [
    {
     "sid": "da0109:T00144",
     "kind": "본문",
     "jp": "「ら、ライカ姉ちゃん……ッ」",
     "ko": "「라, 라이카 누나……!」"
    }
   ]
  },
  {
   "uid": "da0109:U00060",
   "speaker": "リューガ",
   "jp": "「……タ……ト……」",
   "cells": [
    {
     "sid": "da0109:T00145",
     "kind": "본문",
     "jp": "「……タ……ト……」",
     "ko": "「……타……트……」"
    }
   ]
  },
  {
   "uid": "da0109:U00061",
   "speaker": "ライカ",
   "jp": "「まさか、これが九郎ちゃんの\n　言っていた……」",
   "cells": [
    {
     "sid": "da0109:T00146",
     "kind": "본문",
     "jp": "「まさか、これが九郎ちゃんの\n　言っていた……」",
