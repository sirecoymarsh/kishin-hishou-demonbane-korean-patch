{
 "packet": "P0040_da0308",
 "units": [
  {
   "uid": "da0308:U00001",
   "speaker": "ウィンフィールド",
   "jp": "「……私は何を……此処は？」",
   "cells": [
    {
     "sid": "da0308:T00001",
     "kind": "본문",
     "jp": "「……私は何を……此処は？」",
     "ko": "「……제가 무엇을…… 여기는?」"
    }
   ]
  },
  {
   "uid": "da0308:U00002",
   "speaker": "ティトゥス",
   "jp": "「分からぬか？」",
   "cells": [
    {
     "sid": "da0308:T00002",
     "kind": "본문",
     "jp": "「分からぬか？」",
     "ko": "「모르겠느냐?」"
    }
   ]
  },
  {
   "uid": "da0308:U00003",
   "speaker": "ウィンフィールド",
   "jp": "「！　……誰です！？」",
   "cells": [
    {
     "sid": "da0308:T00003",
     "kind": "본문",
     "jp": "「！　……誰です！？」",
     "ko": "「!　……누구십니까!?」"
    }
   ]
  },
  {
   "uid": "da0308:U00004",
   "speaker": "ティトゥス",
   "jp": "「因果の調律か。\n　人の生き様、死に様はかくも容易に〈す〉挿げ替えられるものなのか。\n　儚いものよな」",
   "cells": [
    {
     "sid": "da0308:T00004",
     "kind": "본문",
     "jp": "「因果の調律か。\n　人の生き様、死に様はかくも容易に",
     "ko": "「인과의 조율인가.\n　사람의 삶과 죽음이란 이토록 손쉽게",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0308:R00001",
     "kind": "루비 읽기",
     "jp": "す",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0308:T00005",
     "kind": "본문",
     "jp": "挿",
     "ko": "바꿔 끼",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0308:T00006",
     "kind": "본문",
     "jp": "げ替えられるものなのか。\n　儚いものよな」",
     "ko": "워질 수 있는 것이더냐.\n　덧없는 것이로군」"
    }
   ]
  },
  {
   "uid": "da0308:U00005",
   "speaker": "ウィンフィールド",
   "jp": "「貴方……あの時の！」",
   "cells": [
    {
     "sid": "da0308:T00007",
     "kind": "본문",
     "jp": "「貴方……あの時の！」",
     "ko": "「당신은…… 그때의!」"
    }
   ]
  },
  {
   "uid": "da0308:U00006",
   "speaker": "ティトゥス",
   "jp": "「だが、かりそめの命とはいえ、拙者は再び〈うつしよ〉現世に舞い戻った。ならば望みは一つ――」",
   "cells": [
    {
     "sid": "da0308:T00008",
     "kind": "본문",
     "jp": "「だが、かりそめの命とはいえ、拙者は再び",
     "ko": "「허나, 잠깐뿐인 목숨이라 한들 소인은 다시 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0308:R00002",
     "kind": "루비 읽기",
     "jp": "うつしよ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0308:T00009",
     "kind": "본문",
     "jp": "現世",
     "ko": "현세",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0308:T00010",
     "kind": "본문",
     "jp": "に舞い戻った。ならば望みは一つ――」",
     "ko": "로 되돌아왔다. 그렇다면 소망은 하나――」"
    }
   ]
  },
  {
   "uid": "da0308:U00007",
   "speaker": "ティトゥス",
   "jp": "「死合え、戦士ウィンフィールド。\n　冥府魔道に堕ちし我が剣を、\n　人の身たるお主の拳で砕いてみせよ」",
   "cells": [
    {
     "sid": "da0308:T00011",
     "kind": "본문",
     "jp": "「死合え、戦士ウィンフィールド。\n　冥府魔道に堕ちし我が剣を、\n　人の身たるお主の拳で砕いてみせよ」",
     "ko": "「사투를 벌이자, 전사 윈필드.\n　명부마도에 떨어진 나의 검을,\n　인간의 몸인 그대의 주먹으로 부수어 보아라」"
    }
   ]
  },
  {
   "uid": "da0308:U00008",
   "speaker": "ウィンフィールド",
   "jp": "「――何故、私の名前を」",
   "cells": [
    {
     "sid": "da0308:T00012",
     "kind": "본문",
     "jp": "「――何故、私の名前を」",
     "ko": "「――어째서, 제 이름을」"
    }
   ]
  },
  {
   "uid": "da0308:U00009",
   "speaker": "ティトゥス",
   "jp": "「知らずとも良いことだ」",
   "cells": [
    {
     "sid": "da0308:T00013",
     "kind": "본문",
     "jp": "「知らずとも良いことだ」",
     "ko": "「몰라도 되는 일이다」"
    }
   ]
  },
  {
   "uid": "da0308:U00010",
   "speaker": "ウィンフィールド",
   "jp": "「……〈ひ〉退く気はないようですね」",
   "cells": [
    {
     "sid": "da0308:T00014",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0308:R00003",
     "kind": "루비 읽기",
     "jp": "ひ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0308:T00015",
     "kind": "본문",
     "jp": "退",
     "ko": "물러",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0308:T00016",
     "kind": "본문",
     "jp": "く気はないようですね」",
     "ko": "설 생각은 없으신 모양이군요」"
    }
   ]
  },
  {
   "uid": "da0308:U00011",
   "speaker": "ウィンフィールド",
   "jp": "「瑠璃お嬢様が心配です。\n　貴方の相手に時間は避けません。\n　失礼ですが、速やかに排除させて\n　いただきます」",
   "cells": [
    {
     "sid": "da0308:T00017",
     "kind": "본문",
     "jp": "「瑠璃お嬢様が心配です。\n　貴方の相手に時間は避けません。\n　失礼ですが、速やかに排除させて\n　いただきます」",
     "ko": "「루리 아가씨가 걱정됩니다.\n　당신을 상대하는 데 시간을 할애할 수는 없습니다.\n　실례합니다만, 신속히 배제하도록\n　하겠습니다」"
    }
   ]
  },
  {
   "uid": "da0308:U00012",
   "speaker": "ティトゥス",
   "jp": "「ああ……それで良い」",
   "cells": [
    {
     "sid": "da0308:T00018",
     "kind": "본문",
     "jp": "「ああ……それで良い」",
     "ko": "「그래…… 그거면 된다」"
    }
   ]
  }
 ]
}