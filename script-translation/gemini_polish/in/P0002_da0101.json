    {
     "sid": "da0101:T00084",
     "kind": "본문",
     "jp": "文字列",
     "ko": "문자열",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0101:T00085",
     "kind": "본문",
     "jp": "となり、紅い影の、紅い唇の奥、紅い口腔の",
     "ko": "이 되어, 붉은 그림자의, 붉은 입술 안쪽, 붉은 입안 ",
     "ruby_edge": "뒤"
    },
