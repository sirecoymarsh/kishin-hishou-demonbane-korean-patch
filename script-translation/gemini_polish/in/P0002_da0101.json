    {
     "sid": "da0101:T00060",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0101:T00061",
     "kind": "본문",
     "jp": "数万数億の文字が複雑に編まれてゆく。",
     "ko": "수만 수억의 문자가 복잡하게 엮여 간다."
    },
    {
     "sid": "da0101:T00062",
     "kind": "본문",
     "jp": "結晶する。",
     "ko": " 결정화된다."
    }
   ]
  },
  {
   "uid": "da0101:U00015",
   "speaker": "(지문)",
   "jp": "それは血のように紅い人影だった。",
   "cells": [
    {
     "sid": "da0101:T00063",
     "kind": "본문",
     "jp": "それは血のように紅い人影だった。",
     "ko": "그것은 피처럼 붉은 그림자였다."
    }
   ]
  },
  {
   "uid": "da0101:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「……ヘンリー・アーミティッジ」",
   "cells": [
    {
     "sid": "da0101:T00064",
     "kind": "본문",
     "jp": "「……ヘンリー・アーミティッジ」",
     "ko": "「……헨리 아미티지」"
    }
   ]
  },
  {
   "uid": "da0101:U00017",
   "speaker": "アーミティッジ",
   "jp": "「ほう？　私のことをご存知か。\nだが、それなら規則も知っていただきたい。\n今は閲覧時間ではないのだよ」",
   "cells": [
    {
     "sid": "da0101:T00065",
     "kind": "본문",
     "jp": "「ほう？　私のことをご存知か。\nだが、それなら規則も知っていただきたい。\n今は閲覧時間ではないのだよ」",
     "ko": "「호오?　나를 알고 있나.\n하지만, 그렇다면 규칙도 알아주었으면 하는군.\n지금은 열람 시간이 아니다만」"
    }
   ]
  },
  {
   "uid": "da0101:U00018",
   "speaker": "アーミティッジ",
   "jp": "「賊め……このミスカトニック大学秘密図書館に何の用だ？」",
   "cells": [
    {
     "sid": "da0101:T00066",
     "kind": "본문",
     "jp": "「賊め……このミスカトニック大学秘密図書館に何の用だ？」",
     "ko": "「도적 놈…… 이 미스캐토닉 대학 비밀도서관에 무슨 볼일이지?」"
    }
   ]
  },
  {
   "uid": "da0101:U00019",
   "speaker": "アナザーブラッド",
   "jp": "「いやよ、お爺ちゃん。そんな怖い顔しないで」",
   "cells": [
    {
     "sid": "da0101:T00067",
     "kind": "본문",
     "jp": "「いやよ、お爺ちゃん。そんな怖い顔しないで」",
     "ko": "「싫어라, 할아버지. 그렇게 무서운 얼굴 하지 마」"
    }
   ]
  },
  {
   "uid": "da0101:U00020",
   "speaker": "(지문)",
   "jp": "くすくすと、紅い影が〈わら〉嗤う。その手の中に、一冊の魔導書があった。",
   "cells": [
    {
     "sid": "da0101:T00068",
     "kind": "본문",
     "jp": "くすくすと、紅い影が",
     "ko": "쿡쿡, 하고 붉은 그림자가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0101:R00018",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0101:T00069",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0101:T00070",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    },
    {
     "sid": "da0101:T00071",
     "kind": "본문",
     "jp": "その手の中に、一冊の魔導書があった。",
     "ko": "그 손안에, 한 권의 마도서가 들려 있었다."
    }
   ]
  },
  {
   "uid": "da0101:U00021",
   "speaker": "アナザーブラッド",
   "jp": "「わたしはただ、仲間を迎えに来ただけ」",
   "cells": [
    {
     "sid": "da0101:T00072",
     "kind": "본문",
     "jp": "「わたしはただ、仲間を迎えに来ただけ」",
     "ko": "「나는 그저, 동료를 마중하러 왔을 뿐이야」"
    }
   ]
  },
  {
   "uid": "da0101:U00022",
   "speaker": "(지문)",
   "jp": "手に持った魔導書を掲げる。アーミティッジは見た。その慄然たる〈タイトル〉題名を。",
   "cells": [
    {
     "sid": "da0101:T00073",
     "kind": "본문",
     "jp": "手に持った魔導書を掲げる。",
     "ko": "손에 든 마도서를 치켜든다."
    },
    {
     "sid": "da0101:T00074",
     "kind": "본문",
     "jp": "アーミティッジは見た。",
     "ko": "아미티지는 보았다."
    },
    {
