     "kind": "루비 읽기",
     "jp": "・・・・・・",
     "ko": "・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0101:T00059",
     "kind": "본문",
     "jp": "収束していく",
     "ko": "수렴해 간다",
