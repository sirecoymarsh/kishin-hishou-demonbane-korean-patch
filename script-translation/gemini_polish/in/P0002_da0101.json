     "jp": "文字",
     "ko": "문자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0101:T00083",
     "kind": "본문",
     "jp": "は絡み合い、繋がれ、長い",
     "ko": "는 뒤엉키고, 이어져, 긴 ",
