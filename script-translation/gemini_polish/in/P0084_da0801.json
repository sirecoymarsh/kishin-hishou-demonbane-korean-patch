  {
   "uid": "da0801:U00016",
   "speaker": "九朔",
   "jp": "「クッ――！」",
   "cells": [
    {
     "sid": "da0801:T00061",
     "kind": "본문",
     "jp": "「クッ――！」",
     "ko": "「큭――!」"
    }
   ]
  },
  {
   "uid": "da0801:U00017",
   "speaker": "(지문)",
   "jp": "瞬間、世界が反転する。虚は実に。実は虚に。移り変わり、映り変わる。",
   "cells": [
    {
     "sid": "da0801:T00062",
     "kind": "본문",
     "jp": "瞬間、世界が反転する。",
     "ko": "순간, 세계가 반전한다."
    },
    {
     "sid": "da0801:T00063",
     "kind": "본문",
     "jp": "虚は実に。実は虚に。",
     "ko": "허는 실로. 실은 허로."
    },
    {
     "sid": "da0801:T00064",
     "kind": "본문",
     "jp": "移り変わり、映り変わる。",
     "ko": "바뀌어 가고, 비치어 바뀐다."
    }
   ]
  },
  {
   "uid": "da0801:U00018",
   "speaker": "(지문)",
   "jp": "実体を結ぶ幻影。鏡の国より顕れ出でた幻想。機械仕掛けの悪夢――",
   "cells": [
    {
     "sid": "da0801:T00065",
     "kind": "본문",
     "jp": "実体を結ぶ幻影。",
     "ko": "실체를 맺는 환영."
    },
    {
     "sid": "da0801:T00066",
     "kind": "본문",
     "jp": "鏡の国より顕れ出でた幻想。",
     "ko": "거울 나라에서 모습을 드러낸 환상."
    },
    {
     "sid": "da0801:T00067",
     "kind": "본문",
     "jp": "機械仕掛けの悪夢――",
     "ko": "기계장치의 악몽――"
    }
   ]
  },
  {
   "uid": "da0801:U00019",
   "speaker": "九朔",
   "jp": "「……リベル・レギス！」",
