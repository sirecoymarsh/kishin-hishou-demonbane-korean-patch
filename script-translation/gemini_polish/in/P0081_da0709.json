     "kind": "본문",
     "jp": "魔刃",
     "ko": "마검",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00055",
     "kind": "본문",
     "jp": "／",
     "ko": "/",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0709:R00015",
     "kind": "루비 읽기",
     "jp": "デス・サイズ",
     "ko": "데스 사이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
