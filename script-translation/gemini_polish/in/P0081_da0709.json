     "kind": "본문",
     "jp": "魔銃",
     "ko": "마총",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00059",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0709:U00013",
   "speaker": "アズラッド",
   "jp": "「力を――与えよ！」",
   "cells": [
    {
     "sid": "da0709:T00060",
     "kind": "본문",
     "jp": "「力を――与えよ！」",
     "ko": "「힘을――다오!」"
    }
   ]
  },
  {
   "uid": "da0709:U00014",
   "speaker": "シュリュズベリイ",
   "jp": "「吹き荒め、窮極の風！」",
   "cells": [
    {
     "sid": "da0709:T00061",
     "kind": "본문",
     "jp": "「吹き荒め、",
     "ko": "「휘몰아쳐라,\n"
    },
    {
     "sid": "da0709:T00062",
     "kind": "본문",
     "jp": "窮極の風！」",
     "ko": "궁극의 바람이여!」"
    }
   ]
  },
  {
   "uid": "da0709:U00015",
   "speaker": "アル",
   "jp": "「クトゥグア、イタクァ……\n　神獣形態！」",
   "cells": [
    {
     "sid": "da0709:T00063",
     "kind": "본문",
     "jp": "「クトゥグア、イタクァ……\n　神獣形態！」",
     "ko": "「크투가, 이타콰……\n　신수 형태!」"
    }
   ]
  },
  {
   "uid": "da0709:U00016",
   "speaker": "九郎",
   "jp": "「征けぇぇぇぇぇぇ――――ッ！」",
   "cells": [
    {
     "sid": "da0709:T00064",
     "kind": "본문",
     "jp": "「征けぇぇぇぇぇぇ――――ッ！」",
     "ko": "「가라아아아아아아――――앗!」"
    }
   ]
  },
  {
   "uid": "da0709:U00017",
   "speaker": "ソーニャ",
   "jp": "「敵の第二陣、沈黙！」",
   "cells": [
    {
     "sid": "da0709:T00065",
     "kind": "본문",
     "jp": "「敵の第二陣、沈黙！」",
     "ko": "「적의 제2진, 침묵!」"
    }
   ]
  },
  {
   "uid": "da0709:U00018",
   "speaker": "マコト",
   "jp": "「――すぐに第三陣、来ます。〈エンゲージ〉交戦まで３０秒！」",
   "cells": [
    {
     "sid": "da0709:T00066",
     "kind": "본문",
     "jp": "「――すぐに第三陣、来ます。",
     "ko": "「――곧바로 제3진, 옵니다.\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00017",
     "kind": "루비 읽기",
     "jp": "エンゲージ",
     "ko": "인게이지",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00067",
     "kind": "본문",
     "jp": "交戦",
     "ko": "교전",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00068",
     "kind": "본문",
     "jp": "まで３０秒！」",
     "ko": "까지 30초!」"
    }
   ]
  },
  {
   "uid": "da0709:U00019",
   "speaker": "九郎",
   "jp": "「芸がねえけど、キリもねえな……おい」",
   "cells": [
    {
     "sid": "da0709:T00069",
     "kind": "본문",
     "jp": "「芸がねえけど、キリもねえな……おい」",
     "ko": "「재주도 없지만 끝도 없구만…… 어이」"
    }
   ]
  },
  {
   "uid": "da0709:U00020",
   "speaker": "アル",
   "jp": "「いつまでも、\n　かかずらってはいられんぞ」",
   "cells": [
    {
     "sid": "da0709:T00070",
     "kind": "본문",
     "jp": "「いつまでも、\n　かかずらってはいられんぞ」",
     "ko": "「언제까지고\n　상대하고 있을 수는 없다」"
    }
   ]
  },
  {
   "uid": "da0709:U00021",
   "speaker": "(지문)",
   "jp": "既に九朔の奴は、『夢幻心母』の内部に突入している。急いで後を追わなければならない……が、かと言って基地を無防備にしておくワケにもいかない。",
   "cells": [
    {
     "sid": "da0709:T00071",
     "kind": "본문",
     "jp": "既に九朔の奴は、『夢幻心母』の内部に突入している。",
     "ko": "이미 쿠자쿠 녀석은 『몽환심모』의 내부로 돌입했다."
    },
    {
     "sid": "da0709:T00072",
     "kind": "본문",
     "jp": "急いで後を追わなければならない……が、かと言って基地を無防備にしておくワケにもいかない。",
     "ko": "서둘러 뒤를 쫓아야만 한다……만, 그렇다고 기지를 무방비로 내버려 둘 수도 없다."
    }
   ]
  },
  {
   "uid": "da0709:U00022",
   "speaker": "ハヅキ",
   "jp": "「一体が残って、\n　あいつらの相手をしないとね」",
   "cells": [
    {
     "sid": "da0709:T00073",
     "kind": "본문",
     "jp": "「一体が残って、\n　あいつらの相手をしないとね」",
     "ko": "「한 대가 남아서\n　저 녀석들을 상대해야겠어」"
    }
   ]
  },
  {
   "uid": "da0709:U00023",
   "speaker": "アズラッド",
   "jp": "「ならば、俺が残ろう」",
   "cells": [
    {
     "sid": "da0709:T00074",
     "kind": "본문",
     "jp": "「ならば、俺が残ろう」",
     "ko": "「그렇다면 내가 남겠다」"
    }
   ]
  },
  {
   "uid": "da0709:U00024",
   "speaker": "瑠璃",
   "jp": "「いえ――全機『夢幻心母』に突入\n　して下さい。我々は大丈夫です」",
   "cells": [
    {
     "sid": "da0709:T00075",
     "kind": "본문",
     "jp": "「いえ――全機『夢幻心母』に突入\n　して下さい。我々は大丈夫です」",
     "ko": "「아니요――전 기체 『몽환심모』로 돌입\n　해 주세요. 저희는 괜찮습니다」"
    }
   ]
  },
  {
   "uid": "da0709:U00025",
   "speaker": "シュリュズベリイ",
   "jp": "「だが、しかし……」",
   "cells": [
    {
     "sid": "da0709:T00076",
     "kind": "본문",
     "jp": "「だが、しかし……」",
     "ko": "「하, 하지만……」"
    }
   ]
  },
  {
   "uid": "da0709:U00026",
   "speaker": "(지문)",
   "jp": "再び降下してきた破壊ロボの群れを、無数の〈ビーム〉光条が貫いた。",
   "cells": [
    {
     "sid": "da0709:T00077",
     "kind": "본문",
     "jp": "再び降下してきた破壊ロボの群れを、無数の",
     "ko": "다시 강하해 온 파괴로보 무리를 무수한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00018",
     "kind": "루비 읽기",
     "jp": "ビーム",
     "ko": "빔이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00078",
     "kind": "본문",
     "jp": "光条",
     "ko": "광조가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00079",
     "kind": "본문",
     "jp": "が貫いた。",
     "ko": " 꿰뚫었다."
    }
   ]
  },
  {
   "uid": "da0709:U00027",
   "speaker": "メタトロン",
   "jp": "「此処は私が引き受けよう」",
   "cells": [
    {
     "sid": "da0709:T00080",
     "kind": "본문",
     "jp": "「此処は私が引き受けよう」",
     "ko": "「여기는 내가 맡겠다」"
    }
   ]
  },
  {
   "uid": "da0709:U00028",
   "speaker": "九郎",
   "jp": "「メタトロン！」",
   "cells": [
    {
     "sid": "da0709:T00081",
     "kind": "본문",
     "jp": "「メタトロン！」",
     "ko": "「메타트론!」"
    }
   ]
  },
  {
   "uid": "da0709:U00029",
   "speaker": "アズラッド",
   "jp": "「あの数を相手に、\n　ひとりで戦えるのか？」",
   "cells": [
    {
     "sid": "da0709:T00082",
     "kind": "본문",
     "jp": "「あの数を相手に、\n　ひとりで戦えるのか？」",
     "ko": "「저 숫자를 상대로\n　혼자서 싸울 수 있겠느냐?」"
    }
   ]
  },
  {
   "uid": "da0709:U00030",
   "speaker": "メタトロン",
   "jp": "「見くびらないでいただきたい、\n　もう一人のマスター・オブ・ネクロノミコン\n　――〈・・・・・・・・・・・・〉アレの相手なら慣れている」",
   "cells": [
    {
     "sid": "da0709:T00083",
     "kind": "본문",
     "jp": "「見くびらないでいただきたい、\n　もう一人のマスター・オブ・ネクロノミコン\n　――",
     "ko": "「얕보지 말아 주었으면 하는군,\n　또 한 명의 마스터 오브 네크로노미콘\n　――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00019",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・・・・",
     "ko": "・・・・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00084",
     "kind": "본문",
     "jp": "アレの相手なら慣れている",
     "ko": "저것을 상대하는 건 익숙하다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00085",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0709:U00031",
   "speaker": "メタトロン",
   "jp": "「それに……どうも、ひとりではないようだ」",
   "cells": [
    {
     "sid": "da0709:T00086",
     "kind": "본문",
     "jp": "「それに……どうも、ひとりではないようだ」",
     "ko": "「게다가…… 아무래도 혼자는 아닌 모양이다」"
    }
   ]
  },
  {
   "uid": "da0709:U00032",
   "speaker": "九郎",
   "jp": "「えっ……？」",
   "cells": [
    {
     "sid": "da0709:T00087",
     "kind": "본문",
     "jp": "「えっ……？」",
     "ko": "「어……?」"
    }
   ]
  },
  {
   "uid": "da0709:U00033",
   "speaker": "(지문)",
   "jp": "続く爆発。砲弾が破壊ロボを撃ち落としてゆく。",
   "cells": [
    {
     "sid": "da0709:T00088",
     "kind": "본문",
     "jp": "続く爆発。",
     "ko": "이어지는 폭발."
    },
    {
     "sid": "da0709:T00089",
     "kind": "본문",
     "jp": "砲弾が破壊ロボを撃ち落としてゆく。",
     "ko": "포탄이 파괴로보를 격추해 나간다."
    }
   ]
  },
  {
   "uid": "da0709:U00034",
   "speaker": "ドクター・ウェスト",
   "jp": "「ふはははははは！\n　ふははははははははは！」",
   "cells": [
    {
     "sid": "da0709:T00090",
     "kind": "본문",
     "jp": "「ふはははははは！\n　ふははははははははは！」",
     "ko": "「후하하하하하하!\n　후하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da0709:U00035",
   "speaker": "九郎",
   "jp": "「あー……」",
   "cells": [
    {
     "sid": "da0709:T00091",
     "kind": "본문",
     "jp": "「あー……」",
     "ko": "「아~……」"
    }
   ]
  },
  {
   "uid": "da0709:U00036",
   "speaker": "アル",
   "jp": "「あー……」",
   "cells": [
    {
     "sid": "da0709:T00092",
     "kind": "본문",
     "jp": "「あー……」",
     "ko": "「아~……」"
    }
   ]
  },
  {
   "uid": "da0709:U00037",
   "speaker": "ドクター・ウェスト",
   "jp": "「目にもの見たか、\n　この威力この威容！\n　これぞスーパーウェスト\n　無敵ロボ２８號過渡期リファイン！」",
   "cells": [
    {
     "sid": "da0709:T00093",
     "kind": "본문",
     "jp": "「目にもの見たか、\n　この威力この威容！\n　これぞスーパーウェスト\n　無敵ロボ２８號過渡期リファイン！」",
     "ko": "「똑똑히 보았느냐,\n　이 위력 이 위용!\n　이것이야말로 슈퍼 웨스트\n　무적로보 28호 과도기 리파인!」"
    }
   ]
  },
  {
   "uid": "da0709:U00038",
   "speaker": "ドクター・ウェスト",
   "jp": "「――解説：スーパーウェスト無敵ロボ２８號Ｖｅｒ．Ｋａは、その立ちポーズの格好良さゆえに業界を震撼せしめたが――」",
   "cells": [
    {
     "sid": "da0709:T00094",
     "kind": "본문",
     "jp": "「――解説：スーパーウェスト無敵ロボ２８號Ｖｅｒ．Ｋａは、その立ちポーズの格好良さゆえに業界を震撼せしめたが――」",
     "ko": "「――해설: 슈퍼 웨스트 무적로보 28호 Ver.Ka는 그 서 있는 포즈의 멋짐 때문에 업계를 진감시켰으나――」"
    }
   ]
  },
  {
   "uid": "da0709:U00039",
   "speaker": "ドクター・ウェスト",
   "jp": "「それはあくまでまだ試行錯誤の段階にあり、新たな時代を築くための一過程に過ぎないのだ。〈カトキ〉過渡期なだけに」",
   "cells": [
    {
     "sid": "da0709:T00095",
     "kind": "본문",
     "jp": "「それはあくまでまだ試行錯誤の段階にあり、新たな時代を築くための一過程に過ぎないのだ。",
     "ko": "「그것은 어디까지나 아직 시행착오 단계에 있으며, 새로운 시대를 구축하기 위한 한 과정에 불과한 것이다. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00020",
     "kind": "루비 읽기",
     "jp": "カトキ",
     "ko": "카토키",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00096",
     "kind": "본문",
     "jp": "過渡期",
     "ko": "과도기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00097",
     "kind": "본문",
     "jp": "なだけに」",
     "ko": "이니만큼 말이지」"
    }
   ]
  },
  {
   "uid": "da0709:U00040",
   "speaker": "(지문)",
   "jp": "――分かんねえよ。",
   "cells": [
    {
     "sid": "da0709:T00098",
     "kind": "본문",
     "jp": "――分かんねえよ。",
     "ko": "――무슨 소린지 모르겠다고."
    }
   ]
  },
  {
   "uid": "da0709:U00041",
   "speaker": "エルザ",
   "jp": "「さすが無敵ロボだ。\n（何度負けても）何ともないロボ」",
   "cells": [
    {
     "sid": "da0709:T00099",
     "kind": "본문",
     "jp": "「さすが無敵ロボだ。\n（何度負けても）何ともないロボ」",
     "ko": "「역시 무적로보다.\n(아무리 져도) 아무렇지도 않다 로보」"
    }
   ]
  },
  {
   "uid": "da0709:U00042",
   "speaker": "(지문)",
   "jp": "――少しは何とかなれ。",
   "cells": [
    {
     "sid": "da0709:T00100",
     "kind": "본문",
     "jp": "――少しは何とかなれ。",
     "ko": "――조금은 어떻게 좀 돼라."
    }
   ]
  },
  {
   "uid": "da0709:U00043",
   "speaker": "ドクター・ウェスト",
   "jp": "「ええい！　あのロボットどもを\n見てると、何だか酷く〈いら〉苛ついてくる\nのである！　片っ端から撃ち落としてやるのである！　エェェェルザ！」",
   "cells": [
    {
     "sid": "da0709:T00101",
     "kind": "본문",
     "jp": "「ええい！　あのロボットどもを\n見てると、何だか酷く",
     "ko": "「에에잇! 저 로봇 놈들을\n보고 있으면 어쩐지 지독히 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00021",
     "kind": "루비 읽기",
     "jp": "いら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00102",
     "kind": "본문",
     "jp": "苛",
     "ko": "짜증",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00103",
     "kind": "본문",
     "jp": "ついてくる\nのである！　片っ端から撃ち落としてやるのである！　エェェェルザ！」",
     "ko": "이 나는\n것이다! 닥치는 대로 격추해 버리는 것이다! 에에에엘자!」"
    }
   ]
  },
  {
   "uid": "da0709:U00044",
   "speaker": "エルザ",
   "jp": "「了解ロボ！　破壊ロボがアーカム\nシティで弾幕フィーバーロボ～っ！」",
   "cells": [
    {
     "sid": "da0709:T00104",
     "kind": "본문",
     "jp": "「了解ロボ！　破壊ロボがアーカム\nシティで弾幕フィーバーロボ～っ！」",
     "ko": "「라저 로보! 파괴로보가 아컴\n시티에서 탄막 피버 로보~옷!」"
    }
   ]
  },
  {
   "uid": "da0709:U00045",
   "speaker": "ドクター・ウェスト",
   "jp": "「ＷＯＷ！！」",
   "cells": [
    {
     "sid": "da0709:T00105",
     "kind": "본문",
