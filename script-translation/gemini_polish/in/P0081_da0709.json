{
 "packet": "P0081_da0709",
 "units": [
  {
   "uid": "da0709:U00001",
   "speaker": "(지문)",
   "jp": "覇道財閥の地下基地――人類の砦を狙う破壊者。空を埋め尽くす、邪悪の大勢力。\n\n　数千に及ぶ〈キリング・マシーン〉殺戮兵器の群れ。一国の軍隊をも凌駕する、圧倒的な制圧力。",
   "cells": [
    {
     "sid": "da0709:T00001",
     "kind": "본문",
     "jp": "覇道財閥の地下基地――人類の砦を狙う破壊者。",
     "ko": "하도 재벌의 지하 기지――인류의 보루를 노리는 파괴자."
    },
    {
     "sid": "da0709:T00002",
     "kind": "본문",
     "jp": "空を埋め尽くす、邪悪の大勢力。\n\n　数千に及ぶ",
     "ko": "하늘을 가득 메우는 사악한 대세력.\n\n　수천에 달하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00001",
     "kind": "루비 읽기",
     "jp": "キリング・マシーン",
     "ko": "킬링 머신",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00003",
     "kind": "본문",
     "jp": "殺戮兵器",
     "ko": "살육병기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00004",
     "kind": "본문",
     "jp": "の群れ。",
     "ko": "의 무리."
    },
    {
     "sid": "da0709:T00005",
     "kind": "본문",
     "jp": "一国の軍隊をも凌駕する、圧倒的な制圧力。",
     "ko": "일국의 군대마저 능가하는 압도적인 제압력."
    }
   ]
  },
  {
   "uid": "da0709:U00002",
   "speaker": "(지문)",
   "jp": "それを迎え撃つのは、ただ二組と一人。だが、案ずるなかれ。敵が道理を踏み躙る理不尽の〈ちから〉軍力なら――彼らは理不尽を捻じ伏せる〈ちから〉軍力を超えた〈ちから〉意志力。さあ、音に聞け。瞳に焼きつけよ。\n\n　高らかに響き渡る、三種の詠唱。降臨するのは、三振りの剣。あらゆる〈ハガネ〉鋼鉄を超える、最強の〈ハガネ〉刃金たち。\n\n　さあ、出でよ。顕れ出でよ。優しき心の祈りに応え。戦う心の意志に集い――\n\n　刃金よ！",
   "cells": [
    {
     "sid": "da0709:T00006",
     "kind": "본문",
     "jp": "それを迎え撃つのは、ただ二組と一人。",
     "ko": "그것을 맞아 싸우는 것은 단 두 조와 한 사람."
    },
    {
     "sid": "da0709:T00007",
     "kind": "본문",
     "jp": "だが、案ずるなかれ。",
     "ko": "하지만 걱정하지 마라."
    },
    {
     "sid": "da0709:T00008",
     "kind": "본문",
     "jp": "敵が道理を踏み躙る理不尽の",
     "ko": "적이 도리를 짓밟는 불합리의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00002",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00009",
     "kind": "본문",
     "jp": "軍力",
     "ko": "군력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00010",
     "kind": "본문",
     "jp": "なら――",
     "ko": "이라면――"
    },
    {
     "sid": "da0709:T00011",
     "kind": "본문",
     "jp": "彼らは理不尽を捻じ伏せる",
     "ko": "그들은 불합리를 찍어 누르는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00003",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00012",
     "kind": "본문",
     "jp": "軍力",
     "ko": "군력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00013",
     "kind": "본문",
     "jp": "を超えた",
     "ko": "을 넘어선 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00004",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00014",
     "kind": "본문",
     "jp": "意志力",
     "ko": "의지력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00015",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0709:T00016",
     "kind": "본문",
     "jp": "さあ、音に聞け。",
     "ko": "자, 소리로 들어라."
    },
    {
     "sid": "da0709:T00017",
     "kind": "본문",
     "jp": "瞳に焼きつけよ。\n\n　高らかに響き渡る、三種の詠唱。",
     "ko": "눈동자에 새겨 넣어라.\n\n　드높이 울려 퍼지는 세 종류의 영창."
    },
    {
     "sid": "da0709:T00018",
     "kind": "본문",
     "jp": "降臨するのは、三振りの剣。",
     "ko": "강림하는 것은 세 자루의 검."
    },
    {
     "sid": "da0709:T00019",
     "kind": "본문",
     "jp": "あらゆる",
     "ko": "온갖 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00005",
     "kind": "루비 읽기",
     "jp": "ハガネ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00020",
     "kind": "본문",
     "jp": "鋼鉄",
     "ko": "강철",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00021",
     "kind": "본문",
     "jp": "を超える、最強の",
     "ko": "을 뛰어넘는, 최강의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00006",
     "kind": "루비 읽기",
     "jp": "ハガネ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00022",
     "kind": "본문",
     "jp": "刃金",
     "ko": "검날",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00023",
     "kind": "본문",
     "jp": "たち。\n\n　さあ、出でよ。",
     "ko": "들.\n\n　자, 나오라."
    },
    {
     "sid": "da0709:T00024",
     "kind": "본문",
     "jp": "顕れ出でよ。",
     "ko": "모습을 드러내라."
    },
    {
     "sid": "da0709:T00025",
     "kind": "본문",
     "jp": "優しき心の祈りに応え。",
     "ko": "상냥한 마음의 기도에 응하여."
    },
    {
     "sid": "da0709:T00026",
     "kind": "본문",
     "jp": "戦う心の意志に集い――\n\n　刃金よ！",
     "ko": "싸우는 마음의 의지에 모여――\n\n　강철이여!"
    }
   ]
  },
  {
   "uid": "da0709:U00003",
   "speaker": "アズラッド",
   "jp": "「――〈アイオーン〉永劫！\n　\n　　　時の歯車〈さばき〉断罪の刃\n　　　久遠の果てより来たる虚無」",
   "cells": [
    {
     "sid": "da0709:T00027",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0709:R00007",
     "kind": "루비 읽기",
     "jp": "アイオーン",
     "ko": "아이온",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00028",
     "kind": "본문",
     "jp": "永劫",
     "ko": "영겁",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00029",
     "kind": "본문",
     "jp": "！\n　\n　　　時の歯車",
     "ko": "!\n　\n　　　시간의 톱니바퀴\n　　　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00008",
     "kind": "루비 읽기",
     "jp": "さばき",
     "ko": "심판",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00030",
     "kind": "본문",
     "jp": "断罪",
     "ko": "단죄",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00031",
     "kind": "본문",
     "jp": "の刃\n　　　久遠の果てより来たる虚無」",
     "ko": "의 칼날\n　　　구원의 끝에서 오는 허무」"
    }
   ]
  },
  {
   "uid": "da0709:U00004",
   "speaker": "アズラッド",
   "jp": "「――〈アイオーン〉永劫！〈なれ〉汝より逃れ得るものはなく〈な〉汝が触れしものは死すらも死せん！」",
   "cells": [
    {
     "sid": "da0709:T00032",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0709:R00009",
     "kind": "루비 읽기",
     "jp": "アイオーン",
     "ko": "아이온",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00033",
     "kind": "본문",
     "jp": "永劫",
     "ko": "영겁",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00034",
     "kind": "본문",
     "jp": "！",
     "ko": "!\n　\n　　　",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0709:R00010",
     "kind": "루비 읽기",
     "jp": "なれ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00035",
     "kind": "본문",
     "jp": "汝",
     "ko": "그대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00036",
     "kind": "본문",
     "jp": "より逃れ得るものはなく",
     "ko": "에게서 벗어날 수 있는 자는 없으며\n　　　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00011",
     "kind": "루비 읽기",
     "jp": "な",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00037",
     "kind": "본문",
     "jp": "汝",
     "ko": "그대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00038",
     "kind": "본문",
     "jp": "が触れしものは死すらも死せん！」",
     "ko": "가 닿은 것은 죽음조차도 죽으리라!」"
    }
   ]
  },
  {
   "uid": "da0709:U00005",
   "speaker": "ハヅキ",
   "jp": "「我は勝利を誓う刃金\n　　　　我は〈まがつかぜ〉禍風に挑む翼」",
   "cells": [
    {
     "sid": "da0709:T00039",
     "kind": "본문",
     "jp": "「我は勝利を誓う刃金\n　　　　我は",
     "ko": "「나는 승리를 맹세하는 강철\n　　　　나는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00012",
     "kind": "루비 읽기",
     "jp": "まがつかぜ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00040",
     "kind": "본문",
     "jp": "禍風",
     "ko": "재앙의 바람",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00041",
     "kind": "본문",
     "jp": "に挑む翼」",
     "ko": "에 맞서는 날개」"
    }
   ]
  },
  {
   "uid": "da0709:U00006",
   "speaker": "シュリュズベリイ",
   "jp": "「無窮の空を超え〈アヱテュル〉霊子の海を渡り\n　　　　　翔けよ、刃金の翼！」",
   "cells": [
    {
     "sid": "da0709:T00042",
     "kind": "본문",
     "jp": "「無窮の空を超え",
     "ko": "「무궁한 하늘을 넘어\n　　　　　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00013",
     "kind": "루비 읽기",
     "jp": "アヱテュル",
     "ko": "아이테르",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0709:T00043",
     "kind": "본문",
     "jp": "霊子",
     "ko": "영자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0709:T00044",
     "kind": "본문",
     "jp": "の海を渡り\n　　　　　翔けよ、刃金の翼！」",
     "ko": "의 바다를 건너\n　　　　　날아라, 강철의 날개여!」"
    }
   ]
  },
  {
   "uid": "da0709:U00007",
   "speaker": "シュリュズベリイ＆ハヅキ",
   "jp": "「舞い降りよ――アンブロシウス！」",
   "cells": [
    {
     "sid": "da0709:T00045",
     "kind": "본문",
     "jp": "「舞い降りよ――",
     "ko": "「날아 내려오라――"
    },
    {
     "sid": "da0709:T00046",
     "kind": "본문",
     "jp": "アンブロシウス！」",
     "ko": "암브로시우스!」"
    }
   ]
  },
  {
   "uid": "da0709:U00008",
   "speaker": "九郎",
   "jp": "「憎悪の空より来たりて――」",
   "cells": [
    {
     "sid": "da0709:T00047",
     "kind": "본문",
     "jp": "「憎悪の空より来たりて――」",
     "ko": "「증오의 하늘에서 도래하여――」"
    }
   ]
  },
  {
   "uid": "da0709:U00009",
   "speaker": "アル",
   "jp": "「正しき怒りを胸に――」",
   "cells": [
    {
     "sid": "da0709:T00048",
     "kind": "본문",
     "jp": "「正しき怒りを胸に――」",
     "ko": "「올바른 분노를 가슴에 품고――」"
    }
   ]
  },
  {
   "uid": "da0709:U00010",
   "speaker": "九郎＆アル",
   "jp": "「「我等は魔を断つ剣を執る！」」",
   "cells": [
    {
     "sid": "da0709:T00049",
     "kind": "본문",
     "jp": "「「我等は魔を断つ剣を執る！」」",
     "ko": "「「우리는 마를 끊는 검을 잡는다!」」"
    }
   ]
  },
  {
   "uid": "da0709:U00011",
   "speaker": "九郎＆アル",
   "jp": "「「汝、無垢なる刃――デモンベイン！」」",
   "cells": [
    {
     "sid": "da0709:T00050",
     "kind": "본문",
     "jp": "「「汝、無垢なる刃――デモンベイン！」」",
     "ko": "「「그대, 무구한 칼날――데몬베인!」」"
    }
   ]
  },
  {
   "uid": "da0709:U00012",
   "speaker": "(지문)",
   "jp": "顕現する三体の機神。猛禽の如く、一斉に襲いかかる敵の軍勢。それを迎え撃つ、〈ブレイド〉魔刃／〈デス・サイズ〉死鎌／〈ガン・ファイア〉魔銃。",
   "cells": [
    {
     "sid": "da0709:T00051",
     "kind": "본문",
     "jp": "顕現する三体の機神。",
     "ko": "현현하는 세 대의 기신."
    },
    {
     "sid": "da0709:T00052",
     "kind": "본문",
     "jp": "猛禽の如く、一斉に襲いかかる敵の軍勢。",
     "ko": "맹금처럼 일제히 덮쳐 오는 적의 군세."
    },
    {
     "sid": "da0709:T00053",
     "kind": "본문",
     "jp": "それを迎え撃つ、",
     "ko": "그것을 맞아 싸우는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0709:R00014",
     "kind": "루비 읽기",
     "jp": "ブレイド",
     "ko": "블레이드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
