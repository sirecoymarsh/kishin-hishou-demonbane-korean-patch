{
 "packet": "P0089_da0902",
 "units": [
  {
   "uid": "da0902:U00001",
   "speaker": "(지문)",
   "jp": "アナザーブラッドの罠により、分断された三体の鬼械神。\n\n　しかし自身もまた夢の存在であるアズラッドに、アナザーブラッドの生み出した空間は通用しない。\n\n　迷うことなく、『夢幻心母』の最深部へと向かう。はぐれた二体の心配はまったくしていない様子だった。",
   "cells": [
    {
     "sid": "da0902:T00001",
     "kind": "본문",
     "jp": "アナザーブラッドの罠により、分断された三体の鬼械神。\n\n　しかし自身もまた夢の存在であるアズラッドに、アナザーブラッドの生み出した空間は通用しない。\n\n　迷うことなく、『夢幻心母』の最深部へと向かう。",
     "ko": "어나더 블러드의 함정으로 분단된 세 대의 귀계신.\n\n　하지만 자신 또한 꿈의 존재인 아즈라드에게, 어나더 블러드가 만들어 낸 공간은 통하지 않는다.\n\n　망설임 없이 『몽환심모』의 최심부로 향한다."
    },
    {
     "sid": "da0902:T00002",
     "kind": "본문",
     "jp": "はぐれた二体の心配はまったくしていない様子だった。",
     "ko": "흩어진 두 기체에 대한 걱정은 전혀 하지 않는 기색이었다."
    }
   ]
  },
  {
   "uid": "da0902:U00002",
   "speaker": "アズラッド",
   "jp": "「――敵か」",
   "cells": [
    {
     "sid": "da0902:T00003",
     "kind": "본문",
     "jp": "「――敵か」",
     "ko": "「――적인가」"
    }
   ]
  },
  {
   "uid": "da0902:U00003",
   "speaker": "ティトゥス",
   "jp": "「如何にも。拙者はティトゥス。\n『黒き聖域』の信徒にして『逆十字』\nの末席に名を連ねる者〈なり〉也」",
   "cells": [
    {
     "sid": "da0902:T00004",
     "kind": "본문",
     "jp": "「如何にも。拙者はティトゥス。\n『黒き聖域』の信徒にして『逆十字』\nの末席に名を連ねる者",
     "ko": "「그렇소. 소인은 티투스.\n『검은 성역』의 신도이자 『역십자』\n의 말석에 이름을 올린 자",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00001",
     "kind": "루비 읽기",
     "jp": "なり",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00005",
     "kind": "본문",
     "jp": "也",
     "ko": "라오",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00006",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0902:U00004",
   "speaker": "(지문)",
   "jp": "――鬼械神、〈オーガ〉皇餓。『屍食教典儀』によって招喚される、機神にして剣鬼。",
   "cells": [
    {
     "sid": "da0902:T00007",
     "kind": "본문",
     "jp": "――鬼械神、",
     "ko": "――귀계신, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00002",
     "kind": "루비 읽기",
     "jp": "オーガ",
     "ko": "오거",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00008",
     "kind": "본문",
     "jp": "皇餓",
     "ko": "황아",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00009",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0902:T00010",
     "kind": "본문",
     "jp": "『屍食教典儀』によって招喚される、機神にして剣鬼。",
     "ko": "『시식교전의』가 소환하는, 기신이자 검귀."
    }
   ]
  },
  {
   "uid": "da0902:U00005",
   "speaker": "ティトゥス",
   "jp": "「……とは言っても、正しくはその幻影に過ぎぬがな。お主と同じように」",
   "cells": [
    {
     "sid": "da0902:T00011",
     "kind": "본문",
     "jp": "「……とは言っても、正しくはその幻影に過ぎぬがな。お主と同じように」",
     "ko": "「……라고는 해도, 정확히는 그 환영에 지나지 않지만 말이오. 그대와 마찬가지로」"
    }
   ]
  },
  {
   "uid": "da0902:U00006",
   "speaker": "アズラッド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0902:T00012",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0902:U00007",
   "speaker": "ティトゥス",
   "jp": "「妄執に囚われ、今一度の〈しあい〉死合に望んだものの、この身は二度敗れ去った。雌雄が決した今、この世に留まる理由も無いが――」",
   "cells": [
    {
     "sid": "da0902:T00013",
     "kind": "본문",
     "jp": "「妄執に囚われ、今一度の",
     "ko": "「망집에 사로잡혀 다시 한번 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00003",
     "kind": "루비 읽기",
     "jp": "しあい",
     "ko": "대결",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00014",
     "kind": "본문",
     "jp": "死合",
     "ko": "사합",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00015",
     "kind": "본문",
     "jp": "に望んだものの、この身は二度敗れ去った。雌雄が決した今、この世に留まる理由も無いが――」",
     "ko": "에 임했으나, 이 몸은 두 번 패배하고 말았소. 승패가 결정된 지금, 이 세상에 머무를 이유도 없으나――」"
    }
   ]
  },
  {
   "uid": "da0902:U00008",
   "speaker": "ティトゥス",
   "jp": "「拙者を喚んだ者は\n　そうは考えていないらしい」",
   "cells": [
    {
     "sid": "da0902:T00016",
     "kind": "본문",
     "jp": "「拙者を喚んだ者は\n　そうは考えていないらしい」",
     "ko": "「소인을 부른 자는\n　그렇게 생각하지 않는 모양이오」"
    }
   ]
  },
  {
   "uid": "da0902:U00009",
   "speaker": "アズラッド",
   "jp": "「『ネクロノミコン血液言語版』か」",
   "cells": [
    {
     "sid": "da0902:T00017",
     "kind": "본문",
     "jp": "「『ネクロノミコン血液言語版』か」",
     "ko": "「『네크로노미콘 혈액언어판』인가」"
    }
   ]
  },
  {
   "uid": "da0902:U00010",
   "speaker": "ティトゥス",
   "jp": "「此処から先へ進みたければ、\n　拙者を〈たお〉斃してゆけ――\n　と、つまりはそういうことだ」",
   "cells": [
    {
     "sid": "da0902:T00018",
     "kind": "본문",
     "jp": "「此処から先へ進みたければ、\n　拙者を",
     "ko": "「여기서부터 앞으로 나아가고 싶다면,\n　소인을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00004",
     "kind": "루비 읽기",
     "jp": "たお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00019",
     "kind": "본문",
     "jp": "斃",
     "ko": "쓰러뜨리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00020",
     "kind": "본문",
     "jp": "してゆけ――\n　と、つまりはそういうことだ」",
     "ko": "고 가라――\n　즉, 그런 것이오」"
    }
   ]
  },
  {
   "uid": "da0902:U00011",
   "speaker": "アズラッド",
   "jp": "「退く気は無いようだな」",
   "cells": [
    {
     "sid": "da0902:T00021",
     "kind": "본문",
     "jp": "「退く気は無いようだな」",
     "ko": "「물러설 생각은 없는 모양이군」"
    }
   ]
  },
  {
   "uid": "da0902:U00012",
   "speaker": "ティトゥス",
   "jp": "「はは……宮仕えの悲しいところだ。それに――強者との戦いを拒む道理も無い」",
   "cells": [
    {
     "sid": "da0902:T00022",
     "kind": "본문",
     "jp": "「はは……宮仕えの悲しいところだ。それに――強者との戦いを拒む道理も無い」",
     "ko": "「하하…… 남을 섬기는 몸의 서글픈 점이오. 게다가――강자와의 싸움을 마다할 도리도 없지」"
    }
   ]
  },
  {
   "uid": "da0902:U00013",
   "speaker": "アズラッド",
   "jp": "「そうか。ならば、撃ち滅ぼすのみ」",
   "cells": [
    {
     "sid": "da0902:T00023",
     "kind": "본문",
     "jp": "「そうか。ならば、撃ち滅ぼすのみ」",
     "ko": "「그런가. 그렇다면 쳐부술 따름」"
    }
   ]
  },
  {
   "uid": "da0902:U00014",
   "speaker": "ティトゥス",
   "jp": "「参れ。〈こたび〉此度の〈しあい〉死合には、\n　　　　 良い〈かぜ〉剣風が吹きそうだ」",
   "cells": [
    {
     "sid": "da0902:T00024",
     "kind": "본문",
     "jp": "「参れ。",
     "ko": "「오시오. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00005",
     "kind": "루비 읽기",
     "jp": "こたび",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00025",
     "kind": "본문",
     "jp": "此度",
     "ko": "이번",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00026",
     "kind": "본문",
     "jp": "の",
     "ko": "의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00006",
     "kind": "루비 읽기",
     "jp": "しあい",
     "ko": "대결",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00027",
     "kind": "본문",
     "jp": "死合",
     "ko": "사합",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00028",
     "kind": "본문",
     "jp": "には、\n　　　　 良い",
     "ko": "에는,\n　　　　 좋은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0902:R00007",
     "kind": "루비 읽기",
     "jp": "かぜ",
     "ko": "바람",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0902:T00029",
     "kind": "본문",
     "jp": "剣風",
     "ko": "검풍",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0902:T00030",
     "kind": "본문",
     "jp": "が吹きそうだ」",
     "ko": "이 불 것 같군」"
    }
   ]
  }
 ]
}