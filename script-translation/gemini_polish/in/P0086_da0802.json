{
 "packet": "P0086_da0802",
 "units": [
  {
   "uid": "da0802:U00071",
   "speaker": "(지문)",
   "jp": "さらに強力な雷撃が、Ｄトゥーソードを襲う。爆ぜる爆ぜる爆ぜる。わずかに生き残っていた魔術回路が次々と死滅し、ついには\n沈黙した。\n\n　闇に包まれたコクピット。自身も雷撃を受け、九朔は血を吐きながら、苦痛に喘ぐ。",
   "cells": [
    {
     "sid": "da0802:T00213",
     "kind": "본문",
     "jp": "さらに強力な雷撃が、Ｄトゥーソードを襲う。",
     "ko": "한층 더 강력한 뇌격이 D 투 소드를 덮친다."
    },
    {
     "sid": "da0802:T00214",
     "kind": "본문",
     "jp": "爆ぜる爆ぜる爆ぜる。",
     "ko": "터진다, 터진다, 터진다."
    },
    {
     "sid": "da0802:T00215",
     "kind": "본문",
     "jp": "わずかに生き残っていた魔術回路が次々と死滅し、ついには\n沈黙した。\n\n　闇に包まれたコクピット。",
     "ko": "간신히 살아남아 있던 마술회로가 차례차례 사멸하더니, 마침내\n침묵했다.\n\n　어둠에 휩싸인 콕핏."
    },
    {
     "sid": "da0802:T00216",
     "kind": "본문",
     "jp": "自身も雷撃を受け、九朔は血を吐きながら、苦痛に喘ぐ。",
     "ko": "자신도 뇌격을 맞고, 쿠자쿠는 피를 토하며 고통에 신음한다."
    }
   ]
  },
  {
   "uid": "da0802:U00072",
   "speaker": "九朔",
   "jp": "「クソッ……タレ……！」",
   "cells": [
    {
     "sid": "da0802:T00217",
     "kind": "본문",
     "jp": "「クソッ……タレ……！」",
     "ko": "「빌어…… 먹을……!」"
    }
   ]
  },
  {
   "uid": "da0802:U00073",
   "speaker": "テリオン",
   "jp": "「……終わりだ」",
   "cells": [
    {
     "sid": "da0802:T00218",
     "kind": "본문",
     "jp": "「……終わりだ」",
     "ko": "「……끝이다」"
    }
   ]
  },
  {
   "uid": "da0802:U00074",
   "speaker": "九朔",
   "jp": "「――――――！」",
   "cells": [
    {
     "sid": "da0802:T00219",
     "kind": "본문",
     "jp": "「――――――！」",
     "ko": "「――――――!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0802:U00075",
   "speaker": "(지문)",
   "jp": "頭上に浮かぶ、十字架の剣。それは真っ直ぐにＤトゥーソードを貫き、剣に宿る魔力は解き放たれ、爆裂し――",
   "cells": [
    {
     "sid": "da0802:T00220",
     "kind": "본문",
     "jp": "頭上に浮かぶ、十字架の剣。",
     "ko": "머리 위에 떠오르는 십자가의 검."
    },
    {
     "sid": "da0802:T00221",
     "kind": "본문",
     "jp": "それは真っ直ぐにＤトゥーソードを貫き、剣に宿る魔力は解き放たれ、爆裂し――",
     "ko": "그것은 똑바로 D 투 소드를 꿰뚫고, 검에 깃든 마력은 해방되어 작렬하며――"
    }
   ]
  },
  {
   "uid": "da0802:U00076",
   "speaker": "(지문)",
   "jp": "心臓の間には、紅の鬼械神だけが残された。Ｄトゥーソードの姿は無い。全ては紅く〈くら〉冥い海の底へ呑み込まれていった。",
   "cells": [
    {
     "sid": "da0802:T00222",
     "kind": "본문",
     "jp": "心臓の間には、紅の鬼械神だけが残された。",
     "ko": "심장의 방에는 진홍의 귀계신만이 남겨졌다."
    },
    {
     "sid": "da0802:T00223",
     "kind": "본문",
     "jp": "Ｄトゥーソードの姿は無い。",
     "ko": "D 투 소드의 모습은 없다."
    },
    {
     "sid": "da0802:T00224",
     "kind": "본문",
     "jp": "全ては紅く",
     "ko": "모든 것은 붉고 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0802:R00046",
     "kind": "루비 읽기",
     "jp": "くら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0802:T00225",
     "kind": "본문",
     "jp": "冥",
     "ko": "어두",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0802:T00226",
     "kind": "본문",
     "jp": "い海の底へ呑み込まれていった。",
     "ko": "운 바다 밑바닥으로 삼켜져 갔다."
    }
   ]
  },
  {
   "uid": "da0802:U00077",
   "speaker": "テリオン",
   "jp": "「……つまらん……実につまらん」",
   "cells": [
    {
     "sid": "da0802:T00227",
     "kind": "본문",
     "jp": "「……つまらん……実につまらん」",
     "ko": "「……시시하군…… 실로 시시해」"
    }
   ]
  },
  {
   "uid": "da0802:U00078",
   "speaker": "テリオン",
   "jp": "「こんな〈・・・〉紛い物では、\n　我が飢餓は癒されぬ……」",
   "cells": [
    {
     "sid": "da0802:T00228",
     "kind": "본문",
     "jp": "「こんな",
     "ko": "「이런 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0802:R00047",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0802:T00229",
     "kind": "본문",
     "jp": "紛い物",
     "ko": "모조품",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0802:T00230",
     "kind": "본문",
     "jp": "では、\n　我が飢餓は癒されぬ……」",
     "ko": "으로는,\n　나의 기아는 치유되지 않는다……」"
    }
   ]
  },
  {
   "uid": "da0802:U00079",
   "speaker": "(지문)",
   "jp": "金色の瞳が遠い何処かを、〈じ〉凝っと見つめている。一切の光を映さない金色の闇――その奥に宿るのは憎しみか、\n焦がれか。\n\n　恐らくはそのどちらでもあり、どちらでもない。",
   "cells": [
    {
     "sid": "da0802:T00231",
     "kind": "본문",
     "jp": "金色の瞳が遠い何処かを、",
     "ko": "금빛 눈동자가 먼 어딘가를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0802:R00048",
     "kind": "루비 읽기",
     "jp": "じ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0802:T00232",
     "kind": "본문",
     "jp": "凝",
     "ko": "가만",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0802:T00233",
     "kind": "본문",
     "jp": "っと見つめている。",
     "ko": "히 응시하고 있다."
    },
    {
     "sid": "da0802:T00234",
     "kind": "본문",
     "jp": "一切の光を映さない金色の闇――その奥に宿るのは憎しみか、\n焦がれか。\n\n　恐らくはそのどちらでもあり、どちらでもない。",
     "ko": "일체의 빛을 비추지 않는 금빛 어둠――그 깊은 곳에 깃든 것은 증오인가,\n연모인가.\n\n　아마도 그 둘 다이며, 둘 다 아니다."
    }
   ]
  },
  {
   "uid": "da0802:U00080",
   "speaker": "テリオン",
   "jp": "「来い……大十字九郎……\n　アル・アジフ……デモンベイン！」",
   "cells": [
    {
     "sid": "da0802:T00235",
     "kind": "본문",
     "jp": "「来い……大十字九郎……\n　アル・アジフ……デモンベイン！」",
     "ko": "「오라…… 다이쥬지 쿠로……\n　알 아지프…… 데몬베인!」"
    }
   ]
  },
  {
   "uid": "da0802:U00081",
   "speaker": "テリオン",
   "jp": "「貴様らだけが――\n　三位一体の剣だけが、余を……」",
   "cells": [
    {
     "sid": "da0802:T00236",
     "kind": "본문",
     "jp": "「貴様らだけが――\n　三位一体の剣だけが、余を……」",
     "ko": "「네놈들만이――\n　삼위일체의 검만이, 짐을……」"
    }
   ]
  }
 ]
}