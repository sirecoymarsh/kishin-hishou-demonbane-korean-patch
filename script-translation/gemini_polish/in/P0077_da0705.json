     "kind": "본문",
     "jp": "時間",
     "ko": "시간",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00019",
     "kind": "본문",
     "jp": "さえも",
     "ko": "조차도 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0705:R00008",
     "kind": "루비 읽기",
     "jp": "ノルニル",
     "ko": "노르닐",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0705:T00020",
     "kind": "본문",
     "jp": "時間",
     "ko": "시간",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00021",
     "kind": "본문",
     "jp": "さえも",
     "ko": "조차도 ",
     "ruby_edge": "뒤"
    },
    {
