     "kind": "본문",
     "jp": "を始めよう。",
     "ko": "를 시작하자."
    }
   ]
  },
  {
   "uid": "da0705:U00002",
   "speaker": "(지문)",
   "jp": "それは〈ヒーロー〉英雄の物語。力を授かり、悪と戦い、友を助け、罠を破り、陰謀を砕き、\n　世界を救う英雄の物語。〈コウトウムケイ〉荒唐無稽な物語。誰もが愛する〈オトギバナシ〉御伽噺。",
   "cells": [
    {
     "sid": "da0705:T00004",
     "kind": "본문",
     "jp": "それは",
     "ko": "그것은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0705:R00002",
     "kind": "루비 읽기",
     "jp": "ヒーロー",
     "ko": "히어로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0705:T00005",
     "kind": "본문",
     "jp": "英雄",
     "ko": "영웅",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00006",
     "kind": "본문",
     "jp": "の物語。",
     "ko": "의 이야기."
    },
    {
     "sid": "da0705:T00007",
     "kind": "본문",
     "jp": "力を授かり、悪と戦い、友を助け、罠を破り、陰謀を砕き、\n　世界を救う英雄の物語。",
     "ko": "힘을 부여받고, 악과 싸우고, 벗을 돕고, 함정을 깨뜨리고, 음모를 부수고,\n　세계를 구하는 영웅의 이야기.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0705:R00003",
     "kind": "루비 읽기",
     "jp": "コウトウムケイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0705:T00008",
     "kind": "본문",
     "jp": "荒唐無稽",
     "ko": "황당무계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00009",
     "kind": "본문",
     "jp": "な物語。",
     "ko": "한 이야기."
    },
    {
     "sid": "da0705:T00010",
     "kind": "본문",
     "jp": "誰もが愛する",
     "ko": "누구나 사랑하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0705:R00004",
     "kind": "루비 읽기",
     "jp": "オトギバナシ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0705:T00011",
     "kind": "본문",
     "jp": "御伽噺",
     "ko": "옛날이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00012",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0705:U00003",
   "speaker": "瑠璃",
   "jp": "「〈ＬＯＮＧ　ＬＯＮＧ　ＴＩＭＥ　ＡＧＯ〉むかし、むかし……\n　でさえもないのだけれども。\n　だって、これは時間さえも\n　忘れてしまった物語」",
   "cells": [
    {
     "sid": "da0705:T00013",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0705:R00005",
     "kind": "루비 읽기",
     "jp": "ＬＯＮＧ　ＬＯＮＧ　ＴＩＭＥ　ＡＧＯ",
     "ko": "LONG LONG TIME AGO",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0705:T00014",
     "kind": "본문",
     "jp": "むかし、むかし",
     "ko": "옛날 옛적에",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0705:T00015",
     "kind": "본문",
     "jp": "……\n　でさえもないのだけれども。\n　だって、これは時間さえも\n　忘れてしまった物語」",
     "ko": "……\n　조차도 아니지만요.\n　그도 그럴 것이, 이것은 시간마저도\n　잊어버린 이야기」"
    }
   ]
  },
  {
   "uid": "da0705:U00004",
   "speaker": "(지문)",
   "jp": "〈クィーン〉養母が語る。〈クロノス〉時間さえも〈ノルニル〉時間さえも〈マイスター・ホラ〉時間さえも識らない物語。",
   "cells": [
    {
