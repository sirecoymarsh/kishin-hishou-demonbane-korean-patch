{
 "packet": "P0083_da0710",
 "units": [
  {
   "uid": "da0710:U00001",
   "speaker": "(지문)",
   "jp": "此処は祭壇にして玉座。衰えることなく燃え盛るその聖火の中に時折、異形の存在の影を〈かいまみ〉垣間見るのは、果たして錯覚なのだろうか――\n\n　幽幻なる静寂を撃ち砕く超大な質量。祭壇にして玉座を成す〈コロッセウム〉舞台に、全長５０メートルの機神が降り\n立った。",
   "cells": [
    {
     "sid": "da0710:T00001",
     "kind": "본문",
     "jp": "此処は祭壇にして玉座。",
     "ko": "이곳은 제단이자 옥좌."
    },
    {
     "sid": "da0710:T00002",
     "kind": "본문",
     "jp": "衰えることなく燃え盛るその聖火の中に時折、異形の存在の影を",
     "ko": "사그라들지 않고 타오르는 그 성화 속에서 이따금 이형의 존재의 그림자를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00001",
     "kind": "루비 읽기",
     "jp": "かいまみ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00003",
     "kind": "본문",
     "jp": "垣間見",
     "ko": "언뜻 보",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00004",
     "kind": "본문",
     "jp": "るのは、果たして錯覚なのだろうか――\n\n　幽幻なる静寂を撃ち砕く超大な質量。",
     "ko": "는 것은 과연 착각일까――\n\n　유현한 정적을 깨부수는 초대형 질량."
    },
    {
     "sid": "da0710:T00005",
     "kind": "본문",
     "jp": "祭壇にして玉座を成す",
     "ko": "제단이자 옥좌를 이루는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00002",
     "kind": "루비 읽기",
     "jp": "コロッセウム",
     "ko": "콜로세움",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00006",
     "kind": "본문",
     "jp": "舞台",
     "ko": "무대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00007",
     "kind": "본문",
     "jp": "に、全長５０メートルの機神が降り\n立った。",
     "ko": "에 전장 50미터의 기신이 내려\n섰다."
    }
   ]
  },
  {
   "uid": "da0710:U00002",
   "speaker": "(지문)",
   "jp": "沈む舞台。ひび割れる客席。慄くように激しく揺れ動く炎。",
   "cells": [
    {
     "sid": "da0710:T00008",
     "kind": "본문",
     "jp": "沈む舞台。ひび割れる客席。慄くように激しく揺れ動く炎。",
     "ko": "가라앉는 무대. 금이 가는 객석. 전율하듯 격렬하게 흔들리는 불꽃."
    }
   ]
  },
  {
   "uid": "da0710:U00003",
   "speaker": "(지문)",
   "jp": "幽幻たる光に照らされて、デモンベイン・トゥーソードは、荘厳な神像のように〈そび〉聳え立つ。\n\n　その巨体は空間のほとんどを占拠し、機体に落ちる影は不気味に〈ゆら〉幽めく。\n\n　薄闇を震わせて、機神は――九朔は叫んだ。",
   "cells": [
    {
     "sid": "da0710:T00009",
     "kind": "본문",
     "jp": "幽幻たる光に照らされて、デモンベイン・トゥーソードは、荘厳な神像のように",
     "ko": "유현한 빛에 비추어져, 데몬베인 투 소드는 장엄한 신상처럼 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00003",
     "kind": "루비 읽기",
     "jp": "そび",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00010",
     "kind": "본문",
     "jp": "聳",
     "ko": "우뚝 솟",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00011",
     "kind": "본문",
     "jp": "え立つ。\n\n　その巨体は空間のほとんどを占拠し、機体に落ちる影は不気味に",
     "ko": "아 있다.\n\n　그 거체는 공간의 대부분을 점거하고, 기체에 드리운 그림자는 기분 나쁘게\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00004",
     "kind": "루비 읽기",
     "jp": "ゆら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00012",
     "kind": "본문",
     "jp": "幽",
     "ko": "일렁",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00013",
     "kind": "본문",
     "jp": "めく。\n\n　薄闇を震わせて、機神は――九朔は叫んだ。",
     "ko": "인다.\n\n　어스름을 뒤흔들며 기신은――쿠자쿠는 외쳤다."
    }
   ]
  },
  {
   "uid": "da0710:U00004",
   "speaker": "九朔",
   "jp": "「出て来い、アナザーブラッド！\n　くだらん〈バーレスク〉三文芝居は、これで\n　お終いだ！」",
   "cells": [
    {
     "sid": "da0710:T00014",
     "kind": "본문",
     "jp": "「出て来い、アナザーブラッド！\n　くだらん",
     "ko": "「나와라, 어나더 블러드!\n　시시한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00005",
     "kind": "루비 읽기",
     "jp": "バーレスク",
     "ko": "벌레스크는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00015",
     "kind": "본문",
     "jp": "三文芝居",
     "ko": "삼류 연극은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00016",
     "kind": "본문",
     "jp": "は、これで\n　お終いだ！」",
     "ko": " 이걸로\n　끝이다!」"
    }
   ]
  },
  {
   "uid": "da0710:U00005",
   "speaker": "(지문)",
   "jp": "木霊する声。虚しく闇に呑まれてゆく。あるのはただ静寂ばかり。",
   "cells": [
    {
     "sid": "da0710:T00017",
     "kind": "본문",
     "jp": "木霊する声。",
     "ko": "메아리치는 목소리."
    },
    {
     "sid": "da0710:T00018",
     "kind": "본문",
     "jp": "虚しく闇に呑まれてゆく。",
     "ko": "공허하게 어둠에 삼켜져 간다."
    },
    {
     "sid": "da0710:T00019",
     "kind": "본문",
     "jp": "あるのはただ静寂ばかり。",
     "ko": "있는 것은 오직 정적뿐."
    }
   ]
  },
  {
   "uid": "da0710:U00006",
   "speaker": "九朔",
   "jp": "「……この前も言ったな。\nどうしても姿を現さないのならば\n――舞台ごと叩き斬ってやる」",
   "cells": [
    {
     "sid": "da0710:T00020",
     "kind": "본문",
     "jp": "「……この前も言ったな。\nどうしても姿を現さないのならば\n――舞台ごと叩き斬ってやる」",
     "ko": "「……전에도 말했지.\n아무리 해도 모습을 드러내지 않겠다면\n――무대째로 베어 넘겨 주마」"
    }
   ]
  },
  {
   "uid": "da0710:U00007",
   "speaker": "(지문)",
   "jp": "双剣を構える。刀身を〈はし〉奔る煌めき。風が魔力を宿して吹き荒れ、壊れかけた玉座の間をさらに細かく\n噛み砕いてゆく。",
   "cells": [
    {
     "sid": "da0710:T00021",
     "kind": "본문",
     "jp": "双剣を構える。",
     "ko": "쌍검을 겨눈다."
    },
    {
     "sid": "da0710:T00022",
     "kind": "본문",
     "jp": "刀身を",
     "ko": "도신을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00006",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00023",
     "kind": "본문",
     "jp": "奔",
     "ko": "달리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00024",
     "kind": "본문",
     "jp": "る煌めき。",
     "ko": "는 반짝임."
    },
    {
     "sid": "da0710:T00025",
     "kind": "본문",
     "jp": "風が魔力を宿して吹き荒れ、壊れかけた玉座の間をさらに細かく\n噛み砕いてゆく。",
     "ko": "바람이 마력을 품고 휘몰아치며, 부서져 가던 옥좌의 방을 더욱 잘게\n씹어 부수어 간다."
    }
   ]
  },
  {
   "uid": "da0710:U00008",
   "speaker": "九朔",
   "jp": "「消し飛べ」",
   "cells": [
    {
     "sid": "da0710:T00026",
     "kind": "본문",
     "jp": "「消し飛べ」",
     "ko": "「사라져라」"
    }
   ]
  },
  {
   "uid": "da0710:U00009",
   "speaker": "(지문)",
   "jp": "双剣を振り下ろさんとする、まさにその瞬間。",
   "cells": [
    {
     "sid": "da0710:T00027",
     "kind": "본문",
     "jp": "双剣を振り下ろさんとする、まさにその瞬間。",
     "ko": "쌍검을 내리치려 하는 바로 그 순간."
    }
   ]
  },
  {
   "uid": "da0710:U00010",
   "speaker": "アウグストゥス",
   "jp": "「――神聖なる『夢幻心母』内での狼藉、\n許すわけにはいかんな。〈ナイト・オブ・トゥーソード／トゥーガン〉『二闘流』の騎士」",
   "cells": [
    {
     "sid": "da0710:T00028",
     "kind": "본문",
     "jp": "「――神聖なる『夢幻心母』内での狼藉、\n許すわけにはいかんな。",
     "ko": "「――신성한 『몽환심모』 안에서의 난동,\n용서할 수는 없군. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00007",
     "kind": "루비 읽기",
     "jp": "ナイト・オブ・トゥーソード／トゥーガン",
     "ko": "나이트 오브 투 소드/투 건",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00029",
     "kind": "본문",
     "jp": "『二闘流』の騎士",
     "ko": "『이투류』의 기사",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00030",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0710:U00011",
   "speaker": "(지문)",
   "jp": "その男は忽然と姿を現した。玉座の横に佇む浅黒い肌の男。Ｄトゥーソードを見上げる瞳に宿る、邪悪な眼光。\n\n　アウグストゥス。大導師マスターテリオンに叛旗を翻した、野心のアンチクロス。\n\n　デモンベインを苦しめた程の魔力を持つ大魔術師を前にして、しかし九朔の心は冷め切っている。",
   "cells": [
    {
     "sid": "da0710:T00031",
     "kind": "본문",
     "jp": "その男は忽然と姿を現した。",
     "ko": "그 남자는 홀연히 모습을 드러냈다."
    },
    {
     "sid": "da0710:T00032",
     "kind": "본문",
     "jp": "玉座の横に佇む浅黒い肌の男。",
     "ko": "옥좌 옆에 서 있는 거무스름한 피부의 남자."
    },
    {
     "sid": "da0710:T00033",
     "kind": "본문",
     "jp": "Ｄトゥーソードを見上げる瞳に宿る、邪悪な眼光。\n\n　アウグストゥス。",
     "ko": "D 투 소드를 올려다보는 눈동자에 깃든 사악한 안광.\n\n　아우구스투스."
    },
    {
     "sid": "da0710:T00034",
     "kind": "본문",
     "jp": "大導師マスターテリオンに叛旗を翻した、野心のアンチクロス。\n\n　デモンベインを苦しめた程の魔力を持つ大魔術師を前にして、しかし九朔の心は冷め切っている。",
     "ko": "대도사 마스터 테리온에게 반기를 든 야심의 안티크로스.\n\n　데몬베인을 고전시켰을 정도의 마력을 지닌 대마술사를 앞에 두고도, 쿠자쿠의 마음은 차갑게 식어 있다."
    }
   ]
  },
  {
   "uid": "da0710:U00012",
   "speaker": "九朔",
   "jp": "「……雑魚か」",
   "cells": [
    {
     "sid": "da0710:T00035",
     "kind": "본문",
     "jp": "「……雑魚か」",
     "ko": "「……피라미인가」"
    }
   ]
  },
  {
   "uid": "da0710:U00013",
   "speaker": "(지문)",
   "jp": "つまらなそうに吐き捨てる。九朔の言葉に、アウグストゥスは不敵な笑みで返した。",
   "cells": [
    {
     "sid": "da0710:T00036",
     "kind": "본문",
     "jp": "つまらなそうに吐き捨てる。",
     "ko": "시시하다는 듯 내뱉는다."
    },
    {
     "sid": "da0710:T00037",
     "kind": "본문",
     "jp": "九朔の言葉に、アウグストゥスは不敵な笑みで返した。",
     "ko": "쿠자쿠의 말에 아우구스투스는 대담한 미소로 응수했다."
    }
   ]
  },
  {
   "uid": "da0710:U00014",
   "speaker": "アウグストゥス",
   "jp": "「フッ……近頃の騎士は\n　礼儀を〈わきま〉弁えぬと見える」",
   "cells": [
    {
     "sid": "da0710:T00038",
     "kind": "본문",
     "jp": "「フッ……近頃の騎士は\n　礼儀を",
     "ko": "「훗…… 요즘 기사는\n　예의를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00008",
     "kind": "루비 읽기",
     "jp": "わきま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00039",
     "kind": "본문",
     "jp": "弁",
     "ko": "차리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00040",
     "kind": "본문",
     "jp": "えぬと見える」",
     "ko": "지 못하는 모양이군」"
    }
   ]
  },
  {
   "uid": "da0710:U00015",
   "speaker": "九朔",
   "jp": "「ほざけ、〈ちりあくた〉塵芥。\n貴様のような下賤に礼を尽くすほど、騎士の誇りは安くないのだ」",
   "cells": [
    {
     "sid": "da0710:T00041",
     "kind": "본문",
     "jp": "「ほざけ、",
     "ko": "「지껄여라, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00009",
     "kind": "루비 읽기",
     "jp": "ちりあくた",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00042",
     "kind": "본문",
     "jp": "塵芥",
     "ko": "티끌",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00043",
     "kind": "본문",
     "jp": "。\n貴様のような下賤に礼を尽くすほど、騎士の誇りは安くないのだ」",
     "ko": "만도 못한 놈.\n네놈 같은 비천한 자에게 예를 다할 정도로 기사의 긍지는 값싸지 않다」"
    }
   ]
  },
  {
   "uid": "da0710:U00016",
   "speaker": "アウグストゥス",
   "jp": "「その傲慢さ……なるほど。母親そっくりだな」",
   "cells": [
    {
     "sid": "da0710:T00044",
     "kind": "본문",
     "jp": "「その傲慢さ……なるほど。母親そっくりだな」",
     "ko": "「그 오만함…… 과연. 어미를 빼닮았군」"
    }
   ]
  },
  {
   "uid": "da0710:U00017",
   "speaker": "九朔",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0710:T00045",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0710:U00018",
   "speaker": "アウグストゥス",
   "jp": "「そして、その愚かしさは――父親そっくりだ」",
   "cells": [
    {
     "sid": "da0710:T00046",
     "kind": "본문",
     "jp": "「そして、その愚かしさは――父親そっくりだ」",
     "ko": "「그리고 그 어리석음은――아비를 빼닮았어」"
    }
   ]
  },
  {
   "uid": "da0710:U00019",
   "speaker": "(지문)",
   "jp": "見えない衝撃が迸る。さらにひび割れる玉座の間。\n\n　Ｄトゥーソードから放たれた闘気だ。機体を通して、九朔の殺気がアウグストゥスに突き刺さる。",
   "cells": [
    {
     "sid": "da0710:T00047",
     "kind": "본문",
     "jp": "見えない衝撃が迸る。",
     "ko": "보이지 않는 충격이 솟구친다."
    },
    {
     "sid": "da0710:T00048",
     "kind": "본문",
     "jp": "さらにひび割れる玉座の間。\n\n　Ｄトゥーソードから放たれた闘気だ。",
     "ko": "더욱 금이 가는 옥좌의 방.\n\n　D 투 소드에서 뿜어져 나온 투기다."
    },
    {
     "sid": "da0710:T00049",
     "kind": "본문",
     "jp": "機体を通して、九朔の殺気がアウグストゥスに突き刺さる。",
     "ko": "기체를 통해 쿠자쿠의 살기가 아우구스투스에게 꽂힌다."
    }
   ]
  },
  {
   "uid": "da0710:U00020",
   "speaker": "九朔",
   "jp": "「……よくぞ吠えた、下郎。\n　虫けらの如く不様に死ぬこと\n　を許可する」",
   "cells": [
    {
     "sid": "da0710:T00050",
     "kind": "본문",
     "jp": "「……よくぞ吠えた、下郎。\n　虫けらの如く不様に死ぬこと\n　を許可する」",
     "ko": "「……잘도 짖었구나, 천한 놈.\n　벌레처럼 볼썽사납게 죽는 것\n　을 허가한다」"
    }
   ]
  },
  {
   "uid": "da0710:U00021",
   "speaker": "九朔",
   "jp": "「――〈ＤＲＡＷ　ＹＯＵＲ　ＧＵＮ〉鬼械神を喚べ」",
   "cells": [
    {
     "sid": "da0710:T00051",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0710:R00010",
     "kind": "루비 읽기",
     "jp": "ＤＲＡＷ　ＹＯＵＲ　ＧＵＮ",
     "ko": "DRAW YOUR GUN",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00052",
     "kind": "본문",
     "jp": "鬼械神を喚べ",
     "ko": "귀계신을 불러라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00053",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0710:U00022",
   "speaker": "アウグストゥス",
   "jp": "「はは……ふはははは……\n　フハハハハハハハハハッ！」",
   "cells": [
    {
     "sid": "da0710:T00054",
     "kind": "본문",
     "jp": "「はは……ふはははは……\n　フハハハハハハハハハッ！」",
     "ko": "「하하…… 후하하하하……\n　후하하하하하하하하핫!」"
    }
   ]
  },
  {
   "uid": "da0710:U00023",
   "speaker": "(지문)",
   "jp": "常人なら心臓が破裂するほどの鬼迫を正面から受け止め、だが\nアウグストゥスは〈わら〉哄笑っていた。何も無い虚空に金色の光が生じて、鬼火のようにアウグストゥスの周囲を浮遊する。",
   "cells": [
    {
     "sid": "da0710:T00055",
     "kind": "본문",
     "jp": "常人なら心臓が破裂するほどの鬼迫を正面から受け止め、だが\nアウグストゥスは",
     "ko": "보통 사람이라면 심장이 파열될 정도의 기백을 정면으로 받아 내고도,\n아우구스투스는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00011",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00056",
     "kind": "본문",
     "jp": "哄笑",
     "ko": "홍소",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00057",
     "kind": "본문",
     "jp": "っていた。",
     "ko": "를 터뜨리고 있었다."
    },
    {
     "sid": "da0710:T00058",
     "kind": "본문",
     "jp": "何も無い虚空に金色の光が生じて、鬼火のようにアウグストゥスの周囲を浮遊する。",
     "ko": "아무것도 없는 허공에 금빛이 생겨나, 도깨비불처럼 아우구스투스의 주위를 부유한다."
    }
   ]
  },
  {
   "uid": "da0710:U00024",
   "speaker": "(지문)",
   "jp": "実体を結ぶ光。それは全１３冊からなる書物。魔導書『金枝篇』だ。１３冊の魔導書が同時に開く。開かれた〈ページ〉頁の向こうから溢れ出す、光の枝。黄金の枝。黄金の枝は無数に分岐／複雑な経路を辿りながら伸張／枝と枝は複雑に絡み合い――伸びて／伸びて／伸びて／伸びて／伸びて／伸びて／伸びて／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／拡がり／拡がり／拡がり／拡がり／拡がり／拡がって、編み込まれてゆく金細工。精巧に組み立てられてゆく藝術。\n\n　金細工はＤトゥーソードよりも巨大に成長し、その内に内包する魔力は物理的な重圧を得る。\n\n　途方もない質量の気配。ひび割れた〈コロッセウム〉舞台の強度は、限界に達し――",
   "cells": [
    {
     "sid": "da0710:T00059",
     "kind": "본문",
     "jp": "実体を結ぶ光。",
     "ko": "실체를 맺는 빛."
    },
    {
     "sid": "da0710:T00060",
     "kind": "본문",
     "jp": "それは全１３冊からなる書物。",
     "ko": "그것은 전 13권으로 이루어진 서적."
    },
    {
     "sid": "da0710:T00061",
     "kind": "본문",
     "jp": "魔導書『金枝篇』だ。",
     "ko": "마도서 『황금가지』다."
    },
    {
     "sid": "da0710:T00062",
     "kind": "본문",
     "jp": "１３冊の魔導書が同時に開く。",
     "ko": "13권의 마도서가 동시에 펼쳐진다."
    },
    {
     "sid": "da0710:T00063",
     "kind": "본문",
     "jp": "開かれた",
     "ko": "펼쳐진 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00012",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00064",
     "kind": "본문",
     "jp": "頁",
     "ko": "책장",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00065",
     "kind": "본문",
     "jp": "の向こうから溢れ出す、光の枝。黄金の枝。",
     "ko": " 너머에서 넘쳐흐르는 빛의 가지. 황금의 가지."
    },
    {
     "sid": "da0710:T00066",
     "kind": "본문",
     "jp": "黄金の枝は無数に分岐／複雑な経路を辿りながら伸張／枝と枝は複雑に絡み合い――",
     "ko": "황금의 가지는 무수히 분기/복잡한 경로를 더듬으며 신장/가지와 가지는 복잡하게 얽혀――"
    },
    {
     "sid": "da0710:T00067",
     "kind": "본문",
     "jp": "伸びて／伸びて／伸びて／伸びて／伸びて／伸びて／伸びて／",
     "ko": "뻗고/뻗고/뻗고/뻗고/뻗고/뻗고/뻗으며/"
    },
    {
     "sid": "da0710:T00068",
     "kind": "본문",
     "jp": "昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／昇り／",
     "ko": "솟고/솟고/솟고/솟고/솟고/솟고/솟고/솟고/솟고/솟고/솟으며/"
    },
    {
     "sid": "da0710:T00069",
     "kind": "본문",
     "jp": "拡がり／拡がり／拡がり／拡がり／拡がり／拡がって、",
     "ko": "퍼지고/퍼지고/퍼지고/퍼지고/퍼지고/퍼져서,"
    },
    {
     "sid": "da0710:T00070",
     "kind": "본문",
     "jp": "編み込まれてゆく金細工。精巧に組み立てられてゆく藝術。\n\n　金細工はＤトゥーソードよりも巨大に成長し、その内に内包する魔力は物理的な重圧を得る。\n\n　途方もない質量の気配。",
     "ko": "엮여 들어가는 금세공. 정교하게 조립되어 가는 예술.\n\n　금세공은 D 투 소드보다도 거대하게 성장하여, 그 안에 내포된 마력은 물리적인 중압을 얻는다.\n\n　터무니없는 질량의 기척."
    },
    {
     "sid": "da0710:T00071",
     "kind": "본문",
     "jp": "ひび割れた",
     "ko": "금이 간 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00013",
     "kind": "루비 읽기",
     "jp": "コロッセウム",
     "ko": "콜로세움",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00072",
     "kind": "본문",
     "jp": "舞台",
     "ko": "무대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00073",
     "kind": "본문",
     "jp": "の強度は、限界に達し――",
     "ko": "의 강도는 한계에 달해――"
    }
   ]
  },
  {
   "uid": "da0710:U00025",
   "speaker": "アウグストゥス",
   "jp": "「――では、我が〈デウス・マキナ〉鬼械神レガシー・\nオブ・ゴールドがお相手しよう！」",
   "cells": [
    {
     "sid": "da0710:T00074",
     "kind": "본문",
     "jp": "「――では、我が",
     "ko": "「――그럼 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00014",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00075",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00076",
     "kind": "본문",
     "jp": "レガシー・\nオブ・ゴールドがお相手しよう！」",
     "ko": " 레거시\n오브 골드가 상대해 주지!」"
    }
   ]
  },
  {
   "uid": "da0710:U00026",
   "speaker": "九朔",
   "jp": "「――ッ！」",
   "cells": [
    {
     "sid": "da0710:T00077",
     "kind": "본문",
     "jp": "「――ッ！」",
     "ko": "「――윽!」"
    }
   ]
  },
  {
   "uid": "da0710:U00027",
   "speaker": "(지문)",
   "jp": "決壊する。Ｄトゥーソードが大きく沈む。\n\n　砕け散る舞台。崩れ落ちる足場。その下は底無しの闇。",
   "cells": [
    {
     "sid": "da0710:T00078",
     "kind": "본문",
     "jp": "決壊する。",
     "ko": "붕괴한다."
    },
    {
     "sid": "da0710:T00079",
     "kind": "본문",
     "jp": "Ｄトゥーソードが大きく沈む。\n\n　砕け散る舞台。崩れ落ちる足場。",
     "ko": "D 투 소드가 크게 가라앉는다.\n\n　산산이 부서지는 무대. 무너져 내리는 발판."
    },
    {
     "sid": "da0710:T00080",
     "kind": "본문",
     "jp": "その下は底無しの闇。",
     "ko": "그 아래는 밑바닥 없는 어둠."
    }
   ]
  },
  {
   "uid": "da0710:U00028",
   "speaker": "(지문)",
   "jp": "墜ちる。総ては深淵の向こうへと。",
   "cells": [
    {
     "sid": "da0710:T00081",
     "kind": "본문",
     "jp": "墜ちる。",
     "ko": "추락한다."
    },
    {
     "sid": "da0710:T00082",
     "kind": "본문",
     "jp": "総ては深淵の向こうへと。",
     "ko": "모든 것은 심연의 저편으로."
    }
   ]
  },
  {
   "uid": "da0710:U00029",
   "speaker": "九朔",
   "jp": "「クッ……！」",
   "cells": [
    {
     "sid": "da0710:T00083",
     "kind": "본문",
     "jp": "「クッ……！」",
     "ko": "「큭……!」"
    }
   ]
  },
  {
   "uid": "da0710:U00030",
   "speaker": "アウグストゥス",
   "jp": "「悪夢よ！〈うつしよ〉現世に感染せよ！」",
   "cells": [
    {
     "sid": "da0710:T00084",
     "kind": "본문",
     "jp": "「悪夢よ！",
     "ko": "「악몽이여! ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00015",
     "kind": "루비 읽기",
     "jp": "うつしよ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00085",
     "kind": "본문",
     "jp": "現世",
     "ko": "현세",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00086",
     "kind": "본문",
     "jp": "に感染せよ！」",
     "ko": "에 감염하라!」"
    }
   ]
  },
  {
   "uid": "da0710:U00031",
   "speaker": "(지문)",
   "jp": "黄金の衝撃。金の閃光が、闇を押し退ける。\n\n　『金枝篇』が編む巨大な金細工に、〈マキーナ〉命が宿ったのだ。〈アート〉藝術が〈マキーナ〉機械として完成したのだ。",
   "cells": [
    {
     "sid": "da0710:T00087",
     "kind": "본문",
     "jp": "黄金の衝撃。",
     "ko": "황금의 충격."
    },
    {
     "sid": "da0710:T00088",
     "kind": "본문",
     "jp": "金の閃光が、闇を押し退ける。\n\n　『金枝篇』が編む巨大な金細工に、",
     "ko": "금빛 섬광이 어둠을 밀어낸다.\n\n　『황금가지』가 엮어 내는 거대한 금세공에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00016",
     "kind": "루비 읽기",
     "jp": "マキーナ",
     "ko": "마키나가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00089",
     "kind": "본문",
     "jp": "命",
     "ko": "생명이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00090",
     "kind": "본문",
     "jp": "が宿ったのだ。",
     "ko": " 깃들었다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00017",
     "kind": "루비 읽기",
     "jp": "アート",
     "ko": "아트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00091",
     "kind": "본문",
     "jp": "藝術",
     "ko": "예술",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00092",
     "kind": "본문",
     "jp": "が",
     "ko": "이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0710:R00018",
     "kind": "루비 읽기",
     "jp": "マキーナ",
     "ko": "마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0710:T00093",
     "kind": "본문",
     "jp": "機械",
     "ko": "기계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0710:T00094",
     "kind": "본문",
     "jp": "として完成したのだ。",
     "ko": "로서 완성되었다."
    }
   ]
  },
  {
   "uid": "da0710:U00032",
   "speaker": "(지문)",
   "jp": "――鬼械神レガシー・オブ・ゴールド！",
   "cells": [
    {
     "sid": "da0710:T00095",
     "kind": "본문",
     "jp": "――鬼械神レガシー・オブ・ゴールド！",
     "ko": "――귀계신 레거시 오브 골드!"
    }
   ]
  },
  {
   "uid": "da0710:U00033",
   "speaker": "九朔",
   "jp": "「うおおおおおおおおおおお！」",
   "cells": [
    {
     "sid": "da0710:T00096",
     "kind": "본문",
     "jp": "「うおおおおおおおおおおお！」",
     "ko": "「우오오오오오오오오오오오!」"
    }
   ]
  },
  {
   "uid": "da0710:U00034",
   "speaker": "(지문)",
   "jp": "墜ちるＤトゥーソードの掌中に二挺の魔銃が顕現する。構えた銃身、〈プラズマ〉閃光と〈ダイヤモンド・ダスト〉氷霧を纏う。",
   "cells": [
    {
     "sid": "da0710:T00097",
     "kind": "본문",
     "jp": "墜ちるＤトゥーソードの掌中に二挺の魔銃が顕現する。",
     "ko": "추락하는 D 투 소드의 손바닥에 두 자루의 마총이 현현한다."
    },
    {
     "sid": "da0710:T00098",
     "kind": "본문",
     "jp": "構えた銃身、",
     "ko": "겨눈 총신, ",
     "ruby_edge": "뒤"
    },
