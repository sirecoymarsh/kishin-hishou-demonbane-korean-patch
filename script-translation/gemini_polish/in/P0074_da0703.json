    {
     "sid": "da0703:T00016",
     "kind": "본문",
     "jp": "憧憬。",
     "ko": " 동경."
    },
    {
     "sid": "da0703:T00017",
     "kind": "본문",
     "jp": "戸惑い。",
     "ko": " 당혹."
