  },
  {
   "uid": "da0703:U00004",
   "speaker": "チアキ",
   "jp": "「余　計　な　真　似　を　す　る　な」",
   "cells": [
    {
     "sid": "da0703:T00004",
     "kind": "본문",
     "jp": "「余　計　な　真　似　を　す　る　な」",
