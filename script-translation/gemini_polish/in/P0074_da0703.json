  },
  {
   "uid": "da0703:U00038",
   "speaker": "テリオン",
   "jp": "「ははははははははははははははははは！」",
   "cells": [
    {
     "sid": "da0703:T00174",
     "kind": "본문",
     "jp": "「ははははははははははははははははは！」",
     "ko": "「하하하하하하하하하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da0703:U00039",
   "speaker": "アナザーブラッド",
   "jp": "「吼えるな！」",
   "cells": [
    {
     "sid": "da0703:T00175",
     "kind": "본문",
     "jp": "「吼えるな！」",
     "ko": "「짖지 마라!」"
    }
   ]
  },
  {
   "uid": "da0703:U00040",
   "speaker": "(지문)",
   "jp": "少年は血飛沫となって爆ぜた。金色の髪が、瞳が、血の霧となって散ってゆく。ただ少年の哄笑だけが響き続ける。",
   "cells": [
    {
     "sid": "da0703:T00176",
     "kind": "본문",
     "jp": "少年は血飛沫となって爆ぜた。",
     "ko": "소년은 피보라가 되어 터졌다."
    },
    {
     "sid": "da0703:T00177",
     "kind": "본문",
     "jp": "金色の髪が、瞳が、血の霧となって散ってゆく。",
     "ko": "금빛 머리카락이, 눈동자가, 피안개가 되어 흩어져 간다."
    },
    {
     "sid": "da0703:T00178",
     "kind": "본문",
     "jp": "ただ少年の哄笑だけが響き続ける。",
     "ko": "오직 소년의 홍소만이 계속해서 울려 퍼진다."
    }
   ]
  },
  {
   "uid": "da0703:U00041",
   "speaker": "テリオン",
   "jp": "「では余の役目を果たすとしよう。\n　これ以上、姫君の機嫌を損ねるわけには\n　いかないのでな。あはははは！」",
   "cells": [
    {
     "sid": "da0703:T00179",
     "kind": "본문",
     "jp": "「では余の役目を果たすとしよう。\n　これ以上、姫君の機嫌を損ねるわけには\n　いかないのでな。あはははは！」",
     "ko": "「그럼 짐의 역할을 완수하도록 하지.\n　더 이상 공주님의 심기를 거스를 수는\n　없으니 말이다. 아하하하하!」"
    }
   ]
  },
  {
   "uid": "da0703:U00042",
   "speaker": "アナザーブラッド",
   "jp": "「くっ……！」",
   "cells": [
    {
     "sid": "da0703:T00180",
     "kind": "본문",
     "jp": "「くっ……！」",
     "ko": "「큭……!」"
    }
   ]
  },
  {
   "uid": "da0703:U00043",
   "speaker": "(지문)",
   "jp": "哄笑は天に吸い込まれ、消えていった。血の霧が少女の姿を包み込む。紅の中にあって、少女の影はなお紅い。",
   "cells": [
    {
     "sid": "da0703:T00181",
     "kind": "본문",
     "jp": "哄笑は天に吸い込まれ、消えていった。",
     "ko": "홍소는 하늘로 빨려 들어가 사라졌다."
    },
    {
     "sid": "da0703:T00182",
     "kind": "본문",
     "jp": "血の霧が少女の姿を包み込む。",
     "ko": "피안개가 소녀의 모습을 감싼다."
    },
    {
     "sid": "da0703:T00183",
     "kind": "본문",
     "jp": "紅の中にあって、少女の影はなお紅い。",
     "ko": "진홍빛 속에서도 소녀의 그림자는 더욱 붉다."
    }
   ]
  },
  {
   "uid": "da0703:U00044",
   "speaker": "アナザーブラッド",
   "jp": "「……悪夢は真実となる。私は真実となる。\n　九朔――貴方の全てを否定してあげる」",
   "cells": [
    {
     "sid": "da0703:T00184",
     "kind": "본문",
     "jp": "「……悪夢は真実となる。私は真実となる。\n　九朔――貴方の全てを否定してあげる」",
     "ko": "「……악몽은 진실이 된다. 나는 진실이 된다.\n　쿠자쿠――당신의 모든 것을 부정해 줄게」"
    }
   ]
  },
  {
   "uid": "da0703:U00045",
   "speaker": "(지문)",
