  },
  {
   "uid": "da0707:U00034",
   "speaker": "九朔",
   "jp": "「――来たれ！\n　我が剣、デモンベイン！」",
   "cells": [
    {
     "sid": "da0707:T00067",
     "kind": "본문",
     "jp": "「――来たれ！\n　我が剣、デモンベイン！」",
