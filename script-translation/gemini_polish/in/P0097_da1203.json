{
 "packet": "P0097_da1203",
 "units": [
  {
   "uid": "da1203:U00001",
   "speaker": "(지문)",
   "jp": "〈くら〉冥い〈あんこく〉闇黒を、墜ちる。墜ちる。墜ちる。墜ちて、墜ちて、堕ちる。",
   "cells": [
    {
     "sid": "da1203:R00001",
     "kind": "루비 읽기",
     "jp": "くら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00001",
     "kind": "본문",
     "jp": "冥",
     "ko": "어둡",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00002",
     "kind": "본문",
     "jp": "い",
     "ko": "고 짙은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00002",
     "kind": "루비 읽기",
     "jp": "あんこく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00003",
     "kind": "본문",
     "jp": "闇黒",
     "ko": "암흑",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00004",
     "kind": "본문",
     "jp": "を、墜ちる。",
     "ko": "을, 추락한다."
    },
    {
     "sid": "da1203:T00005",
     "kind": "본문",
     "jp": "墜ちる。",
     "ko": "추락한다."
    },
    {
     "sid": "da1203:T00006",
     "kind": "본문",
     "jp": "墜ちる。",
     "ko": "추락한다."
    },
    {
     "sid": "da1203:T00007",
     "kind": "본문",
     "jp": "墜ちて、",
     "ko": "추락하고,"
    },
    {
     "sid": "da1203:T00008",
     "kind": "본문",
     "jp": "墜ちて、",
     "ko": " 추락하여,"
    },
    {
     "sid": "da1203:T00009",
     "kind": "본문",
     "jp": "堕ちる。",
     "ko": " 전락한다."
    }
   ]
  },
  {
   "uid": "da1203:U00002",
   "speaker": "九朔",
   "jp": "「我は……」",
   "cells": [
    {
     "sid": "da1203:T00010",
     "kind": "본문",
     "jp": "「我は……」",
     "ko": "「나는……」"
    }
   ]
  },
  {
   "uid": "da1203:U00003",
   "speaker": "(지문)",
   "jp": "墜ちながら、躰を動かそうと足掻く。だが、力が入らない。自分の躰が自分のものではない感覚。現実感が、実在感がまったく無い。\n\n　重い。自分の躰が酷く重い。不快なくらいに重い。嗚呼、なんて〈のろま〉鈍重な、肉の牢獄。\n\n　何故――と思い、唐突に思い出す。紅の機神。砕け散るデモンベイン。",
   "cells": [
    {
     "sid": "da1203:T00011",
     "kind": "본문",
     "jp": "墜ちながら、躰を動かそうと足掻く。",
     "ko": "추락하면서 몸을 움직이려고 발버둥 친다."
    },
    {
     "sid": "da1203:T00012",
     "kind": "본문",
     "jp": "だが、力が入らない。",
     "ko": "하지만 힘이 들어가지 않는다."
    },
    {
     "sid": "da1203:T00013",
     "kind": "본문",
     "jp": "自分の躰が自分のものではない感覚。",
     "ko": "내 몸이 내 것이 아닌 감각."
    },
    {
     "sid": "da1203:T00014",
     "kind": "본문",
     "jp": "現実感が、実在感がまったく無い。\n\n　重い。",
     "ko": "현실감이, 실재감이 전혀 없다.\n\n　무겁다."
    },
    {
     "sid": "da1203:T00015",
     "kind": "본문",
     "jp": "自分の躰が酷く重い。",
     "ko": "내 몸이 지독히 무겁다."
    },
    {
     "sid": "da1203:T00016",
     "kind": "본문",
     "jp": "不快なくらいに重い。",
     "ko": "불쾌할 정도로 무겁다."
    },
    {
     "sid": "da1203:T00017",
     "kind": "본문",
     "jp": "嗚呼、なんて",
     "ko": "아아, 이 얼마나 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00003",
     "kind": "루비 읽기",
     "jp": "のろま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00018",
     "kind": "본문",
     "jp": "鈍重",
     "ko": "둔중",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00019",
     "kind": "본문",
     "jp": "な、肉の牢獄。\n\n　何故――と思い、唐突に思い出す。",
     "ko": "한, 살덩이의 감옥인가.\n\n　어째서――라고 생각하다, 돌연 떠올린다."
    },
    {
     "sid": "da1203:T00020",
     "kind": "본문",
     "jp": "紅の機神。",
     "ko": "붉은 기신."
    },
    {
     "sid": "da1203:T00021",
     "kind": "본문",
     "jp": "砕け散るデモンベイン。",
     "ko": "부서져 흩어지는 데몬베인."
    }
   ]
  },
  {
   "uid": "da1203:U00004",
   "speaker": "(지문)",
   "jp": "我は――",
   "cells": [
    {
     "sid": "da1203:T00022",
     "kind": "본문",
     "jp": "我は――",
     "ko": "나는――"
    }
   ]
  },
  {
   "uid": "da1203:U00005",
   "speaker": "九朔",
   "jp": "「我は……敗れたのか……」",
   "cells": [
    {
     "sid": "da1203:T00023",
     "kind": "본문",
     "jp": "「我は……敗れたのか……」",
     "ko": "「나는…… 패배한 것인가……」"
    }
   ]
  },
  {
   "uid": "da1203:U00006",
   "speaker": "(지문)",
   "jp": "躰がさらに重くなった気がした。酷い頭痛が、脳を掻き乱す。\n\n　こんな重い苦しみが続くなら、意識を闇に沈めてしまいたい。何も考えたくない……",
   "cells": [
    {
     "sid": "da1203:T00024",
     "kind": "본문",
     "jp": "躰がさらに重くなった気がした。",
     "ko": "몸이 한층 더 무거워진 기분이 들었다."
    },
    {
     "sid": "da1203:T00025",
     "kind": "본문",
     "jp": "酷い頭痛が、脳を掻き乱す。\n\n　こんな重い苦しみが続くなら、意識を闇に沈めてしまいたい。",
     "ko": "심한 두통이 뇌를 헤집어 놓는다.\n\n　이런 무거운 고통이 계속된다면 의식을 어둠에 가라앉혀 버리고 싶다."
    },
    {
     "sid": "da1203:T00026",
     "kind": "본문",
     "jp": "何も考えたくない……",
     "ko": "아무 생각도 하고 싶지 않다……"
    }
   ]
  },
  {
   "uid": "da1203:U00007",
   "speaker": "(지문)",
   "jp": "無防備になった心に、それは来た。怒涛の如く流れ込む、大質量の思念。\n\n　灼けるように熱く、壊れそうなほどに烈しく、苛烈で壮絶な魂の衝動／燃焼／激動／疾走／爆発／嵐――\n\n　それなのにそれは、強くて、優しくて、陽気で、愛しくて――\n\n　貴方は――",
   "cells": [
    {
     "sid": "da1203:T00027",
     "kind": "본문",
     "jp": "無防備になった心に、それは来た。",
     "ko": "무방비해진 마음에, 그것은 왔다."
    },
    {
     "sid": "da1203:T00028",
     "kind": "본문",
     "jp": "怒涛の如く流れ込む、大質量の思念。\n\n　灼けるように熱く、壊れそうなほどに烈しく、",
     "ko": "노도처럼 흘러들어오는 대질량의 사념.\n\n　타들어 갈 듯이 뜨겁고, 부서질 정도로 격렬하며,"
    },
    {
     "sid": "da1203:T00029",
     "kind": "본문",
     "jp": "苛烈で壮絶な",
     "ko": " 가열차고 장절한"
    },
    {
     "sid": "da1203:T00030",
     "kind": "본문",
     "jp": "魂の衝動／",
     "ko": " 영혼의 충동／"
    },
    {
     "sid": "da1203:T00031",
     "kind": "본문",
     "jp": "燃焼／",
     "ko": "연소／"
    },
    {
     "sid": "da1203:T00032",
     "kind": "본문",
     "jp": "激動／",
     "ko": "격동／"
    },
    {
     "sid": "da1203:T00033",
     "kind": "본문",
     "jp": "疾走／",
     "ko": "질주／"
    },
    {
     "sid": "da1203:T00034",
     "kind": "본문",
     "jp": "爆発／",
     "ko": "폭발／"
    },
    {
     "sid": "da1203:T00035",
     "kind": "본문",
     "jp": "嵐――\n\n　それなのにそれは、",
     "ko": "폭풍――\n\n　그런데도 그것은,"
    },
    {
     "sid": "da1203:T00036",
     "kind": "본문",
     "jp": "強くて、",
     "ko": " 강하고,"
    },
    {
     "sid": "da1203:T00037",
     "kind": "본문",
     "jp": "優しくて、",
     "ko": " 상냥하고,"
    },
    {
     "sid": "da1203:T00038",
     "kind": "본문",
     "jp": "陽気で、",
     "ko": " 쾌활하고,"
    },
    {
     "sid": "da1203:T00039",
     "kind": "본문",
     "jp": "愛しくて――\n\n　貴方は――",
     "ko": " 사랑스러워서――\n\n　당신은――"
    }
   ]
  },
  {
   "uid": "da1203:U00008",
   "speaker": "(지문)",
   "jp": "それでは〈オトギバナシ〉御伽噺を始めよう。それはきっと英雄譚だ。英雄の物語を、お前は嫌うだろうか？\n\n\n　\n　\n　\n　\n　\n　　　――だがこれは、酷く不様な英雄の物語なのだ。",
   "cells": [
    {
     "sid": "da1203:T00040",
     "kind": "본문",
     "jp": "それでは",
     "ko": "자, 그럼 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00004",
     "kind": "루비 읽기",
     "jp": "オトギバナシ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00041",
     "kind": "본문",
     "jp": "御伽噺",
     "ko": "옛날이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00042",
     "kind": "본문",
     "jp": "を始めよう。",
     "ko": "를 시작하자."
    },
    {
     "sid": "da1203:T00043",
     "kind": "본문",
     "jp": "それはきっと英雄譚だ。",
     "ko": "그것은 분명 영웅담이다."
    },
    {
     "sid": "da1203:T00044",
     "kind": "본문",
     "jp": "英雄の物語を、お前は嫌うだろうか？\n\n\n　\n　\n　\n　\n　\n　　　――だがこれは、酷く不様な英雄の物語なのだ。",
     "ko": "영웅의 이야기를, 너는 싫어할까?\n\n\n　\n　\n　\n　\n　\n　　　――하지만 이것은, 지독히도 볼썽사나운 영웅의 이야기다."
    }
   ]
  },
  {
   "uid": "da1203:U00009",
   "speaker": "(지문)",
   "jp": "そいつは何度も敗れ、何度もズタボロになった。胃の中のものを全部ぶち撒け、\n　あまつさえ自分が吐き散らかしたゲロの中に倒れた。",
   "cells": [
    {
     "sid": "da1203:T00045",
     "kind": "본문",
     "jp": "そいつは何度も敗れ、何度もズタボロになった。",
     "ko": "그 녀석은 몇 번이고 패배하고, 몇 번이고 만신창이가 되었다."
    },
    {
     "sid": "da1203:T00046",
     "kind": "본문",
     "jp": "胃の中のものを全部ぶち撒け、\n　あまつさえ自分が吐き散らかしたゲロの中に倒れた。",
     "ko": "위장 속의 것을 전부 토해 내고,\n　심지어 자신이 토해 놓은 오물 속에 쓰러졌다."
    }
   ]
  },
  {
   "uid": "da1203:U00010",
   "speaker": "(지문)",
   "jp": "血まみれになって、ゲロまみれになって、そいつは戦った。歯を食い縛って涙を堪え、怯える心と震える躰に鞭打って。\n\n\n　そんなみじめな英雄の物語を、お前は〈わら〉嘲笑うだろうか？",
   "cells": [
    {
     "sid": "da1203:T00047",
     "kind": "본문",
     "jp": "血まみれになって、ゲロまみれになって、そいつは戦った。",
     "ko": "피투성이가 되고, 오물투성이가 되어, 그 녀석은 싸웠다."
    },
    {
     "sid": "da1203:T00048",
     "kind": "본문",
     "jp": "歯を食い縛って涙を堪え、怯える心と震える躰に鞭打って。\n\n\n　そんなみじめな英雄の物語を、お前は",
     "ko": "이를 악물고 눈물을 참으며, 겁에 질린 마음과 떨리는 몸을 채찍질하며.\n\n\n　그런 비참한 영웅의 이야기를, 너는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00005",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00049",
     "kind": "본문",
     "jp": "嘲笑",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00050",
     "kind": "본문",
     "jp": "うだろうか？",
     "ko": "을까?"
    }
   ]
  },
  {
   "uid": "da1203:U00011",
   "speaker": "(지문)",
   "jp": "――想像してもらおう。\n\n\n\n　そんな不様でみじめで格好悪いそいつが背負わされた、\n　英雄の神話を。そいつの目の前に立ちはだかる、無限質量の恐怖と絶望を。",
   "cells": [
    {
     "sid": "da1203:T00051",
     "kind": "본문",
     "jp": "――想像してもらおう。\n\n\n\n　そんな不様でみじめで格好悪いそいつが背負わされた、\n　英雄の神話を。",
     "ko": "――상상해 보아라.\n\n\n\n　그토록 볼썽사납고 비참하고 멋없는 그 녀석이 짊어지게 된,\n　영웅의 신화를."
    },
    {
     "sid": "da1203:T00052",
     "kind": "본문",
     "jp": "そいつの目の前に立ちはだかる、無限質量の恐怖と絶望を。",
     "ko": "그 녀석의 눈앞에 가로막아 선, 무한 질량의 공포와 절망을."
    }
   ]
  },
  {
   "uid": "da1203:U00012",
   "speaker": "(지문)",
   "jp": "奇蹟の連続を絶対条件としてようやく〈わず〉僅かな可能性を見い出せる\n勝利の、さらにその連続を強制させられた〈たたかい〉闘争の日々を。",
   "cells": [
    {
     "sid": "da1203:T00053",
     "kind": "본문",
     "jp": "奇蹟の連続を絶対条件としてようやく",
     "ko": "기적의 연속을 절대 조건으로 삼아서야 겨우 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00006",
     "kind": "루비 읽기",
     "jp": "わず",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00054",
     "kind": "본문",
     "jp": "僅",
     "ko": "실낱",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00055",
     "kind": "본문",
     "jp": "かな可能性を見い出せる\n勝利の、さらにその連続を強制させられた",
     "ko": "같은 가능성을 찾아낼 수 있는\n승리의, 그마저도 연속을 강요당한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00007",
     "kind": "루비 읽기",
     "jp": "たたかい",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00056",
     "kind": "본문",
     "jp": "闘争",
     "ko": "투쟁",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00057",
     "kind": "본문",
     "jp": "の日々を。",
     "ko": "의 나날을."
    }
   ]
  },
  {
   "uid": "da1203:U00013",
   "speaker": "(지문)",
   "jp": "そんな道を選び、歩き出したそいつの決意を。その第一歩を踏むために必要とした、全宇宙の総エネルギーに\n　匹敵する勇気の熱量を。",
   "cells": [
    {
     "sid": "da1203:T00058",
     "kind": "본문",
     "jp": "そんな道を選び、歩き出したそいつの決意を。",
     "ko": "그런 길을 선택하고 걸음을 내디딘 그 녀석의 결의를."
    },
    {
     "sid": "da1203:T00059",
     "kind": "본문",
     "jp": "その第一歩を踏むために必要とした、全宇宙の総エネルギーに\n　匹敵する勇気の熱量を。",
     "ko": "그 첫걸음을 내딛기 위해 필요했던, 전 우주의 총에너지에\n　필적하는 용기의 열량을."
    }
   ]
  },
  {
   "uid": "da1203:U00014",
   "speaker": "(지문)",
   "jp": "そんな英雄を――お前は直視できるだろうか？",
   "cells": [
    {
     "sid": "da1203:T00060",
     "kind": "본문",
     "jp": "そんな英雄を――お前は直視できるだろうか？",
     "ko": "그런 영웅을――너는 직시할 수 있겠는가?"
    }
   ]
  },
  {
   "uid": "da1203:U00015",
   "speaker": "(지문)",
   "jp": "――まただ。",
   "cells": [
    {
     "sid": "da1203:T00061",
     "kind": "본문",
     "jp": "――まただ。",
     "ko": "――또다."
    }
   ]
  },
  {
   "uid": "da1203:U00016",
   "speaker": "ナイア",
   "jp": "「――やあ、また逢ったね」",
   "cells": [
    {
     "sid": "da1203:T00062",
     "kind": "본문",
     "jp": "「――やあ、また逢ったね」",
     "ko": "「――야아, 또 만났네」"
    }
   ]
  },
  {
   "uid": "da1203:U00017",
   "speaker": "(지문)",
   "jp": "――また、この夢。",
   "cells": [
    {
     "sid": "da1203:T00063",
     "kind": "본문",
     "jp": "――また、この夢。",
     "ko": "――또, 이 꿈."
    }
   ]
  },
  {
   "uid": "da1203:U00018",
   "speaker": "ナイア",
   "jp": "「あはっ、そう警戒しなくて良いよ。\n『今の』『この僕』は君たちとやり合う\nつもりはないから。ちょっと寄っただけさ」",
   "cells": [
    {
     "sid": "da1203:T00064",
     "kind": "본문",
     "jp": "「あはっ、そう警戒しなくて良いよ。\n『今の』『この僕』は君たちとやり合う\nつもりはないから。ちょっと寄っただけさ」",
     "ko": "「아핫, 그렇게 경계하지 않아도 돼.\n『지금의』 『이 나』는 너희와 싸울\n생각은 없으니까. 잠깐 들른 것뿐이야」"
    }
   ]
  },
  {
   "uid": "da1203:U00019",
   "speaker": "ナイア",
   "jp": "「ふぅ……やはり君たちと逢うときは、\n　この姿が一番馴染むかな」",
   "cells": [
    {
     "sid": "da1203:T00065",
     "kind": "본문",
     "jp": "「ふぅ……やはり君たちと逢うときは、\n　この姿が一番馴染むかな」",
     "ko": "「후우…… 역시 너희와 만날 때는,\n　이 모습이 제일 잘 어울리려나」"
    }
   ]
  },
  {
   "uid": "da1203:U00020",
   "speaker": "(지문)",
   "jp": "――何だ。",
   "cells": [
    {
     "sid": "da1203:T00066",
     "kind": "본문",
     "jp": "――何だ。",
     "ko": "――뭐지."
    }
   ]
  },
  {
   "uid": "da1203:U00021",
   "speaker": "ナイア",
   "jp": "「それにしても、君たちとは本当に長い付き合いになったものだ……ああ、これは今の君の主観時間に合わせての発言だけど」",
   "cells": [
    {
     "sid": "da1203:T00067",
     "kind": "본문",
     "jp": "「それにしても、君たちとは本当に長い付き合いになったものだ……ああ、これは今の君の主観時間に合わせての発言だけど」",
     "ko": "「그나저나, 너희와는 정말로 긴 인연이 되었군…… 아아, 이건 지금의 네 주관 시간에 맞춰서 하는 말이지만」"
    }
   ]
  },
  {
   "uid": "da1203:U00022",
   "speaker": "ナイア",
   "jp": "「君たちに『昇滅』させられた『僕』は――\nこれで４１４６３３２７６〈ちゅう〉柱だ ……本当に良く\n頑張ってると思うよ。いやいや、嫌味や皮肉\nや余裕じゃない。心の底からそう思ってるさ」",
   "cells": [
    {
     "sid": "da1203:T00068",
     "kind": "본문",
     "jp": "「君たちに『昇滅』させられた『僕』は――\nこれで４１４６３３２７６",
     "ko": "「너희에게 『승멸』당한 『나』는――\n이걸로 414633276",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00008",
     "kind": "루비 읽기",
     "jp": "ちゅう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00069",
     "kind": "본문",
     "jp": "柱",
     "ko": "위",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00070",
     "kind": "본문",
     "jp": "だ ……",
     "ko": "째야 ……"
    },
    {
     "sid": "da1203:T00071",
     "kind": "본문",
     "jp": "本当に良く\n頑張ってると思うよ。いやいや、嫌味や皮肉\nや余裕じゃない。心の底からそう思ってるさ」",
     "ko": " 정말로 잘\n버티고 있다고 생각해. 아니아니, 빈정거림이나 비꼼\n이나 여유가 아니야. 마음속 깊이 그렇게 생각하고 있어」"
    }
   ]
  },
  {
   "uid": "da1203:U00023",
   "speaker": "(지문)",
   "jp": "――何なんだ、この〈イメージ〉記憶は。",
   "cells": [
    {
     "sid": "da1203:T00072",
     "kind": "본문",
     "jp": "――何なんだ、この",
     "ko": "――뭐냐, 이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00009",
     "kind": "루비 읽기",
     "jp": "イメージ",
     "ko": "이미지는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00073",
     "kind": "본문",
     "jp": "記憶",
     "ko": "기억은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00074",
     "kind": "본문",
     "jp": "は。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1203:U00024",
   "speaker": "ナイア",
   "jp": "「……だけど、そろそろ疲れてきたろう？\n　ここらで一息ついた方が良くないかね？」",
   "cells": [
    {
     "sid": "da1203:T00075",
     "kind": "본문",
     "jp": "「……だけど、そろそろ疲れてきたろう？\n　ここらで一息ついた方が良くないかね？」",
     "ko": "「……하지만, 슬슬 지쳐 가지 않아?\n　이쯤에서 한숨 돌리는 편이 좋지 않겠어?」"
    }
   ]
  },
  {
   "uid": "da1203:U00025",
   "speaker": "ナイア",
   "jp": "「おやおや、真面目だね。\n　……まあ良いさ。\n　じゃあ、見守らせてもらうよ」",
   "cells": [
    {
     "sid": "da1203:T00076",
     "kind": "본문",
     "jp": "「おやおや、真面目だね。\n　……まあ良いさ。\n　じゃあ、見守らせてもらうよ」",
     "ko": "「이런이런, 성실하기도 하지.\n　……뭐 좋아.\n　그럼, 지켜보도록 할게」"
    }
   ]
  },
  {
   "uid": "da1203:U00026",
   "speaker": "(지문)",
   "jp": "――貴方は。",
   "cells": [
    {
     "sid": "da1203:T00077",
     "kind": "본문",
     "jp": "――貴方は。",
     "ko": "――당신은."
    }
   ]
  },
  {
   "uid": "da1203:U00027",
   "speaker": "ナイア",
   "jp": "「『魔を断つ剣』を持たない君たちが、\n　何処まで戦えるかを――」",
   "cells": [
    {
     "sid": "da1203:T00078",
     "kind": "본문",
     "jp": "「『魔を断つ剣』を持たない君たちが、\n　何処まで戦えるかを――」",
     "ko": "「『마를 끊는 검』을 갖지 못한 너희가,\n　어디까지 싸울 수 있을지를――」"
    }
   ]
  },
  {
   "uid": "da1203:U00028",
   "speaker": "(지문)",
   "jp": "――この光景を見る、貴方はいったい『何』なんだ？",
   "cells": [
    {
     "sid": "da1203:T00079",
     "kind": "본문",
     "jp": "――この光景を見る、貴方はいったい『何』なんだ？",
     "ko": "――이 광경을 보는 당신은 도대체 『무엇』이지?"
    }
   ]
  },
  {
   "uid": "da1203:U00029",
   "speaker": "九朔",
   "jp": "「あ……っ」",
   "cells": [
    {
     "sid": "da1203:T00080",
     "kind": "본문",
     "jp": "「あ……っ」",
     "ko": "「아…… 읏」"
    }
   ]
  },
  {
   "uid": "da1203:U00030",
   "speaker": "テリオン",
   "jp": "「何故！　余を産み落とした！〈・・・〉母さん！」",
   "cells": [
    {
     "sid": "da1203:T00081",
     "kind": "본문",
     "jp": "「何故！　余を産み落とした！",
     "ko": "「어째서!　짐을 낳았느냐!　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00010",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00082",
     "kind": "본문",
     "jp": "母さん",
     "ko": "어머니",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00083",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1203:U00031",
   "speaker": "ネロ",
   "jp": "「その言葉で呼ぶなァァァァァァァァ！」",
   "cells": [
    {
     "sid": "da1203:T00084",
     "kind": "본문",
     "jp": "「その言葉で呼ぶなァァァァァァァァ！」",
     "ko": "「그 말로 부르지 마아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1203:U00032",
   "speaker": "アナザーブラッド",
   "jp": "「見なさいな、『〈トゥーソード／トゥーガン〉二闘流』。\n　互いを拒絶し、殺し合う親子の姿を」",
   "cells": [
    {
     "sid": "da1203:T00085",
     "kind": "본문",
     "jp": "「見なさいな、『",
     "ko": "「보렴, 『",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00011",
     "kind": "루비 읽기",
     "jp": "トゥーソード／トゥーガン",
     "ko": "투 소드／투 건",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00086",
     "kind": "본문",
     "jp": "二闘流",
     "ko": "이투류",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00087",
     "kind": "본문",
     "jp": "』。\n　互いを拒絶し、殺し合う親子の姿を」",
     "ko": "』.\n　서로를 거부하고, 서로를 죽이는 부모 자식의 모습을」"
    }
   ]
  },
  {
   "uid": "da1203:U00033",
   "speaker": "(지문)",
   "jp": "気付けば我は、紅い羊膜のようなものに包まれていた。\n\n　内部を充たす血の匂い。〈ほの〉仄かに、甘い匂い。",
   "cells": [
    {
     "sid": "da1203:T00088",
     "kind": "본문",
     "jp": "気付けば我は、紅い羊膜のようなものに包まれていた。\n\n　内部を充たす血の匂い。",
     "ko": "정신을 차려 보니 나는 붉은 양막 같은 것에 싸여 있었다.\n\n　내부를 채운 피 냄새.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00012",
     "kind": "루비 읽기",
     "jp": "ほの",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00089",
     "kind": "본문",
     "jp": "仄",
     "ko": "은은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00090",
     "kind": "본문",
     "jp": "かに、甘い匂い。",
     "ko": "하게, 달콤한 냄새."
    }
   ]
  },
  {
   "uid": "da1203:U00034",
   "speaker": "アナザーブラッド",
   "jp": "「酷いよねえ？　勝手に生んでおきながら、邪魔だから殺そうとするなんて」",
   "cells": [
    {
     "sid": "da1203:T00091",
     "kind": "본문",
     "jp": "「酷いよねえ？　勝手に生んでおきながら、邪魔だから殺そうとするなんて」",
     "ko": "「너무하지 않아?　제멋대로 낳아 놓고선, 방해되니까 죽이려 들다니」"
    }
   ]
  },
  {
   "uid": "da1203:U00035",
   "speaker": "(지문)",
   "jp": "「■■■■■■■■■■■■■■■■■」",
   "cells": [
    {
     "sid": "da1203:T00092",
     "kind": "본문",
     "jp": "「■■■■■■■■■■■■■■■■■」",
     "ko": "「■■■■■■■■■■■■■■■■■」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1203:U00036",
   "speaker": "(지문)",
   "jp": "「■■■■■■■■■■■■■■■■■」",
   "cells": [
    {
     "sid": "da1203:T00093",
     "kind": "본문",
     "jp": "「■■■■■■■■■■■■■■■■■」",
     "ko": "「■■■■■■■■■■■■■■■■■」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1203:U00037",
   "speaker": "(지문)",
   "jp": "薄っすらと紅い視界の向こうで、光が２体の鬼械神を呑み込んだ。光の中に砕けてゆく、機体。",
   "cells": [
    {
     "sid": "da1203:T00094",
     "kind": "본문",
     "jp": "薄っすらと紅い視界の向こうで、光が２体の鬼械神を呑み込んだ。",
     "ko": "희미하게 붉은 시야 너머에서, 빛이 두 기의 귀계신을 집어삼켰다."
    },
    {
     "sid": "da1203:T00095",
     "kind": "본문",
     "jp": "光の中に砕けてゆく、機体。",
     "ko": "빛 속으로 부서져 가는 기체."
    }
   ]
  },
  {
   "uid": "da1203:U00038",
   "speaker": "(지문)",
   "jp": "声が嗤う。くすくす、と。甘い匂いが、一層濃くなった気がした。",
   "cells": [
    {
     "sid": "da1203:T00096",
     "kind": "본문",
     "jp": "声が嗤う。",
     "ko": "목소리가 비웃는다."
    },
    {
     "sid": "da1203:T00097",
     "kind": "본문",
     "jp": "くすくす、と。",
     "ko": "쿡쿡, 하고."
    },
    {
     "sid": "da1203:T00098",
     "kind": "본문",
     "jp": "甘い匂いが、一層濃くなった気がした。",
     "ko": "달콤한 냄새가 한층 더 짙어진 기분이 들었다."
    }
   ]
  },
  {
   "uid": "da1203:U00039",
   "speaker": "アナザーブラッド",
   "jp": "「貴方も一緒ね、九朔？」",
   "cells": [
    {
     "sid": "da1203:T00099",
     "kind": "본문",
     "jp": "「貴方も一緒ね、九朔？」",
     "ko": "「당신도 마찬가지네, 쿠자쿠?」"
    }
   ]
  },
  {
   "uid": "da1203:U00040",
   "speaker": "(지문)",
   "jp": "〈ルビー・アイ〉紅い瞳が、俺を覗き込む。アナザーブラッドの瞳。その奥に宿るのは、憐れみか、慈しみか。\n\n　――やめろ。",
   "cells": [
    {
     "sid": "da1203:R00013",
     "kind": "루비 읽기",
     "jp": "ルビー・アイ",
     "ko": "루비 아이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00100",
     "kind": "본문",
     "jp": "紅い瞳",
     "ko": "붉은 눈동자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00101",
     "kind": "본문",
     "jp": "が、俺を覗き込む。",
     "ko": "가 나를 들여다본다."
    },
    {
     "sid": "da1203:T00102",
     "kind": "본문",
     "jp": "アナザーブラッドの瞳。",
     "ko": "어나더 블러드의 눈동자."
    },
    {
     "sid": "da1203:T00103",
     "kind": "본문",
     "jp": "その奥に宿るのは、憐れみか、慈しみか。\n\n　――やめろ。",
     "ko": "그 안쪽에 깃든 것은 연민인가, 자애인가.\n\n　――그만둬라."
    }
   ]
  },
  {
   "uid": "da1203:U00041",
   "speaker": "アナザーブラッド",
   "jp": "「貴方も拒絶された」",
   "cells": [
    {
     "sid": "da1203:T00104",
     "kind": "본문",
     "jp": "「貴方も拒絶された」",
     "ko": "「당신도 거부당했어」"
    }
   ]
  },
  {
   "uid": "da1203:U00042",
   "speaker": "(지문)",
   "jp": "やめろ。やめろ。やめろ。\n\n　全身が、全霊が、拒んでいた。アナザーブラッドが次に告げるだろう言葉を。\n\n　しかし躰は動かない。目を逸らすことも、耳を塞ぐことも出来ない。\n\n　ただその致命的な言葉を、\n　木偶の坊になって、怯えながら待つだけだ。",
   "cells": [
    {
     "sid": "da1203:T00105",
     "kind": "본문",
     "jp": "やめろ。",
     "ko": "그만둬라."
    },
    {
     "sid": "da1203:T00106",
     "kind": "본문",
     "jp": "やめろ。",
     "ko": "그만둬라."
    },
    {
     "sid": "da1203:T00107",
     "kind": "본문",
     "jp": "やめろ。\n\n　全身が、全霊が、拒んでいた。",
     "ko": "그만둬라.\n\n　온몸이, 온 영혼이 거부하고 있었다."
    },
    {
     "sid": "da1203:T00108",
     "kind": "본문",
     "jp": "アナザーブラッドが次に告げるだろう言葉を。\n\n　しかし躰は動かない。",
     "ko": "어나더 블러드가 다음에 고할 말을.\n\n　그러나 몸은 움직이지 않는다."
    },
    {
     "sid": "da1203:T00109",
     "kind": "본문",
     "jp": "目を逸らすことも、耳を塞ぐことも出来ない。\n\n　ただその致命的な言葉を、\n　木偶の坊になって、怯えながら待つだけだ。",
     "ko": "눈을 돌릴 수도, 귀를 막을 수도 없다.\n\n　그저 그 치명적인 말을,\n　목석같은 꼭두각시가 되어 겁에 질린 채 기다릴 뿐이다."
    }
   ]
  },
  {
   "uid": "da1203:U00043",
   "speaker": "アナザーブラッド",
   "jp": "「九朔、貴方は……」",
   "cells": [
    {
     "sid": "da1203:T00110",
     "kind": "본문",
     "jp": "「九朔、貴方は……」",
     "ko": "「쿠자쿠, 당신은……」"
    }
   ]
  },
  {
   "uid": "da1203:U00044",
   "speaker": "九朔",
   "jp": "「……ッ……や、めろ……ッ！」",
   "cells": [
    {
     "sid": "da1203:T00111",
     "kind": "본문",
     "jp": "「……ッ……や、めろ……ッ！」",
     "ko": "「……읏…… 그, 만둬…… 읏!」"
    }
   ]
  },
  {
   "uid": "da1203:U00045",
   "speaker": "(지문)",
   "jp": "恍惚に潤む、紅の瞳。艶然と微笑む。血の匂いは、むせ返るほどに甘く――",
   "cells": [
    {
     "sid": "da1203:T00112",
     "kind": "본문",
     "jp": "恍惚に潤む、紅の瞳。",
     "ko": "황홀하게 젖어 드는 붉은 눈동자."
    },
    {
     "sid": "da1203:T00113",
     "kind": "본문",
     "jp": "艶然と微笑む。",
     "ko": "요염하게 미소 짓는다."
    },
    {
     "sid": "da1203:T00114",
     "kind": "본문",
     "jp": "血の匂いは、むせ返るほどに甘く――",
     "ko": "피 냄새는 숨이 막힐 정도로 달콤하게――"
    }
   ]
  },
  {
   "uid": "da1203:U00046",
   "speaker": "アナザーブラッド",
   "jp": "「貴方は、親に棄てられた」",
   "cells": [
    {
     "sid": "da1203:T00115",
     "kind": "본문",
     "jp": "「貴方は、親に棄てられた」",
     "ko": "「당신은, 부모에게 버림받았어」"
    }
   ]
  },
  {
   "uid": "da1203:U00047",
   "speaker": "(지문)",
   "jp": "その瞬間、心が折れた。死守しなければならなかった領域が、音を立てて崩れてゆく。\n\n　アナザーブラッドの、嗜虐の〈ヨロコビ〉愉悦に満ち満ちた声が続く。",
   "cells": [
    {
     "sid": "da1203:T00116",
     "kind": "본문",
     "jp": "その瞬間、心が折れた。",
     "ko": "그 순간, 마음이 꺾였다."
    },
    {
     "sid": "da1203:T00117",
     "kind": "본문",
     "jp": "死守しなければならなかった領域が、音を立てて崩れてゆく。\n\n　アナザーブラッドの、嗜虐の",
     "ko": "사수해야만 했던 영역이 소리를 내며 무너져 간다.\n\n　어나더 블러드의, 가학의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00014",
     "kind": "루비 읽기",
     "jp": "ヨロコビ",
     "ko": "기쁨",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00118",
     "kind": "본문",
     "jp": "愉悦",
     "ko": "유열",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00119",
     "kind": "본문",
     "jp": "に満ち満ちた声が続く。",
     "ko": "에 가득 찬 목소리가 이어진다."
    }
   ]
  },
  {
   "uid": "da1203:U00048",
   "speaker": "アナザーブラッド",
   "jp": "「マスターテリオンの言う通りね。\n　いくら騎士道を志したところで、\n　貴方の心は救われない」",
   "cells": [
    {
     "sid": "da1203:T00120",
     "kind": "본문",
     "jp": "「マスターテリオンの言う通りね。\n　いくら騎士道を志したところで、\n　貴方の心は救われない」",
     "ko": "「마스터 테리온의 말대로네.\n　아무리 기사도에 뜻을 두어 봤자,\n　당신의 마음은 구원받지 못해」"
    }
   ]
  },
  {
   "uid": "da1203:U00049",
   "speaker": "九朔",
   "jp": "「やめろ……やめてくれ……」",
   "cells": [
    {
     "sid": "da1203:T00121",
     "kind": "본문",
     "jp": "「やめろ……やめてくれ……」",
     "ko": "「그만둬…… 그만둬 줘……」"
    }
   ]
  },
  {
   "uid": "da1203:U00050",
   "speaker": "アナザーブラッド",
   "jp": "「〈まも〉守護りたいのは〈まも〉庇護られたことがないから。愛されないから、愛することで充たそうとするのよね？　健気だわ、九朔」",
   "cells": [
    {
     "sid": "da1203:T00122",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1203:R00015",
     "kind": "루비 읽기",
     "jp": "まも",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00123",
     "kind": "본문",
     "jp": "守護",
     "ko": "수호하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00124",
     "kind": "본문",
     "jp": "りたいのは",
     "ko": "고 싶은 건 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00016",
     "kind": "루비 읽기",
     "jp": "まも",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00125",
     "kind": "본문",
     "jp": "庇護",
     "ko": "비호받",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00126",
     "kind": "본문",
     "jp": "られたことがないから。愛されないから、愛することで充たそうとするのよね？　健気だわ、九朔」",
     "ko": "은 적이 없기 때문이야. 사랑받지 못하니까, 사랑하는 것으로 채우려 하는 거지?　갸륵하기도 해라, 쿠자쿠」"
    }
   ]
  },
  {
   "uid": "da1203:U00051",
   "speaker": "九朔",
   "jp": "「あ……あああ……ッ」",
   "cells": [
    {
     "sid": "da1203:T00127",
     "kind": "본문",
     "jp": "「あ……あああ……ッ」",
     "ko": "「아…… 아아아…… 읏」"
    }
   ]
  },
  {
   "uid": "da1203:U00052",
   "speaker": "アナザーブラッド",
   "jp": "「でもね、無駄よ、無駄。貴方は否定されたの。その事実は変わらない。覆しようがない。貴方の一番求めているものは、決して与えられるものではないの」",
   "cells": [
    {
     "sid": "da1203:T00128",
     "kind": "본문",
     "jp": "「でもね、無駄よ、無駄。貴方は否定されたの。その事実は変わらない。覆しようがない。貴方の一番求めているものは、決して与えられるものではないの」",
     "ko": "「하지만 말이지, 소용없어, 소용없다고. 당신은 부정당한 거야. 그 사실은 변하지 않아. 뒤집을 방도가 없어. 당신이 가장 바라는 것은, 결코 주어지지 않는 거야」"
    }
   ]
  },
  {
   "uid": "da1203:U00053",
   "speaker": "九朔",
   "jp": "「うわあああああああああああ！」",
   "cells": [
    {
     "sid": "da1203:T00129",
     "kind": "본문",
     "jp": "「うわあああああああああああ！」",
     "ko": "「우와아아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1203:U00054",
   "speaker": "(지문)",
   "jp": "目の前のアナザーブラッドに向けて、銃を乱射する。\n\n　少女の〈かたち〉容が、血の霧になって宙に融ける。全身が重くなった。まとわりつく血の霧。",
   "cells": [
    {
     "sid": "da1203:T00130",
     "kind": "본문",
     "jp": "目の前のアナザーブラッドに向けて、銃を乱射する。\n\n　少女の",
     "ko": "눈앞의 어나더 블러드를 향해 총을 난사한다.\n\n　소녀의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00017",
     "kind": "루비 읽기",
     "jp": "かたち",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00131",
     "kind": "본문",
     "jp": "容",
     "ko": "형상",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00132",
     "kind": "본문",
     "jp": "が、血の霧になって宙に融ける。",
     "ko": "이 피안개가 되어 허공에 녹아든다."
    },
    {
     "sid": "da1203:T00133",
     "kind": "본문",
     "jp": "全身が重くなった。",
     "ko": "온몸이 무거워졌다."
    },
    {
     "sid": "da1203:T00134",
     "kind": "본문",
     "jp": "まとわりつく血の霧。",
     "ko": "휘감겨 오는 피안개."
    }
   ]
  },
  {
   "uid": "da1203:U00055",
   "speaker": "(지문)",
   "jp": "細い指が、頬に触れた。再び実体化したアナザーブラッドが、背後から我を抱き締めている。",
   "cells": [
    {
     "sid": "da1203:T00135",
     "kind": "본문",
     "jp": "細い指が、頬に触れた。",
     "ko": "가느다란 손가락이 뺨에 닿았다."
    },
    {
     "sid": "da1203:T00136",
     "kind": "본문",
     "jp": "再び実体化したアナザーブラッドが、背後から我を抱き締めている。",
     "ko": "다시 실체화한 어나더 블러드가 등 뒤에서 나를 껴안고 있다."
    }
   ]
  },
  {
   "uid": "da1203:U00056",
   "speaker": "アナザーブラッド",
   "jp": "「不様ね……\n　とても不様よ、小さな騎士殿？」",
   "cells": [
    {
     "sid": "da1203:T00137",
     "kind": "본문",
     "jp": "「不様ね……\n　とても不様よ、小さな騎士殿？」",
     "ko": "「볼썽사납네……\n　아주 볼썽사나워요, 작은 기사님?」"
    }
   ]
  },
  {
   "uid": "da1203:U00057",
   "speaker": "(지문)",
   "jp": "指が、唇をなぞり",
   "cells": [
    {
     "sid": "da1203:T00138",
     "kind": "본문",
     "jp": "指が、唇をなぞり",
     "ko": "손가락이 입술을 덧그리고"
    }
   ]
  },
  {
   "uid": "da1203:U00058",
   "speaker": "アナザーブラッド",
   "jp": "「……何が違うの？」",
   "cells": [
    {
     "sid": "da1203:T00139",
     "kind": "본문",
     "jp": "「……何が違うの？」",
     "ko": "「……무엇이 다르다는 거야?」"
    }
   ]
  },
  {
   "uid": "da1203:U00059",
   "speaker": "(지문)",
   "jp": "首筋を舌が這う。",
   "cells": [
    {
     "sid": "da1203:T00140",
     "kind": "본문",
     "jp": "首筋を舌が這う。",
     "ko": "목덜미를 혀가 기어간다."
    }
   ]
  },
  {
   "uid": "da1203:U00060",
   "speaker": "アナザーブラッド",
   "jp": "「貴方と私、何が違うと言うの？\n貴方だって私と同じ……必要とされて\nいない、無価値な〈モノ〉存在じゃない……\nそうでしょう、九朔？」",
   "cells": [
    {
     "sid": "da1203:T00141",
     "kind": "본문",
     "jp": "「貴方と私、何が違うと言うの？\n貴方だって私と同じ……必要とされて\nいない、無価値な",
     "ko": "「당신과 나, 무엇이 다르다는 거야?\n당신도 나와 똑같이…… 누구도 필요로 하지\n않는, 무가치한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00018",
     "kind": "루비 읽기",
     "jp": "モノ",
     "ko": "것",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00142",
     "kind": "본문",
     "jp": "存在",
     "ko": "존재",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00143",
     "kind": "본문",
     "jp": "じゃない……\nそうでしょう、九朔？」",
     "ko": "이잖아……\n그렇지, 쿠자쿠?」"
    }
   ]
  },
  {
   "uid": "da1203:U00061",
   "speaker": "(지문)",
   "jp": "唇が押しつけられる。不意に鋭い痛み。犬歯を突き立てられる。\n\n　首筋を伝う血。生温かい。",
   "cells": [
    {
     "sid": "da1203:T00144",
     "kind": "본문",
     "jp": "唇が押しつけられる。",
     "ko": "입술이 눌려 온다."
    },
    {
     "sid": "da1203:T00145",
     "kind": "본문",
     "jp": "不意に鋭い痛み。",
     "ko": "불현듯 날카로운 아픔."
    },
    {
     "sid": "da1203:T00146",
     "kind": "본문",
     "jp": "犬歯を突き立てられる。\n\n　首筋を伝う血。",
     "ko": "송곳니가 박힌다.\n\n　목덜미를 타고 흐르는 피."
    },
    {
     "sid": "da1203:T00147",
     "kind": "본문",
     "jp": "生温かい。",
     "ko": "미지근하다."
    }
   ]
  },
  {
   "uid": "da1203:U00062",
   "speaker": "アナザーブラッド",
   "jp": "「ん……ちゅ……っ……ふふ」",
   "cells": [
    {
     "sid": "da1203:T00148",
     "kind": "본문",
     "jp": "「ん……ちゅ……っ……ふふ」",
     "ko": "「응…… 츄…… 읏…… 후후」"
    }
   ]
  },
  {
   "uid": "da1203:U00063",
   "speaker": "(지문)",
   "jp": "流れる血を丹念に舐め取る、アナザーブラッドの舌。酷く、熱い。",
   "cells": [
    {
     "sid": "da1203:T00149",
     "kind": "본문",
     "jp": "流れる血を丹念に舐め取る、アナザーブラッドの舌。",
     "ko": "흐르는 피를 정성스레 핥아 내는 어나더 블러드의 혀."
    },
    {
     "sid": "da1203:T00150",
     "kind": "본문",
     "jp": "酷く、熱い。",
     "ko": "지독히, 뜨겁다."
    }
   ]
  },
  {
   "uid": "da1203:U00064",
   "speaker": "アナザーブラッド",
   "jp": "「享け入れなさい、九朔。\n　貴方に与えられた呪いを。\n　忌まれて、生まれたという呪いを」",
   "cells": [
    {
     "sid": "da1203:T00151",
     "kind": "본문",
     "jp": "「享け入れなさい、九朔。\n　貴方に与えられた呪いを。\n　忌まれて、生まれたという呪いを」",
     "ko": "「받아들이렴, 쿠자쿠.\n　당신에게 주어진 저주를.\n　미움받으며 태어났다는 저주를」"
    }
   ]
  },
  {
   "uid": "da1203:U00065",
   "speaker": "(지문)",
   "jp": "崩壊した領域に何かが流れ込む。熱く、黒く、ドロドロと煮えたぎる何かが。〈ウツロ〉空虚になった心を充たす。",
   "cells": [
    {
     "sid": "da1203:T00152",
     "kind": "본문",
     "jp": "崩壊した領域に何かが流れ込む。",
     "ko": "붕괴한 영역에 무언가가 흘러들어온다."
    },
    {
     "sid": "da1203:T00153",
     "kind": "본문",
     "jp": "熱く、黒く、ドロドロと煮えたぎる何かが。",
     "ko": "뜨겁고, 검고, 걸쭉하게 들끓는 무언가가.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1203:R00019",
     "kind": "루비 읽기",
     "jp": "ウツロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1203:T00154",
     "kind": "본문",
     "jp": "空虚",
     "ko": "공허",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1203:T00155",
     "kind": "본문",
     "jp": "になった心を充たす。",
     "ko": "해진 마음을 채운다."
    }
   ]
  },
  {
   "uid": "da1203:U00066",
   "speaker": "アナザーブラッド",
   "jp": "「そして、赦しなさい。貴方の心の奥で熟成された、芳醇な憎悪を。剣を失い、鎧を剥がされて、貴方はようやく自由になれる……」",
   "cells": [
    {
     "sid": "da1203:T00156",
     "kind": "본문",
     "jp": "「そして、赦しなさい。貴方の心の奥で熟成された、芳醇な憎悪を。剣を失い、鎧を剥がされて、貴方はようやく自由になれる……」",
     "ko": "「그리고 풀어놓으렴. 당신의 마음 깊은 곳에서 숙성된, 방순한 증오를. 검을 잃고, 갑옷이 벗겨져야만, 당신은 비로소 자유로워질 수 있어……」"
    }
   ]
  },
  {
   "uid": "da1203:U00067",
   "speaker": "(지문)",
   "jp": "２体の機神を呑み込んだ光。その向こうに、別の影がある。",
   "cells": [
    {
     "sid": "da1203:T00157",
     "kind": "본문",
     "jp": "２体の機神を呑み込んだ光。",
     "ko": "두 기의 기신을 집어삼킨 빛."
    },
    {
     "sid": "da1203:T00158",
     "kind": "본문",
     "jp": "その向こうに、別の影がある。",
     "ko": "그 너머에 다른 그림자가 있다."
    }
   ]
  },
  {
   "uid": "da1203:U00068",
   "speaker": "(지문)",
   "jp": "――デモンベイン。",
   "cells": [
    {
     "sid": "da1203:T00159",
     "kind": "본문",
     "jp": "――デモンベイン。",
     "ko": "――데몬베인."
    }
   ]
  },
  {
   "uid": "da1203:U00069",
   "speaker": "(지문)",
   "jp": "その姿を認めたとき、最後の領域が砕け散った。闇黒が、我を塗り潰す。",
   "cells": [
    {
     "sid": "da1203:T00160",
     "kind": "본문",
     "jp": "その姿を認めたとき、最後の領域が砕け散った。",
     "ko": "그 모습을 확인했을 때, 마지막 영역이 산산이 부서졌다."
    },
    {
     "sid": "da1203:T00161",
     "kind": "본문",
     "jp": "闇黒が、我を塗り潰す。",
     "ko": "암흑이 나를 뒤덮는다."
    }
   ]
  },
  {
   "uid": "da1203:U00070",
   "speaker": "アナザーブラッド",
   "jp": "「あははははははははは！\n　そうよ、それで良いのよ、九朔！\n　さあ、怨嗟と共に歌いなさい！」",
   "cells": [
    {
     "sid": "da1203:T00162",
     "kind": "본문",
     "jp": "「あははははははははは！\n　そうよ、それで良いのよ、九朔！\n　さあ、怨嗟と共に歌いなさい！」",
     "ko": "「아하하하하하하하하하!\n　그래, 그거면 돼, 쿠자쿠!\n　자, 원망과 함께 노래하렴!」"
    }
   ]
  }
 ]
