     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1312:R00027",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・",
     "ko": "・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1312:T00092",
     "kind": "본문",
     "jp": "まだやってねえこと",
     "ko": "아직 하지도 않은 일",
