     "jp": "証明",
     "ko": "증명",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00070",
     "kind": "본문",
     "jp": "。\n\n　\n　\n　\n　\n　　　　　　　それは、",
     "ko": ".\n\n　\n　\n　\n　\n　　　　　　　그것은,"
    },
    {
