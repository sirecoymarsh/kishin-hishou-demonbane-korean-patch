{
 "packet": "P0101_da1302",
 "units": [
  {
   "uid": "da1302:U00001",
   "speaker": "(지문)",
   "jp": "それもまた、一つの選択だった。彼女にとっては罪深く。彼にとっては誇らしく。だがそれは、誰にとっても、気高く。美しく。",
   "cells": [
    {
     "sid": "da1302:T00001",
     "kind": "본문",
     "jp": "それもまた、一つの選択だった。",
     "ko": "그것 또한 하나의 선택이었다."
    },
    {
     "sid": "da1302:T00002",
     "kind": "본문",
     "jp": "彼女にとっては罪深く。",
     "ko": "그녀에게는 죄스럽고."
    },
    {
     "sid": "da1302:T00003",
     "kind": "본문",
     "jp": "彼にとっては誇らしく。",
     "ko": "그에게는 자랑스럽고."
    },
    {
     "sid": "da1302:T00004",
     "kind": "본문",
     "jp": "だがそれは、",
     "ko": "하지만 그것은,"
    },
    {
     "sid": "da1302:T00005",
     "kind": "본문",
     "jp": "誰にとっても、",
     "ko": " 누구에게나,"
    },
    {
     "sid": "da1302:T00006",
     "kind": "본문",
     "jp": "気高く。",
     "ko": " 고결하고."
    },
    {
     "sid": "da1302:T00007",
     "kind": "본문",
     "jp": "美しく。",
     "ko": " 아름답게."
    }
   ]
  },
  {
   "uid": "da1302:U00002",
   "speaker": "(지문)",
   "jp": "ひとつの神話が生まれ、ふたりの日常が失われた。そんな選択。そんな選択の先に待つ、未来――――――",
   "cells": [
    {
     "sid": "da1302:T00008",
     "kind": "본문",
     "jp": "ひとつの神話が生まれ、ふたりの日常が失われた。",
     "ko": "하나의 신화가 태어나고, 두 사람의 일상이 상실되었다."
    },
    {
     "sid": "da1302:T00009",
     "kind": "본문",
     "jp": "そんな選択。",
     "ko": "그런 선택."
    },
    {
     "sid": "da1302:T00010",
     "kind": "본문",
     "jp": "そんな選択の先に待つ、未来――――――",
     "ko": "그런 선택의 끝에 기다리는 미래――――――"
    }
   ]
  },
  {
   "uid": "da1302:U00003",
   "speaker": "ネス",
   "jp": "「おいおい、\n　何が起こってるんだ……！？」",
   "cells": [
    {
     "sid": "da1302:T00011",
     "kind": "본문",
     "jp": "「おいおい、\n　何が起こってるんだ……！？」",
     "ko": "「어이어이,\n　무슨 일이 벌어지고 있는 거야……!?」"
    }
   ]
  },
  {
   "uid": "da1302:U00004",
   "speaker": "ストーン",
   "jp": "「市民の避難を！\n　早く……うわあああああッ！？」",
   "cells": [
    {
     "sid": "da1302:T00012",
     "kind": "본문",
     "jp": "「市民の避難を！\n　早く……うわあああああッ！？」",
     "ko": "「시민 대피를!\n　빨리…… 우와아아아아앗!?」"
    }
   ]
  },
  {
   "uid": "da1302:U00005",
   "speaker": "ソーニャ",
   "jp": "「大変です、お嬢様ぁ！」",
   "cells": [
    {
     "sid": "da1302:T00013",
     "kind": "본문",
     "jp": "「大変です、お嬢様ぁ！」",
     "ko": "「큰일이에요, 아가씨이!」"
    }
   ]
  },
  {
   "uid": "da1302:U00006",
   "speaker": "マコト",
   "jp": "「――大規模な〈アザトース〉字祷子振動\n　を観測しました！」",
   "cells": [
    {
     "sid": "da1302:T00014",
     "kind": "본문",
     "jp": "「――大規模な",
     "ko": "「――대규모 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00001",
     "kind": "루비 읽기",
     "jp": "アザトース",
     "ko": "아자토스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00015",
     "kind": "본문",
     "jp": "字祷子",
     "ko": "자도자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00016",
     "kind": "본문",
     "jp": "振動\n　を観測しました！」",
     "ko": " 진동\n　을 관측했습니다!」"
    }
   ]
  },
  {
   "uid": "da1302:U00007",
   "speaker": "チアキ",
   "jp": "「恐らくは巨大質量の〈マテリアライズ〉顕現化……」",
   "cells": [
    {
     "sid": "da1302:T00017",
     "kind": "본문",
     "jp": "「恐らくは巨大質量の",
     "ko": "「아마도 거대 질량의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00002",
     "kind": "루비 읽기",
     "jp": "マテリアライズ",
     "ko": "머티리얼라이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00018",
     "kind": "본문",
     "jp": "顕現化",
     "ko": "현현화",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00019",
     "kind": "본문",
     "jp": "……」",
     "ko": "……」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1302:U00008",
   "speaker": "瑠璃",
   "jp": "「……ッ！まさか！」",
   "cells": [
    {
     "sid": "da1302:T00020",
     "kind": "본문",
     "jp": "「……ッ！",
     "ko": "「……읏!"
    },
    {
     "sid": "da1302:T00021",
     "kind": "본문",
     "jp": "まさか！」",
     "ko": "설마!」"
    }
   ]
  },
  {
   "uid": "da1302:U00009",
   "speaker": "ウィンフィールド",
   "jp": "「お嬢様ッ！」",
   "cells": [
    {
     "sid": "da1302:T00022",
     "kind": "본문",
     "jp": "「お嬢様ッ！」",
     "ko": "「아가씨!」"
    }
   ]
  },
  {
   "uid": "da1302:U00010",
   "speaker": "瑠璃",
   "jp": "「ついて来て、ウィンフィールド！」",
   "cells": [
    {
     "sid": "da1302:T00023",
     "kind": "본문",
     "jp": "「ついて来て、ウィンフィールド！」",
     "ko": "「따라와요, 윈필드!」"
    }
   ]
  },
  {
   "uid": "da1302:U00011",
   "speaker": "ライカ",
   "jp": "「間違いない……あれは……〈・・・・・〉あの機体は……！」",
   "cells": [
    {
     "sid": "da1302:T00024",
     "kind": "본문",
     "jp": "「間違いない……あれは……",
     "ko": "「틀림없어…… 저건……\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00003",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00025",
     "kind": "본문",
     "jp": "あの機体は",
     "ko": "저 기체는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00026",
     "kind": "본문",
     "jp": "……！」",
     "ko": "……!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1302:U00012",
   "speaker": "瑠璃",
   "jp": "「デモンベイン！」",
   "cells": [
    {
     "sid": "da1302:T00027",
     "kind": "본문",
     "jp": "「デモンベイン！」",
     "ko": "「데몬베인!」"
    }
   ]
  },
  {
   "uid": "da1302:U00013",
   "speaker": "(지문)",
   "jp": "かつて大きな戦いがあった。それは無限に続く、螺旋の地獄。\n\n　かつてそれを撃ち破った者がいた。歪んだ世界は是正され、時間は未来へと動き始めた。\n\n　あの戦いを、憶えているものなどいない。彼と彼女も、正しいこの世界には存在しない。総ては因果の果ての出来事なのだ。\n\n　だけど……",
   "cells": [
    {
     "sid": "da1302:T00028",
     "kind": "본문",
     "jp": "かつて大きな戦いがあった。",
     "ko": "일찍이 큰 싸움이 있었다."
    },
    {
     "sid": "da1302:T00029",
     "kind": "본문",
     "jp": "それは無限に続く、螺旋の地獄。\n\n　かつてそれを撃ち破った者がいた。",
     "ko": "그것은 무한히 이어지는 나선의 지옥.\n\n　일찍이 그것을 깨뜨린 자가 있었다."
    },
    {
     "sid": "da1302:T00030",
     "kind": "본문",
     "jp": "歪んだ世界は是正され、時間は未来へと動き始めた。\n\n　あの戦いを、憶えているものなどいない。",
     "ko": "뒤틀린 세계는 시정되고, 시간은 미래를 향해 움직이기 시작했다.\n\n　그 싸움을 기억하고 있는 자 따위는 없다."
    },
    {
     "sid": "da1302:T00031",
     "kind": "본문",
     "jp": "彼と彼女も、正しいこの世界には存在しない。",
     "ko": "그와 그녀도, 올바른 이 세계에는 존재하지 않는다."
    },
    {
     "sid": "da1302:T00032",
     "kind": "본문",
     "jp": "総ては因果の果ての出来事なのだ。\n\n　だけど……",
     "ko": "모든 것은 인과의 끝에 일어난 일이다.\n\n　하지만……"
    }
   ]
  },
  {
   "uid": "da1302:U00014",
   "speaker": "瑠璃",
   "jp": "「大十字さん！　アル・アジフ！」",
   "cells": [
    {
     "sid": "da1302:T00033",
     "kind": "본문",
     "jp": "「大十字さん！　アル・アジフ！」",
     "ko": "「다이쥬지 씨!　알 아지프!」"
    }
   ]
  },
  {
   "uid": "da1302:U00015",
   "speaker": "瑠璃",
   "jp": "「えっ……？」",
   "cells": [
    {
     "sid": "da1302:T00034",
     "kind": "본문",
     "jp": "「えっ……？」",
     "ko": "「어……?」"
    }
   ]
  },
  {
   "uid": "da1302:U00016",
   "speaker": "(지문)",
   "jp": "――其処は、〈ゆりかご〉揺籃だった。\n\n　鋼鉄の〈コクピット〉操縦室を満たす羊膜の籠。小さな生命を、柔らかく包み込む。温かな海のように。",
   "cells": [
    {
     "sid": "da1302:T00035",
     "kind": "본문",
     "jp": "――其処は、",
     "ko": "――그곳은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00004",
     "kind": "루비 읽기",
     "jp": "ゆりかご",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00036",
     "kind": "본문",
     "jp": "揺籃",
     "ko": "요람",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00037",
     "kind": "본문",
     "jp": "だった。\n\n　鋼鉄の",
     "ko": "이었다.\n\n　강철의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00005",
     "kind": "루비 읽기",
     "jp": "コクピット",
     "ko": "콕핏",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00038",
     "kind": "본문",
     "jp": "操縦室",
     "ko": "조종실",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00039",
     "kind": "본문",
     "jp": "を満たす羊膜の籠。",
     "ko": "을 채운 양막의 바구니."
    },
    {
     "sid": "da1302:T00040",
     "kind": "본문",
     "jp": "小さな生命を、柔らかく包み込む。",
     "ko": "작은 생명을 부드럽게 감싼다."
    },
    {
     "sid": "da1302:T00041",
     "kind": "본문",
     "jp": "温かな海のように。",
     "ko": "따스한 바다처럼."
    }
   ]
  },
  {
   "uid": "da1302:U00017",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り」",
   "cells": [
    {
     "sid": "da1302:T00042",
     "kind": "본문",
     "jp": "「てけり・り」",
     "ko": "「테케리・리」"
    }
   ]
  },
  {
   "uid": "da1302:U00018",
   "speaker": "瑠璃",
   "jp": "「……ダンセイニ？」",
   "cells": [
    {
     "sid": "da1302:T00043",
     "kind": "본문",
     "jp": "「……ダンセイニ？」",
     "ko": "「……던세이니?」"
    }
   ]
  },
  {
   "uid": "da1302:U00019",
   "speaker": "瑠璃",
   "jp": "「どうして……\n　何があったの、ダンセイニ？」",
   "cells": [
    {
     "sid": "da1302:T00044",
     "kind": "본문",
     "jp": "「どうして……\n　何があったの、ダンセイニ？」",
     "ko": "「어째서……\n　무슨 일이 있었던 거니, 던세이니?」"
    }
   ]
  },
  {
   "uid": "da1302:U00020",
   "speaker": "ウィンフィールド",
   "jp": "「お嬢様……中に」",
   "cells": [
    {
     "sid": "da1302:T00045",
     "kind": "본문",
     "jp": "「お嬢様……中に」",
     "ko": "「아가씨…… 안에」"
    }
   ]
  },
  {
   "uid": "da1302:U00021",
   "speaker": "瑠璃",
   "jp": "「え……？」",
   "cells": [
    {
     "sid": "da1302:T00046",
     "kind": "본문",
     "jp": "「え……？」",
     "ko": "「어……?」"
    }
   ]
  },
  {
   "uid": "da1302:U00022",
   "speaker": "(지문)",
   "jp": "護っていた。不浄な種族の〈すえ〉裔であるその存在は、自らの内に抱いた\n　小さな鼓動をひたむきに護っていた。\n\n　それが偉大な神に与えられた崇高な使命であるかのように……否、それは違う。\n\n　それはきっと聖約だ。大切な人たちとの、大切な〈やくそく〉聖約だ。信頼と友情で結ばれた、血の通った、本物の絆だ。\n\n　絆を心に宿し、生命を護るものを、どうして不浄と呼べるだろうか？闇より生じた〈もの〉存在総てが、穢れているとは限らない。呪われた〈もの〉存在総てが、魂の気高さを知らぬわけでもない。",
   "cells": [
    {
     "sid": "da1302:T00047",
     "kind": "본문",
     "jp": "護っていた。",
     "ko": "지키고 있었다."
    },
    {
     "sid": "da1302:T00048",
     "kind": "본문",
     "jp": "不浄な種族の",
     "ko": "부정한 종족의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00006",
     "kind": "루비 읽기",
     "jp": "すえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00049",
     "kind": "본문",
     "jp": "裔",
     "ko": "후예",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00050",
     "kind": "본문",
     "jp": "であるその存在は、自らの内に抱いた\n　小さな鼓動をひたむきに護っていた。\n\n　それが偉大な神に与えられた崇高な使命であるかのように……",
     "ko": "인 그 존재는, 자신의 품 안에 안은\n　작은 고동을 한결같이 지키고 있었다.\n\n　그것이 위대한 신에게 부여받은 숭고한 사명이라도 되는 것처럼……"
    },
    {
     "sid": "da1302:T00051",
     "kind": "본문",
     "jp": "否、それは違う。\n\n　それはきっと聖約だ。",
     "ko": "아니, 그것은 아니다.\n\n　그것은 분명 성약이다."
    },
    {
     "sid": "da1302:T00052",
     "kind": "본문",
     "jp": "大切な人たちとの、大切な",
     "ko": "소중한 사람들과의, 소중한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00007",
     "kind": "루비 읽기",
     "jp": "やくそく",
     "ko": "약속",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00053",
     "kind": "본문",
     "jp": "聖約",
     "ko": "성약",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1302:T00054",
     "kind": "본문",
     "jp": "だ。",
     "ko": "이다."
    },
    {
     "sid": "da1302:T00055",
     "kind": "본문",
     "jp": "信頼と友情で結ばれた、血の通った、本物の絆だ。\n\n　絆を心に宿し、生命を護るものを、どうして不浄と呼べるだろうか？",
     "ko": "신뢰와 우정으로 맺어진, 피가 통하는 진정한 유대다.\n\n　유대를 마음에 품고 생명을 지키는 자를, 어찌 부정하다고 부를 수 있으랴?"
    },
    {
     "sid": "da1302:T00056",
     "kind": "본문",
     "jp": "闇より生じた",
     "ko": "어둠에서 생겨난 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1302:R00008",
     "kind": "루비 읽기",
     "jp": "もの",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1302:T00057",
     "kind": "본문",
     "jp": "存在",
     "ko": "존재",
