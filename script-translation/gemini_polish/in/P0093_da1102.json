{
 "packet": "P0093_da1102",
 "units": [
  {
   "uid": "da1102:U00001",
   "speaker": "(지문)",
   "jp": "アンチクロスを撃破して先を進む、三体の鬼械神。その終着点は『夢幻心母』の中心、心臓の間だ。\n\n　かつて『Ｃ計画』の中枢ユニットとして機能していた、\n　神の心臓である。",
   "cells": [
    {
     "sid": "da1102:T00001",
     "kind": "본문",
     "jp": "アンチクロスを撃破して先を進む、三体の鬼械神。",
     "ko": "안티크로스를 격파하고 앞으로 나아가는 세 기의 귀계신."
    },
    {
     "sid": "da1102:T00002",
     "kind": "본문",
     "jp": "その終着点は『夢幻心母』の中心、心臓の間だ。\n\n　かつて『Ｃ計画』の中枢ユニットとして機能していた、\n　神の心臓である。",
     "ko": "그 종착점은 『몽환심모』의 중심, 심장의 방이다.\n\n　일찍이 『C 계획』의 중추 유닛으로 기능했던,\n　신의 심장이다."
    }
   ]
  },
  {
   "uid": "da1102:U00002",
   "speaker": "(지문)",
   "jp": "爆音のような鼓動の中、リベル・レギスは静かに待つ。宿敵――デモンベインの到来を。",
   "cells": [
    {
     "sid": "da1102:T00003",
     "kind": "본문",
     "jp": "爆音のような鼓動の中、リベル・レギスは静かに待つ。",
     "ko": "굉음 같은 고동 속에서, 리베르 레기스는 조용히 기다린다."
    },
    {
     "sid": "da1102:T00004",
     "kind": "본문",
     "jp": "宿敵――デモンベインの到来を。",
     "ko": "숙적――데몬베인의 도래를."
    }
   ]
  },
  {
   "uid": "da1102:U00003",
   "speaker": "テリオン",
   "jp": "「……足りぬ」",
   "cells": [
    {
     "sid": "da1102:T00005",
     "kind": "본문",
     "jp": "「……足りぬ」",
     "ko": "「……부족하군」"
    }
   ]
  },
  {
   "uid": "da1102:U00004",
   "speaker": "(지문)",
   "jp": "呟きは、自然と零れ落ちた。身を灼く焦燥と、心を穿つ虚無。\n\n　\n　\n　　　　　　　　　　　　　　　――足りない。\n\n　切実な喪失感。迎え撃つ自分に、致命的に欠けているものがある。\n\n　最強最悪の『獣』――邪神の血を色濃く引き、\n　己もまた限りなく神に近い領域に立つ魔人は識る。論理ではなく、真理として。\n\n　――今の自分では、デモンベインに決して勝てない。\n\n　今の自分に欠けているもの。それが何かが解からない。\n\n　それを満たさねば、『魔を断つ剣』と刃を交える権利すら無いのだ。あの三位一体を為す最強の剣と――",
   "cells": [
    {
     "sid": "da1102:T00006",
     "kind": "본문",
     "jp": "呟きは、自然と零れ落ちた。",
     "ko": "중얼거림은 자연스레 흘러나왔다."
    },
    {
     "sid": "da1102:T00007",
     "kind": "본문",
     "jp": "身を灼く焦燥と、心を穿つ虚無。\n\n　\n　\n　　　　　　　　　　　　　　　――足りない。\n\n　切実な喪失感。",
     "ko": "몸을 태우는 초조함과, 마음을 꿰뚫는 허무.\n\n　\n　\n　　　　　　　　　　　　　　　　　――부족하다.\n\n　절실한 상실감."
    },
    {
     "sid": "da1102:T00008",
     "kind": "본문",
     "jp": "迎え撃つ自分に、致命的に欠けているものがある。\n\n　最強最悪の『獣』――邪神の血を色濃く引き、\n　己もまた限りなく神に近い領域に立つ魔人は識る。",
     "ko": "맞아 싸우는 자신에게 치명적으로 결여된 것이 있다.\n\n　최강최악의 『짐승』――사신의 피를 짙게 이어받아,\n　자신 또한 한없이 신에 가까운 영역에 선 마인은 안다."
    },
    {
     "sid": "da1102:T00009",
     "kind": "본문",
     "jp": "論理ではなく、真理として。\n\n　――今の自分では、デモンベインに決して勝てない。\n\n　今の自分に欠けているもの。",
     "ko": "논리가 아니라 진리로서.\n\n　――지금의 자신으로는 데몬베인을 결코 이길 수 없다.\n\n　지금의 자신에게 결여된 것."
    },
    {
     "sid": "da1102:T00010",
     "kind": "본문",
     "jp": "それが何かが解からない。\n\n　それを満たさねば、『魔を断つ剣』と刃を交える権利すら無いのだ。",
     "ko": "그것이 무엇인지 알 수 없다.\n\n　그것을 채우지 않으면, 『마를 끊는 검』과 칼날을 맞댈 권리조차 없다."
    },
    {
     "sid": "da1102:T00011",
     "kind": "본문",
     "jp": "あの三位一体を為す最強の剣と――",
     "ko": "저 삼위일체를 이루는 최강의 검과――"
    }
   ]
  },
  {
   "uid": "da1102:U00005",
   "speaker": "テリオン",
   "jp": "「――――？」",
   "cells": [
    {
     "sid": "da1102:T00012",
     "kind": "본문",
     "jp": "「――――？」",
     "ko": "「――――?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00006",
   "speaker": "(지문)",
   "jp": "今、この大空間に存在するのはリベル・レギスのみ。しかしマスターテリオンの第六感は、確かに違和感を感じ取る。この空間を形成する〈アザトース〉字祷子に生じる〈ノイズ〉乱れ。",
   "cells": [
    {
     "sid": "da1102:T00013",
     "kind": "본문",
     "jp": "今、この大空間に存在するのはリベル・レギスのみ。",
     "ko": "지금, 이 대공간에 존재하는 것은 리베르 레기스뿐."
    },
    {
     "sid": "da1102:T00014",
     "kind": "본문",
     "jp": "しかしマスターテリオンの第六感は、確かに違和感を感じ取る。",
     "ko": "그러나 마스터 테리온의 육감은 확실히 위화감을 감지한다."
    },
    {
     "sid": "da1102:T00015",
     "kind": "본문",
     "jp": "この空間を形成する",
     "ko": "이 공간을 형성하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00001",
     "kind": "루비 읽기",
     "jp": "アザトース",
     "ko": "아자토스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00016",
     "kind": "본문",
     "jp": "字祷子",
     "ko": "자도자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00017",
     "kind": "본문",
     "jp": "に生じる",
     "ko": "에 발생하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00002",
     "kind": "루비 읽기",
     "jp": "ノイズ",
     "ko": "노이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00018",
     "kind": "본문",
     "jp": "乱れ",
     "ko": "흐트러짐",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00019",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00007",
   "speaker": "テリオン",
   "jp": "「何者だ……\n　この空間に干渉しているのは？」",
   "cells": [
    {
     "sid": "da1102:T00020",
     "kind": "본문",
     "jp": "「何者だ……\n　この空間に干渉しているのは？」",
     "ko": "「누구냐……\n　이 공간에 간섭하고 있는 것은?」"
    }
   ]
  },
  {
   "uid": "da1102:U00008",
   "speaker": "(지문)",
   "jp": "答えはない。ノイズはさらに激しく、度し難いものになっていく。マスターテリオンの声が、冷たい怒気を孕む。",
   "cells": [
    {
     "sid": "da1102:T00021",
     "kind": "본문",
     "jp": "答えはない。",
     "ko": "대답은 없다."
    },
    {
     "sid": "da1102:T00022",
     "kind": "본문",
     "jp": "ノイズはさらに激しく、度し難いものになっていく。",
     "ko": "노이즈는 더욱 거세지고, 감당하기 힘든 것이 되어 간다."
    },
    {
     "sid": "da1102:T00023",
     "kind": "본문",
     "jp": "マスターテリオンの声が、冷たい怒気を孕む。",
     "ko": "마스터 테리온의 목소리가 차가운 노기를 머금는다."
    }
   ]
  },
  {
   "uid": "da1102:U00009",
   "speaker": "テリオン",
   "jp": "「不愉快だ……失せろ」",
   "cells": [
    {
     "sid": "da1102:T00024",
     "kind": "본문",
     "jp": "「不愉快だ……失せろ」",
     "ko": "「불유쾌하다…… 꺼져라」"
    }
   ]
  },
  {
   "uid": "da1102:U00010",
   "speaker": "ネロ",
   "jp": "「そうはいかないよ……」",
   "cells": [
    {
     "sid": "da1102:T00025",
     "kind": "본문",
     "jp": "「そうはいかないよ……」",
     "ko": "「그렇게는 안 되지……」"
    }
   ]
  },
  {
   "uid": "da1102:U00011",
   "speaker": "テリオン",
   "jp": "「…………！」",
   "cells": [
    {
     "sid": "da1102:T00026",
     "kind": "본문",
     "jp": "「…………！」",
     "ko": "「…………!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00012",
   "speaker": "ネロ",
   "jp": "「だって君は――」",
   "cells": [
    {
     "sid": "da1102:T00027",
     "kind": "본문",
     "jp": "「だって君は――」",
     "ko": "「왜냐하면 너는――」"
    }
   ]
  },
  {
   "uid": "da1102:U00013",
   "speaker": "ネロ",
   "jp": "「このネロが滅ぼすんだから」",
   "cells": [
    {
     "sid": "da1102:T00028",
     "kind": "본문",
     "jp": "「このネロが滅ぼすんだから」",
     "ko": "「이 네로가 멸할 테니까」"
    }
   ]
  },
  {
   "uid": "da1102:U00014",
   "speaker": "(지문)",
   "jp": "神の心臓が裂けた。滝のように流れ落ちる鮮血。その奥に、血に濡れた白銀の輝きがある。\n\n　それはヒトの形をした異形／神を象った異形。それは機械仕掛けの神――〈デウス・マキナ〉鬼械神。\n\n　心臓から〈・・・・・・〉産まれ落ちたその機体は、血の海面に音も無く\n舞い降りる。\n\n　天を衝くように〈そび〉聳え立つ巨体。その荘厳な威容は、神殿を連想させる。",
   "cells": [
    {
     "sid": "da1102:T00029",
     "kind": "본문",
     "jp": "神の心臓が裂けた。",
     "ko": "신의 심장이 갈라졌다."
    },
    {
     "sid": "da1102:T00030",
     "kind": "본문",
     "jp": "滝のように流れ落ちる鮮血。",
     "ko": "폭포처럼 쏟아져 내리는 선혈."
    },
    {
     "sid": "da1102:T00031",
     "kind": "본문",
     "jp": "その奥に、血に濡れた白銀の輝きがある。\n\n　それはヒトの形をした異形／神を象った異形。",
     "ko": "그 안쪽에, 피에 젖은 백은의 반짝임이 있다.\n\n　그것은 인간의 형태를 한 이형/신을 본뜬 이형."
    },
    {
     "sid": "da1102:T00032",
     "kind": "본문",
     "jp": "それは機械仕掛けの神――",
     "ko": "그것은 기계장치의 신――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00003",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00033",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00034",
     "kind": "본문",
     "jp": "。\n\n　心臓から",
     "ko": ".\n\n　심장에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00004",
     "kind": "루비 읽기",
     "jp": "・・・・・・",
     "ko": "・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00035",
     "kind": "본문",
     "jp": "産まれ落ちた",
     "ko": "태어나 떨어진",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00036",
     "kind": "본문",
     "jp": "その機体は、血の海面に音も無く\n舞い降りる。\n\n　天を衝くように",
     "ko": " 그 기체는, 피의 해면에 소리도 없이\n내려앉는다.\n\n　하늘을 찌를 듯이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00005",
     "kind": "루비 읽기",
     "jp": "そび",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00037",
     "kind": "본문",
     "jp": "聳",
     "ko": "우뚝 솟",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00038",
     "kind": "본문",
     "jp": "え立つ巨体。",
     "ko": "아 선 거체."
    },
    {
     "sid": "da1102:T00039",
     "kind": "본문",
     "jp": "その荘厳な威容は、神殿を連想させる。",
     "ko": "그 장엄한 위용은 신전을 연상시킨다."
    }
   ]
  },
  {
   "uid": "da1102:U00015",
   "speaker": "(지문)",
   "jp": "――鬼械神ネームレス・ワン。\n\n　『無名祭祀書』が招喚する鬼械神。リベル・レギスにも匹敵する力を持つ機体だ。\n\n　そしてそれを駆る者もまた、尋常ならざる魔力を持つ魔術師――\n　魔人の中の魔人である。\n\n　ネームレス・ワンの中から現れる、小柄な少女。マスターテリオンの表情が凍りついた。",
   "cells": [
    {
     "sid": "da1102:T00040",
     "kind": "본문",
     "jp": "――鬼械神ネームレス・ワン。\n\n　『無名祭祀書』が招喚する鬼械神。",
     "ko": "――귀계신 네임리스 원.\n\n　『무명제사서』가 소환하는 귀계신."
    },
    {
     "sid": "da1102:T00041",
     "kind": "본문",
     "jp": "リベル・レギスにも匹敵する力を持つ機体だ。\n\n　そしてそれを駆る者もまた、尋常ならざる魔力を持つ魔術師――\n　魔人の中の魔人である。\n\n　ネームレス・ワンの中から現れる、小柄な少女。",
     "ko": "리베르 레기스에도 필적하는 힘을 가진 기체다.\n\n　그리고 그것을 모는 자 또한, 심상치 않은 마력을 가진 마술사――\n　마인 중의 마인이다.\n\n　네임리스 원 안에서 나타나는 체구가 작은 소녀."
    },
    {
     "sid": "da1102:T00042",
     "kind": "본문",
     "jp": "マスターテリオンの表情が凍りついた。",
     "ko": "마스터 테리온의 표정이 얼어붙었다."
    }
   ]
  },
  {
   "uid": "da1102:U00016",
   "speaker": "テリオン",
   "jp": "「……何だと？」",
   "cells": [
    {
     "sid": "da1102:T00043",
     "kind": "본문",
     "jp": "「……何だと？」",
     "ko": "「……뭐라고?」"
    }
   ]
  },
  {
   "uid": "da1102:U00017",
   "speaker": "ネロ",
   "jp": "「ごきげんよう、〈グランドマスター〉大導師。\n　最後のアンチクロスがやってきたよ\n　……ちょっと遅刻しちゃったけどね」",
   "cells": [
    {
     "sid": "da1102:T00044",
     "kind": "본문",
     "jp": "「ごきげんよう、",
     "ko": "「평안하신지요, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00006",
     "kind": "루비 읽기",
     "jp": "グランドマスター",
     "ko": "그랜드 마스터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00045",
     "kind": "본문",
     "jp": "大導師",
     "ko": "대도사",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00046",
     "kind": "본문",
     "jp": "。\n　最後のアンチクロスがやってきたよ\n　……ちょっと遅刻しちゃったけどね」",
     "ko": ".\n　마지막 안티크로스가 찾아왔어\n　……조금 지각해 버렸지만 말이야」"
    }
   ]
  },
  {
   "uid": "da1102:U00018",
   "speaker": "(지문)",
   "jp": "そう。彼女もまたアンチクロスの一人。魔人の中の魔人にして、罪人の中の罪人。\n\n　『暴君』ネロ。最強最悪のアンチクロス。そして、もう一人の『聖書の獣』。",
   "cells": [
    {
     "sid": "da1102:T00047",
     "kind": "본문",
     "jp": "そう。",
     "ko": "그렇다."
    },
    {
     "sid": "da1102:T00048",
     "kind": "본문",
     "jp": "彼女もまたアンチクロスの一人。",
     "ko": "그녀 또한 안티크로스 중 한 명."
    },
    {
     "sid": "da1102:T00049",
     "kind": "본문",
     "jp": "魔人の中の魔人にして、罪人の中の罪人。\n\n　『暴君』ネロ。",
     "ko": "마인 중의 마인이자, 죄인 중의 죄인.\n\n　『폭군』 네로."
    },
    {
     "sid": "da1102:T00050",
     "kind": "본문",
     "jp": "最強最悪のアンチクロス。",
     "ko": "최강최악의 안티크로스."
    },
    {
     "sid": "da1102:T00051",
     "kind": "본문",
     "jp": "そして、もう一人の『聖書の獣』。",
     "ko": "그리고 또 한 명의 『성서의 짐승』."
    }
   ]
  },
  {
   "uid": "da1102:U00019",
   "speaker": "ネロ",
   "jp": "「なに？　そんなにぼーっとしちゃって。\n　ネロが居るのがそんなに不思議？」",
   "cells": [
    {
     "sid": "da1102:T00052",
     "kind": "본문",
     "jp": "「なに？　そんなにぼーっとしちゃって。\n　ネロが居るのがそんなに不思議？」",
     "ko": "「뭐야?　그렇게 멍하니 있고선.\n　네로가 있는 게 그렇게 이상해?」"
    }
   ]
  },
  {
   "uid": "da1102:U00020",
   "speaker": "ネロ",
   "jp": "「嫌だなぁ……\n　勝手にネロだけを仲間外れにしないでよ」",
   "cells": [
    {
     "sid": "da1102:T00053",
     "kind": "본문",
     "jp": "「嫌だなぁ……\n　勝手にネロだけを仲間外れにしないでよ」",
     "ko": "「싫다 참……\n　멋대로 네로만 따돌리지 말아 줘」"
    }
   ]
  },
  {
   "uid": "da1102:U00021",
   "speaker": "(지문)",
   "jp": "言って、くすくすと笑う。マスターテリオンは動けない。\n\n　ただ呆然と、少女を見つめ続ける。少女もまた構わず進める。",
   "cells": [
    {
     "sid": "da1102:T00054",
     "kind": "본문",
     "jp": "言って、くすくすと笑う。",
     "ko": "그리 말하며 쿡쿡 웃는다."
    },
    {
     "sid": "da1102:T00055",
     "kind": "본문",
     "jp": "マスターテリオンは動けない。\n\n　ただ呆然と、少女を見つめ続ける。",
     "ko": "마스터 테리온은 움직일 수 없다.\n\n　그저 멍하니 소녀를 계속 바라본다."
    },
    {
     "sid": "da1102:T00056",
     "kind": "본문",
     "jp": "少女もまた構わず進める。",
     "ko": "소녀 또한 아랑곳하지 않고 말을 잇는다."
    }
   ]
  },
  {
   "uid": "da1102:U00022",
   "speaker": "ネロ",
   "jp": "「まあ、でも、確かに\n　他のみんなとは事情が違うかも」",
   "cells": [
    {
     "sid": "da1102:T00057",
     "kind": "본문",
     "jp": "「まあ、でも、確かに\n　他のみんなとは事情が違うかも」",
     "ko": "「뭐, 그래도 확실히\n　다른 모두와는 사정이 다를지도」"
    }
   ]
  },
  {
   "uid": "da1102:U00023",
   "speaker": "ネロ",
   "jp": "「――総てはかりそめ。\n　単なる悪夢。\n　ネロも、他のアンチクロスも、〈グランドマスター〉大導師……君もだよ」",
   "cells": [
    {
     "sid": "da1102:T00058",
     "kind": "본문",
     "jp": "「――総てはかりそめ。\n　単なる悪夢。\n　ネロも、他のアンチクロスも、",
     "ko": "「――모든 것은 일시적인 것.\n　단순한 악몽.\n　네로도, 다른 안티크로스도,\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00007",
     "kind": "루비 읽기",
     "jp": "グランドマスター",
     "ko": "그랜드 마스터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00059",
     "kind": "본문",
     "jp": "大導師",
     "ko": "대도사",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00060",
     "kind": "본문",
     "jp": "……君もだよ」",
     "ko": "…… 너도 말이야」"
    }
   ]
  },
  {
   "uid": "da1102:U00024",
   "speaker": "ネロ",
   "jp": "「全部全部、意味の無い、\n　くだらないマボロシに過ぎないのさ」",
   "cells": [
    {
     "sid": "da1102:T00061",
     "kind": "본문",
     "jp": "「全部全部、意味の無い、\n　くだらないマボロシに過ぎないのさ」",
     "ko": "「전부 전부, 의미 없는,\n　시시한 환영에 불과하니까」"
    }
   ]
  },
  {
   "uid": "da1102:U00025",
   "speaker": "(지문)",
   "jp": "少女の貌から微笑が消える。リベル・レギスを――その中に居るマスターテリオンを視る瞳には、光が無い。\n\n　底無しに深い闇色。少年がその瞳に宿す金色の闇と同じように。",
   "cells": [
    {
     "sid": "da1102:T00062",
     "kind": "본문",
     "jp": "少女の貌から微笑が消える。",
     "ko": "소녀의 얼굴에서 미소가 사라진다."
    },
    {
     "sid": "da1102:T00063",
     "kind": "본문",
     "jp": "リベル・レギスを――その中に居るマスターテリオンを視る瞳には、光が無い。\n\n　底無しに深い闇色。",
     "ko": "리베르 레기스를――그 안에 있는 마스터 테리온을 보는 눈동자에는 빛이 없다.\n\n　밑바닥 없이 깊은 암색."
    },
    {
     "sid": "da1102:T00064",
     "kind": "본문",
     "jp": "少年がその瞳に宿す金色の闇と同じように。",
     "ko": "소년이 그 눈동자에 품은 금빛 어둠과 마찬가지로."
    }
   ]
  },
  {
   "uid": "da1102:U00026",
   "speaker": "ネロ",
   "jp": "「でも、だからこそ……\n　何にも〈しば〉呪縛られてない。\n　この世の全てに縁が無いんだもの。\n　だったら――」",
   "cells": [
    {
     "sid": "da1102:T00065",
     "kind": "본문",
     "jp": "「でも、だからこそ……\n　何にも",
     "ko": "「하지만, 그렇기 때문에……\n　아무것에도 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00008",
     "kind": "루비 읽기",
     "jp": "しば",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00066",
     "kind": "본문",
     "jp": "呪縛",
     "ko": "주박",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00067",
     "kind": "본문",
     "jp": "られてない。\n　この世の全てに縁が無いんだもの。\n　だったら――」",
     "ko": "되어 있지 않아.\n　이 세상 모든 것과 인연이 없는걸.\n　그렇다면――」"
    }
   ]
  },
  {
   "uid": "da1102:U00027",
   "speaker": "ネロ",
   "jp": "「〈アナザーブラッド〉紡ぎ手の言うことを聞く\n　必要だってないでしょ？」",
   "cells": [
    {
     "sid": "da1102:T00068",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00009",
     "kind": "루비 읽기",
     "jp": "アナザーブラッド",
     "ko": "어나더 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00069",
     "kind": "본문",
     "jp": "紡ぎ手",
     "ko": "자아내는 자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00070",
     "kind": "본문",
     "jp": "の言うことを聞く\n　必要だってないでしょ？」",
     "ko": "의 말을 들을\n　필요도 없잖아?」"
    }
   ]
  },
  {
   "uid": "da1102:U00028",
   "speaker": "(지문)",
   "jp": "少女はかつて自分を呪縛していたものを想う。無限螺旋の世界。邪神によって組み立てられた〈ウロボロス〉輪廻の箱庭。\n\n　それは混沌の〈ノロイ〉呪縛。運命の歯車を動かすため――少女は穢され、狂わされ、殺され続けた。無限に等しい時間の中、無限に等しい繰り返しの中で。",
   "cells": [
    {
     "sid": "da1102:T00071",
     "kind": "본문",
     "jp": "少女はかつて自分を呪縛していたものを想う。",
     "ko": "소녀는 일찍이 자신을 주박하고 있던 것을 떠올린다."
    },
    {
     "sid": "da1102:T00072",
     "kind": "본문",
     "jp": "無限螺旋の世界。",
     "ko": "무한나선의 세계."
    },
    {
     "sid": "da1102:T00073",
     "kind": "본문",
     "jp": "邪神によって組み立てられた",
     "ko": "사신이 조립한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00010",
     "kind": "루비 읽기",
     "jp": "ウロボロス",
     "ko": "우로보로스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00074",
     "kind": "본문",
     "jp": "輪廻",
     "ko": "윤회",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00075",
     "kind": "본문",
     "jp": "の箱庭。\n\n　それは混沌の",
     "ko": "의 모형정원.\n\n　그것은 혼돈의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00011",
     "kind": "루비 읽기",
     "jp": "ノロイ",
     "ko": "저주",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00076",
     "kind": "본문",
     "jp": "呪縛",
     "ko": "주박",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00077",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:T00078",
     "kind": "본문",
     "jp": "運命の歯車を動かすため――",
     "ko": "운명의 톱니바퀴를 움직이기 위해――"
    },
    {
     "sid": "da1102:T00079",
     "kind": "본문",
     "jp": "少女は穢され、",
     "ko": "소녀는 더럽혀지고,"
    },
    {
     "sid": "da1102:T00080",
     "kind": "본문",
     "jp": "狂わされ、",
     "ko": " 미치게 되고,"
    },
    {
     "sid": "da1102:T00081",
     "kind": "본문",
     "jp": "殺され続けた。",
     "ko": " 계속해서 살해당했다."
    },
    {
     "sid": "da1102:T00082",
     "kind": "본문",
     "jp": "無限に等しい時間の中、無限に等しい繰り返しの中で。",
     "ko": "무한에 가까운 시간 속, 무한에 가까운 되풀이 속에서."
    }
   ]
  },
  {
   "uid": "da1102:U00029",
   "speaker": "ネロ",
   "jp": "「つまりだよ……」",
   "cells": [
    {
     "sid": "da1102:T00083",
     "kind": "본문",
     "jp": "「つまりだよ……」",
     "ko": "「다시 말해서……」"
    }
   ]
  },
  {
   "uid": "da1102:U00030",
   "speaker": "(지문)",
   "jp": "少女の貌に再び表情が戻る。だが、瞳に宿した闇黒はさらに深く、〈くら〉冥く。\n\n　少女が笑う。亀裂のような喜悦。",
   "cells": [
    {
     "sid": "da1102:T00084",
     "kind": "본문",
     "jp": "少女の貌に再び表情が戻る。",
     "ko": "소녀의 얼굴에 다시 표정이 돌아온다."
    },
    {
     "sid": "da1102:T00085",
     "kind": "본문",
     "jp": "だが、瞳に宿した闇黒はさらに深く、",
     "ko": "하지만 눈동자에 품은 암흑은 더욱 깊고, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00012",
     "kind": "루비 읽기",
     "jp": "くら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00086",
     "kind": "본문",
     "jp": "冥",
     "ko": "어둡",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00087",
     "kind": "본문",
     "jp": "く。\n\n　少女が笑う。",
     "ko": "게.\n\n　소녀가 웃는다."
    },
    {
     "sid": "da1102:T00088",
     "kind": "본문",
     "jp": "亀裂のような喜悦。",
     "ko": "균열 같은 희열."
    }
   ]
  },
  {
   "uid": "da1102:U00031",
   "speaker": "ネロ",
   "jp": "「殺せるんだ。\n　ネロは君を殺せるんだ」",
   "cells": [
    {
     "sid": "da1102:T00089",
     "kind": "본문",
     "jp": "「殺せるんだ。\n　ネロは君を殺せるんだ」",
     "ko": "「죽일 수 있는 거야.\n　네로는 너를 죽일 수 있는 거야」"
    }
   ]
  },
  {
   "uid": "da1102:U00032",
   "speaker": "ネロ",
   "jp": "「この手で……\n　私はこの手で、我が子を！――〈くび〉縊り殺せる！」",
   "cells": [
    {
     "sid": "da1102:T00090",
     "kind": "본문",
     "jp": "「この手で……\n　私はこの手で、我が子を！",
     "ko": "「이 손으로……\n　나는 이 손으로, 내 아이를!"
    },
    {
     "sid": "da1102:T00091",
     "kind": "본문",
     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00013",
     "kind": "루비 읽기",
     "jp": "くび",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00092",
     "kind": "본문",
     "jp": "縊",
     "ko": "목 졸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00093",
     "kind": "본문",
     "jp": "り殺せる！」",
     "ko": "라 죽일 수 있어!」"
    }
   ]
  },
  {
   "uid": "da1102:U00033",
   "speaker": "(지문)",
   "jp": "少女が詠うのは殺意。それは無垢な――極限まで純化された、宝石のような殺意だ。\n\n　想えるのだ。人はこんなにも純粋に、誰かを殺したいと想えるのだ。こんな――愛にも似た切実さで。",
   "cells": [
    {
     "sid": "da1102:T00094",
     "kind": "본문",
     "jp": "少女が詠うのは殺意。",
     "ko": "소녀가 읊조리는 것은 살의."
    },
    {
     "sid": "da1102:T00095",
     "kind": "본문",
     "jp": "それは無垢な――極限まで純化された、宝石のような殺意だ。\n\n　想えるのだ。",
     "ko": "그것은 무구한――극한까지 순화된, 보석 같은 살의다.\n\n　품을 수 있는 것이다."
    },
    {
     "sid": "da1102:T00096",
     "kind": "본문",
     "jp": "人はこんなにも純粋に、誰かを殺したいと想えるのだ。",
     "ko": "사람은 이토록이나 순수하게, 누군가를 죽이고 싶다고 생각할 수 있는 것이다."
    },
    {
     "sid": "da1102:T00097",
     "kind": "본문",
     "jp": "こんな――",
     "ko": "이런――"
    },
    {
     "sid": "da1102:T00098",
     "kind": "본문",
     "jp": "愛にも似た切実さで。",
     "ko": "사랑과도 닮은 절실함으로."
    }
   ]
  },
  {
   "uid": "da1102:U00034",
   "speaker": "テリオン",
   "jp": "「――――――」",
   "cells": [
    {
     "sid": "da1102:T00099",
     "kind": "본문",
     "jp": "「――――――」",
     "ko": "「――――――」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00035",
   "speaker": "(지문)",
   "jp": "マスターテリオンは――金色の少年は、ただ呆然と少女の殺意を\n受け止める。\n\n　\n　\n　　　　　　　　　　　　　母の殺意を受け止める。\n\n　――母。然り、少女は少年を孕んだ。外なる神ヨグ＝ソトースを父とする、この少年を。\n\n　少女は邪神と交わり、\n　世界に仇なす最悪の魔人を産み落としたのだ。\n\n　この少女こそ、〈Ｏｕｒ　Ｌａｄｙ　ｏｆ　Ｄａｒｋｎｅｓｓ〉闇の聖母。魔人マスターテリオンの母。\n\n　母は詠う。殺意を。我が子に対する殺意を。宝石のような殺意を。愛にも似た殺意を。",
   "cells": [
    {
     "sid": "da1102:T00100",
     "kind": "본문",
     "jp": "マスターテリオンは――金色の少年は、ただ呆然と少女の殺意を\n受け止める。\n\n　\n　\n　　　　　　　　　　　　　母",
     "ko": "마스터 테리온은――금빛 소년은, 그저 멍하니 소녀의 살의를\n받아들인다.\n\n　\n　\n　　　　　　　　　　　　　　　어"
    },
    {
     "sid": "da1102:T00101",
     "kind": "본문",
     "jp": "の",
     "ko": "머"
    },
    {
     "sid": "da1102:T00102",
     "kind": "본문",
     "jp": "殺",
     "ko": "니"
    },
    {
     "sid": "da1102:T00103",
     "kind": "본문",
     "jp": "意",
     "ko": "의"
    },
    {
     "sid": "da1102:T00104",
     "kind": "본문",
     "jp": "を",
     "ko": " 살"
    },
    {
     "sid": "da1102:T00105",
     "kind": "본문",
     "jp": "受",
     "ko": "의"
    },
    {
     "sid": "da1102:T00106",
     "kind": "본문",
     "jp": "け",
     "ko": "를"
    },
    {
     "sid": "da1102:T00107",
     "kind": "본문",
     "jp": "止",
     "ko": " 받"
    },
    {
     "sid": "da1102:T00108",
     "kind": "본문",
     "jp": "め",
     "ko": "아"
    },
    {
     "sid": "da1102:T00109",
     "kind": "본문",
     "jp": "る。\n\n　――母。",
     "ko": "들인다.\n\n　――어머니."
    },
    {
     "sid": "da1102:T00110",
     "kind": "본문",
     "jp": "然り、少女は少年を孕んだ。",
     "ko": "그렇다, 소녀는 소년을 잉태했다."
    },
    {
     "sid": "da1102:T00111",
     "kind": "본문",
     "jp": "外なる神ヨグ＝ソトースを父とする、この少年を。\n\n　少女は邪神と交わり、\n　世界に仇なす最悪の魔人を産み落としたのだ。\n\n　この少女こそ、",
     "ko": "바깥의 신 요그 소토스를 아버지로 둔, 이 소년을.\n\n　소녀는 사신과 교접하여,\n　세상에 해악을 끼치는 최악의 마인을 낳았다.\n\n　이 소녀야말로, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00014",
     "kind": "루비 읽기",
     "jp": "Ｏｕｒ　Ｌａｄｙ　ｏｆ　Ｄａｒｋｎｅｓｓ",
     "ko": "Ｏｕｒ　Ｌａｄｙ　ｏｆ　Ｄａｒｋｎｅｓｓ",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00112",
     "kind": "본문",
     "jp": "闇の聖母",
     "ko": "어둠의 성모",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00113",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:T00114",
     "kind": "본문",
     "jp": "魔人マスターテリオンの母。\n\n　母は詠う。",
     "ko": "마인 마스터 테리온의 어머니.\n\n　어머니는 노래한다."
    },
    {
     "sid": "da1102:T00115",
     "kind": "본문",
     "jp": "殺意を。",
     "ko": " 살의를."
    },
    {
     "sid": "da1102:T00116",
     "kind": "본문",
     "jp": "我が子に対する殺意を。",
     "ko": "내 아이를 향한 살의를."
    },
    {
     "sid": "da1102:T00117",
     "kind": "본문",
     "jp": "宝石のような殺意を。",
     "ko": "보석 같은 살의를."
    },
    {
     "sid": "da1102:T00118",
     "kind": "본문",
     "jp": "愛にも似た殺意を。",
     "ko": "사랑과도 닮은 살의를."
    }
   ]
  },
  {
   "uid": "da1102:U00036",
   "speaker": "ネロ",
   "jp": "「この役だけは九郎にも譲らない。\n　さあ……私の腕の中で眠り、\n　息絶えなさい！」",
   "cells": [
    {
     "sid": "da1102:T00119",
     "kind": "본문",
     "jp": "「この役だけは九郎にも譲らない。\n　さあ……私の腕の中で眠り、\n　息絶えなさい！」",
     "ko": "「이 역할만은 쿠로에게도 양보하지 않아.\n　자…… 내 품 안에서 잠들어,\n　숨을 거두어라!」"
    }
   ]
  },
  {
   "uid": "da1102:U00037",
   "speaker": "ネロ",
   "jp": "「望まれぬ〈いのち〉生命！　忌むべき〈ヒルコ〉蛭子！\n　――嗚呼、憎しや憎し、私の坊や！」",
   "cells": [
    {
     "sid": "da1102:T00120",
     "kind": "본문",
     "jp": "「望まれぬ",
     "ko": "「축복받지 못한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00015",
     "kind": "루비 읽기",
     "jp": "いのち",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00121",
     "kind": "본문",
     "jp": "生命",
     "ko": "생명",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00122",
     "kind": "본문",
     "jp": "！　忌むべき",
     "ko": "!　꺼림칙한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00016",
     "kind": "루비 읽기",
     "jp": "ヒルコ",
     "ko": "히루코",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00123",
     "kind": "본문",
     "jp": "蛭子",
     "ko": "거머리 아이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00124",
     "kind": "본문",
     "jp": "！\n　――嗚呼、憎しや憎し、私の坊や！」",
     "ko": "!\n　――아아, 밉고도 밉구나, 나의 아가야!」"
    }
   ]
  },
  {
   "uid": "da1102:U00038",
   "speaker": "マスターテリオン",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da1102:T00125",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00039",
   "speaker": "(지문)",
   "jp": "少年はなおも呆然と、少女を見つめている。魔人としての狂気も、黒の王としての威厳も、今の彼には無い。\n\n　少年の心は、無垢な子どもの――\n　世界を知らない赤子のそれに等しかった。\n\n　だが――",
   "cells": [
    {
     "sid": "da1102:T00126",
     "kind": "본문",
     "jp": "少年はなおも呆然と、少女を見つめている。",
     "ko": "소년은 여전히 멍하니 소녀를 바라보고 있다."
    },
    {
     "sid": "da1102:T00127",
     "kind": "본문",
     "jp": "魔人としての狂気も、黒の王としての威厳も、今の彼には無い。\n\n　少年の心は、無垢な子どもの――\n　世界を知らない赤子のそれに等しかった。\n\n　だが――",
     "ko": "마인으로서의 광기도, 흑의 왕으로서의 위엄도, 지금의 그에게는 없다.\n\n　소년의 마음은 무구한 어린아이의――\n　세상을 모르는 갓난아기의 그것과 같았다.\n\n　하지만――"
    }
   ]
  },
  {
   "uid": "da1102:U00040",
   "speaker": "テリオン",
   "jp": "「は……ははは……」",
   "cells": [
    {
     "sid": "da1102:T00128",
     "kind": "본문",
     "jp": "「は……ははは……」",
     "ko": "「하…… 하하하……」"
    }
   ]
  },
  {
   "uid": "da1102:U00041",
   "speaker": "(지문)",
   "jp": "少年の中で何かが決壊した。それは心を護る鎧だったのか。それとも心を縛る鎖だったのか。\n\n　決壊した心から、零れ落ちる笑い。",
   "cells": [
    {
     "sid": "da1102:T00129",
     "kind": "본문",
     "jp": "少年の中で何かが決壊した。",
     "ko": "소년의 안에서 무언가가 무너져 내렸다."
    },
    {
     "sid": "da1102:T00130",
     "kind": "본문",
     "jp": "それは心を護る鎧だったのか。",
     "ko": "그것은 마음을 지키는 갑옷이었던가."
    },
    {
     "sid": "da1102:T00131",
     "kind": "본문",
     "jp": "それとも心を縛る鎖だったのか。\n\n　決壊した心から、零れ落ちる笑い。",
     "ko": "아니면 마음을 묶는 사슬이었던가.\n\n　무너져 내린 마음에서 흘러나오는 웃음."
    }
   ]
  },
  {
   "uid": "da1102:U00042",
   "speaker": "テリオン",
   "jp": "「は……ははははははは……！」",
   "cells": [
    {
     "sid": "da1102:T00132",
     "kind": "본문",
     "jp": "「は……ははははははは……！」",
     "ko": "「하…… 하하하하하하하……!」"
    }
   ]
  },
  {
   "uid": "da1102:U00043",
   "speaker": "(지문)",
   "jp": "それは止め様もなく増大し、",
   "cells": [
    {
     "sid": "da1102:T00133",
     "kind": "본문",
     "jp": "それは止め様もなく増大し、",
     "ko": "그것은 걷잡을 새 없이 커져,"
    }
   ]
  },
  {
   "uid": "da1102:U00044",
   "speaker": "テリオン",
   "jp": "「ははははははははははははははははははははははははははははは！」",
   "cells": [
    {
     "sid": "da1102:T00134",
     "kind": "본문",
     "jp": "「ははははははははははははははははははははははははははははは！」",
     "ko": "「하하하하하하하하하하하하하하하하하하하하하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da1102:U00045",
   "speaker": "(지문)",
   "jp": "哄笑となって、何もかもを呑み込んでゆく。亀裂のような喜悦を浮かべ、少年は〈わら〉哄笑う。〈ほえ〉咆吼るように。",
   "cells": [
    {
     "sid": "da1102:T00135",
     "kind": "본문",
     "jp": "哄笑となって、何もかもを呑み込んでゆく。",
     "ko": "홍소가 되어 모든 것을 집어삼켜 간다."
    },
    {
     "sid": "da1102:T00136",
     "kind": "본문",
     "jp": "亀裂のような喜悦を浮かべ、少年は",
     "ko": "균열 같은 희열을 띠고, 소년은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00017",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00137",
     "kind": "본문",
     "jp": "哄笑",
     "ko": "홍소하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00138",
     "kind": "본문",
     "jp": "う。",
     "ko": "며 웃는다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00018",
     "kind": "루비 읽기",
     "jp": "ほえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00139",
     "kind": "본문",
     "jp": "咆吼",
     "ko": "포효하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00140",
     "kind": "본문",
     "jp": "るように。",
     "ko": "듯이."
    }
   ]
  },
  {
   "uid": "da1102:U00046",
   "speaker": "テリオン",
   "jp": "「こいつは確かに……\n　極上の悪夢だ！」",
   "cells": [
    {
     "sid": "da1102:T00141",
     "kind": "본문",
     "jp": "「こいつは確かに……\n　極上の悪夢だ！」",
     "ko": "「이거 확실히……\n　극상의 악몽이군!」"
    }
   ]
  },
  {
   "uid": "da1102:U00047",
   "speaker": "(지문)",
   "jp": "リベル・レギスから莫大な魔力が噴き出し、爆発した。爆発は突撃力に変換される。爆音を置き去りに、紅の機神は稲妻のように〈はし〉奔る。",
   "cells": [
    {
     "sid": "da1102:T00142",
     "kind": "본문",
     "jp": "リベル・レギスから莫大な魔力が噴き出し、爆発した。",
     "ko": "리베르 레기스에서 막대한 마력이 뿜어져 나와 폭발했다."
    },
    {
     "sid": "da1102:T00143",
     "kind": "본문",
     "jp": "爆発は突撃力に変換される。",
     "ko": "폭발은 돌격력으로 변환된다."
    },
    {
     "sid": "da1102:T00144",
     "kind": "본문",
     "jp": "爆音を置き去りに、紅の機神は稲妻のように",
     "ko": "폭음을 뒤로하고, 붉은 기신은 번개처럼 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00019",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00145",
     "kind": "본문",
     "jp": "奔",
     "ko": "질주한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00146",
     "kind": "본문",
     "jp": "る。",
     "ko": "다."
    }
   ]
  },
  {
   "uid": "da1102:U00048",
   "speaker": "テリオン",
   "jp": "「アアアアアアアアアアァァァッ！」",
   "cells": [
    {
     "sid": "da1102:T00147",
     "kind": "본문",
     "jp": "「アアアアアアアアアアァァァッ！」",
     "ko": "「아아아아아아아아아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da1102:U00049",
   "speaker": "(지문)",
   "jp": "咆吼とも悲鳴ともつかぬ叫びと共に、ネームレス・ワンに\n　襲いかかる。",
   "cells": [
    {
     "sid": "da1102:T00148",
     "kind": "본문",
     "jp": "咆吼とも悲鳴ともつかぬ叫びと共に、ネームレス・ワンに\n　襲いかかる。",
     "ko": "포효인지 비명인지 모를 외침과 함께, 네임리스 원에게\n　덤벼든다."
    }
   ]
  },
  {
   "uid": "da1102:U00050",
   "speaker": "(지문)",
   "jp": "堅牢な防禦陣が、リベル・レギスの行く手を阻む。無理矢理にでも突破しようと突き進むリベル・レギス。ぶつかり合う魔力と魔力が、爆光となって踊り狂う。",
   "cells": [
    {
     "sid": "da1102:T00149",
     "kind": "본문",
     "jp": "堅牢な防禦陣が、リベル・レギスの行く手を阻む。",
     "ko": "견고한 방어진이 리베르 레기스의 앞길을 가로막는다."
    },
    {
     "sid": "da1102:T00150",
     "kind": "본문",
     "jp": "無理矢理にでも突破しようと突き進むリベル・レギス。",
     "ko": "억지로라도 돌파하려고 돌진하는 리베르 레기스."
    },
    {
     "sid": "da1102:T00151",
     "kind": "본문",
     "jp": "ぶつかり合う魔力と魔力が、爆光となって踊り狂う。",
     "ko": "부딪치는 마력과 마력이 폭광이 되어 미친 듯이 춤춘다."
    }
   ]
  },
  {
   "uid": "da1102:U00051",
   "speaker": "テリオン",
   "jp": "「アアアアアアアアアアア\n　アアアアアアアアアアッッッ！」",
   "cells": [
    {
     "sid": "da1102:T00152",
     "kind": "본문",
     "jp": "「アアアアアアアアアアア\n　アアアアアアアアアアッッッ！」",
     "ko": "「아아아아아아아아아아아\n　아아아아아아아아아아으으읏!」"
    }
   ]
  },
  {
   "uid": "da1102:U00052",
   "speaker": "(지문)",
   "jp": "機体のあちらこちらが爆ぜた。飛び散る〈アゾート〉水銀の血。だがそれは闘気に触れて、一瞬で蒸発する。\n\n　機体にかかる負荷には一切構わず、少年はさらに力を注ぎ込む。ネームレス・ワンに触れるために。",
   "cells": [
    {
     "sid": "da1102:T00153",
     "kind": "본문",
     "jp": "機体のあちらこちらが爆ぜた。",
     "ko": "기체 여기저기가 터져 나갔다."
    },
    {
     "sid": "da1102:T00154",
     "kind": "본문",
     "jp": "飛び散る",
     "ko": "흩날리는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00020",
     "kind": "루비 읽기",
     "jp": "アゾート",
     "ko": "아조트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00155",
     "kind": "본문",
     "jp": "水銀",
     "ko": "수은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00156",
     "kind": "본문",
     "jp": "の血。",
     "ko": "의 피."
    },
    {
     "sid": "da1102:T00157",
     "kind": "본문",
     "jp": "だがそれは闘気に触れて、一瞬で蒸発する。\n\n　機体にかかる負荷には一切構わず、少年はさらに力を注ぎ込む。",
     "ko": "하지만 그것은 투기에 닿아 순식간에 증발한다.\n\n　기체에 가해지는 부하는 일절 아랑곳하지 않고, 소년은 더욱 힘을 쏟아붓는다."
    },
    {
     "sid": "da1102:T00158",
     "kind": "본문",
     "jp": "ネームレス・ワンに触れるために。",
     "ko": "네임리스 원에 닿기 위하여."
    }
   ]
  },
  {
   "uid": "da1102:U00053",
   "speaker": "テリオン",
   "jp": "（足りぬ……）",
   "cells": [
    {
     "sid": "da1102:T00159",
     "kind": "본문",
     "jp": "（足りぬ……）",
     "ko": "(부족하다……)"
    }
   ]
  },
  {
   "uid": "da1102:U00054",
   "speaker": "(지문)",
   "jp": "心の何処かで何かが囁く。――足りない、と。囁きは無限に増殖し、思考を塗り潰す。",
   "cells": [
    {
     "sid": "da1102:T00160",
     "kind": "본문",
     "jp": "心の何処かで何かが囁く。",
     "ko": "마음속 어딘가에서 무언가가 속삭인다."
    },
    {
     "sid": "da1102:T00161",
     "kind": "본문",
     "jp": "――足りない、と。",
     "ko": "――부족하다, 라고."
    },
    {
     "sid": "da1102:T00162",
     "kind": "본문",
     "jp": "囁きは無限に増殖し、思考を塗り潰す。",
     "ko": "속삭임은 무한히 증식하여 사고를 뒤덮는다."
    }
   ]
  },
  {
   "uid": "da1102:U00055",
   "speaker": "テリオン",
   "jp": "（足りぬ……足りぬ……\n　足りぬ……足りぬ！）",
   "cells": [
    {
     "sid": "da1102:T00163",
     "kind": "본문",
     "jp": "（足りぬ……足りぬ……\n　足りぬ……足りぬ！）",
     "ko": "(부족하다…… 부족하다……\n　부족하다…… 부족해!)"
    }
   ]
  },
  {
   "uid": "da1102:U00056",
   "speaker": "(지문)",
   "jp": "――足りない。――これでは欠けている。――これでは届かない。",
   "cells": [
    {
     "sid": "da1102:T00164",
     "kind": "본문",
     "jp": "――足りない。",
     "ko": "――부족하다."
    },
    {
     "sid": "da1102:T00165",
     "kind": "본문",
     "jp": "――これでは欠けている。",
     "ko": "――이래서는 결여되어 있다."
    },
    {
     "sid": "da1102:T00166",
     "kind": "본문",
     "jp": "――これでは届かない。",
     "ko": "――이래서는 닿지 않는다."
    }
   ]
  },
  {
   "uid": "da1102:U00057",
   "speaker": "(지문)",
   "jp": "――デモンベインには届かない！\n\n　もっと強く。もっと激しく。もっと鋭く。超えろ超えろ超えろ超えろ超えろ超えろ超えろ！\n\n　取り戻せ。デモンベインと対峙する権利を取り戻せ。\n\n　そのために――何が足りない？何が欠けている？\n\n　欠けたる力――欠けたる半身。それは何だ！？\n\n　デモンベインに比べて、自分には何が欠けている！？あの三位一体の剣に在って、自分に欠けているもの――！",
   "cells": [
    {
     "sid": "da1102:T00167",
     "kind": "본문",
     "jp": "――デモンベインには届かない！\n\n　もっと強く。",
     "ko": "――데몬베인에게는 닿지 않는다!\n\n　더 강하게."
    },
    {
     "sid": "da1102:T00168",
     "kind": "본문",
     "jp": "もっと激しく。",
     "ko": " 더 격렬하게."
    },
    {
     "sid": "da1102:T00169",
     "kind": "본문",
     "jp": "もっと鋭く。",
     "ko": " 더 예리하게."
    },
    {
     "sid": "da1102:T00170",
     "kind": "본문",
     "jp": "超えろ超えろ超えろ超えろ超えろ超えろ超えろ！\n\n　取り戻せ。",
     "ko": "넘어서라 넘어서라 넘어서라 넘어서라 넘어서라 넘어서라 넘어서라!\n\n　되찾아라."
    },
    {
     "sid": "da1102:T00171",
     "kind": "본문",
     "jp": "デモンベインと対峙する権利を取り戻せ。\n\n　そのために――何が足りない？",
     "ko": "데몬베인과 대치할 권리를 되찾아라.\n\n　그러기 위해서――무엇이 부족한가?"
    },
    {
     "sid": "da1102:T00172",
     "kind": "본문",
     "jp": "何が欠けている？\n\n　欠けたる力――欠けたる半身。",
     "ko": "무엇이 결여되어 있는가?\n\n　결여된 힘――결여된 반신."
    },
    {
     "sid": "da1102:T00173",
     "kind": "본문",
     "jp": "それは何だ！？\n\n　デモンベインに比べて、自分には何が欠けている！？",
     "ko": "그것은 무엇이냐!?\n\n　데몬베인에 비해서, 자신에게는 무엇이 결여되어 있는가!?"
    },
    {
     "sid": "da1102:T00174",
     "kind": "본문",
     "jp": "あの三位一体の剣に在って、自分に欠けているもの――！",
     "ko": "저 삼위일체의 검에 있고, 자신에게 결여되어 있는 것――!"
    }
   ]
  },
  {
   "uid": "da1102:U00058",
   "speaker": "(지문)",
   "jp": "『〈・・・・〉三位一体』",
   "cells": [
    {
     "sid": "da1102:T00175",
     "kind": "본문",
     "jp": "『",
     "ko": "『",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00021",
     "kind": "루비 읽기",
     "jp": "・・・・",
     "ko": "・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00176",
     "kind": "본문",
     "jp": "三位一体",
     "ko": "삼위일체",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00177",
     "kind": "본문",
     "jp": "』",
     "ko": "』",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00059",
   "speaker": "マスターテリオン",
   "jp": "「――――！」",
   "cells": [
    {
     "sid": "da1102:T00178",
     "kind": "본문",
     "jp": "「――――！」",
     "ko": "「――――!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00060",
   "speaker": "(지문)",
   "jp": "欠けている〈ピース〉断片が、最後の鍵が合わさった。\n\n　理解よりも迅く、少年は叫んだ。謳った。自らの半身の名を。",
   "cells": [
    {
     "sid": "da1102:T00179",
     "kind": "본문",
     "jp": "欠けている",
     "ko": "결여되어 있던 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00022",
     "kind": "루비 읽기",
     "jp": "ピース",
     "ko": "피스가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00180",
     "kind": "본문",
     "jp": "断片",
     "ko": "단편이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00181",
     "kind": "본문",
     "jp": "が、最後の鍵が合わさった。\n\n　理解よりも迅く、少年は叫んだ。",
     "ko": ", 마지막 열쇠가 맞춰졌다.\n\n　이해보다 빠르게, 소년은 외쳤다."
    },
    {
     "sid": "da1102:T00182",
     "kind": "본문",
     "jp": "謳った。",
     "ko": "소리 높여 불렀다."
    },
    {
     "sid": "da1102:T00183",
     "kind": "본문",
     "jp": "自らの半身の名を。",
     "ko": "자신의 반신의 이름을."
    }
   ]
  },
  {
   "uid": "da1102:U00061",
   "speaker": "テリオン",
   "jp": "「〈・・・・・〉我が魔導書――〈・・・・・　・〉『ナコト写本』よ！」",
   "cells": [
    {
     "sid": "da1102:T00184",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00023",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00185",
     "kind": "본문",
     "jp": "我が魔導書",
     "ko": "나의 마도서",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00186",
     "kind": "본문",
     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00024",
     "kind": "루비 읽기",
     "jp": "・・・・・　・",
     "ko": "・・・・・　・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00187",
     "kind": "본문",
     "jp": "『ナコト写本』よ",
     "ko": "『나코트 사본』이여",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00188",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00062",
   "speaker": "テリオン",
   "jp": "「〈・・〉来い！〈・・・・・・・〉エセルドレーダ！」",
   "cells": [
    {
     "sid": "da1102:T00189",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00025",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00190",
     "kind": "본문",
     "jp": "来い",
     "ko": "오라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00191",
     "kind": "본문",
     "jp": "！",
     "ko": "!　",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1102:R00026",
     "kind": "루비 읽기",
     "jp": "・・・・・・・",
     "ko": "・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00192",
     "kind": "본문",
     "jp": "エセルドレーダ",
     "ko": "에셀드레이다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00193",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1102:U00063",
   "speaker": "エセルドレーダ",
   "jp": "「イエス・マスター！〈おんまえ〉御前に！」",
   "cells": [
    {
     "sid": "da1102:T00194",
     "kind": "본문",
     "jp": "「イエス・マスター！",
     "ko": "「예스, 마스터!　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00027",
     "kind": "루비 읽기",
     "jp": "おんまえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00195",
     "kind": "본문",
     "jp": "御前",
     "ko": "어전",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1102:T00196",
     "kind": "본문",
     "jp": "に！」",
     "ko": "에!」"
    }
   ]
  },
  {
   "uid": "da1102:U00064",
   "speaker": "ネロ",
   "jp": "「…………っ！？」",
   "cells": [
    {
     "sid": "da1102:T00197",
     "kind": "본문",
     "jp": "「…………っ！？」",
     "ko": "「…………읏!?」"
    }
   ]
  },
  {
   "uid": "da1102:U00065",
   "speaker": "(지문)",
   "jp": "リベル・レギスから放たれた複雑強大な術式が、ネームレス・ワンの防禦陣を兇悪に侵略し、征服した。あれほどの堅牢さを誇っていた防禦陣が、跡形も無く分解される。防禦陣崩壊の余波が、爆発となって２体の鬼械神を襲う。",
   "cells": [
    {
     "sid": "da1102:T00198",
     "kind": "본문",
     "jp": "リベル・レギスから放たれた複雑強大な術式が、ネームレス・ワンの防禦陣を兇悪に侵略し、征服した。",
     "ko": "리베르 레기스에서 방출된 복잡하고도 강대한 술식이, 네임리스 원의 방어진을 흉악하게 침략하여 정복했다."
    },
    {
     "sid": "da1102:T00199",
     "kind": "본문",
     "jp": "あれほどの堅牢さを誇っていた防禦陣が、跡形も無く分解される。",
     "ko": "그토록 견고함을 자랑하던 방어진이 흔적도 없이 분해된다."
    },
    {
     "sid": "da1102:T00200",
     "kind": "본문",
     "jp": "防禦陣崩壊の余波が、爆発となって２体の鬼械神を襲う。",
     "ko": "방어진 붕괴의 여파가 폭발이 되어 두 기의 귀계신을 덮친다."
    }
   ]
  },
  {
   "uid": "da1102:U00066",
   "speaker": "ネロ",
   "jp": "「くっ……！」",
   "cells": [
    {
     "sid": "da1102:T00201",
     "kind": "본문",
     "jp": "「くっ……！」",
     "ko": "「크윽……!」"
    }
   ]
  },
  {
   "uid": "da1102:U00067",
   "speaker": "(지문)",
   "jp": "爆炎が晴れる。リベル・レギスは微動だにせず、其処に立っていた。そして少年――大導師マスターテリオンは、",
   "cells": [
    {
     "sid": "da1102:T00202",
     "kind": "본문",
     "jp": "爆炎が晴れる。",
     "ko": "폭염이 걷힌다."
    },
    {
     "sid": "da1102:T00203",
     "kind": "본문",
     "jp": "リベル・レギスは微動だにせず、其処に立っていた。",
     "ko": "리베르 레기스는 미동조차 하지 않고 그곳에 서 있었다."
    },
    {
     "sid": "da1102:T00204",
     "kind": "본문",
     "jp": "そして少年――大導師マスターテリオンは、",
     "ko": "그리고 소년――대도사 마스터 테리온은,"
    }
   ]
  },
  {
   "uid": "da1102:U00068",
   "speaker": "テリオン",
   "jp": "「そうだ！　貴女の言う通りだ！\n　我等は悪夢。単なる幻影。\n　存在し得ぬ、狂った幻想……」",
   "cells": [
    {
     "sid": "da1102:T00205",
     "kind": "본문",
     "jp": "「そうだ！　貴女の言う通りだ！\n　我等は悪夢。単なる幻影。\n　存在し得ぬ、狂った幻想……」",
     "ko": "「그렇다!　그대의 말대로다!\n　우리들은 악몽. 단순한 환영.\n　존재할 수 없는, 미친 환상……」"
    }
   ]
  },
  {
   "uid": "da1102:U00069",
   "speaker": "テリオン",
   "jp": "「ならばこそ！\n　我等を呪縛するものは何も無い！」",
   "cells": [
    {
     "sid": "da1102:T00206",
     "kind": "본문",
     "jp": "「ならばこそ！\n　我等を呪縛するものは何も無い！」",
     "ko": "「그렇다면 더더욱!\n　우리를 주박하는 것은 아무것도 없다!」"
    }
   ]
  },
  {
   "uid": "da1102:U00070",
   "speaker": "(지문)",
   "jp": "叫ぶマスターテリオンの周囲――リベル・レギスの〈コクピット〉操縦室は濃厚な血の霧に充たされていた。\n\n　むせ返るような血臭は、原初の海の匂い――母の胎内と同じ匂いだ。\n\n　其処は少年を充たした、絶望の〈はじまり〉胎内。",
   "cells": [
    {
     "sid": "da1102:T00207",
     "kind": "본문",
     "jp": "叫ぶマスターテリオンの周囲――リベル・レギスの",
     "ko": "외치는 마스터 테리온의 주위――리베르 레기스의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1102:R00028",
     "kind": "루비 읽기",
     "jp": "コクピット",
     "ko": "콕핏",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1102:T00208",
     "kind": "본문",
     "jp": "操縦室",
