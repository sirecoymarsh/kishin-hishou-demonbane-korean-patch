{
 "packet": "P0073_da0702",
 "units": [
  {
   "uid": "da0702:U00071",
   "speaker": "九郎",
   "jp": "「……やっぱりか」\n\n　紅の少女。『ネクロノミコン血液言語版』。やはりアイツをどうにかしなきゃならんようだ。",
   "cells": [
    {
     "sid": "da0702:T00114",
     "kind": "본문",
     "jp": "「……やっぱりか」\n\n　紅の少女。",
     "ko": "「……역시나인가」\n\n　붉은 소녀."
    },
    {
     "sid": "da0702:T00115",
     "kind": "본문",
     "jp": "『ネクロノミコン血液言語版』。",
     "ko": "『네크로노미콘 혈액언어판』."
    },
    {
     "sid": "da0702:T00116",
     "kind": "본문",
     "jp": "やはりアイツをどうにかしなきゃならんようだ。",
     "ko": "역시 그 녀석을 어떻게든 해야만 하는 모양이다."
    }
   ]
  },
  {
   "uid": "da0702:U00072",
   "speaker": "アル",
   "jp": "「どのみち避けては通れん敵だ」",
   "cells": [
    {
     "sid": "da0702:T00117",
     "kind": "본문",
     "jp": "「どのみち避けては通れん敵だ」",
     "ko": "「어차피 피해 갈 수 없는 적이다」"
    }
   ]
  },
  {
   "uid": "da0702:U00073",
   "speaker": "九郎",
   "jp": "「……そうだな」",
   "cells": [
    {
     "sid": "da0702:T00118",
     "kind": "본문",
     "jp": "「……そうだな」",
     "ko": "「……그렇군」"
    }
   ]
  },
  {
   "uid": "da0702:U00074",
   "speaker": "モーガン",
   "jp": "「ただ注意して下さい。侵攻こそ止まってますが、今も〈ウィルス〉呪毒は『アル・アジフ』に大きな負担をかけています。\n　無茶は禁物です」",
   "cells": [
    {
     "sid": "da0702:T00119",
     "kind": "본문",
     "jp": "「ただ注意して下さい。侵攻こそ止まってますが、今も",
     "ko": "「다만 주의해 주세요. 침공은 멈춰 있지만, 지금도 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0702:R00014",
     "kind": "루비 읽기",
     "jp": "ウィルス",
     "ko": "바이러스는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0702:T00120",
     "kind": "본문",
     "jp": "呪毒",
     "ko": "주독은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0702:T00121",
     "kind": "본문",
     "jp": "は『アル・アジフ』に大きな負担をかけています。\n　無茶は禁物です」",
     "ko": " 『알 아지프』에게 큰 부담을 주고 있습니다.\n　무리는 금물입니다」"
    }
   ]
  },
  {
   "uid": "da0702:U00075",
   "speaker": "九郎",
   "jp": "「ああ、分かっている」",
   "cells": [
    {
     "sid": "da0702:T00122",
     "kind": "본문",
     "jp": "「ああ、分かっている」",
     "ko": "「그래, 알고 있어」"
    }
   ]
  },
  {
   "uid": "da0702:U00076",
   "speaker": "アル",
   "jp": "「……すまぬ。妾が不甲斐ないばかりに」",
   "cells": [
    {
     "sid": "da0702:T00123",
     "kind": "본문",
     "jp": "「……すまぬ。妾が不甲斐ないばかりに」",
     "ko": "「……미안하구나. 이 몸이 못난 탓에」"
    }
   ]
  },
  {
   "uid": "da0702:U00077",
   "speaker": "九郎",
   "jp": "「殊勝なお前は冒涜的に不気味なのでやめろ」",
   "cells": [
    {
     "sid": "da0702:T00124",
     "kind": "본문",
     "jp": "「殊勝なお前は冒涜的に不気味なのでやめろ」",
     "ko": "「기특하게 구는 네 녀석은 모독적으로 기분 나쁘니까 그만둬」"
    }
   ]
  },
  {
   "uid": "da0702:U00078",
   "speaker": "アル",
   "jp": "「貴様」",
   "cells": [
    {
     "sid": "da0702:T00125",
     "kind": "본문",
     "jp": "「貴様」",
     "ko": "「네 이놈」"
    }
   ]
  },
  {
   "uid": "da0702:U00079",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り」",
   "cells": [
    {
     "sid": "da0702:T00126",
     "kind": "본문",
     "jp": "「てけり・り」",
     "ko": "「테케리・리」"
    }
   ]
  },
  {
   "uid": "da0702:U00080",
   "speaker": "九郎",
   "jp": "「……ったく。何を今さら、だ」\n\n　ため息をつきながら、アルの頭を乱暴に撫でる。迷惑そうに顔を〈ひそ〉顰めるアル。でも抵抗はしない。",
   "cells": [
    {
     "sid": "da0702:T00127",
     "kind": "본문",
     "jp": "「……ったく。何を今さら、だ」\n\n　ため息をつきながら、アルの頭を乱暴に撫でる。",
     "ko": "「……참 나. 뭘 새삼스럽게 그래」\n\n　한숨을 내쉬며 알의 머리를 난폭하게 쓰다듬는다."
    },
    {
     "sid": "da0702:T00128",
     "kind": "본문",
     "jp": "迷惑そうに顔を",
     "ko": "성가시다는 듯 얼굴을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0702:R00015",
     "kind": "루비 읽기",
     "jp": "ひそ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0702:T00129",
     "kind": "본문",
     "jp": "顰",
     "ko": "찌푸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0702:T00130",
     "kind": "본문",
     "jp": "めるアル。",
     "ko": "리는 알."
    },
    {
     "sid": "da0702:T00131",
     "kind": "본문",
     "jp": "でも抵抗はしない。",
     "ko": "하지만 저항하지는 않는다."
    }
   ]
  },
  {
   "uid": "da0702:U00081",
   "speaker": "アル",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0702:T00132",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0702:U00082",
   "speaker": "九郎",
   "jp": "「迷惑なんて今に始まったことじゃねえだろ。\n　毎度のことだ、バカタレ」",
   "cells": [
    {
     "sid": "da0702:T00133",
     "kind": "본문",
     "jp": "「迷惑なんて今に始まったことじゃねえだろ。\n　毎度のことだ、バカタレ」",
     "ko": "「폐 끼치는 건 어제오늘 일이 아니잖아.\n　늘 있는 일이다, 바보 녀석」"
    }
   ]
  },
  {
   "uid": "da0702:U00083",
   "speaker": "アル",
   "jp": "「……うぬぬ」",
   "cells": [
    {
     "sid": "da0702:T00134",
     "kind": "본문",
     "jp": "「……うぬぬ」",
     "ko": "「……으으으」"
    }
   ]
  },
  {
   "uid": "da0702:U00084",
   "speaker": "九郎",
   "jp": "「こんなんで気を遣い合うほど殊勝な関係か、俺たちが？\n　ふてぶてしくしてろ、いつもどおりに」",
   "cells": [
    {
     "sid": "da0702:T00135",
     "kind": "본문",
     "jp": "「こんなんで気を遣い合うほど殊勝な関係か、俺たちが？\n　ふてぶてしくしてろ、いつもどおりに」",
     "ko": "「이런 걸로 서로 신경 써 줄 만큼 얌전한 사이냐, 우리가?\n　뻔뻔하게 굴어라, 평소처럼」"
    }
   ]
  },
  {
   "uid": "da0702:U00085",
   "speaker": "アル",
   "jp": "「ん……解かった」",
   "cells": [
    {
     "sid": "da0702:T00136",
     "kind": "본문",
     "jp": "「ん……解かった」",
     "ko": "「음…… 알았다」"
    }
   ]
  },
  {
   "uid": "da0702:U00086",
   "speaker": "(지문)",
   "jp": "ようやく安心したように微笑むアル。そんな俺たちの様子を見て、先生たちが苦笑する。\n\n　まあ、こんなもんさ。邪神相手の戦いでも〈シリアス〉深刻やれねえ俺たちだ。\n\n　このノリはもう変えようがない。〈ハッピー〉楽天主義＆〈イージー〉ご都合主義貫くしかあるめえよ。",
   "cells": [
    {
     "sid": "da0702:T00137",
     "kind": "본문",
     "jp": "ようやく安心したように微笑むアル。",
     "ko": "그제야 안심한 듯 미소 짓는 알."
    },
    {
     "sid": "da0702:T00138",
     "kind": "본문",
     "jp": "そんな俺たちの様子を見て、先生たちが苦笑する。\n\n　まあ、こんなもんさ。",
     "ko": "그런 우리의 모습을 보고 선생 일행이 쓴웃음을 짓는다.\n\n　뭐, 이런 거지."
    },
    {
     "sid": "da0702:T00139",
     "kind": "본문",
     "jp": "邪神相手の戦いでも",
     "ko": "사신 상대의 싸움에서도 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0702:R00016",
     "kind": "루비 읽기",
     "jp": "シリアス",
     "ko": "시리어스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0702:T00140",
     "kind": "본문",
     "jp": "深刻",
     "ko": "심각",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0702:T00141",
     "kind": "본문",
     "jp": "やれねえ俺たちだ。\n\n　このノリはもう変えようがない。",
     "ko": "해지지 못하는 우리다.\n\n　이 분위기는 이제 바꿀 도리가 없다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0702:R00017",
     "kind": "루비 읽기",
     "jp": "ハッピー",
     "ko": "해피",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0702:T00142",
     "kind": "본문",
     "jp": "楽天主義",
     "ko": "낙천주의",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0702:T00143",
     "kind": "본문",
     "jp": "＆",
     "ko": " & ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0702:R00018",
     "kind": "루비 읽기",
     "jp": "イージー",
     "ko": "이지",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0702:T00144",
     "kind": "본문",
     "jp": "ご都合主義",
     "ko": "편의주의",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0702:T00145",
     "kind": "본문",
     "jp": "貫くしかあるめえよ。",
     "ko": "를 관철할 수밖에 없지."
    }
   ]
  },
  {
   "uid": "da0702:U00087",
   "speaker": "九郎",
   "jp": "「何とかなるさ……デモンベインとみんながいる限りな」\n\n　デモンベインと共に戦った仲間たち。それはかつての『絆』。\n\n　正しい時間の流れの代わりに、失ったはずの『絆』だ。これだけのオールキャストっぷりだ。負ける道理が見当たらない。\n\n　……『絆』か。\n\n　気にかかることもある。俺が知らない人ら……アズラッドは過去のマスター・オブ・ネクロノミコンだから良いとして、もう一人――彼の正体だけは、未だに不明なのだ。",
   "cells": [
    {
     "sid": "da0702:T00146",
     "kind": "본문",
     "jp": "「何とかなるさ……デモンベインとみんながいる限りな」\n\n　デモンベインと共に戦った仲間たち。",
     "ko": "「어떻게든 될 거야…… 데몬베인과 모두가 있는 한은 말이지」\n\n　데몬베인과 함께 싸운 동료들."
    },
    {
     "sid": "da0702:T00147",
     "kind": "본문",
     "jp": "それはかつての『絆』。\n\n　正しい時間の流れの代わりに、失ったはずの『絆』だ。",
     "ko": "그것은 한때의 『유대』.\n\n　올바른 시간의 흐름 대신에 잃어버렸을 『유대』다."
    },
    {
     "sid": "da0702:T00148",
     "kind": "본문",
     "jp": "これだけのオールキャストっぷりだ。",
     "ko": "이만한 올캐스트 총출동이다."
    },
    {
     "sid": "da0702:T00149",
     "kind": "본문",
     "jp": "負ける道理が見当たらない。\n\n　……『絆』か。\n\n　気にかかることもある。",
     "ko": "질 도리가 보이지 않는다.\n\n　……『유대』라.\n\n　마음에 걸리는 것도 있다."
    },
    {
     "sid": "da0702:T00150",
     "kind": "본문",
     "jp": "俺が知らない人ら……アズラッドは過去のマスター・オブ・ネクロノミコンだから良いとして、もう一人――彼の正体だけは、未だに不明なのだ。",
     "ko": "내가 모르는 사람들…… 아즈라드는 과거의 마스터 오브 네크로노미콘이니까 그렇다 쳐도, 또 한 사람――그의 정체만은 아직도 불명이다."
    }
   ]
  },
  {
   "uid": "da0702:U00088",
   "speaker": "九郎",
   "jp": "（九朔……か）\n\n　あの少年が今回の事件に、\n　大きく関与しているのは間違いない――。",
   "cells": [
    {
     "sid": "da0702:T00151",
     "kind": "본문",
     "jp": "（九朔……か）\n\n　あの少年が今回の事件に、\n　大きく関与しているのは間違いない――。",
     "ko": "(쿠자쿠……인가)\n\n　그 소년이 이번 사건에\n　크게 관여하고 있는 것은 틀림없다――."
    }
   ]
  }
 ]
}