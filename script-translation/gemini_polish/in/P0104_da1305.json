{
 "packet": "P0104_da1305",
 "units": [
  {
   "uid": "da1305:U00001",
   "speaker": "(지문)",
   "jp": "〈ほど〉解けてゆく。アルの存在が解けて、血の霧と化す。紅霧は二重螺旋の渦を巻き、新たな〈カタチ〉容を編み上げる。少女の容を――〈アナザーブラッド〉紅の少女の容を再構築する。",
   "cells": [
    {
     "sid": "da1305:R00001",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00001",
     "kind": "본문",
     "jp": "解",
     "ko": "풀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00002",
     "kind": "본문",
     "jp": "けてゆく。",
     "ko": "려 간다."
    },
    {
     "sid": "da1305:T00003",
     "kind": "본문",
     "jp": "アルの存在が解けて、血の霧と化す。",
     "ko": "알의 존재가 풀려 피안개로 화한다."
    },
    {
     "sid": "da1305:T00004",
     "kind": "본문",
     "jp": "紅霧は二重螺旋の渦を巻き、新たな",
     "ko": "붉은 안개는 이중나선의 소용돌이를 치며 새로운 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00002",
     "kind": "루비 읽기",
     "jp": "カタチ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00005",
     "kind": "본문",
     "jp": "容",
     "ko": "형상",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00006",
     "kind": "본문",
     "jp": "を編み上げる。",
     "ko": "을 엮어 올린다."
    },
    {
     "sid": "da1305:T00007",
     "kind": "본문",
     "jp": "少女の容を――",
     "ko": "소녀의 형상을――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00003",
     "kind": "루비 읽기",
     "jp": "アナザーブラッド",
     "ko": "어나더 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00008",
     "kind": "본문",
     "jp": "紅の少女",
     "ko": "붉은 소녀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00009",
     "kind": "본문",
     "jp": "の容を再構築する。",
     "ko": "의 형상을 재구축한다."
    }
   ]
  },
  {
   "uid": "da1305:U00002",
   "speaker": "九郎",
   "jp": "「ア……アル……」",
   "cells": [
    {
     "sid": "da1305:T00010",
     "kind": "본문",
     "jp": "「ア……アル……」",
     "ko": "「아…… 알……」"
    }
   ]
  },
  {
   "uid": "da1305:U00003",
   "speaker": "(지문)",
   "jp": "俺に一瞥だけくれて、紅の少女はモニターの向こう、倒れた\nＤトゥーソードを見つめる。",
   "cells": [
    {
     "sid": "da1305:T00011",
     "kind": "본문",
     "jp": "俺に一瞥だけくれて、紅の少女はモニターの向こう、倒れた\nＤトゥーソードを見つめる。",
     "ko": "나에게 일별만을 던지고, 붉은 소녀는 모니터 너머 쓰러진\nD 투 소드를 바라본다."
    }
   ]
  },
  {
   "uid": "da1305:U00004",
   "speaker": "(지문)",
   "jp": "血染めのデモンベインが、二闘流のデモンベインを見下ろす。",
   "cells": [
    {
     "sid": "da1305:T00012",
     "kind": "본문",
     "jp": "血染めのデモンベインが、二闘流のデモンベインを見下ろす。",
     "ko": "피로 물든 데몬베인이 이투류의 데몬베인을 내려다본다."
    }
   ]
  },
  {
   "uid": "da1305:U00005",
   "speaker": "アナザーブラッド",
   "jp": "「はぁい、そこまでよ九朔ぅ。\n　貴方の出番はこれでおしまい」",
   "cells": [
    {
     "sid": "da1305:T00013",
     "kind": "본문",
     "jp": "「はぁい、そこまでよ九朔ぅ。\n　貴方の出番はこれでおしまい」",
     "ko": "「자아, 거기까지야 쿠자쿠우.\n　당신의 차례는 이걸로 끝」"
    }
   ]
  },
  {
   "uid": "da1305:U00006",
   "speaker": "九朔",
   "jp": "「アナザー……ブラッド……！」",
   "cells": [
    {
     "sid": "da1305:T00014",
     "kind": "본문",
     "jp": "「アナザー……ブラッド……！」",
     "ko": "「어나더…… 블러드……!」"
    }
   ]
  },
  {
   "uid": "da1305:U00007",
   "speaker": "アナザーブラッド",
   "jp": "「違うでしょ？」",
   "cells": [
    {
     "sid": "da1305:T00015",
     "kind": "본문",
     "jp": "「違うでしょ？」",
     "ko": "「틀렸잖아?」"
    }
   ]
  },
  {
   "uid": "da1305:U00008",
   "speaker": "(지문)",
   "jp": "デモンベインがＤトゥーソードを踏みつける。砕ける装甲。〈アゾート〉水銀の血が噴き出し、紫電が迸る。",
   "cells": [
    {
     "sid": "da1305:T00016",
     "kind": "본문",
     "jp": "デモンベインがＤトゥーソードを踏みつける。",
     "ko": "데몬베인이 D 투 소드를 짓밟는다."
    },
    {
     "sid": "da1305:T00017",
     "kind": "본문",
     "jp": "砕ける装甲。",
     "ko": "부서지는 장갑.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00004",
     "kind": "루비 읽기",
     "jp": "アゾート",
     "ko": "아조트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00018",
     "kind": "본문",
     "jp": "水銀",
     "ko": "수은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00019",
     "kind": "본문",
     "jp": "の血が噴き出し、紫電が迸る。",
     "ko": "의 피가 뿜어져 나오고 보랏빛 번개가 솟구친다."
    }
   ]
  },
  {
   "uid": "da1305:U00009",
   "speaker": "九朔",
   "jp": "「ぐあああああああ！」",
   "cells": [
    {
     "sid": "da1305:T00020",
     "kind": "본문",
     "jp": "「ぐあああああああ！」",
     "ko": "「그아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1305:U00010",
   "speaker": "アナザーブラッド",
   "jp": "「今や〈アナザー〉違えた血は貴方よ、九朔。\n　未来は私に繋がった。\n　悪徳に〈ねじまが〉螺旋禍った、私の未来に」",
   "cells": [
    {
     "sid": "da1305:T00021",
     "kind": "본문",
     "jp": "「今や",
     "ko": "「이제 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00005",
     "kind": "루비 읽기",
     "jp": "アナザー",
     "ko": "어나더",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00022",
     "kind": "본문",
     "jp": "違えた血",
     "ko": "어긋난 피",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00023",
     "kind": "본문",
     "jp": "は貴方よ、九朔。\n　未来は私に繋がった。\n　悪徳に",
     "ko": "는 당신이야, 쿠자쿠.\n　미래는 나에게 이어졌어.\n　악덕으로 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00006",
     "kind": "루비 읽기",
     "jp": "ねじまが",
     "ko": "왜곡",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00024",
     "kind": "본문",
     "jp": "螺旋禍",
     "ko": "나선화",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00025",
     "kind": "본문",
     "jp": "った、私の未来に」",
     "ko": "된, 나의 미래에」"
    }
   ]
  },
  {
   "uid": "da1305:U00011",
   "speaker": "アナザーブラッド",
   "jp": "「ついに〈シャドウ〉虚構が〈リアル〉実存を凌駕したのよ\n　……ははは……あははははっ！〈フェイク〉贋者はあんただ、九朔！\n　みじめで哀れな、私の〈シャドウ〉幻影！」",
   "cells": [
    {
     "sid": "da1305:T00026",
     "kind": "본문",
     "jp": "「ついに",
     "ko": "「마침내 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00007",
     "kind": "루비 읽기",
     "jp": "シャドウ",
     "ko": "섀도",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00027",
     "kind": "본문",
     "jp": "虚構",
     "ko": "허구",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00028",
     "kind": "본문",
     "jp": "が",
     "ko": "가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00008",
     "kind": "루비 읽기",
     "jp": "リアル",
     "ko": "리얼",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00029",
     "kind": "본문",
     "jp": "実存",
     "ko": "실존",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00030",
     "kind": "본문",
     "jp": "を凌駕したのよ\n　……ははは……あははははっ！",
     "ko": "을 능가한 거야\n　……하하하…… 아하하하핫!\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00009",
     "kind": "루비 읽기",
     "jp": "フェイク",
     "ko": "페이크",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00031",
     "kind": "본문",
     "jp": "贋者",
     "ko": "가짜",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00032",
     "kind": "본문",
     "jp": "はあんただ、九朔！\n　みじめで哀れな、私の",
     "ko": "는 네 녀석이다, 쿠자쿠!\n　비참하고 가엾은, 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00010",
     "kind": "루비 읽기",
     "jp": "シャドウ",
     "ko": "섀도",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00033",
     "kind": "본문",
     "jp": "幻影",
     "ko": "환영",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00034",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1305:U00012",
   "speaker": "九朔",
   "jp": "「ぐ……あ……\n　はぁ……あああああああッ！」",
   "cells": [
    {
     "sid": "da1305:T00035",
     "kind": "본문",
     "jp": "「ぐ……あ……\n　はぁ……あああああああッ！」",
     "ko": "「그…… 아……\n　하아…… 아아아아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da1305:U00013",
   "speaker": "(지문)",
   "jp": "踏まれたＤトゥーソードが爆ぜた。噴き出る血は〈アゾート〉水銀の雨となって、降り注ぐ。血染めの機体が、銀色の血に濡れる。",
   "cells": [
    {
     "sid": "da1305:T00036",
     "kind": "본문",
     "jp": "踏まれたＤトゥーソードが爆ぜた。",
     "ko": "짓밟힌 D 투 소드가 터져 나갔다."
    },
    {
     "sid": "da1305:T00037",
     "kind": "본문",
     "jp": "噴き出る血は",
     "ko": "뿜어져 나오는 피는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00011",
     "kind": "루비 읽기",
     "jp": "アゾート",
     "ko": "아조트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00038",
     "kind": "본문",
     "jp": "水銀",
     "ko": "수은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00039",
     "kind": "본문",
     "jp": "の雨となって、降り注ぐ。",
     "ko": "의 비가 되어 쏟아져 내린다."
    },
    {
     "sid": "da1305:T00040",
     "kind": "본문",
     "jp": "血染めの機体が、銀色の血に濡れる。",
     "ko": "피로 물든 기체가 은빛 피에 젖는다."
    }
   ]
  },
  {
   "uid": "da1305:U00014",
   "speaker": "アナザーブラッド",
   "jp": "「……我侭なのよ、貴方。親に棄て\nられた？　そう、それは可哀想ね。\nでも……それでも貴方は愛されて\n育った！」",
   "cells": [
    {
     "sid": "da1305:T00041",
     "kind": "본문",
     "jp": "「……我侭なのよ、貴方。親に棄て\nられた？　そう、それは可哀想ね。\nでも……それでも貴方は愛されて\n育った！」",
     "ko": "「……제멋대로야, 당신. 부모에게 버림\n받았다고?　그래, 그건 불쌍하네.\n하지만…… 그래도 당신은 사랑받으며\n자랐어!」"
    }
   ]
  },
  {
   "uid": "da1305:U00015",
   "speaker": "アナザーブラッド",
   "jp": "「私には与えられなかった！\n　与えられたのは〈ノロイ〉呪詛だけだ！\n　失われた〈セカイ〉物語の怨嗟を、\n　私は詰め込まれた！」",
   "cells": [
    {
     "sid": "da1305:T00042",
     "kind": "본문",
     "jp": "「私には与えられなかった！\n　与えられたのは",
     "ko": "「나에게는 주어지지 않았어!\n　주어진 것은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00012",
     "kind": "루비 읽기",
     "jp": "ノロイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00043",
     "kind": "본문",
     "jp": "呪詛",
     "ko": "저주",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00044",
     "kind": "본문",
     "jp": "だけだ！\n　失われた",
     "ko": "뿐이다!\n　상실된 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00013",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00045",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00046",
     "kind": "본문",
     "jp": "の怨嗟を、\n　私は詰め込まれた！」",
     "ko": "의 원망이,\n　내 안에 쑤셔 박혔어!」"
    }
   ]
  },
  {
   "uid": "da1305:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「私は！\n　　邪悪として断絶された！」",
   "cells": [
    {
     "sid": "da1305:T00047",
     "kind": "본문",
     "jp": "「私は！\n　　邪悪として断絶された！」",
     "ko": "「나는!\n　　사악으로서 단절되었어!」"
    }
   ]
  },
  {
   "uid": "da1305:U00017",
   "speaker": "九朔",
   "jp": "「が……は……ッ！」",
   "cells": [
    {
     "sid": "da1305:T00048",
     "kind": "본문",
     "jp": "「が……は……ッ！」",
     "ko": "「크…… 학…… 읏!」"
    }
   ]
  },
  {
   "uid": "da1305:U00018",
   "speaker": "アナザーブラッド",
   "jp": "「……だから私は貴方から奪うわ。\n　何もかも。貴方が存在したという\n　事実自体を。そして――」",
   "cells": [
    {
     "sid": "da1305:T00049",
     "kind": "본문",
     "jp": "「……だから私は貴方から奪うわ。\n　何もかも。貴方が存在したという\n　事実自体を。そして――」",
     "ko": "「……그러니까 나는 당신에게서 빼앗겠어.\n　모든 것을. 당신이 존재했다는\n　사실 자체를. 그리고――」"
    }
   ]
  },
  {
   "uid": "da1305:U00019",
   "speaker": "アナザーブラッド",
   "jp": "「貴方が一番欲しかったものも手に入れる\n……さあ、愛してくださいまし、お父様」",
   "cells": [
    {
     "sid": "da1305:T00050",
     "kind": "본문",
     "jp": "「貴方が一番欲しかったものも手に入れる\n……さあ、愛してくださいまし、お父様」",
     "ko": "「당신이 가장 원했던 것도 손에 넣겠어\n……자, 사랑해 주시어요, 아버님」"
    }
   ]
  },
  {
   "uid": "da1305:U00020",
   "speaker": "九郎",
   "jp": "「てめえ……！」",
   "cells": [
    {
     "sid": "da1305:T00051",
     "kind": "본문",
     "jp": "「てめえ……！」",
     "ko": "「네 녀석……!」"
    }
   ]
  },
  {
   "uid": "da1305:U00021",
   "speaker": "(지문)",
   "jp": "視線が交わる。艶然と嗤う紅の少女は、酷く不吉に見えた。俺は反射的に身構えて――",
   "cells": [
    {
     "sid": "da1305:T00052",
     "kind": "본문",
     "jp": "視線が交わる。",
     "ko": "시선이 교차한다."
    },
    {
     "sid": "da1305:T00053",
     "kind": "본문",
     "jp": "艶然と嗤う紅の少女は、酷く不吉に見えた。",
     "ko": "요염하게 비웃는 붉은 소녀는 지독히도 불길해 보였다."
    },
    {
     "sid": "da1305:T00054",
     "kind": "본문",
     "jp": "俺は反射的に身構えて――",
     "ko": "나는 반사적으로 자세를 잡고――"
    }
   ]
  },
  {
   "uid": "da1305:U00022",
   "speaker": "九郎",
   "jp": "「な……ッ！？」\n\n　マギウス・スタイルが〈ほど〉解呪ける。黒衣は真紅の糸になって螺旋を描き、新しい〈スタイル〉装束を編み上げた。〈ブラッド　ストレイト・ジャケット〉紅の拘束服。",
   "cells": [
    {
     "sid": "da1305:T00055",
     "kind": "본문",
     "jp": "「な……ッ！？」\n\n　マギウス・スタイルが",
     "ko": "「뭐…… 읏!?」\n\n　마기우스 스타일이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00014",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "해제",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00056",
     "kind": "본문",
     "jp": "解呪",
     "ko": "해주",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00057",
     "kind": "본문",
     "jp": "ける。",
     "ko": "된다."
    },
    {
     "sid": "da1305:T00058",
     "kind": "본문",
     "jp": "黒衣は真紅の糸になって螺旋を描き、新しい",
     "ko": "흑의는 진홍빛 실이 되어 나선을 그리며 새로운 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00015",
     "kind": "루비 읽기",
     "jp": "スタイル",
     "ko": "스타일",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00059",
     "kind": "본문",
     "jp": "装束",
     "ko": "장속",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00060",
     "kind": "본문",
     "jp": "を編み上げた。",
     "ko": "을 엮어 올렸다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00016",
     "kind": "루비 읽기",
     "jp": "ブラッド　ストレイト・ジャケット",
     "ko": "블러드　스트레이트 재킷",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00061",
     "kind": "본문",
     "jp": "紅の拘束服",
     "ko": "붉은 구속복",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00062",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1305:U00023",
   "speaker": "九郎",
   "jp": "「ぐ……があ……ッ！」",
   "cells": [
    {
     "sid": "da1305:T00063",
     "kind": "본문",
     "jp": "「ぐ……があ……ッ！」",
     "ko": "「그…… 크아…… 읏!」"
    }
   ]
  },
  {
   "uid": "da1305:U00024",
   "speaker": "(지문)",
   "jp": "全身をきつく締め付けられ、不様に床を転がった。近寄ってきた紅の少女が傍らに立ち、俺を見下ろす。",
   "cells": [
    {
     "sid": "da1305:T00064",
     "kind": "본문",
     "jp": "全身をきつく締め付けられ、不様に床を転がった。",
     "ko": "온몸이 꽉 죄여 볼썽사납게 바닥을 굴렀다."
    },
    {
     "sid": "da1305:T00065",
     "kind": "본문",
     "jp": "近寄ってきた紅の少女が傍らに立ち、俺を見下ろす。",
     "ko": "다가온 붉은 소녀가 곁에 서서 나를 내려다본다."
    }
   ]
  },
  {
   "uid": "da1305:U00025",
   "speaker": "アナザーブラッド",
   "jp": "「〈アル・アジフ〉お母様が私に取り込まれた今、貴方に与えられている〈ちから〉呪力も、私のものなのよ。お父様？」",
   "cells": [
    {
     "sid": "da1305:T00066",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1305:R00017",
     "kind": "루비 읽기",
     "jp": "アル・アジフ",
     "ko": "알 아지프가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00067",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00068",
     "kind": "본문",
     "jp": "が私に取り込まれた今、貴方に与えられている",
     "ko": " 나에게 집어삼켜진 지금, 당신에게 부여된 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00018",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00069",
     "kind": "본문",
     "jp": "呪力",
     "ko": "주력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00070",
     "kind": "본문",
     "jp": "も、私のものなのよ。お父様？」",
     "ko": "도 나의 것이란다. 아버님?」"
    }
   ]
  },
  {
   "uid": "da1305:U00026",
   "speaker": "九郎",
   "jp": "「ざけん……な！\n　アルを……元に、戻せ……ッ！」",
   "cells": [
    {
     "sid": "da1305:T00071",
     "kind": "본문",
     "jp": "「ざけん……な！\n　アルを……元に、戻せ……ッ！」",
     "ko": "「웃기지…… 마!\n　알을…… 원래대로, 되돌려 놔…… 읏!」"
    }
   ]
  },
  {
   "uid": "da1305:U00027",
   "speaker": "アナザーブラッド",
   "jp": "「〈わか〉理解ってないわね、お父様……」",
   "cells": [
    {
     "sid": "da1305:T00072",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1305:R00019",
     "kind": "루비 읽기",
     "jp": "わか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00073",
     "kind": "본문",
     "jp": "理解",
     "ko": "이해하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00074",
     "kind": "본문",
     "jp": "ってないわね、お父様……」",
     "ko": "지 못하고 계시네, 아버님……」"
    }
   ]
  },
  {
   "uid": "da1305:U00028",
   "speaker": "(지문)",
   "jp": "紅の少女が、俺の上に覆い被さる。頬を上気させ、陶然とした瞳で、囁きかける。熱い吐息。",
   "cells": [
    {
     "sid": "da1305:T00075",
     "kind": "본문",
     "jp": "紅の少女が、俺の上に覆い被さる。",
     "ko": "붉은 소녀가 내 위로 덮쳐 올라온다."
    },
    {
     "sid": "da1305:T00076",
     "kind": "본문",
     "jp": "頬を上気させ、陶然とした瞳で、囁きかける。",
     "ko": "뺨을 붉히고 도취된 눈동자로 속삭인다."
    },
    {
     "sid": "da1305:T00077",
     "kind": "본문",
     "jp": "熱い吐息。",
     "ko": "뜨거운 숨결."
    }
   ]
  },
  {
   "uid": "da1305:U00029",
   "speaker": "アナザーブラッド",
   "jp": "「お母様は私の〈・・〉血肉となった……\n　アル・アジフはもう存在しない。\n　いえ、私自身がアル・アジフよ」",
   "cells": [
    {
     "sid": "da1305:T00078",
     "kind": "본문",
     "jp": "「お母様は私の",
     "ko": "「어머님은 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00020",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00079",
     "kind": "본문",
     "jp": "血肉",
     "ko": "피와 살",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00080",
     "kind": "본문",
     "jp": "となった……\n　アル・アジフはもう存在しない。\n　いえ、私自身がアル・アジフよ」",
     "ko": "이 되었어……\n　알 아지프는 이제 존재하지 않아.\n　아니, 나 자신이 알 아지프야」"
    }
   ]
  },
  {
   "uid": "da1305:U00030",
   "speaker": "アナザーブラッド",
   "jp": "「そう、私は貴方の娘であり……\n　貴方の妻でもある」",
   "cells": [
    {
     "sid": "da1305:T00081",
     "kind": "본문",
     "jp": "「そう、私は貴方の娘であり……\n　貴方の妻でもある」",
     "ko": "「그래, 나는 당신의 딸이자……\n　당신의 아내이기도 해」"
    }
   ]
  },
  {
   "uid": "da1305:U00031",
   "speaker": "(지문)",
   "jp": "唇が重ねられた。熱く濡れた舌が入ってくる。俺の舌を絡め取り、嬲り、啜り、貪る。",
   "cells": [
    {
     "sid": "da1305:T00082",
     "kind": "본문",
     "jp": "唇が重ねられた。",
     "ko": "입술이 포개어졌다."
    },
    {
     "sid": "da1305:T00083",
     "kind": "본문",
     "jp": "熱く濡れた舌が入ってくる。",
     "ko": "뜨겁고 젖은 혀가 들어온다."
    },
    {
     "sid": "da1305:T00084",
     "kind": "본문",
     "jp": "俺の舌を絡め取り、嬲り、啜り、貪る。",
     "ko": "내 혀를 휘감아 잡고, 희롱하고, 빨아들이고, 탐한다."
    }
   ]
  },
  {
   "uid": "da1305:U00032",
   "speaker": "アナザーブラッド",
   "jp": "「ん……ふぅんんっ……ちゅ。\n　……うぅん……んんん……っ」",
   "cells": [
    {
     "sid": "da1305:T00085",
     "kind": "본문",
     "jp": "「ん……ふぅんんっ……ちゅ。\n　……うぅん……んんん……っ」",
     "ko": "「응…… 후으응읏…… 츄.\n　……우으응…… 응응응…… 읏」"
    }
   ]
  },
  {
   "uid": "da1305:U00033",
   "speaker": "(지문)",
   "jp": "少女の舌は、甘い血の味がした。じんじんと頭が痺れるような酩酊感に苛まれる。",
   "cells": [
    {
     "sid": "da1305:T00086",
     "kind": "본문",
     "jp": "少女の舌は、甘い血の味がした。",
     "ko": "소녀의 혀는 달콤한 피 맛이 났다."
    },
    {
     "sid": "da1305:T00087",
     "kind": "본문",
     "jp": "じんじんと頭が痺れるような酩酊感に苛まれる。",
     "ko": "찌릿찌릿 머리가 저리는 듯한 명정감에 시달린다."
    }
   ]
  },
  {
   "uid": "da1305:U00034",
   "speaker": "アナザーブラッド",
   "jp": "「ん……んん……く……ぷはぁ……」",
   "cells": [
    {
     "sid": "da1305:T00088",
     "kind": "본문",
     "jp": "「ん……んん……く……ぷはぁ……」",
     "ko": "「응…… 응응…… 큭…… 푸하아……」"
    }
   ]
  },
  {
   "uid": "da1305:U00035",
   "speaker": "(지문)",
   "jp": "唇が離れる。最後まで絡み合っていた舌が、名残惜しそうに〈ほど〉解けた。",
   "cells": [
    {
     "sid": "da1305:T00089",
     "kind": "본문",
     "jp": "唇が離れる。",
     "ko": "입술이 떨어진다."
    },
    {
     "sid": "da1305:T00090",
     "kind": "본문",
     "jp": "最後まで絡み合っていた舌が、名残惜しそうに",
     "ko": "마지막까지 뒤얽혀 있던 혀가 아쉬운 듯이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00021",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00091",
     "kind": "본문",
     "jp": "解",
     "ko": "풀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00092",
     "kind": "본문",
     "jp": "けた。",
     "ko": "렸다."
    }
   ]
  },
  {
   "uid": "da1305:U00036",
   "speaker": "九郎",
   "jp": "「く……ぅぅ……っ」",
   "cells": [
    {
     "sid": "da1305:T00093",
     "kind": "본문",
     "jp": "「く……ぅぅ……っ」",
     "ko": "「크…… 으으…… 읏」"
    }
   ]
  },
  {
   "uid": "da1305:U00037",
   "speaker": "アナザーブラッド",
   "jp": "「ふふ……」",
   "cells": [
    {
     "sid": "da1305:T00094",
     "kind": "본문",
     "jp": "「ふふ……」",
     "ko": "「후후……」"
    }
   ]
  },
  {
   "uid": "da1305:U00038",
   "speaker": "(지문)",
   "jp": "見下ろす〈ルビー〉紅玉の瞳が妖しく、獰猛な輝きを宿す。獲物を捕らえて嬲る、猫科の猛獣の瞳。細く、しなやかな指が撫でる。頬を、唇を、首筋を、鎖骨を、胸板を、臍を。触れるか触れないかの弱さで。くすぐるように。弄ぶのだ。",
   "cells": [
    {
     "sid": "da1305:T00095",
     "kind": "본문",
     "jp": "見下ろす",
     "ko": "내려다보는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00022",
     "kind": "루비 읽기",
     "jp": "ルビー",
     "ko": "루비",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00096",
     "kind": "본문",
     "jp": "紅玉",
     "ko": "홍옥",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00097",
     "kind": "본문",
     "jp": "の瞳が妖しく、獰猛な輝きを宿す。",
     "ko": "의 눈동자가 요염하고도 사나운 반짝임을 품는다."
    },
    {
     "sid": "da1305:T00098",
     "kind": "본문",
     "jp": "獲物を捕らえて嬲る、猫科の猛獣の瞳。",
     "ko": "사냥감을 붙잡아 희롱하는 고양잇과 맹수의 눈동자."
    },
    {
     "sid": "da1305:T00099",
     "kind": "본문",
     "jp": "細く、しなやかな指が撫でる。",
     "ko": "가늘고 유연한 손가락이 어루만진다."
    },
    {
     "sid": "da1305:T00100",
     "kind": "본문",
     "jp": "頬を、",
     "ko": "뺨을,"
    },
    {
     "sid": "da1305:T00101",
     "kind": "본문",
     "jp": "唇を、",
     "ko": " 입술을,"
    },
    {
     "sid": "da1305:T00102",
     "kind": "본문",
     "jp": "首筋を、",
     "ko": " 목덜미를,"
    },
    {
     "sid": "da1305:T00103",
     "kind": "본문",
     "jp": "鎖骨を、",
     "ko": " 쇄골을,"
    },
    {
     "sid": "da1305:T00104",
     "kind": "본문",
     "jp": "胸板を、",
     "ko": " 가슴팍을,"
    },
    {
     "sid": "da1305:T00105",
     "kind": "본문",
     "jp": "臍を。",
     "ko": " 배꼽을."
    },
    {
     "sid": "da1305:T00106",
     "kind": "본문",
     "jp": "触れるか触れないかの弱さで。",
     "ko": "닿을락 말락 한 미약한 힘으로."
    },
    {
     "sid": "da1305:T00107",
     "kind": "본문",
     "jp": "くすぐるように。",
     "ko": "간지럽히듯이."
    },
    {
     "sid": "da1305:T00108",
     "kind": "본문",
     "jp": "弄ぶのだ。",
     "ko": " 가지고 논다."
    }
   ]
  },
  {
   "uid": "da1305:U00039",
   "speaker": "アナザーブラッド",
   "jp": "「……お父様」",
   "cells": [
    {
     "sid": "da1305:T00109",
     "kind": "본문",
     "jp": "「……お父様」",
     "ko": "「……아버님」"
    }
   ]
  },
  {
   "uid": "da1305:U00040",
   "speaker": "(지문)",
   "jp": "訴える。陶然とした、熱に浮かされた声で。",
   "cells": [
    {
     "sid": "da1305:T00110",
     "kind": "본문",
     "jp": "訴える。",
     "ko": "호소한다."
    },
    {
     "sid": "da1305:T00111",
     "kind": "본문",
     "jp": "陶然とした、熱に浮かされた声で。",
     "ko": "도취된, 열기에 들뜬 목소리로."
    }
   ]
  },
  {
   "uid": "da1305:U00041",
   "speaker": "アナザーブラッド",
   "jp": "「お父様。お父様。お父様。\n　触れてください。撫でてください。\n　抱き締めてください。強く。強く」",
   "cells": [
    {
     "sid": "da1305:T00112",
     "kind": "본문",
     "jp": "「お父様。お父様。お父様。\n　触れてください。撫でてください。\n　抱き締めてください。強く。強く」",
     "ko": "「아버님. 아버님. 아버님.\n　만져 주세요. 어루만져 주세요.\n　껴안아 주세요. 강하게. 강하게」"
    }
   ]
  },
  {
   "uid": "da1305:U00042",
   "speaker": "アナザーブラッド",
   "jp": "「口づけ、〈ねぶ〉舐り、味わい、嗅ぎ取り、掴み、\n転がし、掻き回し、掻き乱し、嬲り、傷つけ、\n突き立て、刺し貫いてください」",
   "cells": [
    {
     "sid": "da1305:T00113",
     "kind": "본문",
     "jp": "「口づけ、",
     "ko": "「입 맞추고, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00023",
     "kind": "루비 읽기",
     "jp": "ねぶ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00114",
     "kind": "본문",
     "jp": "舐",
     "ko": "핥",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00115",
     "kind": "본문",
     "jp": "り、味わい、嗅ぎ取り、掴み、\n転がし、掻き回し、掻き乱し、嬲り、傷つけ、\n突き立て、刺し貫いてください」",
     "ko": "고, 맛보고, 냄새 맡고, 움켜쥐고,\n굴리고, 휘젓고, 어지럽히고, 희롱하고, 상처 입히고,\n박아 넣고, 꿰뚫어 주세요」"
    }
   ]
  },
  {
   "uid": "da1305:U00043",
   "speaker": "(지문)",
   "jp": "その瞳に宿した紅が、不意に涙で歪んだ。訴える。痛切な、聞く者の胸を締めつける声で。",
   "cells": [
    {
     "sid": "da1305:T00116",
     "kind": "본문",
     "jp": "その瞳に宿した紅が、不意に涙で歪んだ。",
     "ko": "그 눈동자에 품은 붉은빛이 불현듯 눈물로 일그러졌다."
    },
    {
     "sid": "da1305:T00117",
     "kind": "본문",
     "jp": "訴える。",
     "ko": "호소한다."
    },
    {
     "sid": "da1305:T00118",
     "kind": "본문",
     "jp": "痛切な、聞く者の胸を締めつける声で。",
     "ko": "통절한, 듣는 이의 가슴을 죄어 오는 목소리로."
    }
   ]
  },
  {
   "uid": "da1305:U00044",
   "speaker": "アナザーブラッド",
   "jp": "「優しくしてください。激しくしてください。\n　苦痛を刻んでください。愉悦で引き裂いて\n　ください……お父様。お父様。お父様ぁ」",
   "cells": [
    {
     "sid": "da1305:T00119",
     "kind": "본문",
     "jp": "「優しくしてください。激しくしてください。\n　苦痛を刻んでください。愉悦で引き裂いて\n　ください……お父様。お父様。お父様ぁ」",
     "ko": "「상냥하게 해 주세요. 격렬하게 해 주세요.\n　고통을 새겨 주세요. 유열로 찢어발겨\n　주세요…… 아버님. 아버님. 아버니임」"
    }
   ]
  },
  {
   "uid": "da1305:U00045",
   "speaker": "(지문)",
   "jp": "泣きながら。だけど、艶然とした、女の表情で。",
   "cells": [
    {
     "sid": "da1305:T00120",
     "kind": "본문",
     "jp": "泣きながら。",
     "ko": "울면서."
    },
    {
     "sid": "da1305:T00121",
     "kind": "본문",
     "jp": "だけど、艶然とした、女の表情で。",
     "ko": "하지만 요염한, 여자의 표정으로."
    }
   ]
  },
  {
   "uid": "da1305:U00046",
   "speaker": "アナザーブラッド",
   "jp": "「焦がれていました。\n　焦がれていたのです。貴方に。\n　可能性すらない私の〈セカイ〉物語に繋がる、\n　貴方に。一縷の蜘蛛の糸に」",
   "cells": [
    {
     "sid": "da1305:T00122",
     "kind": "본문",
     "jp": "「焦がれていました。\n　焦がれていたのです。貴方に。\n　可能性すらない私の",
     "ko": "「애타게 그리워하고 있었습니다.\n　애타게 그리워하고 있었던 것입니다. 당신을.\n　가능성조차 없는 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00024",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00123",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00124",
     "kind": "본문",
     "jp": "に繋がる、\n　貴方に。一縷の蜘蛛の糸に」",
     "ko": "로 이어지는,\n　당신을. 한 가닥 거미줄을」"
    }
   ]
  },
  {
   "uid": "da1305:U00047",
   "speaker": "(지문)",
   "jp": "涙と愉悦に妖しく光る瞳の、だがその奥はどこまでも深い深淵で。俺を映している。俺の姿が、深淵に呑まれる。",
   "cells": [
    {
     "sid": "da1305:T00125",
     "kind": "본문",
     "jp": "涙と愉悦に妖しく光る瞳の、だがその奥はどこまでも深い深淵で。",
     "ko": "눈물과 유열로 요염하게 빛나는 눈동자의, 하지만 그 안쪽은 끝없이 깊은 심연이어서."
    },
    {
     "sid": "da1305:T00126",
     "kind": "본문",
     "jp": "俺を映している。",
     "ko": "나를 비추고 있다."
    },
    {
     "sid": "da1305:T00127",
     "kind": "본문",
     "jp": "俺の姿が、深淵に呑まれる。",
     "ko": "내 모습이 심연에 삼켜진다."
    }
   ]
  },
  {
   "uid": "da1305:U00048",
   "speaker": "アナザーブラッド",
   "jp": "「この世に生まれ落ちたかった。\n母の〈はら〉胎を喰い破り。母の〈はら〉内腑を貪り喰らい。血の一滴、肉の〈ひとかけら〉一片余さず喰い尽くし――\n私は母に成り代わりたかった」",
   "cells": [
    {
     "sid": "da1305:T00128",
     "kind": "본문",
     "jp": "「この世に生まれ落ちたかった。\n母の",
     "ko": "「이 세상에 태어나고 싶었습니다.\n어머니의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00025",
     "kind": "루비 읽기",
     "jp": "はら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00129",
     "kind": "본문",
     "jp": "胎",
     "ko": "태내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00130",
     "kind": "본문",
     "jp": "を喰い破り。母の",
     "ko": "를 물어뜯어 찢고. 어머니의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00026",
     "kind": "루비 읽기",
     "jp": "はら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00131",
     "kind": "본문",
     "jp": "内腑",
     "ko": "오장육부",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00132",
     "kind": "본문",
     "jp": "を貪り喰らい。血の一滴、肉の",
     "ko": "를 게걸스레 탐하여 먹어 치우고. 피 한 방울, 살점 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00027",
     "kind": "루비 읽기",
     "jp": "ひとかけら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00133",
     "kind": "본문",
     "jp": "一片",
     "ko": "한 조각",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00134",
     "kind": "본문",
     "jp": "余さず喰い尽くし――\n私は母に成り代わりたかった」",
     "ko": " 남김없이 먹어 치워서――\n나는 어머니를 대신해 그 자리에 앉고 싶었습니다」"
    }
   ]
  },
  {
   "uid": "da1305:U00049",
   "speaker": "アナザーブラッド",
   "jp": "「貴方の〈ファム・アンファン〉娘になるために。",
   "cells": [
    {
     "sid": "da1305:T00135",
     "kind": "본문",
     "jp": "「貴方の",
     "ko": "「당신의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00028",
     "kind": "루비 읽기",
     "jp": "ファム・アンファン",
     "ko": "팜 앙팡",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00136",
     "kind": "본문",
     "jp": "娘",
     "ko": "딸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00137",
     "kind": "본문",
     "jp": "になるために。",
     "ko": "이 되기 위하여."
    }
   ]
  },
  {
   "uid": "da1305:U00050",
   "speaker": "アナザーブラッド",
   "jp": "貴方の〈ファム・ファタル〉女になるために。",
   "cells": [
    {
     "sid": "da1305:T00138",
     "kind": "본문",
     "jp": "貴方の",
     "ko": "당신의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00029",
     "kind": "루비 읽기",
     "jp": "ファム・ファタル",
     "ko": "팜 파탈이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00139",
     "kind": "본문",
     "jp": "女",
     "ko": "여자가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1305:T00140",
     "kind": "본문",
     "jp": "になるために。",
     "ko": " 되기 위하여."
    }
   ]
  },
  {
   "uid": "da1305:U00051",
   "speaker": "アナザーブラッド",
   "jp": "――ようやく、叶う」",
   "cells": [
    {
     "sid": "da1305:T00141",
     "kind": "본문",
     "jp": "――ようやく、叶う」",
     "ko": "――비로소, 이루어진다」"
    }
   ]
  },
  {
   "uid": "da1305:U00052",
   "speaker": "(지문)",
   "jp": "沈む。紅の奈落を沈んで、沈んで、沈み続ける。",
   "cells": [
    {
     "sid": "da1305:T00142",
     "kind": "본문",
     "jp": "沈む。",
     "ko": "가라앉는다."
    },
    {
     "sid": "da1305:T00143",
     "kind": "본문",
     "jp": "紅の奈落を沈んで、沈んで、沈み続ける。",
     "ko": "붉은 나락으로 가라앉고, 가라앉고, 계속해서 가라앉는다."
    }
   ]
  },
  {
   "uid": "da1305:U00053",
   "speaker": "(지문)",
   "jp": "ぬめる何かが、俺を包み込む。羊膜だ。紅の羊膜。\n\n　脳を蕩けさせる濃密な血の〈かおり〉芳香",
   "cells": [
    {
     "sid": "da1305:T00144",
     "kind": "본문",
     "jp": "ぬめる何かが、俺を包み込む。",
     "ko": "미끈거리는 무언가가 나를 감싼다."
    },
    {
     "sid": "da1305:T00145",
     "kind": "본문",
     "jp": "羊膜だ。紅の羊膜。\n\n　脳を蕩けさせる",
     "ko": "양막이다. 붉은 양막.\n\n　뇌를 녹여 버리는"
    },
    {
     "sid": "da1305:T00146",
     "kind": "본문",
     "jp": "濃密な",
     "ko": "농밀한"
    },
    {
     "sid": "da1305:T00147",
     "kind": "본문",
     "jp": "血の",
     "ko": "피의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1305:R00030",
     "kind": "루비 읽기",
     "jp": "かおり",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1305:T00148",
     "kind": "본문",
     "jp": "芳香",
     "ko": "향기",
     "ruby_edge": "앞"
    }
   ]
  },
  {
   "uid": "da1305:U00054",
   "speaker": "アナザーブラッド",
   "jp": "「お父様。お父様。お父様。\n　教えてください。\n　私の物語が息づいていると。\n　私は確かに此処に在るのだと」",
   "cells": [
    {
     "sid": "da1305:T00149",
     "kind": "본문",
     "jp": "「お父様。お父様。お父様。\n　教えてください。\n　私の物語が息づいていると。\n　私は確かに此処に在るのだと」",
     "ko": "「아버님. 아버님. 아버님.\n　가르쳐 주세요.\n　나의 이야기가 숨 쉬고 있다고.\n　나는 분명히 이곳에 있는 것이라고」"
    }
   ]
  },
  {
   "uid": "da1305:U00055",
   "speaker": "アナザーブラッド",
   "jp": "「貴方の吐息で、鼓動で、肌で、\n　肉で教えてください。そして――」",
   "cells": [
    {
     "sid": "da1305:T00150",
     "kind": "본문",
     "jp": "「貴方の吐息で、鼓動で、肌で、\n　肉で教えてください。そして――」",
     "ko": "「당신의 숨결로, 고동으로, 피부로,\n　살결로 가르쳐 주세요. 그리고――」"
    }
   ]
  },
  {
   "uid": "da1305:U00056",
   "speaker": "アナザーブラッド",
   "jp": "「そっと。耳元で。呼んで。私の――」",
   "cells": [
    {
     "sid": "da1305:T00151",
     "kind": "본문",
     "jp": "「そっと。",
     "ko": "「살포시."
    },
    {
     "sid": "da1305:T00152",
     "kind": "본문",
     "jp": "耳元で。",
     "ko": "귓가에서."
    },
    {
     "sid": "da1305:T00153",
     "kind": "본문",
     "jp": "呼んで。",
     "ko": "불러 줘."
    },
    {
     "sid": "da1305:T00154",
     "kind": "본문",
     "jp": "私の――」",
     "ko": "나의――」"
    }
   ]
  }
 ]
}