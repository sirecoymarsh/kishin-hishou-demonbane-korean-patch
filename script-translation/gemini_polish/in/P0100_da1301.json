{
 "packet": "P0100_da1301",
 "units": [
  {
   "uid": "da1301:U00001",
   "speaker": "九郎",
   "jp": "「いい加減、目を覚ませ！\n　バカタレが！」",
   "cells": [
    {
     "sid": "da1301:T00001",
     "kind": "본문",
     "jp": "「いい加減、目を覚ませ！\n　バカタレが！」",
     "ko": "「적당히 정신 차려라!\n　이 바보 녀석아!」"
    }
   ]
  },
  {
   "uid": "da1301:U00002",
   "speaker": "九朔",
   "jp": "「ぐああああああああああ！」",
   "cells": [
    {
     "sid": "da1301:T00002",
     "kind": "본문",
     "jp": "「ぐああああああああああ！」",
     "ko": "「그아아아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1301:U00003",
   "speaker": "アル",
   "jp": "「……やったか？」",
   "cells": [
    {
     "sid": "da1301:T00003",
     "kind": "본문",
     "jp": "「……やったか？」",
     "ko": "「……해치웠느냐?」"
    }
   ]
  },
  {
   "uid": "da1301:U00004",
   "speaker": "(지문)",
   "jp": "手応えはあった。普通なら再起不能のダメージを与えているはずだが……",
   "cells": [
    {
     "sid": "da1301:T00004",
     "kind": "본문",
     "jp": "手応えはあった。",
     "ko": "손맛은 있었다."
    },
    {
     "sid": "da1301:T00005",
     "kind": "본문",
     "jp": "普通なら再起不能のダメージを与えているはずだが……",
     "ko": "보통이라면 재기 불능의 데미지를 입혔을 텐데……"
    }
   ]
  },
  {
   "uid": "da1301:U00005",
   "speaker": "九朔",
   "jp": "「ぐ……あぁぁ……ぐ……ッ！」",
   "cells": [
    {
     "sid": "da1301:T00006",
     "kind": "본문",
     "jp": "「ぐ……あぁぁ……ぐ……ッ！」",
     "ko": "「그…… 아아아…… 그…… 읏!」"
    }
   ]
  },
  {
   "uid": "da1301:U00006",
   "speaker": "九朔",
   "jp": "「ふ……ざける……なッ！」",
   "cells": [
    {
     "sid": "da1301:T00007",
     "kind": "본문",
     "jp": "「ふ……ざける……なッ！」",
     "ko": "「웃…… 기지…… 마랏!」"
    }
   ]
  },
  {
   "uid": "da1301:U00007",
   "speaker": "九郎",
   "jp": "「……立ち上がりやがった」",
   "cells": [
    {
     "sid": "da1301:T00008",
     "kind": "본문",
     "jp": "「……立ち上がりやがった」",
     "ko": "「……일어섰군」"
    }
   ]
  },
  {
   "uid": "da1301:U00008",
   "speaker": "アル",
   "jp": "「〈メルクリウス・システマ〉自己修復機能か……？」",
   "cells": [
    {
     "sid": "da1301:T00009",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1301:R00001",
     "kind": "루비 읽기",
     "jp": "メルクリウス・システマ",
     "ko": "메르쿠리우스 시스테마",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00010",
     "kind": "본문",
     "jp": "自己修復機能",
     "ko": "자기수복기능",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00011",
     "kind": "본문",
     "jp": "か……？」",
     "ko": "인가……?」"
    }
   ]
  },
  {
   "uid": "da1301:U00009",
   "speaker": "(지문)",
   "jp": "破損箇所から溢れ出す螺子／歯車／発条／配管／鉄骨／導線／装甲――複雑に絡み合い、組み合わさり、機体を修復する。\n\n　再生するＤトゥーソードの姿は――どこか忌まわしかった。\n\n　自己修復は、それほど速くない。だが不完全な機体を無理に動かし、Ｄトゥーソードは構える。",
   "cells": [
    {
     "sid": "da1301:T00012",
     "kind": "본문",
     "jp": "破損箇所から溢れ出す螺子／歯車／発条／配管／鉄骨／導線／装甲――複雑に絡み合い、組み合わさり、機体を修復する。\n\n　再生するＤトゥーソードの姿は――",
     "ko": "파손 부위에서 넘쳐 나오는 나사/톱니바퀴/태엽/배관/철골/도선/장갑――복잡하게 뒤얽히고 맞물려 기체를 수복한다.\n\n　재생하는 D 투 소드의 모습은――"
    },
    {
     "sid": "da1301:T00013",
     "kind": "본문",
     "jp": "どこか忌まわしかった。\n\n　自己修復は、それほど速くない。",
     "ko": "어딘가 불길했다.\n\n　자기수복은 그리 빠르지 않다."
    },
    {
     "sid": "da1301:T00014",
     "kind": "본문",
     "jp": "だが不完全な機体を無理に動かし、Ｄトゥーソードは構える。",
     "ko": "하지만 불완전한 기체를 무리하게 움직여 D 투 소드는 자세를 잡는다."
    }
   ]
  },
  {
   "uid": "da1301:U00010",
   "speaker": "九朔",
   "jp": "「……〈ふざけ〉巫山戯るな……\n　貴様にだけは……負けないッ！」",
   "cells": [
    {
     "sid": "da1301:T00015",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1301:R00002",
     "kind": "루비 읽기",
     "jp": "ふざけ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00016",
     "kind": "본문",
     "jp": "巫山戯",
     "ko": "웃기지",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00017",
     "kind": "본문",
     "jp": "るな……\n　貴様にだけは……負けないッ！」",
     "ko": " 마라……\n　네놈에게만은…… 지지 않는다!」"
    }
   ]
  },
  {
   "uid": "da1301:U00011",
   "speaker": "九郎",
   "jp": "「何でお前、そんなに……」",
   "cells": [
    {
     "sid": "da1301:T00018",
     "kind": "본문",
     "jp": "「何でお前、そんなに……」",
     "ko": "「어째서 너, 그렇게나……」"
    }
   ]
  },
  {
   "uid": "da1301:U00012",
   "speaker": "(지문)",
   "jp": "コイツは何で、ここまで俺を憎むのだろう？この憎悪の〈みなもと〉源泉は、何なのだろう？俺には……検討もつかない。\n\n　……何故だ？",
   "cells": [
    {
     "sid": "da1301:T00019",
     "kind": "본문",
     "jp": "コイツは何で、ここまで俺を憎むのだろう？",
     "ko": "이 녀석은 어째서 이토록 나를 증오하는 것일까?"
    },
    {
     "sid": "da1301:T00020",
     "kind": "본문",
     "jp": "この憎悪の",
     "ko": "이 증오의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1301:R00003",
     "kind": "루비 읽기",
     "jp": "みなもと",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00021",
     "kind": "본문",
     "jp": "源泉",
     "ko": "원천",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00022",
     "kind": "본문",
     "jp": "は、何なのだろう？",
     "ko": "은 무엇이란 말인가?"
    },
    {
     "sid": "da1301:T00023",
     "kind": "본문",
     "jp": "俺には……検討もつかない。\n\n　……何故だ？",
     "ko": "나로서는…… 짐작조차 가지 않는다.\n\n　……어째서지?"
    }
   ]
  },
  {
   "uid": "da1301:U00013",
   "speaker": "九朔",
   "jp": "「……何故だ？」",
   "cells": [
    {
     "sid": "da1301:T00024",
     "kind": "본문",
     "jp": "「……何故だ？」",
     "ko": "「……어째서냐?」"
    }
   ]
  },
  {
   "uid": "da1301:U00014",
   "speaker": "(지문)",
   "jp": "疑問に応えるのも、また疑問。何故。何故。何故。しかし込められた想いは違う。",
   "cells": [
    {
     "sid": "da1301:T00025",
     "kind": "본문",
     "jp": "疑問に応えるのも、また疑問。",
     "ko": "의문에 답하는 것 또한 의문."
    },
    {
     "sid": "da1301:T00026",
     "kind": "본문",
     "jp": "何故。",
     "ko": "어째서."
    },
    {
     "sid": "da1301:T00027",
     "kind": "본문",
     "jp": "何故。",
     "ko": " 어째서."
    },
    {
     "sid": "da1301:T00028",
     "kind": "본문",
     "jp": "何故。",
     "ko": " 어째서."
    },
    {
     "sid": "da1301:T00029",
     "kind": "본문",
     "jp": "しかし込められた想いは違う。",
     "ko": "그러나 담긴 마음은 다르다."
    }
   ]
  },
  {
   "uid": "da1301:U00015",
   "speaker": "九朔",
   "jp": "「……何故」",
   "cells": [
    {
     "sid": "da1301:T00030",
     "kind": "본문",
     "jp": "「……何故」",
     "ko": "「……어째서」"
    }
   ]
  },
  {
   "uid": "da1301:U00016",
   "speaker": "(지문)",
   "jp": "憎悪を込めて、怨嗟を宿し、少年は責め問う。『何故』という〈ノロイ〉言葉を、刃金に変える。",
   "cells": [
    {
     "sid": "da1301:T00031",
     "kind": "본문",
     "jp": "憎悪を込めて、怨嗟を宿し、少年は責め問う。",
     "ko": "증오를 담아, 원망을 품고, 소년은 추궁한다."
    },
    {
     "sid": "da1301:T00032",
     "kind": "본문",
     "jp": "『何故』という",
     "ko": "『어째서』라는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1301:R00004",
     "kind": "루비 읽기",
     "jp": "ノロイ",
     "ko": "저주를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00033",
     "kind": "본문",
     "jp": "言葉",
     "ko": "말을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00034",
     "kind": "본문",
     "jp": "を、刃金に変える。",
     "ko": " 칼날로 바꾼다."
    }
   ]
  },
  {
   "uid": "da1301:U00017",
   "speaker": "九朔",
   "jp": "「何故ッ！」",
   "cells": [
    {
     "sid": "da1301:T00035",
     "kind": "본문",
     "jp": "「何故ッ！」",
     "ko": "「어째서냐!」"
    }
   ]
  },
  {
   "uid": "da1301:U00018",
   "speaker": "(지문)",
   "jp": "九朔の叫びと共に、世界が歪む。黒い太陽は墜ち、紅い月は砕け、空はひび割れる。廃墟の世界が熔け、崩れていく。",
   "cells": [
    {
     "sid": "da1301:T00036",
     "kind": "본문",
     "jp": "九朔の叫びと共に、世界が歪む。",
     "ko": "쿠자쿠의 외침과 함께 세계가 일그러진다."
    },
    {
     "sid": "da1301:T00037",
     "kind": "본문",
     "jp": "黒い太陽は墜ち、紅い月は砕け、空はひび割れる。",
     "ko": "검은 태양은 추락하고, 붉은 달은 부서지며, 하늘은 갈라진다."
    },
    {
     "sid": "da1301:T00038",
     "kind": "본문",
     "jp": "廃墟の世界が熔け、崩れていく。",
     "ko": "폐허의 세계가 녹아내리며 무너져 간다."
    }
   ]
  },
  {
   "uid": "da1301:U00019",
   "speaker": "アル",
   "jp": "「……ッ！？　九郎、不味いぞ！」",
   "cells": [
    {
     "sid": "da1301:T00039",
     "kind": "본문",
     "jp": "「……ッ！？　九郎、不味いぞ！」",
     "ko": "「……읏!?　쿠로, 위험하다!」"
    }
   ]
  },
  {
   "uid": "da1301:U00020",
   "speaker": "九郎",
   "jp": "「……ッ！」",
   "cells": [
    {
     "sid": "da1301:T00040",
     "kind": "본문",
     "jp": "「……ッ！」",
     "ko": "「……읏!」"
    }
   ]
  },
  {
   "uid": "da1301:U00021",
   "speaker": "(지문)",
   "jp": "崩壊する世界の中心で、少年は怨嗟の叫びを上げる。即ち――",
   "cells": [
    {
     "sid": "da1301:T00041",
     "kind": "본문",
     "jp": "崩壊する世界の中心で、少年は怨嗟の叫びを上げる。",
     "ko": "붕괴하는 세계의 중심에서 소년은 원망의 외침을 올린다."
    },
    {
     "sid": "da1301:T00042",
     "kind": "본문",
     "jp": "即ち――",
     "ko": "즉――"
    }
   ]
  },
  {
   "uid": "da1301:U00022",
   "speaker": "九朔",
   "jp": "「何故、俺を棄てた！？〈・・〉親父ッ！」",
   "cells": [
    {
     "sid": "da1301:T00043",
     "kind": "본문",
     "jp": "「何故、俺を棄てた！？",
     "ko": "「어째서, 나를 버렸느냐!?　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1301:R00005",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00044",
     "kind": "본문",
     "jp": "親父",
     "ko": "아버지",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00045",
     "kind": "본문",
     "jp": "ッ！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1301:U00023",
   "speaker": "(지문)",
   "jp": "――〈オイディプス〉刺され、腫れた踵の痛み。",
   "cells": [
    {
     "sid": "da1301:T00046",
     "kind": "본문",
     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1301:R00006",
     "kind": "루비 읽기",
     "jp": "オイディプス",
     "ko": "오이디푸스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00047",
     "kind": "본문",
     "jp": "刺され、腫れた踵",
     "ko": "찔려 부어오른 발뒤꿈치",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00048",
     "kind": "본문",
     "jp": "の痛み。",
     "ko": "의 아픔."
    }
   ]
  },
  {
   "uid": "da1301:U00024",
   "speaker": "九郎",
   "jp": "「な……ッ」\n\n　世界が俺に雪崩れ込む。それは九朔の内面世界。九朔の想いそのものだ。〈ぼうだい〉厖大な質量の想いに、俺たちは呑み込まれた。",
   "cells": [
    {
     "sid": "da1301:T00049",
     "kind": "본문",
     "jp": "「な……ッ」\n\n　世界が俺に雪崩れ込む。",
     "ko": "「뭐…… 읏」\n\n　세계가 나에게 눈사태처럼 쏟아져 들어온다."
    },
    {
     "sid": "da1301:T00050",
     "kind": "본문",
     "jp": "それは九朔の内面世界。",
     "ko": "그것은 쿠자쿠의 내면세계."
    },
    {
     "sid": "da1301:T00051",
     "kind": "본문",
     "jp": "九朔の想いそのものだ。",
     "ko": "쿠자쿠의 마음 그 자체다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1301:R00007",
     "kind": "루비 읽기",
     "jp": "ぼうだい",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1301:T00052",
     "kind": "본문",
     "jp": "厖大",
     "ko": "방대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1301:T00053",
     "kind": "본문",
     "jp": "な質量の想いに、俺たちは呑み込まれた。",
     "ko": "한 질량의 마음에, 우리는 집어삼켜졌다."
    }
   ]
  }
 ]
}