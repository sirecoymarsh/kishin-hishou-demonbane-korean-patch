  {
   "uid": "da1303:U00025",
   "speaker": "(지문)",
   "jp": "其は言語化された血の〈いろ〉彩の存在定義重ね　塗りたぐり　凝固した彩と味その結晶を誓う意志",
   "cells": [
    {
     "sid": "da1303:T00067",
     "kind": "본문",
     "jp": "其は言語化された血の",
     "ko": "그것은 언어화된 피 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1303:R00019",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1303:T00068",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛깔",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1303:T00069",
     "kind": "본문",
     "jp": "の存在定義",
     "ko": "의 존재 정의"
    },
    {
     "sid": "da1303:T00070",
     "kind": "본문",
     "jp": "重ね　塗りたぐり　凝固した彩と味",
     "ko": "포개어　덧칠하고　응고된 빛깔과 맛"
    },
    {
     "sid": "da1303:T00071",
     "kind": "본문",
     "jp": "その結晶を誓う意志",
     "ko": "그 결정을 맹세하는 의지"
    }
   ]
  },
  {
   "uid": "da1303:U00026",
   "speaker": "九朔",
   "jp": "「怨むぞ……親父！」",
   "cells": [
    {
     "sid": "da1303:T00072",
     "kind": "본문",
     "jp": "「怨むぞ……親父！」",
     "ko": "「원망한다…… 아버지!」"
    }
   ]
  },
  {
   "uid": "da1303:U00027",
   "speaker": "アナザーブラッド",
   "jp": "「お怨み申し上げます、お母様！」",
   "cells": [
    {
     "sid": "da1303:T00073",
     "kind": "본문",
     "jp": "「お怨み申し上げます、お母様！」",
     "ko": "「원망하옵니다, 어머님!」"
    }
   ]
  },
  {
   "uid": "da1303:U00028",
   "speaker": "九朔",
   "jp": "「何故だ！\n　　　　　　何故、棄てたのだ！\n　　　　　　何故……何故！」",
   "cells": [
    {
     "sid": "da1303:T00074",
     "kind": "본문",
     "jp": "「何故だ！\n　　　　　　何故、棄てたのだ！\n　　　　　　何故……何故！」",
     "ko": "「어째서냐!\n　　　　　　어째서, 버린 것이냐!\n　　　　　　어째서…… 어째서!」"
    }
   ]
  },
  {
   "uid": "da1303:U00029",
   "speaker": "アナザーブラッド",
   "jp": "「何故です！\n　　　何故、九朔を生んだの！？〈・・・・・〉私ではなく！　何故……何故！」",
   "cells": [
    {
     "sid": "da1303:T00075",
     "kind": "본문",
     "jp": "「何故です！\n　　　何故、九朔を生んだの！？",
     "ko": "「어째서입니까!\n　　　어째서, 쿠자쿠를 낳은 거야!?\n　　　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1303:R00020",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1303:T00076",
     "kind": "본문",
     "jp": "私ではなく",
     "ko": "제가 아니라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1303:T00077",
     "kind": "본문",
     "jp": "！　何故……何故！」",
     "ko": "!　어째서…… 어째서!」"
    }
   ]
  },
