{
 "packet": "P0025_da0201",
 "units": [
  {
   "uid": "da0201:U00001",
   "speaker": "(지문)",
   "jp": "破壊ロボが粉砕される様子は、上空のシュリュズベリイにも\n確認できた。\n\n　血まみれの巨人を見下ろしながら、シュリュズベリイは〈おののき〉戦慄のうちに叫ぶ。",
   "cells": [
    {
     "sid": "da0201:T00001",
     "kind": "본문",
     "jp": "破壊ロボが粉砕される様子は、上空のシュリュズベリイにも\n確認できた。\n\n　血まみれの巨人を見下ろしながら、シュリュズベリイは",
     "ko": "파괴로보가 분쇄되는 모습은 상공의 슈루즈베리도\n확인할 수 있었다.\n\n　피투성이 거인을 내려다보며 슈루즈베리는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00001",
     "kind": "루비 읽기",
     "jp": "おののき",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00002",
     "kind": "본문",
     "jp": "戦慄",
     "ko": "전율",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00003",
     "kind": "본문",
     "jp": "のうちに叫ぶ。",
     "ko": " 속에 외친다."
    }
   ]
  },
  {
   "uid": "da0201:U00002",
   "speaker": "シュリュズベリイ",
   "jp": "「〈デウス・マキナ〉鬼械神！」",
   "cells": [
    {
     "sid": "da0201:T00004",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0201:R00002",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00005",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00006",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0201:U00003",
   "speaker": "ハヅキ",
   "jp": "「でも、前のとは違う〈タイプ〉型ね……それに」",
   "cells": [
    {
     "sid": "da0201:T00007",
     "kind": "본문",
     "jp": "「でも、前のとは違う",
     "ko": "「하지만 이전 것과는 다른 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00003",
     "kind": "루비 읽기",
     "jp": "タイプ",
     "ko": "타입이야",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00008",
     "kind": "본문",
     "jp": "型",
     "ko": "형태야",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00009",
     "kind": "본문",
     "jp": "ね……それに」",
     "ko": "…… 게다가」"
    }
   ]
  },
  {
   "uid": "da0201:U00004",
   "speaker": "シュリュズベリイ",
   "jp": "「何か分かるか、レディ？」",
   "cells": [
    {
     "sid": "da0201:T00010",
     "kind": "본문",
     "jp": "「何か分かるか、レディ？」",
     "ko": "「뭔가 알겠나, 레이디?」"
    }
   ]
  },
  {
   "uid": "da0201:U00005",
   "speaker": "ハヅキ",
   "jp": "「……〈デウス・マキナ〉鬼械神とはなんか違う。\n　酷く不安定な感じ」",
   "cells": [
    {
     "sid": "da0201:T00011",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0201:R00004",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00012",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00013",
     "kind": "본문",
     "jp": "とはなんか違う。\n　酷く不安定な感じ」",
     "ko": "하고는 뭔가 달라.\n　심하게 불안정한 느낌이야」"
    }
   ]
  },
  {
   "uid": "da0201:U00006",
   "speaker": "シュリュズベリイ",
   "jp": "「不完全なのか？」",
   "cells": [
    {
     "sid": "da0201:T00014",
     "kind": "본문",
     "jp": "「不完全なのか？」",
     "ko": "「불완전한 건가?」"
    }
   ]
  },
  {
   "uid": "da0201:U00007",
   "speaker": "ハヅキ",
   "jp": "「それもあるけど……〈ま〉雑ざり物が多いよ、あの子。\n　純粋な〈デウス・マキナ〉鬼械神じゃない」",
   "cells": [
    {
     "sid": "da0201:T00015",
     "kind": "본문",
     "jp": "「それもあるけど……",
     "ko": "「그것도 있지만……\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00005",
     "kind": "루비 읽기",
     "jp": "ま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00016",
     "kind": "본문",
     "jp": "雑",
     "ko": "불순",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00017",
     "kind": "본문",
     "jp": "ざり物が多いよ、あの子。\n　純粋な",
     "ko": "물이 많아, 저 아이.\n　순수한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00006",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00018",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00019",
     "kind": "본문",
     "jp": "じゃない」",
     "ko": " 아니야」"
    }
   ]
  },
  {
   "uid": "da0201:U00008",
   "speaker": "シュリュズベリイ",
   "jp": "「しかしあの威力……捨て置けぬ」",
   "cells": [
    {
     "sid": "da0201:T00020",
     "kind": "본문",
     "jp": "「しかしあの威力……",
     "ko": "「하지만 저 위력…… "
    },
    {
     "sid": "da0201:T00021",
     "kind": "본문",
     "jp": "捨て置けぬ」",
     "ko": "내버려 둘 수 없군」"
    }
   ]
  },
  {
   "uid": "da0201:U00009",
   "speaker": "ハヅキ",
   "jp": "「ハヅキたちが\n　やるしかないみたいだね」",
   "cells": [
    {
     "sid": "da0201:T00022",
     "kind": "본문",
     "jp": "「ハヅキたちが\n　やるしかないみたいだね」",
     "ko": "「하즈키네가\n　해치울 수밖에 없겠네」"
    }
   ]
  },
  {
   "uid": "da0201:U00010",
   "speaker": "シュリュズベリイ",
   "jp": "「勝てるか、レディ？」",
   "cells": [
    {
     "sid": "da0201:T00023",
     "kind": "본문",
     "jp": "「勝てるか、レディ？」",
     "ko": "「이길 수 있겠나, 레이디?」"
    }
   ]
  },
  {
   "uid": "da0201:U00011",
   "speaker": "ハヅキ",
   "jp": "「甘く見ないで、ダディ。余裕」",
   "cells": [
    {
     "sid": "da0201:T00024",
     "kind": "본문",
     "jp": "「甘く見ないで、ダディ。余裕」",
     "ko": "「얕보지 마, 대디. 거뜬해」"
    }
   ]
  },
  {
   "uid": "da0201:U00012",
   "speaker": "シュリュズベリイ",
   "jp": "「頼もしい。では……参るぞ！」",
   "cells": [
    {
     "sid": "da0201:T00025",
     "kind": "본문",
     "jp": "「頼もしい。では……参るぞ！」",
     "ko": "「든든하군. 그럼…… 간다!」"
    }
   ]
  },
  {
   "uid": "da0201:U00013",
   "speaker": "クラウディウス",
   "jp": "「させるかよ！\n         爺ぃぃぃィィィ――――――ッ！」",
   "cells": [
    {
     "sid": "da0201:T00026",
     "kind": "본문",
     "jp": "「させるかよ！\n         爺ぃぃぃィィィ――――――ッ！」",
     "ko": "「그럴 줄 알고!\n         할아범어어어어어어――――――!」"
    }
   ]
  },
  {
   "uid": "da0201:U00014",
   "speaker": "シュリュズベリイ",
   "jp": "「――！？\n　いかん、避けろレディ！」",
   "cells": [
    {
     "sid": "da0201:T00027",
     "kind": "본문",
     "jp": "「――！？\n　いかん、避けろレディ！」",
     "ko": "「――!?\n　위험하다, 피해라 레이디!」"
    }
   ]
  },
  {
   "uid": "da0201:U00015",
   "speaker": "ハヅキ",
   "jp": "「くっ！」",
   "cells": [
    {
     "sid": "da0201:T00028",
     "kind": "본문",
     "jp": "「くっ！」",
     "ko": "「큭!」"
    }
   ]
  },
  {
   "uid": "da0201:U00016",
   "speaker": "(지문)",
   "jp": "超スピードで迫る紅い光線を、シュリュズベリイが乗る飛行体は\n辛うじて躱す。",
   "cells": [
    {
     "sid": "da0201:T00029",
     "kind": "본문",
     "jp": "超スピードで迫る紅い光線を、シュリュズベリイが乗る飛行体は\n辛うじて躱す。",
     "ko": "초스피드로 덮쳐 오는 붉은 광선을 슈루즈베리가 탄 비행체는\n간신히 피한다."
    }
   ]
  },
  {
   "uid": "da0201:U00017",
   "speaker": "シュリュズベリイ",
   "jp": "「この速度――奴か！」",
   "cells": [
    {
     "sid": "da0201:T00030",
     "kind": "본문",
     "jp": "「この速度――奴か！」",
     "ko": "「이 속도―― 녀석인가!」"
    }
   ]
  },
  {
   "uid": "da0201:U00018",
   "speaker": "クラウディウス",
   "jp": "「ヒャーハハハハハハ！\n              また会ったなァァァ！」",
   "cells": [
    {
     "sid": "da0201:T00031",
     "kind": "본문",
     "jp": "「ヒャーハハハハハハ！\n              また会ったなァァァ！」",
     "ko": "「햐하하하하하하!\n              또 만났구나아아아!」"
    }
   ]
  },
  {
   "uid": "da0201:U00019",
   "speaker": "(지문)",
   "jp": "紅い光線は空中で渦巻き、竜巻となって爆ぜる。",
   "cells": [
    {
     "sid": "da0201:T00032",
     "kind": "본문",
     "jp": "紅い光線は空中で渦巻き、竜巻となって爆ぜる。",
     "ko": "붉은 광선은 공중에서 소용돌이치며 회오리가 되어 터진다."
    }
   ]
  },
  {
   "uid": "da0201:U00020",
   "speaker": "(지문)",
   "jp": "飛び散る血風の中から、邪悪な笑みを浮かべる少年が現れた。",
   "cells": [
    {
     "sid": "da0201:T00033",
     "kind": "본문",
     "jp": "飛び散る血風の中から、邪悪な笑みを浮かべる少年が現れた。",
     "ko": "흩날리는 혈풍 속에서 사악한 미소를 띤 소년이 나타났다."
    }
   ]
  },
  {
   "uid": "da0201:U00021",
   "speaker": "シュリュズベリイ",
   "jp": "「やはり、あの時の小僧だったか」",
   "cells": [
    {
     "sid": "da0201:T00034",
     "kind": "본문",
     "jp": "「やはり、あの時の小僧だったか」",
     "ko": "「역시 그때 그 애송이였나」"
    }
   ]
  },
  {
   "uid": "da0201:U00022",
   "speaker": "クラウディウス",
   "jp": "「クラウディウスってんだ、ヨロシクな。\n　死に損ないのじーさまよぉ」",
   "cells": [
    {
     "sid": "da0201:T00035",
     "kind": "본문",
     "jp": "「クラウディウスってんだ、ヨロシクな。\n　死に損ないのじーさまよぉ」",
     "ko": "「클라우디우스라고 한다, 잘 부탁해.\n　죽다 만 영감탱이야」"
    }
   ]
  },
  {
   "uid": "da0201:U00023",
   "speaker": "(지문)",
   "jp": "少年は風を纏い、空中に留まっている。瘴気を孕む、〈きょうあく〉兇悪な風だ。",
   "cells": [
    {
     "sid": "da0201:T00036",
     "kind": "본문",
     "jp": "少年は風を纏い、空中に留まっている。",
     "ko": "소년은 바람을 두른 채 공중에 머물러 있다."
    },
    {
     "sid": "da0201:T00037",
     "kind": "본문",
     "jp": "瘴気を孕む、",
     "ko": "독기를 품은, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00007",
     "kind": "루비 읽기",
     "jp": "きょうあく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00038",
     "kind": "본문",
     "jp": "兇悪",
     "ko": "흉악",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00039",
     "kind": "본문",
     "jp": "な風だ。",
     "ko": "한 바람이다."
    }
   ]
  },
  {
   "uid": "da0201:U00024",
   "speaker": "シュリュズベリイ",
   "jp": "「ハスターの〈ちから〉魔力……\n　見立てどおりか」",
   "cells": [
    {
     "sid": "da0201:T00040",
     "kind": "본문",
     "jp": "「ハスターの",
     "ko": "「하스터의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00008",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0201:T00041",
     "kind": "본문",
     "jp": "魔力",
     "ko": "마력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0201:T00042",
     "kind": "본문",
     "jp": "……\n　見立てどおりか」",
     "ko": "……\n　짐작한 대로인가」"
    }
   ]
  },
  {
   "uid": "da0201:U00025",
   "speaker": "クラウディウス",
   "jp": "「そうさ。てめえと同じさ」",
   "cells": [
    {
     "sid": "da0201:T00043",
     "kind": "본문",
     "jp": "「そうさ。てめえと同じさ」",
     "ko": "「맞아. 네놈이랑 똑같지」"
    }
   ]
  },
  {
   "uid": "da0201:U00026",
   "speaker": "シュリュズベリイ",
   "jp": "「見くびるな。\n　私はハスターの奴隷ではない」",
   "cells": [
    {
     "sid": "da0201:T00044",
     "kind": "본문",
     "jp": "「見くびるな。\n　私はハスターの奴隷ではない」",
     "ko": "「얕보지 마라.\n　나는 하스터의 노예가 아니다」"
    }
   ]
  },
  {
   "uid": "da0201:U00027",
   "speaker": "クラウディウス",
   "jp": "「いや、同じだよ……なぜならよぉ……」",
   "cells": [
    {
     "sid": "da0201:T00045",
     "kind": "본문",
     "jp": "「いや、同じだよ……なぜならよぉ……」",
     "ko": "「아니, 똑같다니까…… 왜냐하면 말이지……」"
    }
   ]
  },
  {
   "uid": "da0201:U00028",
   "speaker": "(지문)",
   "jp": "クラウディウスの掌の上、闇色の風が渦巻いた。それは螺旋状に高速回転する文字列、高密度な魔術情報体。\n\n　螺旋運動の加速が臨界に達したとき、\n　それは急速に圧縮→反転→膨張と同時に物質化。漆黒の竜巻の『内側』から魔導書の〈ページ〉頁が溢れ出す。",
   "cells": [
    {
     "sid": "da0201:T00046",
     "kind": "본문",
     "jp": "クラウディウスの掌の上、闇色の風が渦巻いた。",
     "ko": "클라우디우스의 손바닥 위에서 어둠빛 바람이 소용돌이쳤다."
    },
    {
     "sid": "da0201:T00047",
     "kind": "본문",
     "jp": "それは螺旋状に高速回転する文字列、高密度な魔術情報体。\n\n　螺旋運動の加速が臨界に達したとき、\n　それは急速に圧縮→反転→膨張と同時に物質化。",
     "ko": "그것은 나선형으로 고속 회전하는 문자열, 고밀도의 마술 정보체.\n\n　나선 운동의 가속이 임계에 달했을 때,\n　그것은 급속히 압축→반전→팽창과 동시에 물질화."
    },
    {
     "sid": "da0201:T00048",
     "kind": "본문",
     "jp": "漆黒の竜巻の『内側』から魔導書の",
     "ko": "칠흑빛 회오리의 『안쪽』에서 마도서의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0201:R00009",
