    }
   ]
  },
  {
   "uid": "da0117:U00003",
   "speaker": "アル",
   "jp": "「いつまでも寝ぼけているな、うつけ」",
   "cells": [
    {
     "sid": "da0117:T00005",
     "kind": "본문",
     "jp": "「いつまでも寝ぼけているな、うつけ」",
     "ko": "「언제까지고 잠에 취해 있지 마라, 멍청한 놈」"
    }
   ]
  },
  {
   "uid": "da0117:U00004",
   "speaker": "九郎",
   "jp": "「昨日の疲れが残ってんだよ……マジ眠ィ……」",
   "cells": [
    {
     "sid": "da0117:T00006",
     "kind": "본문",
     "jp": "「昨日の疲れが残ってんだよ……マジ眠ィ……」",
     "ko": "「어제 피로가 남아 있단 말이야…… 진짜 졸려……」"
    }
   ]
  },
  {
   "uid": "da0117:U00005",
   "speaker": "アル",
   "jp": "「コーヒーでもがぶ飲みすることだな。\n　ただしブラックで」",
   "cells": [
    {
     "sid": "da0117:T00007",
     "kind": "본문",
     "jp": "「コーヒーでもがぶ飲みすることだな。\n　ただしブラックで」",
     "ko": "「커피라도 벌컥벌컥 마시거라.\n　단, 블랙으로」"
