{
 "packet": "P0075_da0704",
 "units": [
  {
   "uid": "da0704:U00001",
   "speaker": "九朔",
   "jp": "「……そういう貴方は何だ」",
   "cells": [
    {
     "sid": "da0704:T00001",
     "kind": "본문",
     "jp": "「……そういう貴方は何だ」",
     "ko": "「……그렇게 말하는 당신은 뭐지」"
    }
   ]
  },
  {
   "uid": "da0704:U00002",
   "speaker": "アズラッド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0704:T00002",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00003",
   "speaker": "九朔",
   "jp": "「〈われ〉我がアナザーブラッドに近いというのなら\n……貴方だって、奴の編む悪夢と同質の〈モノ〉存在ではないか！」",
   "cells": [
    {
     "sid": "da0704:T00003",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0704:R00001",
     "kind": "루비 읽기",
     "jp": "われ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00004",
     "kind": "본문",
     "jp": "我",
     "ko": "내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00005",
     "kind": "본문",
     "jp": "がアナザーブラッドに近いというのなら\n……貴方だって、奴の編む悪夢と同質の",
     "ko": "가 어나더 블러드에 가깝다고 한다면\n……당신이야말로 녀석이 엮어 내는 악몽과 동질의\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00002",
     "kind": "루비 읽기",
     "jp": "モノ",
     "ko": "것이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00006",
     "kind": "본문",
     "jp": "存在",
     "ko": "존재가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00007",
     "kind": "본문",
     "jp": "ではないか！」",
     "ko": " 아닌가!」"
    }
   ]
  },
  {
   "uid": "da0704:U00004",
   "speaker": "アズラッド",
   "jp": "「……やはり君は何かを識っているようだ」",
   "cells": [
    {
     "sid": "da0704:T00008",
     "kind": "본문",
     "jp": "「……やはり君は何かを識っているようだ」",
     "ko": "「……역시 그대는 무언가를 알고 있는 모양이군」"
    }
   ]
  },
  {
   "uid": "da0704:U00005",
   "speaker": "アズラッド",
   "jp": "「話してもらおう。〈・・・〉君たちが何ものなのかを」",
   "cells": [
    {
     "sid": "da0704:T00009",
     "kind": "본문",
     "jp": "「話してもらおう。",
     "ko": "「말해 주어야겠다.\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00003",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00010",
     "kind": "본문",
     "jp": "君たち",
     "ko": "그대들",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00011",
     "kind": "본문",
     "jp": "が何ものなのかを」",
     "ko": "이 어떤 존재인지를」"
    }
   ]
  },
  {
   "uid": "da0704:U00006",
   "speaker": "九朔",
   "jp": "「……それが人にものを訊ねる態度か。\n　無礼にも程があるぞ」",
   "cells": [
    {
     "sid": "da0704:T00012",
     "kind": "본문",
     "jp": "「……それが人にものを訊ねる態度か。\n　無礼にも程があるぞ」",
     "ko": "「……그것이 사람에게 무언가를 묻는 태도인가.\n　무례에도 정도가 있다」"
    }
   ]
  },
  {
   "uid": "da0704:U00007",
   "speaker": "アズラッド",
   "jp": "「社交界に出入りするため、〈よみがえ〉黄泉帰ったわけではない」",
   "cells": [
    {
     "sid": "da0704:T00013",
     "kind": "본문",
     "jp": "「社交界に出入りするため、",
     "ko": "「사교계에 드나들기 위해\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00004",
     "kind": "루비 읽기",
     "jp": "よみがえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00014",
     "kind": "본문",
     "jp": "黄泉帰",
     "ko": "되살아난",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00015",
     "kind": "본문",
     "jp": "ったわけではない」",
     "ko": " 것이 아니다」"
    }
   ]
  },
  {
   "uid": "da0704:U00008",
   "speaker": "アズラッド",
   "jp": "「君の存在が彼らにとって災いになる\n　のなら――俺は容赦しない」",
   "cells": [
    {
     "sid": "da0704:T00016",
     "kind": "본문",
     "jp": "「君の存在が彼らにとって災いになる\n　のなら――俺は容赦しない」",
     "ko": "「그대의 존재가 저들에게 재앙이 된다면\n　――나는 용서하지 않겠다」"
    }
   ]
  },
  {
   "uid": "da0704:U00009",
   "speaker": "九朔",
   "jp": "「我を彼奴と一緒にするな！」",
   "cells": [
    {
     "sid": "da0704:T00017",
     "kind": "본문",
     "jp": "「我を彼奴と一緒にするな！」",
     "ko": "「나를 그 녀석과 같은 취급 하지 마라!」"
    }
   ]
  },
  {
   "uid": "da0704:U00010",
   "speaker": "アズラッド",
   "jp": "「――――」",
   "cells": [
    {
     "sid": "da0704:T00018",
     "kind": "본문",
     "jp": "「――――」",
     "ko": "「――――」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00011",
   "speaker": "九朔",
   "jp": "「……ッ！」",
   "cells": [
    {
     "sid": "da0704:T00019",
     "kind": "본문",
     "jp": "「……ッ！」",
     "ko": "「……윽!」"
    }
   ]
  },
  {
   "uid": "da0704:U00012",
   "speaker": "九郎",
   "jp": "「……おいおい。\n　何だよ、この剣呑な空気は……」",
   "cells": [
    {
     "sid": "da0704:T00020",
     "kind": "본문",
     "jp": "「……おいおい。\n　何だよ、この剣呑な空気は……」",
     "ko": "「……어이, 어이.\n　뭐야, 이 험악한 분위기는……」"
    }
   ]
  },
  {
   "uid": "da0704:U00013",
   "speaker": "アズラッド",
   "jp": "「……ッ」",
   "cells": [
    {
     "sid": "da0704:T00021",
     "kind": "본문",
     "jp": "「……ッ」",
     "ko": "「……윽」"
    }
   ]
  },
  {
   "uid": "da0704:U00014",
   "speaker": "九朔",
   "jp": "「……～～～っ！？」",
   "cells": [
    {
     "sid": "da0704:T00022",
     "kind": "본문",
     "jp": "「……～～～っ！？」",
     "ko": "「……~~~윽!?」"
    }
   ]
  },
  {
   "uid": "da0704:U00015",
   "speaker": "九朔",
   "jp": "「大十字九郎……」",
   "cells": [
    {
     "sid": "da0704:T00023",
     "kind": "본문",
     "jp": "「大十字九郎……」",
     "ko": "「다이쥬지 쿠로……」"
    }
   ]
  },
  {
   "uid": "da0704:U00016",
   "speaker": "(지문)",
   "jp": "……ったく、何処で何をしているかと思えばコイツらは。今はいがみ合っている場合でもないだろうに。",
   "cells": [
    {
     "sid": "da0704:T00024",
     "kind": "본문",
     "jp": "……ったく、何処で何をしているかと思えばコイツらは。",
     "ko": "……참 나, 어디서 뭘 하고 있나 했더니 이 녀석들은."
    },
    {
     "sid": "da0704:T00025",
     "kind": "본문",
     "jp": "今はいがみ合っている場合でもないだろうに。",
     "ko": "지금은 서로 으르렁거리고 있을 때도 아닐 텐데."
    }
   ]
  },
  {
   "uid": "da0704:U00017",
   "speaker": "九郎",
   "jp": "「やめろやめろ、やーめっ！\n　くだらねえケンカしてんじゃねえよ。はぁ～～っ」",
   "cells": [
    {
     "sid": "da0704:T00026",
     "kind": "본문",
     "jp": "「やめろやめろ、やーめっ！\n　くだらねえケンカしてんじゃねえよ。はぁ～～っ」",
     "ko": "「그만둬, 그만둬, 그~만!\n　시시한 싸움질 하지 말라고. 하아~~앗」"
    }
   ]
  },
  {
   "uid": "da0704:U00018",
   "speaker": "アズラッド",
   "jp": "「覇道鋼造……」",
   "cells": [
    {
     "sid": "da0704:T00027",
     "kind": "본문",
     "jp": "「覇道鋼造……」",
     "ko": "「하도 고조……」"
    }
   ]
  },
  {
   "uid": "da0704:U00019",
   "speaker": "九郎",
   "jp": "「……覇道鋼造って」",
   "cells": [
    {
     "sid": "da0704:T00028",
     "kind": "본문",
     "jp": "「……覇道鋼造って」",
     "ko": "「……하도 고조라니」"
    }
   ]
  },
  {
   "uid": "da0704:U00020",
   "speaker": "アズラッド",
   "jp": "「いや……すまない。気にするな」",
   "cells": [
    {
     "sid": "da0704:T00029",
     "kind": "본문",
     "jp": "「いや……すまない。気にするな」",
     "ko": "「아니…… 미안하다. 신경 쓰지 마라」"
    }
   ]
  },
  {
   "uid": "da0704:U00021",
   "speaker": "アズラッド",
   "jp": "「――もう『お前』は『覇道鋼造』\n　ではなかったのだな」",
   "cells": [
    {
     "sid": "da0704:T00030",
     "kind": "본문",
     "jp": "「――もう『お前』は『覇道鋼造』\n　ではなかったのだな」",
     "ko": "「――이제 『너』는 『하도 고조』가\n　아니었군」"
    }
   ]
  },
  {
   "uid": "da0704:U00022",
   "speaker": "(지문)",
   "jp": "「…………",
   "cells": [
    {
     "sid": "da0704:T00031",
     "kind": "본문",
     "jp": "「…………",
     "ko": "「…………",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00023",
   "speaker": "九郎",
   "jp": "まあ、良いか。\n　とにかくアズラッド……だったっけか？\n　コイツを挑発するのは止してくれ」",
   "cells": [
    {
     "sid": "da0704:T00032",
     "kind": "본문",
     "jp": "まあ、良いか。\n　とにかくアズラッド……だったっけか？\n　コイツを挑発するのは止してくれ」",
     "ko": "뭐, 됐나.\n　아무튼 아즈라드……였던가?\n　이 녀석을 도발하는 건 그만둬 줘」"
    }
   ]
  },
  {
   "uid": "da0704:U00024",
   "speaker": "九郎",
   "jp": "「確かにコイツは『謎の新キャラその１』だけどさ。\n　少なくも敵じゃあないみたいだし」",
   "cells": [
    {
     "sid": "da0704:T00033",
     "kind": "본문",
     "jp": "「確かにコイツは『謎の新キャラその１』だけどさ。\n　少なくも敵じゃあないみたいだし」",
     "ko": "「확실히 이 녀석은 『수수께끼의 신캐릭터 그 1』이지만 말야.\n　적어도 적은 아닌 것 같고」"
    }
   ]
  },
  {
   "uid": "da0704:U00025",
   "speaker": "アズラッド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0704:T00034",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00026",
   "speaker": "(지문)",
   "jp": "アズラッドは頷きも、拒否もしなかった。ただ黙って、九朔に対する警戒を解いた。それを確認した俺は、今度は九朔に向き直る。",
   "cells": [
    {
     "sid": "da0704:T00035",
     "kind": "본문",
     "jp": "アズラッドは頷きも、拒否もしなかった。",
     "ko": "아즈라드는 고개를 끄덕이지도, 거부하지도 않았다."
    },
    {
     "sid": "da0704:T00036",
     "kind": "본문",
     "jp": "ただ黙って、九朔に対する警戒を解いた。",
     "ko": "그저 잠자코 쿠자쿠에 대한 경계를 풀었다."
    },
    {
     "sid": "da0704:T00037",
     "kind": "본문",
     "jp": "それを確認した俺は、今度は九朔に向き直る。",
     "ko": "그것을 확인한 나는 이번엔 쿠자쿠를 향해 돌아선다."
    }
   ]
  },
  {
   "uid": "da0704:U00027",
   "speaker": "九郎",
   "jp": "「お前もだ、九朔。\n　気が短すぎるぜ？　もう少し落ち着け」",
   "cells": [
    {
     "sid": "da0704:T00038",
     "kind": "본문",
     "jp": "「お前もだ、九朔。\n　気が短すぎるぜ？　もう少し落ち着け」",
     "ko": "「너도 마찬가지야, 쿠자쿠.\n　성질이 너무 급하다고? 조금만 더 진정해」"
    }
   ]
  },
  {
   "uid": "da0704:U00028",
   "speaker": "九朔",
   "jp": "「ふん……貴様に指図される〈いわ〉謂れはない」",
   "cells": [
    {
     "sid": "da0704:T00039",
     "kind": "본문",
     "jp": "「ふん……貴様に指図される",
     "ko": "「흥…… 네놈에게 지시받을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00005",
     "kind": "루비 읽기",
     "jp": "いわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00040",
     "kind": "본문",
     "jp": "謂",
     "ko": "까닭",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00041",
     "kind": "본문",
     "jp": "れはない」",
     "ko": "은 없다」"
    }
   ]
  },
  {
   "uid": "da0704:U00029",
   "speaker": "(지문)",
   "jp": "そう言って、そっぽを向く。……本当に何でコイツはこう、突っかかってくるかね？",
   "cells": [
    {
     "sid": "da0704:T00042",
     "kind": "본문",
     "jp": "そう言って、そっぽを向く。",
     "ko": "그렇게 말하고는 고개를 홱 돌린다."
    },
    {
     "sid": "da0704:T00043",
     "kind": "본문",
     "jp": "……本当に何でコイツはこう、突っかかってくるかね？",
     "ko": "……정말이지 어째서 이 녀석은 이렇게 날을 세우며 대드는 걸까?"
    }
   ]
  },
  {
   "uid": "da0704:U00030",
   "speaker": "九郎",
   "jp": "「そうカリカリしなさんな。カルシウム足りねえぞ。\n　牛乳を飲め、牛乳を。そしたら、背も伸びる」",
   "cells": [
    {
     "sid": "da0704:T00044",
     "kind": "본문",
     "jp": "「そうカリカリしなさんな。カルシウム足りねえぞ。\n　牛乳を飲め、牛乳を。そしたら、背も伸びる」",
     "ko": "「그렇게 신경질 내지 말라고. 칼슘 부족이다.\n　우유를 마셔라, 우유를. 그러면 키도 큰다」"
    }
   ]
  },
  {
   "uid": "da0704:U00031",
   "speaker": "九朔",
   "jp": "「し、身長のことは関係ないッ！」",
   "cells": [
    {
     "sid": "da0704:T00045",
     "kind": "본문",
     "jp": "「し、身長のことは関係ないッ！」",
     "ko": "「키, 키 이야기는 상관없다!」"
    }
   ]
  },
  {
   "uid": "da0704:U00032",
   "speaker": "(지문)",
   "jp": "気にしてたのか。",
   "cells": [
    {
     "sid": "da0704:T00046",
     "kind": "본문",
     "jp": "気にしてたのか。",
     "ko": "신경 쓰고 있었나."
    }
   ]
  },
  {
   "uid": "da0704:U00033",
   "speaker": "九郎",
   "jp": "「あのな……あまり警戒すんなよ。一応は同じ敵と戦う仲間だろ？」",
   "cells": [
    {
     "sid": "da0704:T00047",
     "kind": "본문",
     "jp": "「あのな……あまり警戒すんなよ。一応は同じ敵と戦う仲間だろ？」",
     "ko": "「있잖아…… 너무 경계하지 마. 일단은 같은 적과 싸우는 동료잖아?」"
    }
   ]
  },
  {
   "uid": "da0704:U00034",
   "speaker": "九朔",
   "jp": "「仲間……仲間だと？　笑わせるな」",
   "cells": [
    {
     "sid": "da0704:T00048",
     "kind": "본문",
     "jp": "「仲間……仲間だと？　笑わせるな」",
     "ko": "「동료…… 동료라고? 웃기지 마라」"
    }
   ]
  },
  {
   "uid": "da0704:U00035",
   "speaker": "九朔",
   "jp": "「アナザーブラッドとの決着は自らの手で\n　つける。貴様の手など借りん！」",
   "cells": [
    {
     "sid": "da0704:T00049",
     "kind": "본문",
     "jp": "「アナザーブラッドとの決着は自らの手で\n　つける。貴様の手など借りん！」",
     "ko": "「어나더 블러드와의 결착은 내 손으로\n　짓는다. 네놈의 손 따위는 빌리지 않는다!」"
    }
   ]
  },
  {
   "uid": "da0704:U00036",
   "speaker": "九郎",
   "jp": "「……何でお前、そんなに肩肘張ってるんだよ？」",
   "cells": [
    {
     "sid": "da0704:T00050",
     "kind": "본문",
     "jp": "「……何でお前、そんなに肩肘張ってるんだよ？」",
     "ko": "「……어째서 너, 그렇게 어깨에 잔뜩 힘을 주고 있는 거냐?」"
    }
   ]
  },
  {
   "uid": "da0704:U00037",
   "speaker": "九朔",
   "jp": "「～～～～……ッ！？」",
   "cells": [
    {
     "sid": "da0704:T00051",
     "kind": "본문",
     "jp": "「～～～～……ッ！？」",
     "ko": "「~~~~……윽!?」"
    }
   ]
  },
  {
   "uid": "da0704:U00038",
   "speaker": "九郎",
   "jp": "「お前は相当強いし、出来る奴なんだろうけど。\n　そんなに張り詰めてると、いつか切れちまうぜ？」",
   "cells": [
    {
     "sid": "da0704:T00052",
     "kind": "본문",
     "jp": "「お前は相当強いし、出来る奴なんだろうけど。\n　そんなに張り詰めてると、いつか切れちまうぜ？」",
     "ko": "「너는 상당히 강하고 실력 있는 녀석이겠지만.\n　그렇게 팽팽하게 날을 세우고 있으면 언젠가 끊어져 버린다고?」"
    }
   ]
  },
  {
   "uid": "da0704:U00039",
   "speaker": "九朔",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0704:T00053",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00040",
   "speaker": "九郎",
   "jp": "「お前が何背負っているかは知らないけどさ……\n　だけど、少しくらい楽したってバチは当たらねえよ」",
   "cells": [
    {
     "sid": "da0704:T00054",
     "kind": "본문",
     "jp": "「お前が何背負っているかは知らないけどさ……\n　だけど、少しくらい楽したってバチは当たらねえよ」",
     "ko": "「네가 뭘 짊어지고 있는지는 모르겠지만 말야……\n　그래도 조금쯤 편하게 간다고 벌받진 않아」"
    }
   ]
  },
  {
   "uid": "da0704:U00041",
   "speaker": "九郎",
   "jp": "「独りで戦うよりは、みんなで〈たたか〉共闘う方が良い……そうだろ？」",
   "cells": [
    {
     "sid": "da0704:T00055",
     "kind": "본문",
     "jp": "「独りで戦うよりは、みんなで",
     "ko": "「혼자서 싸우는 것보다는 다 함께 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00006",
     "kind": "루비 읽기",
     "jp": "たたか",
     "ko": "싸우",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00056",
     "kind": "본문",
     "jp": "共闘",
     "ko": "공투하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00057",
     "kind": "본문",
     "jp": "う方が良い……そうだろ？」",
     "ko": "는 편이 좋잖아…… 안 그래?」"
    }
   ]
  },
  {
   "uid": "da0704:U00042",
   "speaker": "九朔",
   "jp": "「貴様が言うなッッッ！」",
   "cells": [
    {
     "sid": "da0704:T00058",
     "kind": "본문",
     "jp": "「貴様が言うなッッッ！」",
     "ko": "「네놈이 그런 말 하지 마라아아!」"
    }
   ]
  },
  {
   "uid": "da0704:U00043",
   "speaker": "九郎",
   "jp": "「～～～～～っ！？」",
   "cells": [
    {
     "sid": "da0704:T00059",
     "kind": "본문",
     "jp": "「～～～～～っ！？」",
     "ko": "「~~~~~윽!?」"
    }
   ]
  },
  {
   "uid": "da0704:U00044",
   "speaker": "アズラッド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0704:T00060",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00045",
   "speaker": "(지문)",
   "jp": "目の前で何かが光ったと思った次の瞬間、首筋に冷たいものが\n触れた。\n\n　ロイガー……いや、ツァール……いや、どっちがどっちだ？まあとにかく、九朔が喚んだ小剣の刃が、俺の首に添えられている。",
   "cells": [
    {
     "sid": "da0704:T00061",
     "kind": "본문",
     "jp": "目の前で何かが光ったと思った次の瞬間、首筋に冷たいものが\n触れた。\n\n　ロイガー……いや、ツァール……いや、どっちがどっちだ？",
     "ko": "눈앞에서 무언가가 빛났다고 생각한 다음 순간, 목덜미에 차가운 것이\n닿았다.\n\n　로이거…… 아니, 차르…… 아니, 어느 쪽이 어느 쪽이지?"
    },
    {
     "sid": "da0704:T00062",
     "kind": "본문",
     "jp": "まあとにかく、九朔が喚んだ小剣の刃が、俺の首に添えられている。",
     "ko": "뭐 아무튼, 쿠자쿠가 소환한 소검의 칼날이 내 목에 대어져 있다."
    }
   ]
  },
  {
   "uid": "da0704:U00046",
   "speaker": "アズラッド",
   "jp": "「……大十字九郎」",
   "cells": [
    {
     "sid": "da0704:T00063",
     "kind": "본문",
     "jp": "「……大十字九郎」",
     "ko": "「……다이쥬지 쿠로」"
    }
   ]
  },
  {
   "uid": "da0704:U00047",
   "speaker": "九郎",
   "jp": "「いや、大丈夫だ……と思う」\n\n　身構えるアズラッドを手で制する。俺は慎重に、九朔と向き合った。\n\n　小剣を抜き放った体勢で、俺を睨みつけてくる。その表情は本気の怒りに歪んでいた。どうしてコイツはここまでの怒りを、俺に向けるのだろうか？",
   "cells": [
    {
     "sid": "da0704:T00064",
     "kind": "본문",
     "jp": "「いや、大丈夫だ……と思う」\n\n　身構えるアズラッドを手で制する。",
     "ko": "「아니, 괜찮아…… 아마도」\n\n　자세를 잡는 아즈라드를 손으로 제지한다."
    },
    {
     "sid": "da0704:T00065",
     "kind": "본문",
     "jp": "俺は慎重に、九朔と向き合った。\n\n　小剣を抜き放った体勢で、俺を睨みつけてくる。",
     "ko": "나는 신중하게 쿠자쿠와 마주 보았다.\n\n　소검을 뽑아 든 자세로 나를 노려본다."
    },
    {
     "sid": "da0704:T00066",
     "kind": "본문",
     "jp": "その表情は本気の怒りに歪んでいた。",
     "ko": "그 표정은 진심 어린 분노로 일그러져 있었다."
    },
    {
     "sid": "da0704:T00067",
     "kind": "본문",
     "jp": "どうしてコイツはここまでの怒りを、俺に向けるのだろうか？",
     "ko": "어째서 이 녀석은 이토록 거센 분노를 나에게 향하는 것일까?"
    }
   ]
  },
  {
   "uid": "da0704:U00048",
   "speaker": "九朔",
   "jp": "「『独りで闘うよりは～』だと！？　\nいけしゃあしゃあと！　どの口がほざくか！」",
   "cells": [
    {
     "sid": "da0704:T00068",
     "kind": "본문",
     "jp": "「『独りで闘うよりは～』だと！？　\nいけしゃあしゃあと！　どの口がほざくか！」",
     "ko": "「『혼자서 싸우는 것보다는~』이라고!?\n뻔뻔스럽게도! 어느 입으로 그런 소리를 지껄이느냐!」"
    }
   ]
  },
  {
   "uid": "da0704:U00049",
   "speaker": "九郎",
   "jp": "「お、おいおい……落ち着……」小剣がさらに強く押し付けられる。皮膚がわずかに裂け、血が首筋を伝った。",
   "cells": [
    {
     "sid": "da0704:T00069",
     "kind": "본문",
     "jp": "「お、おいおい……落ち着……」",
     "ko": "「어, 어이, 어이…… 진정……」"
    },
    {
     "sid": "da0704:T00070",
     "kind": "본문",
     "jp": "小剣がさらに強く押し付けられる。",
     "ko": "소검이 한층 더 강하게 짓눌러 온다."
    },
    {
     "sid": "da0704:T00071",
     "kind": "본문",
     "jp": "皮膚がわずかに裂け、血が首筋を伝った。",
     "ko": "피부가 살짝 찢어지며 피가 목덜미를 타고 흘렀다."
    }
   ]
  },
  {
   "uid": "da0704:U00050",
   "speaker": "九郎",
   "jp": "「……うっ」",
   "cells": [
    {
     "sid": "da0704:T00072",
     "kind": "본문",
     "jp": "「……うっ」",
     "ko": "「……윽」"
    }
   ]
  },
  {
   "uid": "da0704:U00051",
   "speaker": "九朔",
   "jp": "「貴様には……貴様だけにはそれを言われ\nたくないッ！　そもそも！〈われ〉我が戦うのは……〈われ〉我が独りなのは……ッ！」",
   "cells": [
    {
     "sid": "da0704:T00073",
     "kind": "본문",
     "jp": "「貴様には……貴様だけにはそれを言われ\nたくないッ！　そもそも！",
     "ko": "「네놈에게는…… 네놈에게만은 그런 말을 듣고\n싶지 않다! 애초에! ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00007",
     "kind": "루비 읽기",
     "jp": "われ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00074",
     "kind": "본문",
     "jp": "我",
     "ko": "내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00075",
     "kind": "본문",
     "jp": "が戦うのは……",
     "ko": "가 싸우는 것은……\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00008",
     "kind": "루비 읽기",
     "jp": "われ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00076",
     "kind": "본문",
     "jp": "我",
     "ko": "내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00077",
     "kind": "본문",
     "jp": "が独りなのは……ッ！」",
     "ko": "가 혼자인 것은……윽!」"
    }
   ]
  },
  {
   "uid": "da0704:U00052",
   "speaker": "九郎",
   "jp": "「…………」\n\n　九朔はますます激昂する。だが、どうしてだろう。俺の目には、九朔の怒り狂う姿が、今にも泣き出しそうな子どもの\nようにも見えるのだ。",
   "cells": [
    {
     "sid": "da0704:T00078",
     "kind": "본문",
     "jp": "「…………」\n\n　九朔はますます激昂する。",
     "ko": "「…………」\n\n　쿠자쿠는 점점 더 격앙한다."
    },
    {
     "sid": "da0704:T00079",
     "kind": "본문",
     "jp": "だが、どうしてだろう。",
     "ko": "하지만 어째서일까."
    },
    {
     "sid": "da0704:T00080",
     "kind": "본문",
     "jp": "俺の目には、九朔の怒り狂う姿が、今にも泣き出しそうな子どもの\nようにも見えるのだ。",
     "ko": "내 눈에는 쿠자쿠의 성난 모습이 당장이라도 울음을 터뜨릴 것 같은 아이\n처럼 보이기도 한다."
    }
   ]
  },
  {
   "uid": "da0704:U00053",
   "speaker": "九朔",
   "jp": "「～～～～……ッ」",
   "cells": [
    {
     "sid": "da0704:T00081",
     "kind": "본문",
     "jp": "「～～～～……ッ」",
     "ko": "「~~~~……윽」"
    }
   ]
  },
  {
   "uid": "da0704:U00054",
   "speaker": "九郎",
   "jp": "「――――――」",
   "cells": [
    {
     "sid": "da0704:T00082",
     "kind": "본문",
     "jp": "「――――――」",
     "ko": "「――――――」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00055",
   "speaker": "アズラッド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0704:T00083",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0704:U00056",
   "speaker": "(지문)",
   "jp": "一触即発の空気。だがむしろ、俺は落ち着いていた。俺は九朔の瞳を真っ直ぐに見つめながら――",
   "cells": [
    {
     "sid": "da0704:T00084",
     "kind": "본문",
     "jp": "一触即発の空気。",
     "ko": "일촉즉발의 공기."
    },
    {
     "sid": "da0704:T00085",
     "kind": "본문",
     "jp": "だがむしろ、俺は落ち着いていた。",
     "ko": "하지만 오히려 나는 침착했다."
    },
    {
     "sid": "da0704:T00086",
     "kind": "본문",
     "jp": "俺は九朔の瞳を真っ直ぐに見つめながら――",
     "ko": "나는 쿠자쿠의 눈동자를 똑바로 응시하며――"
    }
   ]
  },
  {
   "uid": "da0704:U00057",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り～！」",
   "cells": [
    {
     "sid": "da0704:T00087",
     "kind": "본문",
     "jp": "「てけり・り～！」",
     "ko": "「테케리・리~!」"
    }
   ]
  },
  {
   "uid": "da0704:U00058",
   "speaker": "(지문)",
   "jp": "――シリアスムード、粉微塵。",
   "cells": [
    {
     "sid": "da0704:T00088",
     "kind": "본문",
     "jp": "――シリアスムード、粉微塵。",
     "ko": "――시리어스 무드, 산산조각."
    }
   ]
  },
  {
   "uid": "da0704:U00059",
   "speaker": "アル",
   "jp": "「ええい！\n　いい加減にせんか、汝等！\n　見苦しい！」",
   "cells": [
    {
     "sid": "da0704:T00089",
     "kind": "본문",
     "jp": "「ええい！\n　いい加減にせんか、汝等！\n　見苦しい！」",
     "ko": "「에에잇!\n　적당히 하지 못할까, 그대들!\n　볼썽사납구나!」"
    }
   ]
  },
  {
   "uid": "da0704:U00060",
   "speaker": "九朔",
   "jp": "「……『アル・アジフ』」",
   "cells": [
    {
     "sid": "da0704:T00090",
     "kind": "본문",
     "jp": "「……『アル・アジフ』」",
     "ko": "「……『알 아지프』」"
    }
   ]
  },
  {
   "uid": "da0704:U00061",
   "speaker": "九郎",
   "jp": "「こらこら……休んでなきゃマズイんじゃないか？」",
   "cells": [
    {
     "sid": "da0704:T00091",
     "kind": "본문",
     "jp": "「こらこら……休んでなきゃマズイんじゃないか？」",
     "ko": "「이봐, 이봐…… 쉬고 있어야 하는 거 아니냐?」"
    }
   ]
  },
  {
   "uid": "da0704:U00062",
   "speaker": "アル",
   "jp": "「こんな状況で〈のんき〉暢気に寝てられるか」",
   "cells": [
    {
     "sid": "da0704:T00092",
     "kind": "본문",
     "jp": "「こんな状況で",
     "ko": "「이런 상황에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0704:R00009",
     "kind": "루비 읽기",
     "jp": "のんき",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0704:T00093",
     "kind": "본문",
     "jp": "暢気",
     "ko": "태평하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0704:T00094",
     "kind": "본문",
     "jp": "に寝てられるか」",
     "ko": "게 누워 있을 수 있겠느냐」"
    }
   ]
  },
  {
   "uid": "da0704:U00063",
   "speaker": "アル",
   "jp": "「機体の調子を見に来れば……\n　何だ何だ、汝等は。くだらんことで\n　言い争いよって。情けない」",
   "cells": [
    {
     "sid": "da0704:T00095",
     "kind": "본문",
     "jp": "「機体の調子を見に来れば……\n　何だ何だ、汝等は。くだらんことで\n　言い争いよって。情けない」",
     "ko": "「기체의 상태를 보러 와 봤더니……\n　뭐냐, 뭐냐, 그대들은. 시시한 일로\n　말다툼이나 하고. 한심하구나」"
    }
   ]
  },
  {
   "uid": "da0704:U00064",
   "speaker": "ダンセイニ",
   "jp": "「てけり・りっ」",
   "cells": [
    {
     "sid": "da0704:T00096",
     "kind": "본문",
     "jp": "「てけり・りっ」",
     "ko": "「테케리・릿」"
    }
   ]
  },
