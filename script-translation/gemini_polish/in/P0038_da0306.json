{
 "packet": "P0038_da0306",
 "units": [
  {
   "uid": "da0306:U00001",
   "speaker": "アナザーブラッド",
   "jp": "「――嗚呼、残酷な３人！\n　こんな時間に\n　こんな夢見る天気のもとで\n　どんな小さな羽さえもそよがぬ\n　弱い息のお話をせがむとは！」",
   "cells": [
    {
     "sid": "da0306:T00001",
     "kind": "본문",
     "jp": "「――嗚呼、残酷な３人！\n　こんな時間に\n　こんな夢見る天気のもとで\n　どんな小さな羽さえもそよがぬ\n　弱い息のお話をせがむとは！」",
     "ko": "「――아아, 잔혹한 세 사람!\n　이런 시간에\n　이런 꿈꾸는 듯한 날씨 아래서\n　아무리 작은 깃털조차 흔들지 못할\n　여린 숨결의 이야기를 조르다니!」"
    }
   ]
  },
  {
   "uid": "da0306:U00002",
   "speaker": "(지문)",
   "jp": "少年が何かを答えるより早く、その声は歪んだアーカムシティに\n響き渡った。",
   "cells": [
    {
     "sid": "da0306:T00002",
     "kind": "본문",
     "jp": "少年が何かを答えるより早く、その声は歪んだアーカムシティに\n響き渡った。",
     "ko": "소년이 무언가를 답하기보다 빠르게, 그 목소리는 일그러진 아컴 시티에 울려 퍼졌다."
    }
   ]
  },
  {
   "uid": "da0306:U00003",
   "speaker": "九朔",
   "jp": "「……ッ！　アナザーブラッド！」",
   "cells": [
    {
     "sid": "da0306:T00003",
     "kind": "본문",
     "jp": "「……ッ！　アナザーブラッド！」",
     "ko": "「……읏!　어나더 블러드!」"
    }
   ]
  },
  {
   "uid": "da0306:U00004",
   "speaker": "アナザーブラッド",
   "jp": "「『物語』よ。『物語』を〈はじ〉創めましょう。\n　でたらめを入れて、語りを遮りながら。\n　ゆっくりひとつひとつ、風変わりな\n　出来事を打ち出して――\n　歪んだ国の『物語』を育みましょう」",
   "cells": [
    {
     "sid": "da0306:T00004",
     "kind": "본문",
     "jp": "「『物語』よ。『物語』を",
     "ko": "「『이야기』야. 『이야기』를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00001",
     "kind": "루비 읽기",
     "jp": "はじ",
     "ko": "시작",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00005",
     "kind": "본문",
     "jp": "創",
     "ko": "창조",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00006",
     "kind": "본문",
     "jp": "めましょう。\n　でたらめを入れて、語りを遮りながら。\n　ゆっくりひとつひとつ、風変わりな\n　出来事を打ち出して――\n　歪んだ国の『物語』を育みましょう」",
     "ko": "해 볼까.\n　엉터리를 섞어 넣고, 이야기를 가로막으면서.\n　천천히 하나씩, 색다른\n　사건을 쏘아 올리며――\n　일그러진 나라의 『이야기』를 키워 나가자」"
    }
   ]
  },
  {
   "uid": "da0306:U00005",
   "speaker": "九朔",
   "jp": "「何処だ！　姿を現せ！」",
   "cells": [
    {
     "sid": "da0306:T00007",
     "kind": "본문",
     "jp": "「何処だ！　姿を現せ！」",
     "ko": "「어디냐!　모습을 드러내라!」"
    }
   ]
  },
  {
   "uid": "da0306:U00006",
   "speaker": "アナザーブラッド",
   "jp": "「どんなお話が良いかしら、騎士殿？\n　やっぱりゲーム？　ゲームよね。\n　ゲームが良いわ。貴方の戦いは\n　いつだって滑稽な〈ゲーム〉遊戯だもの。\n　ねっ、〈サー・クザク〉九朔卿？」",
   "cells": [
    {
     "sid": "da0306:T00008",
     "kind": "본문",
     "jp": "「どんなお話が良いかしら、騎士殿？\n　やっぱりゲーム？　ゲームよね。\n　ゲームが良いわ。貴方の戦いは\n　いつだって滑稽な",
     "ko": "「어떤 이야기가 좋을까, 기사공?\n　역시 게임?　게임이지.\n　게임이 좋겠어. 당신의 싸움은\n　언제나 우스꽝스러운 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00002",
     "kind": "루비 읽기",
     "jp": "ゲーム",
     "ko": "게임",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00009",
     "kind": "본문",
     "jp": "遊戯",
     "ko": "유희",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00010",
     "kind": "본문",
     "jp": "だもの。\n　ねっ、",
     "ko": "인걸.\n　그치, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00003",
     "kind": "루비 읽기",
     "jp": "サー・クザク",
     "ko": "서 쿠자쿠",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00011",
     "kind": "본문",
     "jp": "九朔卿",
     "ko": "쿠자쿠 경",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00012",
     "kind": "본문",
     "jp": "？」",
     "ko": "?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0306:U00007",
   "speaker": "九朔",
   "jp": "「貴様……！」",
   "cells": [
    {
     "sid": "da0306:T00013",
     "kind": "본문",
     "jp": "「貴様……！」",
     "ko": "「네 이년……!」"
    }
   ]
  },
  {
   "uid": "da0306:U00008",
   "speaker": "九郎",
   "jp": "「……乱れた気をまき散らすな」",
   "cells": [
    {
     "sid": "da0306:T00014",
     "kind": "본문",
     "jp": "「……乱れた気をまき散らすな」",
     "ko": "「……흐트러진 기를 흩뿌리지 마라」"
    }
   ]
  },
  {
   "uid": "da0306:U00009",
   "speaker": "九朔",
   "jp": "「何だとぉっ！」",
   "cells": [
    {
     "sid": "da0306:T00015",
     "kind": "본문",
     "jp": "「何だとぉっ！」",
     "ko": "「뭐라고오옷!」"
    }
   ]
  },
  {
   "uid": "da0306:U00010",
   "speaker": "九郎",
   "jp": "「落ち着け……感じねえのか。この殺気を」",
   "cells": [
    {
     "sid": "da0306:T00016",
     "kind": "본문",
     "jp": "「落ち着け……感じねえのか。この殺気を」",
     "ko": "「진정해…… 안 느껴지냐. 이 살기가」"
    }
   ]
  },
  {
   "uid": "da0306:U00011",
   "speaker": "九朔",
   "jp": "「……ッ！？」",
   "cells": [
    {
     "sid": "da0306:T00017",
     "kind": "본문",
     "jp": "「……ッ！？」",
     "ko": "「……읏!?」"
    }
   ]
  },
  {
   "uid": "da0306:U00012",
   "speaker": "(지문)",
   "jp": "少し前から、強烈な殺意が俺たちに向けられているのを感じていた。殺気の元を目で追えば――",
   "cells": [
    {
     "sid": "da0306:T00018",
     "kind": "본문",
     "jp": "少し前から、強烈な殺意が俺たちに向けられているのを感じていた。",
     "ko": "조금 전부터 강렬한 살의가 우리를 향하고 있는 것이 느껴졌다."
    },
    {
     "sid": "da0306:T00019",
     "kind": "본문",
     "jp": "殺気の元を目で追えば――",
     "ko": "살기의 근원을 눈으로 쫓으니――"
    }
   ]
  },
  {
   "uid": "da0306:U00013",
   "speaker": "(지문)",
   "jp": "ミスカトニック大学、時計塔。\n\n\n　アーカムシティで最も巨大な建築物の、巨大な時計盤。その針の上に、そいつらの姿があった。",
   "cells": [
    {
     "sid": "da0306:T00020",
     "kind": "본문",
     "jp": "ミスカトニック大学、時計塔。\n\n\n　アーカムシティで最も巨大な建築物の、巨大な時計盤。",
     "ko": "미스캐토닉 대학, 시계탑.\n\n\n　아컴 시티에서 가장 거대한 건축물의, 거대한 시계판."
    },
    {
     "sid": "da0306:T00021",
     "kind": "본문",
     "jp": "その針の上に、そいつらの姿があった。",
     "ko": "그 바늘 위에 그 녀석들의 모습이 있었다."
    }
   ]
  },
  {
   "uid": "da0306:U00014",
   "speaker": "九郎",
   "jp": "「……カリグラ！　クラウディウス！」",
   "cells": [
    {
     "sid": "da0306:T00022",
     "kind": "본문",
     "jp": "「……カリグラ！　クラウディウス！」",
     "ko": "「……칼리굴라!　클라우디우스!」"
    }
   ]
  },
  {
   "uid": "da0306:U00015",
   "speaker": "アル",
   "jp": "「さっそくお出迎えという訳か」",
   "cells": [
    {
     "sid": "da0306:T00023",
     "kind": "본문",
     "jp": "「さっそくお出迎えという訳か」",
     "ko": "「일찌감치 마중이라도 나왔다는 건가」"
    }
   ]
  },
  {
   "uid": "da0306:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「昨夜のウェスパシアヌスよりも、\n　さらに〈リアリティ〉強さが増してるわよ。\n　がんばってね、探偵さん。\n　それに騎士殿？」",
   "cells": [
    {
     "sid": "da0306:T00024",
     "kind": "본문",
     "jp": "「昨夜のウェスパシアヌスよりも、\n　さらに",
     "ko": "「어젯밤의 베스파시아누스보다도,\n　한층 더 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00004",
     "kind": "루비 읽기",
     "jp": "リアリティ",
     "ko": "리얼리티가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00025",
     "kind": "본문",
     "jp": "強さ",
     "ko": "강함이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00026",
     "kind": "본문",
     "jp": "が増してるわよ。\n　がんばってね、探偵さん。\n　それに騎士殿？」",
     "ko": " 늘어나 있어.\n　힘내렴, 탐정님.\n　그리고 기사공?」"
    }
   ]
  },
  {
   "uid": "da0306:U00017",
   "speaker": "九朔",
   "jp": "「……必ず貴様を表に引きずり出し、\n　その〈そっくび〉素首、斬り落としてくれる！」",
   "cells": [
    {
     "sid": "da0306:T00027",
     "kind": "본문",
     "jp": "「……必ず貴様を表に引きずり出し、\n　その",
     "ko": "「……반드시 네년을 밖으로 끌어내어,\n　그 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00005",
     "kind": "루비 읽기",
     "jp": "そっくび",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00028",
     "kind": "본문",
     "jp": "素首",
     "ko": "모가지",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00029",
     "kind": "본문",
     "jp": "、斬り落としてくれる！」",
     "ko": ", 베어 떨어뜨려 주마!」"
    }
   ]
  },
  {
   "uid": "da0306:U00018",
   "speaker": "アナザーブラッド",
   "jp": "「あはははは！　急がないと、\n　お母様は私が食べちゃうわよ。〈・・・・・・・・・〉血の一滴も残さずに……ね？\n　あははははははははは！」",
   "cells": [
    {
     "sid": "da0306:T00030",
     "kind": "본문",
     "jp": "「あはははは！　急がないと、\n　お母様は私が食べちゃうわよ。",
     "ko": "「아하하하하!　서두르지 않으면,\n　어머님은 내가 먹어 버릴 거야.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00006",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・",
     "ko": "・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00031",
     "kind": "본문",
     "jp": "血の一滴も残さずに",
     "ko": "피 한 방울도 남기지 않고",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00032",
     "kind": "본문",
     "jp": "……ね？\n　あははははははははは！」",
     "ko": "…… 말이지?\n　아하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da0306:U00019",
   "speaker": "アル",
   "jp": "「ぐっ……！」",
   "cells": [
    {
     "sid": "da0306:T00033",
     "kind": "본문",
     "jp": "「ぐっ……！」",
     "ko": "「극……!」"
    }
   ]
  },
  {
   "uid": "da0306:U00020",
   "speaker": "(지문)",
   "jp": "少女の声はそれっきり聴こえなくなった。",
   "cells": [
    {
     "sid": "da0306:T00034",
     "kind": "본문",
     "jp": "少女の声はそれっきり聴こえなくなった。",
     "ko": "소녀의 목소리는 그걸로 더 이상 들리지 않게 되었다."
    }
   ]
  },
  {
   "uid": "da0306:U00021",
   "speaker": "クラウディウス",
   "jp": "「チッ……人使いが荒え女だ。だけどよ……」",
   "cells": [
    {
     "sid": "da0306:T00035",
     "kind": "본문",
     "jp": "「チッ……人使いが荒え女だ。だけどよ……」",
     "ko": "「칫…… 사람을 험하게 부려 먹는 여자군. 하지만 말이야……」"
    }
   ]
  },
  {
   "uid": "da0306:U00022",
   "speaker": "(지문)",
   "jp": "クラウディウスから黒い風が噴き出す。口元には残忍な笑みを浮かべ、瞳には濁った憎悪を湛えている。",
   "cells": [
    {
     "sid": "da0306:T00036",
     "kind": "본문",
     "jp": "クラウディウスから黒い風が噴き出す。",
     "ko": "클라우디우스에게서 검은 바람이 뿜어져 나온다."
    },
    {
     "sid": "da0306:T00037",
     "kind": "본문",
     "jp": "口元には残忍な笑みを浮かべ、瞳には濁った憎悪を湛えている。",
     "ko": "입가에는 잔인한 미소를 띠고, 눈동자에는 탁한 증오를 머금고 있다."
    }
   ]
  },
  {
   "uid": "da0306:U00023",
   "speaker": "クラウディウス",
   "jp": "「大十字九郎をこの手で〈バラ〉解体せるんだ……\n　少しぐらいなら踊らされてやるよ！」",
   "cells": [
    {
     "sid": "da0306:T00038",
     "kind": "본문",
     "jp": "「大十字九郎をこの手で",
     "ko": "「다이쥬지 쿠로를 이 손으로 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00007",
     "kind": "루비 읽기",
     "jp": "バラ",
     "ko": "조각낼",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00039",
     "kind": "본문",
     "jp": "解体",
     "ko": "해체할",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00040",
     "kind": "본문",
     "jp": "せるんだ……\n　少しぐらいなら踊らされてやるよ！」",
     "ko": " 수 있거든……\n　조금 정도라면 놀아나 주지!」"
    }
   ]
  },
  {
   "uid": "da0306:U00024",
   "speaker": "カリグラ",
   "jp": "「……コロされた礼だ……\n　こロス……大十字九郎……」",
   "cells": [
    {
     "sid": "da0306:T00041",
     "kind": "본문",
     "jp": "「……コロされた礼だ……\n　こロス……大十字九郎……」",
     "ko": "「……죽임당한 답례다……\n　죽인다…… 다이쥬지 쿠로……」"
    }
   ]
  },
  {
   "uid": "da0306:U00025",
   "speaker": "九郎",
   "jp": "「チィッ……死んでもしつこい奴らだ」",
   "cells": [
    {
     "sid": "da0306:T00042",
     "kind": "본문",
     "jp": "「チィッ……死んでもしつこい奴らだ」",
     "ko": "「치잇…… 죽어서도 끈질긴 녀석들이군」"
    }
   ]
  },
  {
   "uid": "da0306:U00026",
   "speaker": "九朔",
   "jp": "「大十字九郎……\n　貴方は手を出すな。\n　我が片を付ける」",
   "cells": [
    {
     "sid": "da0306:T00043",
     "kind": "본문",
     "jp": "「大十字九郎……\n　貴方は手を出すな。\n　我が片を付ける」",
     "ko": "「다이쥬지 쿠로……\n　당신은 손대지 마라.\n　내가 끝장을 내겠다」"
    }
   ]
  },
  {
   "uid": "da0306:U00027",
   "speaker": "アル",
   "jp": "「侮るな。贋作とはいえ彼奴等は\n　アンチクロス……強大な魔力を\n　持った魔術師どもだ。容易な敵\n　ではない」",
   "cells": [
    {
     "sid": "da0306:T00044",
     "kind": "본문",
     "jp": "「侮るな。贋作とはいえ彼奴等は\n　アンチクロス……強大な魔力を\n　持った魔術師どもだ。容易な敵\n　ではない」",
     "ko": "「얕보지 마라. 위작이라곤 하나 저 녀석들은\n　안티크로스…… 강대한 마력을\n　지닌 마술사 놈들이다. 만만한 적\n　이 아니야」"
    }
   ]
  },
  {
   "uid": "da0306:U00028",
   "speaker": "九朔",
   "jp": "「……我は貴女の〈マスター〉主とは違う。\n　あの程度なら我一人で充分だ」",
   "cells": [
    {
     "sid": "da0306:T00045",
     "kind": "본문",
     "jp": "「……我は貴女の",
     "ko": "「……나는 당신의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00008",
     "kind": "루비 읽기",
     "jp": "マスター",
     "ko": "마스터와는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00046",
     "kind": "본문",
     "jp": "主",
     "ko": "주인과는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00047",
     "kind": "본문",
     "jp": "とは違う。\n　あの程度なら我一人で充分だ」",
     "ko": " 다르다.\n　저 정도라면 나 혼자서 충분하다」"
    }
   ]
  },
  {
   "uid": "da0306:U00029",
   "speaker": "アル",
   "jp": "「我等の戦いを識らぬ小僧が\n　自惚れるな！」",
   "cells": [
    {
     "sid": "da0306:T00048",
     "kind": "본문",
     "jp": "「我等の戦いを識らぬ小僧が\n　自惚れるな！」",
     "ko": "「우리의 싸움을 모르는 애송이가\n　자만하지 마라!」"
    }
   ]
  },
  {
   "uid": "da0306:U00030",
   "speaker": "九朔",
   "jp": "「～～～っ」",
   "cells": [
    {
     "sid": "da0306:T00049",
     "kind": "본문",
     "jp": "「～～～っ」",
     "ko": "「~~~읏」"
    }
   ]
  },
  {
   "uid": "da0306:U00031",
   "speaker": "(지문)",
   "jp": "アルに叱責され、少年は悔しそうに下唇を噛んだ。……コイツ、態度は大げさで偉そうだが、精神的にはまだまだ\n青いようだ。",
   "cells": [
    {
     "sid": "da0306:T00050",
     "kind": "본문",
     "jp": "アルに叱責され、少年は悔しそうに下唇を噛んだ。",
     "ko": "알에게 질책당하자, 소년은 분한 듯이 아랫입술을 깨물었다."
    },
    {
     "sid": "da0306:T00051",
     "kind": "본문",
     "jp": "……コイツ、態度は大げさで偉そうだが、精神的にはまだまだ\n青いようだ。",
     "ko": "……이 녀석, 태도는 거창하고 거만하지만, 정신적으로는 아직 한참 미숙한 모양이다."
    }
   ]
  },
  {
   "uid": "da0306:U00032",
   "speaker": "九郎",
   "jp": "「まあ、どのみち向こうが〈ほ〉放っとかねえさ。俺も戦わせてもらうぜ」\n\n　フォロー……のつもりではないが、そう言って２人の間に入る。少年はますます〈ふてくさ〉不貞腐れた表情で、ぶっきらぼうに答えた。",
   "cells": [
    {
     "sid": "da0306:T00052",
     "kind": "본문",
     "jp": "「まあ、どのみち向こうが",
     "ko": "「뭐, 어차피 저쪽에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00009",
     "kind": "루비 읽기",
     "jp": "ほ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00053",
     "kind": "본문",
     "jp": "放",
     "ko": "내버려",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00054",
     "kind": "본문",
     "jp": "っとかねえさ。俺も戦わせてもらうぜ」\n\n　フォロー……のつもりではないが、そう言って２人の間に入る。",
     "ko": " 두질 않을걸. 나도 싸우게 해 달라고」\n\n　거들어 줄…… 생각은 아니지만, 그렇게 말하며 두 사람 사이에 끼어든다."
    },
    {
     "sid": "da0306:T00055",
     "kind": "본문",
     "jp": "少年はますます",
     "ko": "소년은 한층 더 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00010",
     "kind": "루비 읽기",
     "jp": "ふてくさ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00056",
     "kind": "본문",
     "jp": "不貞腐",
     "ko": "뾰로통해",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00057",
     "kind": "본문",
     "jp": "れた表情で、ぶっきらぼうに答えた。",
     "ko": "진 표정으로 퉁명스럽게 답했다."
    }
   ]
  },
  {
   "uid": "da0306:U00033",
   "speaker": "九朔",
   "jp": "「好きにしろ。\n　足だけは引っ張るな」",
   "cells": [
    {
     "sid": "da0306:T00058",
     "kind": "본문",
     "jp": "「好きにしろ。\n　足だけは引っ張るな」",
     "ko": "「마음대로 해라.\n　발목이나 잡지 마라」"
    }
   ]
  },
  {
   "uid": "da0306:U00034",
   "speaker": "九郎",
   "jp": "「〈おう〉応よ。さてと……こいつで２対２だ」",
   "cells": [
    {
     "sid": "da0306:T00059",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0306:R00011",
     "kind": "루비 읽기",
     "jp": "おう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00060",
     "kind": "본문",
     "jp": "応",
     "ko": "오냐",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00061",
     "kind": "본문",
     "jp": "よ。さてと……こいつで２対２だ」",
     "ko": ". 자 그럼…… 이걸로 2대 2다」"
    }
   ]
  },
  {
   "uid": "da0306:U00035",
   "speaker": "(지문)",
   "jp": "時計塔の２人を見る。向こうさんは既に、殺ル気満々といった様子だ。俺たちは闘気を昂めながら、時計塔に向かって降下する。",
   "cells": [
    {
     "sid": "da0306:T00062",
     "kind": "본문",
     "jp": "時計塔の２人を見る。",
     "ko": "시계탑의 두 사람을 본다."
    },
    {
     "sid": "da0306:T00063",
     "kind": "본문",
     "jp": "向こうさんは既に、殺ル気満々といった様子だ。",
     "ko": "저쪽 양반들은 이미 죽일 기세 등등한 모습이다."
    },
    {
     "sid": "da0306:T00064",
     "kind": "본문",
     "jp": "俺たちは闘気を昂めながら、時計塔に向かって降下する。",
     "ko": "우리는 투기를 끌어올리며 시계탑을 향해 강하한다."
    }
   ]
  },
  {
   "uid": "da0306:U00036",
   "speaker": "九郎",
   "jp": "「そうだ。アルの質問があやふやになってたけどよ」",
   "cells": [
    {
     "sid": "da0306:T00065",
     "kind": "본문",
     "jp": "「そうだ。アルの質問があやふやになってたけどよ」",
     "ko": "「맞다. 알의 질문이 흐지부지됐었는데 말이야」"
    }
   ]
  },
  {
   "uid": "da0306:U00037",
   "speaker": "九朔",
   "jp": "「……何だ、唐突に」",
   "cells": [
    {
     "sid": "da0306:T00066",
     "kind": "본문",
     "jp": "「……何だ、唐突に」",
     "ko": "「……뭐냐, 뜬금없이」"
    }
   ]
  },
  {
   "uid": "da0306:U00038",
   "speaker": "九郎",
   "jp": "「結局、お前って何〈もん〉者よ？」",
   "cells": [
    {
     "sid": "da0306:T00067",
     "kind": "본문",
     "jp": "「結局、お前って何",
     "ko": "「결국, 너는 정체가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00012",
     "kind": "루비 읽기",
     "jp": "もん",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00068",
     "kind": "본문",
     "jp": "者",
     "ko": "뭐",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00069",
     "kind": "본문",
     "jp": "よ？」",
     "ko": "냐?」"
    }
   ]
  },
  {
   "uid": "da0306:U00039",
   "speaker": "九朔",
   "jp": "「今はそんなことを言っている場合じゃ……」",
   "cells": [
    {
     "sid": "da0306:T00070",
     "kind": "본문",
     "jp": "「今はそんなことを言っている場合じゃ……」",
     "ko": "「지금은 그런 소리를 하고 있을 때가……」"
    }
   ]
  },
  {
   "uid": "da0306:U00040",
   "speaker": "九郎",
   "jp": "「一応は一緒に戦うんだ。名前くらい教えろ」",
   "cells": [
    {
     "sid": "da0306:T00071",
     "kind": "본문",
     "jp": "「一応は一緒に戦うんだ。名前くらい教えろ」",
     "ko": "「일단은 함께 싸우는 거잖아. 이름 정도는 알려 줘라」"
    }
   ]
  },
  {
   "uid": "da0306:U00041",
   "speaker": "九朔",
   "jp": "「………………」",
   "cells": [
    {
     "sid": "da0306:T00072",
     "kind": "본문",
     "jp": "「………………」",
     "ko": "「………………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0306:U00042",
   "speaker": "(지문)",
   "jp": "不機嫌そうな表情はそのままだ。少年は、相変わらずぶっきらぼうに、だが素直に答えた。",
   "cells": [
    {
     "sid": "da0306:T00073",
     "kind": "본문",
     "jp": "不機嫌そうな表情はそのままだ。",
     "ko": "기분 나쁜 듯한 표정은 그대로다."
    },
    {
     "sid": "da0306:T00074",
     "kind": "본문",
     "jp": "少年は、相変わらずぶっきらぼうに、だが素直に答えた。",
     "ko": "소년은 변함없이 퉁명스럽게, 하지만 순순히 답했다."
    }
   ]
  },
  {
   "uid": "da0306:U00043",
   "speaker": "九朔",
   "jp": "「……ぃ……〈クザク〉九朔。騎士〈クザク〉九朔だ。\n　まだ修行中の身ではあるが」",
   "cells": [
    {
     "sid": "da0306:T00075",
     "kind": "본문",
     "jp": "「……ぃ……",
     "ko": "「……이…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00013",
     "kind": "루비 읽기",
     "jp": "クザク",
     "ko": "쿠자쿠",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00076",
     "kind": "본문",
     "jp": "九朔",
     "ko": "구삭",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00077",
     "kind": "본문",
     "jp": "。騎士",
     "ko": ". 기사 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00014",
     "kind": "루비 읽기",
     "jp": "クザク",
     "ko": "쿠자쿠다",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00078",
     "kind": "본문",
     "jp": "九朔",
     "ko": "구삭이다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00079",
     "kind": "본문",
     "jp": "だ。\n　まだ修行中の身ではあるが」",
     "ko": ".\n　아직 수행 중인 몸이긴 하지만」"
    }
   ]
  },
  {
   "uid": "da0306:U00044",
   "speaker": "九郎",
   "jp": "「……クザク？」\n\n　妙な語感だ。何処の国の言葉だろう？",
   "cells": [
    {
     "sid": "da0306:T00080",
     "kind": "본문",
     "jp": "「……クザク？」\n\n　妙な語感だ。",
     "ko": "「……쿠자쿠?」\n\n　묘한 어감이다."
    },
    {
     "sid": "da0306:T00081",
     "kind": "본문",
     "jp": "何処の国の言葉だろう？",
     "ko": "어느 나라 말이지?"
    }
   ]
  },
  {
   "uid": "da0306:U00045",
   "speaker": "九朔",
   "jp": "「貴方の故郷と同じ言葉だ。\n　貴方の名と同じ数字の『九』と、\n　新月を意味する『〈さく〉朔』で九朔だ」",
   "cells": [
    {
     "sid": "da0306:T00082",
     "kind": "본문",
     "jp": "「貴方の故郷と同じ言葉だ。\n　貴方の名と同じ数字の『九』と、\n　新月を意味する『",
     "ko": "「당신의 고향과 같은 말이다.\n　당신의 이름과 같은 숫자인 『구』와,\n　초하루를 의미하는 『",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0306:R00015",
     "kind": "루비 읽기",
     "jp": "さく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0306:T00083",
     "kind": "본문",
     "jp": "朔",
     "ko": "삭",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0306:T00084",
     "kind": "본문",
     "jp": "』で九朔だ」",
     "ko": "』으로 쿠자쿠다」"
    }
   ]
  },
  {
   "uid": "da0306:U00046",
   "speaker": "九郎",
   "jp": "「……変な名前だな」",
   "cells": [
    {
     "sid": "da0306:T00085",
     "kind": "본문",
     "jp": "「……変な名前だな」",
     "ko": "「……이상한 이름이군」"
    }
   ]
  },
  {
   "uid": "da0306:U00047",
   "speaker": "九朔",
   "jp": "「なっ……！？　よりにもよって\n　貴方が言うかあぁっ！？」",
   "cells": [
    {
     "sid": "da0306:T00086",
     "kind": "본문",
     "jp": "「なっ……！？　よりにもよって\n　貴方が言うかあぁっ！？」",
     "ko": "「뭐랏……!?　하필이면\n　당신이 그런 소리를 하느냐아앗!?」"
    }
   ]
  },
  {
   "uid": "da0306:U00048",
   "speaker": "九郎",
   "jp": "「うわあっ！　何だよ、いきなりでけー声出してっ！……なに怒ってるんだ、お前？」",
   "cells": [
    {
     "sid": "da0306:T00087",
     "kind": "본문",
     "jp": "「うわあっ！　何だよ、いきなりでけー声出してっ！",
     "ko": "「우와앗!　뭐야, 갑자기 큰 소리를 내고선!"
    },
    {
     "sid": "da0306:T00088",
     "kind": "본문",
     "jp": "……なに怒ってるんだ、お前？」",
     "ko": "……왜 화를 내는 거야, 너?」"
    }
   ]
  },
  {
   "uid": "da0306:U00049",
   "speaker": "九朔",
   "jp": "「ふ、ふんッ！」",
   "cells": [
    {
     "sid": "da0306:T00089",
     "kind": "본문",
     "jp": "「ふ、ふんッ！」",
     "ko": "「흐, 흥읏!」"
    }
   ]
  },
  {
   "uid": "da0306:U00050",
   "speaker": "アル",
   "jp": "「お喋りはそこまでだ。来るぞ！」",
   "cells": [
    {
     "sid": "da0306:T00090",
     "kind": "본문",
     "jp": "「お喋りはそこまでだ。来るぞ！」",
     "ko": "「수다는 거기까지다. 온다!」"
    }
   ]
  },
  {
   "uid": "da0306:U00051",
   "speaker": "カリグラ",
   "jp": "「コロォォォォオオオオス！」",
   "cells": [
    {
     "sid": "da0306:T00091",
     "kind": "본문",
     "jp": "「コロォォォォオオオオス！」",
     "ko": "「죽인다아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0306:U00052",
   "speaker": "クラウディウス",
   "jp": "「ミンチになっちまいなぁッ！\n　ヒャァァァ――――ハァァッ！」",
   "cells": [
    {
     "sid": "da0306:T00092",
     "kind": "본문",
     "jp": "「ミンチになっちまいなぁッ！\n　ヒャァァァ――――ハァァッ！」",
     "ko": "「고기다짐이 되어 버려라앗!\n　햐아아아――――하아앗!」"
    }
   ]
  },
  {
   "uid": "da0306:U00053",
   "speaker": "九朔",
   "jp": "「血迷うな、亡者共！」",
   "cells": [
    {
     "sid": "da0306:T00093",
     "kind": "본문",
     "jp": "「血迷うな、亡者共！」",
     "ko": "「미쳐 날뛰지 마라, 망자 놈들!」"
    }
   ]
