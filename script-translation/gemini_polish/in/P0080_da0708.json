     "jp": "クライ",
     "ko": "크라이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00058",
     "kind": "본문",
     "jp": "歌う",
     "ko": "노래한다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00059",
