     "kind": "본문",
     "jp": "銃撃",
     "ko": "총격",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00047",
     "kind": "본문",
     "jp": "という名の",
     "ko": "이라는 이름의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00016",
     "kind": "루비 읽기",
     "jp": "ジュウリン",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00048",
     "kind": "본문",
     "jp": "蹂躙",
     "ko": "유린",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00049",
     "kind": "본문",
     "jp": "だ。",
     "ko": "이다."
    }
   ]
  },
  {
   "uid": "da0708:U00012",
   "speaker": "(지문)",
   "jp": "吼える、紅の銃。噛み砕かれる敵機の軍勢。",
   "cells": [
    {
     "sid": "da0708:T00050",
     "kind": "본문",
     "jp": "吼える、紅の銃。噛み砕かれる敵機の軍勢。",
     "ko": "포효하는 진홍의 총. 잘게 부서지는 적기의 군세."
    }
   ]
  },
  {
   "uid": "da0708:U00013",
   "speaker": "(지문)",
   "jp": "叫ぶ、〈しろがね〉銀の銃。引き裂かれる鉄鬼の軍勢。〈クライ〉歌う／〈クライ〉歌う／〈クライ〉歌う――",
   "cells": [
    {
     "sid": "da0708:T00051",
     "kind": "본문",
     "jp": "叫ぶ、",
     "ko": "부르짖는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00017",
     "kind": "루비 읽기",
     "jp": "しろがね",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00052",
     "kind": "본문",
     "jp": "銀",
     "ko": "은빛",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00053",
     "kind": "본문",
     "jp": "の銃。引き裂かれる鉄鬼の軍勢。",
     "ko": "의 총. 갈기갈기 찢기는 철귀의 군세.\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00018",
     "kind": "루비 읽기",
     "jp": "クライ",
     "ko": "크라이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
