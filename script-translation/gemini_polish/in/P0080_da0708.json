     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0708:U00014",
   "speaker": "(지문)",
   "jp": "Ｄトゥーソードの周囲から、全ての敵影が消えた。しかし『夢幻心母』からは、既に敵の第二陣が出撃している。",
   "cells": [
    {
     "sid": "da0708:T00060",
     "kind": "본문",
     "jp": "Ｄトゥーソードの周囲から、全ての敵影が消えた。",
     "ko": "D 투 소드의 주위에서 모든 적의 모습이 사라졌다."
    },
    {
     "sid": "da0708:T00061",
     "kind": "본문",
     "jp": "しかし『夢幻心母』からは、既に敵の第二陣が出撃している。",
     "ko": "하지만 『몽환심모』에서는 이미 적의 제2진이 출격해 있다."
    }
   ]
  },
  {
   "uid": "da0708:U00015",
   "speaker": "(지문)",
   "jp": "〈おびただ〉夥しいほどの敵／敵／敵。",
   "cells": [
    {
     "sid": "da0708:R00021",
     "kind": "루비 읽기",
     "jp": "おびただ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00062",
     "kind": "본문",
     "jp": "夥",
     "ko": "엄청난",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00063",
     "kind": "본문",
     "jp": "しいほどの敵／敵／敵。",
     "ko": " 수의 적/적/적."
    }
   ]
  },
  {
   "uid": "da0708:U00016",
   "speaker": "九朔",
   "jp": "「騎士の征く道を阻めると思うな！」",
   "cells": [
    {
     "sid": "da0708:T00064",
     "kind": "본문",
     "jp": "「騎士の征く道を阻めると思うな！」",
     "ko": "「기사가 나아가는 길을 막을 수 있을 줄 아느냐!」"
    }
   ]
  },
  {
   "uid": "da0708:U00017",
   "speaker": "(지문)",
   "jp": "空を埋め尽くさんまでの敵軍の真っ只中に、Ｄトゥーソードは\n突撃する。脚部シールドに集まる莫大なエネルギー。時空間歪曲機構の開放。紫電を纏い、Ｄトゥーソードは空を翔ける。",
   "cells": [
    {
     "sid": "da0708:T00065",
     "kind": "본문",
     "jp": "空を埋め尽くさんまでの敵軍の真っ只中に、Ｄトゥーソードは\n突撃する。",
     "ko": "하늘을 가득 메울 듯한 적군의 한복판으로 D 투 소드는\n돌격한다."
    },
    {
     "sid": "da0708:T00066",
     "kind": "본문",
     "jp": "脚部シールドに集まる莫大なエネルギー。",
     "ko": "다리 실드에 모이는 막대한 에너지."
    },
    {
     "sid": "da0708:T00067",
     "kind": "본문",
     "jp": "時空間歪曲機構の開放。",
     "ko": "시공간 왜곡 기구의 개방."
    },
    {
     "sid": "da0708:T00068",
     "kind": "본문",
     "jp": "紫電を纏い、Ｄトゥーソードは空を翔ける。",
     "ko": "보랏빛 번개를 두르고 D 투 소드는 하늘을 달린다."
    }
   ]
  },
  {
   "uid": "da0708:U00018",
   "speaker": "九朔",
   "jp": "「我が一撃は、\n　戦場を駈ける騎士の〈ランス〉軍槍……！」",
   "cells": [
    {
     "sid": "da0708:T00069",
     "kind": "본문",
     "jp": "「我が一撃は、\n　戦場を駈ける騎士の",
     "ko": "「나의 일격은,\n　전장을 달리는 기사의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00022",
     "kind": "루비 읽기",
     "jp": "ランス",
     "ko": "랜스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00070",
     "kind": "본문",
     "jp": "軍槍",
     "ko": "군창",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00071",
     "kind": "본문",
     "jp": "……！」",
     "ko": "……!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0708:U00019",
   "speaker": "(지문)",
   "jp": "エネルギーを螺旋状に放出しながら、垂直方向への急上昇。軌道は高く、『夢幻心母』の上空へ。その様は天に昇る龍を彷彿とさせる。",
   "cells": [
    {
     "sid": "da0708:T00072",
     "kind": "본문",
     "jp": "エネルギーを螺旋状に放出しながら、垂直方向への急上昇。",
     "ko": "에너지를 나선 모양으로 방출하며 수직 방향으로 급상승."
    },
    {
     "sid": "da0708:T00073",
     "kind": "본문",
     "jp": "軌道は高く、『夢幻心母』の上空へ。",
     "ko": "궤도는 높이, 『몽환심모』의 상공으로."
    },
    {
     "sid": "da0708:T00074",
     "kind": "본문",
     "jp": "その様は天に昇る龍を彷彿とさせる。",
     "ko": "그 모습은 하늘로 승천하는 용을 방불케 한다."
    }
   ]
  },
  {
   "uid": "da0708:U00020",
   "speaker": "(지문)",
   "jp": "黒き月を眼下に見下ろす位置で、Ｄトゥーソードは反転する。必殺の破壊力を湛える脚を突き出し――",
   "cells": [
    {
     "sid": "da0708:T00075",
     "kind": "본문",
     "jp": "黒き月を眼下に見下ろす位置で、Ｄトゥーソードは反転する。",
     "ko": "검은 달을 눈 아래로 내려다보는 위치에서 D 투 소드는 반전한다."
    },
    {
     "sid": "da0708:T00076",
     "kind": "본문",
     "jp": "必殺の破壊力を湛える脚を突き出し――",
     "ko": "필살의 파괴력을 머금은 다리를 내지르며――"
    }
   ]
  },
  {
   "uid": "da0708:U00021",
   "speaker": "九朔",
   "jp": "「アトランティス・ストライク！」",
   "cells": [
    {
     "sid": "da0708:T00077",
     "kind": "본문",
     "jp": "「アトランティス・ストライク！」",
     "ko": "「아틀란티스 스트라이크!」"
    }
   ]
  },
  {
   "uid": "da0708:U00022",
   "speaker": "(지문)",
   "jp": "宣誓とおり、Ｄトゥーソードは敵陣を貫く〈ランス〉突撃槍と化した。Ｄトゥーソードの軌道上に居た破壊ロボは、ひとたまりもなく爆砕\nして散る。\n\n　触れるもの、〈かす〉掠るものの一切を微塵と化して、〈Ｄトゥーソード〉一条の雷は黒き月\nめがけ、落ちる。",
   "cells": [
    {
     "sid": "da0708:T00078",
     "kind": "본문",
     "jp": "宣誓とおり、Ｄトゥーソードは敵陣を貫く",
     "ko": "선언대로 D 투 소드는 적진을 꿰뚫는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00023",
     "kind": "루비 읽기",
     "jp": "ランス",
     "ko": "랜스로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00079",
     "kind": "본문",
     "jp": "突撃槍",
     "ko": "돌격창으로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00080",
     "kind": "본문",
     "jp": "と化した。",
     "ko": " 화했다."
    },
    {
     "sid": "da0708:T00081",
     "kind": "본문",
     "jp": "Ｄトゥーソードの軌道上に居た破壊ロボは、ひとたまりもなく爆砕\nして散る。\n\n　触れるもの、",
     "ko": "D 투 소드의 궤도상에 있던 파괴로보는 맥없이 폭쇄\n하여 흩어진다.\n\n　닿는 것, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00024",
     "kind": "루비 읽기",
     "jp": "かす",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00082",
     "kind": "본문",
     "jp": "掠",
     "ko": "스치",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00083",
     "kind": "본문",
     "jp": "るものの一切を微塵と化して、",
     "ko": "는 것 일체를 가루로 만들며, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00025",
     "kind": "루비 읽기",
     "jp": "Ｄトゥーソード",
     "ko": "D 투 소드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00084",
     "kind": "본문",
     "jp": "一条の雷",
     "ko": "한 줄기 우레",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00085",
     "kind": "본문",
     "jp": "は黒き月\nめがけ、落ちる。",
     "ko": "는 검은 달을\n향해 떨어진다."
    }
   ]
  },
  {
   "uid": "da0708:U00023",
   "speaker": "九朔",
   "jp": "「うおおおおおおおおおおおお！」",
   "cells": [
    {
     "sid": "da0708:T00086",
     "kind": "본문",
     "jp": "「うおおおおおおおおおおおお！」",
     "ko": "「우오오오오오오오오오오오오!」"
    }
   ]
  },
  {
   "uid": "da0708:U00024",
   "speaker": "(지문)",
   "jp": "黒き月を射抜く。〈ナイト・オブ・トゥーソード／トゥーガン〉二闘流の騎士は〈しろ〉要塞の〈なか〉胎に。",
   "cells": [
    {
     "sid": "da0708:T00087",
     "kind": "본문",
     "jp": "黒き月を射抜く。",
     "ko": "검은 달을 꿰뚫는다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00026",
     "kind": "루비 읽기",
     "jp": "ナイト・オブ・トゥーソード／トゥーガン",
     "ko": "나이트 오브 투 소드/투 건은",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00088",
     "kind": "본문",
     "jp": "二闘流の騎士",
     "ko": "이투류의 기사는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00089",
     "kind": "본문",
     "jp": "は",
     "ko": ", ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:R00027",
     "kind": "루비 읽기",
     "jp": "しろ",
     "ko": "성",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00090",
     "kind": "본문",
     "jp": "要塞",
     "ko": "요새",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00091",
     "kind": "본문",
     "jp": "の",
     "ko": "의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00028",
     "kind": "루비 읽기",
     "jp": "なか",
     "ko": "안",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00092",
     "kind": "본문",
     "jp": "胎",
     "ko": "뱃속",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00093",
     "kind": "본문",
     "jp": "に。",
     "ko": "으로."
    }
   ]
  },
  {
   "uid": "da0708:U00025",
   "speaker": "(지문)",
   "jp": "――かくして、最初の役者が壇上に。\n\n　さあ、走り出せ。走り出せ。悪夢が紡ぐ舞台の大団円に向かって、まっしぐらに。〈ダンス〉踊って、〈ダンス〉踊って、〈ダンス・マカブル〉踊り狂え。",
   "cells": [
    {
     "sid": "da0708:T00094",
     "kind": "본문",
     "jp": "――かくして、最初の役者が壇上に。\n\n　さあ、走り出せ。走り出せ。",
     "ko": "――그리하여 첫 번째 배우가 단상 위로.\n\n　자, 달려 나가라. 달려 나가라."
    },
    {
     "sid": "da0708:T00095",
     "kind": "본문",
     "jp": "悪夢が紡ぐ舞台の大団円に向かって、まっしぐらに。",
     "ko": "악몽이 자아내는 무대의 대단원을 향해, 곧장.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00029",
     "kind": "루비 읽기",
     "jp": "ダンス",
     "ko": "댄스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00096",
     "kind": "본문",
     "jp": "踊って",
     "ko": "춤추고",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00097",
     "kind": "본문",
     "jp": "、",
     "ko": ", ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:R00030",
     "kind": "루비 읽기",
     "jp": "ダンス",
     "ko": "댄스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00098",
     "kind": "본문",
     "jp": "踊って",
     "ko": "춤추고",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00099",
     "kind": "본문",
     "jp": "、",
     "ko": ", ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:R00031",
     "kind": "루비 읽기",
     "jp": "ダンス・マカブル",
     "ko": "당스 마카브르",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00100",
     "kind": "본문",
     "jp": "踊り狂え",
     "ko": "미친 듯이 춤춰라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00101",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  }
