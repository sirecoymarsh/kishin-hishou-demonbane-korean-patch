{
 "packet": "P0080_da0708",
 "units": [
  {
   "uid": "da0708:U00001",
   "speaker": "アナザーブラッド",
   "jp": "「来たわね、〈トゥーソード／トゥーガン〉二闘流。\n　迎えてあげるわ！」",
   "cells": [
    {
     "sid": "da0708:T00001",
     "kind": "본문",
     "jp": "「来たわね、",
     "ko": "「왔구나, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00001",
     "kind": "루비 읽기",
     "jp": "トゥーソード／トゥーガン",
     "ko": "투 소드/투 건",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00002",
     "kind": "본문",
     "jp": "二闘流",
     "ko": "이투류",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00003",
     "kind": "본문",
     "jp": "。\n　迎えてあげるわ！」",
     "ko": ".\n　맞이해 줄게!」"
    }
   ]
  },
  {
   "uid": "da0708:U00002",
   "speaker": "九朔",
   "jp": "「我が双剣に鉄屑を宛がうか！\n　笑止！」",
   "cells": [
    {
     "sid": "da0708:T00004",
     "kind": "본문",
     "jp": "「我が双剣に鉄屑を宛がうか！\n　笑止！」",
     "ko": "「나의 쌍검에 고철을 들이대느냐!\n　가소롭다!」"
    }
   ]
  },
  {
   "uid": "da0708:U00003",
   "speaker": "(지문)",
   "jp": "二条の剣閃が、破壊ロボの間を迅る。たちまちデモンベイン・トゥーソードに襲いかかった十数体の\n破壊ロボが、幾何学的な〈ブロック〉形に斬り分けられ、爆発した。",
   "cells": [
    {
     "sid": "da0708:T00005",
     "kind": "본문",
     "jp": "二条の剣閃が、破壊ロボの間を迅る。",
     "ko": "두 줄기 검섬이 파괴로보 사이를 질주한다."
    },
    {
     "sid": "da0708:T00006",
     "kind": "본문",
     "jp": "たちまちデモンベイン・トゥーソードに襲いかかった十数体の\n破壊ロボが、幾何学的な",
     "ko": "순식간에 데몬베인 투 소드에게 덤벼들었던 십수 대의\n파괴로보가 기하학적인 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00002",
     "kind": "루비 읽기",
     "jp": "ブロック",
     "ko": "블록으로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00007",
     "kind": "본문",
     "jp": "形",
     "ko": "형태로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00008",
     "kind": "본문",
     "jp": "に斬り分けられ、爆発した。",
     "ko": " 토막 나 폭발했다."
    }
   ]
  },
  {
   "uid": "da0708:U00004",
   "speaker": "(지문)",
   "jp": "なおも殺到する破壊ロボ群。",
   "cells": [
    {
     "sid": "da0708:T00009",
     "kind": "본문",
     "jp": "なおも殺到する破壊ロボ群。",
     "ko": "여전히 쇄도하는 파괴로보 군단."
    }
   ]
  },
  {
   "uid": "da0708:U00005",
   "speaker": "(지문)",
   "jp": "ふたつの小剣を組み合わせ、十字剣を造る。",
   "cells": [
    {
     "sid": "da0708:T00010",
     "kind": "본문",
     "jp": "ふたつの小剣を組み合わせ、十字剣を造る。",
     "ko": "두 자루의 소검을 조합해 십자검을 만든다."
    }
   ]
  },
  {
   "uid": "da0708:U00006",
   "speaker": "(지문)",
   "jp": "〈スウィング〉投擲。軌道上の敵を両断しながら、十字剣は飛翔する。",
   "cells": [
    {
     "sid": "da0708:R00003",
     "kind": "루비 읽기",
     "jp": "スウィング",
     "ko": "스윙",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00011",
     "kind": "본문",
     "jp": "投擲",
     "ko": "투척",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00012",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:T00013",
     "kind": "본문",
     "jp": "軌道上の敵を両断しながら、十字剣は飛翔する。",
     "ko": "궤도상의 적을 양단하며 십자검은 비상한다."
    }
   ]
  },
  {
   "uid": "da0708:U00007",
   "speaker": "(지문)",
   "jp": "無手になったＤトゥーソード。その右掌で、〈プラズマ〉白光が輝いた。その左掌で、〈ダイヤモンド・ダスト〉氷霧が煌めいた。指向性を得た魔力が、二挺の魔銃となって結晶し、顕現する。",
   "cells": [
    {
     "sid": "da0708:T00014",
     "kind": "본문",
     "jp": "無手になったＤトゥーソード。",
     "ko": "맨손이 된 D 투 소드."
    },
    {
     "sid": "da0708:T00015",
     "kind": "본문",
     "jp": "その右掌で、",
     "ko": "그 오른손바닥에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00004",
     "kind": "루비 읽기",
     "jp": "プラズマ",
     "ko": "플라스마가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00016",
     "kind": "본문",
     "jp": "白光",
     "ko": "백광이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00017",
     "kind": "본문",
     "jp": "が輝いた。",
     "ko": " 빛났다."
    },
    {
     "sid": "da0708:T00018",
     "kind": "본문",
     "jp": "その左掌で、",
     "ko": "그 왼손바닥에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00005",
     "kind": "루비 읽기",
     "jp": "ダイヤモンド・ダスト",
     "ko": "다이아몬드 더스트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00019",
     "kind": "본문",
     "jp": "氷霧",
     "ko": "얼음 안개",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00020",
     "kind": "본문",
     "jp": "が煌めいた。",
     "ko": "가 반짝였다."
    },
    {
     "sid": "da0708:T00021",
     "kind": "본문",
     "jp": "指向性を得た魔力が、二挺の魔銃となって結晶し、顕現する。",
     "ko": "지향성을 얻은 마력이 두 자루의 마총이 되어 결정화하고 현현한다."
    }
   ]
  },
  {
   "uid": "da0708:U00008",
   "speaker": "九朔",
   "jp": "「クトゥグア！　イタクァ！」",
   "cells": [
    {
     "sid": "da0708:T00022",
     "kind": "본문",
     "jp": "「クトゥグア！　イタクァ！」",
     "ko": "「크투가! 이타콰!」"
    }
   ]
  },
  {
   "uid": "da0708:U00009",
   "speaker": "(지문)",
   "jp": "二挺魔銃を手に執ったＤトゥーソードが、独特の動きを見せる。それはある種の剣技、もしくは武術の『型』を連想させる動きだった。\n\n　無機質の双眸が敵の軍勢を見渡す――否、その眼が見るのは、\n敵の群れではない。その眼が視るのは神々の領域――世界を構成する〈アザトース〉字祷子の動き。",
   "cells": [
    {
     "sid": "da0708:T00023",
     "kind": "본문",
     "jp": "二挺魔銃を手に執ったＤトゥーソードが、独特の動きを見せる。",
     "ko": "쌍권총을 손에 쥔 D 투 소드가 독특한 움직임을 보인다."
    },
    {
     "sid": "da0708:T00024",
     "kind": "본문",
     "jp": "それはある種の剣技、もしくは武術の『型』を連想させる動きだった。\n\n　無機質の双眸が敵の軍勢を見渡す――否、その眼が見るのは、\n敵の群れではない。",
     "ko": "그것은 일종의 검기, 혹은 무술의 『초식』을 연상케 하는 움직임이었다.\n\n　무기질적인 두 눈동자가 적의 군세를 둘러본다――아니, 그 눈이 보는 것은\n적의 무리가 아니다."
    },
    {
     "sid": "da0708:T00025",
     "kind": "본문",
     "jp": "その眼が視るのは神々の領域――世界を構成する",
     "ko": "그 눈이 보는 것은 신들의 영역――세계를 구성하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00006",
     "kind": "루비 읽기",
     "jp": "アザトース",
     "ko": "아자토스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00026",
     "kind": "본문",
     "jp": "字祷子",
     "ko": "자도자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00027",
     "kind": "본문",
     "jp": "の動き。",
     "ko": "의 움직임."
    }
   ]
  },
  {
   "uid": "da0708:U00010",
   "speaker": "九朔",
   "jp": "「〈ブラストブリッツ・クライ×３〉歌え、銃声の鎮魂歌！」",
   "cells": [
    {
     "sid": "da0708:T00028",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:R00007",
     "kind": "루비 읽기",
     "jp": "ブラストブリッツ・クライ×３",
     "ko": "블래스트 블리츠 크라이×3",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00029",
     "kind": "본문",
     "jp": "歌え、銃声の鎮魂歌",
     "ko": "노래하라, 총성의 진혼가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00030",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0708:U00011",
   "speaker": "(지문)",
   "jp": "――歌う。\n\n　それは恐るべき精度を誇る〈おうさつ〉鏖殺技術。〈マキシマム・キルゾーン〉最適の攻撃位置からの〈マキシマム・ナンバー〉最多の敵目標に対する〈マキシマム・ダメージ〉最大威力の攻撃。\n\n\n　未来予測に近い計算能力が可能にする〈ガンブ〉銃舞。〈ジュウゲキ〉銃撃という名の〈ジュウバク〉重爆、〈ジュウゲキ〉銃撃という名の〈ジュウリン〉蹂躙だ。",
   "cells": [
    {
     "sid": "da0708:T00031",
     "kind": "본문",
     "jp": "――歌う。\n\n　それは恐るべき精度を誇る",
     "ko": "――노래한다.\n\n　그것은 무서운 정밀도를 자랑하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00008",
     "kind": "루비 읽기",
     "jp": "おうさつ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00032",
     "kind": "본문",
     "jp": "鏖殺",
     "ko": "몰살",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00033",
     "kind": "본문",
     "jp": "技術。",
     "ko": " 기술.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00009",
     "kind": "루비 읽기",
     "jp": "マキシマム・キルゾーン",
     "ko": "맥시멈 킬존",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00034",
     "kind": "본문",
     "jp": "最適の攻撃位置",
     "ko": "최적의 공격 위치",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00035",
     "kind": "본문",
     "jp": "からの",
     "ko": "에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00010",
     "kind": "루비 읽기",
     "jp": "マキシマム・ナンバー",
     "ko": "맥시멈 넘버",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00036",
     "kind": "본문",
     "jp": "最多の敵目標",
     "ko": "최다의 적 목표",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00037",
     "kind": "본문",
     "jp": "に対する",
     "ko": "에 대한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00011",
     "kind": "루비 읽기",
     "jp": "マキシマム・ダメージ",
     "ko": "맥시멈 데미지",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00038",
     "kind": "본문",
     "jp": "最大威力の攻撃",
     "ko": "최대 위력의 공격",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00039",
     "kind": "본문",
     "jp": "。\n\n\n　未来予測に近い計算能力が可能にする",
     "ko": ".\n\n\n　미래 예측에 가까운 계산 능력이 가능케 하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00012",
     "kind": "루비 읽기",
     "jp": "ガンブ",
     "ko": "건부",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00040",
     "kind": "본문",
     "jp": "銃舞",
     "ko": "총의 춤",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00041",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0708:R00013",
     "kind": "루비 읽기",
     "jp": "ジュウゲキ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0708:T00042",
