     "jp": "銃撃",
     "ko": "총격",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0708:T00043",
     "kind": "본문",
     "jp": "という名の",
     "ko": "이라는 이름의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0708:R00014",
     "kind": "루비 읽기",
     "jp": "ジュウバク",
     "ko": "",
