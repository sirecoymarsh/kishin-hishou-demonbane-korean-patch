   ]
  },
  {
   "uid": "da0503:U00056",
   "speaker": "九郎",
   "jp": "「ぐ……ぁ……がぶはぁっ！　あぐっ！」\n\n　身動きが取れない。肺に容赦なくタールを流し込まれている。泥濘の海に沈む。",
   "cells": [
    {
     "sid": "da0503:T00175",
     "kind": "본문",
     "jp": "「ぐ……ぁ……がぶはぁっ！　あぐっ！」\n\n　身動きが取れない。",
     "ko": "「크…… 아…… 커부하앗!　아극!」\n\n　몸을 움직일 수가 없다."
    },
    {
     "sid": "da0503:T00176",
     "kind": "본문",
     "jp": "肺に容赦なくタールを流し込まれている。",
