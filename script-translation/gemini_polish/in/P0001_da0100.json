    }
   ]
  },
  {
   "uid": "da0100:U00002",
   "speaker": "九郎",
   "jp": "「てめえも道連れだぁぁぁぁぁ！」",
   "cells": [
    {
     "sid": "da0100:T00002",
     "kind": "본문",
     "jp": "「てめえも道連れだぁぁぁぁぁ！」",
     "ko": "「네놈도 길동무다아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0100:U00003",
   "speaker": "(지문)",
   "jp": "これもまた、ひとつの世界と物語。神が〈もてあそ〉玩ぶ無限螺旋は撃ち砕かれ――世界は再び、未来に向かって動き出す。",
   "cells": [
    {
     "sid": "da0100:T00003",
     "kind": "본문",
     "jp": "これもまた、ひとつの世界と物語。",
     "ko": "이 또한, 하나의 세계이자 이야기."
    },
    {
     "sid": "da0100:T00004",
     "kind": "본문",
     "jp": "神が",
     "ko": "신이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0100:R00001",
     "kind": "루비 읽기",
     "jp": "もてあそ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0100:T00005",
     "kind": "본문",
     "jp": "玩",
     "ko": "희롱하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0100:T00006",
     "kind": "본문",
     "jp": "ぶ無限螺旋は撃ち砕かれ――",
     "ko": "는 무한나선은 부서져 깨지고――"
    },
    {
     "sid": "da0100:T00007",
     "kind": "본문",
     "jp": "世界は再び、未来に向かって動き出す。",
     "ko": "세계는 다시금, 미래를 향해 움직이기 시작한다."
    }
   ]
  }
 ]
