   "speaker": "アナザーブラッド",
   "jp": "「鋼鉄の血を分ける――〈あらわ〉顕れよ！」",
   "cells": [
    {
     "sid": "da1306:T00194",
     "kind": "본문",
     "jp": "「鋼鉄の血を分ける――",
     "ko": "「강철의 피를 나눈다――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00044",
     "kind": "루비 읽기",
     "jp": "あらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00195",
     "kind": "본문",
     "jp": "顕",
     "ko": "나타나",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00196",
     "kind": "본문",
     "jp": "れよ！」",
     "ko": "라!」"
    }
   ]
  },
  {
   "uid": "da1306:U00072",
   "speaker": "九朔",
   "jp": "「デモンベインッ！？」",
   "cells": [
    {
     "sid": "da1306:T00197",
     "kind": "본문",
     "jp": "「デモンベインッ！？」",
     "ko": "「데몬베인!?」"
    }
   ]
  },
  {
   "uid": "da1306:U00073",
   "speaker": "ファーザー・ナイ",
   "jp": "「さあ、駒は揃った！\n　ゲームの始まりだ！」",
   "cells": [
    {
     "sid": "da1306:T00198",
     "kind": "본문",
     "jp": "「さあ、駒は揃った！\n　ゲームの始まりだ！」",
     "ko": "「자, 말은 다 모였다!\n　게임의 시작이다!」"
    }
   ]
  },
  {
   "uid": "da1306:U00074",
   "speaker": "ファーザー・ナイ",
   "jp": "「大十字九朔――君は〈トラベラー〉時空放浪者として、バラバラに〈ほど〉解けた時間と世界を渡り歩くのだ！」",
   "cells": [
    {
     "sid": "da1306:T00199",
     "kind": "본문",
     "jp": "「大十字九朔――君は",
     "ko": "「다이쥬지 쿠자쿠――그대는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00045",
     "kind": "루비 읽기",
     "jp": "トラベラー",
     "ko": "트래블러",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00200",
     "kind": "본문",
     "jp": "時空放浪者",
     "ko": "시공방랑자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00201",
     "kind": "본문",
     "jp": "として、バラバラに",
     "ko": "로서, 산산이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00046",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00202",
     "kind": "본문",
     "jp": "解",
     "ko": "풀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00203",
     "kind": "본문",
     "jp": "けた時間と世界を渡り歩くのだ！」",
     "ko": "어진 시간과 세계를 건너다니는 것이다!」"
    }
   ]
  },
  {
   "uid": "da1306:U00075",
   "speaker": "ナイア",
   "jp": "「引き裂かれた世界を！　引き裂か\nれた自分を取り戻したければ！〈ゲームキーパー〉管理者を……僕の化身を追うが\nいい！　混沌の欠片を拾い集め、\n再び世界を一つに戻すのだ！」",
   "cells": [
    {
     "sid": "da1306:T00204",
     "kind": "본문",
     "jp": "「引き裂かれた世界を！　引き裂か\nれた自分を取り戻したければ！",
     "ko": "「찢어발겨진 세계를!　찢어발겨\n진 자신을 되찾고 싶다면!\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00047",
     "kind": "루비 읽기",
     "jp": "ゲームキーパー",
     "ko": "게임 키퍼",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00205",
     "kind": "본문",
     "jp": "管理者",
     "ko": "관리자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00206",
     "kind": "본문",
     "jp": "を……僕の化身を追うが\nいい！　混沌の欠片を拾い集め、\n再び世界を一つに戻すのだ！」",
     "ko": "를…… 나의 화신을 쫓는 게\n좋아!　혼돈의 조각을 주워 모아,\n다시 세계를 하나로 되돌리는 거야!」"
    }
   ]
  },
  {
   "uid": "da1306:U00076",
   "speaker": "ナイア",
   "jp": "「彼女は、君に与える最初の敵だ！　さあ、戦いの幕を切って落とせ！」",
   "cells": [
    {
     "sid": "da1306:T00207",
     "kind": "본문",
     "jp": "「彼女は、君に与える最初の敵だ！　さあ、戦いの幕を切って落とせ！」",
     "ko": "「저 아이는 너에게 주는 첫 번째 적이다!　자, 싸움의 막을 올려라!」"
    }
   ]
  },
  {
   "uid": "da1306:U00077",
   "speaker": "アナザーブラッド",
   "jp": "「あはははははははは！」",
   "cells": [
    {
     "sid": "da1306:T00208",
     "kind": "본문",
     "jp": "「あはははははははは！」",
     "ko": "「아하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da1306:U00078",
   "speaker": "九朔",
   "jp": "「貴様ァァァァァ――ッ！」",
   "cells": [
    {
     "sid": "da1306:T00209",
     "kind": "본문",
     "jp": "「貴様ァァァァァ――ッ！」",
     "ko": "「네노오오오오옴――읏!」"
    }
   ]
  },
  {
   "uid": "da1306:U00079",
   "speaker": "ナイア",
   "jp": "「――ゲームスタートだ！」",
   "cells": [
    {
     "sid": "da1306:T00210",
     "kind": "본문",
     "jp": "「――ゲームスタートだ！」",
     "ko": "「――게임 스타트다!」"
    }
   ]
  },
  {
   "uid": "da1306:U00080",
   "speaker": "アナザーブラッド",
   "jp": "「禁忌の血を〈はな〉解放つ……侵せ！」",
   "cells": [
    {
     "sid": "da1306:T00211",
     "kind": "본문",
     "jp": "「禁忌の血を",
     "ko": "「금기의 피를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00048",
     "kind": "루비 읽기",
     "jp": "はな",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00212",
     "kind": "본문",
     "jp": "解放",
     "ko": "해방한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00213",
     "kind": "본문",
     "jp": "つ……侵せ！」",
     "ko": "다…… 침식하라!」"
    }
   ]
  },
  {
   "uid": "da1306:U00081",
   "speaker": "九朔",
   "jp": "「レムリアァァァァ……インパクトォォォ――ッ！」",
   "cells": [
    {
     "sid": "da1306:T00214",
     "kind": "본문",
     "jp": "「レムリアァァァァ……",
     "ko": "「레무리아아아아아……"
    },
    {
     "sid": "da1306:T00215",
     "kind": "본문",
     "jp": "インパクトォォォ――ッ！」",
     "ko": "임팩트으으으――읏!」"
    }
   ]
  },
  {
   "uid": "da1306:U00082",
   "speaker": "ナイア＆ファーザー・ナイ",
   "jp": "「旅立つが良い。今一度ふたたび、千なる異形の我に出遭えるよう、宇宙に祈るが良い」",
   "cells": [
    {
     "sid": "da1306:T00216",
     "kind": "본문",
     "jp": "「旅立つが良い。今一度ふたたび、千なる異形の我に出遭えるよう、宇宙に祈るが良い」",
     "ko": "「여행을 떠나는 게 좋다. 다시 한번, 천의 이형인 나와 마주할 수 있기를 우주에 기도하는 게 좋아」"
    }
   ]
