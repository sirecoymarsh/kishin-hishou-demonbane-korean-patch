  },
  {
   "uid": "da1304:U00034",
   "speaker": "アナザーブラッド",
   "jp": "「さあ、総てを\n奪い尽くしてあげるわ、\nお母様！」",
   "cells": [
    {
     "sid": "da1304:T00075",
     "kind": "본문",
     "jp": "「さあ、総てを\n奪い尽くしてあげるわ、\nお母様！」",
     "ko": "「자, 모든 것을\n빼앗아 다 먹어 치워 줄게,\n어머님!」"
    }
   ]
  },
  {
   "uid": "da1304:U00035",
   "speaker": "九郎",
   "jp": "「させるか！」",
   "cells": [
    {
     "sid": "da1304:T00076",
