{
 "packet": "P0103_da1304",
 "units": [
  {
   "uid": "da1304:U00001",
   "speaker": "九郎",
   "jp": "「ぐぅぅっ……！」",
   "cells": [
    {
     "sid": "da1304:T00001",
     "kind": "본문",
     "jp": "「ぐぅぅっ……！」",
     "ko": "「그으윽……!」"
    }
   ]
  },
  {
   "uid": "da1304:U00002",
   "speaker": "九朔",
   "jp": "「うおおおおおお！」",
   "cells": [
    {
     "sid": "da1304:T00002",
     "kind": "본문",
     "jp": "「うおおおおおお！」",
     "ko": "「우오오오오오오!」"
    }
   ]
  },
  {
   "uid": "da1304:U00003",
   "speaker": "(지문)",
   "jp": "〈ユメ〉悪夢から〈ユメ〉悪夢を渡り歩く。〈ユメ〉悪夢と〈ユメ〉悪夢の狭間で、デモンベインとＤトゥーソードは衝突する。\n\n　何が〈うつつ〉現で何が〈うつろ〉虚か。それとも両者の間に、〈はざま〉境界など無いのか。",
   "cells": [
    {
     "sid": "da1304:R00001",
     "kind": "루비 읽기",
     "jp": "ユメ",
     "ko": "꿈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00003",
     "kind": "본문",
     "jp": "悪夢",
     "ko": "악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00004",
     "kind": "본문",
     "jp": "から",
     "ko": "에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00002",
     "kind": "루비 읽기",
     "jp": "ユメ",
     "ko": "꿈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00005",
     "kind": "본문",
     "jp": "悪夢",
     "ko": "악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00006",
     "kind": "본문",
     "jp": "を渡り歩く。",
     "ko": "을 건너다닌다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00003",
     "kind": "루비 읽기",
     "jp": "ユメ",
     "ko": "꿈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00007",
     "kind": "본문",
     "jp": "悪夢",
     "ko": "악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00008",
     "kind": "본문",
     "jp": "と",
     "ko": "과 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00004",
     "kind": "루비 읽기",
     "jp": "ユメ",
     "ko": "꿈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00009",
     "kind": "본문",
     "jp": "悪夢",
     "ko": "악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00010",
     "kind": "본문",
     "jp": "の狭間で、デモンベインとＤトゥーソードは衝突する。\n\n　何が",
     "ko": "의 틈새에서, 데몬베인과 D 투 소드는 충돌한다.\n\n　무엇이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00005",
     "kind": "루비 읽기",
     "jp": "うつつ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00011",
     "kind": "본문",
     "jp": "現",
     "ko": "현실",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00012",
     "kind": "본문",
     "jp": "で何が",
     "ko": "이고 무엇이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00006",
     "kind": "루비 읽기",
     "jp": "うつろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00013",
     "kind": "본문",
     "jp": "虚",
     "ko": "허상",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00014",
     "kind": "본문",
     "jp": "か。",
     "ko": "인가."
    },
    {
     "sid": "da1304:T00015",
     "kind": "본문",
     "jp": "それとも両者の間に、",
     "ko": "아니면 양자 사이에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00007",
     "kind": "루비 읽기",
     "jp": "はざま",
     "ko": "틈새",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00016",
     "kind": "본문",
     "jp": "境界",
     "ko": "경계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00017",
     "kind": "본문",
     "jp": "など無いのか。",
     "ko": " 따위는 없는 것인가."
    }
   ]
  },
  {
   "uid": "da1304:U00004",
   "speaker": "九郎",
   "jp": "「う……ッ！？」\n\n　突然、デモンベインの出力が落ちた。動きが止まったところに、Ｄトゥーソードの蹴りが炸裂する。",
   "cells": [
    {
     "sid": "da1304:T00018",
     "kind": "본문",
     "jp": "「う……ッ！？」\n\n　突然、デモンベインの出力が落ちた。",
     "ko": "「우…… 읏!?」\n\n　갑자기 데몬베인의 출력이 떨어졌다."
    },
    {
     "sid": "da1304:T00019",
     "kind": "본문",
     "jp": "動きが止まったところに、Ｄトゥーソードの蹴りが炸裂する。",
     "ko": "움직임이 멈춘 틈에 D 투 소드의 발차기가 작렬한다."
    }
   ]
  },
  {
   "uid": "da1304:U00005",
   "speaker": "九郎",
   "jp": "「ぐわああああああああ！」",
   "cells": [
    {
     "sid": "da1304:T00020",
     "kind": "본문",
     "jp": "「ぐわああああああああ！」",
     "ko": "「크와아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1304:U00006",
   "speaker": "(지문)",
   "jp": "吹き飛ばされ、廃墟の街を転がる。追撃を避けるため起き上がる――",
   "cells": [
    {
     "sid": "da1304:T00021",
     "kind": "본문",
     "jp": "吹き飛ばされ、廃墟の街を転がる。",
     "ko": "나가떨어져 폐허의 거리를 구른다."
    },
    {
     "sid": "da1304:T00022",
     "kind": "본문",
     "jp": "追撃を避けるため起き上がる――",
     "ko": "추격을 피하기 위해 몸을 일으킨다――"
    }
   ]
  },
  {
   "uid": "da1304:U00007",
   "speaker": "(지문)",
   "jp": "――〈・・・・・〉動かない。",
   "cells": [
    {
     "sid": "da1304:T00023",
     "kind": "본문",
     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1304:R00008",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00024",
     "kind": "본문",
     "jp": "動かない",
     "ko": "움직이지 않는다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00025",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1304:U00008",
   "speaker": "九郎",
   "jp": "「どうしたんだ、アル！？」",
   "cells": [
    {
     "sid": "da1304:T00026",
     "kind": "본문",
     "jp": "「どうしたんだ、アル！？」",
     "ko": "「어떻게 된 거야, 알!?」"
    }
   ]
  },
  {
   "uid": "da1304:U00009",
   "speaker": "アル",
   "jp": "「あ……ああ……」",
   "cells": [
    {
     "sid": "da1304:T00027",
     "kind": "본문",
     "jp": "「あ……",
     "ko": "「아……"
    },
    {
     "sid": "da1304:T00028",
     "kind": "본문",
     "jp": "ああ……」",
     "ko": "아아……」"
    }
   ]
  },
  {
   "uid": "da1304:U00010",
   "speaker": "九郎",
   "jp": "「っっ！？　ア、アルッ！？」",
   "cells": [
    {
     "sid": "da1304:T00029",
     "kind": "본문",
     "jp": "「っっ！？　ア、アルッ！？」",
     "ko": "「읏!?　아, 알!?」"
    }
   ]
  },
  {
   "uid": "da1304:U00011",
   "speaker": "(지문)",
   "jp": "アルの躰を覆い尽くす紅い影。アナザーブラッドの術式が、急激に進行／侵攻していた。アルの存在が紅く塗り潰されていく。",
   "cells": [
    {
     "sid": "da1304:T00030",
     "kind": "본문",
     "jp": "アルの躰を覆い尽くす紅い影。",
     "ko": "알의 몸을 뒤덮는 붉은 그림자."
    },
    {
     "sid": "da1304:T00031",
     "kind": "본문",
     "jp": "アナザーブラッドの術式が、急激に進行／侵攻していた。",
     "ko": "어나더 블러드의 술식이 급격하게 진행/침공하고 있었다."
    },
    {
     "sid": "da1304:T00032",
     "kind": "본문",
     "jp": "アルの存在が紅く塗り潰されていく。",
     "ko": "알의 존재가 붉게 덧칠해져 간다."
    }
   ]
  },
  {
   "uid": "da1304:U00012",
   "speaker": "九郎",
   "jp": "「何で、いきなり！？」",
   "cells": [
    {
     "sid": "da1304:T00033",
     "kind": "본문",
     "jp": "「何で、いきなり！？」",
     "ko": "「어째서, 갑자기!?」"
    }
   ]
  },
  {
   "uid": "da1304:U00013",
   "speaker": "アル",
   "jp": "「く、九郎……ッ」",
   "cells": [
    {
     "sid": "da1304:T00034",
     "kind": "본문",
     "jp": "「く、九郎……ッ」",
     "ko": "「쿠, 쿠로…… 읏」"
    }
   ]
  },
  {
   "uid": "da1304:U00014",
   "speaker": "九郎",
   "jp": "「アル――――――ッ！」\n\n　苦痛に足掻いて伸ばした手、その指先までもが紅い。俺もまたアルに手を伸ばして――",
   "cells": [
    {
     "sid": "da1304:T00035",
     "kind": "본문",
     "jp": "「アル――――――ッ！」\n\n　苦痛に足掻いて伸ばした手、その指先までもが紅い。",
     "ko": "「알――――――!」\n\n　고통에 발버둥 치며 뻗은 손, 그 손가락 끝마저 붉다."
    },
    {
     "sid": "da1304:T00036",
     "kind": "본문",
     "jp": "俺もまたアルに手を伸ばして――",
     "ko": "나 또한 알에게 손을 뻗어――"
    }
   ]
  },
  {
   "uid": "da1304:U00015",
   "speaker": "(지문)",
   "jp": "だが、紅い紅いアルの手のひらに重ねられる、もうひとつの\n手のひら。",
   "cells": [
    {
     "sid": "da1304:T00037",
     "kind": "본문",
     "jp": "だが、紅い紅いアルの手のひらに重ねられる、もうひとつの\n手のひら。",
     "ko": "하지만 붉고 붉은 알의 손바닥에 포개어지는, 또 하나의\n손바닥."
    }
   ]
  },
  {
   "uid": "da1304:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「――認知したのね？　未来を」",
   "cells": [
    {
     "sid": "da1304:T00038",
     "kind": "본문",
     "jp": "「――認知したのね？　未来を」",
     "ko": "「――인지했구나?　미래를」"
    }
   ]
  },
  {
   "uid": "da1304:U00017",
   "speaker": "アル",
   "jp": "「くぅ……あぁぁ……！\n　アナザー……ブラッド……！」",
   "cells": [
    {
     "sid": "da1304:T00039",
     "kind": "본문",
     "jp": "「くぅ……あぁぁ……！\n　アナザー……ブラッド……！」",
     "ko": "「크으…… 아아아……!\n　어나더…… 블러드……!」"
    }
   ]
  },
  {
   "uid": "da1304:U00018",
   "speaker": "アナザーブラッド",
   "jp": "「私はもう〈アナザー〉蛭子なんかじゃない」",
   "cells": [
    {
     "sid": "da1304:T00040",
     "kind": "본문",
     "jp": "「私はもう",
     "ko": "「나는 이제 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00009",
     "kind": "루비 읽기",
     "jp": "アナザー",
     "ko": "어나더",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00041",
     "kind": "본문",
     "jp": "蛭子",
     "ko": "거머리 아이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00042",
     "kind": "본문",
     "jp": "なんかじゃない」",
     "ko": " 따위가 아니야」"
    }
   ]
  },
  {
   "uid": "da1304:U00019",
   "speaker": "(지문)",
   "jp": "アルを侵す紅い影の中から、紅の少女が姿を〈あらわ〉顕す。ずぶり、ずぶり。嫌な音を立てながら、血の彩の水面から這い出てくる。",
   "cells": [
    {
     "sid": "da1304:T00043",
     "kind": "본문",
     "jp": "アルを侵す紅い影の中から、紅の少女が姿を",
     "ko": "알을 침식하는 붉은 그림자 속에서 붉은 소녀가 모습을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00010",
     "kind": "루비 읽기",
     "jp": "あらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00044",
     "kind": "본문",
     "jp": "顕",
     "ko": "드러낸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00045",
     "kind": "본문",
     "jp": "す。",
     "ko": "다."
    },
    {
     "sid": "da1304:T00046",
     "kind": "본문",
     "jp": "ずぶり、ずぶり。",
     "ko": "철퍽, 철퍽."
    },
    {
     "sid": "da1304:T00047",
     "kind": "본문",
     "jp": "嫌な音を立てながら、血の彩の水面から這い出てくる。",
     "ko": "불쾌한 소리를 내며 피 빛깔 수면에서 기어 나온다."
    }
   ]
  },
  {
   "uid": "da1304:U00020",
   "speaker": "アル",
   "jp": "「ああぁぁぁ――――ッ！」",
   "cells": [
    {
     "sid": "da1304:T00048",
     "kind": "본문",
     "jp": "「ああぁぁぁ――――ッ！」",
     "ko": "「아아아아아――――앗!」"
    }
   ]
  },
  {
   "uid": "da1304:U00021",
   "speaker": "(지문)",
   "jp": "苦痛に悶え、アルは身を仰け反らせる。紅の少女は上半身までを、アルの胸から生やしていた。\n\n　真正面、触れ合うほどの間近から、アルの貌を覗き込む。〈ヒイロ〉緋色の瞳が、〈ヒスイ〉翡翠の瞳を覗き込む。",
   "cells": [
    {
     "sid": "da1304:T00049",
     "kind": "본문",
     "jp": "苦痛に悶え、アルは身を仰け反らせる。",
     "ko": "고통에 몸부림치며 알은 몸을 뒤로 젖힌다."
    },
    {
     "sid": "da1304:T00050",
     "kind": "본문",
     "jp": "紅の少女は上半身までを、アルの胸から生やしていた。\n\n　真正面、触れ合うほどの間近から、アルの貌を覗き込む。",
     "ko": "붉은 소녀는 상반신까지를 알의 가슴에서 내밀고 있었다.\n\n　정면, 서로 닿을 듯한 지근거리에서 알의 얼굴을 들여다본다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00011",
     "kind": "루비 읽기",
     "jp": "ヒイロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00051",
     "kind": "본문",
     "jp": "緋色",
     "ko": "진홍빛",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00052",
     "kind": "본문",
     "jp": "の瞳が、",
     "ko": "의 눈동자가, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1304:R00012",
     "kind": "루비 읽기",
     "jp": "ヒスイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00053",
     "kind": "본문",
     "jp": "翡翠",
     "ko": "비취색",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00054",
     "kind": "본문",
     "jp": "の瞳を覗き込む。",
     "ko": "의 눈동자를 들여다본다."
    }
   ]
  },
  {
   "uid": "da1304:U00022",
   "speaker": "アナザーブラッド",
   "jp": "「貴女が未来を……九朔と言う血を\n認めたとき、私と貴女の最後の絆が\n繋がったんですわ」",
   "cells": [
    {
     "sid": "da1304:T00055",
     "kind": "본문",
     "jp": "「貴女が未来を……九朔と言う血を\n認めたとき、私と貴女の最後の絆が\n繋がったんですわ」",
     "ko": "「당신이 미래를…… 쿠자쿠라는 피를\n인정했을 때, 나와 당신의 마지막 유대가\n이어졌답니다」"
    }
   ]
  },
  {
   "uid": "da1304:U00023",
   "speaker": "アナザーブラッド",
   "jp": "「その絆こそが最後の鍵……\n　もはや、貴女は私の侵攻を\n　阻めない！」",
   "cells": [
    {
     "sid": "da1304:T00056",
     "kind": "본문",
     "jp": "「その絆こそが最後の鍵……\n　もはや、貴女は私の侵攻を\n　阻めない！」",
     "ko": "「그 유대야말로 최후의 열쇠……\n　더 이상, 당신은 나의 침공을\n　막을 수 없어!」"
    }
   ]
  },
  {
   "uid": "da1304:U00024",
   "speaker": "九郎",
   "jp": "「てめえ……っ！」",
   "cells": [
