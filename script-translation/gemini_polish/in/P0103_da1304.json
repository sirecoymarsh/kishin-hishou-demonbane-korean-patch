     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00060",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1304:T00061",
     "kind": "본문",
     "jp": "……",
     "ko": "…… ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1304:R00014",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1304:T00062",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
