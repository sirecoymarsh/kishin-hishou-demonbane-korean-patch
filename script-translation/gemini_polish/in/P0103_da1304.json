     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1304:U00027",
   "speaker": "アナザーブラッド",
   "jp": "「九朔と一緒。\n　私も貴女たちの子ども……」",
   "cells": [
    {
