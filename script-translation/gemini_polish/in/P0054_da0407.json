  {
   "uid": "da0407:U00015",
   "speaker": "クラウディウス",
   "jp": "「は……はははは！\n　吠えたな虫けら！\n　ＯＫＯＫ、分かったよ。\n　確かめようじゃねえか……」",
   "cells": [
    {
     "sid": "da0407:T00048",
     "kind": "본문",
     "jp": "「は……はははは！\n　吠えたな虫けら！\n　ＯＫＯＫ、分かったよ。\n　確かめようじゃねえか……」",
