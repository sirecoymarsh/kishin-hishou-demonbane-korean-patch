  {
   "uid": "da1309:U00014",
   "speaker": "(지문)",
   "jp": "混沌が、優しく嘲笑う。",
   "cells": [
    {
     "sid": "da1309:T00052",
     "kind": "본문",
     "jp": "混沌が、優しく嘲笑う。",
     "ko": "혼돈이, 상냥하게 비웃는다."
    }
   ]
  },
  {
   "uid": "da1309:U00015",
   "speaker": "ナイア",
   "jp": "「君の手には『魔を断つ剣』\n　　　　　　なんて握られてない」",
   "cells": [
    {
     "sid": "da1309:T00053",
     "kind": "본문",
     "jp": "「君の手には『魔を断つ剣』\n　　　　　　なんて握られてない」",
     "ko": "「그대의 손에는 『마를 끊는 검』\n　　　　　　따윈 쥐어져 있지 않아」"
    }
   ]
  },
  {
   "uid": "da1309:U00016",
   "speaker": "九朔",
   "jp": "「あ……ああ……ああああ……！」",
   "cells": [
