     "kind": "본문",
     "jp": "機械仕掛けの悪夢",
     "ko": "기계장치의 악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1309:T00003",
     "kind": "본문",
     "jp": "』？",
     "ko": "』?",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1309:R00002",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・・",
     "ko": "・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1309:T00004",
     "kind": "본문",
     "jp": "ナイアルラトホテップ",
     "ko": "나이알라토텝",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1309:T00005",
     "kind": "본문",
