  {
   "uid": "da1309:U00001",
   "speaker": "九朔",
   "jp": "「ゲームキーパー？\n　『〈クロックワーク・ファントム〉機械仕掛けの悪夢』？〈・・・・・・・・・・〉ナイアルラトホテップ？」",
   "cells": [
    {
     "sid": "da1309:T00001",
     "kind": "본문",
     "jp": "「ゲームキーパー？\n　『",
     "ko": "「게임 키퍼?\n　『",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1309:R00001",
     "kind": "루비 읽기",
     "jp": "クロックワーク・ファントム",
     "ko": "클록워크 팬텀",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
