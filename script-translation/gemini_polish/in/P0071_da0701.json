    },
    {
     "sid": "da0701:T00211",
     "kind": "본문",
     "jp": "見つめて",
     "ko": " 응시하고",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da0701:R00040",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00212",
     "kind": "본문",
     "jp": "いた",
     "ko": " 있었다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00213",
     "kind": "본문",
     "jp": "。\n\n　無機質な眸のその奥――怒り、憎しみ、そして殺意の気配すらも\n感じるのは、はたして気のせいだろうか？",
     "ko": ".\n\n　무기질적인 눈동자 그 깊은 곳――분노, 증오, 그리고 살의의 기척마저도\n느껴지는 것은 과연 기분 탓일까?"
    }
   ]
  },
  {
   "uid": "da0701:U00087",
   "speaker": "テリオン",
   "jp": "「とにかく、これで役者が揃った……」",
   "cells": [
    {
     "sid": "da0701:T00214",
     "kind": "본문",
     "jp": "「とにかく、これで役者が揃った……」",
     "ko": "「어찌 됐든, 이걸로 배우가 다 모였군……」"
    }
   ]
  },
  {
   "uid": "da0701:U00088",
   "speaker": "アナザーブラッド",
   "jp": "「そのようね。\n　予定外のことで〈はなは〉甚だ不愉快ではあるけれど」",
   "cells": [
    {
     "sid": "da0701:T00215",
     "kind": "본문",
     "jp": "「そのようね。\n　予定外のことで",
     "ko": "「그런 모양이네.\n　예정 밖의 일이라 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00041",
     "kind": "루비 읽기",
     "jp": "はなは",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00216",
     "kind": "본문",
     "jp": "甚",
     "ko": "심히",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00217",
     "kind": "본문",
     "jp": "だ不愉快ではあるけれど」",
     "ko": " 불유쾌하긴 하지만」"
    }
   ]
  },
  {
   "uid": "da0701:U00089",
   "speaker": "アナザーブラッド",
   "jp": "「〈オリジナル〉お母様を堕とすには、\n　総ての〈ゆめ〉希望を絶つ必要がありそう」",
   "cells": [
    {
     "sid": "da0701:T00218",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00042",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00219",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00220",
     "kind": "본문",
     "jp": "を堕とすには、\n　総ての",
     "ko": "을 함락하려면,\n　모든 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00043",
     "kind": "루비 읽기",
     "jp": "ゆめ",
     "ko": "꿈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00221",
     "kind": "본문",
     "jp": "希望",
     "ko": "희망",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00222",
     "kind": "본문",
     "jp": "を絶つ必要がありそう」",
     "ko": "을 끊어 버릴 필요가 있겠어」"
    }
   ]
  },
  {
   "uid": "da0701:U00090",
   "speaker": "アナザーブラッド",
   "jp": "「ここは一度、仕切り直し。\n　次の幕を待ちましょう」",
   "cells": [
    {
     "sid": "da0701:T00223",
     "kind": "본문",
     "jp": "「ここは一度、仕切り直し。\n　次の幕を待ちましょう」",
     "ko": "「여기는 일단 판을 다시 짜지.\n　다음 막을 기다리도록 하자」"
    }
   ]
  },
  {
   "uid": "da0701:U00091",
   "speaker": "メタトロン",
   "jp": "「逃がすか！」",
   "cells": [
    {
     "sid": "da0701:T00224",
     "kind": "본문",
     "jp": "「逃がすか！」",
     "ko": "「놓칠까 보냐!」"
    }
   ]
  },
  {
   "uid": "da0701:U00092",
   "speaker": "メタトロン",
   "jp": "「くっ……！」",
   "cells": [
    {
     "sid": "da0701:T00225",
     "kind": "본문",
     "jp": "「くっ……！」",
     "ko": "「큭……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00093",
   "speaker": "(지문)",
   "jp": "マスターテリオンの傍らで、血の風が吹いた。血の〈いろ〉彩の二重螺旋が、〈つむじ〉旋風を巻いて踊る。",
   "cells": [
    {
     "sid": "da0701:T00226",
     "kind": "본문",
     "jp": "マスターテリオンの傍らで、血の風が吹いた。",
     "ko": "마스터 테리온의 곁에서 피의 바람이 불었다."
    },
    {
     "sid": "da0701:T00227",
     "kind": "본문",
     "jp": "血の",
     "ko": "피의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00044",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00228",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛깔",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00229",
     "kind": "본문",
     "jp": "の二重螺旋が、",
     "ko": "로 된 이중나선이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00045",
     "kind": "루비 읽기",
     "jp": "つむじ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00230",
     "kind": "본문",
     "jp": "旋風",
     "ko": "회오리바람",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00231",
     "kind": "본문",
     "jp": "を巻いて踊る。",
     "ko": "을 일으키며 춤춘다."
    }
   ]
  },
  {
   "uid": "da0701:U00094",
   "speaker": "(지문)",
   "jp": "血の風が濃度を増す。二重螺旋がヒトの〈カタチ〉容を編み上げてゆく。――〈アナザーブラッド〉紅の少女。",
   "cells": [
    {
     "sid": "da0701:T00232",
     "kind": "본문",
     "jp": "血の風が濃度を増す。",
     "ko": "피의 바람이 농도를 더한다."
    },
    {
     "sid": "da0701:T00233",
     "kind": "본문",
     "jp": "二重螺旋がヒトの",
     "ko": "이중나선이 인간의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00046",
     "kind": "루비 읽기",
     "jp": "カタチ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00234",
     "kind": "본문",
     "jp": "容",
     "ko": "형태",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00235",
     "kind": "본문",
     "jp": "を編み上げてゆく。",
     "ko": "를 엮어 올린다."
    },
    {
     "sid": "da0701:T00236",
     "kind": "본문",
     "jp": "――",
     "ko": "――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00047",
     "kind": "루비 읽기",
     "jp": "アナザーブラッド",
     "ko": "어나더 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00237",
     "kind": "본문",
     "jp": "紅の少女",
     "ko": "붉은 소녀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00238",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0701:U00095",
   "speaker": "アナザーブラッド",
   "jp": "「今度の幕では、より相応しい舞台\n　を用意してあげる」",
   "cells": [
    {
     "sid": "da0701:T00239",
     "kind": "본문",
     "jp": "「今度の幕では、より相応しい舞台\n　を用意してあげる」",
     "ko": "「다음 막에서는 보다 어울리는 무대\n　를 준비해 줄게」"
    }
   ]
  },
  {
   "uid": "da0701:U00096",
   "speaker": "九朔",
   "jp": "「……必要ない」",
   "cells": [
    {
     "sid": "da0701:T00240",
     "kind": "본문",
     "jp": "「……必要ない」",
     "ko": "「……필요 없다」"
    }
   ]
  },
  {
   "uid": "da0701:U00097",
   "speaker": "(지문)",
   "jp": "今度こそ、トゥーソードはリベル・レギスを見上げた。",
   "cells": [
    {
     "sid": "da0701:T00241",
     "kind": "본문",
     "jp": "今度こそ、トゥーソードはリベル・レギスを見上げた。",
     "ko": "이번에야말로, 투 소드는 리베르 레기스를 올려다보았다."
    }
   ]
  },
  {
   "uid": "da0701:U00098",
   "speaker": "九朔",
   "jp": "「アナザーブラッド。\n　我が双剣の錆となれ」",
   "cells": [
    {
     "sid": "da0701:T00242",
     "kind": "본문",
     "jp": "「アナザーブラッド。\n　我が双剣の錆となれ」",
     "ko": "「어나더 블러드.\n　나의 쌍검의 녹이 되어라」"
    }
   ]
  },
  {
   "uid": "da0701:U00099",
   "speaker": "アナザーブラッド",
   "jp": "「残念だけど貴方は主役じゃないわ。舞台を飾るのは彼ら――無限螺旋の英雄たちよ」",
   "cells": [
    {
     "sid": "da0701:T00243",
     "kind": "본문",
     "jp": "「残念だけど貴方は主役じゃないわ。舞台を飾るのは彼ら――無限螺旋の英雄たちよ」",
     "ko": "「유감이지만 당신은 주역이 아니야. 무대를 장식하는 건 저들――무한나선의 영웅들이지」"
    }
   ]
  },
  {
   "uid": "da0701:U00100",
   "speaker": "九朔",
   "jp": "「ならば、この〈ふざけ〉巫山戯た舞台ごと叩き斬ってやる。この〈ドロ〉汚泥のように」",
   "cells": [
    {
     "sid": "da0701:T00244",
     "kind": "본문",
     "jp": "「ならば、この",
     "ko": "「그렇다면 이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00048",
     "kind": "루비 읽기",
     "jp": "ふざけ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00245",
     "kind": "본문",
     "jp": "巫山戯",
     "ko": "웃기지도 않",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00246",
     "kind": "본문",
     "jp": "た舞台ごと叩き斬ってやる。この",
     "ko": "는 무대째로 베어 넘겨 주마. 이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00049",
     "kind": "루비 읽기",
     "jp": "ドロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00247",
     "kind": "본문",
     "jp": "汚泥",
     "ko": "진흙탕",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00248",
     "kind": "본문",
     "jp": "のように」",
     "ko": "처럼」"
    }
   ]
  },
  {
   "uid": "da0701:U00101",
   "speaker": "(지문)",
   "jp": "揮発した〈ズアウィア〉汚泥が編む血風の中で、トゥーソードは小剣を構える。それを見下ろす少女の表情は酷薄だった。",
   "cells": [
    {
     "sid": "da0701:T00249",
     "kind": "본문",
     "jp": "揮発した",
     "ko": "휘발한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00050",
     "kind": "루비 읽기",
     "jp": "ズアウィア",
     "ko": "즈아위아가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00250",
     "kind": "본문",
     "jp": "汚泥",
     "ko": "진흙탕이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00251",
     "kind": "본문",
     "jp": "が編む血風の中で、トゥーソードは小剣を構える。",
     "ko": " 엮어 내는 혈풍 속에서, 투 소드는 소검을 겨눈다."
    },
    {
     "sid": "da0701:T00252",
     "kind": "본문",
     "jp": "それを見下ろす少女の表情は酷薄だった。",
     "ko": "그것을 내려다보는 소녀의 표정은 냉혹했다."
    }
   ]
  },
  {
   "uid": "da0701:U00102",
   "speaker": "アナザーブラッド",
   "jp": "「自惚れるな、〈ドンキホーテ〉道化。\n　お前はゲーム盤の上で\n　踊らされているだけよ」",
   "cells": [
    {
     "sid": "da0701:T00253",
     "kind": "본문",
     "jp": "「自惚れるな、",
     "ko": "「자만하지 마라, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00051",
     "kind": "루비 읽기",
     "jp": "ドンキホーテ",
     "ko": "돈키호테",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00254",
     "kind": "본문",
     "jp": "道化",
     "ko": "광대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00255",
     "kind": "본문",
     "jp": "。\n　お前はゲーム盤の上で\n　踊らされているだけよ」",
     "ko": ".\n　네놈은 게임판 위에서\n　놀아나고 있을 뿐이야」"
    }
   ]
  },
  {
   "uid": "da0701:U00103",
   "speaker": "九朔",
   "jp": "「……！」",
   "cells": [
    {
     "sid": "da0701:T00256",
     "kind": "본문",
     "jp": "「……！」",
     "ko": "「……!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0701:U00104",
   "speaker": "(지문)",
   "jp": "トゥーソードを囲む血風の濃度が上がる。血風は実体を結び、血の〈いろ〉彩をした二匹の〈オロチ〉大蛇となった。",
   "cells": [
    {
     "sid": "da0701:T00257",
     "kind": "본문",
     "jp": "トゥーソードを囲む血風の濃度が上がる。",
     "ko": "투 소드를 둘러싼 혈풍의 농도가 올라간다."
    },
    {
     "sid": "da0701:T00258",
     "kind": "본문",
     "jp": "血風は実体を結び、血の",
     "ko": "혈풍은 실체를 맺어, 피의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00052",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00259",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛깔",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00260",
     "kind": "본문",
     "jp": "をした二匹の",
     "ko": "을 한 두 마리의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00053",
     "kind": "루비 읽기",
     "jp": "オロチ",
     "ko": "오로치가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00261",
     "kind": "본문",
     "jp": "大蛇",
     "ko": "큰 뱀이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00262",
     "kind": "본문",
     "jp": "となった。",
     "ko": " 되었다."
    }
   ]
  },
  {
   "uid": "da0701:U00105",
   "speaker": "(지문)",
   "jp": "天に昇りつめる二重螺旋の蛇→解けて、互いの尻尾を喰らおうと廻り／廻り／廻り／繋ぐ〈メビウス・リング〉螺旋の環→さら高速回転／回転／回転／輪廻→縮小→圧縮＝爆縮。",
   "cells": [
    {
     "sid": "da0701:T00263",
     "kind": "본문",
     "jp": "天に昇りつめる二重螺旋の蛇→解けて、互いの尻尾を喰らおうと廻り／廻り／廻り／繋ぐ",
     "ko": "하늘로 끝없이 치솟는 이중나선의 뱀→풀려나, 서로의 꼬리를 집어삼키려 돌고/돌고/돌며/잇는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00054",
     "kind": "루비 읽기",
     "jp": "メビウス・リング",
     "ko": "뫼비우스 링",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00264",
     "kind": "본문",
     "jp": "螺旋の環",
     "ko": "나선의 고리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00265",
     "kind": "본문",
     "jp": "→さら高速回転／回転／回転／輪廻→縮小→圧縮＝爆縮。",
     "ko": "→더욱 고속 회전/회전/회전/윤회→축소→압축＝폭축."
    }
   ]
  },
  {
   "uid": "da0701:U00106",
   "speaker": "(지문)",
   "jp": "開放／爆発",
   "cells": [
    {
     "sid": "da0701:T00266",
     "kind": "본문",
     "jp": "開放／",
     "ko": "개방/"
    },
    {
     "sid": "da0701:T00267",
     "kind": "본문",
     "jp": "爆発",
     "ko": "폭발"
    }
   ]
  },
  {
   "uid": "da0701:U00107",
   "speaker": "(지문)",
   "jp": "大爆音が轟いた。同時に蛇は、一筋の紅い稲妻となってリベル・レギスを貫く。そして。",
   "cells": [
    {
     "sid": "da0701:T00268",
     "kind": "본문",
     "jp": "大爆音が轟いた。",
     "ko": "대폭음이 울려 퍼졌다."
    },
    {
     "sid": "da0701:T00269",
     "kind": "본문",
     "jp": "同時に蛇は、一筋の紅い稲妻となってリベル・レギスを貫く。",
     "ko": "동시에 뱀은 한 줄기 붉은 번개가 되어 리베르 레기스를 꿰뚫는다."
    },
    {
     "sid": "da0701:T00270",
     "kind": "본문",
     "jp": "そして。",
     "ko": "그리고."
    }
   ]
  },
  {
   "uid": "da0701:U00108",
   "speaker": "アル",
   "jp": "「再生してゆく……！」",
   "cells": [
    {
     "sid": "da0701:T00271",
     "kind": "본문",
     "jp": "「再生してゆく……！」",
     "ko": "「재생해 간다……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00109",
   "speaker": "(지문)",
   "jp": "半壊していたリベル・レギスがみるみる再生してゆく。稲妻に刻まれた邪神の〈データ〉情報を、リベル・レギスが読み込み、再構築しているのだ。\n\n　破損箇所から溢れ出す、不浄な赤黒い粘液。煮え滾るソレは、だが急速に冷却→固体化し、リベル・レギスを構成する超物質となる。\n\n　精密に再現された内部機関を、超鋼が鎧っていく――",
   "cells": [
    {
     "sid": "da0701:T00272",
     "kind": "본문",
     "jp": "半壊していたリベル・レギスがみるみる再生してゆく。",
     "ko": "반파되어 있던 리베르 레기스가 순식간에 재생해 간다."
    },
    {
     "sid": "da0701:T00273",
     "kind": "본문",
     "jp": "稲妻に刻まれた邪神の",
     "ko": "번개에 새겨진 사신의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00055",
     "kind": "루비 읽기",
     "jp": "データ",
     "ko": "데이터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00274",
     "kind": "본문",
     "jp": "情報",
     "ko": "정보",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00275",
     "kind": "본문",
     "jp": "を、リベル・レギスが読み込み、再構築しているのだ。\n\n　破損箇所から溢れ出す、不浄な赤黒い粘液。",
     "ko": "를 리베르 레기스가 읽어 들여 재구축하고 있다.\n\n　파손 부위에서 넘쳐흐르는 부정한 검붉은 점액."
    },
    {
     "sid": "da0701:T00276",
     "kind": "본문",
     "jp": "煮え滾るソレは、だが急速に冷却→固体化し、リベル・レギスを構成する超物質となる。\n\n　精密に再現された内部機関を、超鋼が鎧っていく――",
     "ko": "부글부글 끓어오르는 그것은 그러나 급속히 냉각→고체화하여, 리베르 레기스를 구성하는 초물질이 된다.\n\n　정밀하게 재현된 내부 기관을 초강이 갑옷처럼 덮어 간다――"
    }
   ]
  },
  {
   "uid": "da0701:U00110",
   "speaker": "九郎（マギウス）＆アル（ヘルメット）＆九朔",
   "jp": "「させるか！」",
   "cells": [
    {
     "sid": "da0701:T00277",
     "kind": "본문",
     "jp": "「させるか！」",
     "ko": "「놔둘까 보냐!」"
    }
   ]
  },
  {
   "uid": "da0701:U00111",
   "speaker": "(지문)",
   "jp": "デモンベインとトゥーソードは同時に脚部シールドを解放。リベル・レギスに躍りかかった。\n\n　しかし……",
   "cells": [
    {
     "sid": "da0701:T00278",
     "kind": "본문",
     "jp": "デモンベインとトゥーソードは同時に脚部シールドを解放。",
     "ko": "데몬베인과 투 소드는 동시에 다리 실드를 개방."
    },
    {
     "sid": "da0701:T00279",
     "kind": "본문",
     "jp": "リベル・レギスに躍りかかった。\n\n　しかし……",
     "ko": "리베르 레기스에게 덤벼들었다.\n\n　하지만……"
    }
   ]
  },
  {
   "uid": "da0701:U00112",
   "speaker": "テリオン",
   "jp": "「あはははははははははは！」",
   "cells": [
    {
     "sid": "da0701:T00280",
     "kind": "본문",
     "jp": "「あはははははははははは！」",
     "ko": "「아하하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da0701:U00113",
   "speaker": "(지문)",
   "jp": "リベル・レギスの背後（？）で、空間が砕け散る。空間に生じた裂け目より噴き出す瘴気。\n\n　それは物質的な圧力をもって、２体のデモンベインを吹き飛ばす。",
   "cells": [
    {
     "sid": "da0701:T00281",
     "kind": "본문",
     "jp": "リベル・レギスの背後（？）で、空間が砕け散る。",
     "ko": "리베르 레기스의 등 뒤(?)에서 공간이 산산이 부서진다."
    },
    {
     "sid": "da0701:T00282",
     "kind": "본문",
     "jp": "空間に生じた裂け目より噴き出す瘴気。\n\n　それは物質的な圧力をもって、２体のデモンベインを吹き飛ばす。",
     "ko": "공간에 생긴 균열에서 뿜어져 나오는 독기.\n\n　그것은 물질적인 압력을 띠고 2대의 데몬베인을 날려 버린다."
    }
   ]
  },
  {
   "uid": "da0701:U00114",
   "speaker": "九郎＆九朔＆アル",
   "jp": "「「うわあああああああ！」」",
   "cells": [
    {
     "sid": "da0701:T00283",
     "kind": "본문",
     "jp": "「「うわあああああああ！」」",
     "ko": "「「우와아아아아아아아!」」"
    }
   ]
  },
  {
   "uid": "da0701:U00115",
   "speaker": "ライス",
   "jp": "「時空の裂け目が……！」",
   "cells": [
    {
     "sid": "da0701:T00284",
     "kind": "본문",
     "jp": "「時空の裂け目が……！」",
     "ko": "「시공의 균열이……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00116",
   "speaker": "アーミティッジ",
   "jp": "「……ウェイトリイの置き土産か！」",
   "cells": [
    {
     "sid": "da0701:T00285",
     "kind": "본문",
     "jp": "「……ウェイトリイの置き土産か！」",
     "ko": "「……웨이틀리가 남긴 선물인가!」"
    }
   ]
  },
  {
   "uid": "da0701:U00117",
   "speaker": "(지문)",
   "jp": "裂け目の『向こう側』から、〈・・・・・〉燃える闇黒が、ぞろり、と這い出てきた。黒炎がリベル・レギスを包み込む。群がる〈イナゴ〉人蝗に貪られるように、紅の機体が闇黒に蝕まれてゆく。",
   "cells": [
    {
     "sid": "da0701:T00286",
     "kind": "본문",
     "jp": "裂け目の『向こう側』から、",
     "ko": "균열의 『저편』에서, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00056",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00287",
     "kind": "본문",
     "jp": "燃える闇黒",
     "ko": "불타는 암흑",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00288",
     "kind": "본문",
     "jp": "が、ぞろり、と這い出てきた。",
     "ko": "이 스르륵 기어 나왔다."
    },
    {
     "sid": "da0701:T00289",
     "kind": "본문",
     "jp": "黒炎がリベル・レギスを包み込む。",
     "ko": "흑염이 리베르 레기스를 감싼다."
    },
    {
     "sid": "da0701:T00290",
     "kind": "본문",
     "jp": "群がる",
     "ko": "떼 지어 몰려드는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00057",
     "kind": "루비 읽기",
     "jp": "イナゴ",
     "ko": "메뚜기",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00291",
     "kind": "본문",
     "jp": "人蝗",
     "ko": "인황",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00292",
     "kind": "본문",
     "jp": "に貪られるように、紅の機体が闇黒に蝕まれてゆく。",
     "ko": "에게 탐식당하듯, 진홍의 기체가 암흑에 좀먹혀 간다."
    }
   ]
  },
  {
   "uid": "da0701:U00118",
   "speaker": "テリオン",
   "jp": "「ではしばしの休演を。\n　また逢おう、宿敵諸君――」",
   "cells": [
    {
     "sid": "da0701:T00293",
     "kind": "본문",
     "jp": "「ではしばしの休演を。\n　また逢おう、宿敵諸君――」",
     "ko": "「그럼 잠시 휴연을.\n　다시 만나자, 숙적 제군――」"
    }
   ]
  },
  {
   "uid": "da0701:U00119",
   "speaker": "(지문)",
   "jp": "燃える闇の中でマスターテリオンが〈わら〉嗤う。亀裂の笑み。",
   "cells": [
    {
     "sid": "da0701:T00294",
     "kind": "본문",
     "jp": "燃える闇の中でマスターテリオンが",
     "ko": "불타는 어둠 속에서 마스터 테리온이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00058",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00295",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00296",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    },
    {
     "sid": "da0701:T00297",
     "kind": "본문",
     "jp": "亀裂の笑み。",
     "ko": "균열의 미소."
    }
   ]
  },
  {
   "uid": "da0701:U00120",
   "speaker": "アナザーブラッド",
   "jp": "「〈オリジナル〉お母様の希望――貴方たちが潰えるとき、\n　窮極の魔導書『アル・アジフ』は私の中に\n　融けるわ」",
   "cells": [
    {
     "sid": "da0701:T00298",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00059",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00299",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00300",
     "kind": "본문",
     "jp": "の希望――貴方たちが潰えるとき、\n　窮極の魔導書『アル・アジフ』は私の中に\n　融けるわ」",
     "ko": "의 희망――당신들이 스러질 때,\n　궁극의 마도서 『알 아지프』는 내 안으로\n　녹아들 거야」"
    }
   ]
  },
  {
   "uid": "da0701:U00121",
   "speaker": "(지문)",
   "jp": "燃える闇の中で紅の少女が〈わら〉微笑う。恍惚の笑み。",
   "cells": [
    {
     "sid": "da0701:T00301",
     "kind": "본문",
     "jp": "燃える闇の中で紅の少女が",
     "ko": "불타는 어둠 속에서 붉은 소녀가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00060",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00302",
     "kind": "본문",
     "jp": "微笑",
     "ko": "미소 짓",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00303",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    },
    {
     "sid": "da0701:T00304",
     "kind": "본문",
     "jp": "恍惚の笑み。",
     "ko": "황홀의 미소."
    }
   ]
  },
  {
   "uid": "da0701:U00122",
   "speaker": "九郎",
   "jp": "「不可能さ」",
   "cells": [
    {
     "sid": "da0701:T00305",
     "kind": "본문",
     "jp": "「不可能さ」",
     "ko": "「불가능해」"
    }
   ]
  },
  {
   "uid": "da0701:U00123",
   "speaker": "アル",
   "jp": "「九郎……」",
   "cells": [
    {
     "sid": "da0701:T00306",
     "kind": "본문",
     "jp": "「九郎……」",
     "ko": "「쿠로……」"
    }
   ]
  },
  {
   "uid": "da0701:U00124",
   "speaker": "(지문)",
   "jp": "俺は燃える闇を真っ直ぐに見据え、笑う。不敵な笑み。決して怯まず。威風堂々と。",
   "cells": [
    {
     "sid": "da0701:T00307",
     "kind": "본문",
     "jp": "俺は燃える闇を真っ直ぐに見据え、笑う。",
     "ko": "나는 불타는 어둠을 똑바로 마주 보며 웃는다."
    },
    {
     "sid": "da0701:T00308",
     "kind": "본문",
     "jp": "不敵な笑み。",
     "ko": "대담한 미소."
    },
    {
     "sid": "da0701:T00309",
     "kind": "본문",
     "jp": "決して怯まず。威風堂々と。",
     "ko": "결코 주눅 들지 않고. 위풍당당하게."
    }
   ]
  },
  {
   "uid": "da0701:U00125",
   "speaker": "九郎",
   "jp": "「デモンベインが在る限り、俺たちは絶対に負けない」",
   "cells": [
    {
     "sid": "da0701:T00310",
     "kind": "본문",
     "jp": "「デモンベインが在る限り、俺たちは絶対に負けない」",
     "ko": "「데몬베인이 있는 한, 우리는 절대 지지 않아」"
    }
   ]
  },
  {
   "uid": "da0701:U00126",
   "speaker": "アル",
   "jp": "「……そのとおりだ、九郎！」",
   "cells": [
    {
     "sid": "da0701:T00311",
     "kind": "본문",
     "jp": "「……そのとおりだ、九郎！」",
     "ko": "「……그 말대로다, 쿠로!」"
    }
   ]
  },
  {
   "uid": "da0701:U00127",
   "speaker": "アナザーブラッド",
   "jp": "「……素敵ね。ますます好きに\n　なってしまいそうよ、探偵さん」",
   "cells": [
    {
     "sid": "da0701:T00312",
     "kind": "본문",
     "jp": "「……素敵ね。ますます好きに\n　なってしまいそうよ、探偵さん」",
     "ko": "「……멋지네. 점점 더 좋아하게\n　되어 버릴 것 같아, 탐정님」"
    }
   ]
  },
  {
   "uid": "da0701:U00128",
   "speaker": "アナザーブラッド",
   "jp": "「貴方みたいな強い人を無理矢理\n　……っていうのが昂奮するのよね」",
   "cells": [
    {
     "sid": "da0701:T00313",
     "kind": "본문",
     "jp": "「貴方みたいな強い人を無理矢理\n　……っていうのが昂奮するのよね」",
     "ko": "「당신처럼 강한 사람을 억지로\n　……라는 게 흥분되거든」"
    }
   ]
  },
  {
   "uid": "da0701:U00129",
   "speaker": "(지문)",
   "jp": "燃える闇がリベル・レギスを完全に呑み込んだ。刹那、闇黒はひときわ烈しく燃え盛った。\n\n　燃える闇が〈わら〉哂う。異形の笑み。",
   "cells": [
    {
     "sid": "da0701:T00314",
     "kind": "본문",
     "jp": "燃える闇がリベル・レギスを完全に呑み込んだ。",
     "ko": "불타는 어둠이 리베르 레기스를 완전히 집어삼켰다."
    },
    {
     "sid": "da0701:T00315",
     "kind": "본문",
     "jp": "刹那、闇黒はひときわ烈しく燃え盛った。\n\n　燃える闇が",
     "ko": "찰나, 암흑은 한층 더 격렬하게 타올랐다.\n\n　불타는 어둠이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00061",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00316",
     "kind": "본문",
     "jp": "哂",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00317",
     "kind": "본문",
     "jp": "う。",
     "ko": "는다."
    },
    {
     "sid": "da0701:T00318",
     "kind": "본문",
     "jp": "異形の笑み。",
     "ko": "이형의 미소."
    }
   ]
  },
  {
   "uid": "da0701:U00130",
   "speaker": "(지문)",
   "jp": "哂う闇黒は、そのまま裂け目へと吸い込まれた。後には何も残らない。時空の裂け目も、綺麗さっぱり消えてしまった。",
   "cells": [
    {
     "sid": "da0701:T00319",
     "kind": "본문",
     "jp": "哂う闇黒は、そのまま裂け目へと吸い込まれた。",
     "ko": "비웃는 암흑은 그대로 균열 속으로 빨려 들어갔다."
    },
    {
     "sid": "da0701:T00320",
     "kind": "본문",
     "jp": "後には何も残らない。",
     "ko": "뒤에는 아무것도 남지 않는다."
    },
    {
     "sid": "da0701:T00321",
     "kind": "본문",
     "jp": "時空の裂け目も、綺麗さっぱり消えてしまった。",
     "ko": "시공의 균열도 감쪽같이 사라져 버렸다."
    }
   ]
  },
  {
   "uid": "da0701:U00131",
   "speaker": "瑠璃",
   "jp": "「消滅したのですか……？」",
   "cells": [
    {
     "sid": "da0701:T00322",
     "kind": "본문",
     "jp": "「消滅したのですか……？」",
     "ko": "「소멸한 건가요……?」"
    }
   ]
  },
  {
   "uid": "da0701:U00132",
   "speaker": "アル",
   "jp": "「撤退しただけだ。\n　いずれまた現れるぞ」",
   "cells": [
    {
     "sid": "da0701:T00323",
     "kind": "본문",
     "jp": "「撤退しただけだ。\n　いずれまた現れるぞ」",
     "ko": "「후퇴했을 뿐이다.\n　머지않아 다시 나타날 거다」"
    }
   ]
  },
  {
   "uid": "da0701:U00133",
   "speaker": "九郎",
   "jp": "「ああ……今度はもっとエゲツない〈だ〉演し物を用意してくるだろうな。\nクソッタレ」",
   "cells": [
    {
     "sid": "da0701:T00324",
     "kind": "본문",
     "jp": "「ああ……今度はもっとエゲツない",
     "ko": "「그래…… 다음엔 더 지독한\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00062",
     "kind": "루비 읽기",
     "jp": "だ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00325",
     "kind": "본문",
     "jp": "演",
     "ko": "공연",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00326",
     "kind": "본문",
     "jp": "し物を用意してくるだろうな。\nクソッタレ」",
     "ko": "거리를 준비해 오겠지.\n빌어먹을」"
    }
   ]
  },
  {
   "uid": "da0701:U00134",
   "speaker": "九朔",
   "jp": "「……アナザーブラッド」",
   "cells": [
