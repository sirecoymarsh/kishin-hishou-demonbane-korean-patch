  },
  {
   "uid": "da0701:U00078",
   "speaker": "(지문)",
   "jp": "血の霧が、エネルギー流に乗って渦を巻き、天へと昇る。血の〈いろ〉彩で編まれた、二重螺旋。",
   "cells": [
    {
     "sid": "da0701:T00190",
     "kind": "본문",
     "jp": "血の霧が、エネルギー流に乗って渦を巻き、天へと昇る。",
     "ko": "피안개가 에너지류를 타고 소용돌이치며 하늘로 솟구친다."
    },
    {
     "sid": "da0701:T00191",
     "kind": "본문",
     "jp": "血の",
     "ko": "피의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00032",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00192",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛깔",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00193",
     "kind": "본문",
     "jp": "で編まれた、二重螺旋。",
     "ko": "로 엮인 이중나선."
    }
   ]
  },
  {
   "uid": "da0701:U00079",
   "speaker": "テリオン",
   "jp": "「ほう……！」",
   "cells": [
    {
     "sid": "da0701:T00194",
     "kind": "본문",
     "jp": "「ほう……！」",
     "ko": "「호오……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00080",
   "speaker": "(지문)",
   "jp": "マスターテリオンが感嘆のため息を漏らす。",
   "cells": [
    {
     "sid": "da0701:T00195",
     "kind": "본문",
     "jp": "マスターテリオンが感嘆のため息を漏らす。",
     "ko": "마스터 테리온이 감탄의 한숨을 흘린다."
    }
   ]
  },
  {
   "uid": "da0701:U00081",
   "speaker": "テリオン",
   "jp": "「もう一体のデモンベイン\n　……貴公のことは識っている。\n　出逢わずとも識っている」",
   "cells": [
    {
     "sid": "da0701:T00196",
     "kind": "본문",
     "jp": "「もう一体のデモンベイン\n　……貴公のことは識っている。\n　出逢わずとも識っている」",
     "ko": "「또 한 대의 데몬베인\n　……귀공에 대해서는 알고 있다.\n　만나지 않아도 알고 있다」"
    }
   ]
  },
  {
   "uid": "da0701:U00082",
   "speaker": "テリオン",
   "jp": "「〈アナザーブラッド〉悪夢の記憶は、余の脳髄に\n　しかと刻まれているのだ」",
   "cells": [
    {
     "sid": "da0701:T00197",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00033",
     "kind": "루비 읽기",
     "jp": "アナザーブラッド",
     "ko": "어나더 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00198",
     "kind": "본문",
     "jp": "悪夢",
     "ko": "악몽",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00199",
     "kind": "본문",
     "jp": "の記憶は、余の脳髄に\n　しかと刻まれているのだ」",
     "ko": "의 기억은 짐의 뇌수에\n　똑똑히 새겨져 있으니 말이다」"
    }
   ]
  },
  {
   "uid": "da0701:U00083",
   "speaker": "九朔",
   "jp": "「――――――」",
   "cells": [
    {
