{
 "packet": "P0004_da0102",
 "units": [
  {
   "uid": "da0102:U00071",
   "speaker": "アル",
   "jp": "「………………」",
   "cells": [
    {
     "sid": "da0102:T00116",
     "kind": "본문",
     "jp": "「………………」",
     "ko": "「………………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00072",
   "speaker": "九郎",
   "jp": "「………………」",
   "cells": [
    {
     "sid": "da0102:T00117",
     "kind": "본문",
     "jp": "「………………」",
     "ko": "「………………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00073",
   "speaker": "アル",
   "jp": "「……どうしたのだ？」",
   "cells": [
    {
     "sid": "da0102:T00118",
     "kind": "본문",
     "jp": "「……どうしたのだ？」",
     "ko": "「……어찌 그러느냐?」"
    }
   ]
  },
  {
   "uid": "da0102:U00074",
   "speaker": "九郎",
   "jp": "「……何が？」",
   "cells": [
    {
     "sid": "da0102:T00119",
     "kind": "본문",
     "jp": "「……何が？」",
     "ko": "「……뭐가?」"
    }
   ]
  },
  {
   "uid": "da0102:U00075",
   "speaker": "アル",
   "jp": "「最近、無理にお〈どけ〉道化てないか？」",
   "cells": [
    {
     "sid": "da0102:T00120",
     "kind": "본문",
     "jp": "「最近、無理にお",
     "ko": "「요즘, 억지로 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00011",
     "kind": "루비 읽기",
     "jp": "どけ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00121",
     "kind": "본문",
     "jp": "道化",
     "ko": "익살 부리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00122",
     "kind": "본문",
     "jp": "てないか？」",
     "ko": "고 있지 않느냐?」"
    }
   ]
  },
  {
   "uid": "da0102:U00076",
   "speaker": "九郎",
   "jp": "「……ははっ、なに言ってんだか。俺は別に――」",
   "cells": [
    {
     "sid": "da0102:T00123",
     "kind": "본문",
     "jp": "「……ははっ、なに言ってんだか。俺は別に――」",
     "ko": "「……하핫, 무슨 소릴 하는 거야. 난 딱히――」"
    }
   ]
  },
  {
   "uid": "da0102:U00077",
   "speaker": "アル",
   "jp": "「〈ごまか〉誤魔化すな」",
   "cells": [
    {
     "sid": "da0102:T00124",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0102:R00012",
     "kind": "루비 읽기",
     "jp": "ごまか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00125",
     "kind": "본문",
     "jp": "誤魔化",
     "ko": "얼버무리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00126",
     "kind": "본문",
     "jp": "すな」",
     "ko": "지 마라」"
    }
   ]
  },
  {
   "uid": "da0102:U00078",
   "speaker": "九郎",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0102:T00127",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00079",
   "speaker": "アル",
   "jp": "「汝のことなど手に取るように分かる」",
   "cells": [
    {
     "sid": "da0102:T00128",
     "kind": "본문",
     "jp": "「汝のことなど手に取るように分かる」",
     "ko": "「그대 일이라면 손바닥 보듯 훤히 안다」"
    }
   ]
  },
  {
   "uid": "da0102:U00080",
   "speaker": "九郎",
   "jp": "「……お見通しってか？　敵わないな」",
   "cells": [
    {
     "sid": "da0102:T00129",
     "kind": "본문",
     "jp": "「……お見通しってか？　敵わないな」",
     "ko": "「……다 꿰뚫어 보고 있다 이건가?　당해 낼 수가 없네」"
    }
   ]
  },
  {
   "uid": "da0102:U00081",
   "speaker": "(지문)",
   "jp": "特に意味もなく、アルの髪を撫でる。アルはそれを黙って受け入れている。アルを軽く胸の中に抱いて、告げる。",
   "cells": [
    {
     "sid": "da0102:T00130",
     "kind": "본문",
     "jp": "特に意味もなく、アルの髪を撫でる。",
     "ko": "별다른 의미도 없이, 알의 머리카락을 쓰다듬는다."
    },
    {
     "sid": "da0102:T00131",
     "kind": "본문",
     "jp": "アルはそれを黙って受け入れている。",
     "ko": "알은 그 손길을 잠자코 받아들이고 있다."
    },
    {
     "sid": "da0102:T00132",
     "kind": "본문",
     "jp": "アルを軽く胸の中に抱いて、告げる。",
     "ko": "알을 가볍게 품에 안고, 입을 연다."
    }
   ]
  },
  {
   "uid": "da0102:U00082",
   "speaker": "九郎",
   "jp": "「大したことじゃないのさ。\n　ただ、ちょっとだけな。前のことを思い出したりして」",
   "cells": [
    {
     "sid": "da0102:T00133",
     "kind": "본문",
     "jp": "「大したことじゃないのさ。\n　ただ、ちょっとだけな。前のことを思い出したりして」",
     "ko": "「대단한 일은 아니야.\n　그저, 조금 말이야. 예전 일이 떠오르고 그래서」"
    }
   ]
  },
  {
   "uid": "da0102:U00083",
   "speaker": "アル",
   "jp": "「『前世』か」",
   "cells": [
    {
     "sid": "da0102:T00134",
     "kind": "본문",
     "jp": "「『前世』か」",
     "ko": "「『전생』 말인가」"
    }
   ]
  },
  {
   "uid": "da0102:U00084",
   "speaker": "九郎",
   "jp": "「……ああ」\n\n　『前世』ってのはつまり、『ブラックロッジ』が存在した世界……つまりデモンベインで戦っていた〈とき〉時間のことだ。\n\n　俺たちの知る暗黒時代は、歪んだ歴史が生み出したものだった。デモンベインの戦いにより間違った時間は修正され……この時間、この世界にはあの強大な悪は存在しない。\n\n　そしてあの戦いもまた、もう俺たちの記憶の中にしか存在\nしないのだ。",
   "cells": [
    {
     "sid": "da0102:T00135",
     "kind": "본문",
     "jp": "「……ああ」\n\n　『前世』ってのはつまり、『ブラックロッジ』が存在した世界……",
     "ko": "「……아아」\n\n　『전생』이란 건 즉, 『블랙 로지』가 존재했던 세계……"
    },
    {
     "sid": "da0102:T00136",
     "kind": "본문",
     "jp": "つまりデモンベインで戦っていた",
     "ko": "다시 말해 데몬베인으로 싸웠던 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00013",
     "kind": "루비 읽기",
     "jp": "とき",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00137",
     "kind": "본문",
     "jp": "時間",
     "ko": "시간",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00138",
     "kind": "본문",
     "jp": "のことだ。\n\n　俺たちの知る暗黒時代は、歪んだ歴史が生み出したものだった。",
     "ko": "을 뜻한다.\n\n　우리가 아는 암흑시대는, 일그러진 역사가 낳은 산물이었다."
    },
    {
     "sid": "da0102:T00139",
     "kind": "본문",
     "jp": "デモンベインの戦いにより間違った時間は修正され……この時間、この世界にはあの強大な悪は存在しない。\n\n　そしてあの戦いもまた、もう俺たちの記憶の中にしか存在\nしないのだ。",
     "ko": "데몬베인의 싸움으로 잘못된 시간은 수정되었고…… 이 시간, 이 세계에는 그 강대한 악이 존재하지 않는다.\n\n　그리고 그 싸움 또한, 이제는 우리의 기억 속에만 존재할\n뿐이다."
    }
   ]
  },
  {
   "uid": "da0102:U00085",
   "speaker": "九郎",
   "jp": "「これで良いんだって、分かってるんだけどな」\n\n　やれやれ。結局、おセンチになっちまった。こういうのは俺の〈キャラクター〉性格には似合わないんだが。",
   "cells": [
    {
     "sid": "da0102:T00140",
     "kind": "본문",
     "jp": "「これで良いんだって、分かってるんだけどな」\n\n　やれやれ。結局、おセンチになっちまった。",
     "ko": "「이걸로 된 거란 건, 알고 있는데 말이야」\n\n　원 참. 결국 센티멘털해져 버렸다."
    },
    {
     "sid": "da0102:T00141",
     "kind": "본문",
     "jp": "こういうのは俺の",
     "ko": "이런 건 내 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00014",
     "kind": "루비 읽기",
     "jp": "キャラクター",
     "ko": "캐릭터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00142",
     "kind": "본문",
     "jp": "性格",
     "ko": "성격",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00143",
     "kind": "본문",
     "jp": "には似合わないんだが。",
     "ko": "에는 안 어울리는데."
    }
   ]
  },
  {
   "uid": "da0102:U00086",
   "speaker": "アル",
   "jp": "「不安にならずとも良い」",
   "cells": [
    {
     "sid": "da0102:T00144",
     "kind": "본문",
     "jp": "「不安にならずとも良い」",
     "ko": "「불안해하지 않아도 된다」"
    }
   ]
  },
  {
   "uid": "da0102:U00087",
   "speaker": "九郎",
   "jp": "「あっ……」湯船の中、アルはそっと俺の手を握る。小さくて華奢な指が、俺の指と絡まり合う。優しく、静かな……だけど確かな口調で告げる。",
   "cells": [
    {
     "sid": "da0102:T00145",
     "kind": "본문",
     "jp": "「あっ……」",
     "ko": "「앗……」"
    },
    {
     "sid": "da0102:T00146",
     "kind": "본문",
     "jp": "湯船の中、アルはそっと俺の手を握る。",
     "ko": "욕조 안에서, 알은 살며시 내 손을 잡는다."
    },
    {
     "sid": "da0102:T00147",
     "kind": "본문",
     "jp": "小さくて華奢な指が、俺の指と絡まり合う。",
     "ko": "작고 가녀린 손가락이, 내 손가락과 얽혀 든다."
    },
    {
     "sid": "da0102:T00148",
     "kind": "본문",
     "jp": "優しく、静かな……だけど確かな口調で告げる。",
     "ko": "다정하고, 조용한…… 하지만 분명한 어조로 말한다."
    }
   ]
  },
  {
   "uid": "da0102:U00088",
   "speaker": "アル",
   "jp": "「妾はちゃんと、此処に居る」",
   "cells": [
    {
     "sid": "da0102:T00149",
     "kind": "본문",
     "jp": "「妾はちゃんと、此処に居る」",
     "ko": "「이 몸은 분명히, 이곳에 있다」"
    }
   ]
  },
  {
   "uid": "da0102:U00089",
   "speaker": "九郎",
   "jp": "「……そうだな」\n\n\n　俺たちは一度別れ、だが再び〈めぐ〉廻り逢った。この小さな掌を、もう二度と離すまい。\n\n　そう。俺たちはずっと、ふたりで歩んでゆく。",
   "cells": [
    {
     "sid": "da0102:T00150",
     "kind": "본문",
     "jp": "「……そうだな」\n\n\n　俺たちは一度別れ、だが再び",
     "ko": "「……그러게」\n\n\n　우리는 한 번 헤어졌지만, 다시금 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00015",
     "kind": "루비 읽기",
     "jp": "めぐ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00151",
     "kind": "본문",
     "jp": "廻",
     "ko": "만",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00152",
     "kind": "본문",
     "jp": "り逢った。",
     "ko": "났다."
    },
    {
     "sid": "da0102:T00153",
     "kind": "본문",
     "jp": "この小さな掌を、もう二度と離すまい。\n\n　そう。",
     "ko": "이 작은 손바닥을, 두 번 다시 놓지 않으리라.\n\n　그래."
    },
    {
     "sid": "da0102:T00154",
     "kind": "본문",
     "jp": "俺たちはずっと、ふたりで歩んでゆく。",
     "ko": "우리는 언제까지나, 둘이서 걸어간다."
    }
   ]
  },
  {
   "uid": "da0102:U00090",
   "speaker": "アナザーブラッド",
   "jp": "「大十字九郎……アル・アジフ」",
   "cells": [
    {
     "sid": "da0102:T00155",
     "kind": "본문",
     "jp": "「大十字九郎……アル・アジフ」",
     "ko": "「다이쥬지 쿠로…… 알 아지프」"
    }
   ]
  }
 ]
}