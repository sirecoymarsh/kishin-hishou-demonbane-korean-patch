    {
     "sid": "da0105:T00060",
     "kind": "본문",
     "jp": "さらに続けて印を結ぶ。",
     "ko": "나아가 연이어 인을 맺는다."
    }
   ]
  },
  {
   "uid": "da0105:U00021",
   "speaker": "シュリュズベリイ",
   "jp": "「吹き荒め、険悪にして〈きゅうきょく〉窮極の風よ！ハスターの爪、受けるが良い！」",
   "cells": [
    {
     "sid": "da0105:T00061",
     "kind": "본문",
     "jp": "「吹き荒め、険悪にして",
     "ko": "「휘몰아쳐라, 험악한 ",
     "ruby_edge": "뒤"
