{
 "packet": "P0007_da0105",
 "units": [
  {
   "uid": "da0105:U00001",
   "speaker": "(지문)",
   "jp": "〈ゴーストタウン〉眠る街の静寂を、〈ソニックブーム〉衝撃波が引き裂いた。高層ビルの窓ガラスが一斉に砕け、眼下の街へと雪のように\n舞い散る。",
   "cells": [
    {
     "sid": "da0105:R00001",
     "kind": "루비 읽기",
     "jp": "ゴーストタウン",
     "ko": "고스트 타운",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00001",
     "kind": "본문",
     "jp": "眠る街",
     "ko": "잠든 거리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00002",
     "kind": "본문",
     "jp": "の静寂を、",
     "ko": "의 정적을, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00002",
     "kind": "루비 읽기",
     "jp": "ソニックブーム",
     "ko": "소닉붐이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00003",
     "kind": "본문",
     "jp": "衝撃波",
     "ko": "충격파가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00004",
     "kind": "본문",
     "jp": "が引き裂いた。",
     "ko": " 찢어 놓았다."
    },
    {
     "sid": "da0105:T00005",
     "kind": "본문",
     "jp": "高層ビルの窓ガラスが一斉に砕け、眼下の街へと雪のように\n舞い散る。",
     "ko": "고층 빌딩의 유리창이 일제히 부서지며, 아래쪽 거리로 눈처럼\n흩날린다."
    }
   ]
  },
  {
   "uid": "da0105:U00002",
   "speaker": "(지문)",
   "jp": "だが、たとえ空を見上げる者がいようとも、既にそこには何も無い。あるのはただ、取り残された風ばかり。\n\n　超音速の世界。大気が兇悪な質量を持って、襲いかかる領域。音すら阻む風の壁を通して、彼の声は彼女に届く。",
   "cells": [
    {
     "sid": "da0105:T00006",
     "kind": "본문",
     "jp": "だが、たとえ空を見上げる者がいようとも、既にそこには何も無い。",
     "ko": "하지만, 설령 하늘을 올려다보는 자가 있다 한들, 이미 그곳에는 아무것도 없다."
    },
    {
     "sid": "da0105:T00007",
     "kind": "본문",
     "jp": "あるのはただ、取り残された風ばかり。\n\n　超音速の世界。",
     "ko": "있는 것은 오직, 남겨진 바람뿐.\n\n　초음속의 세계."
    },
    {
     "sid": "da0105:T00008",
     "kind": "본문",
     "jp": "大気が兇悪な質量を持って、襲いかかる領域。",
     "ko": "대기가 흉악한 질량을 품고, 덮쳐 오는 영역."
    },
    {
     "sid": "da0105:T00009",
     "kind": "본문",
     "jp": "音すら阻む風の壁を通して、彼の声は彼女に届く。",
     "ko": "소리마저 가로막는 바람의 벽을 넘어, 그의 목소리는 그녀에게 닿는다."
    }
   ]
  },
  {
   "uid": "da0105:U00003",
   "speaker": "シュリュズベリイ",
   "jp": "「レディ、このままでは逃げられるぞ」",
   "cells": [
    {
     "sid": "da0105:T00010",
     "kind": "본문",
     "jp": "「レディ、このままでは逃げられるぞ」",
     "ko": "「레이디, 이대로는 놓치겠군」"
    }
   ]
  },
  {
   "uid": "da0105:U00004",
   "speaker": "(지문)",
   "jp": "衝撃波を引き連れ、疾る飛行体。それは異形の生命と異界の科学が生んだ落とし子だった。",
   "cells": [
    {
     "sid": "da0105:T00011",
     "kind": "본문",
     "jp": "衝撃波を引き連れ、疾る飛行体。",
     "ko": "충격파를 거느리고, 질주하는 비행체."
    },
    {
     "sid": "da0105:T00012",
     "kind": "본문",
     "jp": "それは異形の生命と異界の科学が生んだ落とし子だった。",
     "ko": "그것은 이형의 생명과 이계의 과학이 낳은 사생아였다."
    }
   ]
  },
  {
   "uid": "da0105:U00005",
   "speaker": "(지문)",
   "jp": "そしてその背に乗り、超音速の暴力に生身を晒す男がいる。既に老齢に達しているだろう男だった。しかしそれを全く感じさせないほどの気力に満ちている。\n\n　精悍な顔つき。しかし目元は〈サングラス〉黒眼鏡に隠され、表情が判別し難い。",
   "cells": [
    {
     "sid": "da0105:T00013",
     "kind": "본문",
     "jp": "そしてその背に乗り、超音速の暴力に生身を晒す男がいる。",
     "ko": "그리고 그 등에 올라타, 초음속의 폭력에 맨몸을 드러낸 남자가 있다."
    },
    {
     "sid": "da0105:T00014",
     "kind": "본문",
     "jp": "既に老齢に達しているだろう男だった。",
     "ko": "이미 노령에 접어들었을 남자였다."
    },
    {
     "sid": "da0105:T00015",
     "kind": "본문",
     "jp": "しかしそれを全く感じさせないほどの気力に満ちている。\n\n　精悍な顔つき。",
     "ko": "그러나 그것을 전혀 느낄 수 없을 만큼 기력이 넘친다.\n\n　다부진 생김새."
    },
    {
     "sid": "da0105:T00016",
     "kind": "본문",
     "jp": "しかし目元は",
     "ko": "그러나 눈매는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00003",
     "kind": "루비 읽기",
     "jp": "サングラス",
     "ko": "선글라스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00017",
     "kind": "본문",
     "jp": "黒眼鏡",
     "ko": "검은 안경",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00018",
     "kind": "본문",
     "jp": "に隠され、表情が判別し難い。",
     "ko": "에 가려져, 표정을 분간하기 어렵다."
    }
   ]
  },
  {
   "uid": "da0105:U00006",
   "speaker": "(지문)",
   "jp": "果たして如何なる理論が、彼をこの爆速の中で生かすのか。速度はなおも増し、迸る衝撃波はビルを砕く。",
   "cells": [
    {
     "sid": "da0105:T00019",
     "kind": "본문",
     "jp": "果たして如何なる理論が、彼をこの爆速の中で生かすのか。",
     "ko": "과연 어떠한 이론이 이 폭발적인 속도에서도 그를 살아 있게 하는가."
    },
    {
     "sid": "da0105:T00020",
     "kind": "본문",
     "jp": "速度はなおも増し、迸る衝撃波はビルを砕く。",
     "ko": "속도는 더욱 빨라지고, 뿜어져 나오는 충격파는 빌딩을 부순다."
    }
   ]
  },
  {
   "uid": "da0105:U00007",
   "speaker": "(지문)",
   "jp": "だが、その超音速を超えて、彼らの先を〈はし〉飛翔る物体がある。",
   "cells": [
    {
     "sid": "da0105:T00021",
     "kind": "본문",
     "jp": "だが、その超音速を超えて、彼らの先を",
     "ko": "허나, 그 초음속을 넘어, 그들의 앞을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00004",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "달리",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00022",
     "kind": "본문",
     "jp": "飛翔",
     "ko": "비상하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00023",
     "kind": "본문",
     "jp": "る物体がある。",
     "ko": "는 물체가 있다."
    }
   ]
  },
  {
   "uid": "da0105:U00008",
   "speaker": "(지문)",
   "jp": "摩天楼の空に刻む、紅い光線。あるときは直線、あるときは曲線、物理法則を無視した機動で追跡者を翻弄する。\n\n　その正体は、ここ数週間に渡り、アーカムシティを騒がせて\nいる怪異だ。",
   "cells": [
    {
     "sid": "da0105:T00024",
     "kind": "본문",
     "jp": "摩天楼の空に刻む、紅い光線。",
     "ko": "마천루의 하늘에 새겨지는, 붉은 광선."
    },
    {
     "sid": "da0105:T00025",
     "kind": "본문",
     "jp": "あるときは直線、あるときは曲線、物理法則を無視した機動で追跡者を翻弄する。\n\n　その正体は、ここ数週間に渡り、アーカムシティを騒がせて\nいる怪異だ。",
     "ko": "어느 때는 직선, 어느 때는 곡선, 물리법칙을 무시한 기동으로 추적자를 농락한다.\n\n　그 정체는, 요 몇 주에 걸쳐, 아컴 시티를 떠들썩하게 만들고\n있는 괴이다."
    }
   ]
  },
  {
   "uid": "da0105:U00009",
   "speaker": "(지문)",
   "jp": "そしてそれを追う者は、〈ハンター〉狩猟者だ。〈アザトース〉字祷子を読み解き、光を超えて〈アヱテュル〉霊子の〈そら〉海を往く、〈あんこく〉闇黒の賢者に\nして狩人。",
   "cells": [
    {
     "sid": "da0105:T00026",
     "kind": "본문",
     "jp": "そしてそれを追う者は、",
     "ko": "그리고 그것을 쫓는 자는, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00005",
     "kind": "루비 읽기",
     "jp": "ハンター",
     "ko": "헌터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00027",
     "kind": "본문",
     "jp": "狩猟者",
     "ko": "수렵자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00028",
     "kind": "본문",
     "jp": "だ。",
     "ko": "다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00006",
     "kind": "루비 읽기",
     "jp": "アザトース",
     "ko": "아자토스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00029",
     "kind": "본문",
     "jp": "字祷子",
     "ko": "자도자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00030",
     "kind": "본문",
     "jp": "を読み解き、光を超えて",
     "ko": "를 해독하고, 빛을 넘어 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00007",
     "kind": "루비 읽기",
     "jp": "アヱテュル",
     "ko": "아이테르",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00031",
     "kind": "본문",
     "jp": "霊子",
     "ko": "영자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00032",
     "kind": "본문",
     "jp": "の",
     "ko": "의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00008",
     "kind": "루비 읽기",
     "jp": "そら",
     "ko": "하늘을",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00033",
     "kind": "본문",
     "jp": "海",
     "ko": "바다를",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00034",
     "kind": "본문",
     "jp": "を往く、",
     "ko": " 누비는, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0105:R00009",
     "kind": "루비 읽기",
     "jp": "あんこく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00035",
     "kind": "본문",
     "jp": "闇黒",
     "ko": "암흑",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0105:T00036",
     "kind": "본문",
     "jp": "の賢者に\nして狩人。",
     "ko": "의 현자이자 사냥꾼."
    }
   ]
  },
  {
   "uid": "da0105:U00010",
   "speaker": "ハヅキ",
   "jp": "「分かっている」",
   "cells": [
    {
     "sid": "da0105:T00037",
     "kind": "본문",
     "jp": "「分かっている」",
     "ko": "「알고 있어」"
    }
   ]
  },
  {
   "uid": "da0105:U00011",
   "speaker": "(지문)",
   "jp": "何処からともなく、彼女の声が返る。その声はやはり、音速の壁に遮られることはない。",
   "cells": [
    {
     "sid": "da0105:T00038",
     "kind": "본문",
     "jp": "何処からともなく、彼女の声が返る。",
     "ko": "어디선가, 그녀의 목소리가 돌아온다."
    },
    {
     "sid": "da0105:T00039",
     "kind": "본문",
     "jp": "その声はやはり、音速の壁に遮られることはない。",
     "ko": "그 목소리는 역시나, 음속의 벽에 가로막히는 일이 없다."
    }
   ]
  },
  {
   "uid": "da0105:U00012",
   "speaker": "ハヅキ",
   "jp": "「本気を出すよ。\n　振り落とされないでね」",
   "cells": [
    {
     "sid": "da0105:T00040",
     "kind": "본문",
     "jp": "「本気を出すよ。\n　振り落とされないでね」",
     "ko": "「전력으로 갈게.\n　떨어지지 마」"
    }
   ]
  },
  {
   "uid": "da0105:U00013",
   "speaker": "シュリュズベリイ",
   "jp": "「蜂蜜酒は飲んでいる。\n　思いっきりやりたまえ」",
   "cells": [
    {
     "sid": "da0105:T00041",
     "kind": "본문",
     "jp": "「蜂蜜酒は飲んでいる。\n　思いっきりやりたまえ」",
     "ko": "「벌꿀술은 마셔 두었다.\n　마음껏 해 보게」"
    }
   ]
  },
  {
   "uid": "da0105:U00014",
   "speaker": "ハヅキ",
   "jp": "「Ｙｅｓ，Ｄａｄｄｙ」",
   "cells": [
    {
     "sid": "da0105:T00042",
     "kind": "본문",
     "jp": "「Ｙｅｓ，Ｄａｄｄｙ」",
     "ko": "「Ｙｅｓ，Ｄａｄｄｙ」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0105:U00015",
   "speaker": "(지문)",
   "jp": "飛行体の後部、魔力エンジンであるフーン機関が唸りを上げる。それは圧縮された情報、一音節ごとに超高密度の魔術的『意味』を詰め込まれた言語は悲鳴となり、常人の識閾を超え、蛮名化する。\n\n　霊子の吸引→魔術的定義の圧縮→魔力燃焼→排気／爆発＝物理的／概念的に。\n\n　次の瞬間、賢者を乗せた飛行体は光となった。",
   "cells": [
    {
     "sid": "da0105:T00043",
     "kind": "본문",
     "jp": "飛行体の後部、魔力エンジンであるフーン機関が唸りを上げる。",
     "ko": "비행체의 후부, 마력 엔진인 훈 기관이 굉음을 올린다."
    },
    {
     "sid": "da0105:T00044",
     "kind": "본문",
     "jp": "それは圧縮された情報、一音節ごとに超高密度の魔術的『意味』を詰め込まれた言語は悲鳴となり、常人の識閾を超え、蛮名化する。\n\n　霊子の吸引→",
     "ko": "그것은 압축된 정보다. 한 음절마다 초고밀도의 마술적 『의미』가 채워진 언어가 비명으로 변해, 보통 사람의 식역을 넘어 만명화한다.\n\n　영자의 흡인→"
    },
    {
     "sid": "da0105:T00045",
     "kind": "본문",
     "jp": "魔術的定義の圧縮→",
     "ko": "마술적 정의의 압축→"
    },
    {
     "sid": "da0105:T00046",
     "kind": "본문",
     "jp": "魔力燃焼→",
     "ko": "마력 연소→"
    },
    {
     "sid": "da0105:T00047",
     "kind": "본문",
     "jp": "排気／爆発",
     "ko": "배기／폭발"
    },
    {
     "sid": "da0105:T00048",
     "kind": "본문",
     "jp": "＝物理的／概念的に。\n\n　次の瞬間、賢者を乗せた飛行体は光となった。",
     "ko": "＝물리적／개념적으로.\n\n　다음 순간, 현자를 태운 비행체는 빛이 되었다."
    }
   ]
  },
  {
   "uid": "da0105:U00016",
   "speaker": "(지문)",
   "jp": "時間を切り取ったかのように、\n紅い光線の行く先に飛行体が現出した。",
   "cells": [
    {
     "sid": "da0105:T00049",
     "kind": "본문",
     "jp": "時間を切り取ったかのように、\n紅い光線の行く先に飛行体が現出した。",
     "ko": "시간을 잘라 낸 것처럼,\n붉은 광선이 향하는 앞길에 비행체가 현출했다."
    }
