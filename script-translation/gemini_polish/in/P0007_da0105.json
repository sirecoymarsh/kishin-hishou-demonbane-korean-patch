     "kind": "루비 읽기",
     "jp": "エルダーサイン",
     "ko": "엘더 사인",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00056",
     "kind": "본문",
     "jp": "五芒星形の印",
     "ko": "오망성형의 인",
     "ruby_edge": "앞"
    },
    {
