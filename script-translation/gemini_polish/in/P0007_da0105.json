    {
     "sid": "da0105:R00013",
     "kind": "루비 읽기",
     "jp": "きゅうきょく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0105:T00062",
     "kind": "본문",
     "jp": "窮極",
     "ko": "궁극",
