    }
   ]
  },
  {
   "uid": "da0120ed:U00029",
   "speaker": "(지문)",
   "jp": "エントリーNo.997『では次に――御伽噺をしよう』",
   "cells": [
    {
     "sid": "da0120ed:T00060",
     "kind": "본문",
     "jp": "エントリーNo.997",
     "ko": "엔트리 No.997"
    },
    {
     "sid": "da0120ed:T00061",
     "kind": "본문",
     "jp": "『では次に――御伽噺をしよう』",
     "ko": "『그럼 다음으로――옛날이야기를 하지』"
    }
   ]
  },
  {
   "uid": "da0120ed:U00030",
   "speaker": "(지문)",
   "jp": "とおい、とおい、むかし。はるか昔のおはなし。最初の人間が生まれるよりも、\n　さらに前のおはなしです。",
   "cells": [
    {
     "sid": "da0120ed:T00062",
     "kind": "본문",
     "jp": "とおい、とおい、むかし。",
     "ko": "머나먼, 머나먼, 옛날."
    },
    {
     "sid": "da0120ed:T00063",
     "kind": "본문",
     "jp": "はるか昔のおはなし。",
     "ko": "아득히 먼 옛날의 이야기."
    },
    {
     "sid": "da0120ed:T00064",
     "kind": "본문",
     "jp": "最初の人間が生まれるよりも、\n　さらに前のおはなしです。",
     "ko": "최초의 인간이 태어나기보다도,\n　더욱 전의 이야기입니다."
    }
   ]
  },
  {
   "uid": "da0120ed:U00031",
   "speaker": "(지문)",
   "jp": "〈くら〉冥い冥い星々の向こうから、生まれたばかりの地球に『ぐれーと・おーるど・わん』と呼ばれる悪い神様たちがやってきました。\n\n　悪い神様たちは好き勝手に暴れて、地球に生きるみんなを苦しめました。\n\n　みんなみんな、泣きました。地球も、痛い痛いと泣きました。\n\n　だけどそのとき、空が輝きました。誰もが、空を見上げました。そして、誰もがそれを見ました。\n\n　――善い神様が、舞い降りたのです。",
   "cells": [
    {
     "sid": "da0120ed:R00001",
     "kind": "루비 읽기",
     "jp": "くら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0120ed:T00065",
     "kind": "본문",
     "jp": "冥",
     "ko": "어두",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0120ed:T00066",
     "kind": "본문",
     "jp": "い冥い星々の向こうから、生まれたばかりの地球に『ぐれーと・おーるど・わん』と呼ばれる悪い神様たちがやってきました。\n\n　悪い神様たちは好き勝手に暴れて、地球に生きるみんなを苦しめました。\n\n　みんなみんな、泣きました。",
     "ko": "운 어두운 별들 너머에서, 막 태어난 지구에 『그레이트 올드 원』이라 불리는 나쁜 신님들이 찾아왔습니다.\n\n　나쁜 신님들은 제멋대로 날뛰며 지구에 살아가는 모두를 괴롭혔습니다.\n\n　모두 모두, 울었습니다."
    },
    {
     "sid": "da0120ed:T00067",
     "kind": "본문",
     "jp": "地球も、痛い痛いと泣きました。\n\n　だけどそのとき、空が輝きました。",
     "ko": "지구도, 아프다 아프다며 울었습니다.\n\n　하지만 그때, 하늘이 빛났습니다."
    },
    {
     "sid": "da0120ed:T00068",
     "kind": "본문",
     "jp": "誰もが、空を見上げました。",
     "ko": "누구나가, 하늘을 올려다보았습니다."
    },
    {
     "sid": "da0120ed:T00069",
     "kind": "본문",
     "jp": "そして、誰もがそれを見ました。\n\n　――善い神様が、舞い降りたのです。",
     "ko": "그리고, 누구나가 그것을 보았습니다.\n\n　――착한 신님이, 내려오신 것입니다."
    }
   ]
  },
  {
   "uid": "da0120ed:U00032",
   "speaker": "ナイア",
   "jp": "「まさか――こんな世界にまで、やって来るとはね」",
   "cells": [
    {
     "sid": "da0120ed:T00070",
     "kind": "본문",
     "jp": "「まさか――こんな世界にまで、やって来るとはね」",
     "ko": "「설마――이런 세계에까지 찾아올 줄이야」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00033",
   "speaker": "ナイア",
   "jp": "「ヒトとして戦い、戦い抜いて、ヒトを超え、ヒトを棄て、遂に神の領域に辿り着いたか！　邪悪を討ち滅ぼす為に、私と同じ〈モノ〉存在になったか！」",
   "cells": [
    {
     "sid": "da0120ed:T00071",
     "kind": "본문",
     "jp": "「ヒトとして戦い、戦い抜いて、ヒトを超え、ヒトを棄て、遂に神の領域に辿り着いたか！　邪悪を討ち滅ぼす為に、私と同じ",
     "ko": "「인간으로서 싸우고, 끝까지 싸워 내어, 인간을 넘어, 인간을 버리고, 마침내 신의 영역에 도달했는가!　사악을 토벌해 멸하기 위해, 나와 같은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0120ed:R00002",
     "kind": "루비 읽기",
     "jp": "モノ",
     "ko": "것이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0120ed:T00072",
     "kind": "본문",
     "jp": "存在",
     "ko": "존재가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0120ed:T00073",
     "kind": "본문",
     "jp": "になったか！」",
     "ko": " 되었는가!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00034",
   "speaker": "ドクター・ウェスト",
   "jp": "「一緒にするなであーる！」",
   "cells": [
    {
     "sid": "da0120ed:T00074",
     "kind": "본문",
     "jp": "「一緒にするなであーる！」",
     "ko": "「같은 부류로 취급하지 말라는 것이다아!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00035",
   "speaker": "エルザ",
   "jp": "「同類にされては、すっげー不愉快ロボ！」",
   "cells": [
    {
     "sid": "da0120ed:T00075",
     "kind": "본문",
     "jp": "「同類にされては、すっげー不愉快ロボ！」",
     "ko": "「동류 취급당하다니 엄청 불쾌해로보!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00036",
   "speaker": "(지문)",
   "jp": "それは刹那の愛を紡いで、永遠の時を刻み続ける――",
   "cells": [
    {
     "sid": "da0120ed:T00076",
     "kind": "본문",
     "jp": "それは刹那の愛を紡いで、永遠の時を刻み続ける――",
     "ko": "그것은 찰나의 사랑을 자아내어, 영원의 시간을 계속해서 새기는――"
    }
   ]
  },
  {
   "uid": "da0120ed:U00037",
   "speaker": "(지문)",
   "jp": "いのちの歌。",
   "cells": [
    {
     "sid": "da0120ed:T00077",
     "kind": "본문",
     "jp": "いのちの歌。",
     "ko": "생명의 노래."
    }
   ]
  },
  {
   "uid": "da0120ed:U00038",
   "speaker": "エンネア",
   "jp": "「orz」",
   "cells": [
    {
     "sid": "da0120ed:T00078",
     "kind": "본문",
     "jp": "「orz」",
     "ko": "「orz」",
     "lock": "한글 없는 칸"
    }
   ]
  }
 ]
}