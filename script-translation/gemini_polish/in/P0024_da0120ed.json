{
 "packet": "P0024_da0120ed",
 "units": [
  {
   "uid": "da0120ed:U00001",
   "speaker": "アナザーブラッド",
   "jp": "「……どうして？」",
   "cells": [
    {
     "sid": "da0120ed:T00001",
     "kind": "본문",
     "jp": "「……どうして？」",
     "ko": "「……어째서?」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00002",
   "speaker": "九郎＆アル",
   "jp": "「…………………………………………」",
   "cells": [
    {
     "sid": "da0120ed:T00002",
     "kind": "본문",
     "jp": "「…………………………………………」",
     "ko": "「…………………………………………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0120ed:U00003",
   "speaker": "ドクター・ウェスト",
   "jp": "「我輩は……勝ったッ！」",
   "cells": [
    {
     "sid": "da0120ed:T00003",
     "kind": "본문",
     "jp": "「我輩は……",
     "ko": "「본인은…… "
    },
    {
     "sid": "da0120ed:T00004",
     "kind": "본문",
     "jp": "勝ったッ！」",
     "ko": "이겼다앗!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00004",
   "speaker": "エルザ",
   "jp": "「これでアーカムシティも平和になるロボ」",
   "cells": [
    {
     "sid": "da0120ed:T00005",
     "kind": "본문",
     "jp": "「これでアーカムシティも平和になるロボ」",
     "ko": "「이걸로 아컴 시티도 평화로워질 거예요로보」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00005",
   "speaker": "(지문)",
   "jp": "そうか？",
   "cells": [
    {
     "sid": "da0120ed:T00006",
     "kind": "본문",
     "jp": "そうか？",
     "ko": "그런가?"
    }
   ]
  },
  {
   "uid": "da0120ed:U00006",
   "speaker": "ドクター・ウェスト",
   "jp": "「しかし、どうしてかな……我輩の胸には乾いた風ばかりが吹き抜けていきやがる……」",
   "cells": [
    {
     "sid": "da0120ed:T00007",
     "kind": "본문",
     "jp": "「しかし、どうしてかな……我輩の胸には乾いた風ばかりが吹き抜けていきやがる……」",
     "ko": "「하지만 어째서일까나…… 본인의 가슴에는 메마른 바람만이 스쳐 지나가 버리는군……」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00007",
   "speaker": "エルザ",
   "jp": "「戦いは虚しいロボ……」",
   "cells": [
    {
     "sid": "da0120ed:T00008",
     "kind": "본문",
     "jp": "「戦いは虚しいロボ……」",
     "ko": "「싸움은 허무해요로보……」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00008",
   "speaker": "九郎",
   "jp": "「同感だ」",
   "cells": [
    {
     "sid": "da0120ed:T00009",
     "kind": "본문",
     "jp": "「同感だ」",
     "ko": "「동감이다」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00009",
   "speaker": "アル",
   "jp": "「おい……これ、どうやってオチをつけるつもりだ？」",
   "cells": [
    {
     "sid": "da0120ed:T00010",
     "kind": "본문",
     "jp": "「おい……これ、どうやってオチをつけるつもりだ？」",
     "ko": "「어이…… 이거, 어떻게 마무리 지을 생각이냐?」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00010",
   "speaker": "ナイア",
   "jp": "「想定外の事態が発生したため、これ以降の展開は用意されておりません」",
   "cells": [
    {
     "sid": "da0120ed:T00011",
     "kind": "본문",
     "jp": "「想定外の事態が発生したため、これ以降の展開は用意されておりません」",
     "ko": "「상정 외의 사태가 발생하였으므로, 이 이후의 전개는 준비되어 있지 않습니다」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00011",
   "speaker": "ナイア",
   "jp": "「『納得いかない！』とお怒りのお客様につきましては、次の中からお好みのエンディングをご自由にお選びください」",
   "cells": [
    {
     "sid": "da0120ed:T00012",
     "kind": "본문",
     "jp": "「『納得いかない！』とお怒りのお客様につきましては、次の中からお好みのエンディングをご自由にお選びください」",
     "ko": "「『납득할 수 없어!』라며 분노하시는 고객님께서는, 다음 중에서 마음에 드시는 엔딩을 자유롭게 선택해 주십시오」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00012",
   "speaker": "(지문)",
   "jp": "エントリーNo.001『戦いはこれからだ』」",
   "cells": [
    {
     "sid": "da0120ed:T00013",
     "kind": "본문",
     "jp": "エントリーNo.001",
     "ko": "엔트리 No.001"
    },
    {
     "sid": "da0120ed:T00014",
     "kind": "본문",
     "jp": "『戦いはこれからだ』」",
     "ko": "『싸움은 지금부터다』」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00013",
   "speaker": "九朔",
   "jp": "「ふははは！　地球のロボットもなかなかにやるではないか！」",
   "cells": [
    {
     "sid": "da0120ed:T00015",
     "kind": "본문",
     "jp": "「ふははは！　地球のロボットもなかなかにやるではないか！」",
     "ko": "「후하하하!　지구의 로봇도 제법 하는구나!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00014",
   "speaker": "九朔",
   "jp": "「しかし貴様が倒したアナザーブラッドは、我らグリュ＝ヴォ５１２傑の中で最も格下！」",
   "cells": [
    {
     "sid": "da0120ed:T00016",
     "kind": "본문",
     "jp": "「しかし貴様が倒したアナザーブラッドは、",
     "ko": "「허나 네놈이 쓰러뜨린 어나더 블러드는, "
    },
    {
     "sid": "da0120ed:T00017",
     "kind": "본문",
     "jp": "我らグリュ＝ヴォ５１２傑の中で最も格下！」",
     "ko": "우리 그류=보 512걸 중에서 가장 말석!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00015",
   "speaker": "ドクター・ウェスト",
   "jp": "「ふん、面白い！　エルザぁぁぁっ！」",
   "cells": [
    {
     "sid": "da0120ed:T00018",
     "kind": "본문",
     "jp": "「ふん、面白い！　エルザぁぁぁっ！」",
     "ko": "「흥, 재미있군!　엘자아아앗!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00016",
   "speaker": "エルザ",
   "jp": "「無敵ロボ、征っけぇぇぇぇ――――ッ！」",
   "cells": [
    {
     "sid": "da0120ed:T00019",
     "kind": "본문",
     "jp": "「無敵ロボ、征っけぇぇぇぇ――――ッ！」",
     "ko": "「무적로보, 가라아아아아――――앗!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00017",
   "speaker": "(지문)",
   "jp": "次回作にご期待ください。",
   "cells": [
    {
     "sid": "da0120ed:T00020",
     "kind": "본문",
     "jp": "次回作にご期待ください",
     "ko": "차기작을 기대해 주십시오"
    },
    {
     "sid": "da0120ed:T00021",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0120ed:U00018",
   "speaker": "(지문)",
   "jp": "エントリーNo.002『青空に死んだ仲間の笑顔』",
   "cells": [
    {
     "sid": "da0120ed:T00022",
     "kind": "본문",
     "jp": "エントリーNo.002",
     "ko": "엔트리 No.002"
    },
    {
     "sid": "da0120ed:T00023",
     "kind": "본문",
     "jp": "『青空に死んだ仲間の笑顔』",
     "ko": "『푸른 하늘에 죽은 동료의 미소』"
    }
   ]
  },
  {
   "uid": "da0120ed:U00019",
   "speaker": "エルザ",
   "jp": "「博士ーっ！\n　早くしないと置いてくロボよ～っ！」",
   "cells": [
    {
     "sid": "da0120ed:T00024",
     "kind": "본문",
     "jp": "「博士ーっ！\n　早くしないと置いてくロボよ～っ！」",
     "ko": "「박사니임~!\n　빨리 안 오시면 두고 갈 거예요로보~!」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00020",
   "speaker": "ドクター・ウェスト",
   "jp": "「やれやれ。仕方ない奴であるな、エルザは」",
   "cells": [
    {
     "sid": "da0120ed:T00025",
     "kind": "본문",
     "jp": "「やれやれ。仕方ない奴であるな、エルザは」",
     "ko": "「이런이런. 못 말리는 녀석인 것이다, 엘자는」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00021",
   "speaker": "(지문)",
   "jp": "……ウェスト。",
   "cells": [
    {
     "sid": "da0120ed:T00026",
     "kind": "본문",
     "jp": "……ウェスト。",
     "ko": "……웨스트."
    }
   ]
  },
  {
   "uid": "da0120ed:U00022",
   "speaker": "ドクター・ウェスト",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da0120ed:T00027",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0120ed:U00023",
   "speaker": "アウグストゥス",
   "jp": "「今、幸せかい……？」",
   "cells": [
    {
     "sid": "da0120ed:T00028",
     "kind": "본문",
     "jp": "「今、幸せかい……？」",
     "ko": "「지금, 행복하니……?」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00024",
   "speaker": "ドクター・ウェスト",
   "jp": "「……ああ。ありがとう」",
   "cells": [
    {
     "sid": "da0120ed:T00029",
     "kind": "본문",
     "jp": "「……ああ。ありがとう」",
     "ko": "「……그래. 고맙다」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00025",
   "speaker": "(지문)",
   "jp": "エントリーNo.003『犯人はこの中』",
   "cells": [
    {
     "sid": "da0120ed:T00030",
     "kind": "본문",
     "jp": "エントリーNo.003",
     "ko": "엔트리 No.003"
    },
    {
     "sid": "da0120ed:T00031",
     "kind": "본문",
     "jp": "『犯人はこの中』",
     "ko": "『범인은 이 안에』"
    }
   ]
  },
  {
   "uid": "da0120ed:U00026",
   "speaker": "ドクター・ウェスト",
   "jp": "「あなたが――――蜘蛛だったのですね」",
   "cells": [
    {
     "sid": "da0120ed:T00032",
     "kind": "본문",
     "jp": "「あなたが――――",
     "ko": "「당신이――――"
    },
    {
     "sid": "da0120ed:T00033",
     "kind": "본문",
     "jp": "蜘蛛だったのですね」",
     "ko": "거미였군요」"
    }
   ]
  },
  {
   "uid": "da0120ed:U00027",
   "speaker": "(지문)",
   "jp": "エントリーNo.004『俺より強いの』",
   "cells": [
    {
     "sid": "da0120ed:T00034",
     "kind": "본문",
     "jp": "エントリーNo.004",
     "ko": "엔트리 No.004"
    },
    {
     "sid": "da0120ed:T00035",
     "kind": "본문",
     "jp": "『俺より強いの』",
     "ko": "『나보다 강한 녀석』"
    }
   ]
  },
  {
   "uid": "da0120ed:U00028",
   "speaker": "(지문)",
   "jp": "さあひょうしょうしきだなにぃっウェストがいない！",
   "cells": [
    {
