{
 "packet": "P0056_da0501",
 "units": [
  {
   "uid": "da0501:U00071",
   "speaker": "アナザーブラッド",
   "jp": "「先生もですよ？　もう少し\n　　　大人しくしてもらわないと。\n　　　此処は私の『物語』の中\n　　　なんだから」",
   "cells": [
    {
     "sid": "da0501:T00127",
     "kind": "본문",
     "jp": "「先生もですよ？　もう少し\n　　　大人しくしてもらわないと。\n　　　此処は私の『物語』の中\n　　　なんだから」",
     "ko": "「선생님도 마찬가지예요?　조금만 더\n　　　얌전히 계셔 주셔야겠어요.\n　　　여기는 내 『이야기』 속\n　　　이니까요」"
    }
   ]
  },
  {
   "uid": "da0501:U00072",
   "speaker": "ハヅキ",
   "jp": "「……うぅっ！」",
   "cells": [
    {
     "sid": "da0501:T00128",
     "kind": "본문",
     "jp": "「……うぅっ！」",
     "ko": "「……으으윽!」"
    }
   ]
  },
  {
   "uid": "da0501:U00073",
   "speaker": "(지문)",
   "jp": "アンブロシウスもまた、タールの海へと引きずり込まれる。波打ち、脈打つ生きる海面は、２体の〈デウス・マキナ〉鬼械神を完全に呑み込んで\nしまった。",
   "cells": [
    {
     "sid": "da0501:T00129",
     "kind": "본문",
     "jp": "アンブロシウスもまた、タールの海へと引きずり込まれる。",
     "ko": "암브로시우스 또한 타르의 바다로 끌려 들어간다."
    },
    {
     "sid": "da0501:T00130",
     "kind": "본문",
     "jp": "波打ち、脈打つ生きる海面は、２体の",
     "ko": "물결치고 맥박 치는 살아 있는 해면은 2대의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00018",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00131",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00132",
     "kind": "본문",
     "jp": "を完全に呑み込んで\nしまった。",
     "ko": " 완전히 집어삼켜\n버렸다."
    }
   ]
  },
  {
   "uid": "da0501:U00074",
   "speaker": "九郎",
   "jp": "「九朔！　シュリュズベリイ〈センセ〉先生！　ハヅキ！」",
   "cells": [
    {
     "sid": "da0501:T00133",
     "kind": "본문",
     "jp": "「九朔！　シュリュズベリイ",
     "ko": "「쿠자쿠!　슈루즈베리 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00019",
     "kind": "루비 읽기",
     "jp": "センセ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00134",
     "kind": "본문",
     "jp": "先生",
     "ko": "선생",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00135",
     "kind": "본문",
     "jp": "！　ハヅキ！」",
     "ko": "!　하즈키!」"
    }
   ]
  },
  {
   "uid": "da0501:U00075",
   "speaker": "アナザーブラッド",
   "jp": "「さてと……残るは」",
   "cells": [
    {
     "sid": "da0501:T00136",
     "kind": "본문",
     "jp": "「さてと……残るは」",
     "ko": "「자, 그럼…… 남은 건」"
    }
   ]
  },
  {
   "uid": "da0501:U00076",
   "speaker": "(지문)",
   "jp": "少女の視線が俺たちを捉える。〈ね〉睨めつける、蛇の様な瞳は欲情に潤んでいた。",
   "cells": [
    {
     "sid": "da0501:T00137",
     "kind": "본문",
     "jp": "少女の視線が俺たちを捉える。",
     "ko": "소녀의 시선이 우리를 포착한다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00020",
     "kind": "루비 읽기",
     "jp": "ね",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00138",
     "kind": "본문",
     "jp": "睨",
     "ko": "노려보",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00139",
     "kind": "본문",
     "jp": "めつける、蛇の様な瞳は欲情に潤んでいた。",
     "ko": "는 뱀 같은 눈동자는 욕정으로 촉촉이 젖어 있었다."
    }
   ]
  },
  {
   "uid": "da0501:U00077",
   "speaker": "アナザーブラッド",
   "jp": "「あなた方を手に入れるだけよ……」",
   "cells": [
    {
     "sid": "da0501:T00140",
     "kind": "본문",
     "jp": "「あなた方を手に入れるだけよ……」",
     "ko": "「당신들을 손에 넣는 것뿐이야……」"
    }
   ]
  },
  {
   "uid": "da0501:U00078",
   "speaker": "(지문)",
   "jp": "熱い吐息と共に紡ぎ出す。愛の言葉にも似た、〈くら〉冥い妄執を。",
   "cells": [
    {
     "sid": "da0501:T00141",
     "kind": "본문",
     "jp": "熱い吐息と共に紡ぎ出す。",
     "ko": "뜨거운 한숨과 함께 자아낸다."
    },
    {
     "sid": "da0501:T00142",
     "kind": "본문",
     "jp": "愛の言葉にも似た、",
     "ko": "사랑의 밀어와도 닮은, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00021",
     "kind": "루비 읽기",
     "jp": "くら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00143",
     "kind": "본문",
     "jp": "冥",
     "ko": "어두",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00144",
     "kind": "본문",
     "jp": "い妄執を。",
     "ko": "운 망집을."
    }
   ]
  },
  {
   "uid": "da0501:U00079",
   "speaker": "(지문)",
   "jp": "時計塔が激しく揺れる。重い地響きと共に、タールの海が大津波となって押し寄せてきた。波の高さは優に３００メートルを超える。",
   "cells": [
    {
     "sid": "da0501:T00145",
     "kind": "본문",
     "jp": "時計塔が激しく揺れる。",
     "ko": "시계탑이 격렬하게 흔들린다."
    },
    {
     "sid": "da0501:T00146",
     "kind": "본문",
     "jp": "重い地響きと共に、タールの海が大津波となって押し寄せてきた。",
     "ko": "무거운 땅울림과 함께 타르의 바다가 대해일이 되어 밀려들어 왔다."
    },
    {
     "sid": "da0501:T00147",
     "kind": "본문",
     "jp": "波の高さは優に３００メートルを超える。",
     "ko": "파도의 높이는 족히 300미터를 넘는다."
    }
   ]
  },
  {
   "uid": "da0501:U00080",
   "speaker": "九郎",
   "jp": "「……クソッタレ」",
   "cells": [
    {
     "sid": "da0501:T00148",
     "kind": "본문",
     "jp": "「……クソッタレ」",
     "ko": "「……제기랄」"
    }
   ]
  },
  {
   "uid": "da0501:U00081",
   "speaker": "(지문)",
   "jp": "なす術もなく、俺たちは赤黒いタールに呑み込まれた。",
   "cells": [
    {
     "sid": "da0501:T00149",
     "kind": "본문",
     "jp": "なす術もなく、俺たちは赤黒いタールに呑み込まれた。",
     "ko": "손쓸 방도도 없이, 우리는 검붉은 타르에 집어삼켜졌다."
    }
   ]
  }
 ]
}