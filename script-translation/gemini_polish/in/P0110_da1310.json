     "kind": "본문",
     "jp": "。登場人物は皆、",
     "ko": ". 등장인물은 모두, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1310:R00042",
     "kind": "루비 읽기",
     "jp": "はやく",
