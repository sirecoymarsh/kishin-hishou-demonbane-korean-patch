     "kind": "루비 읽기",
     "jp": "か",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1310:T00002",
     "kind": "본문",
     "jp": "斯",
     "ko": "이",
     "ruby_edge": "앞"
