{
 "packet": "P0026_da0202",
 "units": [
  {
   "uid": "da0202:U00001",
   "speaker": "アナザーブラッド",
   "jp": "「これで少しは静かになったわね」",
   "cells": [
    {
     "sid": "da0202:T00001",
     "kind": "본문",
     "jp": "「これで少しは静かになったわね」",
     "ko": "「이걸로 조금은 조용해졌네」"
    }
   ]
  },
  {
   "uid": "da0202:U00002",
   "speaker": "(지문)",
   "jp": "破壊ロボを倒したデモンベインが、再び俺たちの方を向いた。さっきの戦い方を見て、確信した。認めたくない事実だが……こいつは紛れもなくデモンベインだ。",
   "cells": [
    {
     "sid": "da0202:T00002",
     "kind": "본문",
     "jp": "破壊ロボを倒したデモンベインが、再び俺たちの方を向いた。",
     "ko": "파괴로보를 쓰러뜨린 데몬베인이 다시 우리 쪽을 향했다."
    },
    {
     "sid": "da0202:T00003",
     "kind": "본문",
     "jp": "さっきの戦い方を見て、確信した。",
     "ko": "아까 싸우는 방식을 보고 확신했다."
    },
    {
     "sid": "da0202:T00004",
     "kind": "본문",
     "jp": "認めたくない事実だが……こいつは紛れもなくデモンベインだ。",
     "ko": "인정하고 싶지 않은 사실이지만…… 이 녀석은 틀림없는 데몬베인이다."
    }
   ]
  },
  {
   "uid": "da0202:U00003",
   "speaker": "アナザーブラッド",
   "jp": "「改めて、初めまして。\n　大十字九郎様にアル・アジフ様。\n　お逢いできて、とっても光栄だわ」",
   "cells": [
    {
     "sid": "da0202:T00005",
     "kind": "본문",
     "jp": "「改めて、初めまして。\n　大十字九郎様にアル・アジフ様。\n　お逢いできて、とっても光栄だわ」",
     "ko": "「새삼스럽게, 처음 뵙겠어요.\n　다이쥬지 쿠로 님과 알 아지프 님.\n　만나 뵙게 되어 무척 영광이야」"
    }
   ]
  },
  {
   "uid": "da0202:U00004",
   "speaker": "(지문)",
   "jp": "再び少女の声が響き渡る。ちょっと気取った、おしゃまな感じの口調。その無邪気さが逆に不気味だった。",
   "cells": [
    {
     "sid": "da0202:T00006",
     "kind": "본문",
     "jp": "再び少女の声が響き渡る。",
     "ko": "다시 소녀의 목소리가 울려 퍼진다."
    },
    {
     "sid": "da0202:T00007",
     "kind": "본문",
     "jp": "ちょっと気取った、おしゃまな感じの口調。",
     "ko": "조금 새침하고 조숙한 느낌의 말투."
    },
    {
     "sid": "da0202:T00008",
     "kind": "본문",
     "jp": "その無邪気さが逆に不気味だった。",
     "ko": "그 순진무구함이 오히려 섬뜩했다."
    }
   ]
  },
  {
   "uid": "da0202:U00005",
   "speaker": "九郎",
   "jp": "「……てめえが血の化け物どもの親玉か？」",
   "cells": [
    {
     "sid": "da0202:T00009",
     "kind": "본문",
     "jp": "「……てめえが血の化け物どもの親玉か？」",
     "ko": "「……네 녀석이 피의 괴물 놈들의 우두머리냐?」"
    }
   ]
  },
  {
   "uid": "da0202:U00006",
   "speaker": "アナザーブラッド",
   "jp": "「バケモノだなんて酷いわ。\n　もっと可愛い呼び方はないものかしら？」",
   "cells": [
    {
     "sid": "da0202:T00010",
     "kind": "본문",
     "jp": "「バケモノだなんて酷いわ。\n　もっと可愛い呼び方はないものかしら？」",
     "ko": "「괴물이라니 너무해.\n　좀 더 귀여운 호칭은 없는 걸까?」"
    }
   ]
  },
  {
   "uid": "da0202:U00007",
   "speaker": "アル",
   "jp": "「存在しない筈のアンチクロス。\n　そしてデモンベイン！\n　――〈な〉汝は何者ぞ！」",
   "cells": [
    {
     "sid": "da0202:T00011",
     "kind": "본문",
     "jp": "「存在しない筈のアンチクロス。\n　そしてデモンベイン！\n　――",
     "ko": "「존재할 리 없는 안티크로스.\n　그리고 데몬베인!\n　――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00001",
     "kind": "루비 읽기",
     "jp": "な",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00012",
     "kind": "본문",
     "jp": "汝",
     "ko": "그대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00013",
     "kind": "본문",
     "jp": "は何者ぞ！」",
     "ko": "는 정체가 무엇이냐!」"
    }
   ]
  },
  {
   "uid": "da0202:U00008",
   "speaker": "アナザーブラッド",
   "jp": "「判らない？〈・・・・・・・・・〉貴女と同質の存在よ」",
   "cells": [
    {
     "sid": "da0202:T00014",
     "kind": "본문",
     "jp": "「判らない？",
     "ko": "「모르겠어? ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00002",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・",
     "ko": "・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00015",
     "kind": "본문",
     "jp": "貴女と同質の存在よ",
     "ko": "당신과 동질의 존재야",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00016",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0202:U00009",
   "speaker": "アル",
   "jp": "「何だと？」",
   "cells": [
    {
     "sid": "da0202:T00017",
     "kind": "본문",
     "jp": "「何だと？」",
     "ko": "「뭐라?」"
    }
   ]
  },
  {
   "uid": "da0202:U00010",
   "speaker": "アナザーブラッド",
   "jp": "「私は――『ネクロノミコン』。\n　外道の知識の集大成。\n　貴女の〈うつし〉写本よ……〈オリジナル〉お母様」",
   "cells": [
    {
     "sid": "da0202:T00018",
     "kind": "본문",
     "jp": "「私は――『ネクロノミコン』。\n　外道の知識の集大成。\n　貴女の",
     "ko": "「나는―― 『네크로노미콘』.\n　외도의 지식을 집대성한 것.\n　당신의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00003",
     "kind": "루비 읽기",
     "jp": "うつし",
     "ko": "복사본",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00019",
     "kind": "본문",
     "jp": "写本",
     "ko": "사본",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00020",
     "kind": "본문",
     "jp": "よ……",
     "ko": "이야…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00004",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00021",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00022",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0202:U00011",
   "speaker": "九郎",
   "jp": "「『ネクロノミコン』だって！？」",
   "cells": [
    {
     "sid": "da0202:T00023",
     "kind": "본문",
     "jp": "「『ネクロノミコン』だって！？」",
     "ko": "「『네크로노미콘』이라고!?」"
    }
   ]
  },
  {
   "uid": "da0202:U00012",
   "speaker": "アル",
   "jp": "「……〈ざれごと〉戯言を。ギリシャ語版、ラテン語版、不完全な英語版……機械語版などという変種も在ったがな。汝の様な歪んだ術式で編まれた写本など存在せぬわ」",
   "cells": [
    {
     "sid": "da0202:T00024",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0202:R00005",
     "kind": "루비 읽기",
     "jp": "ざれごと",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00025",
     "kind": "본문",
     "jp": "戯言",
     "ko": "헛소리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00026",
     "kind": "본문",
     "jp": "を。ギリシャ語版、ラテン語版、不完全な英語版……機械語版などという変種も在ったがな。汝の様な歪んだ術式で編まれた写本など存在せぬわ」",
     "ko": "를. 그리스어판, 라틴어판, 불완전한 영어판…… 기계어판 따위의 변종도 있었다만. 그대처럼 뒤틀린 술식으로 엮인 사본 따위는 존재치 않는다」"
    }
   ]
  },
  {
   "uid": "da0202:U00013",
   "speaker": "アナザーブラッド",
   "jp": "「それは当然ね。\n　だって私は……〈・・・・・〉存在しない〈・〉『書』だもの」",
   "cells": [
    {
     "sid": "da0202:T00027",
     "kind": "본문",
     "jp": "「それは当然ね。\n　だって私は……",
     "ko": "「그건 당연하지.\n　왜냐하면 나는…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00006",
     "kind": "루비 읽기",
     "jp": "・・・・・",
     "ko": "・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00028",
     "kind": "본문",
     "jp": "存在しない",
     "ko": "존재하지 않는",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da0202:R00007",
     "kind": "루비 읽기",
     "jp": "・",
     "ko": "・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00029",
     "kind": "본문",
     "jp": "『書』",
     "ko": " 『책』",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00030",
     "kind": "본문",
     "jp": "だもの」",
     "ko": "인걸」"
    }
   ]
  },
  {
   "uid": "da0202:U00014",
   "speaker": "アル",
   "jp": "「存在しない……？」",
   "cells": [
    {
     "sid": "da0202:T00031",
     "kind": "본문",
     "jp": "「存在しない……？」",
     "ko": "「존재하지 않는……?」"
    }
   ]
  },
  {
   "uid": "da0202:U00015",
   "speaker": "(지문)",
   "jp": "存在しない――アンチクロスのように？",
   "cells": [
    {
     "sid": "da0202:T00032",
     "kind": "본문",
     "jp": "存在しない――アンチクロスのように？",
     "ko": "존재하지 않는다―― 안티크로스처럼?"
    }
   ]
  },
  {
   "uid": "da0202:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「私は生まれざる〈いのち〉生命。私は望まれぬ生命。私は〈ノロイ〉呪詛を血に宿す『書』。私は怨嗟で綴られた物語。私は――」",
   "cells": [
    {
     "sid": "da0202:T00033",
     "kind": "본문",
     "jp": "「私は生まれざる",
     "ko": "「나는 태어나지 못한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00008",
     "kind": "루비 읽기",
     "jp": "いのち",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00034",
     "kind": "본문",
     "jp": "生命",
     "ko": "생명",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00035",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0202:T00036",
     "kind": "본문",
     "jp": "私は望まれぬ",
     "ko": "나는 바라는 이 없는 "
    },
    {
     "sid": "da0202:T00037",
     "kind": "본문",
     "jp": "生命",
     "ko": "생명"
    },
    {
     "sid": "da0202:T00038",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0202:T00039",
     "kind": "본문",
     "jp": "私は",
     "ko": "나는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00009",
     "kind": "루비 읽기",
     "jp": "ノロイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00040",
     "kind": "본문",
     "jp": "呪詛",
     "ko": "저주",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00041",
     "kind": "본문",
     "jp": "を血に宿す『書』。",
     "ko": "를 피에 품은 『책』."
    },
    {
     "sid": "da0202:T00042",
     "kind": "본문",
     "jp": "私は怨嗟で綴られた物語。",
     "ko": "나는 원망으로 엮인 이야기."
    },
    {
     "sid": "da0202:T00043",
     "kind": "본문",
     "jp": "私は――」",
     "ko": " 나는――」"
    }
   ]
  },
  {
   "uid": "da0202:U00017",
   "speaker": "アナザーブラッド",
   "jp": "「ネクロノミコン血液言語版」",
   "cells": [
    {
     "sid": "da0202:T00044",
     "kind": "본문",
     "jp": "「ネクロノミコン血液言語版」",
     "ko": "「네크로노미콘 혈액언어판」"
    }
   ]
  },
  {
   "uid": "da0202:U00018",
   "speaker": "九郎",
   "jp": "「血液……言語？」",
   "cells": [
    {
     "sid": "da0202:T00045",
     "kind": "본문",
     "jp": "「血液……言語？」",
     "ko": "「혈액…… 언어?」"
    }
   ]
  },
  {
   "uid": "da0202:U00019",
   "speaker": "アル",
   "jp": "「何だ、それは？〈ふざけ〉巫山戯ているのか」",
   "cells": [
    {
     "sid": "da0202:T00046",
     "kind": "본문",
     "jp": "「何だ、それは？",
     "ko": "「뭐냐, 그것은?",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00010",
     "kind": "루비 읽기",
     "jp": "ふざけ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00047",
     "kind": "본문",
     "jp": "巫山戯",
     "ko": "수작",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00048",
     "kind": "본문",
     "jp": "ているのか」",
     "ko": "을 부리는 것이냐」"
    }
   ]
  },
  {
   "uid": "da0202:U00020",
   "speaker": "アナザーブラッド",
   "jp": "「理解できなくても仕方ないわ。\n　理解してもらう必要もないのだけれど」",
   "cells": [
    {
     "sid": "da0202:T00049",
     "kind": "본문",
     "jp": "「理解できなくても仕方ないわ。\n　理解してもらう必要もないのだけれど」",
     "ko": "「이해하지 못해도 어쩔 수 없어.\n　이해해 줄 필요도 없지만」"
    }
   ]
  },
  {
   "uid": "da0202:U00021",
   "speaker": "アル",
   "jp": "「……そうか。ならばこの茶番、\n　終わりにしてくれる」",
   "cells": [
    {
     "sid": "da0202:T00050",
     "kind": "본문",
     "jp": "「……そうか。ならばこの茶番、\n　終わりにしてくれる」",
     "ko": "「……그런가. 그렇다면 이 어릿광대놀음,\n　끝내 주마」"
    }
   ]
  },
  {
   "uid": "da0202:U00022",
   "speaker": "アル",
   "jp": "「やるぞ、九郎！　あの下衆を\n　デモンベインから引きずり下ろせ！」",
   "cells": [
    {
     "sid": "da0202:T00051",
     "kind": "본문",
     "jp": "「やるぞ、九郎！　あの下衆を\n　デモンベインから引きずり下ろせ！」",
     "ko": "「간다, 쿠로! 저 천박한 것을\n　데몬베인에서 끌어내려라!」"
    }
   ]
  },
  {
   "uid": "da0202:U00023",
   "speaker": "九郎",
   "jp": "「……アル」\n\n　もともと気性の激しい奴だが、ここまで本気で怒っているアルは\n久しぶりだ。\n\n　だが、その気持ちは痛いほど分かる。俺だから分かる。デモンベインは俺たちにとって、かけがえのない戦友だった。半身のようなもの……と言っても過言ではないだろう。\n\n　永い永い――時間からも失われた戦いを経て、ようやくその役目を遂げたデモンベイン。その戦いを〈けが〉穢す、この血の化け物が〈ゆる〉赦せないのだ。その想いは、俺も同じだ。",
   "cells": [
    {
     "sid": "da0202:T00052",
     "kind": "본문",
     "jp": "「……アル」\n\n　もともと気性の激しい奴だが、ここまで本気で怒っているアルは\n久しぶりだ。\n\n　だが、その気持ちは痛いほど分かる。",
     "ko": "「……알」\n\n　원래 성미가 불같은 녀석이지만, 이토록 진심으로 분노하는 알은\n오랜만이다.\n\n　하지만 그 심정은 뼈저리게 이해한다."
    },
    {
     "sid": "da0202:T00053",
     "kind": "본문",
     "jp": "俺だから分かる。",
     "ko": " 나이기 때문에 이해한다."
    },
    {
     "sid": "da0202:T00054",
     "kind": "본문",
     "jp": "デモンベインは俺たちにとって、かけがえのない戦友だった。",
     "ko": "데몬베인은 우리에게 둘도 없는 전우였다."
    },
    {
     "sid": "da0202:T00055",
     "kind": "본문",
     "jp": "半身のようなもの……と言っても過言ではないだろう。\n\n　永い永い――時間からも失われた戦いを経て、ようやくその役目を遂げたデモンベイン。",
     "ko": "반신과도 같은 존재……라고 해도 과언이 아닐 것이다.\n\n　길고 긴―― 시간에서조차 소실된 싸움을 거쳐, 마침내 그 소임을 다한 데몬베인."
    },
    {
     "sid": "da0202:T00056",
     "kind": "본문",
     "jp": "その戦いを",
     "ko": "그 싸움을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00011",
     "kind": "루비 읽기",
     "jp": "けが",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00057",
     "kind": "본문",
     "jp": "穢",
     "ko": "더럽히",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00058",
     "kind": "본문",
     "jp": "す、この血の化け物が",
     "ko": "는 이 피의 괴물을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00012",
     "kind": "루비 읽기",
     "jp": "ゆる",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00059",
     "kind": "본문",
     "jp": "赦",
     "ko": "용서",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00060",
     "kind": "본문",
     "jp": "せないのだ。",
     "ko": "할 수 없는 것이다."
    },
    {
     "sid": "da0202:T00061",
     "kind": "본문",
     "jp": "その想いは、俺も同じだ。",
     "ko": "그 마음은 나도 마찬가지다."
    }
   ]
  },
  {
   "uid": "da0202:U00024",
   "speaker": "アナザーブラッド",
   "jp": "「あら？　遊んでくれるのかしら？」",
   "cells": [
    {
     "sid": "da0202:T00062",
     "kind": "본문",
     "jp": "「あら？　遊んでくれるのかしら？」",
     "ko": "「어머? 놀아 주려는 걸까?」"
    }
   ]
  },
  {
   "uid": "da0202:U00025",
   "speaker": "九郎",
   "jp": "「その機体はてめえには分不相応なんだよ……\n　今、引っぺがしてやる！」",
   "cells": [
    {
     "sid": "da0202:T00063",
     "kind": "본문",
     "jp": "「その機体はてめえには分不相応なんだよ……\n　今、引っぺがしてやる！」",
     "ko": "「그 기체는 네 녀석한테는 분수에 안 맞아……\n　지금 당장 벗겨 내 주마!」"
    }
   ]
  },
  {
   "uid": "da0202:U00026",
   "speaker": "アナザーブラッド",
   "jp": "「生身でこの子に挑むの？楽しいわね。まるでマスターテリオンみたい」",
   "cells": [
    {
     "sid": "da0202:T00064",
     "kind": "본문",
     "jp": "「生身でこの子に挑むの？",
     "ko": "「맨몸으로 이 아이에게 덤비는 거야?"
    },
    {
     "sid": "da0202:T00065",
     "kind": "본문",
     "jp": "楽しいわね。",
     "ko": "즐겁네."
    },
    {
     "sid": "da0202:T00066",
     "kind": "본문",
     "jp": "まるでマスターテリオンみたい」",
     "ko": "마치 마스터 테리온 같아」"
    }
   ]
  },
  {
   "uid": "da0202:U00027",
   "speaker": "九郎",
   "jp": "「――ッ！？」\n\n　マスターテリオン。失われた時間と世界で、悪の魔術結社『ブラックロッジ』を\n率いた〈グランドマスター〉大導師。絶望に囚われた金色の魔人。\n\n\n　あの強大な魔力を宿した少年は一度、生身でデモンベインを倒したことがある。\n\n\n　――やはりコイツは、俺とアルしか憶えていない世界を識っている！",
   "cells": [
    {
     "sid": "da0202:T00067",
     "kind": "본문",
     "jp": "「――ッ！？」\n\n　マスターテリオン。",
     "ko": "「――윽!?」\n\n　마스터 테리온."
    },
    {
     "sid": "da0202:T00068",
     "kind": "본문",
     "jp": "失われた時間と世界で、悪の魔術結社『ブラックロッジ』を\n率いた",
     "ko": "잃어버린 시간과 세계에서 악의 마술결사 『블랙 로지』를\n이끌었던 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00013",
     "kind": "루비 읽기",
     "jp": "グランドマスター",
     "ko": "그랜드 마스터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00069",
     "kind": "본문",
     "jp": "大導師",
     "ko": "대도사",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00070",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0202:T00071",
     "kind": "본문",
     "jp": "絶望に囚われた金色の魔人。\n\n\n　あの強大な魔力を宿した少年は一度、生身でデモンベインを倒したことがある。\n\n\n　――やはりコイツは、俺とアルしか憶えていない世界を識っている！",
     "ko": "절망에 사로잡힌 금빛 마인.\n\n\n　그 강대한 마력을 품은 소년은 한 번 맨몸으로 데몬베인을 쓰러뜨린 적이 있다.\n\n\n　――역시 이 녀석은 나와 알밖에 기억하지 못하는 세계를 알고 있다!"
    }
   ]
  },
  {
   "uid": "da0202:U00028",
   "speaker": "アナザーブラッド",
   "jp": "「強めにいくわよ！」",
   "cells": [
    {
     "sid": "da0202:T00072",
     "kind": "본문",
     "jp": "「強めにいくわよ！」",
     "ko": "「조금 세게 간다!」"
    }
   ]
  },
  {
   "uid": "da0202:U00029",
   "speaker": "アル",
   "jp": "「――九郎！」",
   "cells": [
    {
     "sid": "da0202:T00073",
     "kind": "본문",
     "jp": "「――九郎！」",
     "ko": "「――쿠로!」"
    }
   ]
  },
  {
   "uid": "da0202:U00030",
   "speaker": "(지문)",
   "jp": "応えるより早く、飛翔。さっきまで立っていた場所は、紅い爆発によって吹き飛んだ。\n\n　爆風は血の臭いを孕む。血風だ。血が爆ぜて、大地をえぐったのだ。",
   "cells": [
    {
     "sid": "da0202:T00074",
     "kind": "본문",
     "jp": "応えるより早く、飛翔。",
     "ko": "대답보다 빠르게 비상."
    },
    {
     "sid": "da0202:T00075",
     "kind": "본문",
     "jp": "さっきまで立っていた場所は、紅い爆発によって吹き飛んだ。\n\n　爆風は血の臭いを孕む。",
     "ko": "방금 전까지 서 있던 장소는 붉은 폭발에 날아갔다.\n\n　폭풍은 피비린내를 머금고 있다."
    },
    {
     "sid": "da0202:T00076",
     "kind": "본문",
     "jp": "血風だ。",
     "ko": " 혈풍이다."
    },
    {
     "sid": "da0202:T00077",
     "kind": "본문",
     "jp": "血が爆ぜて、大地をえぐったのだ。",
     "ko": "피가 터지며 대지를 도려냈다."
    }
   ]
  },
  {
   "uid": "da0202:U00031",
   "speaker": "アナザーブラッド",
   "jp": "「〈けつじん〉血刃を放つ、断て」",
   "cells": [
    {
     "sid": "da0202:T00078",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0202:R00014",
     "kind": "루비 읽기",
     "jp": "けつじん",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00079",
     "kind": "본문",
     "jp": "血刃",
     "ko": "피의 칼날",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00080",
     "kind": "본문",
     "jp": "を放つ、断て」",
     "ko": "을 날린다, 끊어라」"
    }
   ]
  },
  {
   "uid": "da0202:U00032",
   "speaker": "(지문)",
   "jp": "デモンベインが突き出す掌の前方、何処からともなく吹き出した\n血風が集う。\n\n　血風は厚みを得、質量を得て、〈ルビー〉紅玉の輝きを帯びる巨大な刃と\n化した。\n\n　気体／液体／固体、実体／非実体の境界を絶えず行き来する、〈ゆら〉幽めく血の刃をデモンベインが振り下ろす。",
   "cells": [
    {
     "sid": "da0202:T00081",
     "kind": "본문",
     "jp": "デモンベインが突き出す掌の前方、何処からともなく吹き出した\n血風が集う。\n\n　血風は厚みを得、質量を得て、",
     "ko": "데몬베인이 내민 손바닥 전방, 어디선가 뿜어져 나온\n혈풍이 모인다.\n\n　혈풍은 두께를 얻고 질량을 얻어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00015",
     "kind": "루비 읽기",
     "jp": "ルビー",
     "ko": "루비",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00082",
     "kind": "본문",
     "jp": "紅玉",
     "ko": "홍옥",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00083",
     "kind": "본문",
     "jp": "の輝きを帯びる巨大な刃と\n化した。\n\n　気体／液体／固体、実体／非実体の境界を絶えず行き来する、",
     "ko": "의 빛을 띤 거대한 칼날로\n변했다.\n\n　기체/액체/고체, 실체/비실체의 경계를 끊임없이 오가는,",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00016",
     "kind": "루비 읽기",
     "jp": "ゆら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0202:T00084",
     "kind": "본문",
     "jp": "幽",
     "ko": "일렁",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0202:T00085",
     "kind": "본문",
     "jp": "めく血の刃をデモンベインが振り下ろす。",
     "ko": "이는 피의 칼날을 데몬베인이 내리친다."
    }
   ]
  },
  {
   "uid": "da0202:U00033",
   "speaker": "(지문)",
   "jp": "刃は俺の躰をかすめ、背後にある街並みを一刀の元に両断。砕け吹き飛ぶビル群が瓦礫の雨となって降り注ぐ。\n\n　俺もまた剣圧に弾かれ、剣風に舞い上げられる。何とか体勢を整えるものの、間を置かず２撃目が襲ってくる。",
   "cells": [
    {
     "sid": "da0202:T00086",
     "kind": "본문",
     "jp": "刃は俺の躰をかすめ、背後にある街並みを一刀の元に両断。",
     "ko": "칼날은 내 몸을 스치며 등 뒤에 있는 거리 풍경을 일도양단."
    },
    {
     "sid": "da0202:T00087",
     "kind": "본문",
     "jp": "砕け吹き飛ぶビル群が瓦礫の雨となって降り注ぐ。\n\n　俺もまた剣圧に弾かれ、剣風に舞い上げられる。",
     "ko": "부서져 날아가는 빌딩군이 잔해의 비가 되어 쏟아져 내린다.\n\n　나 또한 검압에 튕겨 나가 검풍에 휩쓸려 솟구친다."
    },
    {
     "sid": "da0202:T00088",
     "kind": "본문",
     "jp": "何とか体勢を整えるものの、間を置かず２撃目が襲ってくる。",
     "ko": "어떻게든 자세를 바로잡았지만, 틈을 두지 않고 2격째가 덮쳐 온다."
    }
   ]
  },
  {
   "uid": "da0202:U00034",
   "speaker": "アナザーブラッド",
   "jp": "「まだまだぁ！」",
   "cells": [
    {
     "sid": "da0202:T00089",
     "kind": "본문",
     "jp": "「まだまだぁ！」",
     "ko": "「아직 안 끝났어!」"
    }
   ]
  },
  {
   "uid": "da0202:U00035",
   "speaker": "九郎",
   "jp": "「ぐわあああ！」",
   "cells": [
    {
     "sid": "da0202:T00090",
     "kind": "본문",
     "jp": "「ぐわあああ！」",
     "ko": "「크아아아아!」"
    }
   ]
  },
  {
   "uid": "da0202:U00036",
   "speaker": "(지문)",
   "jp": "横薙ぎの一撃。紅い斬撃が通り過ぎ、街並みが砕ける。",
   "cells": [
    {
     "sid": "da0202:T00091",
     "kind": "본문",
     "jp": "横薙ぎの一撃。",
     "ko": "가로베는 일격."
    },
    {
     "sid": "da0202:T00092",
     "kind": "본문",
     "jp": "紅い斬撃が通り過ぎ、街並みが砕ける。",
     "ko": "붉은 참격이 스쳐 지나가며 거리 풍경이 부서진다."
    }
   ]
  },
  {
   "uid": "da0202:U00037",
   "speaker": "(지문)",
   "jp": "さらに斬撃。斬撃。斬撃。",
   "cells": [
    {
     "sid": "da0202:T00093",
     "kind": "본문",
     "jp": "さらに斬撃。斬撃。斬撃。",
     "ko": "이어서 참격. 참격. 참격."
    }
   ]
  },
  {
   "uid": "da0202:U00038",
   "speaker": "瑠璃",
   "jp": "「……鋼鉄の巨人」",
   "cells": [
    {
     "sid": "da0202:T00094",
     "kind": "본문",
     "jp": "「……鋼鉄の巨人」",
     "ko": "「……강철의 거인」"
    }
   ]
  },
  {
   "uid": "da0202:U00039",
   "speaker": "ウィンフィールド",
   "jp": "「なんと凄まじい……」",
   "cells": [
    {
     "sid": "da0202:T00095",
     "kind": "본문",
     "jp": "「なんと凄まじい……」",
     "ko": "「어찌 이토록 무시무시한……」"
    }
   ]
  },
  {
   "uid": "da0202:U00040",
   "speaker": "瑠璃",
   "jp": "「何ですの……アレは？」",
   "cells": [
    {
     "sid": "da0202:T00096",
     "kind": "본문",
     "jp": "「何ですの……アレは？」",
     "ko": "「무엇인가요…… 저것은?」"
    }
   ]
  },
  {
   "uid": "da0202:U00041",
   "speaker": "(지문)",
   "jp": "<SE ID=\"1\" SRC=\"seロボ特殊_汎用斬撃命中飛翔 MODE=\"normal\" TIME=\"\" LOOP=\"\" vol=\"\">",
   "cells": [
    {
     "sid": "da0202:T00097",
     "kind": "본문",
     "jp": "<SE ID=\"1\" SRC=\"seロボ特殊_汎用斬撃命中飛翔 MODE=\"normal\" TIME=\"\" LOOP=\"\" vol=\"\">",
     "ko": null,
     "lock": "엔진 명령 칸(원본 그대로 보존)"
    }
   ]
  },
  {
   "uid": "da0202:U00042",
   "speaker": "瑠璃",
   "jp": "「何なんですの！？\n　あの……あの〈・・・・〉バケモノは！？」",
   "cells": [
    {
     "sid": "da0202:T00098",
     "kind": "본문",
     "jp": "「何なんですの！？\n　あの……あの",
     "ko": "「대체 무엇인가요!?\n　저…… 저 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0202:R00017",
     "kind": "루비 읽기",
     "jp": "・・・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
