    {
     "sid": "da0802:T00015",
     "kind": "본문",
     "jp": "存在し得ぬ",
     "ko": "존재할 수 없는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0802:T00016",
     "kind": "본문",
     "jp": "のは貴様だ」",
     "ko": " 것은 네놈이다」"
    }
   ]
  },
  {
   "uid": "da0802:U00006",
   "speaker": "(지문)",
   "jp": "両掌に顕れる双剣。その切っ先をリベル・レギスに向けて、突きつける。九朔の鬼迫は〈プレッシャー〉圧迫感をもって、大広間の空気を震撼させる。",
   "cells": [
    {
     "sid": "da0802:T00017",
     "kind": "본문",
     "jp": "両掌に顕れる双剣。",
     "ko": "두 손바닥에 나타나는 쌍검."
    },
    {
     "sid": "da0802:T00018",
     "kind": "본문",
     "jp": "その切っ先をリベル・レギスに向けて、突きつける。",
     "ko": "그 칼끝을 리베르 레기스를 향해 들이댄다."
    },
    {
     "sid": "da0802:T00019",
     "kind": "본문",
     "jp": "九朔の鬼迫は",
     "ko": "쿠자쿠의 기백은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0802:R00005",
     "kind": "루비 읽기",
     "jp": "プレッシャー",
     "ko": "프레셔를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0802:T00020",
     "kind": "본문",
     "jp": "圧迫感",
     "ko": "압박감을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0802:T00021",
     "kind": "본문",
     "jp": "をもって、大広間の空気を震撼させる。",
     "ko": " 띠고 대홀의 공기를 진감시킨다."
    }
   ]
  },
  {
   "uid": "da0802:U00007",
   "speaker": "九朔",
   "jp": "「〈と〉疾く〈い〉去ね。単なる悪夢に用は無い」",
