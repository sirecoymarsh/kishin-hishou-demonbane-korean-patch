  },
  {
   "uid": "da0802:U00008",
   "speaker": "テリオン",
   "jp": "「はは……手厳しいな。しかし\n　それは此方の台詞でもある……」",
   "cells": [
    {
     "sid": "da0802:T00027",
     "kind": "본문",
     "jp": "「はは……手厳しいな。しかし\n　それは此方の台詞でもある……」",
     "ko": "「하하…… 매정하군. 하지만\n　그것은 이쪽이 할 말이기도 하다……」"
    }
   ]
  },
  {
   "uid": "da0802:U00009",
   "speaker": "九朔",
   "jp": "「何だと……？」",
   "cells": [
