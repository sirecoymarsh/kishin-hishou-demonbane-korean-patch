    }
   ]
  },
  {
   "uid": "da0802:U00004",
   "speaker": "テリオン",
   "jp": "「〈・・・・・・・〉未だ存在し得ぬ英雄にまで、\n　我が名が知れ渡っているとは\n　……光栄なことだ」",
   "cells": [
    {
     "sid": "da0802:T00011",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0802:R00003",
     "kind": "루비 읽기",
     "jp": "・・・・・・・",
     "ko": "・・・・・・・",
