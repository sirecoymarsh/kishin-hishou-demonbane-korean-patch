     "kind": "본문",
     "jp": "！\n　　時の歯車",
     "ko": "!\n　　시간의 톱니바퀴\n　　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00029",
     "kind": "루비 읽기",
     "jp": "さばき",
     "ko": "심판",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00121",
     "kind": "본문",
     "jp": "断罪",
     "ko": "단죄",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00122",
     "kind": "본문",
     "jp": "の刃\n　　久遠の果てより来たる虚無」",
     "ko": "의 칼날\n　　구원의 끝에서 오는 허무」"
