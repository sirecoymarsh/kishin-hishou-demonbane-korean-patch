     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0505:R00019",
     "kind": "루비 읽기",
     "jp": "カウンター",
     "ko": "카운터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
