    }
   ]
  },
  {
   "uid": "da0505:U00028",
   "speaker": "アズラッド",
   "jp": "「あの道化師にも言ったはずだ。\n　お前も聞いていたのだろう？」",
   "cells": [
    {
     "sid": "da0505:T00076",
     "kind": "본문",
     "jp": "「あの道化師にも言ったはずだ。\n　お前も聞いていたのだろう？」",
     "ko": "「그 광대에게도 말했을 텐데.\n　너도 듣고 있었겠지?」"
    }
   ]
  },
  {
   "uid": "da0505:U00029",
   "speaker": "アナザーブラッド",
   "jp": "「〈まさか〉真逆……！」",
   "cells": [
    {
