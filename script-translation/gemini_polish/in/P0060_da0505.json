     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00087",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00088",
     "kind": "본문",
     "jp": "が創ったの！？　貴方を！\n　私の",
     "ko": "이 창조한 거야!?　당신을!\n　내 ",
     "ruby_edge": "뒤"
    },
    {
