  {
   "uid": "da0505:U00024",
   "speaker": "アナザーブラッド",
   "jp": "「そうか……〈・・・・〉あの時代の\nマスター・オブ・ネクロノミコンね！」",
   "cells": [
    {
     "sid": "da0505:T00070",
     "kind": "본문",
     "jp": "「そうか……",
     "ko": "「그런가…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00016",
     "kind": "루비 읽기",
     "jp": "・・・・",
     "ko": "・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00071",
     "kind": "본문",
     "jp": "あの時代",
     "ko": "그 시대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00072",
     "kind": "본문",
     "jp": "の\nマスター・オブ・ネクロノミコンね！」",
     "ko": "의\n마스터 오브 네크로노미콘이구나!」"
    }
   ]
  },
  {
   "uid": "da0505:U00025",
   "speaker": "アナザーブラッド",
   "jp": "「でもどうして！？\n　私は貴方なんか創っていないわ！」",
   "cells": [
    {
     "sid": "da0505:T00073",
     "kind": "본문",
     "jp": "「でもどうして！？\n　私は貴方なんか創っていないわ！」",
     "ko": "「하지만 어째서!?\n　나는 당신 같은 건 창조하지 않았어!」"
    }
   ]
  },
  {
   "uid": "da0505:U00026",
   "speaker": "アズラッド",
   "jp": "「彼女が見る夢は、悪夢だけではない」",
   "cells": [
    {
     "sid": "da0505:T00074",
     "kind": "본문",
     "jp": "「彼女が見る夢は、悪夢だけではない」",
     "ko": "「그 아이가 꾸는 꿈은 악몽만이 아니다」"
    }
   ]
  },
  {
   "uid": "da0505:U00027",
   "speaker": "アナザーブラッド",
   "jp": "「…………！？」",
   "cells": [
