    },
    {
     "sid": "da0505:T00049",
     "kind": "본문",
     "jp": "がひとりでに外れた。",
     "ko": "이 저절로 풀렸다."
    },
    {
     "sid": "da0505:T00050",
     "kind": "본문",
     "jp": "開かれた書から眩い光が溢れる。",
     "ko": "펼쳐진 책에서 눈부신 빛이 흘러넘친다."
    }
   ]
  },
  {
   "uid": "da0505:U00017",
   "speaker": "アズラッド",
   "jp": "「だからこそ――」",
   "cells": [
    {
     "sid": "da0505:T00051",
     "kind": "본문",
     "jp": "「だからこそ――」",
     "ko": "「그렇기에――」"
    }
   ]
  },
  {
   "uid": "da0505:U00018",
   "speaker": "(지문)",
   "jp": "光が男を包み込む。光は無数の魔術文字。複雑にして強靭な術式。彼の存在を組み替えてゆく。",
   "cells": [
    {
     "sid": "da0505:T00052",
     "kind": "본문",
     "jp": "光が男を包み込む。",
     "ko": "빛이 남자를 감싼다."
    },
    {
     "sid": "da0505:T00053",
     "kind": "본문",
     "jp": "光は無数の魔術文字。複雑にして強靭な術式。",
     "ko": "빛은 무수한 마술문자. 복잡하고도 강인한 술식."
    },
    {
     "sid": "da0505:T00054",
     "kind": "본문",
     "jp": "彼の存在を組み替えてゆく。",
     "ko": "그의 존재를 재구성해 간다."
    }
   ]
  },
  {
   "uid": "da0505:U00019",
   "speaker": "(지문)",
   "jp": "「――俺が存在できる」",
   "cells": [
    {
     "sid": "da0505:T00055",
     "kind": "본문",
     "jp": "「――俺が存在できる」",
     "ko": "「――내가 존재할 수 있다」"
    }
   ]
  },
  {
   "uid": "da0505:U00020",
   "speaker": "(지문)",
   "jp": "光が収まる。男の姿は一変していた。",
   "cells": [
    {
     "sid": "da0505:T00056",
     "kind": "본문",
     "jp": "光が収まる。",
     "ko": "빛이 잦아든다."
    },
    {
     "sid": "da0505:T00057",
     "kind": "본문",
     "jp": "男の姿は一変していた。",
     "ko": "남자의 모습은 일변해 있었다."
    }
   ]
  },
  {
   "uid": "da0505:U00021",
   "speaker": "(지문)",
   "jp": "全身を包み込む漆黒のスーツ。全身から発せられる強大な魔力。",
   "cells": [
    {
     "sid": "da0505:T00058",
     "kind": "본문",
     "jp": "全身を包み込む漆黒のスーツ。",
     "ko": "전신을 감싸는 칠흑의 슈트."
    },
    {
     "sid": "da0505:T00059",
     "kind": "본문",
     "jp": "全身から発せられる強大な魔力。",
     "ko": "전신에서 뿜어져 나오는 강대한 마력."
    }
   ]
  },
  {
   "uid": "da0505:U00022",
   "speaker": "アズラッド",
   "jp": "「〈マスター・オブ・ネクロノミコン〉『死霊秘法』の主、アズラッド。\n　邪神ズアウィアを冥府に連れ戻す任、〈プルート〉閻魔より仰せつかった」",
   "cells": [
    {
     "sid": "da0505:T00060",
     "kind": "본문",
