    },
    {
     "sid": "da0505:T00090",
     "kind": "본문",
     "jp": "に対抗する",
     "ko": "에 대항하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00022",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00091",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00092",
     "kind": "본문",
     "jp": "を！」",
     "ko": "를!」"
    }
   ]
  },
  {
   "uid": "da0505:U00032",
   "speaker": "アズラッド",
   "jp": "「夢語りの魔物よ。邪神ズアウィアよ。\n　お前たちの好きにはさせない」",
   "cells": [
    {
     "sid": "da0505:T00093",
     "kind": "본문",
     "jp": "「夢語りの魔物よ。邪神ズアウィアよ。\n　お前たちの好きにはさせない」",
     "ko": "「꿈을 말하는 마물이여. 사신 즈아위아여.\n　너희 뜻대로 두지는 않겠다」"
    }
   ]
  },
  {
   "uid": "da0505:U00033",
   "speaker": "アナザーブラッド",
   "jp": "「ウェイトリイ！」",
   "cells": [
    {
     "sid": "da0505:T00094",
     "kind": "본문",
     "jp": "「ウェイトリイ！」",
     "ko": "「웨이틀리!」"
    }
   ]
  },
  {
   "uid": "da0505:U00034",
   "speaker": "(지문)",
   "jp": "アズラッドの周囲で空間が砕けた。空間の裂け目から、ウェイトリイの触手が溢れ、アズラッドに\n襲いかかる。\n\n　しかし、アズラッドは動かない。アズラッドが地面に落とす影より、バルザイの偃月刀が顕れ、\n触手を薙ぎ払った。",
   "cells": [
    {
     "sid": "da0505:T00095",
     "kind": "본문",
     "jp": "アズラッドの周囲で空間が砕けた。",
     "ko": "아즈라드의 주위에서 공간이 부서졌다."
    },
    {
     "sid": "da0505:T00096",
     "kind": "본문",
     "jp": "空間の裂け目から、ウェイトリイの触手が溢れ、アズラッドに\n襲いかかる。\n\n　しかし、アズラッドは動かない。",
     "ko": "공간의 갈라진 틈에서 웨이틀리의 촉수가 흘러넘쳐 아즈라드를\n덮친다.\n\n　그러나 아즈라드는 움직이지 않는다."
    },
    {
     "sid": "da0505:T00097",
     "kind": "본문",
     "jp": "アズラッドが地面に落とす影より、バルザイの偃月刀が顕れ、\n触手を薙ぎ払った。",
     "ko": "아즈라드가 지면에 드리운 그림자에서 바르자이 언월도가 나타나\n촉수를 베어 넘겼다."
    }
   ]
  },
  {
   "uid": "da0505:U00035",
   "speaker": "(지문)",
   "jp": "四方から襲い来る触手の群れに対抗すべく、偃月刀は十に分身。アズラッドの周囲を円形に囲む。ズアウィアを退ける巨大な偃月刀の結界と同じように。",
   "cells": [
    {
     "sid": "da0505:T00098",
     "kind": "본문",
     "jp": "四方から襲い来る触手の群れに対抗すべく、偃月刀は十に分身。",
     "ko": "사방에서 덮쳐 오는 촉수 무리에 대항하고자 언월도는 열 자루로 분신."
    },
    {
     "sid": "da0505:T00099",
     "kind": "본문",
     "jp": "アズラッドの周囲を円形に囲む。",
     "ko": "아즈라드의 주위를 원형으로 에워싼다."
    },
    {
     "sid": "da0505:T00100",
     "kind": "본문",
     "jp": "ズアウィアを退ける巨大な偃月刀の結界と同じように。",
     "ko": "즈아위아를 물리치는 거대한 언월도의 결계와 마찬가지로."
    }
   ]
  },
  {
   "uid": "da0505:U00036",
   "speaker": "アズラッド",
   "jp": "「二度と世界を奪わせたりはしない」",
   "cells": [
    {
     "sid": "da0505:T00101",
     "kind": "본문",
     "jp": "「二度と世界を奪わせたりはしない」",
     "ko": "「두 번 다시 세계를 빼앗기게 두지 않는다」"
    }
   ]
  },
  {
   "uid": "da0505:U00037",
   "speaker": "(지문)",
   "jp": "アズラッドを囲む偃月刀のうち九つが解け、無数の〈ページ〉紙片となった。〈ページ〉紙片はそれぞれ、複雑な呪紋や魔術文字を、目まぐるしく〈モニター〉表示している。残った一本をアズラッドは手に取り、魔力を研ぎ澄ませてゆく。\n\n\n　『詠唱形態』。魔導書が最大の効果を発揮する〈スタイル〉形態だ。\n\n　そしてたった今、展開されている術式こそ、魔導書『アル・アジフ』\n最強最大の奥義――",
   "cells": [
    {
     "sid": "da0505:T00102",
     "kind": "본문",
     "jp": "アズラッドを囲む偃月刀のうち九つが解け、無数の",
     "ko": "아즈라드를 에워싼 언월도 중 아홉 자루가 풀리며 무수한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00023",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00103",
     "kind": "본문",
     "jp": "紙片",
     "ko": "지편이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00104",
     "kind": "본문",
     "jp": "となった。",
     "ko": " 되었다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00024",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00105",
     "kind": "본문",
     "jp": "紙片",
     "ko": "지편은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00106",
     "kind": "본문",
     "jp": "はそれぞれ、複雑な呪紋や魔術文字を、目まぐるしく",
     "ko": " 각각 복잡한 주술 문양과 마술문자를 어지럽게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00025",
     "kind": "루비 읽기",
     "jp": "モニター",
     "ko": "모니터",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00107",
     "kind": "본문",
     "jp": "表示",
     "ko": "표시",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00108",
     "kind": "본문",
     "jp": "している。",
     "ko": "하고 있다."
    },
    {
     "sid": "da0505:T00109",
     "kind": "본문",
     "jp": "残った一本をアズラッドは手に取り、魔力を研ぎ澄ませてゆく。\n\n\n　『詠唱形態』。",
     "ko": "남은 한 자루를 아즈라드는 손에 쥐고 마력을 벼려 간다.\n\n\n　『영창형태』."
    },
    {
     "sid": "da0505:T00110",
     "kind": "본문",
     "jp": "魔導書が最大の効果を発揮する",
     "ko": "마도서가 최대의 효과를 발휘하는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0505:R00026",
     "kind": "루비 읽기",
     "jp": "スタイル",
     "ko": "스타일이다",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00111",
     "kind": "본문",
     "jp": "形態",
     "ko": "형태다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0505:T00112",
     "kind": "본문",
     "jp": "だ。\n\n　そしてたった今、展開されている術式こそ、魔導書『アル・アジフ』\n最強最大の奥義――",
     "ko": ".\n\n　그리고 바로 지금, 전개되고 있는 술식이야말로 마도서 『알 아지프』\n최강 최대의 오의――"
    }
   ]
  },
  {
   "uid": "da0505:U00038",
   "speaker": "アナザーブラッド",
   "jp": "「『機神招喚』！？」",
   "cells": [
    {
