     "kind": "루비 읽기",
     "jp": "アイオーン",
     "ko": "아이온",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0505:T00119",
     "kind": "본문",
     "jp": "永劫",
     "ko": "영겁",
     "ruby_edge": "앞"
    },
    {
