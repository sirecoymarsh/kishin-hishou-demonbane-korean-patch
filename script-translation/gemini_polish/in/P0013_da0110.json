{
 "packet": "P0013_da0110",
 "units": [
  {
   "uid": "da0110:U00001",
   "speaker": "(지문)",
   "jp": "言葉は魔術だ。物語は世界だ。",
   "cells": [
    {
     "sid": "da0110:T00001",
     "kind": "본문",
     "jp": "言葉は魔術だ。",
     "ko": "말은 마술이다."
    },
    {
     "sid": "da0110:T00002",
     "kind": "본문",
     "jp": "物語は世界だ。",
     "ko": "이야기는 세계다."
    }
   ]
  },
  {
   "uid": "da0110:U00002",
   "speaker": "(지문)",
   "jp": "〈コトバ〉魔術を紡いで、〈セカイ〉物語を創る。魔術師に限ったことではない。ヒトは個々の世界観に従って、生きる。言葉がヒトに世界を与えるのだ。\n\n　ヒトの数だけセカイは存在し、〈セカイ〉物語なくしてヒトは生きられぬ。外道の血脈たる私とて、同じことだ。\n\n　私は私の世界を創る。私の言葉で世界を紡ぐ。私の思念で世界を築く。私が私である限り、何人も私の物語を止めることは出来ない。\n\n　さあ、世界よ。私の〈セカイ〉物語を受け入れよ。私が求める物語は――",
   "cells": [
    {
     "sid": "da0110:R00001",
     "kind": "루비 읽기",
     "jp": "コトバ",
     "ko": "말",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00003",
     "kind": "본문",
     "jp": "魔術",
     "ko": "마술",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00004",
     "kind": "본문",
     "jp": "を紡いで、",
     "ko": "을 자아내어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00002",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00005",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00006",
     "kind": "본문",
     "jp": "を創る。",
     "ko": "를 만든다."
    },
    {
     "sid": "da0110:T00007",
     "kind": "본문",
     "jp": "魔術師に限ったことではない。",
     "ko": "마술사에게만 국한된 일이 아니다."
    },
    {
     "sid": "da0110:T00008",
     "kind": "본문",
     "jp": "ヒトは個々の世界観に従って、生きる。",
     "ko": "인간은 개개의 세계관에 따라, 살아간다."
    },
    {
     "sid": "da0110:T00009",
     "kind": "본문",
     "jp": "言葉がヒトに世界を与えるのだ。\n\n　ヒトの数だけセカイは存在し、",
     "ko": "말이 인간에게 세계를 부여한다.\n\n　인간의 수만큼 세계는 존재하며, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00003",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00010",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00011",
     "kind": "본문",
     "jp": "なくしてヒトは生きられぬ。",
     "ko": " 없이는 인간은 살아갈 수 없다."
    },
    {
     "sid": "da0110:T00012",
     "kind": "본문",
     "jp": "外道の血脈たる私とて、同じことだ。\n\n　私は私の世界を創る。",
     "ko": "외도의 혈맥인 나라고 해서, 다를 바 없다.\n\n　나는 나의 세계를 만든다."
    },
    {
     "sid": "da0110:T00013",
     "kind": "본문",
     "jp": "私の言葉で世界を紡ぐ。",
     "ko": "나의 말로 세계를 자아낸다."
    },
    {
     "sid": "da0110:T00014",
     "kind": "본문",
     "jp": "私の思念で世界を築く。",
     "ko": "나의 사념으로 세계를 구축한다."
    },
    {
     "sid": "da0110:T00015",
     "kind": "본문",
     "jp": "私が私である限り、何人も私の物語を止めることは出来ない。\n\n　さあ、世界よ。",
     "ko": "내가 나인 이상, 그 누구도 나의 이야기를 멈출 수는 없다.\n\n　자, 세계여."
    },
    {
     "sid": "da0110:T00016",
     "kind": "본문",
     "jp": "私の",
     "ko": "나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00004",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00017",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00018",
     "kind": "본문",
     "jp": "を受け入れよ。",
     "ko": "를 받아들여라."
    },
    {
     "sid": "da0110:T00019",
     "kind": "본문",
     "jp": "私が求める物語は――",
     "ko": "내가 바라는 이야기는――"
    }
   ]
  },
  {
   "uid": "da0110:U00003",
   "speaker": "アナザーブラッド",
   "jp": "「悪徳！」",
   "cells": [
    {
     "sid": "da0110:T00020",
     "kind": "본문",
     "jp": "「悪徳！」",
     "ko": "「악덕!」"
    }
   ]
  },
  {
   "uid": "da0110:U00004",
   "speaker": "アナザーブラッド",
   "jp": "「悪徳！」",
   "cells": [
    {
     "sid": "da0110:T00021",
     "kind": "본문",
     "jp": "「悪徳！」",
     "ko": "「악덕!」"
    }
   ]
  },
  {
   "uid": "da0110:U00005",
   "speaker": "アナザーブラッド",
   "jp": "「悪徳の坩堝を！」",
   "cells": [
    {
     "sid": "da0110:T00022",
     "kind": "본문",
     "jp": "「悪徳の坩堝を！」",
     "ko": "「악덕의 도가니를!」"
    }
   ]
  },
  {
   "uid": "da0110:U00006",
   "speaker": "(지문)",
   "jp": "私の世界は、それ以外に形を成し得ない。私の言葉は呪詛だ。私の思念は怨嗟だ。私が紡ぎ、築き、創るのは、ただ堕ちゆくだけの救われざる物語。\n\n　さあ、世界よ。〈おと〉堕胎されし〈ヒルコ〉蛭子が、怨念により編み上げた〈セカイ〉物語を享け入れよ。〈あまた〉数多の世界を〈イケニエ〉苗床として、私の〈セカイ〉物語を育もう。愛も悦びも安息も享楽も総て、甘く〈ふらん〉腐爛する苦痛より産み落とされる\nのだ。",
   "cells": [
    {
     "sid": "da0110:T00023",
     "kind": "본문",
     "jp": "私の世界は、それ以外に形を成し得ない。",
     "ko": "나의 세계는, 그 외에는 형태를 이룰 수 없다."
    },
    {
     "sid": "da0110:T00024",
     "kind": "본문",
     "jp": "私の言葉は呪詛だ。",
     "ko": "나의 말은 저주다."
    },
    {
     "sid": "da0110:T00025",
     "kind": "본문",
     "jp": "私の思念は怨嗟だ。",
     "ko": "나의 사념은 원망이다."
    },
    {
     "sid": "da0110:T00026",
     "kind": "본문",
     "jp": "私が紡ぎ、築き、創るのは、ただ堕ちゆくだけの救われざる物語。\n\n　さあ、世界よ。",
     "ko": "내가 자아내고, 구축하고, 만드는 것은, 그저 타락해 갈 뿐인 구원받지 못할 이야기.\n\n　자, 세계여.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00005",
     "kind": "루비 읽기",
     "jp": "おと",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00027",
     "kind": "본문",
     "jp": "堕胎",
     "ko": "낙태",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00028",
     "kind": "본문",
     "jp": "されし",
     "ko": "된 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00006",
     "kind": "루비 읽기",
     "jp": "ヒルコ",
     "ko": "히루코",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00029",
     "kind": "본문",
     "jp": "蛭子",
     "ko": "거머리 아이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00030",
     "kind": "본문",
     "jp": "が、怨念により編み上げた",
     "ko": "가, 원념으로 엮어 올린 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00007",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00031",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00032",
     "kind": "본문",
     "jp": "を享け入れよ。",
     "ko": "를 받아들여라.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00008",
     "kind": "루비 읽기",
     "jp": "あまた",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00033",
     "kind": "본문",
     "jp": "数多",
     "ko": "수많은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00034",
     "kind": "본문",
     "jp": "の世界を",
     "ko": " 세계를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00009",
     "kind": "루비 읽기",
     "jp": "イケニエ",
     "ko": "제물로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00035",
     "kind": "본문",
     "jp": "苗床",
     "ko": "모판으로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00036",
     "kind": "본문",
     "jp": "として、私の",
     "ko": " 삼아, 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00010",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00037",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00038",
     "kind": "본문",
     "jp": "を育もう。",
     "ko": "를 길러 내자."
    },
    {
     "sid": "da0110:T00039",
     "kind": "본문",
     "jp": "愛も悦びも安息も享楽も総て、甘く",
     "ko": "사랑도 기쁨도 안식도 향락도 모두, 달콤하게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00011",
     "kind": "루비 읽기",
     "jp": "ふらん",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00040",
     "kind": "본문",
     "jp": "腐爛",
     "ko": "썩어 가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00041",
     "kind": "본문",
     "jp": "する苦痛より産み落とされる\nのだ。",
     "ko": "는 고통에서 태어나는 것이다."
    }
   ]
  },
  {
   "uid": "da0110:U00007",
   "speaker": "アナザーブラッド",
   "jp": "「……あはっ」",
   "cells": [
    {
     "sid": "da0110:T00042",
     "kind": "본문",
     "jp": "「……あはっ」",
     "ko": "「……아핫」"
    }
   ]
  },
  {
   "uid": "da0110:U00008",
   "speaker": "アナザーブラッド",
   "jp": "「鋼鉄の血を分ける――〈あらわ〉顕れよ」",
   "cells": [
    {
     "sid": "da0110:T00043",
     "kind": "본문",
     "jp": "「鋼鉄の血を分ける――",
     "ko": "「강철의 피를 나눈다――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00012",
     "kind": "루비 읽기",
     "jp": "あらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00044",
     "kind": "본문",
     "jp": "顕",
     "ko": "나타나",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00045",
     "kind": "본문",
     "jp": "れよ」",
     "ko": "라」"
    }
   ]
  },
  {
   "uid": "da0110:U00009",
   "speaker": "アナザーブラッド",
   "jp": "「遠隔招喚――相変わらず器用ね」",
   "cells": [
    {
     "sid": "da0110:T00046",
     "kind": "본문",
     "jp": "「遠隔招喚――相変わらず器用ね」",
     "ko": "「원격 소환――여전히 재주가 좋네」"
    }
   ]
  },
  {
   "uid": "da0110:U00010",
   "speaker": "アナザーブラッド",
   "jp": "「だけど私に構っている場合かしら？\n　ほら、急がないと彼女たちが……\n　ねっ？」",
   "cells": [
    {
     "sid": "da0110:T00047",
     "kind": "본문",
     "jp": "「だけど私に構っている場合かしら？\n　ほら、急がないと彼女たちが……\n　ねっ？」",
     "ko": "「하지만 나한테 신경 쓰고 있을 때일까?\n　봐, 서두르지 않으면 그 애들이……\n　응?」"
    }
   ]
  },
  {
   "uid": "da0110:U00011",
   "speaker": "九朔",
   "jp": "「元より承知！」",
   "cells": [
    {
     "sid": "da0110:T00048",
     "kind": "본문",
     "jp": "「元より承知！」",
     "ko": "「원래부터 알고 있다!」"
    }
   ]
  },
  {
   "uid": "da0110:U00012",
   "speaker": "(지문)",
   "jp": "それでも今ので、精神集中が乱れたはずだ。貴様の紡ぐ悪夢は、それほど強固なものではあるまい。ならば必ず綻びが生じる！\n\n　走る／〈はし〉疾る／〈はし〉奔る。我が〈おこない〉行動が『守護』である以上、我が速度に追いつけるもの\n　はいない――〈かぜ〉疾風といえども、〈さだめ〉運命といえども。\n\n　何故ならば。",
   "cells": [
    {
     "sid": "da0110:T00049",
     "kind": "본문",
     "jp": "それでも今ので、精神集中が乱れたはずだ。",
     "ko": "그래도 방금 일격으로, 정신 집중이 흐트러졌을 터이다."
    },
    {
     "sid": "da0110:T00050",
     "kind": "본문",
     "jp": "貴様の紡ぐ悪夢は、それほど強固なものではあるまい。",
     "ko": "네놈이 자아내는 악몽은, 그토록 견고한 것이 아닐 테지."
    },
    {
     "sid": "da0110:T00051",
     "kind": "본문",
     "jp": "ならば必ず綻びが生じる！\n\n　走る／",
     "ko": "그렇다면 반드시 틈이 생긴다!\n\n　달린다／",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00013",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00052",
     "kind": "본문",
     "jp": "疾",
     "ko": "질주한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00053",
     "kind": "본문",
     "jp": "る／",
     "ko": "다／",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00014",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00054",
     "kind": "본문",
     "jp": "奔",
     "ko": "내달린",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00055",
     "kind": "본문",
     "jp": "る。",
     "ko": "다."
    },
    {
     "sid": "da0110:T00056",
     "kind": "본문",
     "jp": "我が",
     "ko": "나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00015",
     "kind": "루비 읽기",
     "jp": "おこない",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00057",
     "kind": "본문",
     "jp": "行動",
     "ko": "행동",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00058",
     "kind": "본문",
     "jp": "が『守護』である以上、我が速度に追いつけるもの\n　はいない――",
     "ko": "이 『수호』인 이상, 무엇도 나의 속도를\n　따라잡을 수 없다――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00016",
     "kind": "루비 읽기",
     "jp": "かぜ",
     "ko": "바람",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00059",
     "kind": "본문",
     "jp": "疾風",
     "ko": "질풍",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00060",
     "kind": "본문",
     "jp": "といえども、",
     "ko": "이라 할지라도, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00017",
     "kind": "루비 읽기",
     "jp": "さだめ",
     "ko": "숙명",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00061",
     "kind": "본문",
     "jp": "運命",
     "ko": "운명",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00062",
     "kind": "본문",
     "jp": "といえども。\n\n　何故ならば。",
     "ko": "이라 할지라도.\n\n　왜냐하면."
    }
   ]
  },
  {
   "uid": "da0110:U00013",
   "speaker": "九朔",
   "jp": "「〈われ〉我が、『騎士』だからだ！」",
   "cells": [
    {
     "sid": "da0110:T00063",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0110:R00018",
     "kind": "루비 읽기",
     "jp": "われ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00064",
     "kind": "본문",
     "jp": "我",
     "ko": "내",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00065",
     "kind": "본문",
     "jp": "が、『騎士』だからだ！」",
     "ko": "가, 『기사』이기 때문이다!」"
    }
   ]
  },
  {
   "uid": "da0110:U00014",
   "speaker": "(지문)",
   "jp": "走りながら、親指の皮を食い千切る。傷口から溢れる熱い血が、『世界』に向かって流れ込む。",
   "cells": [
    {
     "sid": "da0110:T00066",
     "kind": "본문",
     "jp": "走りながら、親指の皮を食い千切る。",
     "ko": "달리면서, 엄지손가락의 살갗을 물어뜯는다."
    },
    {
     "sid": "da0110:T00067",
     "kind": "본문",
     "jp": "傷口から溢れる熱い血が、『世界』に向かって流れ込む。",
     "ko": "상처에서 넘쳐흐르는 뜨거운 피가, 『세계』를 향해 흘러든다."
    }
   ]
  },
  {
   "uid": "da0110:U00015",
   "speaker": "(지문)",
   "jp": "血こそ我が存在。我が〈ちから〉魔力の証明。我が魔術の源泉。",
   "cells": [
    {
     "sid": "da0110:T00068",
     "kind": "본문",
     "jp": "血こそ我が存在。",
     "ko": "피야말로 나의 존재."
    },
    {
     "sid": "da0110:T00069",
     "kind": "본문",
     "jp": "我が",
     "ko": "나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00019",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00070",
     "kind": "본문",
     "jp": "魔力",
     "ko": "마력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00071",
     "kind": "본문",
     "jp": "の証明。",
     "ko": "의 증명."
    },
    {
     "sid": "da0110:T00072",
     "kind": "본문",
     "jp": "我が魔術の源泉。",
     "ko": "나의 마술의 원천."
    }
   ]
  },
  {
   "uid": "da0110:U00016",
   "speaker": "九朔",
   "jp": "「――吹き荒め」",
   "cells": [
    {
     "sid": "da0110:T00073",
     "kind": "본문",
     "jp": "「――吹き荒め」",
     "ko": "「――휘몰아쳐라」"
    }
   ]
  },
  {
   "uid": "da0110:U00017",
   "speaker": "(지문)",
   "jp": "流れる血が〈かぜ〉血風と化し、〈はし〉疾走る我に纏わりながら併走する。血風の流れは二つ。極めて近い属性を持つ、双子のような二つの〈ちから〉魔力。\n\n　血風は凶風である。魔力は禍々しい気配を孕む。だが我が認識、我が血には、それを制御するための外道の知識\nが在る。\n\n　騎士の誇りと外道の知識を宿すこの血を以って、我は気高き道を\n征こう。",
   "cells": [
    {
     "sid": "da0110:T00074",
     "kind": "본문",
     "jp": "流れる血が",
     "ko": "흐르는 피가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00020",
     "kind": "루비 읽기",
     "jp": "かぜ",
     "ko": "바람",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00075",
     "kind": "본문",
     "jp": "血風",
     "ko": "혈풍",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00076",
     "kind": "본문",
     "jp": "と化し、",
     "ko": "으로 화하여, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00021",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00077",
     "kind": "본문",
     "jp": "疾走",
     "ko": "질주하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00078",
     "kind": "본문",
     "jp": "る我に纏わりながら併走する。",
     "ko": "는 나를 휘감으며 나란히 달린다."
    },
    {
     "sid": "da0110:T00079",
     "kind": "본문",
     "jp": "血風の流れは二つ。",
     "ko": "혈풍의 흐름은 두 줄기."
    },
    {
     "sid": "da0110:T00080",
     "kind": "본문",
     "jp": "極めて近い属性を持つ、双子のような二つの",
     "ko": "지극히 가까운 속성을 지닌, 쌍둥이 같은 두 개의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00022",
     "kind": "루비 읽기",
     "jp": "ちから",
     "ko": "힘",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00081",
     "kind": "본문",
     "jp": "魔力",
     "ko": "마력",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00082",
     "kind": "본문",
     "jp": "。\n\n　血風は凶風である。",
     "ko": ".\n\n　혈풍은 흉풍이다."
    },
    {
     "sid": "da0110:T00083",
     "kind": "본문",
     "jp": "魔力は禍々しい気配を孕む。",
     "ko": "마력은 불길한 기척을 품는다."
    },
    {
     "sid": "da0110:T00084",
     "kind": "본문",
     "jp": "だが我が認識、我が血には、それを制御するための外道の知識\nが在る。\n\n　騎士の誇りと外道の知識を宿すこの血を以って、我は気高き道を\n征こう。",
     "ko": "허나 나의 인식, 나의 피에는, 그것을 제어하기 위한 외도의 지식이 있다.\n\n　기사의 긍지와 외도의 지식이 깃든 이 피로써, 나는 고결한 길로\n나아가리라."
    }
   ]
  },
  {
   "uid": "da0110:U00018",
   "speaker": "九朔",
   "jp": "「――〈あらわ〉顕れ、〈い〉出でよ」",
   "cells": [
    {
     "sid": "da0110:T00085",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0110:R00023",
     "kind": "루비 읽기",
     "jp": "あらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00086",
     "kind": "본문",
     "jp": "顕",
     "ko": "모습을 드러내라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00087",
     "kind": "본문",
     "jp": "れ、",
     "ko": ", ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0110:R00024",
     "kind": "루비 읽기",
     "jp": "い",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00088",
     "kind": "본문",
     "jp": "出",
     "ko": "나오",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00089",
     "kind": "본문",
     "jp": "でよ」",
     "ko": "너라」"
    }
   ]
  },
  {
   "uid": "da0110:U00019",
   "speaker": "(지문)",
   "jp": "血風を包み込む魔術文字。曖昧で不定形な魔力の渦が、確かな存在を、質量を得る。二つの魔力を編んで構築されたそれは、金属の光沢を帯びていた。",
   "cells": [
    {
     "sid": "da0110:T00090",
     "kind": "본문",
     "jp": "血風を包み込む魔術文字。",
     "ko": "혈풍을 감싸는 마술문자."
    },
    {
     "sid": "da0110:T00091",
     "kind": "본문",
     "jp": "曖昧で不定形な魔力の渦が、確かな存在を、質量を得る。",
     "ko": "애매하고 부정형인 마력의 소용돌이가, 확실한 존재를, 질량을 얻는다."
    },
    {
     "sid": "da0110:T00092",
     "kind": "본문",
     "jp": "二つの魔力を編んで構築されたそれは、金属の光沢を帯びていた。",
     "ko": "두 개의 마력을 엮어 구축된 그것은, 금속의 광택을 띠고 있었다."
    }
   ]
  },
  {
   "uid": "da0110:U00020",
   "speaker": "九朔",
   "jp": "「〈はし〉飛翔れ！」",
   "cells": [
    {
     "sid": "da0110:T00093",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0110:R00025",
     "kind": "루비 읽기",
     "jp": "はし",
     "ko": "달려",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00094",
     "kind": "본문",
     "jp": "飛翔",
     "ko": "비상하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00095",
     "kind": "본문",
     "jp": "れ！」",
     "ko": "라!」"
    }
   ]
  },
  {
   "uid": "da0110:U00021",
   "speaker": "(지문)",
   "jp": "顕現したそれを掴み、振りかぶる。最大限の威力と魔力を乗せて、〈スウィング〉投擲。放たれた破壊力が、稲妻の如く〈はし〉迅る。",
   "cells": [
    {
     "sid": "da0110:T00096",
     "kind": "본문",
     "jp": "顕現したそれを掴み、振りかぶる。",
     "ko": "현현한 그것을 움켜잡고, 치켜든다."
    },
    {
     "sid": "da0110:T00097",
     "kind": "본문",
     "jp": "最大限の威力と魔力を乗せて、",
     "ko": "최대한의 위력과 마력을 실어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0110:R00026",
     "kind": "루비 읽기",
     "jp": "スウィング",
     "ko": "스윙",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0110:T00098",
     "kind": "본문",
     "jp": "投擲",
     "ko": "투척",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0110:T00099",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0110:T00100",
     "kind": "본문",
     "jp": "放たれた破壊力が、稲妻の如く",
     "ko": "방출된 파괴력이, 번개처럼 ",
     "ruby_edge": "뒤"
    },
