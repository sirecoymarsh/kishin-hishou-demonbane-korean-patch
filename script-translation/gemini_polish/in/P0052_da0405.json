{
 "packet": "P0052_da0405",
 "units": [
  {
   "uid": "da0405:U00071",
   "speaker": "アズラッド",
   "jp": "「……先程も言ったはずだ。\n　俺はこいつらと同じ存在だと」",
   "cells": [
    {
     "sid": "da0405:T00140",
     "kind": "본문",
     "jp": "「……先程も言ったはずだ。\n　俺はこいつらと同じ存在だと」",
     "ko": "「……아까도 말했을 텐데.\n　나는 이놈들과 같은 존재라고」"
    }
   ]
  },
  {
   "uid": "da0405:U00072",
   "speaker": "(지문)",
   "jp": "足元の焼け爛れた肉塊に視線を向けて、答える。汚穢な腐肉はもはや再生する気配を見せない。完全に静止していた。",
   "cells": [
    {
     "sid": "da0405:T00141",
     "kind": "본문",
     "jp": "足元の焼け爛れた肉塊に視線を向けて、答える。",
     "ko": "발밑의 불타 짓무른 고깃덩어리에 시선을 향하며 답한다."
    },
    {
     "sid": "da0405:T00142",
     "kind": "본문",
     "jp": "汚穢な腐肉はもはや再生する気配を見せない。",
     "ko": "더러운 썩은 살점은 더 이상 재생할 기미를 보이지 않는다."
    },
    {
     "sid": "da0405:T00143",
     "kind": "본문",
     "jp": "完全に静止していた。",
     "ko": "완전히 정지해 있었다."
    }
   ]
  },
  {
   "uid": "da0405:U00073",
   "speaker": "瑠璃",
   "jp": "「でも貴方は違います」",
   "cells": [
    {
     "sid": "da0405:T00144",
     "kind": "본문",
     "jp": "「でも貴方は違います」",
     "ko": "「하지만 당신은 다릅니다」"
    }
   ]
  },
  {
   "uid": "da0405:U00074",
   "speaker": "アズラッド",
   "jp": "「違わないさ。俺は単なる夢だ」",
   "cells": [
    {
     "sid": "da0405:T00145",
     "kind": "본문",
     "jp": "「違わないさ。俺は単なる夢だ」",
     "ko": "「다르지 않아. 나는 그저 꿈이다」"
    }
   ]
  },
  {
   "uid": "da0405:U00075",
   "speaker": "瑠璃",
   "jp": "「……夢？」",
   "cells": [
    {
     "sid": "da0405:T00146",
     "kind": "본문",
     "jp": "「……夢？」",
     "ko": "「……꿈?」"
    }
   ]
  },
  {
   "uid": "da0405:U00076",
   "speaker": "(지문)",
   "jp": "男の元に全ての偃月刀が集い、重なり、一本のステッキに戻った。続けて、空いた方の手に『アル・アジフ』が再び顕現する。\n\n　『アル・アジフ』は瑠璃から魔力を取り戻す。術衣が〈ページ〉頁になって〈ほど〉解け、書の中へと吸い込まれていく。",
   "cells": [
    {
     "sid": "da0405:T00147",
     "kind": "본문",
     "jp": "男の元に全ての偃月刀が集い、重なり、一本のステッキに戻った。",
     "ko": "남자의 손으로 모든 언월도가 모여들고, 겹쳐져, 한 자루의 스틱으로 돌아갔다."
    },
    {
     "sid": "da0405:T00148",
     "kind": "본문",
     "jp": "続けて、空いた方の手に『アル・アジフ』が再び顕現する。\n\n　『アル・アジフ』は瑠璃から魔力を取り戻す。",
     "ko": "이어서 빈 쪽의 손에 『알 아지프』가 다시 현현한다.\n\n　『알 아지프』는 루리에게서 마력을 되찾는다."
    },
    {
     "sid": "da0405:T00149",
     "kind": "본문",
     "jp": "術衣が",
     "ko": "술의가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00016",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00150",
     "kind": "본문",
     "jp": "頁",
     "ko": "책장이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00151",
     "kind": "본문",
     "jp": "になって",
     "ko": " 되어 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00017",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00152",
     "kind": "본문",
     "jp": "解",
     "ko": "풀어",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00153",
     "kind": "본문",
     "jp": "け、書の中へと吸い込まれていく。",
     "ko": "지고, 책 속으로 빨려 들어간다."
    }
   ]
  },
  {
   "uid": "da0405:U00077",
   "speaker": "アズラッド",
   "jp": "「この世界は『ネクロノミコン』を名乗る怪異\nの魔術と、『アル・アジフ』の記憶が合わさり、\n組み上げられた世界――〈うつしよ〉現世と夢幻の狭間にある世界だ」",
   "cells": [
    {
     "sid": "da0405:T00154",
     "kind": "본문",
     "jp": "「この世界は『ネクロノミコン』を名乗る怪異\nの魔術と、『アル・アジフ』の記憶が合わさり、\n組み上げられた世界――",
     "ko": "「이 세계는 『네크로노미콘』을 자칭하는 괴이의\n마술과, 『알 아지프』의 기억이 합쳐져\n짜인 세계――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00018",
     "kind": "루비 읽기",
     "jp": "うつしよ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00155",
     "kind": "본문",
     "jp": "現世",
     "ko": "현세",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00156",
     "kind": "본문",
     "jp": "と夢幻の狭間にある世界だ」",
     "ko": "와 몽환의 틈새에 있는 세계다」"
    }
   ]
  },
  {
   "uid": "da0405:U00078",
   "speaker": "アズラッド",
   "jp": "「あの怪異は現世を、自らの想い描く\n　『〈セカイ〉物語』に塗り替えようとしている」",
   "cells": [
    {
     "sid": "da0405:T00157",
     "kind": "본문",
     "jp": "「あの怪異は現世を、自らの想い描く\n　『",
     "ko": "「그 괴이는 현세를, 자신이 마음속에 그리는\n　『",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00019",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00158",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00159",
     "kind": "본문",
     "jp": "』に塗り替えようとしている」",
     "ko": "』로 덧칠하려 하고 있다」"
    }
   ]
  },
  {
   "uid": "da0405:U00079",
   "speaker": "(지문)",
   "jp": "術衣形態が解除される。だが瑠璃の格好はいつものものとは違う。",
   "cells": [
    {
     "sid": "da0405:T00160",
     "kind": "본문",
     "jp": "術衣形態が解除される。",
     "ko": "술의 형태가 해제된다."
    },
    {
     "sid": "da0405:T00161",
     "kind": "본문",
     "jp": "だが瑠璃の格好はいつものものとは違う。",
     "ko": "하지만 루리의 차림새는 평소와 다르다."
    }
   ]
  },
  {
   "uid": "da0405:U00080",
   "speaker": "瑠璃",
   "jp": "「……〈セカイ〉物語？」",
   "cells": [
    {
     "sid": "da0405:T00162",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0405:R00020",
     "kind": "루비 읽기",
     "jp": "セカイ",
     "ko": "세계",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00163",
     "kind": "본문",
     "jp": "物語",
     "ko": "이야기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00164",
     "kind": "본문",
     "jp": "？」",
     "ko": "?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0405:U00081",
   "speaker": "アズラッド",
   "jp": "「止めなければならない。\n　彼女――アル・アジフのためにも」",
   "cells": [
    {
     "sid": "da0405:T00165",
     "kind": "본문",
     "jp": "「止めなければならない。\n　彼女――アル・アジフのためにも」",
     "ko": "「막아야만 한다.\n　그 아이――알 아지프를 위해서도」"
    }
   ]
  },
  {
   "uid": "da0405:U00082",
   "speaker": "(지문)",
   "jp": "手にした『アル・アジフ』を閉じた。瑠璃に背を向けて、歩き出す。",
   "cells": [
    {
     "sid": "da0405:T00166",
     "kind": "본문",
     "jp": "手にした『アル・アジフ』を閉じた。",
     "ko": "손에 쥔 『알 아지프』를 덮었다."
    },
    {
     "sid": "da0405:T00167",
     "kind": "본문",
     "jp": "瑠璃に背を向けて、歩き出す。",
     "ko": "루리에게 등을 돌리고 걷기 시작한다."
    }
   ]
  },
  {
   "uid": "da0405:U00083",
   "speaker": "瑠璃",
   "jp": "「待って下さい！」",
   "cells": [
    {
     "sid": "da0405:T00168",
     "kind": "본문",
     "jp": "「待って下さい！」",
     "ko": "「기다려 주세요!」"
    }
   ]
  },
  {
   "uid": "da0405:U00084",
   "speaker": "アズラッド",
   "jp": "「もう大丈夫だ。\n　何故ならお前は――」",
   "cells": [
    {
     "sid": "da0405:T00169",
     "kind": "본문",
     "jp": "「もう大丈夫だ。\n　何故ならお前は――」",
     "ko": "「이제 괜찮다.\n　왜냐하면 너는――」"
    }
   ]
  },
  {
   "uid": "da0405:U00085",
   "speaker": "アズラッド",
   "jp": "「自分の為すべきことを\n　取り戻したのだから」",
   "cells": [
    {
     "sid": "da0405:T00170",
     "kind": "본문",
     "jp": "「自分の為すべきことを\n　取り戻したのだから」",
     "ko": "「자신이 해야 할 일을\n　되찾았으니까」"
    }
   ]
  },
  {
   "uid": "da0405:U00086",
   "speaker": "瑠璃",
   "jp": "「……！」",
   "cells": [
    {
     "sid": "da0405:T00171",
     "kind": "본문",
     "jp": "「……！」",
     "ko": "「……!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0405:U00087",
   "speaker": "(지문)",
   "jp": "一度も振り返らず、男は立ち去った。広間にはただ一人、瑠璃だけが残される。",
   "cells": [
    {
     "sid": "da0405:T00172",
     "kind": "본문",
     "jp": "一度も振り返らず、男は立ち去った。",
     "ko": "한 번도 뒤돌아보지 않고 남자는 떠나갔다."
    },
    {
     "sid": "da0405:T00173",
     "kind": "본문",
     "jp": "広間にはただ一人、瑠璃だけが残される。",
     "ko": "홀에는 단 한 사람, 루리만이 남겨진다."
    }
   ]
  },
  {
   "uid": "da0405:U00088",
   "speaker": "瑠璃",
   "jp": "「……為すべきこと」",
   "cells": [
    {
     "sid": "da0405:T00174",
     "kind": "본문",
     "jp": "「……為すべきこと」",
     "ko": "「……해야 할 일」"
    }
   ]
  },
  {
   "uid": "da0405:U00089",
   "speaker": "(지문)",
   "jp": "――司令服姿の瑠璃だけが。",
   "cells": [
    {
     "sid": "da0405:T00175",
     "kind": "본문",
     "jp": "――司令服姿の瑠璃だけが。",
     "ko": "――사령복 차림의 루리만이."
    }
   ]
  },
  {
   "uid": "da0405:U00090",
   "speaker": "瑠璃",
   "jp": "「ええ……分かっているわ」",
   "cells": [
    {
     "sid": "da0405:T00176",
     "kind": "본문",
     "jp": "「ええ……分かっているわ」",
     "ko": "「네…… 알고 있어요」"
    }
   ]
  },
  {
   "uid": "da0405:U00091",
   "speaker": "(지문)",
   "jp": "頭上を仰ぎ見る。生命の宿らぬ、無機物の〈ひとみ〉眸。〈はがね〉鋼鉄のバケモノが、見下ろしている。\n\n　そう。彼はバケモノだ。科学と魔術、機械と呪具、人と魔を組み合わせた〈メイド・イン・フランケンシュタイン〉継ぎ接ぎの巨人。この世のあらゆる邪悪を滅ぼすために生まれた、バケモノが\n恐れるバケモノだ。",
   "cells": [
    {
     "sid": "da0405:T00177",
     "kind": "본문",
     "jp": "頭上を仰ぎ見る。",
     "ko": "머리 위를 우러러본다."
    },
    {
     "sid": "da0405:T00178",
     "kind": "본문",
     "jp": "生命の宿らぬ、無機物の",
     "ko": "생명이 깃들지 않은, 무기물의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00021",
     "kind": "루비 읽기",
     "jp": "ひとみ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00179",
     "kind": "본문",
     "jp": "眸",
     "ko": "눈동자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00180",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0405:R00022",
     "kind": "루비 읽기",
     "jp": "はがね",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00181",
     "kind": "본문",
     "jp": "鋼鉄",
     "ko": "강철",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00182",
     "kind": "본문",
     "jp": "のバケモノが、見下ろしている。\n\n　そう。彼はバケモノだ。",
     "ko": "의 괴물이 내려다보고 있다.\n\n　그렇다. 그는 괴물이다."
    },
    {
     "sid": "da0405:T00183",
     "kind": "본문",
     "jp": "科学と魔術、機械と呪具、人と魔を組み合わせた",
     "ko": "과학과 마술, 기계와 주술 도구, 사람과 마를 조합한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0405:R00023",
     "kind": "루비 읽기",
     "jp": "メイド・イン・フランケンシュタイン",
     "ko": "메이드 인 프랑켄슈타인",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0405:T00184",
     "kind": "본문",
     "jp": "継ぎ接ぎの巨人",
     "ko": "짜깁기된 거인",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0405:T00185",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0405:T00186",
     "kind": "본문",
     "jp": "この世のあらゆる邪悪を滅ぼすために生まれた、バケモノが\n恐れるバケモノだ。",
     "ko": "이 세상의 온갖 사악을 멸하기 위해 태어난, 괴물이\n두려워하는 괴물이다."
    }
   ]
  },
  {
   "uid": "da0405:U00092",
   "speaker": "瑠璃",
   "jp": "「わたくしたちには力がある。\n　戦う力がある。そうでしょう？」",
   "cells": [
    {
     "sid": "da0405:T00187",
     "kind": "본문",
     "jp": "「わたくしたちには力がある。\n　戦う力がある。そうでしょう？」",
     "ko": "「저희에게는 힘이 있어요.\n　싸울 힘이 있어요. 그렇지요?」"
    }
   ]
  },
  {
   "uid": "da0405:U00093",
   "speaker": "(지문)",
   "jp": "彼女は識っている。バケモノの名を。彼は刻んでいる。己が名の意味を。\n\n　バケモノよ。汝は、憎悪に燃える空より産まれ落ちた涙。汝は、流された血を舐める炎に宿りし正しき怒り。汝は、無垢なる刃。\n\n　汝の名は――",
   "cells": [
    {
     "sid": "da0405:T00188",
     "kind": "본문",
     "jp": "彼女は識っている。",
     "ko": "그녀는 알고 있다."
    },
    {
     "sid": "da0405:T00189",
     "kind": "본문",
     "jp": "バケモノの名を。",
     "ko": "괴물의 이름을."
    },
    {
     "sid": "da0405:T00190",
     "kind": "본문",
     "jp": "彼は刻んでいる。",
     "ko": "그는 새기고 있다."
    },
    {
     "sid": "da0405:T00191",
     "kind": "본문",
     "jp": "己が名の意味を。\n\n　バケモノよ。",
     "ko": "자신의 이름의 의미를.\n\n　괴물이여."
    },
    {
     "sid": "da0405:T00192",
     "kind": "본문",
     "jp": "汝は、憎悪に燃える空より産まれ落ちた涙。",
     "ko": "그대는, 증오에 타오르는 하늘에서 태어나 떨어진 눈물."
    },
    {
     "sid": "da0405:T00193",
     "kind": "본문",
     "jp": "汝は、流された血を舐める炎に宿りし正しき怒り。",
     "ko": "그대는, 흘려진 피를 핥는 불꽃에 깃든 올바른 분노."
    },
    {
     "sid": "da0405:T00194",
     "kind": "본문",
     "jp": "汝は、無垢なる刃。\n\n　汝の名は――",
     "ko": "그대는, 무구한 칼날.\n\n　그대의 이름은――"
    }
   ]
  },
