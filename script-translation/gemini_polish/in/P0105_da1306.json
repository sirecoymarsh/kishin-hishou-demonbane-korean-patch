  {
   "uid": "da1306:U00014",
   "speaker": "ファーザー・ナイ",
   "jp": "「大十字九朔！　君もまた私の〈テーブル〉卓に着くか！\n　君の親と同じく、私のゲームに挑むか！」",
   "cells": [
    {
     "sid": "da1306:T00059",
     "kind": "본문",
     "jp": "「大十字九朔！　君もまた私の",
     "ko": "「다이쥬지 쿠자쿠!　그대 또한 나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00018",
     "kind": "루비 읽기",
     "jp": "テーブル",
     "ko": "테이블",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00060",
     "kind": "본문",
     "jp": "卓",
     "ko": "탁자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00061",
     "kind": "본문",
     "jp": "に着くか！\n　君の親と同じく、私のゲームに挑むか！」",
     "ko": "에 앉겠는가!\n　그대의 부모와 마찬가지로, 나의 게임에 도전하겠는가!」"
    }
   ]
  },
  {
   "uid": "da1306:U00015",
   "speaker": "九朔",
   "jp": "「ゲームだと！？」",
   "cells": [
    {
