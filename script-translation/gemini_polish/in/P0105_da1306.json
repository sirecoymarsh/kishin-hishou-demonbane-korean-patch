    }
   ]
  },
  {
   "uid": "da1306:U00019",
   "speaker": "ファーザー・ナイ",
   "jp": "「〈・・・・・・・〉私は何もしない。私はただ火をくべるだけだ――〈フェイト〉運命という名の〈たきぎ〉薪に、〈チャンス〉偶然という名の火種を！」",
   "cells": [
    {
     "sid": "da1306:T00072",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1306:R00022",
     "kind": "루비 읽기",
     "jp": "・・・・・・・",
     "ko": "・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00073",
     "kind": "본문",
     "jp": "私は何もしない",
     "ko": "나는 아무것도 하지 않는다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00074",
     "kind": "본문",
     "jp": "。私はただ火をくべるだけだ――",
     "ko": ". 나는 그저 불을 지필 뿐이다――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00023",
     "kind": "루비 읽기",
     "jp": "フェイト",
     "ko": "페이트라는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00075",
     "kind": "본문",
     "jp": "運命",
     "ko": "운명이라는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00076",
     "kind": "본문",
     "jp": "という名の",
     "ko": " 이름의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00024",
     "kind": "루비 읽기",
     "jp": "たきぎ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00077",
     "kind": "본문",
     "jp": "薪",
     "ko": "장작",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00078",
     "kind": "본문",
     "jp": "に、",
     "ko": "에, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00025",
     "kind": "루비 읽기",
     "jp": "チャンス",
     "ko": "찬스라는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00079",
     "kind": "본문",
     "jp": "偶然",
     "ko": "우연이라는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00080",
     "kind": "본문",
     "jp": "という名の火種を！」",
     "ko": " 이름의 불씨를!」"
    }
   ]
  },
  {
   "uid": "da1306:U00020",
   "speaker": "ナイア",
   "jp": "「そう、地獄の饗宴を〈もよお〉催すのは、いつだって人間だ！」",
   "cells": [
    {
     "sid": "da1306:T00081",
     "kind": "본문",
     "jp": "「そう、地獄の饗宴を",
     "ko": "「그래, 지옥의 향연을\n　",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00026",
     "kind": "루비 읽기",
     "jp": "もよお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00082",
     "kind": "본문",
     "jp": "催",
     "ko": "주최하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00083",
     "kind": "본문",
     "jp": "すのは、いつだって人間だ！」",
     "ko": "는 것은 언제나 인간이야!」"
    }
   ]
  },
  {
   "uid": "da1306:U00021",
   "speaker": "(지문)",
   "jp": "〈グレート・ウォー〉魔導大戦の時代。熾烈化する戦いが、大崩壊をもたらした。\n\n　『邪神招喚』儀式の失敗と暴走。その影響は世界全土に及んだ。",
   "cells": [
    {
     "sid": "da1306:R00027",
     "kind": "루비 읽기",
     "jp": "グレート・ウォー",
     "ko": "그레이트 워",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00084",
     "kind": "본문",
     "jp": "魔導大戦",
     "ko": "마도대전",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00085",
     "kind": "본문",
     "jp": "の時代。",
     "ko": "의 시대."
    },
    {
     "sid": "da1306:T00086",
     "kind": "본문",
     "jp": "熾烈化する戦いが、大崩壊をもたらした。\n\n　『邪神招喚』儀式の失敗と暴走。",
     "ko": "치열해지는 싸움이 대붕괴를 초래했다.\n\n　『사신소환』 의식의 실패와 폭주."
    },
    {
     "sid": "da1306:T00087",
     "kind": "본문",
     "jp": "その影響は世界全土に及んだ。",
     "ko": "그 영향은 세계 전역에 미쳤다."
    }
   ]
  },
  {
   "uid": "da1306:U00022",
   "speaker": "九朔",
   "jp": "「これは……！？」",
   "cells": [
    {
     "sid": "da1306:T00088",
     "kind": "본문",
     "jp": "「これは……！？」",
     "ko": "「이것은……!?」"
    }
   ]
  },
  {
   "uid": "da1306:U00023",
   "speaker": "ファーザー・ナイ",
   "jp": "「時空の狭間だ――暴走した神力の余波は\n　時空を引き裂き、世界を断絶させたのだ。\n　引き裂かれた世界は分岐し、孤立し、\n　異形の法則が支配する魔界と化した」",
   "cells": [
    {
     "sid": "da1306:T00089",
     "kind": "본문",
     "jp": "「時空の狭間だ――暴走した神力の余波は\n　時空を引き裂き、世界を断絶させたのだ。\n　引き裂かれた世界は分岐し、孤立し、\n　異形の法則が支配する魔界と化した」",
     "ko": "「시공의 틈새다――폭주한 신력의 여파는\n　시공을 찢어발겨, 세계를 단절시켰다.\n　찢어발겨진 세계는 분기하고 고립되어,\n　이형의 법칙이 지배하는 마계로 화했다」"
    }
   ]
  },
  {
   "uid": "da1306:U00024",
   "speaker": "九朔",
   "jp": "「世界が……引き裂かれた？」",
   "cells": [
    {
     "sid": "da1306:T00090",
     "kind": "본문",
     "jp": "「世界が……引き裂かれた？」",
     "ko": "「세계가…… 찢어발겨졌다고?」"
    }
   ]
  },
  {
   "uid": "da1306:U00025",
   "speaker": "ナイア",
   "jp": "「空間。時間。そして因果もが。\n　君もまた引き裂かれている……このように！」",
   "cells": [
    {
     "sid": "da1306:T00091",
     "kind": "본문",
     "jp": "「空間。時間。そして因果もが。\n　君もまた引き裂かれている……",
     "ko": "「공간. 시간. 그리고 인과마저도.\n　너 또한 찢어발겨져 있다……"
    },
    {
     "sid": "da1306:T00092",
     "kind": "본문",
     "jp": "このように！」",
     "ko": "이처럼!」"
    }
   ]
  },
  {
   "uid": "da1306:U00026",
   "speaker": "九朔",
   "jp": "「……ッ！？\n　ぐあああああああああ！」",
   "cells": [
    {
     "sid": "da1306:T00093",
     "kind": "본문",
     "jp": "「……ッ！？\n　ぐあああああああああ！」",
     "ko": "「……읏!?\n　그아아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da1306:U00027",
   "speaker": "(지문)",
   "jp": "少年の躰が血風となって〈ほど〉解ける。血風は無数の魔術文字で構成され、〈ヘビ〉文字列となって二重螺旋を\n描いた。〈カドゥケウス〉二重螺旋が九朔の躰から――\n　あるいは魂から――引き剥がされる。",
   "cells": [
    {
     "sid": "da1306:T00094",
     "kind": "본문",
     "jp": "少年の躰が血風となって",
     "ko": "소년의 몸이 혈풍이 되어 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00028",
     "kind": "루비 읽기",
     "jp": "ほど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00095",
     "kind": "본문",
     "jp": "解",
     "ko": "풀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00096",
     "kind": "본문",
     "jp": "ける。",
     "ko": "린다."
    },
    {
     "sid": "da1306:T00097",
     "kind": "본문",
     "jp": "血風は無数の魔術文字で構成され、",
     "ko": "혈풍은 무수한 마술 문자로 구성되어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00029",
     "kind": "루비 읽기",
     "jp": "ヘビ",
     "ko": "뱀",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00098",
     "kind": "본문",
     "jp": "文字列",
     "ko": "문자열",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00099",
     "kind": "본문",
     "jp": "となって二重螺旋を\n描いた。",
     "ko": "이 되어 이중나선을\n그렸다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00030",
     "kind": "루비 읽기",
     "jp": "カドゥケウス",
     "ko": "카두케우스가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00100",
     "kind": "본문",
     "jp": "二重螺旋",
     "ko": "이중나선이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00101",
     "kind": "본문",
     "jp": "が九朔の躰から――\n　あるいは魂から――引き剥がされる。",
     "ko": " 쿠자쿠의 몸에서――\n　혹은 영혼에서――뜯겨 나간다."
    }
   ]
  },
  {
   "uid": "da1306:U00028",
   "speaker": "九朔",
   "jp": "「がッ……はァ……\n　ハぁ……ハァ……」",
   "cells": [
    {
     "sid": "da1306:T00102",
     "kind": "본문",
     "jp": "「がッ……はァ……\n　ハぁ……ハァ……」",
     "ko": "「크악…… 하아……\n　하아…… 하아……」"
    }
   ]
  },
  {
   "uid": "da1306:U00029",
   "speaker": "(지문)",
   "jp": "躰と魂を引き裂かれた激痛に、膝を突く。息を荒げ苦しむ九朔の頬に、細い指が触れた。何事かと見上げる九朔の〈ヒスイ〉翡翠の瞳を、〈ヒイロ〉緋色の瞳が覗き込む。",
   "cells": [
    {
     "sid": "da1306:T00103",
     "kind": "본문",
     "jp": "躰と魂を引き裂かれた激痛に、膝を突く。",
     "ko": "몸과 영혼이 찢어발겨진 격통에 무릎을 꿇는다."
    },
    {
     "sid": "da1306:T00104",
     "kind": "본문",
     "jp": "息を荒げ苦しむ九朔の頬に、細い指が触れた。",
     "ko": "거친 숨을 몰아쉬며 괴로워하는 쿠자쿠의 뺨에 가느다란 손가락이 닿았다."
    },
    {
     "sid": "da1306:T00105",
     "kind": "본문",
     "jp": "何事かと見上げる九朔の",
     "ko": "무슨 일인가 싶어 올려다보는 쿠자쿠의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00031",
     "kind": "루비 읽기",
     "jp": "ヒスイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00106",
     "kind": "본문",
     "jp": "翡翠",
     "ko": "비취색",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00107",
     "kind": "본문",
     "jp": "の瞳を、",
     "ko": " 눈동자를, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00032",
     "kind": "루비 읽기",
     "jp": "ヒイロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00108",
     "kind": "본문",
     "jp": "緋色",
     "ko": "진홍색",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00109",
     "kind": "본문",
     "jp": "の瞳が覗き込む。",
     "ko": "의 눈동자가 들여다본다."
    }
   ]
  },
  {
   "uid": "da1306:U00030",
   "speaker": "九朔",
   "jp": "「……なっ」",
   "cells": [
    {
     "sid": "da1306:T00110",
     "kind": "본문",
     "jp": "「……なっ」",
     "ko": "「……뭣」"
    }
   ]
  },
  {
   "uid": "da1306:U00031",
   "speaker": "アナザーブラッド",
   "jp": "「――はじめまして、『我』よ」",
   "cells": [
    {
     "sid": "da1306:T00111",
     "kind": "본문",
     "jp": "「――はじめまして、『我』よ」",
     "ko": "「――처음 뵙겠습니다, 『나』여」"
    }
   ]
  },
  {
   "uid": "da1306:U00032",
   "speaker": "(지문)",
   "jp": "紅の二重螺旋が紅の少女を編み上げていた。甘い血の芳香を〈かす〉幽かに漂わせて、少女は少年を見つめていた。その姿は何処か〈おぼろ〉朧げで、酷く儚い。\n\n　その夢幻のような少女が、告げた。頬に触れた指を下ろし、少年の胸――少年の〈ハート〉心臓の上に手のひらを置いて、少女は、少年を呼んだのだ。\n\n　『我』と。『私自身』であると。",
   "cells": [
    {
     "sid": "da1306:T00112",
     "kind": "본문",
     "jp": "紅の二重螺旋が紅の少女を編み上げていた。",
     "ko": "붉은 이중나선이 붉은 소녀를 엮어 올리고 있었다."
    },
    {
     "sid": "da1306:T00113",
     "kind": "본문",
     "jp": "甘い血の芳香を",
     "ko": "달콤한 피의 향기를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00033",
     "kind": "루비 읽기",
     "jp": "かす",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00114",
     "kind": "본문",
     "jp": "幽",
     "ko": "어렴풋",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00115",
     "kind": "본문",
     "jp": "かに漂わせて、少女は少年を見つめていた。",
     "ko": "이 풍기며, 소녀는 소년을 바라보고 있었다."
    },
    {
     "sid": "da1306:T00116",
     "kind": "본문",
     "jp": "その姿は何処か",
     "ko": "그 모습은 어딘가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00034",
     "kind": "루비 읽기",
     "jp": "おぼろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00117",
     "kind": "본문",
     "jp": "朧",
     "ko": "아련",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00118",
     "kind": "본문",
     "jp": "げで、酷く儚い。\n\n　その夢幻のような少女が、告げた。",
     "ko": "하고, 지독히 덧없다.\n\n　그 몽환 같은 소녀가 고했다."
    },
    {
     "sid": "da1306:T00119",
     "kind": "본문",
     "jp": "頬に触れた指を下ろし、少年の胸――少年の",
     "ko": "뺨에 닿은 손가락을 내려 소년의 가슴――소년의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00035",
     "kind": "루비 읽기",
     "jp": "ハート",
     "ko": "하트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00120",
     "kind": "본문",
     "jp": "心臓",
     "ko": "심장",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00121",
     "kind": "본문",
     "jp": "の上に手のひらを置いて、少女は、少年を呼んだのだ。\n\n　『我』と。",
     "ko": " 위에 손바닥을 얹고서, 소녀는 소년을 불렀다.\n\n　『나』라고."
    },
    {
     "sid": "da1306:T00122",
     "kind": "본문",
     "jp": "『私自身』であると。",
     "ko": "『나 자신』이라고."
    }
   ]
  },
  {
   "uid": "da1306:U00033",
   "speaker": "九朔",
   "jp": "「……『我』？」",
   "cells": [
    {
     "sid": "da1306:T00123",
     "kind": "본문",
     "jp": "「……『我』？」",
     "ko": "「……『나』?」"
    }
   ]
  },
  {
   "uid": "da1306:U00034",
   "speaker": "ファーザー・ナイ",
   "jp": "「如何にも。〈・・〉それは『君』だ。『君』自身だ。引き裂かれ、分岐した『君』のもうひとつの可能性だ」",
   "cells": [
    {
     "sid": "da1306:T00124",
     "kind": "본문",
     "jp": "「如何にも。",
     "ko": "「그렇다. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00036",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00125",
     "kind": "본문",
     "jp": "それ",
     "ko": "그것",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00126",
     "kind": "본문",
     "jp": "は『君』だ。『君』自身だ。引き裂かれ、分岐した『君』のもうひとつの可能性だ」",
     "ko": "은 『그대』다. 『그대』 자신이다. 찢어발겨져 분기한 『그대』의 또 하나의 가능성이다」"
    }
   ]
  },
  {
   "uid": "da1306:U00035",
   "speaker": "九朔",
   "jp": "「どういう意味――ッッ！？ぐぅああァッっ！」",
   "cells": [
    {
     "sid": "da1306:T00127",
     "kind": "본문",
     "jp": "「どういう意味――",
     "ko": "「무슨 뜻이――"
    },
    {
     "sid": "da1306:T00128",
     "kind": "본문",
     "jp": "ッッ！？",
     "ko": "읏!?"
    },
    {
     "sid": "da1306:T00129",
     "kind": "본문",
     "jp": "ぐぅああァッっ！」",
     "ko": "그으아아앗!」"
    }
   ]
  },
  {
   "uid": "da1306:U00036",
   "speaker": "(지문)",
   "jp": "少女の手のひらが、少年の胸の〈なか〉内へと沈んだ。深く。深く。",
   "cells": [
    {
     "sid": "da1306:T00130",
     "kind": "본문",
     "jp": "少女の手のひらが、少年の胸の",
     "ko": "소녀의 손바닥이 소년의 가슴 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00037",
     "kind": "루비 읽기",
     "jp": "なか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00131",
     "kind": "본문",
     "jp": "内",
     "ko": "안",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00132",
     "kind": "본문",
     "jp": "へと沈んだ。",
     "ko": "으로 가라앉았다."
    },
    {
     "sid": "da1306:T00133",
     "kind": "본문",
     "jp": "深く。",
     "ko": "깊이."
    },
    {
     "sid": "da1306:T00134",
     "kind": "본문",
     "jp": "深く。",
     "ko": " 깊이."
    }
   ]
  },
  {
   "uid": "da1306:U00037",
   "speaker": "アナザーブラッド",
   "jp": "「はぁ……ああぁぁ……\n　アアアァァァァ――――ッ！」",
   "cells": [
    {
     "sid": "da1306:T00135",
     "kind": "본문",
     "jp": "「はぁ……ああぁぁ……\n　アアアァァァァ――――ッ！」",
     "ko": "「하아…… 아아아아……\n　아아아아아아아――――앗!」"
    }
   ]
  },
  {
   "uid": "da1306:U00038",
   "speaker": "九朔",
   "jp": "「ぐぅ……がぁあッ！ああああぁぁぁあああっ！」",
   "cells": [
    {
     "sid": "da1306:T00136",
     "kind": "본문",
     "jp": "「ぐぅ……がぁあッ！",
     "ko": "「그으…… 크아앗!"
    },
    {
     "sid": "da1306:T00137",
     "kind": "본문",
     "jp": "ああああぁぁぁあああっ！」",
     "ko": "아아아아아아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da1306:U00039",
   "speaker": "(지문)",
   "jp": "刺し／貫くのではなく、融け合い／蕩け合う。少女の存在が、少年の〈ハート〉中心に触れる。\n\n　戦慄が走るほどの一体感に打ち震えながら、少年と少女はひとつに繋がった。\n\n　その熱い恍惚を――互いの身を喰らい合うような〈アウリン〉一体感を――少年は――",
   "cells": [
    {
     "sid": "da1306:T00138",
     "kind": "본문",
     "jp": "刺し／貫くのではなく、融け合い／蕩け合う。",
     "ko": "찌르고/꿰뚫는 것이 아니라, 서로 녹아들고/녹아 섞인다."
    },
    {
     "sid": "da1306:T00139",
     "kind": "본문",
     "jp": "少女の存在が、少年の",
     "ko": "소녀의 존재가 소년의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00038",
     "kind": "루비 읽기",
     "jp": "ハート",
     "ko": "하트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00140",
     "kind": "본문",
     "jp": "中心",
     "ko": "중심",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00141",
     "kind": "본문",
     "jp": "に触れる。\n\n　戦慄が走るほどの一体感に打ち震えながら、少年と少女はひとつに繋がった。\n\n　その熱い恍惚を――",
     "ko": "에 닿는다.\n\n　전율이 일 정도의 일체감에 몸을 떨며, 소년과 소녀는 하나로 이어졌다.\n\n　그 뜨거운 황홀을――"
    },
    {
     "sid": "da1306:T00142",
     "kind": "본문",
     "jp": "互いの身を喰らい合うような",
     "ko": "서로의 몸을 탐하여 먹어 치우는 듯한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00039",
     "kind": "루비 읽기",
     "jp": "アウリン",
     "ko": "아우린",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00143",
     "kind": "본문",
     "jp": "一体感",
     "ko": "일체감",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00144",
     "kind": "본문",
     "jp": "を――",
     "ko": "을――"
    },
    {
     "sid": "da1306:T00145",
     "kind": "본문",
     "jp": "少年は――",
     "ko": "소년은――"
    }
   ]
  },
  {
   "uid": "da1306:U00040",
   "speaker": "九朔",
   "jp": "「く……ッ……！」",
   "cells": [
    {
     "sid": "da1306:T00146",
     "kind": "본문",
     "jp": "「く……ッ……！」",
     "ko": "「크…… 읏……!」"
    }
   ]
  },
  {
   "uid": "da1306:U00041",
   "speaker": "アナザーブラッド",
   "jp": "「はぁ……ぁぁぁ……」",
   "cells": [
    {
     "sid": "da1306:T00147",
     "kind": "본문",
     "jp": "「はぁ……ぁぁぁ……」",
     "ko": "「하아…… 아아아……」"
    }
   ]
  },
  {
   "uid": "da1306:U00042",
   "speaker": "九朔",
   "jp": "「や……」",
   "cells": [
    {
     "sid": "da1306:T00148",
     "kind": "본문",
     "jp": "「や……」",
     "ko": "「그……」"
    }
   ]
  },
  {
   "uid": "da1306:U00043",
   "speaker": "アナザーブラッド",
   "jp": "「……ぁ……ぁぁぁ……」",
   "cells": [
    {
     "sid": "da1306:T00149",
     "kind": "본문",
     "jp": "「……ぁ……ぁぁぁ……」",
     "ko": "「……아…… 아아아……」"
    }
   ]
  },
  {
   "uid": "da1306:U00044",
   "speaker": "九朔",
   "jp": "「やめ……ろ……」",
   "cells": [
    {
     "sid": "da1306:T00150",
     "kind": "본문",
     "jp": "「やめ……ろ……」",
     "ko": "「그만…… 둬……」"
    }
   ]
  },
  {
   "uid": "da1306:U00045",
   "speaker": "アナザーブラッド",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da1306:T00151",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1306:U00046",
   "speaker": "九朔",
   "jp": "「やめろッッッッ！」",
   "cells": [
    {
     "sid": "da1306:T00152",
     "kind": "본문",
     "jp": "「やめろッッッッ！」",
     "ko": "「그만둬어어어엇!」"
    }
   ]
  },
  {
   "uid": "da1306:U00047",
   "speaker": "アナザーブラッド",
   "jp": "「！？　――ッぁぁ！」",
   "cells": [
    {
     "sid": "da1306:T00153",
     "kind": "본문",
     "jp": "「！？　――ッぁぁ！」",
     "ko": "「!?　――으아아!」"
    }
   ]
  },
  {
   "uid": "da1306:U00048",
   "speaker": "(지문)",
   "jp": "拒絶した。全力で少女を突き飛ばす。少女の手が引き抜かれたとき、またしても身を裂かれるような激痛が彼を襲う。",
   "cells": [
    {
     "sid": "da1306:T00154",
     "kind": "본문",
     "jp": "拒絶した。",
     "ko": "거부했다."
    },
    {
     "sid": "da1306:T00155",
     "kind": "본문",
     "jp": "全力で少女を突き飛ばす。",
     "ko": "전력으로 소녀를 밀쳐 낸다."
    },
    {
     "sid": "da1306:T00156",
     "kind": "본문",
     "jp": "少女の手が引き抜かれたとき、またしても身を裂かれるような激痛が彼を襲う。",
     "ko": "소녀의 손이 뽑혀 나왔을 때, 또다시 몸이 찢기는 듯한 격통이 그를 덮친다."
    }
   ]
  },
  {
   "uid": "da1306:U00049",
   "speaker": "(지문)",
   "jp": "少年はその苦痛こそを、自らの怒りに動機付けた。仇敵を見るかのような視線を、少女にぶつける。",
   "cells": [
    {
     "sid": "da1306:T00157",
     "kind": "본문",
     "jp": "少年はその苦痛こそを、自らの怒りに動機付けた。",
     "ko": "소년은 그 고통이야말로 자신의 분노의 동기로 삼았다."
    },
    {
     "sid": "da1306:T00158",
     "kind": "본문",
     "jp": "仇敵を見るかのような視線を、少女にぶつける。",
     "ko": "원수를 보는 듯한 시선을 소녀에게 꽂는다."
    }
   ]
  },
  {
   "uid": "da1306:U00050",
   "speaker": "アナザーブラッド",
   "jp": "「……ぁ……？」",
   "cells": [
    {
     "sid": "da1306:T00159",
     "kind": "본문",
     "jp": "「……ぁ……？」",
     "ko": "「……아……?」"
    }
   ]
  },
  {
   "uid": "da1306:U00051",
   "speaker": "(지문)",
   "jp": "尻餅を突いた少女は何が起こったのかも解からず、ただ呆然と少年を見上げていた。",
   "cells": [
    {
     "sid": "da1306:T00160",
     "kind": "본문",
     "jp": "尻餅を突いた少女は何が起こったのかも解からず、ただ呆然と少年を見上げていた。",
     "ko": "엉덩방아를 찧은 소녀는 무슨 일이 일어났는지도 모른 채, 그저 멍하니 소년을 올려다보고 있었다."
    }
   ]
  },
  {
   "uid": "da1306:U00052",
   "speaker": "(지문)",
   "jp": "しかし、やがて自分を睨みつける翡翠の瞳の奥に答えを識る。焦点のない、茫漠とした〈ルビー〉紅玉の瞳に、理解が宿る。",
   "cells": [
    {
     "sid": "da1306:T00161",
     "kind": "본문",
     "jp": "しかし、やがて自分を睨みつける翡翠の瞳の奥に答えを識る。",
     "ko": "그러나 이윽고 자신을 노려보는 비취색 눈동자 안쪽에서 답을 안다."
    },
    {
     "sid": "da1306:T00162",
     "kind": "본문",
     "jp": "焦点のない、茫漠とした",
     "ko": "초점 없는, 아득한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00040",
     "kind": "루비 읽기",
     "jp": "ルビー",
     "ko": "루비",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00163",
     "kind": "본문",
     "jp": "紅玉",
     "ko": "홍옥",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00164",
     "kind": "본문",
     "jp": "の瞳に、理解が宿る。",
     "ko": "의 눈동자에 이해가 깃든다."
    }
   ]
  },
  {
   "uid": "da1306:U00053",
   "speaker": "アナザーブラッド",
   "jp": "「は……はは……」",
   "cells": [
    {
     "sid": "da1306:T00165",
     "kind": "본문",
     "jp": "「は……はは……」",
     "ko": "「하…… 하하……」"
    }
   ]
  },
  {
   "uid": "da1306:U00054",
   "speaker": "(지문)",
   "jp": "零れ落ちたのは、〈わら〉嗤いだった。",
   "cells": [
    {
     "sid": "da1306:T00166",
     "kind": "본문",
     "jp": "零れ落ちたのは、",
     "ko": "흘러나온 것은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00041",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00167",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00168",
     "kind": "본문",
     "jp": "いだった。",
     "ko": "음이었다."
    }
   ]
  },
  {
   "uid": "da1306:U00055",
   "speaker": "アナザーブラッド",
   "jp": "「はは……あはっ……はははは……」",
   "cells": [
    {
     "sid": "da1306:T00169",
     "kind": "본문",
     "jp": "「はは……あはっ……はははは……」",
     "ko": "「하하…… 아핫…… 하하하하……」"
    }
   ]
  },
  {
   "uid": "da1306:U00056",
   "speaker": "アナザーブラッド",
   "jp": "「あははっ、ははは、はははははははっ！」",
   "cells": [
    {
     "sid": "da1306:T00170",
     "kind": "본문",
     "jp": "「あははっ、ははは、はははははははっ！」",
     "ko": "「아하핫, 하하하, 하하하하하하핫!」"
    }
   ]
  },
  {
   "uid": "da1306:U00057",
   "speaker": "九朔",
   "jp": "「何が可笑しいッ！？」",
   "cells": [
    {
     "sid": "da1306:T00171",
     "kind": "본문",
     "jp": "「何が可笑しいッ！？」",
     "ko": "「무엇이 우스우냐!?」"
    }
   ]
  },
  {
   "uid": "da1306:U00058",
   "speaker": "(지문)",
   "jp": "ぴたりと笑い声が止まる。瞳がすぅ……と細められる。不敵な、だけど何処か陶然とした、紅い、紅い瞳が。",
   "cells": [
    {
     "sid": "da1306:T00172",
     "kind": "본문",
     "jp": "ぴたりと笑い声が止まる。",
     "ko": "딱 하고 웃음소리가 멎는다."
    },
    {
     "sid": "da1306:T00173",
     "kind": "본문",
     "jp": "瞳がすぅ……と細められる。",
     "ko": "눈동자가 스으…… 하고 가늘어진다."
    },
    {
     "sid": "da1306:T00174",
     "kind": "본문",
     "jp": "不敵な、だけど何処か陶然とした、紅い、紅い瞳が。",
     "ko": "대담한, 하지만 어딘가 도취된, 붉고 붉은 눈동자가."
    }
   ]
  },
  {
   "uid": "da1306:U00059",
   "speaker": "アナザーブラッド",
   "jp": "「『わたし』が、そんなに、こわいの？」",
   "cells": [
    {
     "sid": "da1306:T00175",
     "kind": "본문",
     "jp": "「『わたし』が、そんなに、こわいの？」",
     "ko": "「『나』가, 그렇게나, 무서워?」"
    }
   ]
  },
  {
   "uid": "da1306:U00060",
   "speaker": "九朔",
   "jp": "「……ッッ！？　ほざくか、化け物！」",
   "cells": [
    {
     "sid": "da1306:T00176",
     "kind": "본문",
     "jp": "「……ッッ！？　ほざくか、化け物！」",
     "ko": "「……읏!?　지껄이느냐, 괴물!」"
    }
   ]
  },
  {
   "uid": "da1306:U00061",
   "speaker": "アナザーブラッド",
   "jp": "「バケモノ、ではないわ。\n　『わたし』は『我』。\n　わたしは、あなた」",
   "cells": [
    {
     "sid": "da1306:T00177",
     "kind": "본문",
     "jp": "「バケモノ、ではないわ。\n　『わたし』は『我』。\n　わたしは、あなた」",
     "ko": "「괴물이, 아니야.\n　『나』는 『나』.\n　나는, 당신」"
    }
   ]
  },
  {
   "uid": "da1306:U00062",
   "speaker": "アナザーブラッド",
   "jp": "「そうだ……そうだ……そうだ！\n　わたしは、おまえだ！\n　お前の……別のモノガタリだ！\n　わたしは――」",
   "cells": [
    {
     "sid": "da1306:T00178",
     "kind": "본문",
     "jp": "「そうだ……そうだ……そうだ！\n　わたしは、おまえだ！\n　お前の……別のモノガタリだ！\n　わたしは――」",
     "ko": "「그래…… 그래…… 그렇다!\n　나는, 너다!\n　너의…… 다른 이야기다!\n　나는――」"
    }
   ]
  },
  {
   "uid": "da1306:U00063",
   "speaker": "アナザーブラッド",
   "jp": "「私はお前の悪だ！\n　悪を為すお前の可能性だ！\n　大十字九朔！」",
   "cells": [
    {
     "sid": "da1306:T00179",
     "kind": "본문",
     "jp": "「私はお前の悪だ！\n　悪を為すお前の可能性だ！\n　大十字九朔！」",
     "ko": "「나는 너의 악이다!\n　악을 행하는 너의 가능성이다!\n　다이쥬지 쿠자쿠!」"
    }
   ]
  },
  {
   "uid": "da1306:U00064",
   "speaker": "九朔",
   "jp": "「ふ……〈ふざけ〉巫山戯るなァァァァ！」",
   "cells": [
    {
     "sid": "da1306:T00180",
     "kind": "본문",
     "jp": "「ふ……",
     "ko": "「우…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00042",
     "kind": "루비 읽기",
     "jp": "ふざけ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00181",
     "kind": "본문",
     "jp": "巫山戯",
     "ko": "웃기지",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00182",
     "kind": "본문",
     "jp": "るなァァァァ！」",
     "ko": " 마라아아아아!」"
    }
   ]
  },
  {
   "uid": "da1306:U00065",
   "speaker": "(지문)",
   "jp": "少年の掌で〈アザトース〉字祷子が結晶、双剣が握られる。本気の斬撃が少女に振り下ろされる。",
   "cells": [
    {
     "sid": "da1306:T00183",
     "kind": "본문",
     "jp": "少年の掌で",
     "ko": "소년의 손바닥에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00043",
     "kind": "루비 읽기",
     "jp": "アザトース",
     "ko": "아자토스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00184",
     "kind": "본문",
     "jp": "字祷子",
     "ko": "자도자",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00185",
     "kind": "본문",
     "jp": "が結晶、双剣が握られる。",
     "ko": "가 결정화되어, 쌍검이 쥐어진다."
    },
    {
     "sid": "da1306:T00186",
     "kind": "본문",
     "jp": "本気の斬撃が少女に振り下ろされる。",
     "ko": "진심이 담긴 참격이 소녀에게 내리쳐진다."
    }
   ]
  },
  {
   "uid": "da1306:U00066",
   "speaker": "(지문)",
   "jp": "刃は虚しく空を切る。紅の風、血の芳香を幽かに残して、少女の姿は霧のように散った。",
   "cells": [
    {
     "sid": "da1306:T00187",
     "kind": "본문",
     "jp": "刃は虚しく空を切る。",
     "ko": "칼날은 허무하게 허공을 가른다."
    },
    {
     "sid": "da1306:T00188",
     "kind": "본문",
     "jp": "紅の風、血の芳香を幽かに残して、少女の姿は霧のように散った。",
     "ko": "붉은 바람, 피의 향기를 어렴풋이 남기고 소녀의 모습은 안개처럼 흩어졌다."
    }
   ]
  },
  {
   "uid": "da1306:U00067",
   "speaker": "九朔",
   "jp": "「くっ……何処だッ！？」",
   "cells": [
    {
     "sid": "da1306:T00189",
     "kind": "본문",
     "jp": "「くっ……何処だッ！？」",
     "ko": "「크윽…… 어디냐!?」"
    }
   ]
  },
  {
   "uid": "da1306:U00068",
   "speaker": "ナイア",
   "jp": "「さぁて……駒は揃った」",
   "cells": [
    {
     "sid": "da1306:T00190",
     "kind": "본문",
     "jp": "「さぁて……駒は揃った」",
     "ko": "「자아…… 말은 다 모였다」"
    }
   ]
  },
  {
   "uid": "da1306:U00069",
   "speaker": "九朔",
   "jp": "「――――ッ！」",
   "cells": [
    {
     "sid": "da1306:T00191",
     "kind": "본문",
     "jp": "「――――ッ！」",
     "ko": "「――――읏!」"
    }
   ]
  },
  {
   "uid": "da1306:U00070",
   "speaker": "(지문)",
   "jp": "巨大な歯車が動く、重い音が聴こえた。少年の眼前に、巨大な紅の螺旋が渦を巻く。\n\n\n　紅の竜巻に呑み込まれて廻る、螺子／歯車／発条／配管／鉄骨／導線／装甲――組み合わさり、噛み合わされ、築き上げられていく。",
   "cells": [
    {
     "sid": "da1306:T00192",
     "kind": "본문",
     "jp": "巨大な歯車が動く、重い音が聴こえた。",
     "ko": "거대한 톱니바퀴가 움직이는 무거운 소리가 들렸다."
    },
    {
     "sid": "da1306:T00193",
     "kind": "본문",
     "jp": "少年の眼前に、巨大な紅の螺旋が渦を巻く。\n\n\n　紅の竜巻に呑み込まれて廻る、螺子／歯車／発条／配管／鉄骨／導線／装甲――組み合わさり、噛み合わされ、築き上げられていく。",
     "ko": "소년의 눈앞에 거대한 붉은 나선이 소용돌이친다.\n\n\n　붉은 회오리에 집어삼켜져 도는 나사/톱니바퀴/태엽/배관/철골/도선/장갑――서로 맞물리고 조립되어 구축되어 간다."
    }
   ]
  }
 ]
}