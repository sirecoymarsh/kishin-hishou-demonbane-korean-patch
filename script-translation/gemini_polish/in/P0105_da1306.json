     "kind": "본문",
     "jp": "「ゲームだと！？」",
     "ko": "「게임이라고!?」"
    }
   ]
  },
  {
   "uid": "da1306:U00016",
   "speaker": "ファーザー・ナイ",
   "jp": "「その通り……総ては〈ゲーム〉戯事だ。\n　我は世界を〈もてあそ〉玩ぶもの。我は――」",
   "cells": [
    {
     "sid": "da1306:T00063",
     "kind": "본문",
     "jp": "「その通り……総ては",
     "ko": "「그렇다…… 모든 것은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00019",
     "kind": "루비 읽기",
     "jp": "ゲーム",
     "ko": "게임",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00064",
     "kind": "본문",
     "jp": "戯事",
     "ko": "장난",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00065",
     "kind": "본문",
     "jp": "だ。\n　我は世界を",
     "ko": "이다.\n　나는 세계를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1306:R00020",
     "kind": "루비 읽기",
     "jp": "もてあそ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1306:T00066",
     "kind": "본문",
     "jp": "玩",
     "ko": "가지고 노",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1306:T00067",
     "kind": "본문",
     "jp": "ぶもの。我は――」",
     "ko": "는 자. 나는――」"
    }
   ]
  },
  {
   "uid": "da1306:U00017",
   "speaker": "ナイア",
   "jp": "「――我は〈ゲームキーパー〉玩具支配者なれば」",
   "cells": [
    {
