{
 "packet": "P0027_da0203",
 "units": [
  {
   "uid": "da0203:U00001",
   "speaker": "(지문)",
   "jp": "紅い剣閃。血刃から〈しぶ〉飛沫く血風は、雨になって街を染める。街はみるみる引き裂かれ、瓦礫が宙高く飛ぶ。\n\n　このままでは、デモンベインによる被害は拡がる一方だ。何とかしないと……！",
   "cells": [
    {
     "sid": "da0203:T00001",
     "kind": "본문",
     "jp": "紅い剣閃。",
     "ko": "붉은 검섬."
    },
    {
     "sid": "da0203:T00002",
     "kind": "본문",
     "jp": "血刃から",
     "ko": "혈인에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00001",
     "kind": "루비 읽기",
     "jp": "しぶ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00003",
     "kind": "본문",
     "jp": "飛沫",
     "ko": "튀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00004",
     "kind": "본문",
     "jp": "く血風は、雨になって街を染める。",
     "ko": "는 피바람은, 비가 되어 거리를 물들인다."
    },
    {
     "sid": "da0203:T00005",
     "kind": "본문",
     "jp": "街はみるみる引き裂かれ、瓦礫が宙高く飛ぶ。\n\n　このままでは、デモンベインによる被害は拡がる一方だ。",
     "ko": "거리는 순식간에 찢겨 나가고, 잔해가 허공 높이 날아오른다.\n\n　이대로는 데몬베인으로 인한 피해가 커지기만 할 뿐이다."
    },
    {
     "sid": "da0203:T00006",
     "kind": "본문",
     "jp": "何とかしないと……！",
     "ko": "어떻게든 하지 않으면……!"
    }
   ]
  },
  {
   "uid": "da0203:U00002",
   "speaker": "アル",
   "jp": "「デモンベインの頭だ」",
   "cells": [
    {
     "sid": "da0203:T00007",
     "kind": "본문",
     "jp": "「デモンベインの頭だ」",
     "ko": "「데몬베인의 머리다」"
    }
   ]
  },
  {
   "uid": "da0203:U00003",
   "speaker": "(지문)",
   "jp": "デモンベインの頭頂部には、まだあの紅い人影が立っている。あれだけ暴れているにも関わらず、振り落とされる気配はない。",
   "cells": [
    {
     "sid": "da0203:T00008",
     "kind": "본문",
     "jp": "デモンベインの頭頂部には、まだあの紅い人影が立っている。",
     "ko": "데몬베인의 정수리에는, 아직도 그 붉은 그림자가 서 있다."
    },
    {
     "sid": "da0203:T00009",
     "kind": "본문",
     "jp": "あれだけ暴れているにも関わらず、振り落とされる気配はない。",
     "ko": "저토록 날뛰고 있는데도 털려 떨어질 기색은 없다."
    }
   ]
  },
  {
   "uid": "da0203:U00004",
   "speaker": "アル",
   "jp": "「彼奴を押さえるぞ」",
   "cells": [
    {
     "sid": "da0203:T00010",
     "kind": "본문",
     "jp": "「彼奴を押さえるぞ」",
     "ko": "「저 녀석을 제압한다」"
    }
   ]
  },
  {
   "uid": "da0203:U00005",
   "speaker": "九郎",
   "jp": "「ああ……」\n\n　遠隔操作なのか、他に操縦者がいるのか分からないが、奴が\n関わっていることは間違いなさそうだ。\n\n　問題はどうやって接近するか――",
   "cells": [
    {
     "sid": "da0203:T00011",
     "kind": "본문",
     "jp": "「ああ……」\n\n　遠隔操作なのか、他に操縦者がいるのか分からないが、奴が\n関わっていることは間違いなさそうだ。\n\n　問題はどうやって接近するか――",
     "ko": "「그래……」\n\n　원격 조작인지, 다른 조종자가 있는 건지는 모르겠지만, 녀석이 관여하고 있는 건 틀림없어 보인다.\n\n　문제는 어떻게 접근하느냐인데――"
    }
   ]
  },
  {
   "uid": "da0203:U00006",
   "speaker": "九郎",
   "jp": "「一気に突っ込む！」",
   "cells": [
    {
     "sid": "da0203:T00012",
     "kind": "본문",
     "jp": "「一気に突っ込む！」",
     "ko": "「단숨에 파고든다!」"
    }
   ]
  },
  {
   "uid": "da0203:U00007",
   "speaker": "アル",
   "jp": "「正気か……」",
   "cells": [
    {
     "sid": "da0203:T00013",
     "kind": "본문",
     "jp": "「正気か……」",
     "ko": "「제정신이냐……」"
    }
   ]
  },
  {
   "uid": "da0203:U00008",
   "speaker": "(지문)",
   "jp": "マギウス・ウィングを支える魔力を全て推進力に変換。最大速度でデモンベインに突撃する。\n\n　血刃は完全に実体化された攻撃じゃない。斬撃の合間に生じる揺らぎを突けば――突破できる！",
   "cells": [
    {
     "sid": "da0203:T00014",
     "kind": "본문",
     "jp": "マギウス・ウィングを支える魔力を全て推進力に変換。",
     "ko": "마기우스 윙을 지탱하는 마력을 전부 추진력으로 변환."
    },
    {
     "sid": "da0203:T00015",
     "kind": "본문",
     "jp": "最大速度でデモンベインに突撃する。\n\n　血刃は完全に実体化された攻撃じゃない。",
     "ko": "최대 속도로 데몬베인에게 돌격한다.\n\n　혈인은 완전히 실체화된 공격이 아니다."
    },
    {
     "sid": "da0203:T00016",
     "kind": "본문",
     "jp": "斬撃の合間に生じる揺らぎを突けば――突破できる！",
     "ko": "참격과 참격 사이에 생기는 흔들림을 찌르면―― 돌파할 수 있어!"
    }
   ]
  },
  {
   "uid": "da0203:U00009",
   "speaker": "九郎",
   "jp": "「いけぇぇ――――――――――ッ！」",
   "cells": [
    {
     "sid": "da0203:T00017",
     "kind": "본문",
     "jp": "「いけぇぇ――――――――――ッ！」",
     "ko": "「가라아아――――――――――앗!」"
    }
   ]
  },
  {
   "uid": "da0203:U00010",
   "speaker": "アナザーブラッド",
   "jp": "「！？」",
   "cells": [
    {
     "sid": "da0203:T00018",
     "kind": "본문",
     "jp": "「！？」",
     "ko": "「!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0203:U00011",
   "speaker": "(지문)",
   "jp": "斬撃を繰り出し、次の斬撃に移る一瞬。振り切った血刃の、半ば液体、半ば気体と化している一点を狙う。",
   "cells": [
    {
     "sid": "da0203:T00019",
     "kind": "본문",
     "jp": "斬撃を繰り出し、次の斬撃に移る一瞬。",
     "ko": "참격을 날리고, 다음 참격으로 넘어가는 한순간."
    },
    {
     "sid": "da0203:T00020",
     "kind": "본문",
     "jp": "振り切った血刃の、半ば液体、半ば気体と化している一点を狙う。",
     "ko": "휘둘러 끝낸 혈인의, 반쯤 액체, 반쯤 기체로 화해 있는 한 점을 노린다."
    }
   ]
  },
  {
   "uid": "da0203:U00012",
   "speaker": "(지문)",
   "jp": "粘つく水の抵抗感。視界が紅に染まる。突撃のパワーと俺の魔力の前に血液は爆ぜ、血煙と化す。",
   "cells": [
    {
     "sid": "da0203:T00021",
     "kind": "본문",
     "jp": "粘つく水の抵抗感。",
     "ko": "끈적이는 물의 저항감."
    },
    {
     "sid": "da0203:T00022",
     "kind": "본문",
     "jp": "視界が紅に染まる。",
     "ko": "시야가 붉게 물든다."
    },
    {
     "sid": "da0203:T00023",
     "kind": "본문",
     "jp": "突撃のパワーと俺の魔力の前に血液は爆ぜ、血煙と化す。",
     "ko": "돌격의 파워와 내 마력 앞에 혈액은 터져 나가며 피안개로 화한다."
    }
   ]
  },
  {
   "uid": "da0203:U00013",
   "speaker": "(지문)",
   "jp": "血煙を裂いて、そのまま止まることなく突き進む。行く先にはデモンベインの頭頂部、紅い人影。",
   "cells": [
    {
     "sid": "da0203:T00024",
     "kind": "본문",
     "jp": "血煙を裂いて、そのまま止まることなく突き進む。",
     "ko": "피안개를 가르며, 그대로 멈추지 않고 돌진한다."
    },
    {
     "sid": "da0203:T00025",
     "kind": "본문",
     "jp": "行く先にはデモンベインの頭頂部、紅い人影。",
     "ko": "향하는 곳은 데몬베인의 정수리, 붉은 그림자."
    }
   ]
  },
  {
   "uid": "da0203:U00014",
   "speaker": "九郎",
   "jp": "「バルザイの偃月刀！」",
   "cells": [
    {
     "sid": "da0203:T00026",
     "kind": "본문",
     "jp": "「バルザイの偃月刀！」",
     "ko": "「바르자이 언월도!」"
    }
   ]
  },
  {
   "uid": "da0203:U00015",
   "speaker": "(지문)",
   "jp": "全身を濡らす血は、偃月刀招喚により生じた熱風によって蒸発。燃える偃月刀を手に取り、紅い影に斬りかかる。",
   "cells": [
    {
     "sid": "da0203:T00027",
     "kind": "본문",
     "jp": "全身を濡らす血は、偃月刀招喚により生じた熱風によって蒸発。",
     "ko": "전신을 적신 피는 언월도 소환으로 발생한 열풍에 증발."
    },
    {
     "sid": "da0203:T00028",
     "kind": "본문",
     "jp": "燃える偃月刀を手に取り、紅い影に斬りかかる。",
     "ko": "불타는 언월도를 손에 쥐고 붉은 그림자에게 베어든다."
    }
   ]
  },
  {
   "uid": "da0203:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「きゃあっ」",
   "cells": [
    {
     "sid": "da0203:T00029",
     "kind": "본문",
     "jp": "「きゃあっ」",
     "ko": "「꺄악」"
    }
   ]
  },
  {
   "uid": "da0203:U00017",
   "speaker": "(지문)",
   "jp": "紅い影はデモンベインの頭頂部から飛び退き、その一撃を躱す。そのまま、ふわりとデモンベインの胸部に舞い降りた。",
   "cells": [
    {
     "sid": "da0203:T00030",
     "kind": "본문",
     "jp": "紅い影はデモンベインの頭頂部から飛び退き、その一撃を躱す。",
     "ko": "붉은 그림자는 데몬베인의 정수리에서 뒤로 뛰어 물러나며 그 일격을 피한다."
    },
    {
     "sid": "da0203:T00031",
     "kind": "본문",
     "jp": "そのまま、ふわりとデモンベインの胸部に舞い降りた。",
     "ko": "그대로 사뿐히 데몬베인의 흉부에 내려앉았다."
    }
   ]
  },
  {
   "uid": "da0203:U00018",
   "speaker": "九郎",
   "jp": "「チッ……」",
   "cells": [
    {
     "sid": "da0203:T00032",
     "kind": "본문",
     "jp": "「チッ……」",
     "ko": "「칫……」"
    }
   ]
  },
  {
   "uid": "da0203:U00019",
   "speaker": "(지문)",
   "jp": "俺も続けて、デモンベインの胸部に着地する。",
   "cells": [
    {
     "sid": "da0203:T00033",
     "kind": "본문",
     "jp": "俺も続けて、デモンベインの胸部に着地する。",
     "ko": "나도 이어서 데몬베인의 흉부에 착지한다."
    }
   ]
  },
  {
   "uid": "da0203:U00020",
   "speaker": "(지문)",
   "jp": "紅い影――\n　『ネクロノミコン血液言語版』と名乗る少女と初めて対峙する。\n\n　紅い少女だ。身に纏うドレスも、髪の色も、瞳の色も全てが紅。確かに『血』を冠するに相応しい姿だ。\n\n　そして……何処となく、アルに似ている。彼女が名乗るとおり『ネクロノミコン』だから――なのか。",
   "cells": [
    {
     "sid": "da0203:T00034",
     "kind": "본문",
     "jp": "紅い影――\n　『ネクロノミコン血液言語版』と名乗る少女と初めて対峙する。\n\n　紅い少女だ。",
     "ko": "붉은 그림자――\n　『네크로노미콘 혈액언어판』이라 자칭하는 소녀와 처음으로 대치한다.\n\n　붉은 소녀다."
    },
    {
     "sid": "da0203:T00035",
     "kind": "본문",
     "jp": "身に纏うドレスも、髪の色も、瞳の色も全てが紅。",
     "ko": "몸에 두른 드레스도, 머리칼 색도, 눈동자 색도 전부가 진홍빛."
    },
    {
     "sid": "da0203:T00036",
     "kind": "본문",
     "jp": "確かに『血』を冠するに相応しい姿だ。\n\n　そして……何処となく、アルに似ている。",
     "ko": "확실히 『피』라는 이름을 달기에 걸맞은 모습이다.\n\n　그리고…… 어딘가 모르게, 알을 닮았다."
    },
    {
     "sid": "da0203:T00037",
     "kind": "본문",
     "jp": "彼女が名乗るとおり『ネクロノミコン』だから――なのか。",
     "ko": "그녀가 자칭한 대로 『네크로노미콘』이기 때문――인가."
    }
   ]
  },
  {
   "uid": "da0203:U00021",
   "speaker": "九郎",
   "jp": "「デモンベインを止めてもらうぜ」言って、俺は偃月刀を身構える。しかし少女に緊張はない。むしろ頬を朱に染め、華やかな微笑みを浮かべている。",
   "cells": [
    {
     "sid": "da0203:T00038",
     "kind": "본문",
     "jp": "「デモンベインを止めてもらうぜ」",
     "ko": "「데몬베인을 멈춰 줘야겠어」"
    },
    {
     "sid": "da0203:T00039",
     "kind": "본문",
     "jp": "言って、俺は偃月刀を身構える。",
     "ko": "말하며, 나는 언월도를 고쳐 쥔다."
    },
    {
     "sid": "da0203:T00040",
     "kind": "본문",
     "jp": "しかし少女に緊張はない。",
     "ko": "그러나 소녀에게 긴장감은 없다."
    },
    {
     "sid": "da0203:T00041",
     "kind": "본문",
     "jp": "むしろ頬を朱に染め、華やかな微笑みを浮かべている。",
     "ko": "오히려 뺨을 붉게 물들이며 화려한 미소를 띠고 있다."
    }
   ]
  },
  {
   "uid": "da0203:U00022",
   "speaker": "アナザーブラッド",
   "jp": "「思っていたとおり綺麗な〈ひと〉男性なのね、\n　マスター・オブ・ネクロノミコン。嬉しいわ」",
   "cells": [
    {
     "sid": "da0203:T00042",
     "kind": "본문",
     "jp": "「思っていたとおり綺麗な",
     "ko": "「생각했던 대로 예쁜 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00002",
     "kind": "루비 읽기",
     "jp": "ひと",
     "ko": "사람",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00043",
     "kind": "본문",
     "jp": "男性",
     "ko": "남성",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00044",
     "kind": "본문",
     "jp": "なのね、\n　マスター・オブ・ネクロノミコン。嬉しいわ」",
     "ko": "이네,\n　마스터 오브 네크로노미콘. 기뻐라」"
    }
   ]
  },
  {
   "uid": "da0203:U00023",
   "speaker": "九郎",
   "jp": "「……なに言い出しやがる」",
   "cells": [
    {
     "sid": "da0203:T00045",
     "kind": "본문",
     "jp": "「……なに言い出しやがる」",
     "ko": "「……무슨 뚱딴지같은 소리야」"
    }
   ]
  },
  {
   "uid": "da0203:U00024",
   "speaker": "アル",
   "jp": "「敵のペースに呑まれるなよ、九郎」",
   "cells": [
    {
     "sid": "da0203:T00046",
     "kind": "본문",
     "jp": "「敵のペースに呑まれるなよ、九郎」",
     "ko": "「적의 페이스에 말려들지 마라, 쿠로」"
    }
   ]
  },
  {
   "uid": "da0203:U00025",
   "speaker": "アナザーブラッド",
   "jp": "「そんな〈センスな〉格好悪い〈スーツ〉術衣を着ていなければ、\n　もっと素敵なのだけど」",
   "cells": [
    {
     "sid": "da0203:T00047",
     "kind": "본문",
     "jp": "「そんな",
     "ko": "「그런 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00003",
     "kind": "루비 읽기",
     "jp": "センスな",
     "ko": "센스 없",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
