    }
   ]
  },
  {
   "uid": "da0203:U00026",
   "speaker": "アル",
   "jp": "「にゃにおうっ！？」",
   "cells": [
    {
     "sid": "da0203:T00052",
     "kind": "본문",
     "jp": "「にゃにおうっ！？」",
     "ko": "「뭐야아앗!?」"
    }
   ]
  },
  {
   "uid": "da0203:U00027",
   "speaker": "九郎",
   "jp": "「ペースに呑まれるなよ」",
   "cells": [
    {
     "sid": "da0203:T00053",
     "kind": "본문",
     "jp": "「ペースに呑まれるなよ」",
     "ko": "「페이스에 말려들지 마라」"
    }
   ]
  },
  {
   "uid": "da0203:U00028",
   "speaker": "アナザーブラッド",
   "jp": "「ねえ、探偵さん？」",
   "cells": [
    {
     "sid": "da0203:T00054",
     "kind": "본문",
     "jp": "「ねえ、探偵さん？」",
     "ko": "「있지, 탐정님?」"
    }
   ]
  },
  {
   "uid": "da0203:U00029",
   "speaker": "九郎",
   "jp": "「！？」",
   "cells": [
    {
     "sid": "da0203:T00055",
     "kind": "본문",
     "jp": "「！？」",
     "ko": "「!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0203:U00030",
   "speaker": "(지문)",
   "jp": "少女の姿が紅い風になって掻き消えた。気付けば、触れ合いそうなほど間近に、少女の貌が。潤んだ、〈いたずら〉悪戯な瞳が俺を覗き込む。",
   "cells": [
    {
     "sid": "da0203:T00056",
     "kind": "본문",
     "jp": "少女の姿が紅い風になって掻き消えた。",
     "ko": "소녀의 모습이 붉은 바람이 되어 감쪽같이 사라졌다."
    },
    {
     "sid": "da0203:T00057",
     "kind": "본문",
     "jp": "気付けば、触れ合いそうなほど間近に、少女の貌が。",
     "ko": "정신을 차려 보니, 닿을 듯이 가까운 코앞에 소녀의 얼굴이 있었다."
    },
    {
     "sid": "da0203:T00058",
     "kind": "본문",
     "jp": "潤んだ、",
     "ko": "촉촉이 젖은, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00005",
     "kind": "루비 읽기",
     "jp": "いたずら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00059",
     "kind": "본문",
     "jp": "悪戯",
     "ko": "장난기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00060",
     "kind": "본문",
     "jp": "な瞳が俺を覗き込む。",
     "ko": " 어린 눈동자가 나를 들여다본다."
    }
   ]
  },
  {
   "uid": "da0203:U00031",
   "speaker": "アナザーブラッド",
   "jp": "「お母様なんてポイしちゃって、\n　私の〈マスター〉御主人様にならない？」",
   "cells": [
    {
     "sid": "da0203:T00061",
     "kind": "본문",
     "jp": "「お母様なんてポイしちゃって、\n　私の",
     "ko": "「어머님 같은 건 홱 버려 버리고,\n　나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00006",
     "kind": "루비 읽기",
     "jp": "マスター",
     "ko": "마스터가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00062",
     "kind": "본문",
     "jp": "御主人様",
     "ko": "주인님이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00063",
     "kind": "본문",
     "jp": "にならない？」",
     "ko": " 되지 않을래?」"
    }
   ]
  },
  {
   "uid": "da0203:U00032",
   "speaker": "九郎",
   "jp": "「いつの間に……」",
   "cells": [
    {
     "sid": "da0203:T00064",
     "kind": "본문",
     "jp": "「いつの間に……」",
     "ko": "「어느 틈에……」"
    }
   ]
  },
  {
   "uid": "da0203:U00033",
   "speaker": "アル",
   "jp": "「こぉぉの……痴れ者がぁぁぁっ！」",
   "cells": [
    {
     "sid": "da0203:T00065",
     "kind": "본문",
     "jp": "「こぉぉの……痴れ者がぁぁぁっ！」",
     "ko": "「이이이…… 발칙한 것이이이잇!」"
    }
   ]
  },
  {
   "uid": "da0203:U00034",
   "speaker": "(지문)",
   "jp": "アルが術式に強制介入して、『アトラック＝ナチャ』を発動させる。俺の髪が急激に伸びて、四方八方から紅の少女に襲いかかる。",
   "cells": [
    {
     "sid": "da0203:T00066",
     "kind": "본문",
     "jp": "アルが術式に強制介入して、『アトラック＝ナチャ』を発動させる。",
     "ko": "알이 술식에 강제 개입하여, 『아틀락 나차』를 발동시킨다."
    },
    {
     "sid": "da0203:T00067",
     "kind": "본문",
     "jp": "俺の髪が急激に伸びて、四方八方から紅の少女に襲いかかる。",
     "ko": "내 머리카락이 급격하게 자라나 사방팔방에서 붉은 소녀에게 덮쳐든다."
    }
   ]
  },
  {
   "uid": "da0203:U00035",
   "speaker": "(지문)",
   "jp": "だが魔力の糸に拘束される寸前、少女は血溜まりになって\n崩れ落ちる。\n\n　血溜まりは装甲の上を流れ、コクピット近くで再び実体化。",
   "cells": [
    {
     "sid": "da0203:T00068",
     "kind": "본문",
     "jp": "だが魔力の糸に拘束される寸前、少女は血溜まりになって\n崩れ落ちる。\n\n　血溜まりは装甲の上を流れ、コクピット近くで再び実体化。",
     "ko": "하지만 마력의 실에 구속되기 직전, 소녀는 피웅덩이가 되어 무너져 내린다.\n\n　피웅덩이는 장갑 위를 흘러, 콕핏 근처에서 다시 실체화."
    }
   ]
  },
  {
   "uid": "da0203:U00036",
   "speaker": "(지문)",
   "jp": "血溜まりがヒト型を〈かたど〉模り、〈ルビー〉紅玉の輝きを帯び、生命の輝きを帯び、\n結晶し、再び少女の姿へ。",
   "cells": [
    {
     "sid": "da0203:T00069",
     "kind": "본문",
     "jp": "血溜まりがヒト型を",
     "ko": "피웅덩이가 인간 형태를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00007",
     "kind": "루비 읽기",
     "jp": "かたど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00070",
     "kind": "본문",
     "jp": "模",
     "ko": "본뜨",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00071",
     "kind": "본문",
     "jp": "り、",
     "ko": "고, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00008",
     "kind": "루비 읽기",
     "jp": "ルビー",
     "ko": "루비",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00072",
     "kind": "본문",
     "jp": "紅玉",
     "ko": "홍옥",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00073",
     "kind": "본문",
     "jp": "の輝きを帯び、生命の輝きを帯び、\n結晶し、再び少女の姿へ。",
     "ko": "의 빛을 띠고, 생명의 빛을 띠며,\n결정화되어, 다시 소녀의 모습으로."
    }
   ]
  },
  {
   "uid": "da0203:U00037",
   "speaker": "アル",
   "jp": "「くっ……〈わずら〉煩わしい！」",
   "cells": [
    {
     "sid": "da0203:T00074",
     "kind": "본문",
     "jp": "「くっ……",
     "ko": "「큭…… ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00009",
     "kind": "루비 읽기",
     "jp": "わずら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00075",
     "kind": "본문",
     "jp": "煩",
     "ko": "성가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00076",
     "kind": "본문",
     "jp": "わしい！」",
     "ko": "시군!」"
    }
   ]
  },
  {
   "uid": "da0203:U00038",
   "speaker": "アナザーブラッド",
   "jp": "「〈ＳＭ〉緊縛がお好み？」",
   "cells": [
    {
     "sid": "da0203:T00077",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0203:R00010",
     "kind": "루비 읽기",
     "jp": "ＳＭ",
     "ko": "ＳＭ",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00078",
     "kind": "본문",
     "jp": "緊縛",
     "ko": "결박",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00079",
     "kind": "본문",
     "jp": "がお好み？」",
     "ko": "이 취향이야?」"
    }
   ]
  },
  {
   "uid": "da0203:U00039",
   "speaker": "(지문)",
   "jp": "再構成された少女の背後、コクピットのハッチが開いた。コクピットの奥には――",
   "cells": [
    {
     "sid": "da0203:T00080",
     "kind": "본문",
     "jp": "再構成された少女の背後、コクピットのハッチが開いた。",
     "ko": "재구성된 소녀의 등 뒤, 콕핏의 해치가 열렸다."
    },
    {
     "sid": "da0203:T00081",
     "kind": "본문",
     "jp": "コクピットの奥には――",
     "ko": "콕핏 안쪽에는――"
    }
   ]
  },
  {
   "uid": "da0203:U00040",
   "speaker": "九郎",
   "jp": "「！？　しまっ……！」",
   "cells": [
    {
     "sid": "da0203:T00082",
     "kind": "본문",
     "jp": "「！？　しまっ……！」",
     "ko": "「!?　아차……!」"
    }
   ]
  },
  {
   "uid": "da0203:U00041",
   "speaker": "(지문)",
   "jp": "気づいたときは四肢を拘束されていた。コクピットから伸びる白い糸――魔力で編まれた〈クモ〉蜘蛛の糸によって！",
   "cells": [
    {
     "sid": "da0203:T00083",
     "kind": "본문",
     "jp": "気づいたときは四肢を拘束されていた。",
     "ko": "정신을 차렸을 때는 사지가 구속되어 있었다."
    },
    {
     "sid": "da0203:T00084",
     "kind": "본문",
     "jp": "コクピットから伸びる白い糸――",
     "ko": "콕핏에서 뻗어 나온 하얀 실――"
    },
    {
     "sid": "da0203:T00085",
     "kind": "본문",
     "jp": "魔力で編まれた",
     "ko": "마력으로 짜인 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00011",
     "kind": "루비 읽기",
     "jp": "クモ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00086",
     "kind": "본문",
     "jp": "蜘蛛",
     "ko": "거미",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00087",
     "kind": "본문",
     "jp": "の糸によって！",
     "ko": "줄로!"
    }
   ]
  },
  {
   "uid": "da0203:U00042",
   "speaker": "九郎",
   "jp": "「アトラック＝ナチャ……！」",
   "cells": [
    {
     "sid": "da0203:T00088",
     "kind": "본문",
     "jp": "「アトラック＝ナチャ……！」",
     "ko": "「아틀락 나차……!」"
    }
   ]
  },
  {
   "uid": "da0203:U00043",
   "speaker": "(지문)",
   "jp": "コクピットに潜んでいたのはヒトとクモを合成させたようなフォルムの怪物……ページモンスターとしてのアトラック＝ナチャだった。\n\n　かつて――というか『前世』――アーカムシティ中に散らばってしまったアルのページが、怪異となって事件を起こしたことがあった。このアトラック＝ナチャも、そういうものの一つだ。\n\n　だが今のアルは完全であるため、ページモンスターだけが暴れる\nことはあり得ない……またしても「あり得ない」か！",
   "cells": [
    {
     "sid": "da0203:T00089",
     "kind": "본문",
     "jp": "コクピットに潜んでいたのはヒトとクモを合成させたようなフォルムの怪物……ページモンスターとしてのアトラック＝ナチャだった。\n\n　かつて――というか『前世』――アーカムシティ中に散らばってしまったアルのページが、怪異となって事件を起こしたことがあった。",
     "ko": "콕핏에 숨어 있던 것은 인간과 거미를 합성해 놓은 듯한 형태의 괴물…… 페이지 몬스터로서의 아틀락 나차였다.\n\n　일찍이――라기보단 『전생』――아컴 시티 온 곳에 흩어져 버렸던 알의 페이지가, 괴이가 되어 사건을 일으킨 적이 있었다."
    },
    {
     "sid": "da0203:T00090",
     "kind": "본문",
     "jp": "このアトラック＝ナチャも、そういうものの一つだ。\n\n　だが今のアルは完全であるため、ページモンスターだけが暴れる\nことはあり得ない……",
     "ko": "이 아틀락 나차도 그런 것들 중 하나다.\n\n　하지만 지금의 알은 완전하기에, 페이지 몬스터만이 날뛰는 일은 있을 수 없다……"
    },
    {
     "sid": "da0203:T00091",
     "kind": "본문",
     "jp": "またしても「あり得ない」か！",
     "ko": " 또다시 「있을 수 없는」 일인가!"
    }
   ]
  },
  {
   "uid": "da0203:U00044",
   "speaker": "アル",
   "jp": "「〈ディスペル〉解呪を……ふぐぅうんっんっ！？」",
   "cells": [
    {
     "sid": "da0203:T00092",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0203:R00012",
     "kind": "루비 읽기",
     "jp": "ディスペル",
     "ko": "디스펠을",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00093",
     "kind": "본문",
     "jp": "解呪",
     "ko": "해주를",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00094",
     "kind": "본문",
     "jp": "を……",
     "ko": "……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0203:T00095",
     "kind": "본문",
     "jp": "ふぐぅうんっんっ！？」",
     "ko": "후구우웅음!?」"
    }
   ]
  },
  {
   "uid": "da0203:U00045",
   "speaker": "(지문)",
   "jp": "アルもまた蜘蛛の糸で全身を〈くる〉包まれ、〈かいこ〉蚕のようにされてしまう。こいつはちょっとヤバイか！？",
   "cells": [
    {
     "sid": "da0203:T00096",
     "kind": "본문",
     "jp": "アルもまた蜘蛛の糸で全身を",
     "ko": "알 또한 거미줄에 전신이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00013",
     "kind": "루비 읽기",
     "jp": "くる",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00097",
     "kind": "본문",
     "jp": "包",
     "ko": "휘감",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00098",
     "kind": "본문",
     "jp": "まれ、",
     "ko": "겨, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00014",
     "kind": "루비 읽기",
     "jp": "かいこ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00099",
     "kind": "본문",
     "jp": "蚕",
     "ko": "누에고치",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00100",
     "kind": "본문",
     "jp": "のようにされてしまう。",
     "ko": "처럼 되고 만다."
    },
    {
     "sid": "da0203:T00101",
     "kind": "본문",
     "jp": "こいつはちょっとヤバイか！？",
     "ko": "이거 좀 위험한데!?"
    }
   ]
  },
  {
   "uid": "da0203:U00046",
   "speaker": "九郎",
   "jp": "「くっ！　マギウス・ウィ……！」",
   "cells": [
    {
     "sid": "da0203:T00102",
     "kind": "본문",
     "jp": "「くっ！　マギウス・ウィ……！」",
     "ko": "「큭!　마기우스 윙……!」"
    }
   ]
  },
  {
   "uid": "da0203:U00047",
   "speaker": "アナザーブラッド",
   "jp": "「ちょっとだけ大人しくしててね」",
   "cells": [
    {
     "sid": "da0203:T00103",
     "kind": "본문",
     "jp": "「ちょっとだけ大人しくしててね」",
     "ko": "「잠깐만 얌전히 있어 줘」"
    }
   ]
  },
  {
   "uid": "da0203:U00048",
   "speaker": "九郎",
   "jp": "「ぐぅっ！　……ッ！？」\n\n　蜘蛛の糸に縛られた四肢に痛みが走る。蜘蛛の糸を通して魔力が注がれているのだ。その魔力に反応して、術衣に魔術文字が浮かび上がる。\n\n　魔術文字は際限なく増殖し、あっという間に術衣全体を埋め\n尽くした。",
   "cells": [
    {
     "sid": "da0203:T00104",
     "kind": "본문",
     "jp": "「ぐぅっ！　……ッ！？」\n\n　蜘蛛の糸に縛られた四肢に痛みが走る。",
     "ko": "「그윽!　……읏!?」\n\n　거미줄에 묶인 사지에 통증이 인다."
    },
    {
     "sid": "da0203:T00105",
     "kind": "본문",
     "jp": "蜘蛛の糸を通して魔力が注がれているのだ。",
     "ko": "거미줄을 통해 마력이 주입되고 있다."
    },
    {
     "sid": "da0203:T00106",
     "kind": "본문",
     "jp": "その魔力に反応して、術衣に魔術文字が浮かび上がる。\n\n　魔術文字は際限なく増殖し、あっという間に術衣全体を埋め\n尽くした。",
     "ko": "그 마력에 반응하여, 술의에 마술문자가 떠오른다.\n\n　마술문자는 끝없이 증식하여, 순식간에 술의 전체를 가득 메웠다."
    }
   ]
  },
  {
   "uid": "da0203:U00049",
   "speaker": "(지문)",
   "jp": "さらに変化は続く。魔術文字は配列を変えながら、正方形に区切られたマス目――\n魔『方』陣を描く。マスの一つ一つには、呪的紋様が書かれている。",
   "cells": [
    {
     "sid": "da0203:T00107",
     "kind": "본문",
     "jp": "さらに変化は続く。",
     "ko": "변화는 계속 이어진다."
    },
    {
     "sid": "da0203:T00108",
     "kind": "본문",
     "jp": "魔術文字は配列を変えながら、正方形に区切られたマス目――\n魔『方』陣を描く。",
     "ko": "마술문자는 배열을 바꾸면서, 정사각형으로 구획된 칸――\n마『방』진을 그린다."
    },
    {
     "sid": "da0203:T00109",
     "kind": "본문",
     "jp": "マスの一つ一つには、呪的紋様が書かれている。",
     "ko": "칸 하나하나에는 주술적 문양이 적혀 있다."
    }
   ]
  },
  {
   "uid": "da0203:U00050",
   "speaker": "アナザーブラッド",
   "jp": "「アエテュル表による暗号解読。〈ハッキング〉術式介入……」",
   "cells": [
    {
     "sid": "da0203:T00110",
     "kind": "본문",
     "jp": "「アエテュル表による暗号解読。",
     "ko": "「아이테르 표에 의한 암호 해독.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00015",
     "kind": "루비 읽기",
     "jp": "ハッキング",
     "ko": "해킹",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00111",
     "kind": "본문",
     "jp": "術式介入",
     "ko": "술식 개입",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00112",
     "kind": "본문",
     "jp": "……」",
     "ko": "……」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0203:U00051",
   "speaker": "(지문)",
   "jp": "アトラク＝ナチャがさらに糸を吐く。新しい糸は触手のように蠢きながら、魔方陣のマス目に触れる。そのたびにそこに書かれた魔術紋様は形を変える。",
   "cells": [
    {
     "sid": "da0203:T00113",
     "kind": "본문",
     "jp": "アトラク＝ナチャがさらに糸を吐く。",
     "ko": "아틀락 나차가 한층 더 실을 토해 낸다."
    },
    {
     "sid": "da0203:T00114",
     "kind": "본문",
     "jp": "新しい糸は触手のように蠢きながら、魔方陣のマス目に触れる。",
     "ko": "새로운 실은 촉수처럼 꿈틀거리며 마방진의 칸에 닿는다."
    },
    {
     "sid": "da0203:T00115",
     "kind": "본문",
     "jp": "そのたびにそこに書かれた魔術紋様は形を変える。",
     "ko": "그때마다 거기에 적힌 마술문양은 형태를 바꾼다."
    }
   ]
  },
  {
   "uid": "da0203:U00052",
   "speaker": "(지문)",
   "jp": "やがて蜘蛛の糸が、光になって霧散した。術が完成したのだ。\n\n　全てのマス目が、同じ紋様に揃っていた。そして――",
   "cells": [
    {
     "sid": "da0203:T00116",
     "kind": "본문",
     "jp": "やがて蜘蛛の糸が、光になって霧散した。",
     "ko": "이윽고 거미줄이 빛이 되어 흩어져 사라졌다."
    },
    {
     "sid": "da0203:T00117",
     "kind": "본문",
     "jp": "術が完成したのだ。\n\n　全てのマス目が、同じ紋様に揃っていた。",
     "ko": "술법이 완성되었다.\n\n　모든 칸이 똑같은 문양으로 맞춰져 있었다."
    },
    {
     "sid": "da0203:T00118",
     "kind": "본문",
     "jp": "そして――",
     "ko": "그리고――"
    }
   ]
  },
  {
   "uid": "da0203:U00053",
   "speaker": "九郎",
   "jp": "「えっ……？」",
   "cells": [
    {
     "sid": "da0203:T00119",
     "kind": "본문",
     "jp": "「えっ……？」",
     "ko": "「어……?」"
    }
   ]
  },
  {
   "uid": "da0203:U00054",
   "speaker": "(지문)",
   "jp": "術衣が崩れ、単なる魔導書の〈ページ〉紙片に分解された。何が起こったか一瞬理解できなかった俺は、ただ紙片の真ん中に\n埋もれて、呆然とするばかりだ。\n\n　見ればアルもまた、元の〈サイズ〉体型に戻っている。",
   "cells": [
    {
     "sid": "da0203:T00120",
     "kind": "본문",
     "jp": "術衣が崩れ、単なる魔導書の",
     "ko": "술의가 무너져 내리며, 단순한 마도서의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00016",
     "kind": "루비 읽기",
     "jp": "ページ",
     "ko": "페이지로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00121",
     "kind": "본문",
     "jp": "紙片",
     "ko": "종잇조각으로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00122",
     "kind": "본문",
     "jp": "に分解された。",
     "ko": " 분해되었다."
    },
    {
     "sid": "da0203:T00123",
     "kind": "본문",
     "jp": "何が起こったか一瞬理解できなかった俺は、ただ紙片の真ん中に\n埋もれて、呆然とするばかりだ。\n\n　見ればアルもまた、元の",
     "ko": "무슨 일이 일어났는지 한순간 이해하지 못한 나는, 그저 종잇조각 한가운데에 파묻혀 멍하니 있을 뿐이다.\n\n　보니 알 또한 원래의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00017",
     "kind": "루비 읽기",
     "jp": "サイズ",
     "ko": "사이즈로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00124",
     "kind": "본문",
     "jp": "体型",
     "ko": "체형으로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00125",
     "kind": "본문",
     "jp": "に戻っている。",
     "ko": " 돌아와 있다."
    }
   ]
  },
  {
   "uid": "da0203:U00055",
   "speaker": "アル",
   "jp": "「……〈ディスペル〉解呪だと？」",
   "cells": [
    {
     "sid": "da0203:T00126",
     "kind": "본문",
     "jp": "「……",
     "ko": "「……",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0203:R00018",
     "kind": "루비 읽기",
     "jp": "ディスペル",
     "ko": "디스펠이라고",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00127",
     "kind": "본문",
     "jp": "解呪",
     "ko": "해주라고",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00128",
     "kind": "본문",
     "jp": "だと？」",
     "ko": "?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0203:U00056",
   "speaker": "(지문)",
   "jp": "信じ難いことだ。『アル・アジフ』が編んだ強力堅固な魔術を、こうも容易く解呪\nするなんて。",
   "cells": [
    {
     "sid": "da0203:T00129",
     "kind": "본문",
     "jp": "信じ難いことだ。",
     "ko": "믿기 힘든 일이다."
    },
    {
     "sid": "da0203:T00130",
     "kind": "본문",
     "jp": "『アル・アジフ』が編んだ強力堅固な魔術を、こうも容易く解呪\nするなんて。",
     "ko": "『알 아지프』가 짠 강력하고 견고한 마술을 이토록 손쉽게 해주하다니."
    }
   ]
  },
  {
   "uid": "da0203:U00057",
   "speaker": "アナザーブラッド",
   "jp": "「言ってるでしょ？\n　私は『ネクロノミコン』だって。〈オリジナル〉お母様の術構成くらい解読できるわ」",
   "cells": [
    {
     "sid": "da0203:T00131",
     "kind": "본문",
     "jp": "「言ってるでしょ？\n　私は『ネクロノミコン』だって。",
     "ko": "「말했잖아?\n　나는 『네크로노미콘』이라고.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00019",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00132",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00133",
     "kind": "본문",
     "jp": "の術構成くらい解読できるわ」",
     "ko": "의 술법 구성 정도는 해독할 수 있어」"
    }
   ]
  },
  {
   "uid": "da0203:U00058",
   "speaker": "アル",
   "jp": "「……ッ！　九郎！」",
   "cells": [
    {
     "sid": "da0203:T00134",
     "kind": "본문",
     "jp": "「……ッ！　九郎！」",
     "ko": "「……읏!　쿠로!」"
    }
   ]
  },
  {
   "uid": "da0203:U00059",
   "speaker": "アナザーブラッド",
   "jp": "「やらせないわ」",
   "cells": [
    {
     "sid": "da0203:T00135",
     "kind": "본문",
     "jp": "「やらせないわ」",
     "ko": "「그렇게는 안 둬」"
    }
   ]
  },
  {
   "uid": "da0203:U00060",
   "speaker": "(지문)",
   "jp": "再びマギウス・スタイルになるよりも速く、少女は動いた。\n\n　紅の煌めきが一閃する。紅の少女の手許から放たれたそれは、一直線にアルの胸元へ。",
   "cells": [
    {
     "sid": "da0203:T00136",
     "kind": "본문",
     "jp": "再びマギウス・スタイルになるよりも速く、少女は動いた。\n\n　紅の煌めきが一閃する。",
     "ko": "다시 마기우스 스타일이 되는 것보다도 빠르게, 소녀는 움직였다.\n\n　붉은 반짝임이 일섬한다."
    },
    {
     "sid": "da0203:T00137",
     "kind": "본문",
     "jp": "紅の少女の手許から放たれたそれは、一直線にアルの胸元へ。",
     "ko": "붉은 소녀의 손끝에서 쏘아진 그것은 일직선으로 알의 가슴팍으로."
    }
   ]
  },
  {
   "uid": "da0203:U00061",
   "speaker": "アル",
   "jp": "「な……っ」",
   "cells": [
    {
     "sid": "da0203:T00138",
     "kind": "본문",
     "jp": "「な……っ」",
     "ko": "「뭐……읏」"
    }
   ]
  },
  {
   "uid": "da0203:U00062",
   "speaker": "(지문)",
   "jp": "突き刺さる。それは〈ぬめ〉滑るような紅色に輝く短剣……いや、違う。\n\n　これは『鍵』だ。『鍵』を中心に、先ほどと同じ魔方陣が、アルの躰に拡がってゆく。",
   "cells": [
    {
     "sid": "da0203:T00139",
     "kind": "본문",
     "jp": "突き刺さる。",
     "ko": "깊숙이 박힌다."
    },
    {
     "sid": "da0203:T00140",
     "kind": "본문",
     "jp": "それは",
     "ko": "그것은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0203:R00020",
     "kind": "루비 읽기",
     "jp": "ぬめ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0203:T00141",
     "kind": "본문",
     "jp": "滑",
     "ko": "매끈",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0203:T00142",
     "kind": "본문",
     "jp": "るような紅色に輝く短剣……いや、違う。\n\n　これは『鍵』だ。",
     "ko": "거리는 듯한 붉은빛으로 빛나는 단검…… 아니, 아니다.\n\n　이것은 『열쇠』다."
    },
    {
     "sid": "da0203:T00143",
     "kind": "본문",
     "jp": "『鍵』を中心に、先ほどと同じ魔方陣が、アルの躰に拡がってゆく。",
     "ko": "『열쇠』를 중심으로, 방금 전과 같은 마방진이 알의 몸으로 퍼져 나간다."
    }
   ]
  },
  {
   "uid": "da0203:U00063",
   "speaker": "アル",
   "jp": "「あ……あああああああ！」",
   "cells": [
    {
     "sid": "da0203:T00144",
     "kind": "본문",
     "jp": "「あ……あああああああ！」",
     "ko": "「아…… 아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0203:U00064",
   "speaker": "(지문)",
   "jp": "突然、アルは苦しみ出した。『鍵』が刺さった胸を押さえ、その場に膝を突く。",
   "cells": [
    {
     "sid": "da0203:T00145",
     "kind": "본문",
     "jp": "突然、アルは苦しみ出した。",
     "ko": "갑자기 알이 괴로워하기 시작했다."
    },
    {
     "sid": "da0203:T00146",
     "kind": "본문",
     "jp": "『鍵』が刺さった胸を押さえ、その場に膝を突く。",
     "ko": "『열쇠』가 꽂힌 가슴을 움켜쥐고, 그 자리에 무릎을 꿇는다."
    }
   ]
  },
  {
   "uid": "da0203:U00065",
   "speaker": "(지문)",
   "jp": "胸から零れ落ちるのは血ではない。これは……アルから溢れ出すのは魔術文字。魔術文字によって構成された文字列、『術式』だ。\n\n　アルを構築する術式が今、読み解かれようとしているのだ……！",
   "cells": [
    {
     "sid": "da0203:T00147",
     "kind": "본문",
     "jp": "胸から零れ落ちるのは血ではない。",
     "ko": "가슴에서 흘러내리는 것은 피가 아니다."
    },
    {
     "sid": "da0203:T00148",
     "kind": "본문",
     "jp": "これは……アルから溢れ出すのは魔術文字。",
     "ko": "이것은…… 알에게서 흘러넘치는 것은 마술문자."
    },
    {
     "sid": "da0203:T00149",
     "kind": "본문",
     "jp": "魔術文字によって構成された文字列、『術式』だ。\n\n　アルを構築する術式が今、読み解かれようとしているのだ……！",
     "ko": "마술문자로 구성된 문자열, 『술식』이다.\n\n　알을 구축하는 술식이 지금 해독되려 하고 있는 것이다……!"
    }
   ]
  },
  {
   "uid": "da0203:U00066",
   "speaker": "アナザーブラッド",
   "jp": "「『ネクロノミコン』ラテン語版は\n　私の血になったけど、これだけでは\n　足りない。だから、お母様……」",
