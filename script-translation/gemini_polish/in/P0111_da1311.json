{
 "packet": "P0111_da1311",
 "units": [
  {
   "uid": "da1311:U00001",
   "speaker": "九朔",
   "jp": "「あ……」",
   "cells": [
    {
     "sid": "da1311:T00001",
     "kind": "본문",
     "jp": "「あ……」",
     "ko": "「아……」"
    }
   ]
  },
  {
   "uid": "da1311:U00002",
   "speaker": "(지문)",
   "jp": "アナザーブラッドの手が、我の胸から抜け落ちる。我の心から、彼女の心が抜け落ちる。\n\n　急速に失われる一体感。胸に大穴が開いたような喪失感。\n\n　幽かにあった力が――虫の吐息が、ついに消えた。その瞳は、もう何も映していない。光も無く、闇すら無く――ただウツロがぽっかりと空いているだけだ。",
   "cells": [
    {
     "sid": "da1311:T00002",
     "kind": "본문",
     "jp": "アナザーブラッドの手が、我の胸から抜け落ちる。",
     "ko": "어나더 블러드의 손이, 내 가슴에서 빠져나간다."
    },
    {
     "sid": "da1311:T00003",
     "kind": "본문",
     "jp": "我の心から、彼女の心が抜け落ちる。\n\n　急速に失われる一体感。",
     "ko": "내 마음에서, 그녀의 마음이 빠져나간다.\n\n　급속도로 상실되는 일체감."
    },
    {
     "sid": "da1311:T00004",
     "kind": "본문",
     "jp": "胸に大穴が開いたような喪失感。\n\n　幽かにあった力が――虫の吐息が、ついに消えた。",
     "ko": "가슴에 커다란 구멍이 뚫린 듯한 상실감.\n\n　희미하게 남아 있던 힘이――꺼져가던 숨결이, 마침내 사라졌다."
    },
    {
     "sid": "da1311:T00005",
     "kind": "본문",
     "jp": "その瞳は、もう何も映していない。",
     "ko": "그 눈동자는, 더 이상 아무것도 비추지 않는다."
    },
    {
     "sid": "da1311:T00006",
     "kind": "본문",
     "jp": "光も無く、闇すら無く――ただウツロがぽっかりと空いているだけだ。",
     "ko": "빛도 없고, 어둠조차 없이――그저 공허가 뻥 뚫려 있을 뿐이다."
    }
   ]
  },
  {
   "uid": "da1311:U00003",
   "speaker": "九朔",
   "jp": "「――――――」",
   "cells": [
    {
     "sid": "da1311:T00007",
     "kind": "본문",
     "jp": "「――――――」",
     "ko": "「――――――」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1311:U00004",
   "speaker": "(지문)",
   "jp": "『我』もまたウツロに、ごっそりと持って行かれた。我が半身はこうして、朽ちて、果てた。もう二度と、取り戻すことは出来ない。〈うしな〉喪失われた。永遠に。",
   "cells": [
    {
     "sid": "da1311:T00008",
     "kind": "본문",
     "jp": "『我』もまたウツロに、ごっそりと持って行かれた。",
     "ko": "『나』 또한 공허에게, 통째로 앗겨 버렸다."
    },
    {
     "sid": "da1311:T00009",
     "kind": "본문",
     "jp": "我が半身はこうして、朽ちて、果てた。",
     "ko": "나의 반신은 이렇게, 썩어, 다했다."
    },
    {
     "sid": "da1311:T00010",
     "kind": "본문",
     "jp": "もう二度と、取り戻すことは出来ない。",
     "ko": "다시는, 되찾을 수 없다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00001",
     "kind": "루비 읽기",
     "jp": "うしな",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00011",
     "kind": "본문",
     "jp": "喪失",
     "ko": "상실",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00012",
     "kind": "본문",
     "jp": "われた。",
     "ko": "되었다."
    },
    {
     "sid": "da1311:T00013",
     "kind": "본문",
     "jp": "永遠に。",
     "ko": "영원히."
    }
   ]
  },
  {
   "uid": "da1311:U00005",
   "speaker": "(지문)",
   "jp": "少女の貌に水滴が落ちた。それは血に濡れた頬を伝い、白い軌跡を残してゆく。\n\n　雫はさらに止め処なく、降り注ぐ。少女を染める血を洗い流してゆく。ぽつり。ぽつり。ぽつり。次から次へと。",
   "cells": [
    {
     "sid": "da1311:T00014",
     "kind": "본문",
     "jp": "少女の貌に水滴が落ちた。",
     "ko": "소녀의 얼굴에 물방울이 떨어졌다."
    },
    {
     "sid": "da1311:T00015",
     "kind": "본문",
     "jp": "それは血に濡れた頬を伝い、白い軌跡を残してゆく。\n\n　雫はさらに止め処なく、降り注ぐ。",
     "ko": "그것은 피에 젖은 뺨을 타고 흘러, 하얀 궤적을 남기며 나아간다.\n\n　물방울은 더욱 하염없이, 쏟아져 내린다."
    },
    {
     "sid": "da1311:T00016",
     "kind": "본문",
     "jp": "少女を染める血を洗い流してゆく。",
     "ko": "소녀를 물들이는 피를 씻어내려 간다."
    },
    {
     "sid": "da1311:T00017",
     "kind": "본문",
     "jp": "ぽつり。",
     "ko": "뚝."
    },
    {
     "sid": "da1311:T00018",
     "kind": "본문",
     "jp": "ぽつり。",
     "ko": " 뚝."
    },
    {
     "sid": "da1311:T00019",
     "kind": "본문",
     "jp": "ぽつり。",
     "ko": " 뚝."
    },
    {
     "sid": "da1311:T00020",
     "kind": "본문",
     "jp": "次から次へと。",
     "ko": "차례차례 끝없이."
    }
   ]
  },
  {
   "uid": "da1311:U00006",
   "speaker": "(지문)",
   "jp": "我は、自分が泣いていることに気付いた。",
   "cells": [
    {
     "sid": "da1311:T00021",
     "kind": "본문",
     "jp": "我は、自分が泣いていることに気付いた。",
     "ko": "나는, 자신이 울고 있다는 사실을 깨달았다."
    }
   ]
  },
  {
   "uid": "da1311:U00007",
   "speaker": "九朔",
   "jp": "「我は……我は……っ！\n　今までいったい何を……っ！」",
   "cells": [
    {
     "sid": "da1311:T00022",
     "kind": "본문",
     "jp": "「我は……我は……っ！\n　今までいったい何を……っ！」",
     "ko": "「나는…… 나는…… 윽!\n　지금까지 도대체 무엇을…… 윽!」"
    }
   ]
  },
  {
   "uid": "da1311:U00008",
   "speaker": "(지문)",
   "jp": "……これは『我』だ。我自身だ。\n\n　弱くてちっぽけな、つまらない我そのものだ。最初から分かっていたことではないか。\n\n　それなのに……何を今更！\n\n　アナザーブラッドは、別のモノガタリなどではない。在り得ざる、もうひとりの我などではない。悪徳を為す、我の可能性などでは断じてない。",
   "cells": [
    {
     "sid": "da1311:T00023",
     "kind": "본문",
     "jp": "……これは『我』だ。",
     "ko": "……이것은 『나』다."
    },
    {
     "sid": "da1311:T00024",
     "kind": "본문",
     "jp": "我自身だ。\n\n　弱くてちっぽけな、つまらない我そのものだ。",
     "ko": "나 자신이다.\n\n　약하고 보잘것없는, 시시한 나 그 자체다."
    },
    {
     "sid": "da1311:T00025",
     "kind": "본문",
     "jp": "最初から分かっていたことではないか。\n\n　それなのに……何を今更！\n\n　アナザーブラッドは、別のモノガタリなどではない。",
     "ko": "처음부터 알고 있었던 일이지 않은가.\n\n　그런데도…… 새삼스럽게 무엇을!\n\n　어나더 블러드는, 다른 이야기 따위가 아니다."
    },
    {
     "sid": "da1311:T00026",
     "kind": "본문",
     "jp": "在り得ざる、もうひとりの我などではない。",
     "ko": "있을 수 없는, 또 한 명의 나 따위가 아니다."
    },
    {
     "sid": "da1311:T00027",
     "kind": "본문",
     "jp": "悪徳を為す、我の可能性などでは断じてない。",
     "ko": "악덕을 행하는, 나의 가능성 따위가 결단코 아니다."
    }
   ]
  },
  {
   "uid": "da1311:U00009",
   "speaker": "(지문)",
   "jp": "こいつは……我の『悪』だ。我の『悪』そのものだ。我の中に今もなお〈しか〉確と存在する『悪』の顕現だ。\n\n　――なのに、大十字九朔。貴様のやってきたことは、いったい何だ？〈おこ〉烏滸がましくも騎士を騙り、皆を〈まも〉守護ると妄言を弄し――それなのに何だ、この醜態は！\n\n　貴様のやってきたことは、単なる暴走だ。憎悪のままに敵を斬り、怨みに固執して大十字九郎に楯突いた。〈アナザーブラッド〉己の悪から目を背け、くだらぬ自尊心を守る――そのためだけに。\n\n　挙げ句がこれだ！過去の世界に破滅的な災禍をもたらし、そして今、未来の可能性を根絶やしにしようとしている。\n\n　――総て我のせいだ！総ては、我の歪んだ心根が呼び寄せた悪夢ではないか！",
   "cells": [
    {
     "sid": "da1311:T00028",
     "kind": "본문",
     "jp": "こいつは……我の『悪』だ。",
     "ko": "이 녀석은…… 나의 『악』이다."
    },
    {
     "sid": "da1311:T00029",
     "kind": "본문",
     "jp": "我の『悪』そのものだ。",
     "ko": "나의 『악』 그 자체다."
    },
    {
     "sid": "da1311:T00030",
     "kind": "본문",
     "jp": "我の中に今もなお",
     "ko": "내 안에 지금도 여전히 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00002",
     "kind": "루비 읽기",
     "jp": "しか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00031",
     "kind": "본문",
     "jp": "確",
     "ko": "확실",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00032",
     "kind": "본문",
     "jp": "と存在する『悪』の顕現だ。\n\n　――なのに、大十字九朔。",
     "ko": "히 존재하는 『악』의 현현이다.\n\n　――그런데도, 다이쥬지 쿠자쿠."
    },
    {
     "sid": "da1311:T00033",
     "kind": "본문",
     "jp": "貴様のやってきたことは、いったい何だ？",
     "ko": "네놈이 해 온 짓은, 도대체 뭐냐?",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00003",
     "kind": "루비 읽기",
     "jp": "おこ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00034",
     "kind": "본문",
     "jp": "烏滸",
     "ko": "주제넘",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00035",
     "kind": "본문",
     "jp": "がましくも騎士を騙り、皆を",
     "ko": "게도 기사를 사칭하며, 모두를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00004",
     "kind": "루비 읽기",
     "jp": "まも",
     "ko": "지킨",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00036",
     "kind": "본문",
     "jp": "守護",
     "ko": "수호한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00037",
     "kind": "본문",
     "jp": "ると妄言を弄し――それなのに何だ、この醜態は！\n\n　貴様のやってきたことは、単なる暴走だ。",
     "ko": "다고 망언을 일삼더니――그런데도 뭐냐, 이 추태는!\n\n　네놈이 해 온 짓은, 단순한 폭주다."
    },
    {
     "sid": "da1311:T00038",
     "kind": "본문",
     "jp": "憎悪のままに敵を斬り、怨みに固執して大十字九郎に楯突いた。",
     "ko": "증오에 맡겨 적을 베고, 원한에 집착하여 다이쥬지 쿠로에게 반기를 들었다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00005",
     "kind": "루비 읽기",
     "jp": "アナザーブラッド",
     "ko": "어나더 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00039",
     "kind": "본문",
     "jp": "己の悪",
     "ko": "자신의 악",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00040",
     "kind": "본문",
     "jp": "から目を背け、くだらぬ自尊心を守る――そのためだけに。\n\n　挙げ句がこれだ！",
     "ko": "에서 눈을 돌리고, 하찮은 자존심을 지키는――오직 그만을 위해서.\n\n　그 결과가 이것이다!"
    },
    {
     "sid": "da1311:T00041",
     "kind": "본문",
     "jp": "過去の世界に破滅的な災禍をもたらし、そして今、未来の可能性を根絶やしにしようとしている。\n\n　――総て我のせいだ！",
     "ko": "과거의 세계에 파멸적인 재앙을 불러오고, 그리고 지금, 미래의 가능성을 뿌리째 뽑아버리려 하고 있다.\n\n　――모두 내 탓이다!"
    },
    {
     "sid": "da1311:T00042",
     "kind": "본문",
     "jp": "総ては、我の歪んだ心根が呼び寄せた悪夢ではないか！",
     "ko": "모든 것은, 내 뒤틀린 심성이 불러들인 악몽이 아닌가!"
    }
   ]
  },
  {
   "uid": "da1311:U00010",
   "speaker": "(지문)",
   "jp": "ミニミイカン\n　　　　　　　　　　　　ンイチスト　　　　　テニカクラナカ\n　　　　　　　　　　　　　　　トリナモコイスニミキ\n　　　チクタク　　　　　　　　　　チクタク\n　　　　　クニト　　　　リニハイ　　　　　　　　　　　　　　　　　　　　　トイソラミシト\n　　　　　　　　　　　　　　　ミナモコイスニミキ　　　　　チクタク\n　　　　　　　チクタク\n　　　　　　　　　　　　　　　　　　　　　ニカ\n　　　　　　トカラセセイシ\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　トクラスカ\n　　　　ミイヒイス　　　　　　　　　　　カラ　　　　　　　キラ\n　　　　　　　チキチニミ　テクイミ\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　カクイ\n　　　ラリシ　　　　　　　　　　　モチミ\n　　　　　　　　　　　　　　　　　　　　　シニイシ",
   "cells": [
    {
     "sid": "da1311:T00043",
     "kind": "본문",
     "jp": "ミニミイカン\n　　　　　　　　　　　　ンイチスト　　　　　テニカクラナカ\n　　　　　　　　　　　　　　　トリナモコイスニミキ\n　　　チクタク　　　　　　　　　　チクタク\n　　　　　クニト　　　　リニハイ　　　　　　　　　　　　　　　　　　　　　トイソラミシト\n　　　　　　　　　　　　　　　ミナモコイスニミキ　　　　　チクタク\n　　　　　　　チクタク\n　　　　　　　　　　　　　　　　　　　　　ニカ\n　　　　　　トカラセセイシ\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　トクラスカ\n　　　　ミイヒイス　　　　　　　　　　　カラ　　　　　　　キラ\n　　　　　　　チキチニミ　テクイミ\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　カクイ\n　　　ラリシ　　　　　　　　　　　モチミ\n　　　　　　　　　　　　　　　　　　　　　シニイシ",
     "ko": "미니미이칸\n　　　　　　　　　　　　은이치스토　　　　　테니카쿠라나카\n　　　　　　　　　　　　　　　토리나모코이스니미키\n　　　치쿠타쿠　　　　　　　　　　치쿠타쿠\n　　　　　쿠니토　　　　리니하이　　　　　　　　　　　　　　　　　　　　　토이소라미시토\n　　　　　　　　　　　　　　　미나모코이스니미키　　　　　치쿠타쿠\n　　　　　　　치쿠타쿠\n　　　　　　　　　　　　　　　　　　　　　니카\n　　　　　　토카라세세이시\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　토쿠라스카\n　　　　미이히이스　　　　　　　　　　　카라　　　　　　　키라\n　　　　　　　치키치니미　테쿠이미\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　카쿠이\n　　　라리시　　　　　　　　　　　모치미\n　　　　　　　　　　　　　　　　　　　　　시니이시"
    }
   ]
  },
  {
   "uid": "da1311:U00011",
   "speaker": "(지문)",
   "jp": "秩序立った無秩序、異界の律動が幾重にも〈こだま〉木霊して、耳を――\n魂を――〈ろう〉聾する。\n\n　機械化する宇宙。何もかもが、この意味を持たぬ混沌の機械を動かすための、〈パーツ〉部品と化していく。",
   "cells": [
    {
     "sid": "da1311:T00044",
     "kind": "본문",
     "jp": "秩序立った無秩序、異界の律動が幾重にも",
     "ko": "질서 정연한 무질서, 이계의 율동이 몇 겹이고 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00006",
     "kind": "루비 읽기",
     "jp": "こだま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00045",
     "kind": "본문",
     "jp": "木霊",
     "ko": "메아리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00046",
     "kind": "본문",
     "jp": "して、耳を――\n魂を――",
     "ko": "쳐, 귀를――\n영혼을――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00007",
     "kind": "루비 읽기",
     "jp": "ろう",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00047",
     "kind": "본문",
     "jp": "聾",
     "ko": "먹먹하게",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00048",
     "kind": "본문",
     "jp": "する。\n\n　機械化する宇宙。",
     "ko": " 만든다.\n\n　기계화하는 우주."
    },
    {
     "sid": "da1311:T00049",
     "kind": "본문",
     "jp": "何もかもが、この意味を持たぬ混沌の機械を動かすための、",
     "ko": "모든 것이, 이 의미를 갖지 않는 혼돈의 기계를 움직이기 위한, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00008",
     "kind": "루비 읽기",
     "jp": "パーツ",
     "ko": "파츠로",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00050",
     "kind": "본문",
     "jp": "部品",
     "ko": "부품으로",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00051",
     "kind": "본문",
     "jp": "と化していく。",
     "ko": " 화해 간다."
    }
   ]
  },
  {
   "uid": "da1311:U00012",
   "speaker": "(지문)",
   "jp": "螺子。歯車。発条。我もまた同じ。アナザーブラッド同様、邪神の陰謀を組み立てる小さな〈パーツ〉部品に\n過ぎない。\n\n\n　俺は、誰かを〈まも〉守護る、騎士なんかじゃなかった。そんな気高い精神なんて、これぽっちもありはしないんだ。",
   "cells": [
    {
     "sid": "da1311:T00052",
     "kind": "본문",
     "jp": "螺子。",
     "ko": "나사."
    },
    {
     "sid": "da1311:T00053",
     "kind": "본문",
     "jp": "歯車。",
     "ko": " 톱니바퀴."
    },
    {
     "sid": "da1311:T00054",
     "kind": "본문",
     "jp": "発条。",
     "ko": " 태엽."
    },
    {
     "sid": "da1311:T00055",
     "kind": "본문",
     "jp": "我もまた同じ。",
     "ko": " 나 또한 마찬가지."
    },
    {
     "sid": "da1311:T00056",
     "kind": "본문",
     "jp": "アナザーブラッド同様、邪神の陰謀を組み立てる小さな",
     "ko": "어나더 블러드와 마찬가지로, 사신의 음모를 조립하는 작은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00009",
     "kind": "루비 읽기",
     "jp": "パーツ",
     "ko": "파츠",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00057",
     "kind": "본문",
     "jp": "部品",
     "ko": "부품",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00058",
     "kind": "본문",
     "jp": "に\n過ぎない。\n\n\n　俺は、誰かを",
     "ko": "에\n지나지 않는다.\n\n\n　나는, 누군가를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00010",
     "kind": "루비 읽기",
     "jp": "まも",
     "ko": "지키는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00059",
     "kind": "본문",
     "jp": "守護",
     "ko": "수호하는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00060",
     "kind": "본문",
     "jp": "る、騎士なんかじゃなかった。",
     "ko": ", 기사 따위가 아니었다."
    },
    {
     "sid": "da1311:T00061",
     "kind": "본문",
     "jp": "そんな気高い精神なんて、これぽっちもありはしないんだ。",
     "ko": "그런 고결한 정신 따윈, 요만큼도 있지 않았던 거다."
    }
   ]
  },
  {
   "uid": "da1311:U00013",
   "speaker": "九朔",
   "jp": "「うっ……ぐっ……ぐぅぅ……！」",
   "cells": [
    {
     "sid": "da1311:T00062",
     "kind": "본문",
     "jp": "「うっ……ぐっ……ぐぅぅ……！」",
     "ko": "「욱…… 큭…… 그으으……!」"
    }
   ]
  },
  {
   "uid": "da1311:U00014",
   "speaker": "(지문)",
   "jp": "猛烈な吐き気に襲われる。体内に充満する血の匂い――〈いや〉否。",
   "cells": [
    {
     "sid": "da1311:T00063",
     "kind": "본문",
     "jp": "猛烈な吐き気に襲われる。",
     "ko": "맹렬한 구역질이 덮쳐 온다."
    },
    {
     "sid": "da1311:T00064",
     "kind": "본문",
     "jp": "体内に充満する血の匂い――",
     "ko": "체내에 충만하는 피 냄새――",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00011",
     "kind": "루비 읽기",
     "jp": "いや",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00065",
     "kind": "본문",
     "jp": "否",
     "ko": "아니",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00066",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1311:U00015",
   "speaker": "(지문)",
   "jp": "――鉄錆の、臭い。",
   "cells": [
    {
     "sid": "da1311:T00067",
     "kind": "본문",
     "jp": "――鉄錆の、臭い。",
     "ko": "――쇠녹의, 냄새."
    }
   ]
  },
  {
   "uid": "da1311:U00016",
   "speaker": "九朔",
   "jp": "「あああああ……」",
   "cells": [
    {
     "sid": "da1311:T00068",
     "kind": "본문",
     "jp": "「あああああ……」",
     "ko": "「아아아아아……」"
    }
   ]
  },
  {
   "uid": "da1311:U00017",
   "speaker": "(지문)",
   "jp": "全身に浮かび上がる黒い汚染。我の躰は錆びついていた。〈ボロボロ〉襤褸々々と粉になった鉄錆が零れ落ちる。〈ボロボロ〉襤褸々々と崩れてゆく。",
   "cells": [
    {
     "sid": "da1311:T00069",
     "kind": "본문",
     "jp": "全身に浮かび上がる黒い汚染。",
     "ko": "전신에 떠오르는 검은 오염."
    },
    {
     "sid": "da1311:T00070",
     "kind": "본문",
     "jp": "我の躰は錆びついていた。",
     "ko": "내 몸은 녹슬어 있었다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00012",
     "kind": "루비 읽기",
     "jp": "ボロボロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00071",
     "kind": "본문",
     "jp": "襤褸々々",
     "ko": "후드득후드득",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00072",
     "kind": "본문",
     "jp": "と粉になった鉄錆が零れ落ちる。",
     "ko": " 가루가 된 쇠녹이 쏟아져 내린다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00013",
     "kind": "루비 읽기",
     "jp": "ボロボロ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00073",
     "kind": "본문",
     "jp": "襤褸々々",
     "ko": "푸석푸석",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00074",
     "kind": "본문",
     "jp": "と崩れてゆく。",
     "ko": " 허물어져 간다."
    }
   ]
  },
  {
   "uid": "da1311:U00018",
   "speaker": "九朔",
   "jp": "「…………嗚呼」",
   "cells": [
    {
     "sid": "da1311:T00075",
     "kind": "본문",
     "jp": "「…………嗚呼」",
     "ko": "「…………아아」"
    }
   ]
  },
  {
   "uid": "da1311:U00019",
   "speaker": "(지문)",
   "jp": "これが、結末だ。不様で滑稽な〈ドンキホーテ〉道化に相応しい、不様で滑稽な結末。\n\n　我自身も、腕の中のこの少女も、我が我である〈もの〉存在は総て、\n　朽ちて消える。\n\n　我こそが間違った血――間違った未来なのだ。無くなってしまえば良い。零になってしまえば良い。総ては、混沌の機械が見る悪夢に過ぎない――",
   "cells": [
    {
     "sid": "da1311:T00076",
     "kind": "본문",
     "jp": "これが、結末だ。",
     "ko": "이것이, 결말이다."
    },
    {
     "sid": "da1311:T00077",
     "kind": "본문",
     "jp": "不様で滑稽な",
     "ko": "볼썽사납고 우스꽝스러운 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00014",
     "kind": "루비 읽기",
     "jp": "ドンキホーテ",
     "ko": "돈키호테",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00078",
     "kind": "본문",
     "jp": "道化",
     "ko": "광대",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00079",
     "kind": "본문",
     "jp": "に相応しい、不様で滑稽な結末。\n\n　我自身も、腕の中のこの少女も、我が我である",
     "ko": "에게 걸맞은, 볼썽사납고 우스꽝스러운 결말.\n\n　나 자신도, 품 안의 이 소녀도, 내가 나로서 있는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00015",
     "kind": "루비 읽기",
     "jp": "もの",
     "ko": "것은",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00080",
     "kind": "본문",
     "jp": "存在",
     "ko": "존재는",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00081",
     "kind": "본문",
     "jp": "は総て、\n　朽ちて消える。\n\n　我こそが間違った血――間違った未来なのだ。",
     "ko": " 모두,\n　썩어 사라진다.\n\n　나야말로 잘못된 피――잘못된 미래다."
    },
    {
     "sid": "da1311:T00082",
     "kind": "본문",
     "jp": "無くなってしまえば良い。",
     "ko": "없어져 버리면 된다."
    },
    {
     "sid": "da1311:T00083",
     "kind": "본문",
     "jp": "零になってしまえば良い。",
     "ko": "제로가 되어 버리면 된다."
    },
    {
     "sid": "da1311:T00084",
     "kind": "본문",
     "jp": "総ては、混沌の機械が見る悪夢に過ぎない――",
     "ko": "모든 것은, 혼돈의 기계가 꾸는 악몽에 지나지 않는다――"
    }
   ]
  },
  {
   "uid": "da1311:U00020",
   "speaker": "九朔",
   "jp": "「……畜生……畜生ぉぉ……！」",
   "cells": [
    {
     "sid": "da1311:T00085",
     "kind": "본문",
     "jp": "「……畜生……畜生ぉぉ……！」",
     "ko": "「……젠장…… 젠자아앙……!」"
    }
   ]
  },
  {
   "uid": "da1311:U00021",
   "speaker": "(지문)",
   "jp": "涙が止まらない。震えが止まらない。歯の根が合わず、がちがち鳴り続ける。顔は涙と鼻水と鉄錆でグチャグチャだ。\n\n　惨めだ。酷く惨めだ。この期に及んで、なおも不様を晒す気か。散り際すらこうも見苦しく、泣き喚くのか。\n\n\n　こんな貧弱な〈ココロ〉魂に、どうして〈ツルギ〉騎士道が宿っていると勘違いできたの\nだろうか。\n\n　だけど。それでも。我は――",
   "cells": [
    {
     "sid": "da1311:T00086",
     "kind": "본문",
     "jp": "涙が止まらない。",
     "ko": "눈물이 멈추지 않는다."
    },
    {
     "sid": "da1311:T00087",
     "kind": "본문",
     "jp": "震えが止まらない。",
     "ko": "떨림이 멈추지 않는다."
    },
    {
     "sid": "da1311:T00088",
     "kind": "본문",
     "jp": "歯の根が合わず、がちがち鳴り続ける。",
     "ko": "이빨이 맞물리지 않아, 딱딱 소리를 내며 계속 떨린다."
    },
    {
     "sid": "da1311:T00089",
     "kind": "본문",
     "jp": "顔は涙と鼻水と鉄錆でグチャグチャだ。\n\n　惨めだ。",
     "ko": "얼굴은 눈물과 콧물과 쇠녹으로 엉망진창이다.\n\n　비참하다."
    },
    {
     "sid": "da1311:T00090",
     "kind": "본문",
     "jp": "酷く惨めだ。",
     "ko": " 지독히도 비참하다."
    },
    {
     "sid": "da1311:T00091",
     "kind": "본문",
     "jp": "この期に及んで、なおも不様を晒す気か。",
     "ko": "이 지경에 이르러서도, 아직도 추태를 부릴 셈인가."
    },
    {
     "sid": "da1311:T00092",
     "kind": "본문",
     "jp": "散り際すらこうも見苦しく、泣き喚くのか。\n\n\n　こんな貧弱な",
     "ko": "스러지는 마지막 순간조차 이토록 볼썽사납게, 울부짖을 것인가.\n\n\n　이런 빈약한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00016",
     "kind": "루비 읽기",
     "jp": "ココロ",
     "ko": "마음",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00093",
     "kind": "본문",
     "jp": "魂",
     "ko": "영혼",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00094",
     "kind": "본문",
     "jp": "に、どうして",
     "ko": "에, 어째서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00017",
     "kind": "루비 읽기",
     "jp": "ツルギ",
     "ko": "검이",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00095",
     "kind": "본문",
     "jp": "騎士道",
     "ko": "기사도가",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00096",
     "kind": "본문",
     "jp": "が宿っていると勘違いできたの\nだろうか。\n\n　だけど。",
     "ko": " 깃들어 있다고 착각할 수 있었던\n것일까.\n\n　하지만."
    },
    {
     "sid": "da1311:T00097",
     "kind": "본문",
     "jp": "それでも。",
     "ko": "그런데도."
    },
    {
     "sid": "da1311:T00098",
     "kind": "본문",
     "jp": "我は――",
     "ko": "나는――"
    }
   ]
  },
  {
   "uid": "da1311:U00022",
   "speaker": "(지문)",
   "jp": "「……",
   "cells": [
    {
     "sid": "da1311:T00099",
     "kind": "본문",
     "jp": "「…",
     "ko": "「…",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1311:T00100",
     "kind": "본문",
     "jp": "…",
     "ko": "…",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1311:U00023",
   "speaker": "九朔",
   "jp": "消えたくない」",
   "cells": [
    {
     "sid": "da1311:T00101",
     "kind": "본문",
     "jp": "消えたくない」",
     "ko": "사라지고 싶지 않아」"
    }
   ]
  },
  {
   "uid": "da1311:U00024",
   "speaker": "(지문)",
   "jp": "自分の存在が無かったことになる。零になってしまう。アナザーブラッドを蝕んだものと同じ、抗いようのない恐怖と絶望。\n\n　こんなのは嫌だ。こんな惨めなまま、消えてしまいたくない。\n\n　誇り、自信、自尊心――あらゆる虚飾を剥ぎ取られた我に残った、\nそれが唯一の本心だった。\n\n　我は、最低だ。不様に滅びるのが嫌だから、不様に足掻く。全く以って、救い難い。\n\n　だけど。だけど。それでも。〈・・・・　・・・・・・・・・〉それでも、我は救われたいのだ！",
   "cells": [
    {
     "sid": "da1311:T00102",
     "kind": "본문",
     "jp": "自分の存在が無かったことになる。",
     "ko": "자신의 존재가 없었던 일이 된다."
    },
    {
     "sid": "da1311:T00103",
     "kind": "본문",
     "jp": "零になってしまう。",
     "ko": "제로가 되어 버린다."
    },
    {
     "sid": "da1311:T00104",
     "kind": "본문",
     "jp": "アナザーブラッドを蝕んだものと同じ、抗いようのない恐怖と絶望。\n\n　こんなのは嫌だ。",
     "ko": "어나더 블러드를 좀먹었던 것과 같은, 거스를 길 없는 공포와 절망.\n\n　이런 건 싫다."
    },
    {
     "sid": "da1311:T00105",
     "kind": "본문",
     "jp": "こんな惨めなまま、消えてしまいたくない。\n\n　誇り、自信、自尊心――あらゆる虚飾を剥ぎ取られた我に残った、\nそれが唯一の本心だった。\n\n　我は、最低だ。",
     "ko": "이렇게 비참한 채로, 사라져 버리고 싶지 않다.\n\n　긍지, 자신감, 자존심――온갖 허식을 벗겨낸 나에게 남은,\n그것이 유일한 본심이었다.\n\n　나는, 최악이다."
    },
    {
     "sid": "da1311:T00106",
     "kind": "본문",
     "jp": "不様に滅びるのが嫌だから、不様に足掻く。",
     "ko": "볼썽사납게 멸망하는 게 싫으니까, 볼썽사납게 발버둥 친다."
    },
    {
     "sid": "da1311:T00107",
     "kind": "본문",
     "jp": "全く以って、救い難い。\n\n　だけど。",
     "ko": "실로, 구제 불능이다.\n\n　하지만."
    },
    {
     "sid": "da1311:T00108",
     "kind": "본문",
     "jp": "だけど。",
     "ko": "하지만."
    },
    {
     "sid": "da1311:T00109",
     "kind": "본문",
     "jp": "それでも。",
     "ko": "그런데도.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00018",
     "kind": "루비 읽기",
     "jp": "・・・・　・・・・・・・・・",
     "ko": "・・・・　・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00110",
     "kind": "본문",
     "jp": "それでも、我は救われたいのだ",
     "ko": "그런데도, 나는 구원받고 싶은 것이다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00111",
     "kind": "본문",
     "jp": "！",
     "ko": "!",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1311:U00025",
   "speaker": "九朔",
   "jp": "「誰か……」",
   "cells": [
    {
     "sid": "da1311:T00112",
     "kind": "본문",
     "jp": "「誰か……」",
     "ko": "「누군가……」"
    }
   ]
  },
  {
   "uid": "da1311:U00026",
   "speaker": "(지문)",
   "jp": "誰か。誰か。誰か。\n\n　誰でも良い。何でも良い。どんな〈デウス・エクス・マキナ〉陳腐な奇跡だって構わない。\n\n　我を……我等を……このウツロな地獄から、救い出してくれ。\n\n　誰か。誰か。誰か――",
   "cells": [
    {
     "sid": "da1311:T00113",
     "kind": "본문",
     "jp": "誰か。",
     "ko": "누군가."
    },
    {
     "sid": "da1311:T00114",
     "kind": "본문",
     "jp": "誰か。",
     "ko": "누군가."
    },
    {
     "sid": "da1311:T00115",
     "kind": "본문",
     "jp": "誰か。\n\n　誰でも良い。何でも良い。",
     "ko": "누군가.\n\n　누구라도 좋다. 무엇이라도 좋다."
    },
    {
     "sid": "da1311:T00116",
     "kind": "본문",
     "jp": "どんな",
     "ko": "어떤 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1311:R00019",
     "kind": "루비 읽기",
     "jp": "デウス・エクス・マキナ",
     "ko": "데우스 엑스 마키나라도",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1311:T00117",
     "kind": "본문",
     "jp": "陳腐な奇跡",
     "ko": "진부한 기적이라도",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1311:T00118",
     "kind": "본문",
     "jp": "だって構わない。\n\n　我を……我等を……このウツロな地獄から、救い出してくれ。\n\n　誰か。",
     "ko": " 상관없다.\n\n　나를…… 우리를…… 이 공허한 지옥에서, 구해내 줘.\n\n　누군가."
    },
    {
     "sid": "da1311:T00119",
     "kind": "본문",
     "jp": "誰か。",
     "ko": "누군가."
    },
    {
     "sid": "da1311:T00120",
     "kind": "본문",
     "jp": "誰か――",
     "ko": "누군가――"
    }
   ]
  },
  {
   "uid": "da1311:U00027",
   "speaker": "九朔",
   "jp": "「誰か……助けて……ッ！」",
   "cells": [
    {
     "sid": "da1311:T00121",
     "kind": "본문",
     "jp": "「誰か……助けて……ッ！」",
     "ko": "「누군가…… 도와줘…… 윽!」"
    }
   ]
  },
  {
   "uid": "da1311:U00028",
   "speaker": "九郎",
   "jp": "「助けるに……決まってんだろうがッッッッ！」",
   "cells": [
    {
     "sid": "da1311:T00122",
     "kind": "본문",
     "jp": "「助けるに……決まってんだろうがッッッッ！」",
     "ko": "「도와주는 게…… 당연하잖아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da1311:U00029",
   "speaker": "(지문)",
   "jp": "その声は、混沌の中心で、耳を聾する如何なる音よりも\n　高らかに響いた。",
   "cells": [
    {
     "sid": "da1311:T00123",
     "kind": "본문",
     "jp": "その声は、混沌の中心で、耳を聾する如何なる音よりも\n　高らかに響いた。",
     "ko": "그 목소리는, 혼돈의 중심에서, 귀를 먹먹하게 하는 그 어떠한 소리보다도\n　드높이 울려 퍼졌다."
    }
   ]
  }
 ]
}