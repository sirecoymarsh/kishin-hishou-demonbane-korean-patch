{
 "packet": "P0003_da0102",
 "units": [
  {
   "uid": "da0102:U00001",
   "speaker": "アル",
   "jp": "「来るぞ……九郎」",
   "cells": [
    {
     "sid": "da0102:T00001",
     "kind": "본문",
     "jp": "「来るぞ……九郎」",
     "ko": "「온다…… 쿠로」"
    }
   ]
  },
  {
   "uid": "da0102:U00002",
   "speaker": "九郎",
   "jp": "「分かってる、アル」",
   "cells": [
    {
     "sid": "da0102:T00002",
     "kind": "본문",
     "jp": "「分かってる、アル」",
     "ko": "「알고 있어, 알」"
    }
   ]
  },
  {
   "uid": "da0102:U00003",
   "speaker": "九郎",
   "jp": "「〈マギウス・スタイル〉術衣形態！」",
   "cells": [
    {
     "sid": "da0102:T00003",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0102:R00001",
     "kind": "루비 읽기",
     "jp": "マギウス・スタイル",
     "ko": "마기우스 스타일",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00004",
     "kind": "본문",
     "jp": "術衣形態",
     "ko": "술의 형태",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00005",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00004",
   "speaker": "アル",
   "jp": "「九郎！　また来るぞ！」",
   "cells": [
    {
     "sid": "da0102:T00006",
     "kind": "본문",
     "jp": "「九郎！　また来るぞ！」",
     "ko": "「쿠로!　또 온다!」"
    }
   ]
  },
  {
   "uid": "da0102:U00005",
   "speaker": "九郎",
   "jp": "「クッ！」",
   "cells": [
    {
     "sid": "da0102:T00007",
     "kind": "본문",
     "jp": "「クッ！」",
     "ko": "「큭!」"
    }
   ]
  },
  {
   "uid": "da0102:U00006",
   "speaker": "(지문)",
   "jp": "「くっ……はっ！　チィィィッ！」",
   "cells": [
    {
     "sid": "da0102:T00008",
     "kind": "본문",
     "jp": "「くっ……はっ！　チィィィッ！」",
     "ko": "「큿…… 핫!　치이이익!」"
    }
   ]
  },
  {
   "uid": "da0102:U00007",
   "speaker": "九郎",
   "jp": "「クトゥグア！　イタクァ！」",
   "cells": [
    {
     "sid": "da0102:T00009",
     "kind": "본문",
     "jp": "「クトゥグア！　イタクァ！」",
     "ko": "「크투가!　이타콰!」"
    }
   ]
  },
  {
   "uid": "da0102:U00008",
   "speaker": "九郎",
   "jp": "「くたばれ！」",
   "cells": [
    {
     "sid": "da0102:T00010",
     "kind": "본문",
     "jp": "「くたばれ！」",
     "ko": "「뒈져라!」"
    }
   ]
  },
  {
   "uid": "da0102:U00009",
   "speaker": "九郎",
   "jp": "「……ふぅ」",
   "cells": [
    {
     "sid": "da0102:T00011",
     "kind": "본문",
     "jp": "「……ふぅ」",
     "ko": "「……후우」"
    }
   ]
  },
  {
   "uid": "da0102:U00010",
   "speaker": "アル",
   "jp": "「怪我は無いか、九郎？」",
   "cells": [
    {
     "sid": "da0102:T00012",
     "kind": "본문",
     "jp": "「怪我は無いか、九郎？」",
     "ko": "「다친 데는 없느냐, 쿠로?」"
    }
   ]
  },
  {
   "uid": "da0102:U00011",
   "speaker": "九郎",
   "jp": "「ああ、大丈夫だ。しかし……」",
   "cells": [
    {
     "sid": "da0102:T00013",
     "kind": "본문",
     "jp": "「ああ、大丈夫だ。しかし……」",
     "ko": "「아아, 괜찮아. 그나저나……」"
    }
   ]
  },
  {
   "uid": "da0102:U00012",
   "speaker": "アル",
   "jp": "「また〈・・〉コレか……」",
   "cells": [
    {
     "sid": "da0102:T00014",
     "kind": "본문",
     "jp": "「また",
     "ko": "「또 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00002",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00015",
     "kind": "본문",
     "jp": "コレ",
     "ko": "이것",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00016",
     "kind": "본문",
     "jp": "か……」",
     "ko": "인가……」"
    }
   ]
  },
  {
   "uid": "da0102:U00013",
   "speaker": "(지문)",
   "jp": "大十字九郎。職業、魔導探偵。まあ、要するにオカルト絡みの事件を扱う何でも屋だ。\n\n　そんな俺がここ数週間、多忙を極めている。その諸悪の根源が……たった今、ぶっ倒したコレだ。",
   "cells": [
    {
     "sid": "da0102:T00017",
     "kind": "본문",
     "jp": "大十字九郎。",
     "ko": "다이쥬지 쿠로."
    },
    {
     "sid": "da0102:T00018",
     "kind": "본문",
     "jp": "職業、魔導探偵。",
     "ko": "직업, 마도탐정."
    },
    {
     "sid": "da0102:T00019",
     "kind": "본문",
     "jp": "まあ、要するにオカルト絡みの事件を扱う何でも屋だ。\n\n　そんな俺がここ数週間、多忙を極めている。",
     "ko": "뭐, 요컨대 오컬트 관련 사건을 다루는 해결사다.\n\n　그런 내가 요 몇 주 사이, 눈코 뜰 새 없이 바쁘다."
    },
    {
     "sid": "da0102:T00020",
     "kind": "본문",
     "jp": "その諸悪の根源が……たった今、ぶっ倒した",
     "ko": "그 만악의 근원이…… 방금 때려눕힌 "
    },
    {
     "sid": "da0102:T00021",
     "kind": "본문",
     "jp": "コレだ。",
     "ko": "이것이다."
    }
   ]
  },
  {
   "uid": "da0102:U00014",
   "speaker": "九郎",
   "jp": "「血……」\n\n　ここ数週間、多発している怪異。それらはコイツらによって引き起こされていた。\n\n　普段は不定形。だが時折こうして実体化し、街中で暴れ出す。その正体はこの通り――自らの意思を持って動く、血溜まりだ。\n\n　今夜と同じように、もう何度もコイツらを倒している。だが怪事件は減るどころか増えていく一方だ。",
   "cells": [
    {
     "sid": "da0102:T00022",
     "kind": "본문",
     "jp": "「血……」\n\n　ここ数週間、多発している怪異。",
     "ko": "「피……」\n\n　요 몇 주 사이 잇따르고 있는 괴이."
    },
    {
     "sid": "da0102:T00023",
     "kind": "본문",
     "jp": "それらはコイツらによって引き起こされていた。\n\n　普段は不定形。",
     "ko": "그런 일들을 일으킨 것은 이 녀석들이었다.\n\n　평소에는 부정형."
    },
    {
     "sid": "da0102:T00024",
     "kind": "본문",
     "jp": "だが時折こうして実体化し、街中で暴れ出す。",
     "ko": "하지만 때때로 이렇게 실체화해서, 거리 한복판에서 날뛰기 시작한다."
    },
    {
     "sid": "da0102:T00025",
     "kind": "본문",
     "jp": "その正体はこの通り――自らの意思を持って動く、血溜まりだ。\n\n　今夜と同じように、もう何度もコイツらを倒している。",
     "ko": "그 정체는 보시다시피――스스로의 의지를 갖고 움직이는, 피웅덩이다.\n\n　오늘 밤처럼, 벌써 몇 번이나 이 녀석들을 쓰러뜨렸다."
    },
    {
     "sid": "da0102:T00026",
     "kind": "본문",
     "jp": "だが怪事件は減るどころか増えていく一方だ。",
     "ko": "하지만 괴사건은 줄어들기는커녕 늘어만 갈 뿐이다."
    }
   ]
  },
  {
   "uid": "da0102:U00015",
   "speaker": "九郎",
   "jp": "「……何なんだ、コイツら」",
   "cells": [
    {
     "sid": "da0102:T00027",
     "kind": "본문",
     "jp": "「……何なんだ、コイツら」",
     "ko": "「……뭐냐고, 이 녀석들」"
    }
   ]
  },
  {
   "uid": "da0102:U00016",
   "speaker": "アル",
   "jp": "「さあな」",
   "cells": [
    {
     "sid": "da0102:T00028",
     "kind": "본문",
     "jp": "「さあな」",
     "ko": "「글쎄다」"
    }
   ]
  },
  {
   "uid": "da0102:U00017",
   "speaker": "アル",
   "jp": "「〈わらわ〉妾にも解からん」",
   "cells": [
    {
     "sid": "da0102:T00029",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0102:R00003",
     "kind": "루비 읽기",
     "jp": "わらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00030",
     "kind": "본문",
     "jp": "妾",
     "ko": "이 몸",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00031",
     "kind": "본문",
     "jp": "にも解からん」",
     "ko": "도 모르겠구나」"
    }
   ]
  },
  {
   "uid": "da0102:U00018",
   "speaker": "(지문)",
   "jp": "アルの知識を以ってしても正体不明な、今回の怪異。ここまで奇妙なのは、かれこれ〈・・・・〉前の世界以来だ。",
   "cells": [
    {
     "sid": "da0102:T00032",
     "kind": "본문",
     "jp": "アルの知識を以ってしても正体不明な、今回の怪異。",
     "ko": "알의 지식으로도 정체불명인, 이번 괴이."
    },
    {
     "sid": "da0102:T00033",
     "kind": "본문",
     "jp": "ここまで奇妙なのは、かれこれ",
     "ko": "이토록 기묘한 일은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00004",
     "kind": "루비 읽기",
     "jp": "・・・・",
     "ko": "・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00034",
     "kind": "본문",
     "jp": "前の世界",
     "ko": "이전 세계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00035",
     "kind": "본문",
     "jp": "以来だ。",
     "ko": " 이래 처음이다."
    }
   ]
  },
  {
   "uid": "da0102:U00019",
   "speaker": "アル",
   "jp": "「だが……」",
   "cells": [
    {
     "sid": "da0102:T00036",
     "kind": "본문",
     "jp": "「だが……」",
     "ko": "「허나……」"
    }
   ]
  },
  {
   "uid": "da0102:U00020",
   "speaker": "(지문)",
   "jp": "アルが言わんとしているところは分かっている。それがまた、さらにこの事件の〈キッカイ〉奇怪さを増しているのだが。",
   "cells": [
    {
     "sid": "da0102:T00037",
     "kind": "본문",
     "jp": "アルが言わんとしているところは分かっている。",
     "ko": "알이 무슨 말을 하려는지 알고 있다."
    },
    {
     "sid": "da0102:T00038",
     "kind": "본문",
     "jp": "それがまた、さらにこの事件の",
     "ko": "그 점이 이 사건을 한층 더 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00005",
     "kind": "루비 읽기",
     "jp": "キッカイ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00039",
     "kind": "본문",
     "jp": "奇怪",
     "ko": "기괴",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00040",
     "kind": "본문",
     "jp": "さを増しているのだが。",
     "ko": "하게 만들고 있지만."
    }
   ]
  },
  {
   "uid": "da0102:U00021",
   "speaker": "九郎",
   "jp": "「お前に『近い』感じがある……か」",
   "cells": [
    {
     "sid": "da0102:T00041",
     "kind": "본문",
     "jp": "「お前に『近い』感じがある……か」",
     "ko": "「너와 『가까운』 느낌이 있다……라」"
    }
   ]
  },
  {
   "uid": "da0102:U00022",
   "speaker": "アル",
   "jp": "「うむ……」",
   "cells": [
    {
     "sid": "da0102:T00042",
     "kind": "본문",
     "jp": "「うむ……」",
     "ko": "「음……」"
    }
   ]
  },
  {
   "uid": "da0102:U00023",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り」",
   "cells": [
    {
     "sid": "da0102:T00043",
     "kind": "본문",
     "jp": "「てけり・り」",
     "ko": "「테케리・리」"
    }
   ]
  },
  {
   "uid": "da0102:U00024",
   "speaker": "九郎",
   "jp": "「おう、ただいま」",
   "cells": [
    {
     "sid": "da0102:T00044",
     "kind": "본문",
     "jp": "「おう、ただいま」",
     "ko": "「어, 다녀왔어」"
    }
   ]
  },
  {
   "uid": "da0102:U00025",
   "speaker": "アル",
   "jp": "「留守番ご苦労。ダンセイニ」",
   "cells": [
    {
     "sid": "da0102:T00045",
     "kind": "본문",
     "jp": "「留守番ご苦労。ダンセイニ」",
     "ko": "「집 보느라 수고했다. 던세이니」"
    }
   ]
  },
  {
   "uid": "da0102:U00026",
   "speaker": "九郎",
   "jp": "「はあ……むやみやたらに疲れた……」",
   "cells": [
    {
     "sid": "da0102:T00046",
     "kind": "본문",
     "jp": "「はあ……むやみやたらに疲れた……」",
     "ko": "「하아…… 무지막지하게 피곤하네……」"
    }
   ]
  },
  {
   "uid": "da0102:U00027",
   "speaker": "(지문)",
   "jp": "帰るなり、ソファーに向かって倒れ込む。心底、疲れた。いくらなんでも忙し過ぎる。\n\n　暇よりはマシかも知れないが、これでは身体の方が持たない。",
   "cells": [
    {
     "sid": "da0102:T00047",
     "kind": "본문",
     "jp": "帰るなり、ソファーに向かって倒れ込む。",
     "ko": "돌아오자마자, 소파를 향해 쓰러진다."
    },
    {
     "sid": "da0102:T00048",
     "kind": "본문",
     "jp": "心底、疲れた。",
     "ko": "진심으로, 지쳤다."
    },
    {
     "sid": "da0102:T00049",
     "kind": "본문",
     "jp": "いくらなんでも忙し過ぎる。\n\n　暇よりはマシかも知れないが、これでは身体の方が持たない。",
     "ko": "아무리 그래도 너무 바쁘다.\n\n　한가한 것보다는 나을지 몰라도, 이래서는 몸이 남아나질 않는다."
    }
   ]
  },
  {
   "uid": "da0102:U00028",
   "speaker": "アル",
   "jp": "「覇道の小娘に\n　報告しなくて良いのか？」",
   "cells": [
    {
     "sid": "da0102:T00050",
     "kind": "본문",
     "jp": "「覇道の小娘に\n　報告しなくて良いのか？」",
     "ko": "「하도의 애송이에게\n　보고하지 않아도 되느냐?」"
    }
   ]
  },
  {
   "uid": "da0102:U00029",
   "speaker": "九郎",
   "jp": "「今日はパス……明日で良いや……」",
   "cells": [
    {
     "sid": "da0102:T00051",
     "kind": "본문",
     "jp": "「今日はパス……明日で良いや……」",
     "ko": "「오늘은 패스…… 내일 하면 됐지 뭐……」"
    }
   ]
  },
  {
   "uid": "da0102:U00030",
   "speaker": "アル",
   "jp": "「だらしがないのう」",
   "cells": [
    {
     "sid": "da0102:T00052",
     "kind": "본문",
     "jp": "「だらしがないのう」",
     "ko": "「칠칠치 못하기는」"
    }
   ]
  },
  {
   "uid": "da0102:U00031",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り」",
   "cells": [
    {
     "sid": "da0102:T00053",
     "kind": "본문",
     "jp": "「てけり・り」",
     "ko": "「테케리・리」"
    }
   ]
  },
  {
   "uid": "da0102:U00032",
   "speaker": "(지문)",
   "jp": "うるせえぞ、人外風情ども。だいたい報告するにしたって、いつもと同じ内容じゃねえか。",
   "cells": [
    {
     "sid": "da0102:T00054",
     "kind": "본문",
     "jp": "うるせえぞ、人外風情ども。",
     "ko": "시끄러워, 인외 나부랭이들아."
    },
    {
     "sid": "da0102:T00055",
     "kind": "본문",
     "jp": "だいたい報告するにしたって、いつもと同じ内容じゃねえか。",
     "ko": "애초에 보고를 한들, 언제나 똑같은 내용이잖아."
    }
   ]
  },
  {
   "uid": "da0102:U00033",
   "speaker": "(지문)",
   "jp": "何の腐れ縁か――俺はこの世界でも、覇道財閥のお抱え探偵\nをやっている。\n\n　『ブラックロッジ』が存在しなくても、この街と俺を取り巻く環境は\n大して変わっていない。\n\n　変わっていることがあるとすれば――",
   "cells": [
    {
     "sid": "da0102:T00056",
     "kind": "본문",
     "jp": "何の腐れ縁か――俺はこの世界でも、覇道財閥のお抱え探偵\nをやっている。\n\n　『ブラックロッジ』が存在しなくても、この街と俺を取り巻く環境は\n大して変わっていない。\n\n　変わっていることがあるとすれば――",
     "ko": "무슨 질긴 악연인지――나는 이 세계에서도, 하도 재벌의 전속 탐정\n노릇을 하고 있다.\n\n　『블랙 로지』가 존재하지 않아도, 이 거리와 나를 둘러싼 환경은\n그다지 변하지 않았다.\n\n　달라진 점이 있다면――"
    }
   ]
  },
  {
   "uid": "da0102:U00034",
   "speaker": "(지문)",
   "jp": "デモンベインが無いことくらいか。\n\n　そう。邪神の陰謀を砕いた今、魔を断つ剣は必要ない。アイツの永い戦いはようやく終わったのだ。\n\n　もう居ないデモンベイン。デモンベインを忘れた世界。\n\n　ふと寂しく思うこともある。だけどこれで良いんだ。世界は未来へ向かっているのだから。",
   "cells": [
    {
     "sid": "da0102:T00057",
     "kind": "본문",
     "jp": "デモンベインが無いことくらいか。\n\n　そう。",
     "ko": "데몬베인이 없다는 것 정도려나.\n\n　그래."
    },
    {
     "sid": "da0102:T00058",
     "kind": "본문",
     "jp": "邪神の陰謀を砕いた今、魔を断つ剣は必要ない。",
     "ko": "사신의 음모를 분쇄한 지금, 마를 끊는 검은 필요 없다."
    },
    {
     "sid": "da0102:T00059",
     "kind": "본문",
     "jp": "アイツの永い戦いはようやく終わったのだ。\n\n　もう居ないデモンベイン。",
     "ko": "그 녀석의 기나긴 싸움은 마침내 끝났다.\n\n　이제는 없는 데몬베인."
    },
    {
     "sid": "da0102:T00060",
     "kind": "본문",
     "jp": "デモンベインを忘れた世界。\n\n　ふと寂しく思うこともある。",
     "ko": "데몬베인을 잊은 세계.\n\n　문득 쓸쓸해질 때도 있다."
    },
    {
     "sid": "da0102:T00061",
     "kind": "본문",
     "jp": "だけどこれで良いんだ。",
     "ko": "하지만 이걸로 된 거다."
    },
    {
     "sid": "da0102:T00062",
     "kind": "본문",
     "jp": "世界は未来へ向かっているのだから。",
     "ko": "세계는 미래로 향하고 있으니까."
    }
   ]
  },
  {
   "uid": "da0102:U00035",
   "speaker": "(지문)",
   "jp": "……なんてな。〈センチメンタル〉感傷的になっている場合じゃない。\n\n　今の問題は、例の件だ。あのファッキン血溜まりども、本気で厄介になってきた。\n\n　今のところ後れを取ることはないが、それでも決して楽な相手\nではない。",
   "cells": [
    {
     "sid": "da0102:T00063",
     "kind": "본문",
     "jp": "……なんてな。",
     "ko": "……라니 원.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00006",
     "kind": "루비 읽기",
     "jp": "センチメンタル",
     "ko": "센티멘털",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00064",
     "kind": "본문",
     "jp": "感傷的",
     "ko": "감상",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00065",
     "kind": "본문",
     "jp": "になっている場合じゃない。\n\n　今の問題は、例の件だ。",
     "ko": "에 젖어 있을 때가 아니다.\n\n　지금 문제는, 그 건이다."
    },
    {
     "sid": "da0102:T00066",
     "kind": "본문",
     "jp": "あのファッキン血溜まりども、本気で厄介になってきた。\n\n　今のところ後れを取ることはないが、それでも決して楽な相手\nではない。",
     "ko": "그 퍼킹 피웅덩이 녀석들, 진짜로 골치 아파지기 시작했다.\n\n　지금까지는 밀린 적이 없지만, 그렇다고 결코 만만한 상대도\n아니다."
    }
   ]
  },
  {
   "uid": "da0102:U00036",
   "speaker": "九郎",
   "jp": "「このままじゃキリがねえ」",
   "cells": [
    {
     "sid": "da0102:T00067",
     "kind": "본문",
     "jp": "「このままじゃキリがねえ」",
     "ko": "「이대로는 끝이 없겠어」"
    }
   ]
  },
  {
   "uid": "da0102:U00037",
   "speaker": "アル",
   "jp": "「……元凶を突き止めんことにはな」",
   "cells": [
    {
     "sid": "da0102:T00068",
     "kind": "본문",
     "jp": "「……元凶を突き止めんことにはな」",
     "ko": "「……원흉을 밝혀내지 않고서야 말이지」"
    }
   ]
  },
  {
   "uid": "da0102:U00038",
   "speaker": "九郎",
   "jp": "「むむむ～」",
   "cells": [
    {
     "sid": "da0102:T00069",
     "kind": "본문",
     "jp": "「むむむ～」",
     "ko": "「음음음~」"
    }
   ]
  },
  {
   "uid": "da0102:U00039",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り～」",
   "cells": [
    {
     "sid": "da0102:T00070",
     "kind": "본문",
     "jp": "「てけり・り～」",
     "ko": "「테케리・리~」"
    }
   ]
  },
  {
   "uid": "da0102:U00040",
   "speaker": "(지문)",
   "jp": "元凶を突き止めようとしても、手がかりすら無いけどな。なにせヤツら、〈たお〉斃れて血溜まりになったと思ったら、すぐに蒸発して消えちまう。",
   "cells": [
    {
     "sid": "da0102:T00071",
     "kind": "본문",
     "jp": "元凶を突き止めようとしても、手がかりすら無いけどな。",
     "ko": "원흉을 밝혀내려 해도 단서조차 없지만."
    },
    {
     "sid": "da0102:T00072",
     "kind": "본문",
     "jp": "なにせヤツら、",
     "ko": "녀석들은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00007",
     "kind": "루비 읽기",
     "jp": "たお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00073",
     "kind": "본문",
     "jp": "斃",
     "ko": "쓰러",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00074",
     "kind": "본문",
     "jp": "れて血溜まりになったと思ったら、すぐに蒸発して消えちまう。",
     "ko": "져서 피웅덩이가 되었다 싶으면 곧바로 증발해서 사라져 버리니 말이다."
    }
   ]
  },
  {
   "uid": "da0102:U00041",
   "speaker": "九郎",
   "jp": "「やってらんねえ～……」",
   "cells": [
    {
     "sid": "da0102:T00075",
     "kind": "본문",
     "jp": "「やってらんねえ～……」",
     "ko": "「해 먹을 수가 없구만~……」"
    }
   ]
  },
  {
   "uid": "da0102:U00042",
   "speaker": "アル",
   "jp": "「ええい、だからしっかりせんか」",
   "cells": [
    {
     "sid": "da0102:T00076",
     "kind": "본문",
     "jp": "「ええい、だからしっかりせんか」",
     "ko": "「에이, 그러니까 정신 좀 차리란 말이다」"
    }
   ]
  },
  {
   "uid": "da0102:U00043",
   "speaker": "九郎",
   "jp": "「本当にアイツら、何ものなんだ……」",
   "cells": [
    {
     "sid": "da0102:T00077",
     "kind": "본문",
     "jp": "「本当にアイツら、何ものなんだ……」",
     "ko": "「정말이지 그 녀석들, 정체가 뭐야……」"
    }
   ]
  },
  {
   "uid": "da0102:U00044",
   "speaker": "アル",
   "jp": "「それを調べるのが仕事だ……ったく」",
   "cells": [
    {
     "sid": "da0102:T00078",
     "kind": "본문",
     "jp": "「それを調べるのが仕事だ……ったく」",
     "ko": "「그걸 조사하는 게 일이다…… 쯧」"
    }
   ]
  },
  {
   "uid": "da0102:U00045",
   "speaker": "(지문)",
   "jp": "言いながら、アルは俺の横を通り過ぎる。",
   "cells": [
    {
     "sid": "da0102:T00079",
     "kind": "본문",
     "jp": "言いながら、アルは俺の横を通り過ぎる。",
     "ko": "그렇게 말하며, 알은 내 옆을 지나쳐 간다."
    }
   ]
  },
  {
   "uid": "da0102:U00046",
   "speaker": "九郎",
   "jp": "「……ん？　どこ行く？」",
   "cells": [
    {
     "sid": "da0102:T00080",
     "kind": "본문",
     "jp": "「……ん？　どこ行く？」",
     "ko": "「……응?　어디 가?」"
    }
   ]
  },
  {
   "uid": "da0102:U00047",
   "speaker": "アル",
   "jp": "「疲れたのは妾も同じだ。\n　湯に浸かって身体を休める」",
   "cells": [
    {
     "sid": "da0102:T00081",
     "kind": "본문",
     "jp": "「疲れたのは妾も同じだ。\n　湯に浸かって身体を休める」",
     "ko": "「피곤한 건 이 몸도 마찬가지다.\n　탕에 몸을 담그고 쉬련다」"
    }
   ]
  },
  {
   "uid": "da0102:U00048",
   "speaker": "(지문)",
   "jp": "告げて、アルは浴室へ入っていった。部屋には俺とダンセイニが残される。",
   "cells": [
    {
     "sid": "da0102:T00082",
     "kind": "본문",
     "jp": "告げて、アルは浴室へ入っていった。",
     "ko": "그리 말하고선, 알은 욕실로 들어갔다."
    },
    {
     "sid": "da0102:T00083",
     "kind": "본문",
     "jp": "部屋には俺とダンセイニが残される。",
     "ko": "방에는 나와 던세이니가 남겨진다."
    }
   ]
  },
  {
   "uid": "da0102:U00049",
   "speaker": "九郎",
   "jp": "「………………」",
   "cells": [
    {
     "sid": "da0102:T00084",
     "kind": "본문",
     "jp": "「………………」",
     "ko": "「………………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00050",
   "speaker": "ダンセイニ",
   "jp": "「てけり・り？」",
   "cells": [
    {
     "sid": "da0102:T00085",
     "kind": "본문",
     "jp": "「てけり・り？」",
     "ko": "「테케리・리?」"
    }
   ]
  },
  {
   "uid": "da0102:U00051",
   "speaker": "アル",
   "jp": "「何故……\n　汝も入ってくるかぁぁぁ――――ッ！？」",
   "cells": [
    {
     "sid": "da0102:T00086",
     "kind": "본문",
     "jp": "「何故……\n　汝も入ってくるかぁぁぁ――――ッ！？」",
     "ko": "「어째서……\n　네놈도 들어오는 것이냐아아아――――앗!?」"
    }
   ]
  },
  {
   "uid": "da0102:U00052",
   "speaker": "九郎",
   "jp": "「ドンマイドンマイ」",
   "cells": [
    {
     "sid": "da0102:T00087",
     "kind": "본문",
     "jp": "「ドンマイドンマイ」",
     "ko": "「돈마이 돈마이」"
    }
   ]
  },
  {
   "uid": "da0102:U00053",
   "speaker": "アル",
   "jp": "「何がだっ！？あっ、んん……っ！\n　こ、こら、変なところ触るなっ！」",
   "cells": [
    {
     "sid": "da0102:T00088",
     "kind": "본문",
     "jp": "「何がだっ！？",
     "ko": "「뭐가 말이냐앗!?"
    },
    {
     "sid": "da0102:T00089",
     "kind": "본문",
     "jp": "あっ、んん……っ！\n　こ、こら、変なところ触るなっ！」",
     "ko": "앗, 으응……읏!\n　이, 이놈, 이상한 데 만지지 마라앗!」"
    }
   ]
  },
  {
   "uid": "da0102:U00054",
   "speaker": "九郎",
   "jp": "「仕方ないだろ？　狭いんだから」",
   "cells": [
    {
     "sid": "da0102:T00090",
     "kind": "본문",
     "jp": "「仕方ないだろ？　狭いんだから」",
     "ko": "「어쩔 수 없잖아?　좁으니까」"
    }
   ]
  },
  {
   "uid": "da0102:U00055",
   "speaker": "アル",
   "jp": "「か、顔がにやけておるぞ！あ……あああっ……くぅぅんっ！\n　……ま、またぁぁぁぁっ！」",
   "cells": [
    {
     "sid": "da0102:T00091",
     "kind": "본문",
     "jp": "「か、顔がにやけておるぞ！",
     "ko": "「어, 얼굴이 실실 풀려 있잖느냐!"
    },
    {
     "sid": "da0102:T00092",
     "kind": "본문",
     "jp": "あ……あああっ……くぅぅんっ！\n　……ま、またぁぁぁぁっ！」",
     "ko": "아…… 아아앗…… 크으으응!\n　……또, 또오오오옷!」"
    }
   ]
  },
  {
   "uid": "da0102:U00056",
   "speaker": "九郎",
   "jp": "「やわらかいなぁ……」",
   "cells": [
    {
     "sid": "da0102:T00093",
     "kind": "본문",
     "jp": "「やわらかいなぁ……」",
     "ko": "「부드럽네……」"
    }
   ]
  },
  {
   "uid": "da0102:U00057",
   "speaker": "アル",
   "jp": "「しみじみ言うな！うくぅっ……そ、そこは……\n　駄目ぇぇぇ……っ！」",
   "cells": [
    {
     "sid": "da0102:T00094",
     "kind": "본문",
     "jp": "「しみじみ言うな！",
     "ko": "「음미하듯 말하지 마라!"
    },
    {
     "sid": "da0102:T00095",
     "kind": "본문",
     "jp": "うくぅっ……そ、そこは……\n　駄目ぇぇぇ……っ！」",
     "ko": "우크읏…… 거, 거기는……\n　안 돼에에에……읏!」"
    }
   ]
  },
  {
   "uid": "da0102:U00058",
   "speaker": "九郎",
   "jp": "「ヤベ。〈た〉勃ってきた」",
   "cells": [
    {
     "sid": "da0102:T00096",
     "kind": "본문",
     "jp": "「ヤベ。",
     "ko": "「큰일 났네. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00008",
     "kind": "루비 읽기",
     "jp": "た",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00097",
     "kind": "본문",
     "jp": "勃",
     "ko": "서",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00098",
     "kind": "본문",
     "jp": "ってきた」",
     "ko": " 버렸다」"
    }
   ]
  },
  {
   "uid": "da0102:U00059",
   "speaker": "アル",
   "jp": "「～～～～～ッ！？」",
   "cells": [
    {
     "sid": "da0102:T00099",
     "kind": "본문",
     "jp": "「～～～～～ッ！？」",
     "ko": "「~~~~~읏!?」"
    }
   ]
  },
  {
   "uid": "da0102:U00060",
   "speaker": "九郎",
   "jp": "「……アル」",
   "cells": [
    {
     "sid": "da0102:T00100",
     "kind": "본문",
     "jp": "「……アル」",
     "ko": "「……알」"
    }
   ]
  },
  {
   "uid": "da0102:U00061",
   "speaker": "アル",
   "jp": "「い……いぃ……いぃぃ～～～ッ」",
   "cells": [
    {
     "sid": "da0102:T00101",
     "kind": "본문",
     "jp": "「い……いぃ……いぃぃ～～～ッ」",
     "ko": "「이…… 이이…… 이이이~~~잇」"
    }
   ]
  },
  {
   "uid": "da0102:U00062",
   "speaker": "九郎",
   "jp": "「？」",
   "cells": [
    {
     "sid": "da0102:T00102",
     "kind": "본문",
     "jp": "「？」",
     "ko": "「?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0102:U00063",
   "speaker": "アル",
   "jp": "「……いい加減にせんかッ〈イロボケ〉色情狂がぁぁぁぁっ！」",
   "cells": [
    {
     "sid": "da0102:T00103",
     "kind": "본문",
     "jp": "「……いい加減にせんかッ",
     "ko": "「……적당히 좀 하란 말이다앗",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0102:R00009",
     "kind": "루비 읽기",
     "jp": "イロボケ",
     "ko": "색골",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0102:T00104",
     "kind": "본문",
     "jp": "色情狂",
     "ko": "색정광",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0102:T00105",
     "kind": "본문",
     "jp": "がぁぁぁぁっ！」",
     "ko": " 놈아아아아앗!」"
    }
   ]
  },
  {
   "uid": "da0102:U00064",
   "speaker": "九郎",
   "jp": "「ぐぎゃあああああああああっ！」",
   "cells": [
    {
