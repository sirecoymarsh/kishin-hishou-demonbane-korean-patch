{
 "packet": "P0070_da0701",
 "units": [
  {
   "uid": "da0701:U00001",
   "speaker": "ウェイトリイ",
   "jp": "「エエ・ヤ・ヤ・ヤ・ヤハアアア――エヤヤヤヤアアア……ングアアアアアア……ングアアアアア……フユウ……フユウ……助けて！……助けてくれ！……チ――チ――ちち――父上！　父上！ヨグ＝ソトース！」",
   "cells": [
    {
     "sid": "da0701:T00001",
     "kind": "본문",
     "jp": "「エエ",
     "ko": "「에에"
    },
    {
     "sid": "da0701:T00002",
     "kind": "본문",
     "jp": "・ヤ",
     "ko": "・야"
    },
    {
     "sid": "da0701:T00003",
     "kind": "본문",
     "jp": "・ヤ・ヤ・",
     "ko": "・야・야・"
    },
    {
     "sid": "da0701:T00004",
     "kind": "본문",
     "jp": "ヤハアアア――エヤヤヤヤアアア……ングアアアアアア……ングアア",
     "ko": "야하아아아――에야야야야아아아…… 으아아아아아아…… 으아아"
    },
    {
     "sid": "da0701:T00005",
     "kind": "본문",
     "jp": "アアア……フユウ…",
     "ko": "아아아…… 후유우…"
    },
    {
     "sid": "da0701:T00006",
     "kind": "본문",
     "jp": "…フユウ……助",
     "ko": "…후유우…… 살"
    },
    {
     "sid": "da0701:T00007",
     "kind": "본문",
     "jp": "けて！……助けてくれ！……チ",
     "ko": "려 줘! ……살려 줘! ……아"
    },
    {
     "sid": "da0701:T00008",
     "kind": "본문",
     "jp": "――チ――ち",
     "ko": "――아――아"
    },
    {
     "sid": "da0701:T00009",
     "kind": "본문",
     "jp": "ち――父上！　父上！",
     "ko": "버――아버님! 아버님!"
    },
    {
     "sid": "da0701:T00010",
     "kind": "본문",
     "jp": "ヨグ＝ソトース！」",
     "ko": " 요그 소토스!」"
    }
   ]
  },
  {
   "uid": "da0701:U00002",
   "speaker": "(지문)",
   "jp": "狂乱した虚空に、雷鳴の如く、鈍く響き渡る断末魔。それに唱和するように、何処からともなく、〈ウィップアーウィル〉夜鷹の嬌声が無数に\n重なり轟いた。",
   "cells": [
    {
     "sid": "da0701:T00011",
     "kind": "본문",
     "jp": "狂乱した虚空に、雷鳴の如く、鈍く響き渡る断末魔。",
     "ko": "광란하는 허공에, 뇌명처럼 둔탁하게 울려 퍼지는 단말마."
    },
    {
     "sid": "da0701:T00012",
     "kind": "본문",
     "jp": "それに唱和するように、何処からともなく、",
     "ko": "그에 창화하듯, 어디선가 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00001",
     "kind": "루비 읽기",
     "jp": "ウィップアーウィル",
     "ko": "위프어윌",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00013",
     "kind": "본문",
     "jp": "夜鷹",
     "ko": "쏙독새",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00014",
     "kind": "본문",
     "jp": "の嬌声が無数に\n重なり轟いた。",
     "ko": "의 교성이 무수히\n겹쳐 울려 퍼졌다."
    }
   ]
  },
  {
   "uid": "da0701:U00003",
   "speaker": "(지문)",
   "jp": "耳を〈つんざ〉劈く驚天動地の大音に、大地が激震する。ウェイトリイの躰が閃光と化して、天を貫いた。",
   "cells": [
    {
     "sid": "da0701:T00015",
     "kind": "본문",
     "jp": "耳を",
     "ko": "귀를 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00002",
     "kind": "루비 읽기",
     "jp": "つんざ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00016",
     "kind": "본문",
     "jp": "劈",
     "ko": "찢",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00017",
     "kind": "본문",
     "jp": "く驚天動地の大音に、大地が激震する。",
     "ko": "는 경천동지의 굉음에 대지가 격진한다."
    },
    {
     "sid": "da0701:T00018",
     "kind": "본문",
     "jp": "ウェイトリイの躰が閃光と化して、天を貫いた。",
     "ko": "웨이틀리의 몸이 섬광으로 화해 하늘을 꿰뚫었다."
    }
   ]
  },
  {
   "uid": "da0701:U00004",
   "speaker": "(지문)",
   "jp": "光はやがて紅に染まり、血の霧となって消滅する。そう。夢はただ夢と散り逝くだけだ。",
   "cells": [
    {
     "sid": "da0701:T00019",
     "kind": "본문",
     "jp": "光はやがて紅に染まり、血の霧となって消滅する。",
     "ko": "빛은 이윽고 진홍빛으로 물들더니, 피안개가 되어 소멸한다."
    },
    {
     "sid": "da0701:T00020",
     "kind": "본문",
     "jp": "そう。",
     "ko": "그렇다."
    },
    {
     "sid": "da0701:T00021",
     "kind": "본문",
     "jp": "夢はただ夢と散り逝くだけだ。",
     "ko": " 꿈은 그저 꿈으로 흩어져 사라질 뿐이다."
    }
   ]
  },
  {
   "uid": "da0701:U00005",
   "speaker": "アーミティッジ",
   "jp": "「おお……！」",
   "cells": [
    {
     "sid": "da0701:T00022",
     "kind": "본문",
     "jp": "「おお……！」",
     "ko": "「오오……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00006",
   "speaker": "アナザーブラッド",
   "jp": "「……デモンベイン！」",
   "cells": [
    {
     "sid": "da0701:T00023",
     "kind": "본문",
     "jp": "「……デモンベイン！」",
     "ko": "「……데몬베인!」"
    }
   ]
  },
  {
   "uid": "da0701:U00007",
   "speaker": "テリオン",
   "jp": "「……兄弟は敗れたようだな」",
   "cells": [
    {
     "sid": "da0701:T00024",
     "kind": "본문",
     "jp": "「……兄弟は敗れたようだな」",
     "ko": "「……형제는 패배한 모양이군」"
    }
   ]
  },
  {
   "uid": "da0701:U00008",
   "speaker": "(지문)",
   "jp": "〈リベル・レギス〉紅の機神から響く〈こえ〉聲は、激戦の最中にあってなおも涼やかだった。相対する〈アイオーン〉黒の機神が新たな偃月刀を鍛造し、身構える。",
   "cells": [
    {
     "sid": "da0701:R00003",
     "kind": "루비 읽기",
     "jp": "リベル・レギス",
     "ko": "리베르 레기스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00025",
     "kind": "본문",
     "jp": "紅の機神",
     "ko": "진홍의 기신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00026",
     "kind": "본문",
     "jp": "から響く",
     "ko": "에서 울리는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00004",
     "kind": "루비 읽기",
     "jp": "こえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00027",
     "kind": "본문",
     "jp": "聲",
     "ko": "목소리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00028",
     "kind": "본문",
     "jp": "は、激戦の最中にあってなおも涼やかだった。",
     "ko": "는, 격전의 한복판에서도 여전히 서늘했다."
    },
    {
     "sid": "da0701:T00029",
     "kind": "본문",
     "jp": "相対する",
     "ko": "마주 선 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00005",
     "kind": "루비 읽기",
     "jp": "アイオーン",
     "ko": "아이온",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00030",
     "kind": "본문",
     "jp": "黒の機神",
     "ko": "흑의 기신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00031",
     "kind": "본문",
     "jp": "が新たな偃月刀を鍛造し、身構える。",
     "ko": "이 새로운 언월도를 단조하며 자세를 잡는다."
    }
   ]
  },
  {
   "uid": "da0701:U00009",
   "speaker": "アズラッド",
   "jp": "「次は貴様の番だ、ズアウィア！」",
   "cells": [
    {
     "sid": "da0701:T00032",
     "kind": "본문",
     "jp": "「次は貴様の番だ、ズアウィア！」",
     "ko": "「다음은 네놈 차례다, 즈아위아!」"
    }
   ]
  },
  {
   "uid": "da0701:U00010",
   "speaker": "テリオン",
   "jp": "「〈いや〉否……まだ舞台は整っておらぬ」",
   "cells": [
    {
     "sid": "da0701:T00033",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00006",
     "kind": "루비 읽기",
     "jp": "いや",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00034",
     "kind": "본문",
     "jp": "否",
     "ko": "아니",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00035",
     "kind": "본문",
     "jp": "……まだ舞台は整っておらぬ」",
     "ko": "…… 아직 무대는 갖춰지지 않았다」"
    }
   ]
  },
  {
   "uid": "da0701:U00011",
   "speaker": "アズラッド",
   "jp": "「ハァァァ――ッ！」",
   "cells": [
    {
     "sid": "da0701:T00036",
     "kind": "본문",
     "jp": "「ハァァァ――ッ！」",
     "ko": "「하아아아――앗!」"
    }
   ]
  },
  {
   "uid": "da0701:U00012",
   "speaker": "(지문)",
   "jp": "斬りかかるアイオーン。",
   "cells": [
    {
     "sid": "da0701:T00037",
     "kind": "본문",
     "jp": "斬りかかるアイオーン。",
     "ko": "베어 들어가는 아이온."
    }
   ]
  },
  {
   "uid": "da0701:U00013",
   "speaker": "(지문)",
   "jp": "しかし刃は強固な防禦結界に阻まれ、リベル・レギスに届かない。魔刃に宿る魔力と防禦結界を編む魔力の衝突と摩擦が、火花と\nなって迸る。",
   "cells": [
    {
     "sid": "da0701:T00038",
     "kind": "본문",
     "jp": "しかし刃は強固な防禦結界に阻まれ、リベル・レギスに届かない。",
     "ko": "하지만 칼날은 강고한 방어결계에 막혀, 리베르 레기스에게 닿지 않는다."
    },
    {
     "sid": "da0701:T00039",
     "kind": "본문",
     "jp": "魔刃に宿る魔力と防禦結界を編む魔力の衝突と摩擦が、火花と\nなって迸る。",
     "ko": "마검에 깃든 마력과 방어결계를 엮는 마력의 충돌과 마찰이, 불꽃이\n되어 솟구친다."
    }
   ]
  },
  {
   "uid": "da0701:U00014",
   "speaker": "アズラッド",
   "jp": "「くっ……！」",
   "cells": [
    {
     "sid": "da0701:T00040",
     "kind": "본문",
     "jp": "「くっ……！」",
     "ko": "「큭……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00015",
   "speaker": "テリオン",
   "jp": "「――役者として喚ばれた以上、\n　勝手に役を降りる訳にもいくまい？」",
   "cells": [
    {
     "sid": "da0701:T00041",
     "kind": "본문",
     "jp": "「――役者として喚ばれた以上、\n　勝手に役を降りる訳にもいくまい？」",
     "ko": "「――배우로서 불려 나온 이상,\n　제멋대로 배역에서 내려올 수도 없지 않겠나?」"
    }
   ]
  },
  {
   "uid": "da0701:U00016",
   "speaker": "(지문)",
   "jp": "冷淡な〈こえ〉聲に嗜虐と嘲弄の響きが交じる。",
   "cells": [
    {
     "sid": "da0701:T00042",
     "kind": "본문",
     "jp": "冷淡な",
     "ko": "냉담한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00007",
     "kind": "루비 읽기",
     "jp": "こえ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00043",
     "kind": "본문",
     "jp": "聲",
     "ko": "목소리",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00044",
     "kind": "본문",
     "jp": "に嗜虐と嘲弄の響きが交じる。",
     "ko": "에 가학과 조롱의 울림이 섞인다."
    }
   ]
  },
  {
   "uid": "da0701:U00017",
   "speaker": "テリオン",
   "jp": "「それは貴公とて同じこと……〈プロヴィデンス・ロスト〉神国亡びし日から止まっていた\n時間が再び動き出したのだ。\n――そうだろう、〈アヴェンジャー〉復讐鬼？」",
   "cells": [
    {
     "sid": "da0701:T00045",
     "kind": "본문",
     "jp": "「それは貴公とて同じこと……",
     "ko": "「그건 귀공도 마찬가지……\n",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00008",
     "kind": "루비 읽기",
     "jp": "プロヴィデンス・ロスト",
     "ko": "프로비던스 로스트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00046",
     "kind": "본문",
     "jp": "神国亡びし日",
     "ko": "신국이 멸망한 날",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00047",
     "kind": "본문",
     "jp": "から止まっていた\n時間が再び動き出したのだ。\n――そうだろう、",
     "ko": "부터 멈춰 있던\n시간이 다시 움직이기 시작했다.\n――그렇지 않은가, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00009",
     "kind": "루비 읽기",
     "jp": "アヴェンジャー",
     "ko": "어벤저",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00048",
     "kind": "본문",
     "jp": "復讐鬼",
     "ko": "복수귀",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00049",
     "kind": "본문",
     "jp": "？」",
     "ko": "?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0701:U00018",
   "speaker": "アズラッド",
   "jp": "「……ッ！\n　ズアウィアァァァァ――ッ！」",
   "cells": [
    {
     "sid": "da0701:T00050",
     "kind": "본문",
     "jp": "「……ッ！\n　ズアウィアァァァァ――ッ！」",
     "ko": "「……윽!\n　즈아위아아아아아――앗!」"
    }
   ]
  },
  {
   "uid": "da0701:U00019",
   "speaker": "(지문)",
   "jp": "加速する術式が魔刃を赤熱させる。しかしリベル・レギスの防禦は破れない。",
   "cells": [
    {
     "sid": "da0701:T00051",
     "kind": "본문",
     "jp": "加速する術式が魔刃を赤熱させる。",
     "ko": "가속하는 술식이 마검을 적열시킨다."
    },
    {
     "sid": "da0701:T00052",
     "kind": "본문",
     "jp": "しかしリベル・レギスの防禦は破れない。",
     "ko": "하지만 리베르 레기스의 방어는 깨지지 않는다."
    }
   ]
  },
  {
   "uid": "da0701:U00020",
   "speaker": "(지문)",
   "jp": "アイオーンの周囲。唸りを発して、いくつもの爆炎が燃え上がる。爆炎はそれぞれ、新たな偃月刀を鍛造する。",
   "cells": [
    {
     "sid": "da0701:T00053",
     "kind": "본문",
     "jp": "アイオーンの周囲。",
     "ko": "아이온의 주위."
    },
    {
     "sid": "da0701:T00054",
     "kind": "본문",
     "jp": "唸りを発して、いくつもの爆炎が燃え上がる。",
     "ko": "굉음을 내며, 몇 줄기나 되는 폭염이 타오른다."
    },
    {
     "sid": "da0701:T00055",
     "kind": "본문",
     "jp": "爆炎はそれぞれ、新たな偃月刀を鍛造する。",
     "ko": "폭염은 저마다 새로운 언월도를 단조한다."
    }
   ]
  },
  {
   "uid": "da0701:U00021",
   "speaker": "(지문)",
   "jp": "炎を刀身に纏いながら、偃月刀が飛翔する。リベル・レギスに降り注ぐ魔刃の雨。それを押し止める防禦陣が、少しずつ綻んでゆく。",
   "cells": [
    {
     "sid": "da0701:T00056",
     "kind": "본문",
     "jp": "炎を刀身に纏いながら、偃月刀が飛翔する。",
     "ko": "화염을 도신에 두른 채 언월도가 비상한다."
    },
    {
     "sid": "da0701:T00057",
     "kind": "본문",
     "jp": "リベル・レギスに降り注ぐ魔刃の雨。",
     "ko": "리베르 레기스에게 쏟아지는 마검의 비."
    },
    {
     "sid": "da0701:T00058",
     "kind": "본문",
     "jp": "それを押し止める防禦陣が、少しずつ綻んでゆく。",
     "ko": "그것을 막아내는 방어진이 조금씩 허물어져 간다."
    }
   ]
  },
  {
   "uid": "da0701:U00022",
   "speaker": "テリオン",
   "jp": "「心地好い怒りだ。今しばし貴公との〈ダンス〉舞闘を楽しみたいところだが……」",
   "cells": [
    {
     "sid": "da0701:T00059",
     "kind": "본문",
     "jp": "「心地好い怒りだ。今しばし貴公との",
     "ko": "「기분 좋은 분노다. 잠시 더 귀공과의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00010",
     "kind": "루비 읽기",
     "jp": "ダンス",
     "ko": "댄스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00060",
     "kind": "본문",
     "jp": "舞闘",
     "ko": "무투",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00061",
     "kind": "본문",
     "jp": "を楽しみたいところだが……」",
     "ko": "를 즐기고 싶은 참이지만……」"
    }
   ]
  },
  {
   "uid": "da0701:U00023",
   "speaker": "アズラッド",
   "jp": "「オオオオオオオオ！」",
   "cells": [
    {
     "sid": "da0701:T00062",
     "kind": "본문",
     "jp": "「オオオオオオオオ！」",
     "ko": "「오오오오오오오오!」"
    }
   ]
  },
  {
   "uid": "da0701:U00024",
   "speaker": "(지문)",
   "jp": "アズラッドが全ての偃月刀に魔力を注ぎ込む。軋みを上げる防禦陣。攻防の均衡が崩れようとしていた。",
   "cells": [
    {
     "sid": "da0701:T00063",
     "kind": "본문",
     "jp": "アズラッドが全ての偃月刀に魔力を注ぎ込む。",
     "ko": "아즈라드가 모든 언월도에 마력을 쏟아붓는다."
    },
    {
     "sid": "da0701:T00064",
     "kind": "본문",
     "jp": "軋みを上げる防禦陣。",
     "ko": "삐걱거리는 소리를 내는 방어진."
    },
    {
     "sid": "da0701:T00065",
     "kind": "본문",
     "jp": "攻防の均衡が崩れようとしていた。",
     "ko": "공방의 균형이 무너지려 하고 있었다."
    }
   ]
  },
  {
   "uid": "da0701:U00025",
   "speaker": "(지문)",
   "jp": "負荷に耐え切れず、全ての偃月刀が砕け散った。それと同時にリベル・レギスの防禦陣も呪力を失い、霧散した。",
   "cells": [
    {
     "sid": "da0701:T00066",
     "kind": "본문",
     "jp": "負荷に耐え切れず、全ての偃月刀が砕け散った。",
     "ko": "부하를 견디지 못하고 모든 언월도가 산산이 부서졌다."
    },
    {
     "sid": "da0701:T00067",
     "kind": "본문",
     "jp": "それと同時にリベル・レギスの防禦陣も呪力を失い、霧散した。",
     "ko": "그와 동시에 리베르 레기스의 방어진도 주력을 잃고 무산되었다."
    }
   ]
  },
  {
   "uid": "da0701:U00026",
   "speaker": "(지문)",
   "jp": "追撃を試みるアイオーン。しかしリベル・レギスの動きはそれより速い。",
   "cells": [
    {
     "sid": "da0701:T00068",
     "kind": "본문",
     "jp": "追撃を試みるアイオーン。",
     "ko": "추격을 시도하는 아이온."
    },
    {
     "sid": "da0701:T00069",
     "kind": "본문",
     "jp": "しかしリベル・レギスの動きはそれより速い。",
     "ko": "하지만 리베르 레기스의 움직임은 그보다 빠르다."
    }
   ]
  },
  {
   "uid": "da0701:U00027",
   "speaker": "テリオン",
   "jp": "「残念ながら――\n　まだ時は満ちていない」",
   "cells": [
    {
     "sid": "da0701:T00070",
     "kind": "본문",
     "jp": "「残念ながら――\n　まだ時は満ちていない」",
     "ko": "「유감스럽게도――\n　아직 때는 무르익지 않았다」"
    }
   ]
  },
  {
   "uid": "da0701:U00028",
   "speaker": "(지문)",
   "jp": "高速の機動により、アイオーンの背後を取るリベル・レギス。その掌にはいつの間にか、金色に輝く剣が握られていた。",
   "cells": [
    {
     "sid": "da0701:T00071",
     "kind": "본문",
     "jp": "高速の機動により、アイオーンの背後を取るリベル・レギス。",
     "ko": "고속 기동으로 아이온의 배후를 잡는 리베르 레기스."
    },
    {
     "sid": "da0701:T00072",
     "kind": "본문",
     "jp": "その掌にはいつの間にか、金色に輝く剣が握られていた。",
     "ko": "그 손바닥에는 어느새 금빛으로 빛나는 검이 쥐어져 있었다."
    }
   ]
  },
  {
   "uid": "da0701:U00029",
   "speaker": "アズラッド",
   "jp": "「くっ……！？」",
   "cells": [
    {
     "sid": "da0701:T00073",
     "kind": "본문",
     "jp": "「くっ……！？」",
     "ko": "「큭……!?」"
    }
   ]
  },
  {
   "uid": "da0701:U00030",
   "speaker": "アズラッド",
   "jp": "「ぐああああ！」",
   "cells": [
    {
     "sid": "da0701:T00074",
     "kind": "본문",
     "jp": "「ぐああああ！」",
     "ko": "「그아아아아!」"
    }
   ]
  },
  {
   "uid": "da0701:U00031",
   "speaker": "(지문)",
   "jp": "金色の剣閃が走る。重い衝撃がアイオーンを吹き飛ばした。破損箇所から〈アゾート〉水銀の血が噴き出し、宙に〈しぶ〉飛沫く。",
   "cells": [
    {
     "sid": "da0701:T00075",
     "kind": "본문",
     "jp": "金色の剣閃が走る。",
     "ko": "금빛 검섬이 내달린다."
    },
    {
     "sid": "da0701:T00076",
     "kind": "본문",
     "jp": "重い衝撃がアイオーンを吹き飛ばした。",
     "ko": "무거운 충격이 아이온을 날려 버렸다."
    },
    {
     "sid": "da0701:T00077",
     "kind": "본문",
     "jp": "破損箇所から",
     "ko": "파손 부위에서 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00011",
     "kind": "루비 읽기",
     "jp": "アゾート",
     "ko": "아조트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00078",
     "kind": "본문",
     "jp": "水銀",
     "ko": "수은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00079",
     "kind": "본문",
     "jp": "の血が噴き出し、宙に",
     "ko": "의 피가 뿜어져 나와 허공에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00012",
     "kind": "루비 읽기",
     "jp": "しぶ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00080",
     "kind": "본문",
     "jp": "飛沫",
     "ko": "물보라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00081",
     "kind": "본문",
     "jp": "く。",
     "ko": "친다."
    }
   ]
  },
  {
   "uid": "da0701:U00032",
   "speaker": "アズラッド",
   "jp": "「おのれ……！」",
   "cells": [
    {
     "sid": "da0701:T00082",
     "kind": "본문",
     "jp": "「おのれ……！」",
     "ko": "「네 이놈……!」"
    }
   ]
  },
  {
   "uid": "da0701:U00033",
   "speaker": "シュリュズベリイ",
   "jp": "「避けろ！　黒いの！」",
   "cells": [
    {
     "sid": "da0701:T00083",
     "kind": "본문",
     "jp": "「避けろ！　黒いの！」",
     "ko": "「피해라! 검은 녀석!」"
    }
   ]
  },
  {
   "uid": "da0701:U00034",
   "speaker": "アズラッド",
   "jp": "「――！？」",
   "cells": [
    {
     "sid": "da0701:T00084",
     "kind": "본문",
     "jp": "「――！？」",
     "ko": "「――!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0701:U00035",
   "speaker": "(지문)",
   "jp": "体勢を立て直すより速く、シャンタクを噴かせ、その場から\n離脱する。",
   "cells": [
    {
     "sid": "da0701:T00085",
     "kind": "본문",
     "jp": "体勢を立て直すより速く、シャンタクを噴かせ、その場から\n離脱する。",
     "ko": "자세를 가다듬기보다 빠르게 샨타크를 분사해 그 자리에서\n이탈한다."
    }
   ]
  },
  {
   "uid": "da0701:U00036",
   "speaker": "(지문)",
   "jp": "次の瞬間、混沌の海が爆発した。混沌の海から猛スピードで飛び出した何かが、アイオーンのすぐ脇を通り過ぎてゆく。\n\n　機体を拘束する赤黒い触手を引きずりながら、飛翔する戦闘機――",
   "cells": [
    {
     "sid": "da0701:T00086",
     "kind": "본문",
     "jp": "次の瞬間、混沌の海が爆発した。",
     "ko": "다음 순간, 혼돈의 바다가 폭발했다."
    },
    {
     "sid": "da0701:T00087",
     "kind": "본문",
     "jp": "混沌の海から猛スピードで飛び出した何かが、アイオーンのすぐ脇を通り過ぎてゆく。\n\n　機体を拘束する赤黒い触手を引きずりながら、飛翔する戦闘機――",
     "ko": "혼돈의 바다에서 맹렬한 스피드로 튀어나온 무언가가, 아이온의 바로 옆을 스쳐 지나간다.\n\n　기체를 구속하는 검붉은 촉수를 질질 끌며 비상하는 전투기――"
    }
   ]
  },
  {
   "uid": "da0701:U00037",
   "speaker": "テリオン",
   "jp": "「盲目のご老体か！」",
   "cells": [
    {
     "sid": "da0701:T00088",
     "kind": "본문",
     "jp": "「盲目のご老体か！」",
     "ko": "「맹목의 노인장인가!」"
    }
   ]
  },
  {
   "uid": "da0701:U00038",
   "speaker": "ハヅキ",
   "jp": "「フーン機関〈オーバードライブ〉全力運転！〈ミード〉燃料残量……残りわずか！」",
   "cells": [
    {
     "sid": "da0701:T00089",
     "kind": "본문",
     "jp": "「フーン機関",
     "ko": "「훈 기관 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00013",
     "kind": "루비 읽기",
     "jp": "オーバードライブ",
     "ko": "오버드라이브",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00090",
     "kind": "본문",
     "jp": "全力運転",
     "ko": "전력 운전",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00091",
     "kind": "본문",
     "jp": "！",
     "ko": "!\n　",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0701:R00014",
     "kind": "루비 읽기",
     "jp": "ミード",
     "ko": "미드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00092",
     "kind": "본문",
     "jp": "燃料",
     "ko": "연료",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00093",
     "kind": "본문",
     "jp": "残量……残りわずか！」",
     "ko": " 잔량…… 얼마 안 남았어!」"
    }
   ]
  },
  {
   "uid": "da0701:U00039",
   "speaker": "シュリュズベリイ",
   "jp": "「このまま、ぶつけるぞ！」",
   "cells": [
    {
     "sid": "da0701:T00094",
     "kind": "본문",
     "jp": "「このまま、ぶつけるぞ！」",
     "ko": "「이대로 부딪친다!」"
    }
   ]
  },
  {
   "uid": "da0701:U00040",
   "speaker": "(지문)",
   "jp": "戦闘機形態のアンブロシウスは、上空で大きく弧を描きながら\n急加速。爆速を生むのは蛮名化した魔術言語、超高密度の術式。\n\n　霊子の吸引→魔術的定義の圧縮→魔力燃焼→排気／爆発＝物理的／概念的に。",
   "cells": [
    {
     "sid": "da0701:T00095",
     "kind": "본문",
     "jp": "戦闘機形態のアンブロシウスは、上空で大きく弧を描きながら\n急加速。",
     "ko": "전투기 형태의 암브로시우스는 상공에서 크게 호를 그리며\n급가속."
    },
    {
     "sid": "da0701:T00096",
     "kind": "본문",
     "jp": "爆速を生むのは蛮名化した魔術言語、超高密度の術式。\n\n　霊子の吸引→魔術的定義の圧縮→魔力燃焼→排気／爆発",
     "ko": "폭속을 낳는 것은 만명화한 마술언어, 초고밀도의 술식.\n\n　영자의 흡인→마술적 정의의 압축→마력 연소→배기/폭발"
    },
    {
     "sid": "da0701:T00097",
     "kind": "본문",
     "jp": "＝物理的／概念的に。",
     "ko": "＝물리적/개념적으로."
    }
   ]
  },
  {
   "uid": "da0701:U00041",
   "speaker": "(지문)",
   "jp": "速度と魔力の〈フィールド〉結界を纏い、アンブロシウスは光と化した。アンブロシウス特攻形態。光は物理法則を無視した、異常極まる機動でリベル・レギスに迫る。",
   "cells": [
    {
     "sid": "da0701:T00098",
     "kind": "본문",
     "jp": "速度と魔力の",
     "ko": "속도와 마력의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0701:R00015",
     "kind": "루비 읽기",
     "jp": "フィールド",
     "ko": "필드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0701:T00099",
     "kind": "본문",
     "jp": "結界",
     "ko": "결계",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0701:T00100",
     "kind": "본문",
     "jp": "を纏い、アンブロシウスは光と化した。",
     "ko": "를 두르고, 암브로시우스는 빛으로 화했다."
    },
    {
     "sid": "da0701:T00101",
     "kind": "본문",
     "jp": "アンブロシウス特攻形態。",
     "ko": "암브로시우스 특공 형태."
    },
    {
     "sid": "da0701:T00102",
     "kind": "본문",
     "jp": "光は物理法則を無視した、異常極まる機動でリベル・レギスに迫る。",
     "ko": "빛은 물리법칙을 무시한, 이상하기 짝이 없는 기동으로 리베르 레기스에게 육박한다."
    }
   ]
  },
  {
   "uid": "da0701:U00042",
   "speaker": "テリオン",
   "jp": "「――――！」",
   "cells": [
    {
     "sid": "da0701:T00103",
     "kind": "본문",
     "jp": "「――――！」",
     "ko": "「――――!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0701:U00043",
   "speaker": "(지문)",
   "jp": "光が紅の機神を貫く。",
   "cells": [
    {
     "sid": "da0701:T00104",
     "kind": "본문",
     "jp": "光が紅の機神を貫く。",
     "ko": "빛이 진홍의 기신을 꿰뚫는다."
    }
   ]
  },
  {
   "uid": "da0701:U00044",
   "speaker": "九郎",
   "jp": "「――っ！？」\n\n　勝利の余韻に浸っている暇なんて、ありはしない。向こうの方――アイオーンとリベル・レギスが交戦している辺りで\n大爆発が起こった。\n\n　乱れ狂うエネルギーの嵐。閃光と爆音が物質的な圧力を持って、街を震わせた。",
   "cells": [
    {
     "sid": "da0701:T00105",
     "kind": "본문",
     "jp": "「――っ！？」\n\n　勝利の余韻に浸っている暇なんて、ありはしない。",
     "ko": "「――윽!?」\n\n　승리의 여운에 잠겨 있을 틈 따윈 없다."
    },
    {
     "sid": "da0701:T00106",
     "kind": "본문",
     "jp": "向こうの方――アイオーンとリベル・レギスが交戦している辺りで\n大爆発が起こった。\n\n　乱れ狂うエネルギーの嵐。",
     "ko": "저쪽――아이온과 리베르 레기스가 교전하고 있는 근처에서\n대폭발이 일어났다.\n\n　미쳐 날뛰는 에너지의 폭풍."
    },
    {
     "sid": "da0701:T00107",
     "kind": "본문",
     "jp": "閃光と爆音が物質的な圧力を持って、街を震わせた。",
     "ko": "섬광과 폭음이 물질적인 압력을 띠고 거리를 뒤흔들었다."
    }
   ]
  },
  {
