{
 "packet": "P0041_da0309",
 "units": [
  {
   "uid": "da0309:U00001",
   "speaker": "(지문)",
   "jp": "また、しろい、景色。しろい、ベッドとしろい、シーツとしろい、天井としろい、かべとしろい、ゆかとしろい、カーテンと――――私のゆめは、いつだって、しろい。",
   "cells": [
    {
     "sid": "da0309:T00001",
     "kind": "본문",
     "jp": "また、しろい、景色。",
     "ko": "또다시, 하얀, 풍경."
    },
    {
     "sid": "da0309:T00002",
     "kind": "본문",
     "jp": "しろい、ベッドと",
     "ko": "하얀, 침대와"
    },
    {
     "sid": "da0309:T00003",
     "kind": "본문",
     "jp": "しろい、シーツと",
     "ko": "하얀, 시트와"
    },
    {
     "sid": "da0309:T00004",
     "kind": "본문",
     "jp": "しろい、天井と",
     "ko": "하얀, 천장과"
    },
    {
     "sid": "da0309:T00005",
     "kind": "본문",
     "jp": "しろい、かべと",
     "ko": "하얀, 벽과"
    },
    {
     "sid": "da0309:T00006",
     "kind": "본문",
     "jp": "しろい、ゆかと",
     "ko": "하얀, 바닥과"
    },
    {
     "sid": "da0309:T00007",
     "kind": "본문",
     "jp": "しろい、カーテンと――",
     "ko": "하얀, 커튼과――"
    },
    {
     "sid": "da0309:T00008",
     "kind": "본문",
     "jp": "――私のゆめは、いつだって、しろい。",
     "ko": "――내 꿈은, 언제나, 하얗다."
    }
   ]
  },
  {
   "uid": "da0309:U00002",
   "speaker": "ライカ",
   "jp": "「えっ……なに……ここ……？」",
   "cells": [
    {
     "sid": "da0309:T00009",
     "kind": "본문",
     "jp": "「えっ……なに……ここ……？」",
     "ko": "「어…… 뭐야…… 여기……?」"
    }
   ]
  },
  {
   "uid": "da0309:U00003",
   "speaker": "(지문)",
   "jp": "あなたは、またこの白の中に立つ。かつての、あなたの、原風景。決して逃れられない〈はず〉筈だった、呪いのはじまり。",
   "cells": [
    {
     "sid": "da0309:T00010",
     "kind": "본문",
     "jp": "あなたは、またこの白の中に立つ。",
     "ko": "당신은, 또다시 이 하양 속에 선다."
    },
    {
     "sid": "da0309:T00011",
     "kind": "본문",
     "jp": "かつての、あなたの、原風景。",
     "ko": "일찍이 보았던, 당신의, 원풍경."
    },
    {
     "sid": "da0309:T00012",
     "kind": "본문",
     "jp": "決して逃れられない",
     "ko": "결코 벗어날 수 없을 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0309:R00001",
     "kind": "루비 읽기",
     "jp": "はず",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0309:T00013",
     "kind": "본문",
     "jp": "筈",
     "ko": "터",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0309:T00014",
     "kind": "본문",
     "jp": "だった、呪いのはじまり。",
     "ko": "였던, 저주의 시작."
    }
   ]
  },
  {
   "uid": "da0309:U00004",
   "speaker": "ライカ",
   "jp": "「私……どうして……」",
   "cells": [
    {
     "sid": "da0309:T00015",
     "kind": "본문",
     "jp": "「私……どうして……」",
     "ko": "「나…… 어째서……」"
    }
   ]
  },
  {
   "uid": "da0309:U00005",
   "speaker": "(지문)",
   "jp": "汚れひとつない、清潔な白。気が狂うほどに、潔癖な白。白しろシロ。",
   "cells": [
    {
     "sid": "da0309:T00016",
     "kind": "본문",
     "jp": "汚れひとつない、清潔な白。",
     "ko": "얼룩 하나 없는, 청결한 하양."
    },
    {
     "sid": "da0309:T00017",
     "kind": "본문",
     "jp": "気が狂うほどに、潔癖な白。",
     "ko": "미쳐 버릴 정도로, 결벽한 하양."
    },
    {
     "sid": "da0309:T00018",
     "kind": "본문",
     "jp": "白",
     "ko": "백"
    },
    {
     "sid": "da0309:T00019",
     "kind": "본문",
     "jp": "しろ",
     "ko": " 하양"
    },
    {
     "sid": "da0309:T00020",
     "kind": "본문",
     "jp": "シロ。",
     "ko": " 하양."
    }
   ]
  },
  {
   "uid": "da0309:U00006",
   "speaker": "ライカ",
   "jp": "「どうして……どうして……\nどう、して……ぁ……ぁぁああ……っ」",
   "cells": [
    {
     "sid": "da0309:T00021",
     "kind": "본문",
     "jp": "「どうして……どうして……\nどう、して……ぁ……ぁぁああ……っ」",
     "ko": "「어째서…… 어째서……\n어째, 서…… 아…… 아아아아……앗」"
    }
   ]
  },
  {
   "uid": "da0309:U00007",
   "speaker": "(지문)",
   "jp": "――白い、牢獄だ。",
   "cells": [
    {
     "sid": "da0309:T00022",
     "kind": "본문",
     "jp": "――白い、牢獄だ。",
     "ko": "――하얀, 감옥이다."
    }
   ]
  },
  {
   "uid": "da0309:U00008",
   "speaker": "ライカ",
   "jp": "「ぁ……あぁぁ……」",
   "cells": [
    {
     "sid": "da0309:T00023",
     "kind": "본문",
     "jp": "「ぁ……あぁぁ……」",
     "ko": "「아…… 아아아……」"
    }
   ]
  },
  {
   "uid": "da0309:U00009",
   "speaker": "(지문)",
   "jp": "得体の知れない不安と恐怖に、激しく脈打つ心臓。\n\n　\n　\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　あなたは胸を押さえ、〈うずくま〉蹲る。そうだ。逃れることなどできない。たとえ〈とき〉時間と世界が忘れても、この白い牢獄は在り続ける。",
   "cells": [
    {
     "sid": "da0309:T00024",
     "kind": "본문",
     "jp": "得体の知れない不安と恐怖に、激しく脈打つ心臓。\n\n　\n　\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　あなたは胸を押さえ、",
     "ko": "정체 모를 불안과 공포에 거세게 맥박 치는 심장.\n\n　\n　\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　당신은 가슴을 움켜쥐고, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0309:R00002",
     "kind": "루비 읽기",
     "jp": "うずくま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0309:T00025",
     "kind": "본문",
     "jp": "蹲",
     "ko": "웅크",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0309:T00026",
     "kind": "본문",
     "jp": "る。",
     "ko": "린다."
    },
    {
     "sid": "da0309:T00027",
     "kind": "본문",
     "jp": "そうだ。逃れることなどできない。",
     "ko": "그렇다. 벗어날 수 있을 리 없다."
    },
    {
     "sid": "da0309:T00028",
     "kind": "본문",
     "jp": "たとえ",
     "ko": "설령 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0309:R00003",
     "kind": "루비 읽기",
     "jp": "とき",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0309:T00029",
     "kind": "본문",
     "jp": "時間",
     "ko": "시간",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0309:T00030",
     "kind": "본문",
     "jp": "と世界が忘れても、この白い牢獄は在り続ける。",
     "ko": "과 세계가 잊는다 해도, 이 하얀 감옥은 계속 존재한다."
    }
   ]
  },
  {
   "uid": "da0309:U00010",
   "speaker": "ライカ",
   "jp": "「…………？」",
   "cells": [
    {
     "sid": "da0309:T00031",
     "kind": "본문",
     "jp": "「…………？」",
     "ko": "「…………?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0309:U00011",
   "speaker": "(지문)",
   "jp": "あなたの罪は、此処に、在り続ける。",
   "cells": [
    {
     "sid": "da0309:T00032",
     "kind": "본문",
     "jp": "あなたの罪は、此処に、在り続ける。",
     "ko": "당신의 죄는, 이곳에, 계속 존재한다."
    }
   ]
  },
  {
   "uid": "da0309:U00012",
   "speaker": "ライカ",
   "jp": "「……みんな？」",
   "cells": [
    {
     "sid": "da0309:T00033",
     "kind": "본문",
     "jp": "「……みんな？」",
     "ko": "「……얘들아?」"
    }
   ]
  },
  {
   "uid": "da0309:U00013",
   "speaker": "(지문)",
   "jp": "さあ、顔を上げて。そしてその目でしっかり見るんだ。",
   "cells": [
    {
     "sid": "da0309:T00034",
     "kind": "본문",
     "jp": "さあ、顔を上げて。",
     "ko": "자, 고개를 들어."
    },
    {
     "sid": "da0309:T00035",
     "kind": "본문",
     "jp": "そしてその目でしっかり見るんだ。",
     "ko": "그리고 그 눈으로 똑똑히 보는 거다."
    }
   ]
  },
  {
   "uid": "da0309:U00014",
   "speaker": "ライカ",
   "jp": "「――――！？」",
   "cells": [
    {
     "sid": "da0309:T00036",
     "kind": "본문",
     "jp": "「――――！？」",
     "ko": "「――――!?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0309:U00015",
   "speaker": "ライカ",
   "jp": "「みんなぁぁぁっ！」",
   "cells": [
    {
     "sid": "da0309:T00037",
     "kind": "본문",
     "jp": "「みんなぁぁぁっ！」",
     "ko": "「얘들아아아앗!」"
    }
   ]
  },
  {
   "uid": "da0309:U00016",
   "speaker": "(지문)",
   "jp": "あなたは走る。あなたの大切な人たちの元へ。息を切らせながら、必死に。必死に。",
   "cells": [
    {
     "sid": "da0309:T00038",
     "kind": "본문",
     "jp": "あなたは走る。",
     "ko": "당신은 달린다."
    },
    {
     "sid": "da0309:T00039",
     "kind": "본문",
     "jp": "あなたの大切な人たちの元へ。",
     "ko": "당신의 소중한 사람들이 있는 곳으로."
    },
    {
     "sid": "da0309:T00040",
     "kind": "본문",
     "jp": "息を切らせながら、必死に。",
     "ko": "숨을 헐떡이면서, 필사적으로."
    },
    {
     "sid": "da0309:T00041",
     "kind": "본문",
     "jp": "必死に。",
     "ko": " 필사적으로."
    }
   ]
  },
  {
   "uid": "da0309:U00017",
   "speaker": "ライカ",
   "jp": "「ジョージ！　コリン！　アリスン！」",
   "cells": [
    {
     "sid": "da0309:T00042",
     "kind": "본문",
     "jp": "「ジョージ！　コリン！　アリスン！」",
     "ko": "「조지!　콜린!　앨리슨!」"
    }
   ]
  },
  {
   "uid": "da0309:U00018",
   "speaker": "(지문)",
   "jp": "だが、決してたどり着かない。あなたと、あなたの大切な人たちの間には、無限のへだたりがある。\n\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　ゼノンの〈パラドックス〉呪いだ。絶対に、絶対に、たどり着けない。",
   "cells": [
    {
     "sid": "da0309:T00043",
     "kind": "본문",
     "jp": "だが、決してたどり着かない。",
     "ko": "하지만, 결코 다다르지 못한다."
    },
    {
     "sid": "da0309:T00044",
     "kind": "본문",
     "jp": "あなたと、あなたの大切な人たちの間には、無限のへだたりがある。\n\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　ゼノンの",
     "ko": "당신과, 당신의 소중한 사람들 사이에는, 무한한 간극이 있다.\n\n　\n　\n　\n　\n　\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　제논의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0309:R00004",
     "kind": "루비 읽기",
     "jp": "パラドックス",
     "ko": "패러독스",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0309:T00045",
     "kind": "본문",
     "jp": "呪い",
     "ko": "저주",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0309:T00046",
     "kind": "본문",
     "jp": "だ。",
     "ko": "다."
    },
    {
     "sid": "da0309:T00047",
     "kind": "본문",
     "jp": "絶対に、絶対に、たどり着けない。",
     "ko": "절대로, 절대로, 다다를 수 없다."
    }
   ]
  },
  {
   "uid": "da0309:U00019",
   "speaker": "アリスン",
   "jp": "「た……たすけ……て……」",
   "cells": [
    {
     "sid": "da0309:T00048",
     "kind": "본문",
     "jp": "「た……たすけ……て……」",
     "ko": "「사…… 살려…… 줘……」"
    }
   ]
  },
  {
   "uid": "da0309:U00020",
   "speaker": "ライカ",
   "jp": "「うわあああああああああああ！」",
   "cells": [
    {
     "sid": "da0309:T00049",
     "kind": "본문",
     "jp": "「うわあああああああああああ！」",
     "ko": "「우와아아아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0309:U00021",
   "speaker": "(지문)",
   "jp": "あなたは、いつだって無力だ。なあ、そうだろ……？",
   "cells": [
    {
     "sid": "da0309:T00050",
     "kind": "본문",
     "jp": "あなたは、いつだって無力だ。",
     "ko": "당신은, 언제나 무력하다."
    },
    {
     "sid": "da0309:T00051",
     "kind": "본문",
     "jp": "なあ、そうだろ……？",
     "ko": "있지, 그렇지……?"
    }
   ]
  },
  {
   "uid": "da0309:U00022",
   "speaker": "(지문)",
   "jp": "「ライカ姉さん」",
   "cells": [
    {
     "sid": "da0309:T00052",
     "kind": "본문",
     "jp": "「ライカ姉さん」",
     "ko": "「라이카 누나」"
    }
   ]
  }
 ]
}