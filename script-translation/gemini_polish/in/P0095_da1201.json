{
 "packet": "P0095_da1201",
 "units": [
  {
   "uid": "da1201:U00001",
   "speaker": "テリオン",
   "jp": "「は……ははは……\n　ははははははは！\n　ははははははははは！」",
   "cells": [
    {
     "sid": "da1201:T00001",
     "kind": "본문",
     "jp": "「は……ははは……\n　ははははははは！\n　ははははははははは！」",
     "ko": "「하…… 하하하……\n　하하하하하하하!\n　하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da1201:U00002",
   "speaker": "(지문)",
   "jp": "哄笑が広大な心臓の間に響き渡る。だけどそれは笑っているのに、泣いているように聴こえた。",
   "cells": [
    {
     "sid": "da1201:T00002",
     "kind": "본문",
     "jp": "哄笑が広大な心臓の間に響き渡る。",
     "ko": "홍소가 광대한 심장의 방에 울려 퍼진다."
    },
    {
     "sid": "da1201:T00003",
     "kind": "본문",
     "jp": "だけどそれは笑っているのに、泣いているように聴こえた。",
     "ko": "하지만 그것은 웃고 있는데도 울고 있는 것처럼 들렸다."
    }
   ]
  },
  {
   "uid": "da1201:U00003",
   "speaker": "エセルドレーダ",
   "jp": "「……マスター」",
   "cells": [
    {
     "sid": "da1201:T00004",
     "kind": "본문",
     "jp": "「……マスター」",
     "ko": "「……마스터」"
    }
   ]
  },
  {
   "uid": "da1201:U00004",
   "speaker": "(지문)",
   "jp": "力を失ったネームレス・ワンは枯れ果てた大樹のような姿で\n立ち尽くしていた。",
   "cells": [
    {
     "sid": "da1201:T00005",
     "kind": "본문",
     "jp": "力を失ったネームレス・ワンは枯れ果てた大樹のような姿で\n立ち尽くしていた。",
     "ko": "힘을 잃은 네임리스 원은 말라죽은 거목 같은 모습으로\n우두커니 서 있었다."
    }
   ]
  },
  {
   "uid": "da1201:U00005",
   "speaker": "(지문)",
   "jp": "ひび割れる機体。崩れた破片がボロボロと血の海に墜ちてゆく。",
   "cells": [
    {
     "sid": "da1201:T00006",
     "kind": "본문",
     "jp": "ひび割れる機体。",
     "ko": "금이 가는 기체."
    },
    {
     "sid": "da1201:T00007",
     "kind": "본문",
     "jp": "崩れた破片がボロボロと血の海に墜ちてゆく。",
     "ko": "무너진 파편이 후드득 피의 바다로 떨어져 내린다."
    }
   ]
  },
  {
   "uid": "da1201:U00006",
   "speaker": "(지문)",
   "jp": "リベル・レギスがネームレス・ワンの胸部を鷲掴みにして、\n一気に引き剥がした。\n\n\n　祭壇にも似た操縦室が剥き出しになる。その中に、息も絶え絶えな少女の姿。",
   "cells": [
    {
     "sid": "da1201:T00008",
     "kind": "본문",
     "jp": "リベル・レギスがネームレス・ワンの胸部を鷲掴みにして、\n一気に引き剥がした。\n\n\n　祭壇にも似た操縦室が剥き出しになる。",
     "ko": "리베르 레기스가 네임리스 원의 흉부를 움켜쥐고,\n단숨에 뜯어냈다.\n\n\n　제단과도 닮은 조종실이 고스란히 드러난다."
    },
    {
     "sid": "da1201:T00009",
     "kind": "본문",
     "jp": "その中に、息も絶え絶えな少女の姿。",
     "ko": "그 안에, 숨이 끊어질 듯한 소녀의 모습."
    }
   ]
  },
  {
   "uid": "da1201:U00007",
   "speaker": "テリオン",
   "jp": "「さあ……母さん。\n　僕の〈オモイ〉怨嗟を受け取ってください」",
   "cells": [
    {
     "sid": "da1201:T00010",
     "kind": "본문",
     "jp": "「さあ……母さん。\n　僕の",
     "ko": "「자…… 어머니.\n　저의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00001",
     "kind": "루비 읽기",
     "jp": "オモイ",
     "ko": "마음",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00011",
     "kind": "본문",
     "jp": "怨嗟",
     "ko": "원망",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00012",
     "kind": "본문",
     "jp": "を受け取ってください」",
     "ko": "을 받아 주세요」"
    }
   ]
  },
  {
   "uid": "da1201:U00008",
   "speaker": "(지문)",
   "jp": "リベル・レギスの右掌が白く〈も〉焔える。〈ハイパーボリア・ゼロドライブ〉絶対零度の刃。その掌に触れれば、一切が死の静寂に停止し、跡形もなく\n　消滅する。\n\n　これで総てに〈とど〉止めを。そして再び黒の王としてデモンベインの前に――",
   "cells": [
    {
     "sid": "da1201:T00013",
     "kind": "본문",
     "jp": "リベル・レギスの右掌が白く",
     "ko": "리베르 레기스의 오른 손바닥이 하얗게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00002",
     "kind": "루비 읽기",
     "jp": "も",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00014",
     "kind": "본문",
     "jp": "焔",
     "ko": "불타오",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00015",
     "kind": "본문",
     "jp": "える。",
     "ko": "른다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00003",
     "kind": "루비 읽기",
     "jp": "ハイパーボリア・ゼロドライブ",
     "ko": "하이퍼보리아 제로드라이브",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00016",
     "kind": "본문",
     "jp": "絶対零度の刃",
     "ko": "절대영도의 칼날",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00017",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1201:T00018",
     "kind": "본문",
     "jp": "その掌に触れれば、一切が死の静寂に停止し、跡形もなく\n　消滅する。\n\n　これで総てに",
     "ko": "그 손바닥에 닿으면 일체가 죽음의 정적 속에 정지하여, 흔적도 없이\n　소멸한다.\n\n　이걸로 모든 것에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00004",
     "kind": "루비 읽기",
     "jp": "とど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00019",
     "kind": "본문",
     "jp": "止",
     "ko": "끝",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00020",
     "kind": "본문",
     "jp": "めを。",
     "ko": "을."
    },
    {
     "sid": "da1201:T00021",
     "kind": "본문",
     "jp": "そして再び黒の王としてデモンベインの前に――",
     "ko": "그리고 다시 흑의 왕으로서 데몬베인 앞에――"
    }
   ]
  },
  {
   "uid": "da1201:U00009",
   "speaker": "ネロ",
   "jp": "「……もう良いんだよ」",
   "cells": [
    {
     "sid": "da1201:T00022",
     "kind": "본문",
     "jp": "「……もう良いんだよ」",
     "ko": "「……이제 됐단다」"
    }
   ]
  },
  {
   "uid": "da1201:U00010",
   "speaker": "テリオン",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da1201:T00023",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1201:U00011",
   "speaker": "(지문)",
   "jp": "突然返ってきた少女の声に、マスターテリオンは酷い違和感を\n覚えた。",
   "cells": [
    {
     "sid": "da1201:T00024",
     "kind": "본문",
     "jp": "突然返ってきた少女の声に、マスターテリオンは酷い違和感を\n覚えた。",
     "ko": "갑자기 돌아온 소녀의 목소리에, 마스터 테리온은 심한 위화감을\n느꼈다."
    }
   ]
  },
  {
   "uid": "da1201:U00012",
   "speaker": "ネロ",
   "jp": "「……もう苦しまなくても良い」",
   "cells": [
    {
     "sid": "da1201:T00025",
     "kind": "본문",
     "jp": "「……もう苦しまなくても良い」",
     "ko": "「……더는 괴로워하지 않아도 돼」"
    }
   ]
  },
  {
   "uid": "da1201:U00013",
   "speaker": "(지문)",
   "jp": "脳裏を駆ける〈ノイズ〉雑念／〈ノイズ〉雑念／〈ノイズ〉雑念。",
   "cells": [
    {
     "sid": "da1201:T00026",
     "kind": "본문",
     "jp": "脳裏を駆ける",
     "ko": "뇌리를 스치는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00005",
     "kind": "루비 읽기",
     "jp": "ノイズ",
     "ko": "노이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00027",
     "kind": "본문",
     "jp": "雑念",
     "ko": "잡념",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00028",
     "kind": "본문",
     "jp": "／",
     "ko": "／",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1201:R00006",
     "kind": "루비 읽기",
     "jp": "ノイズ",
     "ko": "노이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00029",
     "kind": "본문",
     "jp": "雑念",
     "ko": "잡념",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00030",
     "kind": "본문",
     "jp": "／",
     "ko": "／",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1201:R00007",
     "kind": "루비 읽기",
     "jp": "ノイズ",
     "ko": "노이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00031",
     "kind": "본문",
     "jp": "雑念",
     "ko": "잡념",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00032",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1201:U00014",
   "speaker": "テリオン",
   "jp": "「――違う」",
   "cells": [
    {
     "sid": "da1201:T00033",
     "kind": "본문",
     "jp": "「――違う」",
     "ko": "「――아니야」"
    }
   ]
  },
  {
   "uid": "da1201:U00015",
   "speaker": "エセルドレーダ",
   "jp": "「……マスター？」",
   "cells": [
    {
     "sid": "da1201:T00034",
     "kind": "본문",
     "jp": "「……マスター？」",
     "ko": "「……마스터?」"
    }
   ]
  },
  {
   "uid": "da1201:U00016",
   "speaker": "ネロ",
   "jp": "「君は、本当ならもう……\n　　　　　　救われているんだから」",
   "cells": [
    {
     "sid": "da1201:T00035",
     "kind": "본문",
     "jp": "「君は、本当ならもう……\n　　　　　　救われているんだから」",
     "ko": "「너는, 원래대로라면 이미……\n　　　　　　구원받았으니까」"
    }
   ]
  },
  {
   "uid": "da1201:U00017",
   "speaker": "(지문)",
   "jp": "さっきまでとは違う。リベル・レギスを見上げる瞳――そこに宿るのは、あの底無しの闇ではない。〈・・・〉底無しよりも深く、しかし何よりも透明な瞳。それは少年の識らない、少女／母の瞳だ。",
   "cells": [
    {
     "sid": "da1201:T00036",
     "kind": "본문",
     "jp": "さっきまでとは違う。",
     "ko": "조금 전까지와는 다르다."
    },
    {
     "sid": "da1201:T00037",
     "kind": "본문",
     "jp": "リベル・レギスを見上げる瞳――",
     "ko": "리베르 레기스를 올려다보는 눈동자――"
    },
    {
     "sid": "da1201:T00038",
     "kind": "본문",
     "jp": "そこに宿るのは、あの底無しの闇ではない。",
     "ko": "그곳에 깃든 것은 저 밑바닥 없는 어둠이 아니다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da1201:R00008",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00039",
     "kind": "본문",
     "jp": "底無し",
     "ko": "밑바닥 없는 것",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00040",
     "kind": "본문",
     "jp": "よりも深く、しかし何よりも透明な瞳。",
     "ko": "보다도 깊고, 그러나 무엇보다도 투명한 눈동자."
    },
    {
     "sid": "da1201:T00041",
     "kind": "본문",
     "jp": "それは少年の識らない、少女／母の瞳だ。",
     "ko": "그것은 소년이 알지 못하는, 소녀/어머니의 눈동자다."
    }
   ]
  },
  {
   "uid": "da1201:U00018",
   "speaker": "エセルドレーダ",
   "jp": "「…………ッ！」",
   "cells": [
    {
     "sid": "da1201:T00042",
     "kind": "본문",
     "jp": "「…………ッ！」",
     "ko": "「…………읏!」"
    }
   ]
  },
  {
   "uid": "da1201:U00019",
   "speaker": "(지문)",
   "jp": "――決定的に、違う。",
   "cells": [
    {
     "sid": "da1201:T00043",
     "kind": "본문",
     "jp": "――決定的に、違う。",
     "ko": "――결정적으로, 다르다."
    }
   ]
  },
  {
   "uid": "da1201:U00020",
   "speaker": "テリオン",
   "jp": "「貴女は……〈・・・〉さっき〈・・・〉までの〈・・・・・・〉悪夢ではない！」",
   "cells": [
    {
