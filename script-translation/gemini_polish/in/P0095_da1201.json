     "kind": "본문",
     "jp": "さっき",
     "ko": "방금 전",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da1201:R00010",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00046",
     "kind": "본문",
     "jp": "までの",
     "ko": "까지의 ",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da1201:R00011",
     "kind": "루비 읽기",
     "jp": "・・・・・・",
     "ko": "・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1201:T00047",
     "kind": "본문",
     "jp": "悪夢ではない",
     "ko": "악몽이 아니야",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1201:T00048",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da1201:U00021",
   "speaker": "エセルドレーダ",
   "jp": "「何……何なんですか、\n　貴女は……！」",
   "cells": [
