    {
     "sid": "da1204:T00029",
     "kind": "본문",
     "jp": "解呪",
     "ko": "해주",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1204:T00030",
     "kind": "본문",
     "jp": "する」",
     "ko": "하겠다」"
    }
