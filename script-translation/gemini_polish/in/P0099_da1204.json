  },
  {
   "uid": "da1204:U00031",
   "speaker": "九朔",
   "jp": "「〈たお〉斃れろ、大十字九郎……！\n　英雄気取りの愚物め！\n　『魔を断つ剣』は\n　誇り高き騎士の剣なのだ！」",
   "cells": [
    {
     "sid": "da1204:T00063",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da1204:R00010",
     "kind": "루비 읽기",
     "jp": "たお",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da1204:T00064",
     "kind": "본문",
     "jp": "斃",
     "ko": "쓰러져",
     "ruby_edge": "앞"
    },
    {
     "sid": "da1204:T00065",
     "kind": "본문",
     "jp": "れろ、大十字九郎……！\n　英雄気取りの愚物め！\n　『魔を断つ剣』は\n　誇り高き騎士の剣なのだ！」",
     "ko": "라, 다이쥬지 쿠로……!\n　영웅 행세를 하는 어리석은 놈!\n　『마를 끊는 검』은\n　긍지 높은 기사의 검이란 말이다!」"
    }
   ]
  },
  {
   "uid": "da1204:U00032",
   "speaker": "九郎",
   "jp": "「なに、ワケの分からねえこと言ってんだ、お前は……！」",
   "cells": [
    {
     "sid": "da1204:T00066",
     "kind": "본문",
     "jp": "「なに、ワケの分からねえこと言ってんだ、お前は……！」",
     "ko": "「무슨 영문 모를 소리를 지껄이는 거냐, 네 녀석은……!」"
    }
   ]
  },
  {
   "uid": "da1204:U00033",
   "speaker": "(지문)",
   "jp": "互いに弾かれるように飛び退く。その際にＤトゥーソードはロイガーとツァールを組み合わせ、投擲。こちらもまた偃月刀を投げつける。",
   "cells": [
    {
     "sid": "da1204:T00067",
     "kind": "본문",
     "jp": "互いに弾かれるように飛び退く。",
     "ko": "서로 튕겨 나가듯 물러선다."
    },
    {
     "sid": "da1204:T00068",
     "kind": "본문",
     "jp": "その際にＤトゥーソードはロイガーとツァールを組み合わせ、投擲。",
     "ko": "그사이 D 투 소드는 로이거와 차르를 결합하여 투척."
