     "sid": "da0312:T00057",
     "kind": "본문",
     "jp": "偶々",
     "ko": "우연히",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00058",
     "kind": "본문",
     "jp": "、鬼に憑かれたというだけだ。\n　ならば祓うのが道理であろう？」",
     "ko": ", 귀신에게 씌었을 뿐이지.\n　그렇다면 퇴마하는 것이 도리 아니겠느냐?」"
    }
   ]
  },
  {
   "uid": "da0312:U00024",
   "speaker": "ウィンフィールド",
   "jp": "「〈エクソシズム〉悪魔祓いは専門外ですが」",
   "cells": [
    {
     "sid": "da0312:T00059",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0312:R00016",
     "kind": "루비 읽기",
     "jp": "エクソシズム",
     "ko": "엑소시즘은",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00060",
     "kind": "본문",
     "jp": "悪魔祓い",
     "ko": "악마 퇴치는",
     "ruby_edge": "앞"
