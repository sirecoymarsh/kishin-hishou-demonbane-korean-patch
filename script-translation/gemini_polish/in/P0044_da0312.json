     "kind": "본문",
     "jp": "冥",
     "ko": "어둡",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00084",
     "kind": "본문",
     "jp": "く、冷たい声が呟きとして漏れる。",
     "ko": "고 차가운 목소리가 중얼거림이 되어 흘러나온다."
