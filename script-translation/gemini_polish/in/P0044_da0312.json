    }
   ]
  },
  {
   "uid": "da0312:U00025",
   "speaker": "ティトゥス",
   "jp": "「なに、拙者を祓うのに念仏は要らぬよ」",
   "cells": [
    {
     "sid": "da0312:T00062",
     "kind": "본문",
     "jp": "「なに、拙者を祓うのに念仏は要らぬよ」",
     "ko": "「뭘, 소인을 퇴마하는 데 염불은 필요 없다」"
    }
   ]
  },
  {
   "uid": "da0312:U00026",
   "speaker": "(지문)",
   "jp": "四刀が妖しく煌めく。高まる両者の闘気は、最高潮に達していた。大気を歪ませるほどの〈プレッシャー〉圧迫感が、広間を震わせる。\n\n　サムライは凄惨な笑みを浮かべ、告げた。",
   "cells": [
    {
     "sid": "da0312:T00063",
     "kind": "본문",
     "jp": "四刀が妖しく煌めく。",
     "ko": "네 자루의 칼이 요사스럽게 번뜩인다."
    },
    {
     "sid": "da0312:T00064",
     "kind": "본문",
     "jp": "高まる両者の闘気は、最高潮に達していた。",
     "ko": "고조되는 양자의 투기는 최고조에 달해 있었다."
    },
    {
     "sid": "da0312:T00065",
     "kind": "본문",
     "jp": "大気を歪ませるほどの",
     "ko": "대기를 일그러뜨릴 정도의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00017",
     "kind": "루비 읽기",
     "jp": "プレッシャー",
     "ko": "프레셔가",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00066",
     "kind": "본문",
     "jp": "圧迫感",
     "ko": "압박감이",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00067",
     "kind": "본문",
     "jp": "が、広間を震わせる。\n\n　サムライは凄惨な笑みを浮かべ、告げた。",
     "ko": " 홀을 뒤흔든다.\n\n　사무라이는 처참한 미소를 띠며 고했다."
    }
   ]
  },
  {
   "uid": "da0312:U00027",
   "speaker": "ティトゥス",
   "jp": "「――その拳があれば事足りる」",
   "cells": [
    {
