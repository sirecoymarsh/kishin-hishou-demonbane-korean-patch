   "jp": "「今のは……！」",
   "cells": [
    {
     "sid": "da0312:T00003",
     "kind": "본문",
     "jp": "「今のは……！」",
     "ko": "「방금 그건……!」"
    }
   ]
  },
  {
   "uid": "da0312:U00004",
   "speaker": "ティトゥス",
   "jp": "「〈かわ〉躱したか……」",
   "cells": [
    {
     "sid": "da0312:T00004",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0312:R00001",
     "kind": "루비 읽기",
     "jp": "かわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00005",
     "kind": "본문",
     "jp": "躱",
     "ko": "피",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00006",
     "kind": "본문",
     "jp": "したか……」",
     "ko": "했는가……」"
    }
   ]
  },
  {
   "uid": "da0312:U00005",
   "speaker": "ティトゥス",
   "jp": "「我が〈しれんざん〉四連斬を」",
   "cells": [
    {
     "sid": "da0312:T00007",
     "kind": "본문",
     "jp": "「我が",
     "ko": "「나의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00002",
     "kind": "루비 읽기",
     "jp": "しれんざん",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00008",
     "kind": "본문",
     "jp": "四連斬",
     "ko": "사연참",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00009",
     "kind": "본문",
     "jp": "を」",
     "ko": "을」"
    }
   ]
  },
  {
   "uid": "da0312:U00006",
   "speaker": "ウィンフィールド",
   "jp": "「四本腕！」",
   "cells": [
    {
     "sid": "da0312:T00010",
     "kind": "본문",
     "jp": "「四本腕！」",
     "ko": "「네 개의 팔!」"
    }
   ]
  },
  {
   "uid": "da0312:U00007",
   "speaker": "ティトゥス",
   "jp": "「〈しか〉然り。拙者は『屍食教典儀』の力によって\n　魔人の〈からだ〉肉体を手に入れた外道ぞ」",
   "cells": [
    {
     "sid": "da0312:T00011",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0312:R00003",
     "kind": "루비 읽기",
     "jp": "しか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00012",
     "kind": "본문",
     "jp": "然",
     "ko": "그렇",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00013",
     "kind": "본문",
     "jp": "り。拙者は『屍食教典儀』の力によって\n　魔人の",
     "ko": "다. 소인은 『시식교전의』의 힘으로\n　마인의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00004",
     "kind": "루비 읽기",
     "jp": "からだ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00014",
     "kind": "본문",
     "jp": "肉体",
     "ko": "육체",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00015",
     "kind": "본문",
     "jp": "を手に入れた外道ぞ」",
     "ko": "를 손에 넣은 외도다」"
    }
   ]
  },
  {
   "uid": "da0312:U00008",
   "speaker": "ウィンフィールド",
   "jp": "「詳しい事は解かりませんが……\n『悪魔に魂を売った』と言ったところでしょうか？」",
   "cells": [
    {
     "sid": "da0312:T00016",
     "kind": "본문",
     "jp": "「詳しい事は解かりませんが……\n『悪魔に魂を売った』と言ったところでしょうか？」",
     "ko": "「자세한 사정은 모르겠습니다만……\n『악마에게 영혼을 팔았다』는 셈이겠군요?」"
    }
   ]
  },
  {
   "uid": "da0312:U00009",
   "speaker": "ティトゥス",
   "jp": "「そんなところだ……クククッ」",
   "cells": [
    {
     "sid": "da0312:T00017",
     "kind": "본문",
     "jp": "「そんなところだ……クククッ」",
     "ko": "「그런 셈이지…… 크크큭」"
    }
   ]
  },
  {
   "uid": "da0312:U00010",
   "speaker": "ウィンフィールド",
   "jp": "「……何が可笑しいのです？」",
   "cells": [
    {
     "sid": "da0312:T00018",
     "kind": "본문",
     "jp": "「……何が可笑しいのです？」",
     "ko": "「……무엇이 우스운 겁니까?」"
    }
   ]
  },
  {
   "uid": "da0312:U00011",
   "speaker": "ティトゥス",
   "jp": "「いや……何な。\n　先程の剣、お主には〈・・・〉躱せぬ〈・・・・〉筈だった〈・・〉のよ」",
   "cells": [
    {
     "sid": "da0312:T00019",
     "kind": "본문",
     "jp": "「いや……何な。\n　先程の剣、お主には",
     "ko": "「아니…… 별것 아니다.\n　방금 전의 검, 그대는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00005",
     "kind": "루비 읽기",
     "jp": "・・・",
     "ko": "・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00020",
     "kind": "본문",
     "jp": "躱せぬ",
     "ko": "피하지",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da0312:R00006",
     "kind": "루비 읽기",
     "jp": "・・・・",
     "ko": "・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00021",
     "kind": "본문",
     "jp": "筈だった",
     "ko": " 못할 터",
     "ruby_edge": "앞·뒤"
    },
    {
     "sid": "da0312:R00007",
     "kind": "루비 읽기",
     "jp": "・・",
     "ko": "・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00022",
     "kind": "본문",
     "jp": "のよ",
     "ko": "였거늘",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00023",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00012",
   "speaker": "ウィンフィールド",
   "jp": "「……？」",
   "cells": [
    {
     "sid": "da0312:T00024",
     "kind": "본문",
     "jp": "「……？」",
     "ko": "「……?」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00013",
   "speaker": "ティトゥス",
   "jp": "「躱せぬ筈だったのにのぅ？\n　クククク……クハハハハハハッ！」",
   "cells": [
    {
     "sid": "da0312:T00025",
     "kind": "본문",
     "jp": "「躱せぬ筈だったのにのぅ？\n　クククク……クハハハハハハッ！」",
     "ko": "「피하지 못할 터였는데 말이지?\n　크크크크…… 크하하하하하핫!」"
    }
   ]
  },
  {
   "uid": "da0312:U00014",
   "speaker": "ウィンフィールド",
   "jp": "「……余程の秘技だったようですが、\n　所詮は単なる不意打ち。\n　侮ってもらっては困りますな」",
   "cells": [
    {
     "sid": "da0312:T00026",
     "kind": "본문",
     "jp": "「……余程の秘技だったようですが、\n　所詮は単なる不意打ち。\n　侮ってもらっては困りますな」",
     "ko": "「……상당한 비기였던 모양입니다만,\n　어차피 단순한 기습.\n　얕보셔서는 곤란합니다」"
    }
   ]
  },
  {
   "uid": "da0312:U00015",
   "speaker": "ティトゥス",
   "jp": "「クフフフ……いやはや全く。\n　非礼を詫びよう、ウィンフィールド」",
   "cells": [
    {
     "sid": "da0312:T00027",
     "kind": "본문",
     "jp": "「クフフフ……いやはや全く。\n　非礼を詫びよう、ウィンフィールド」",
     "ko": "「크후후후…… 이거 참 실로 그렇군.\n　무례를 사과하지, 윈필드」"
    }
   ]
  },
  {
   "uid": "da0312:U00016",
   "speaker": "ウィンフィールド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0312:T00028",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00017",
   "speaker": "(지문)",
   "jp": "――第六感に類するものではない。ウィンフィールドはそう判断する。先程の四連斬を回避したのは、勘ではない。\n\n　あれは『確信』だった。「来る」と察したのではない。「来る」ことを識っていたのだ。\n\n　この敵には『奥の手』があると。今、このタイミングならば、必ずそれが飛んでくると。\n\n　ウィンフィールドは識っていた。〈・・・・・・・・・〉戦ったこともない敵の、奥の手を。それはあまりにも鮮明すぎた、〈デジャビュ〉既視感。",
   "cells": [
    {
     "sid": "da0312:T00029",
     "kind": "본문",
     "jp": "――第六感に類するものではない。",
     "ko": "――육감 따위에 속하는 것이 아니다."
    },
    {
     "sid": "da0312:T00030",
     "kind": "본문",
     "jp": "ウィンフィールドはそう判断する。",
     "ko": "윈필드는 그렇게 판단한다."
    },
    {
     "sid": "da0312:T00031",
     "kind": "본문",
     "jp": "先程の四連斬を回避したのは、勘ではない。\n\n　あれは『確信』だった。",
     "ko": "방금 전의 사연참을 회피한 것은 감이 아니다.\n\n　그것은 『확신』이었다."
    },
    {
     "sid": "da0312:T00032",
     "kind": "본문",
     "jp": "「来る」と察したのではない。",
     "ko": "「온다」고 감지한 것이 아니다."
    },
    {
     "sid": "da0312:T00033",
     "kind": "본문",
     "jp": "「来る」ことを識っていたのだ。\n\n　この敵には『奥の手』があると。",
     "ko": "「온다」는 것을 알고 있었던 것이다.\n\n　이 적에게는 『비장의 수』가 있다고."
    },
    {
     "sid": "da0312:T00034",
     "kind": "본문",
     "jp": "今、このタイミングならば、必ずそれが飛んでくると。\n\n　ウィンフィールドは識っていた。",
     "ko": "지금 이 타이밍이라면 반드시 그것이 날아온다고.\n\n　윈필드는 알고 있었다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00008",
     "kind": "루비 읽기",
     "jp": "・・・・・・・・・",
     "ko": "・・・・・・・・・",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00035",
     "kind": "본문",
     "jp": "戦ったこともない敵",
     "ko": "싸워 본 적도 없는 적",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00036",
     "kind": "본문",
     "jp": "の、奥の手を。",
     "ko": "의 비장의 수를."
    },
    {
     "sid": "da0312:T00037",
     "kind": "본문",
     "jp": "それはあまりにも鮮明すぎた、",
     "ko": "그것은 너무나도 선명했던, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00009",
     "kind": "루비 읽기",
     "jp": "デジャビュ",
     "ko": "데자뷔",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00038",
     "kind": "본문",
     "jp": "既視感",
     "ko": "기시감",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00039",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00018",
   "speaker": "ウィンフィールド",
   "jp": "「……そう言えば、まだお名前を〈うかが〉伺っておりませんでしたね。\n　よろしければ――」",
   "cells": [
    {
     "sid": "da0312:T00040",
     "kind": "본문",
     "jp": "「……そう言えば、まだお名前を",
     "ko": "「……그러고 보니, 아직 성함을",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00010",
     "kind": "루비 읽기",
     "jp": "うかが",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00041",
     "kind": "본문",
     "jp": "伺",
     "ko": "여쭙",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00042",
     "kind": "본문",
     "jp": "っておりませんでしたね。\n　よろしければ――」",
     "ko": "지 못했군요.\n　괜찮으시다면――」"
    }
   ]
  },
  {
   "uid": "da0312:U00019",
   "speaker": "ティトゥス",
   "jp": "「不要〈ナリ〉也」",
   "cells": [
    {
     "sid": "da0312:T00043",
     "kind": "본문",
     "jp": "「不要",
     "ko": "「불필요",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00011",
     "kind": "루비 읽기",
     "jp": "ナリ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00044",
     "kind": "본문",
     "jp": "也",
     "ko": "하다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00045",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00020",
   "speaker": "ウィンフィールド",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0312:T00046",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0312:U00021",
   "speaker": "ティトゥス",
   "jp": "「拙者は〈まぼろし〉幻影。\n　浅い眠りに見る、〈おぼろ〉朧げな悪夢に過ぎん。〈こだわ〉拘る価値もあるまい」",
   "cells": [
    {
     "sid": "da0312:T00047",
     "kind": "본문",
     "jp": "「拙者は",
     "ko": "「소인은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00012",
     "kind": "루비 읽기",
     "jp": "まぼろし",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00048",
     "kind": "본문",
     "jp": "幻影",
     "ko": "환영",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00049",
     "kind": "본문",
     "jp": "。\n　浅い眠りに見る、",
     "ko": ".\n　얕은 잠에서 꾸는, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00013",
     "kind": "루비 읽기",
     "jp": "おぼろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00050",
     "kind": "본문",
     "jp": "朧",
     "ko": "어렴풋",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00051",
     "kind": "본문",
     "jp": "げな悪夢に過ぎん。",
     "ko": "한 악몽에 불과하다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00014",
     "kind": "루비 읽기",
     "jp": "こだわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0312:T00052",
     "kind": "본문",
     "jp": "拘",
     "ko": "구애",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0312:T00053",
     "kind": "본문",
     "jp": "る価値もあるまい」",
     "ko": "될 가치도 없을 터」"
    }
   ]
  },
  {
   "uid": "da0312:U00022",
   "speaker": "(지문)",
   "jp": "黒のサムライの闘気が冷たく、鋭く、研ぎ澄まされてゆく。それを察したウィンフィールドもまた、神経を研ぎ澄ませる。",
   "cells": [
    {
     "sid": "da0312:T00054",
     "kind": "본문",
     "jp": "黒のサムライの闘気が冷たく、鋭く、研ぎ澄まされてゆく。",
     "ko": "검은 사무라이의 투기가 차갑고 날카롭게 벼려져 간다."
    },
    {
     "sid": "da0312:T00055",
     "kind": "본문",
     "jp": "それを察したウィンフィールドもまた、神経を研ぎ澄ませる。",
     "ko": "그것을 감지한 윈필드 또한 신경을 곤두세운다."
    }
   ]
  },
  {
   "uid": "da0312:U00023",
   "speaker": "ティトゥス",
   "jp": "「この戦いは、単なる拙者の妄執ぞ。\n　お主は〈たまたま〉偶々、鬼に憑かれたというだけだ。\n　ならば祓うのが道理であろう？」",
   "cells": [
    {
     "sid": "da0312:T00056",
     "kind": "본문",
     "jp": "「この戦いは、単なる拙者の妄執ぞ。\n　お主は",
     "ko": "「이 싸움은 단순한 소인의 망집이다.\n　그대는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0312:R00015",
     "kind": "루비 읽기",
     "jp": "たまたま",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
