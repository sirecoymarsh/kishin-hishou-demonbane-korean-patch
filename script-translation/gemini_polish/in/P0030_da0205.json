{
 "packet": "P0030_da0205",
 "units": [
  {
   "uid": "da0205:U00001",
   "speaker": "(지문)",
   "jp": "血の〈いろ〉彩のデモンベインに対峙する、もう一体のデモンベイン。\n\n　良く見れば、頭部の形や脚部シールドの位置、カラーリング等々、\n俺の知るデモンベインとは色々と違っていた。",
   "cells": [
    {
     "sid": "da0205:T00001",
     "kind": "본문",
     "jp": "血の",
     "ko": "핏",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00001",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00002",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00003",
     "kind": "본문",
     "jp": "のデモンベインに対峙する、もう一体のデモンベイン。\n\n　良く見れば、頭部の形や脚部シールドの位置、カラーリング等々、\n俺の知るデモンベインとは色々と違っていた。",
     "ko": " 데몬베인과 대치하는, 또 한 대의 데몬베인.\n\n　자세히 보니 머리 부분의 형태나 다리 실드의 위치, 컬러링 등등, 내가 아는 데몬베인과는 여러모로 달랐다."
    }
   ]
  },
  {
   "uid": "da0205:U00002",
   "speaker": "(지문)",
   "jp": "だがそれでもその〈フォルム〉全体像が、〈イメージ〉空気が、こいつはデモンベインだと\n雄弁に語ってくれる。",
   "cells": [
    {
     "sid": "da0205:T00004",
     "kind": "본문",
     "jp": "だがそれでもその",
     "ko": "하지만 그럼에도 그 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00002",
     "kind": "루비 읽기",
     "jp": "フォルム",
     "ko": "포름",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00005",
     "kind": "본문",
     "jp": "全体像",
     "ko": "전체상",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00006",
     "kind": "본문",
     "jp": "が、",
     "ko": "이, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00003",
     "kind": "루비 읽기",
     "jp": "イメージ",
     "ko": "이미지",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00007",
     "kind": "본문",
     "jp": "空気",
     "ko": "분위기",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00008",
     "kind": "본문",
     "jp": "が、こいつはデモンベインだと\n雄弁に語ってくれる。",
     "ko": "가, 이 녀석은 데몬베인이라고 웅변해 준다."
    }
   ]
  },
  {
   "uid": "da0205:U00003",
   "speaker": "アナザーブラッド",
   "jp": "「――来たわね、〈トゥーソード／トゥーガン〉二闘流！」",
   "cells": [
    {
     "sid": "da0205:T00009",
     "kind": "본문",
     "jp": "「――来たわね、",
     "ko": "「――왔네, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00004",
     "kind": "루비 읽기",
     "jp": "トゥーソード／トゥーガン",
     "ko": "투 소드/투 건",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00010",
     "kind": "본문",
     "jp": "二闘流",
     "ko": "이투류",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00011",
     "kind": "본문",
     "jp": "！」",
     "ko": "!」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0205:U00004",
   "speaker": "(지문)",
   "jp": "２体目のデモンベインのハッチが開いた。コクピットの中から出てきたのは、小柄な人影。真紅のマントに身を包む少年だ。\n\n　少年は血染めのデモンベインの上、紅の少女を真っ直ぐに見据え、宣言する。",
   "cells": [
    {
     "sid": "da0205:T00012",
     "kind": "본문",
     "jp": "２体目のデモンベインのハッチが開いた。",
     "ko": "두 번째 데몬베인의 해치가 열렸다."
    },
    {
     "sid": "da0205:T00013",
     "kind": "본문",
     "jp": "コクピットの中から出てきたのは、小柄な人影。",
     "ko": "콕핏 안에서 나온 것은 몸집이 작은 그림자."
    },
    {
     "sid": "da0205:T00014",
     "kind": "본문",
     "jp": "真紅のマントに身を包む少年だ。\n\n　少年は血染めのデモンベインの上、紅の少女を真っ直ぐに見据え、宣言する。",
     "ko": "진홍빛 망토로 몸을 감싼 소년이다.\n\n　소년은 피로 물든 데몬베인 위, 붉은 소녀를 똑바로 응시하며 선언한다."
    }
   ]
  },
  {
   "uid": "da0205:U00005",
   "speaker": "九朔",
   "jp": "「魔道に生きる身なれど、〈ココロ〉魂は〈ツルギ〉騎士道に〈ささ〉奉げたり。\n　　　――外道、断つべし」",
   "cells": [
    {
     "sid": "da0205:T00015",
     "kind": "본문",
     "jp": "「魔道に生きる身なれど、",
     "ko": "「마도에 사는 몸이나,",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00005",
     "kind": "루비 읽기",
     "jp": "ココロ",
     "ko": "마음",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00016",
     "kind": "본문",
     "jp": "魂",
     "ko": "혼",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00017",
     "kind": "본문",
     "jp": "は",
     "ko": "은 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00006",
     "kind": "루비 읽기",
     "jp": "ツルギ",
     "ko": "검",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00018",
     "kind": "본문",
     "jp": "騎士道",
     "ko": "기사도",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00019",
     "kind": "본문",
     "jp": "に",
     "ko": "에 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00007",
     "kind": "루비 읽기",
     "jp": "ささ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00020",
     "kind": "본문",
     "jp": "奉",
     "ko": "바쳤",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00021",
     "kind": "본문",
     "jp": "げたり。\n　　　――外道、断つべし」",
     "ko": "노라.\n　　　――외도, 베어 마땅하다」"
    }
   ]
  },
  {
   "uid": "da0205:U00006",
   "speaker": "アナザーブラッド",
   "jp": "「〈ひど〉非道い言われよう。\n　この子だってデモンベインよ？」",
   "cells": [
    {
     "sid": "da0205:T00022",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0205:R00008",
     "kind": "루비 읽기",
     "jp": "ひど",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00023",
     "kind": "본문",
     "jp": "非道",
     "ko": "너무한",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00024",
     "kind": "본문",
     "jp": "い言われよう。\n　この子だってデモンベインよ？」",
     "ko": " 말투네.\n　이 아이도 데몬베인이거든?」"
    }
   ]
  },
  {
   "uid": "da0205:U00007",
   "speaker": "九朔",
   "jp": "「――〈しか〉然り。\n　罪に錆びゆく血濡れの刃だ。\n　これ以上穢されるくらいなら、\n　この手で引導を渡そう」",
   "cells": [
    {
     "sid": "da0205:T00025",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0205:R00009",
     "kind": "루비 읽기",
     "jp": "しか",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00026",
     "kind": "본문",
     "jp": "然",
     "ko": "그렇다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00027",
     "kind": "본문",
     "jp": "り。\n　罪に錆びゆく血濡れの刃だ。\n　これ以上穢されるくらいなら、\n　この手で引導を渡そう」",
     "ko": ".\n　죄에 녹슬어 가는 피 묻은 칼날이다.\n　더 이상 더럽혀질 바에야,\n　이 손으로 끝장을 내주겠다」"
    }
   ]
  },
  {
   "uid": "da0205:U00008",
   "speaker": "アナザーブラッド",
   "jp": "「独善的ね。嫌いよ、〈くざく〉九朔」",
   "cells": [
    {
     "sid": "da0205:T00028",
     "kind": "본문",
     "jp": "「独善的ね。嫌いよ、",
     "ko": "「독선적이네. 싫어, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00010",
     "kind": "루비 읽기",
     "jp": "くざく",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00029",
     "kind": "본문",
     "jp": "九朔",
     "ko": "쿠자쿠",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00030",
     "kind": "본문",
     "jp": "」",
     "ko": "」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0205:U00009",
   "speaker": "(지문)",
   "jp": "対峙する少年と少女。対峙するデモンベイン。",
   "cells": [
    {
     "sid": "da0205:T00031",
     "kind": "본문",
     "jp": "対峙する少年と少女。",
     "ko": "대치하는 소년과 소녀."
    },
    {
     "sid": "da0205:T00032",
     "kind": "본문",
     "jp": "対峙するデモンベイン。",
     "ko": "대치하는 데몬베인."
    }
   ]
  },
  {
   "uid": "da0205:U00010",
   "speaker": "(지문)",
   "jp": "両者のぶつかり合う闘気は、物理的な圧力すら持って大気を\n歪め始める。こいつらは敵同士なのだろうか。",
   "cells": [
    {
     "sid": "da0205:T00033",
     "kind": "본문",
     "jp": "両者のぶつかり合う闘気は、物理的な圧力すら持って大気を\n歪め始める。",
     "ko": "양자의 부딪치는 투기는 물리적인 압력마저 띠고 대기를 일그러뜨리기 시작한다."
    },
    {
     "sid": "da0205:T00034",
     "kind": "본문",
     "jp": "こいつらは敵同士なのだろうか。",
     "ko": "이 녀석들은 적대 관계인 걸까."
    }
   ]
  },
  {
   "uid": "da0205:U00011",
   "speaker": "アル",
   "jp": "「汝等はいったい……",
   "cells": [
    {
     "sid": "da0205:T00035",
     "kind": "본문",
     "jp": "「汝等はいったい……",
     "ko": "「그대들은 도대체……"
    }
   ]
  },
  {
   "uid": "da0205:U00012",
   "speaker": "(지문)",
   "jp": "ぐっ！ああああ！」",
   "cells": [
    {
     "sid": "da0205:T00036",
     "kind": "본문",
     "jp": "ぐっ！",
     "ko": "극!"
    },
    {
     "sid": "da0205:T00037",
     "kind": "본문",
     "jp": "ああああ！」",
     "ko": "아아아아!」"
    }
   ]
  },
  {
   "uid": "da0205:U00013",
   "speaker": "(지문)",
   "jp": "紅の少女が、装甲の上に倒れるアルを無理やり立たせ、背中から\n抱き締めた。",
   "cells": [
    {
     "sid": "da0205:T00038",
     "kind": "본문",
     "jp": "紅の少女が、装甲の上に倒れるアルを無理やり立たせ、背中から\n抱き締めた。",
     "ko": "붉은 소녀가, 장갑 위에 쓰러진 알을 억지로 일으켜 세워 등 뒤에서 껴안았다."
    }
   ]
  },
  {
   "uid": "da0205:U00014",
   "speaker": "九朔",
   "jp": "「その人に触れるな、\n　アナザーブラッド！」",
   "cells": [
    {
     "sid": "da0205:T00039",
     "kind": "본문",
     "jp": "「その人に触れるな、\n　アナザーブラッド！」",
     "ko": "「그 사람에게 손대지 마라,\n　어나더 블러드!」"
    }
   ]
  },
  {
   "uid": "da0205:U00015",
   "speaker": "(지문)",
   "jp": "……「その人」？アルのことを知っているのか？\n\n　怒りをあらわにする少年に対し、紅の少女はからかうような口調で\n答える。\n\n　アルの顔に、自らの顔を寄せ――",
   "cells": [
    {
     "sid": "da0205:T00040",
     "kind": "본문",
     "jp": "……「その人」？",
     "ko": "……「그 사람」?"
    },
    {
     "sid": "da0205:T00041",
     "kind": "본문",
     "jp": "アルのことを知っているのか？\n\n　怒りをあらわにする少年に対し、紅の少女はからかうような口調で\n答える。\n\n　アルの顔に、自らの顔を寄せ――",
     "ko": "알을 알고 있는 건가?\n\n　분노를 드러내는 소년에게, 붉은 소녀는 놀리는 듯한 어조로 답한다.\n\n　알의 얼굴에 자신의 얼굴을 가까이 대고――"
    }
   ]
  },
  {
   "uid": "da0205:U00016",
   "speaker": "アナザーブラッド",
   "jp": "「嫌よ。だって〈オリジナル〉お母様は、\n　私の血肉となるんだから」",
   "cells": [
    {
     "sid": "da0205:T00042",
     "kind": "본문",
     "jp": "「嫌よ。だって",
     "ko": "「싫어. 왜냐하면 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00011",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00043",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00044",
     "kind": "본문",
     "jp": "は、\n　私の血肉となるんだから」",
     "ko": "은,\n　나의 피와 살이 될 테니까」"
    }
   ]
  },
  {
   "uid": "da0205:U00017",
   "speaker": "アル",
   "jp": "「くっ…………あぁぁ……っ」",
   "cells": [
    {
     "sid": "da0205:T00045",
     "kind": "본문",
     "jp": "「くっ…………あぁぁ……っ」",
     "ko": "「큭………… 아아아……앗」"
    }
   ]
  },
  {
   "uid": "da0205:U00018",
   "speaker": "(지문)",
   "jp": "細い指で優しく頬を撫でる。だが、もう片方の手は胸元に伸び、膨らみかけの乳房を乱暴に〈まさぐ〉弄り、そして、",
   "cells": [
    {
     "sid": "da0205:T00046",
     "kind": "본문",
     "jp": "細い指で優しく頬を撫でる。",
     "ko": "가느다란 손가락으로 부드럽게 뺨을 어루만진다."
    },
    {
     "sid": "da0205:T00047",
     "kind": "본문",
     "jp": "だが、もう片方の手は胸元に伸び、膨らみかけの乳房を乱暴に",
     "ko": "하지만 다른 한쪽 손은 가슴팍으로 뻗어, 부풀어 오르기 시작한 가슴을 난폭하게 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00012",
     "kind": "루비 읽기",
     "jp": "まさぐ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00048",
     "kind": "본문",
     "jp": "弄",
     "ko": "더듬",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00049",
     "kind": "본문",
     "jp": "り、そして、",
     "ko": "으며, 그리고,"
    }
   ]
  },
  {
   "uid": "da0205:U00019",
   "speaker": "アル",
   "jp": "「――っっ！？\n　あああああああああああ！」",
   "cells": [
    {
     "sid": "da0205:T00050",
     "kind": "본문",
     "jp": "「――っっ！？\n　あああああああああああ！」",
     "ko": "「――으읍!?\n　아아아아아아아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0205:U00020",
   "speaker": "九郎",
   "jp": "「くっ！？　アルっっ！」\n\n　胸に突き立つ血の〈いろ〉彩の『鍵』を、さらに深くめり込ませた。身を仰け反らせ、髪を振り乱し、苦痛の悲鳴をあげるアル。",
   "cells": [
    {
     "sid": "da0205:T00051",
     "kind": "본문",
     "jp": "「くっ！？　アルっっ！」\n\n　胸に突き立つ血の",
     "ko": "「큭!?　알!」\n\n　가슴에 꽂힌 핏",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00013",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00052",
     "kind": "본문",
     "jp": "彩",
     "ko": "빛",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00053",
     "kind": "본문",
     "jp": "の『鍵』を、さらに深くめり込ませた。",
     "ko": " 『열쇠』를 한층 더 깊숙이 박아 넣었다."
    },
    {
     "sid": "da0205:T00054",
     "kind": "본문",
     "jp": "身を仰け反らせ、髪を振り乱し、苦痛の悲鳴をあげるアル。",
     "ko": "몸을 뒤로 젖히고 머리칼을 흩뜨리며 고통의 비명을 지르는 알."
    }
   ]
  },
  {
   "uid": "da0205:U00021",
   "speaker": "九朔",
   "jp": "「貴様ァァァァァァ！」",
   "cells": [
    {
     "sid": "da0205:T00055",
     "kind": "본문",
     "jp": "「貴様ァァァァァァ！」",
     "ko": "「네 이녀어어어어어언!」"
    }
   ]
  },
  {
   "uid": "da0205:U00022",
   "speaker": "アナザーブラッド",
   "jp": "「あはっ！　怒った怒った♪」",
   "cells": [
    {
     "sid": "da0205:T00056",
     "kind": "본문",
     "jp": "「あはっ！　怒った怒った♪」",
     "ko": "「아핫!　화났다 화났어♪」"
    }
   ]
  },
  {
   "uid": "da0205:U00023",
   "speaker": "(지문)",
   "jp": "〈わら〉嗤い、紅の少女はアルを抱えたまま後方へ跳躍。ふたりの姿はコクピットの内部へと消えた。ハッチが閉ざされる。",
   "cells": [
    {
     "sid": "da0205:R00014",
     "kind": "루비 읽기",
     "jp": "わら",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00057",
     "kind": "본문",
     "jp": "嗤",
     "ko": "비웃",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00058",
     "kind": "본문",
     "jp": "い、紅の少女はアルを抱えたまま後方へ跳躍。",
     "ko": "으며, 붉은 소녀는 알을 안은 채 후방으로 도약."
    },
    {
     "sid": "da0205:T00059",
     "kind": "본문",
     "jp": "ふたりの姿はコクピットの内部へと消えた。",
     "ko": "두 사람의 모습은 콕핏 내부로 사라졌다."
    },
    {
     "sid": "da0205:T00060",
     "kind": "본문",
     "jp": "ハッチが閉ざされる。",
     "ko": "해치가 닫힌다."
    }
   ]
  },
  {
   "uid": "da0205:U00024",
   "speaker": "九朔",
   "jp": "「おのれ！」",
   "cells": [
    {
     "sid": "da0205:T00061",
     "kind": "본문",
     "jp": "「おのれ！」",
     "ko": "「네 이년!」"
    }
   ]
  },
  {
   "uid": "da0205:U00025",
   "speaker": "(지문)",
   "jp": "少年もまた弾かれるように後方へ跳躍。コクピットの中へと飛び込んだ。ハッチが閉ざされる。",
   "cells": [
    {
     "sid": "da0205:T00062",
     "kind": "본문",
     "jp": "少年もまた弾かれるように後方へ跳躍。",
     "ko": "소년 또한 튕겨 나가듯 후방으로 도약."
    },
    {
     "sid": "da0205:T00063",
     "kind": "본문",
     "jp": "コクピットの中へと飛び込んだ。",
     "ko": "콕핏 안으로 뛰어들었다."
    },
    {
     "sid": "da0205:T00064",
     "kind": "본문",
     "jp": "ハッチが閉ざされる。",
     "ko": "해치가 닫힌다."
    }
   ]
  },
  {
   "uid": "da0205:U00026",
   "speaker": "(지문)",
   "jp": "２体のデモンベインが同時に動き出す。",
   "cells": [
    {
     "sid": "da0205:T00065",
     "kind": "본문",
     "jp": "２体のデモンベインが同時に動き出す。",
     "ko": "2대의 데몬베인이 동시에 움직이기 시작한다."
    }
   ]
  },
  {
   "uid": "da0205:U00027",
   "speaker": "(지문)",
   "jp": "紅の少女が乗る、血染めのデモンベイン。拳を固め、身構える。",
   "cells": [
    {
     "sid": "da0205:T00066",
     "kind": "본문",
     "jp": "紅の少女が乗る、血染めのデモンベイン。",
     "ko": "붉은 소녀가 탄, 피로 물든 데몬베인."
    },
    {
     "sid": "da0205:T00067",
     "kind": "본문",
     "jp": "拳を固め、身構える。",
     "ko": "주먹을 굳게 쥐고 자세를 잡는다."
    }
   ]
  },
  {
   "uid": "da0205:U00028",
   "speaker": "(지문)",
   "jp": "全身を高速で賭ける術式。機体が赤熱し、紅い機体をさらに紅く輝かせる。",
   "cells": [
    {
     "sid": "da0205:T00068",
     "kind": "본문",
     "jp": "全身を高速で賭ける術式。",
     "ko": "전신을 고속으로 달리는 술식."
    },
    {
     "sid": "da0205:T00069",
     "kind": "본문",
     "jp": "機体が赤熱し、紅い機体をさらに紅く輝かせる。",
     "ko": "기체가 적열하며 붉은 기체를 한층 더 붉게 빛낸다."
    }
   ]
  },
  {
   "uid": "da0205:U00029",
   "speaker": "(지문)",
   "jp": "装甲を濡らす血が蒸発し、血煙となって噴き出す。〈も〉焔える血風を纏う、〈デモンベイン・ブラッド〉鮮血の機神。",
   "cells": [
    {
     "sid": "da0205:T00070",
     "kind": "본문",
     "jp": "装甲を濡らす血が蒸発し、血煙となって噴き出す。",
     "ko": "장갑을 적신 피가 증발하여 피안개가 되어 뿜어져 나온다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00015",
     "kind": "루비 읽기",
     "jp": "も",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00071",
     "kind": "본문",
     "jp": "焔",
     "ko": "타오르",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00072",
     "kind": "본문",
     "jp": "える血風を纏う、",
     "ko": "는 피바람을 두른, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00016",
     "kind": "루비 읽기",
     "jp": "デモンベイン・ブラッド",
     "ko": "데몬베인 블러드",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00073",
     "kind": "본문",
     "jp": "鮮血の機神",
     "ko": "선혈의 기신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00074",
     "kind": "본문",
     "jp": "。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0205:U00030",
   "speaker": "(지문)",
   "jp": "それに対するは少年が乗る、〈タイプ〉型の異なるデモンベイン。両腕を交差させ、前方に突き出す。",
   "cells": [
    {
     "sid": "da0205:T00075",
     "kind": "본문",
     "jp": "それに対するは少年が乗る、",
     "ko": "그에 맞서는 것은 소년이 탄, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00017",
     "kind": "루비 읽기",
     "jp": "タイプ",
     "ko": "타입",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00076",
     "kind": "본문",
     "jp": "型",
     "ko": "형",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00077",
     "kind": "본문",
     "jp": "の異なるデモンベイン。",
     "ko": "이 다른 데몬베인."
    },
    {
     "sid": "da0205:T00078",
     "kind": "본문",
     "jp": "両腕を交差させ、前方に突き出す。",
     "ko": "양팔을 교차시켜 전방으로 내민다."
    }
   ]
  },
  {
   "uid": "da0205:U00031",
   "speaker": "九朔",
   "jp": "「――吹き荒め」",
   "cells": [
    {
     "sid": "da0205:T00079",
     "kind": "본문",
     "jp": "「――吹き荒め」",
     "ko": "「――휘몰아쳐라」"
    }
   ]
  },
  {
   "uid": "da0205:U00032",
   "speaker": "(지문)",
   "jp": "強大な魔力の気配。デモンベインの両掌から魔術文字が溢れ出し、文字列を造り、\n文字列は荒れ狂う竜巻となって宙に留まる。",
   "cells": [
    {
     "sid": "da0205:T00080",
     "kind": "본문",
     "jp": "強大な魔力の気配。",
     "ko": "강대한 마력의 기척."
    },
    {
     "sid": "da0205:T00081",
     "kind": "본문",
     "jp": "デモンベインの両掌から魔術文字が溢れ出し、文字列を造り、\n文字列は荒れ狂う竜巻となって宙に留まる。",
     "ko": "데몬베인의 양 손바닥에서 마술문자가 흘러넘쳐 문자열을 만들고, 문자열은 사납게 날뛰는 회오리가 되어 허공에 머문다."
    }
   ]
  },
  {
   "uid": "da0205:U00033",
   "speaker": "(지문)",
   "jp": "術式の嵐は次第に圧縮され、凝縮され、実体を結ぶ。",
   "cells": [
    {
     "sid": "da0205:T00082",
     "kind": "본문",
     "jp": "術式の嵐は次第に圧縮され、凝縮され、実体を結ぶ。",
     "ko": "술식의 폭풍은 서서히 압축되고, 응축되어, 실체를 맺는다."
    }
   ]
  },
  {
   "uid": "da0205:U00034",
   "speaker": "九朔",
   "jp": "「――〈あらわ〉顕れ、〈い〉出でよ」",
   "cells": [
    {
     "sid": "da0205:T00083",
     "kind": "본문",
     "jp": "「――",
     "ko": "「――",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0205:R00018",
     "kind": "루비 읽기",
     "jp": "あらわ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00084",
     "kind": "본문",
     "jp": "顕",
     "ko": "모습을 드러내라",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00085",
     "kind": "본문",
     "jp": "れ、",
     "ko": ", ",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0205:R00019",
     "kind": "루비 읽기",
     "jp": "い",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00086",
     "kind": "본문",
     "jp": "出",
     "ko": "나오",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00087",
     "kind": "본문",
     "jp": "でよ」",
     "ko": "너라」"
    }
   ]
  },
  {
   "uid": "da0205:U00035",
   "speaker": "(지문)",
   "jp": "砕け散る呪力の竜巻。巨大な物質が〈マテリアライズ〉顕現化した。それは金属の光沢を帯びる、一対の魔剣――",
   "cells": [
    {
     "sid": "da0205:T00088",
     "kind": "본문",
     "jp": "砕け散る呪力の竜巻。",
     "ko": "부서져 흩어지는 주력의 회오리."
    },
    {
     "sid": "da0205:T00089",
     "kind": "본문",
     "jp": "巨大な物質が",
     "ko": "거대한 물질이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00020",
     "kind": "루비 읽기",
     "jp": "マテリアライズ",
     "ko": "머티리얼라이즈",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00090",
     "kind": "본문",
     "jp": "顕現化",
     "ko": "현현화",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00091",
     "kind": "본문",
     "jp": "した。",
     "ko": "했다."
    },
    {
     "sid": "da0205:T00092",
     "kind": "본문",
     "jp": "それは金属の光沢を帯びる、一対の魔剣――",
     "ko": "그것은 금속의 광택을 띤 한 쌍의 마검――"
    }
   ]
  },
  {
   "uid": "da0205:U00036",
   "speaker": "九郎",
   "jp": "「ロイガーとツァール！？」\n\n　ツァール。ロイガー。旧支配者の二柱。『双子の卑猥なるもの』の名を冠する、兄弟神である。\n\n　あの一対の小剣は、俺の持つ二挺の魔銃クトゥグアとイタクァ同様、神の魔力を宿す呪法兵装なのだ。顕現した魔剣を両掌に取り、身構える。二刀流。〈デモンベイン・トゥーソード〉二刀流の機神だ。",
   "cells": [
    {
     "sid": "da0205:T00093",
     "kind": "본문",
     "jp": "「ロイガーとツァール！？」\n\n　ツァール。",
     "ko": "「로이거와 차르!?」\n\n　차르."
    },
    {
     "sid": "da0205:T00094",
     "kind": "본문",
     "jp": "ロイガー。",
     "ko": " 로이거."
    },
    {
     "sid": "da0205:T00095",
     "kind": "본문",
     "jp": "旧支配者の二柱。",
     "ko": "옛 지배자의 두 신."
    },
    {
     "sid": "da0205:T00096",
     "kind": "본문",
     "jp": "『双子の卑猥なるもの』の名を冠する、兄弟神である。\n\n　あの一対の小剣は、俺の持つ二挺の魔銃クトゥグアとイタクァ同様、神の魔力を宿す呪法兵装なのだ。",
     "ko": "『쌍둥이 외설스러운 자』라는 이름을 단 형제신이다.\n\n　저 한 쌍의 소검은 내가 가진 두 자루의 마총 크투가와 이타콰와 마찬가지로, 신의 마력을 품은 주법병장이다."
    },
    {
     "sid": "da0205:T00097",
     "kind": "본문",
     "jp": "顕現した魔剣を両掌に取り、身構える。",
     "ko": "현현한 마검을 양 손바닥에 쥐고 자세를 잡는다."
    },
    {
     "sid": "da0205:T00098",
     "kind": "본문",
     "jp": "二刀流。",
     "ko": "이도류.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0205:R00021",
     "kind": "루비 읽기",
     "jp": "デモンベイン・トゥーソード",
     "ko": "데몬베인 투 소드다",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00099",
     "kind": "본문",
     "jp": "二刀流の機神",
     "ko": "이도류의 기신이다",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00100",
     "kind": "본문",
     "jp": "だ。",
     "ko": ".",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0205:U00037",
   "speaker": "九朔",
   "jp": "「〈つかまつ〉仕る！」",
   "cells": [
    {
     "sid": "da0205:T00101",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0205:R00022",
     "kind": "루비 읽기",
     "jp": "つかまつ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0205:T00102",
     "kind": "본문",
     "jp": "仕",
     "ko": "간",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0205:T00103",
     "kind": "본문",
     "jp": "る！」",
     "ko": "다!」"
    }
   ]
  },
  {
   "uid": "da0205:U00038",
   "speaker": "アナザーブラッド",
   "jp": "「遊んであげるわ、ドンキホーテ！」",
   "cells": [
    {
     "sid": "da0205:T00104",
     "kind": "본문",
     "jp": "「遊んであげるわ、ドンキホーテ！」",
     "ko": "「놀아 줄게, 돈키호테!」"
    }
   ]
  },
