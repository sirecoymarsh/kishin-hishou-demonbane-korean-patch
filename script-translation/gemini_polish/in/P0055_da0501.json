{
 "packet": "P0055_da0501",
 "units": [
  {
   "uid": "da0501:U00001",
   "speaker": "クラウディウス",
   "jp": "「そんな……ボクが……\n　このボクが……」",
   "cells": [
    {
     "sid": "da0501:T00001",
     "kind": "본문",
     "jp": "「そんな……ボクが……\n　このボクが……」",
     "ko": "「이럴 수가…… 내가……\n　이 내가……」"
    }
   ]
  },
  {
   "uid": "da0501:U00002",
   "speaker": "ハヅキ",
   "jp": "「駄目だね。『不可』だね。落第だね」",
   "cells": [
    {
     "sid": "da0501:T00002",
     "kind": "본문",
     "jp": "「駄目だね。『不可』だね。落第だね」",
     "ko": "「안 되겠네. 『불가』네. 낙제네」"
    }
   ]
  },
  {
   "uid": "da0501:U00003",
   "speaker": "シュリュズベリイ",
   "jp": "「ああ、残念ながら単位はやれんな」",
   "cells": [
    {
     "sid": "da0501:T00003",
     "kind": "본문",
     "jp": "「ああ、残念ながら単位はやれんな」",
     "ko": "「그래, 유감이지만 학점은 줄 수 없겠군」"
    }
   ]
  },
  {
   "uid": "da0501:U00004",
   "speaker": "クラウディウス",
   "jp": "「畜生……畜生……\n　チクショオオオォォォォォ！」",
   "cells": [
    {
     "sid": "da0501:T00004",
     "kind": "본문",
     "jp": "「畜生……畜生……\n　チクショオオオォォォォォ！」",
     "ko": "「젠장…… 젠장……\n　젠자아아아아아앙!」"
    }
   ]
  },
  {
   "uid": "da0501:U00005",
   "speaker": "(지문)",
   "jp": "アンブロシウスに撃墜されたロードビヤーキーは、空中で爆砕した。",
   "cells": [
    {
     "sid": "da0501:T00005",
     "kind": "본문",
     "jp": "アンブロシウスに撃墜されたロードビヤーキーは、空中で爆砕した。",
     "ko": "암브로시우스에게 격추당한 로드 비야키는 공중에서 폭사했다."
    }
   ]
  },
  {
   "uid": "da0501:U00006",
   "speaker": "(지문)",
   "jp": "爆発は瞬く間に血の〈いろ〉彩に染まる。四散する残骸も、爆炎も、全ては血風と化して大気に消える。\n\n　空に血の大輪が咲く。",
   "cells": [
    {
     "sid": "da0501:T00006",
     "kind": "본문",
     "jp": "爆発は瞬く間に血の",
     "ko": "폭발은 순식간에 핏빛 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00001",
     "kind": "루비 읽기",
     "jp": "いろ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00007",
     "kind": "본문",
     "jp": "彩",
     "ko": "색채",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00008",
     "kind": "본문",
     "jp": "に染まる。",
     "ko": "로 물든다."
    },
    {
     "sid": "da0501:T00009",
     "kind": "본문",
     "jp": "四散する残骸も、爆炎も、全ては血風と化して大気に消える。\n\n　空に血の大輪が咲く。",
     "ko": "사방으로 흩어지는 잔해도, 폭염도, 모든 것이 혈풍으로 변해 대기 속으로 사라진다.\n\n　하늘에 피의 큰 꽃이 피어난다."
    }
   ]
  },
  {
   "uid": "da0501:U00007",
   "speaker": "(지문)",
   "jp": "後には何も残らない。遺さない。夢はただ夢と散り逝くだけだ。",
   "cells": [
    {
     "sid": "da0501:T00010",
     "kind": "본문",
     "jp": "後には何も残らない。遺さない。",
     "ko": "뒤에는 아무것도 남지 않는다. 남기지 않는다."
    },
    {
     "sid": "da0501:T00011",
     "kind": "본문",
     "jp": "夢はただ夢と散り逝くだけだ。",
     "ko": "꿈은 그저 꿈으로 흩어져 사라질 뿐이다."
    }
   ]
  },
  {
   "uid": "da0501:U00008",
   "speaker": "シュリュズベリイ",
   "jp": "「とりあえずは片が付いたな」",
   "cells": [
    {
     "sid": "da0501:T00012",
     "kind": "본문",
     "jp": "「とりあえずは片が付いたな」",
     "ko": "「우선은 정리가 되었군」"
    }
   ]
  },
  {
   "uid": "da0501:U00009",
   "speaker": "(지문)",
   "jp": "シュリュズベリイ〈センセ〉先生の機体が降りてくる。〈デウス・マキナ〉鬼械神アンブロシウス……か。確かにロードビヤーキーよりも複雑な構造をしているようだ。\n\n　アンブロシウスは、デモンベイン・トゥーソードの隣に着地した。",
   "cells": [
    {
     "sid": "da0501:T00013",
     "kind": "본문",
     "jp": "シュリュズベリイ",
     "ko": "슈루즈베리 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00002",
     "kind": "루비 읽기",
     "jp": "センセ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00014",
     "kind": "본문",
     "jp": "先生",
     "ko": "선생",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00015",
     "kind": "본문",
     "jp": "の機体が降りてくる。",
     "ko": "의 기체가 내려온다.",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00003",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00016",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00017",
     "kind": "본문",
     "jp": "アンブロシウス……か。",
     "ko": " 암브로시우스……인가."
    },
    {
     "sid": "da0501:T00018",
     "kind": "본문",
     "jp": "確かにロードビヤーキーよりも複雑な構造をしているようだ。\n\n　アンブロシウスは、デモンベイン・トゥーソードの隣に着地した。",
     "ko": "확실히 로드 비야키보다도 복잡한 구조를 하고 있는 모양이다.\n\n　암브로시우스는 데몬베인 투 소드의 옆에 착지했다."
    }
   ]
  },
  {
   "uid": "da0501:U00010",
   "speaker": "シュリュズベリイ",
   "jp": "「君もご苦労だった」",
   "cells": [
    {
     "sid": "da0501:T00019",
     "kind": "본문",
     "jp": "「君もご苦労だった」",
     "ko": "「자네도 수고했네」"
    }
   ]
  },
  {
   "uid": "da0501:U00011",
   "speaker": "九朔",
   "jp": "「…………」",
   "cells": [
    {
     "sid": "da0501:T00020",
     "kind": "본문",
     "jp": "「…………」",
     "ko": "「…………」",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0501:U00012",
   "speaker": "(지문)",
   "jp": "〈デモンベイン〉Ｄトゥーソードは、先程から微動だにしない。トラブルでもあったのだろうか。",
   "cells": [
    {
     "sid": "da0501:R00004",
     "kind": "루비 읽기",
     "jp": "デモンベイン",
     "ko": "데몬베인",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00021",
     "kind": "본문",
     "jp": "Ｄ",
     "ko": "D",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0501:T00022",
     "kind": "본문",
     "jp": "トゥーソードは、先程から微動だにしない。",
     "ko": " 투 소드는 아까부터 미동조차 하지 않는다."
    },
    {
     "sid": "da0501:T00023",
     "kind": "본문",
     "jp": "トラブルでもあったのだろうか。",
     "ko": "트러블이라도 있었던 걸까."
    }
   ]
  },
  {
   "uid": "da0501:U00013",
   "speaker": "シュリュズベリイ",
   "jp": "「……どうした？」",
   "cells": [
    {
     "sid": "da0501:T00024",
     "kind": "본문",
     "jp": "「……どうした？」",
     "ko": "「……왜 그러나?」"
    }
   ]
  },
  {
   "uid": "da0501:U00014",
   "speaker": "九朔",
   "jp": "「――来る」",
   "cells": [
    {
     "sid": "da0501:T00025",
     "kind": "본문",
     "jp": "「――来る」",
     "ko": "「――온다」"
    }
   ]
  },
  {
   "uid": "da0501:U00015",
   "speaker": "シュリュズベリイ",
   "jp": "「……何？」",
   "cells": [
    {
     "sid": "da0501:T00026",
     "kind": "본문",
     "jp": "「……何？」",
     "ko": "「……뭐라?」"
    }
   ]
  },
  {
   "uid": "da0501:U00016",
   "speaker": "(지문)",
   "jp": "アーカムシティが揺れていた。まるでこれから顕れる強大な何かに、恐れ〈おのの〉戦くように。",
   "cells": [
    {
     "sid": "da0501:T00027",
     "kind": "본문",
     "jp": "アーカムシティが揺れていた。",
     "ko": "아컴 시티가 흔들리고 있었다."
    },
    {
     "sid": "da0501:T00028",
     "kind": "본문",
     "jp": "まるでこれから顕れる強大な何かに、恐れ",
     "ko": "마치 이제부터 나타날 강대한 무언가에 두려워하며 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00005",
     "kind": "루비 읽기",
     "jp": "おのの",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00029",
     "kind": "본문",
     "jp": "戦",
     "ko": "전율하",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00030",
     "kind": "본문",
     "jp": "くように。",
     "ko": "듯이."
    }
   ]
  },
  {
   "uid": "da0501:U00017",
   "speaker": "九郎",
   "jp": "「……お次の出し物は何だ、コンチクショウ！」",
   "cells": [
    {
     "sid": "da0501:T00031",
     "kind": "본문",
     "jp": "「……お次の出し物は何だ、コンチクショウ！」",
     "ko": "「……다음 여흥거리는 뭐냐, 제기랄!」"
    }
   ]
  },
  {
   "uid": "da0501:U00018",
   "speaker": "アル",
   "jp": "「この……気配は！」",
   "cells": [
    {
     "sid": "da0501:T00032",
     "kind": "본문",
     "jp": "「この……気配は！」",
     "ko": "「이…… 기척은!」"
    }
   ]
  },
  {
   "uid": "da0501:U00019",
   "speaker": "九郎",
   "jp": "「知ってるのか！？」",
   "cells": [
    {
     "sid": "da0501:T00033",
     "kind": "본문",
     "jp": "「知ってるのか！？」",
     "ko": "「아는 거냐!?」"
    }
   ]
  },
  {
   "uid": "da0501:U00020",
   "speaker": "アル",
   "jp": "「〈まず〉不味い！　逃げろ！」",
   "cells": [
    {
     "sid": "da0501:T00034",
     "kind": "본문",
     "jp": "「",
     "ko": "「",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0501:R00006",
     "kind": "루비 읽기",
     "jp": "まず",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00035",
     "kind": "본문",
     "jp": "不味",
     "ko": "위험",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00036",
     "kind": "본문",
     "jp": "い！　逃げろ！」",
     "ko": "하다!　도망쳐라!」"
    }
   ]
  },
  {
   "uid": "da0501:U00021",
   "speaker": "九郎",
   "jp": "「――――！」\n\n　アルが叫ぶのと同時、凄まじい危機感が俺の心臓を圧迫した。考えるよりも早く、マギウス・ウィングで全身を包み込み、その上から幾重にも〈ぼうぎょ〉防禦結界を張る。",
   "cells": [
    {
     "sid": "da0501:T00037",
     "kind": "본문",
     "jp": "「――――！」\n\n　アルが叫ぶのと同時、凄まじい危機感が俺の心臓を圧迫した。",
     "ko": "「――――!」\n\n　알이 외치자, 무시무시한 위기감이 내 심장을 압박했다."
    },
    {
     "sid": "da0501:T00038",
     "kind": "본문",
     "jp": "考えるよりも早く、マギウス・ウィングで全身を包み込み、その上から幾重にも",
     "ko": "생각하기보다도 빠르게 마기우스 윙으로 전신을 감싸고, 그 위에서 겹겹이 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00007",
     "kind": "루비 읽기",
     "jp": "ぼうぎょ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00039",
     "kind": "본문",
     "jp": "防禦",
     "ko": "방어",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00040",
     "kind": "본문",
     "jp": "結界を張る。",
     "ko": " 결계를 친다."
    }
   ]
  },
  {
   "uid": "da0501:U00022",
   "speaker": "九郎",
   "jp": "「ぐあああああ！」",
   "cells": [
    {
     "sid": "da0501:T00041",
     "kind": "본문",
     "jp": "「ぐあああああ！」",
     "ko": "「크아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0501:U00023",
   "speaker": "(지문)",
   "jp": "高濃度の瘴気が激震を伴って、ここら一帯を襲った。周囲の建造物が腐れ、崩れ落ちる。こいつは……！",
   "cells": [
    {
     "sid": "da0501:T00042",
     "kind": "본문",
     "jp": "高濃度の瘴気が激震を伴って、ここら一帯を襲った。",
     "ko": "고농도의 독기가 격진을 동반하며 이 일대를 덮쳤다."
    },
    {
     "sid": "da0501:T00043",
     "kind": "본문",
     "jp": "周囲の建造物が腐れ、崩れ落ちる。",
     "ko": "주위의 건조물이 썩어 문드러지며 무너져 내린다."
    },
    {
     "sid": "da0501:T00044",
     "kind": "본문",
     "jp": "こいつは……！",
     "ko": "이 녀석은……!"
    }
   ]
  },
  {
   "uid": "da0501:U00024",
   "speaker": "(지문)",
   "jp": "俺たちの頭上、天が砕けた。空間に穿たれた穴から、赤黒いタールの塊がボトボトと零れ落ちる。穢れた〈タール〉粘液は街並みを呑み込みながら、こちらに向かって押し\n寄せてくる。",
   "cells": [
    {
     "sid": "da0501:T00045",
     "kind": "본문",
     "jp": "俺たちの頭上、天が砕けた。",
     "ko": "우리의 머리 위, 하늘이 부서졌다."
    },
    {
     "sid": "da0501:T00046",
     "kind": "본문",
     "jp": "空間に穿たれた穴から、赤黒いタールの塊がボトボトと零れ落ちる。",
     "ko": "공간에 뚫린 구멍에서 검붉은 타르 덩어리가 뚝뚝 흘러내린다."
    },
    {
     "sid": "da0501:T00047",
     "kind": "본문",
     "jp": "穢れた",
     "ko": "부정한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00008",
     "kind": "루비 읽기",
     "jp": "タール",
     "ko": "타르는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00048",
     "kind": "본문",
     "jp": "粘液",
     "ko": "점액은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00049",
     "kind": "본문",
     "jp": "は街並みを呑み込みながら、こちらに向かって押し\n寄せてくる。",
     "ko": " 거리를 집어삼키면서 이쪽을 향해 밀려\n들어온다."
    }
   ]
  },
  {
   "uid": "da0501:U00025",
   "speaker": "ハヅキ",
   "jp": "「うわわわっ」",
   "cells": [
    {
     "sid": "da0501:T00050",
     "kind": "본문",
     "jp": "「うわわわっ」",
     "ko": "「우와와왓」"
    }
   ]
  },
  {
   "uid": "da0501:U00026",
   "speaker": "九朔",
   "jp": "「シャンタク！」",
   "cells": [
    {
     "sid": "da0501:T00051",
     "kind": "본문",
     "jp": "「シャンタク！」",
     "ko": "「샨타크!」"
    }
   ]
  },
  {
   "uid": "da0501:U00027",
   "speaker": "(지문)",
   "jp": "２体の〈デウス・マキナ〉鬼械神は飛翔し、雪崩れ込む粘液から逃れる。だが、しかし。",
   "cells": [
    {
     "sid": "da0501:T00052",
     "kind": "본문",
     "jp": "２体の",
     "ko": "2대의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00009",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나는",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00053",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신은",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00054",
     "kind": "본문",
     "jp": "は飛翔し、雪崩れ込む粘液から逃れる。",
     "ko": " 비상하여 쏟아져 들어오는 점액에서 벗어난다."
    },
    {
     "sid": "da0501:T00055",
     "kind": "본문",
     "jp": "だが、しかし。",
     "ko": "하지만, 그러나."
    }
   ]
  },
  {
   "uid": "da0501:U00028",
   "speaker": "シュリュズベリイ",
   "jp": "「ぬぅぅっ！？」",
   "cells": [
    {
     "sid": "da0501:T00056",
     "kind": "본문",
     "jp": "「ぬぅぅっ！？」",
     "ko": "「크으으윽!?」"
    }
   ]
  },
  {
   "uid": "da0501:U00029",
   "speaker": "九朔",
   "jp": "「しまった！」",
   "cells": [
    {
     "sid": "da0501:T00057",
     "kind": "본문",
     "jp": "「しまった！」",
     "ko": "「아뿔싸!」"
    }
   ]
  },
  {
   "uid": "da0501:U00030",
   "speaker": "(지문)",
   "jp": "不浄の海から無数の赤黒い触手が伸びて、〈デモンベイン〉Ｄトゥーソードを、\nアンブロシウスを拘束した。\n\n　２体とも逃れようと足掻くが、触手による拘束は固く振り解けない。この触手は、〈デウス・マキナ〉鬼械神をも上回るパワーを持っているのだ！",
   "cells": [
    {
     "sid": "da0501:T00058",
     "kind": "본문",
     "jp": "不浄の海から無数の赤黒い触手が伸びて、",
     "ko": "부정의 바다에서 무수한 검붉은 촉수가 뻗어 나와 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00010",
     "kind": "루비 읽기",
     "jp": "デモンベイン",
     "ko": "데몬베인",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00059",
     "kind": "본문",
     "jp": "Ｄ",
     "ko": "D",
     "lock": "한글 없는 칸"
    },
    {
     "sid": "da0501:T00060",
     "kind": "본문",
     "jp": "トゥーソードを、\nアンブロシウスを拘束した。\n\n　２体とも逃れようと足掻くが、触手による拘束は固く振り解けない。",
     "ko": " 투 소드를,\n암브로시우스를 구속했다.\n\n　둘 다 벗어나려고 발버둥 치지만, 촉수의 구속은 단단하여 떨쳐낼 수 없다."
    },
    {
     "sid": "da0501:T00061",
     "kind": "본문",
     "jp": "この触手は、",
     "ko": "이 촉수는 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00011",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00062",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00063",
     "kind": "본문",
     "jp": "をも上回るパワーを持っているのだ！",
     "ko": "마저도 웃도는 파워를 지니고 있다!"
    }
   ]
  },
  {
   "uid": "da0501:U00031",
   "speaker": "ハヅキ",
   "jp": "「わわわ、マズイ。\n　マズイよ、ダディ！」",
   "cells": [
    {
     "sid": "da0501:T00064",
     "kind": "본문",
     "jp": "「わわわ、マズイ。\n　マズイよ、ダディ！」",
     "ko": "「와와와, 위험해.\n　위험해, 대디!」"
    }
   ]
  },
  {
   "uid": "da0501:U00032",
   "speaker": "九朔",
   "jp": "「おのれ！」",
   "cells": [
    {
     "sid": "da0501:T00065",
     "kind": "본문",
     "jp": "「おのれ！」",
     "ko": "「네 이놈!」"
    }
   ]
  },
  {
   "uid": "da0501:U00033",
   "speaker": "アナザーブラッド",
   "jp": "「ははは……ははははは……\n　あははははははははははは！」",
   "cells": [
    {
     "sid": "da0501:T00066",
     "kind": "본문",
     "jp": "「ははは……ははははは……\n　あははははははははははは！」",
     "ko": "「하하하…… 하하하하하……\n　아하하하하하하하하하하하!」"
    }
   ]
  },
  {
   "uid": "da0501:U00034",
   "speaker": "九郎",
   "jp": "「この声！」",
   "cells": [
    {
     "sid": "da0501:T00067",
     "kind": "본문",
     "jp": "「この声！」",
     "ko": "「이 목소리!」"
    }
   ]
  },
  {
   "uid": "da0501:U00035",
   "speaker": "アル",
   "jp": "「あの……女か……っ！」",
   "cells": [
    {
     "sid": "da0501:T00068",
     "kind": "본문",
     "jp": "「あの……女か……っ！」",
     "ko": "「그…… 여자인가……!」"
    }
   ]
  },
  {
   "uid": "da0501:U00036",
   "speaker": "九朔",
   "jp": "「アナザーブラッド！」",
   "cells": [
    {
     "sid": "da0501:T00069",
     "kind": "본문",
     "jp": "「アナザーブラッド！」",
     "ko": "「어나더 블러드!」"
    }
   ]
  },
  {
   "uid": "da0501:U00037",
   "speaker": "(지문)",
   "jp": "天に開いた時空の穴から、酷い悪臭が流れ込んできた。２体の〈デウス・マキナ〉鬼械神を捕らえたものとはまた別の触手が『向こう側』から\nあふれ出る。\n\n　そしてあの紅の少女もまた、共に姿を現した。血の霧で編んだ蝶の〈はね〉翅を羽ばたかせ。",
   "cells": [
    {
     "sid": "da0501:T00070",
     "kind": "본문",
     "jp": "天に開いた時空の穴から、酷い悪臭が流れ込んできた。",
     "ko": "하늘에 열린 시공의 구멍에서 끔찍한 악취가 흘러들어왔다."
    },
    {
     "sid": "da0501:T00071",
     "kind": "본문",
     "jp": "２体の",
     "ko": "2대의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00012",
     "kind": "루비 읽기",
     "jp": "デウス・マキナ",
     "ko": "데우스 마키나를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00072",
     "kind": "본문",
     "jp": "鬼械神",
     "ko": "귀계신을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00073",
     "kind": "본문",
     "jp": "を捕らえたものとはまた別の触手が『向こう側』から\nあふれ出る。\n\n　そしてあの紅の少女もまた、共に姿を現した。",
     "ko": " 붙잡은 것과는 또 다른 촉수가 『저편』에서\n흘러넘친다.\n\n　그리고 그 붉은 소녀 또한 함께 모습을 드러냈다."
    },
    {
     "sid": "da0501:T00074",
     "kind": "본문",
     "jp": "血の霧で編んだ蝶の",
     "ko": "피의 안개로 엮은 나비의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00013",
     "kind": "루비 읽기",
     "jp": "はね",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00075",
     "kind": "본문",
     "jp": "翅",
     "ko": "날개",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00076",
     "kind": "본문",
     "jp": "を羽ばたかせ。",
     "ko": "를 퍼덕이며."
    }
   ]
  },
  {
   "uid": "da0501:U00038",
   "speaker": "アナザーブラッド",
   "jp": "「頑張るのね、みんな。あんまり頑張るものだから、私もちょっと本気を出さなきゃいけなくなったわ」",
   "cells": [
    {
     "sid": "da0501:T00077",
     "kind": "본문",
     "jp": "「頑張るのね、みんな。あんまり頑張るものだから、私もちょっと本気を出さなきゃいけなくなったわ」",
     "ko": "「열심히 하네, 다들. 너무 열심히들 하니까 나도 조금은 진심을 내야만 하게 됐잖아」"
    }
   ]
  },
  {
   "uid": "da0501:U00039",
   "speaker": "九朔",
   "jp": "「貴様ァァァァァァ！」",
   "cells": [
    {
     "sid": "da0501:T00078",
     "kind": "본문",
     "jp": "「貴様ァァァァァァ！」",
     "ko": "「네 이노오오오오오옴!」"
    }
   ]
  },
  {
   "uid": "da0501:U00040",
   "speaker": "(지문)",
   "jp": "1",
   "cells": [
    {
     "sid": "da0501:T00079",
     "kind": "본문",
     "jp": "1",
     "ko": "1",
     "lock": "한글 없는 칸"
    }
   ]
  },
  {
   "uid": "da0501:U00041",
   "speaker": "(지문)",
   "jp": "シャンタクが爆風を噴き出し、出力を上げる。だがそれでも、触手を振り解けない。",
   "cells": [
    {
     "sid": "da0501:T00080",
     "kind": "본문",
     "jp": "シャンタクが爆風を噴き出し、出力を上げる。",
     "ko": "샨타크가 폭풍을 뿜어내며 출력을 올린다."
    },
    {
     "sid": "da0501:T00081",
     "kind": "본문",
     "jp": "だがそれでも、触手を振り解けない。",
     "ko": "하지만 그런데도 촉수를 떨쳐낼 수 없다."
    }
   ]
  },
  {
   "uid": "da0501:U00042",
   "speaker": "アナザーブラッド",
   "jp": "「そいつは『ズアウィア』――アマゾンの『神の吼える森』と呼ばれる秘境に棲む、〈おぞ〉悍ましくも退化した獣人達に信仰されていた存在」",
   "cells": [
    {
     "sid": "da0501:T00082",
     "kind": "본문",
     "jp": "「そいつは『ズアウィア』――アマゾンの『神の吼える森』と呼ばれる秘境に棲む、",
     "ko": "「그 녀석은 『즈아위아』――아마존의 『신이 포효하는 숲』이라 불리는 비경에 사는, ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00014",
     "kind": "루비 읽기",
     "jp": "おぞ",
     "ko": "",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00083",
     "kind": "본문",
     "jp": "悍",
     "ko": "끔찍",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00084",
     "kind": "본문",
     "jp": "ましくも退化した獣人達に信仰されていた存在」",
     "ko": "하게도 퇴화한 수인들에게 숭배받던 존재」"
    }
   ]
  },
  {
   "uid": "da0501:U00043",
   "speaker": "アナザーブラッド",
   "jp": "「そう……こんなのでも一応、\n　立派な神様よ？」",
   "cells": [
    {
     "sid": "da0501:T00085",
     "kind": "본문",
     "jp": "「そう……こんなのでも一応、\n　立派な神様よ？」",
     "ko": "「그래…… 이래 봬도 일단은,\n　훌륭한 신님이란다?」"
    }
   ]
  },
  {
   "uid": "da0501:U00044",
   "speaker": "アル",
   "jp": "「神……神だと？　確かにな……\n　だが、異界の神だ。邪神だ！」",
   "cells": [
    {
     "sid": "da0501:T00086",
     "kind": "본문",
     "jp": "「神……神だと？　確かにな……\n　だが、異界の神だ。邪神だ！」",
     "ko": "「신…… 신이라고?　확실히 그렇군……\n　하지만 이계의 신이다. 사신이다!」"
    }
   ]
  },
  {
   "uid": "da0501:U00045",
   "speaker": "アナザーブラッド",
   "jp": "「その通り。〈オリジナル〉お母様、\n　貴女がよく識っているものよ」",
   "cells": [
    {
     "sid": "da0501:T00087",
     "kind": "본문",
     "jp": "「その通り。",
     "ko": "「그 말씀대로예요. ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00015",
     "kind": "루비 읽기",
     "jp": "オリジナル",
     "ko": "오리지널",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00088",
     "kind": "본문",
     "jp": "お母様",
     "ko": "어머님",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00089",
     "kind": "본문",
     "jp": "、\n　貴女がよく識っているものよ」",
     "ko": ",\n　당신이 잘 알고 있는 것이죠」"
    }
   ]
  },
  {
   "uid": "da0501:U00046",
   "speaker": "アナザーブラッド",
   "jp": "「それに……探偵さんも」",
   "cells": [
    {
     "sid": "da0501:T00090",
     "kind": "본문",
     "jp": "「それに……探偵さんも」",
     "ko": "「게다가…… 탐정님도」"
    }
   ]
  },
  {
   "uid": "da0501:U00047",
   "speaker": "九郎",
   "jp": "「俺が……」",
   "cells": [
    {
     "sid": "da0501:T00091",
     "kind": "본문",
     "jp": "「俺が……」",
     "ko": "「내가……」"
    }
   ]
  },
  {
   "uid": "da0501:U00048",
   "speaker": "アナザーブラッド",
   "jp": "「『流血祈祷書』に記されし\n　鮮血神――ふふ、同じ『血』\n　の属性を持つだけに、私とは\n　相性が良いわぁ」",
   "cells": [
    {
     "sid": "da0501:T00092",
     "kind": "본문",
     "jp": "「『流血祈祷書』に記されし\n　鮮血神――ふふ、同じ『血』\n　の属性を持つだけに、私とは\n　相性が良いわぁ」",
     "ko": "「『유혈기도서』에 기록된\n　선혈신――후후, 같은 『피』\n　의 속성을 지닌 만큼, 나와는\n　상성이 좋다니까」"
    }
   ]
  },
  {
   "uid": "da0501:U00049",
   "speaker": "アル",
   "jp": "「ズアウィアは存在しない！\n　歪んだ因果は断ち切られたのだ！」",
   "cells": [
    {
     "sid": "da0501:T00093",
     "kind": "본문",
     "jp": "「ズアウィアは存在しない！\n　歪んだ因果は断ち切られたのだ！」",
     "ko": "「즈아위아는 존재하지 않는다!\n　일그러진 인과는 끊어졌단 말이다!」"
    }
   ]
  },
  {
   "uid": "da0501:U00050",
   "speaker": "アナザーブラッド",
   "jp": "「そうだ！　私たちは怨念だ！\n　存在を否定された〈ゴースト〉亡零の怨念だ！」",
   "cells": [
    {
     "sid": "da0501:T00094",
     "kind": "본문",
     "jp": "「そうだ！　私たちは怨念だ！\n　存在を否定された",
     "ko": "「그래!　우리는 원념이다!\n　존재를 부정당한 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00016",
     "kind": "루비 읽기",
     "jp": "ゴースト",
     "ko": "고스트",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00095",
     "kind": "본문",
     "jp": "亡零",
     "ko": "망령",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00096",
     "kind": "본문",
     "jp": "の怨念だ！」",
     "ko": "의 원념이다!」"
    }
   ]
  },
  {
   "uid": "da0501:U00051",
   "speaker": "九朔",
   "jp": "「うおおおおおおおおお！」",
   "cells": [
    {
     "sid": "da0501:T00097",
     "kind": "본문",
     "jp": "「うおおおおおおおおお！」",
     "ko": "「우오오오오오오오오오!」"
    }
   ]
  },
  {
   "uid": "da0501:U00052",
   "speaker": "(지문)",
   "jp": "九朔が吼える。シャンタクは眩いほどの〈エネルギー〉魔力を発しているが、触手の拘束は固い。業を煮やしたか、続いて脚部シールドが光を放ち始める。",
   "cells": [
    {
     "sid": "da0501:T00098",
     "kind": "본문",
     "jp": "九朔が吼える。",
     "ko": "쿠자쿠가 포효한다."
    },
    {
     "sid": "da0501:T00099",
     "kind": "본문",
     "jp": "シャンタクは眩いほどの",
     "ko": "샨타크는 눈부실 정도의 ",
     "ruby_edge": "뒤"
    },
    {
     "sid": "da0501:R00017",
     "kind": "루비 읽기",
     "jp": "エネルギー",
     "ko": "에너지를",
     "lock": "루비 읽기 칸은 고치지 않는다"
    },
    {
     "sid": "da0501:T00100",
     "kind": "본문",
     "jp": "魔力",
     "ko": "마력을",
     "ruby_edge": "앞"
    },
    {
     "sid": "da0501:T00101",
     "kind": "본문",
     "jp": "を発しているが、触手の拘束は固い。",
     "ko": " 발하고 있지만, 촉수의 구속은 단단하다."
    },
    {
     "sid": "da0501:T00102",
     "kind": "본문",
     "jp": "業を煮やしたか、続いて脚部シールドが光を放ち始める。",
     "ko": "속이 끓었는지, 이어서 다리 실드가 빛을 발하기 시작한다."
    }
   ]
  },
  {
   "uid": "da0501:U00053",
   "speaker": "九朔",
   "jp": "「断鎖術式壱号ティマイオス！\n　弐号クリティアス！　解放！」",
   "cells": [
    {
     "sid": "da0501:T00103",
     "kind": "본문",
     "jp": "「断鎖術式壱号ティマイオス！\n　弐号クリティアス！　解放！」",
     "ko": "「단쇄술식 1호 티마이오스!\n　2호 크리티아스!　해방!」"
    }
   ]
  },
  {
   "uid": "da0501:U00054",
   "speaker": "(지문)",
   "jp": "時空間歪曲の反作用によって、紫電が迸る。脚部シールドの出力は急激に上昇し、それに比例して電撃は\n荒れ狂う。\n\n　極限まで高まったエネルギーが解放される――",
   "cells": [
    {
     "sid": "da0501:T00104",
     "kind": "본문",
     "jp": "時空間歪曲の反作用によって、紫電が迸る。",
     "ko": "시공간 왜곡의 반작용으로 인해 보랏빛 번개가 솟구친다."
    },
    {
     "sid": "da0501:T00105",
     "kind": "본문",
     "jp": "脚部シールドの出力は急激に上昇し、それに比例して電撃は\n荒れ狂う。\n\n　極限まで高まったエネルギーが解放される――",
     "ko": "다리 실드의 출력은 급격히 상승하고, 그에 비례하여 전격은\n미친 듯이 날뛴다.\n\n　극한까지 높아진 에너지가 해방된다――"
    }
   ]
  },
  {
   "uid": "da0501:U00055",
   "speaker": "九朔",
   "jp": "「アトランティス・ストライク！」",
   "cells": [
    {
     "sid": "da0501:T00106",
     "kind": "본문",
     "jp": "「アトランティス・ストライク！」",
     "ko": "「아틀란티스 스트라이크!」"
    }
   ]
  },
  {
   "uid": "da0501:U00056",
   "speaker": "(지문)",
   "jp": "攻撃の矛先を自分に向けての、時空間歪曲エネルギーの爆発。赤黒い海が爆ぜ、触手が千切れ飛んだ。\n\n　無論、Ｄトゥーソードも無事ではない。装甲はひび割れ、剥がれ落ち、脚部は爆発と負荷によって\nへし折れ、使い物になりそうになかった。",
   "cells": [
    {
     "sid": "da0501:T00107",
     "kind": "본문",
     "jp": "攻撃の矛先を自分に向けての、時空間歪曲エネルギーの爆発。",
     "ko": "공격의 화살을 자신에게 돌린 시공간 왜곡 에너지의 폭발."
    },
    {
     "sid": "da0501:T00108",
     "kind": "본문",
     "jp": "赤黒い海が爆ぜ、触手が千切れ飛んだ。\n\n　無論、Ｄトゥーソードも無事ではない。",
     "ko": "검붉은 바다가 터져 나가고 촉수가 갈기갈기 찢겨 날아갔다.\n\n　물론 D 투 소드도 무사하지는 않다."
    },
    {
     "sid": "da0501:T00109",
     "kind": "본문",
     "jp": "装甲はひび割れ、剥がれ落ち、脚部は爆発と負荷によって\nへし折れ、使い物になりそうになかった。",
     "ko": "장갑은 금이 가고 벗겨져 떨어졌으며, 다리 부분은 폭발과 부하로 인해\n꺾여 버려 쓸모가 없을 것 같았다."
    }
   ]
  },
  {
   "uid": "da0501:U00057",
   "speaker": "九郎",
   "jp": "「……なんちゅー無茶を」",
   "cells": [
    {
     "sid": "da0501:T00110",
     "kind": "본문",
     "jp": "「……なんちゅー無茶を」",
     "ko": "「……무슨 저런 무모한 짓을」"
    }
   ]
  },
  {
   "uid": "da0501:U00058",
   "speaker": "アル",
   "jp": "「……そっくりだな」",
   "cells": [
    {
     "sid": "da0501:T00111",
     "kind": "본문",
     "jp": "「……そっくりだな」",
     "ko": "「……판박이로군」"
    }
   ]
  },
  {
   "uid": "da0501:U00059",
   "speaker": "九郎",
   "jp": "「何と？」",
   "cells": [
    {
     "sid": "da0501:T00112",
     "kind": "본문",
     "jp": "「何と？」",
     "ko": "「누구랑?」"
    }
   ]
  },
  {
   "uid": "da0501:U00060",
   "speaker": "アル",
   "jp": "「汝と、だ」",
   "cells": [
    {
     "sid": "da0501:T00113",
     "kind": "본문",
     "jp": "「汝と、だ」",
     "ko": "「그대와 말이다」"
    }
   ]
  },
  {
   "uid": "da0501:U00061",
   "speaker": "九朔",
   "jp": "「アナザァァァァァァァ\n　ブラッドォォォォォォォッ！」",
   "cells": [
    {
     "sid": "da0501:T00114",
     "kind": "본문",
     "jp": "「アナザァァァァァァァ\n　ブラッドォォォォォォォッ！」",
     "ko": "「어나더어어어어어어\n　블러드으으으으으으윽!」"
    }
   ]
  },
  {
   "uid": "da0501:U00062",
   "speaker": "(지문)",
   "jp": "折れた脚に構わず、シャンタクを噴かせ、紅の少女に突撃する。飛びながら両手に持ったロイガー、ツァールを振り下ろそうとして、",
   "cells": [
    {
     "sid": "da0501:T00115",
     "kind": "본문",
     "jp": "折れた脚に構わず、シャンタクを噴かせ、紅の少女に突撃する。",
     "ko": "부러진 다리는 아랑곳하지 않고 샨타크를 분사하며 붉은 소녀에게 돌격한다."
    },
    {
     "sid": "da0501:T00116",
     "kind": "본문",
     "jp": "飛びながら両手に持ったロイガー、ツァールを振り下ろそうとして、",
     "ko": "날면서 양손에 쥔 로이거, 차르를 내리치려다가,"
    }
   ]
  },
  {
   "uid": "da0501:U00063",
   "speaker": "アナザーブラッド",
   "jp": "「甘いわよ、騎士殿」",
   "cells": [
    {
     "sid": "da0501:T00117",
     "kind": "본문",
     "jp": "「甘いわよ、騎士殿」",
     "ko": "「무르구나, 기사공」"
    }
   ]
  },
  {
   "uid": "da0501:U00064",
   "speaker": "(지문)",
   "jp": "遅かった。刃が少女に届くより早く、新たにタールの海から生えた触手の群れが、Ｄトゥーソードを串刺しにした。",
   "cells": [
    {
     "sid": "da0501:T00118",
     "kind": "본문",
     "jp": "遅かった。",
     "ko": "늦었다."
    },
    {
     "sid": "da0501:T00119",
     "kind": "본문",
     "jp": "刃が少女に届くより早く、新たにタールの海から生えた触手の群れが、Ｄトゥーソードを串刺しにした。",
     "ko": "칼날이 소녀에게 닿기보다 빠르게, 새로이 타르의 바다에서 돋아난 촉수 무리가 D 투 소드를 꼬치로 꿰었다."
    }
   ]
  },
  {
   "uid": "da0501:U00065",
   "speaker": "九朔",
   "jp": "「があああああ！」",
   "cells": [
    {
     "sid": "da0501:T00120",
     "kind": "본문",
     "jp": "「があああああ！」",
     "ko": "「크아아아아아!」"
    }
   ]
  },
  {
   "uid": "da0501:U00066",
   "speaker": "九郎",
   "jp": "「九朔！」",
   "cells": [
    {
     "sid": "da0501:T00121",
     "kind": "본문",
     "jp": "「九朔！」",
     "ko": "「쿠자쿠!」"
    }
   ]
  },
  {
   "uid": "da0501:U00067",
   "speaker": "アナザーブラッド",
   "jp": "「残念でした。じゃあね？」",
   "cells": [
    {
     "sid": "da0501:T00122",
     "kind": "본문",
     "jp": "「残念でした。じゃあね？」",
     "ko": "「유감이네요. 그럼 안녕?」"
    }
   ]
  },
  {
   "uid": "da0501:U00068",
   "speaker": "九朔",
   "jp": "「く……くそっ」",
   "cells": [
