      "ko": "멜로디와",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00062",
      "source_sha256": "f0385d5399ff3c93c55d443b0f03e1ef2439d753ecd414d16183b16953ab009d",
      "ko": "선율과"
    },
    {
      "id": "da1502a:T00063",
      "source_sha256": "e77c847a46d2aa73fbe744c4a7cfbb1dfb47fdf66cfbd336294d08655abce453",
      "ko": " 미친 "
    },
    {
      "id": "da1502a:R00021",
      "source_sha256": "ccd80fe2406e12cdd1ae6972c9a3e7444c0d02478133cef826f31f4fcec34f42",
      "ko": "드럼",
      "ruby_action": "keep"
    },
    {
