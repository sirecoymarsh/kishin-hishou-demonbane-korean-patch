    },
    {
      "id": "da1502a:T00065",
      "source_sha256": "3b2e79bc719379948597cf4be8f8c76f1b3296e6089b0a355b1d9b49e5503647",
      "ko": "의 "
    },
    {
      "id": "da1502a:R00022",
      "source_sha256": "84ef66040449740cf633d4f35adf719737857496b3e5c61d918d3b51b41961cf",
      "ko": "리듬",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00066",
      "source_sha256": "5871caed50de64bf37bf1ceeea5aebf6fcddb07d226d97495cdf46090ff503a3",
      "ko": "박자"
    },
    {
      "id": "da1502a:T00067",
      "source_sha256": "f4c95e016272a03229b9e6ef99f7950cebc5eeed386933784cbbda9bcc04833e",
      "ko": "에 선잠이 들어, 혼돈의 핵은 봉신되어 있다."
    },
    {
      "id": "da1502a:T00068",
      "source_sha256": "22b9ff25efb86de8d9c998163be0f3318cae0348a512c52e21acf4f1248a34db",
      "ko": "――빛나는 트라페조헤드론."
    },
    {
      "id": "da1502a:T00069",
      "source_sha256": "90d5a5d5cb3e05951920864c0c1ed189821f12ffd0e9252767a80de15e69c78f",
      "ko": "그것은 끓어오르는 혼돈 아자토스의 우주를 빙결 / 구속 / 봉멸한\n신기이자, 무한히 존재하는 세계 그 자체."
    },
    {
      "id": "da1502a:T00070",
      "source_sha256": "fde5e4e6a70f071ae61a90be9f6dbb0b37fa8a0b39fe386aa91dd2222c25a169",
      "ko": "「단 하나뿐인…… 신들을 위한\n올바른 우주를 봉인하기 위해\n너희는 무한에 가까운 우주의 유해\n를 첩첩이 쌓아 올린 거야!」"
    },
    {
      "id": "da1502a:T00071",
      "source_sha256": "dc9bde8d46f584d8d3859ec5d97a8ff69d9141774c3dde81484195d7e55189b2",
      "ko": "「――유해 따위가 아니야」"
    },
    {
      "id": "da1502a:T00072",
      "source_sha256": "cdc846f0e34b830bff210b612e1c3619688cf1cbfd50bc66fc35b4b538b981e0",
      "ko": "「그것은 자식의 내일을 빼앗긴, 어미의 한탄」"
    },
    {
      "id": "da1502a:T00073",
      "source_sha256": "b594d60f66516caa1fcf78c8b4dd1930aac1581da6f34e6ff91333dc255773d1",
      "ko": "「그것은 자식의 내일을 지키지 못한, 아비의 분노」"
    },
    {
      "id": "da1502a:T00074",
      "source_sha256": "9d63cbeabbbc1e761826a3bd3fa92363858d22abd4f8f97e31275c8dabef9774",
      "ko": "「그것은 사악함에 "
    },
    {
      "id": "da1502a:R00023",
      "source_sha256": "c15e66756f836acc97fe1b71a7a71550b17a744dcccf5855958e2e0d79a9b5a8",
      "ko": "유린",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00075",
      "source_sha256": "de576b8e1a03c11f86f11c0bb22a14076542dba00805219152b4ff0ee122f406",
      "ko": "농락"
    },
    {
      "id": "da1502a:T00076",
      "source_sha256": "7cd204b748da3070e767e0712d1a455bc6f0fc2747a00f59529eff3218e92e6b",
      "ko": "당한,\n　무수한 세계의 절규와 기도……이지만」"
    },
    {
      "id": "da1502a:T00077",
      "source_sha256": "70b44175ac743241172e7131ea159dc88c0525706d36add0970b8cebc0056b7e",
      "ko": "「그 의지는―― 힘이 된 거야」"
    },
    {
      "id": "da1502a:T00078",
      "source_sha256": "6662ef06509dea861035a2873c8bfe1cfe8d0de8df023cdd74c4c75c1280e17e",
      "ko": "「혼돈이여. 그 얼굴 없는 얼굴에 뚫린,"
    },
    {
      "id": "da1502a:R00024",
      "source_sha256": "9340ec2bd34f504a6ceb14f5c8beea15a575bf08b4f8f6e31d771c48855f6ce1",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00079",
      "source_sha256": "a20eda9744a7dcdcc91352732604c547ffdb645ba2fcefd6b24ba363bf3df2de",
      "ko": "광야"
    },
    {
      "id": "da1502a:T00080",
      "source_sha256": "3b2e79bc719379948597cf4be8f8c76f1b3296e6089b0a355b1d9b49e5503647",
      "ko": "의 "
    },
    {
      "id": "da1502a:R00025",
      "source_sha256": "77574f3ead81ac1417f7ece57ef3afc5d2a488f021d76fc9d6ebeff259908ab0",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00081",
      "source_sha256": "393ee0b5797efaa42b103981be37ed70703e44523fc77f777cdcc9c8026a2993",
      "ko": "눈"
    },
    {
      "id": "da1502a:T00082",
      "source_sha256": "a2e54fdcf32b8ceaa593999f460bd361bd0ba4f0a598c6a11bcdda7c52e6ae6c",
      "ko": "으로 "
    },
    {
      "id": "da1502a:R00026",
      "source_sha256": "6195718f5eb43d289510d24a658c4d8209ba3aa3fc4d4c9527231166d2a0c8f4",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00083",
      "source_sha256": "7fa48bad516a2de563bc66c385b11a612f3596b9b149a0bec94fed63f91cc49b",
      "ko": "똑똑"
    },
    {
      "id": "da1502a:T00084",
      "source_sha256": "427566260604d16fb4a900e51400dd5dfac2ef749901179434735f0d0008d100",
      "ko": "히 "
    },
    {
      "id": "da1502a:R00027",
      "source_sha256": "71541c68c80f279e2d988b2afc366dad1df68b500f3947fe63c3175eedef8662",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00085",
      "source_sha256": "e2267f0baeeac82530e0a6993e4d3d2ec2d6f81707b5057881157a3c537d5a7b",
      "ko": "보"
    },
    {
      "id": "da1502a:T00086",
      "source_sha256": "2f11508f5619001a5e59e5d87451f4f2a46622d4420a4d1271d20d90473b78ff",
      "ko": "아라」"
    },
    {
      "id": "da1502a:T00087",
      "source_sha256": "4c944de58d68d37808462fbdd3a518a6dbb066bbe8f5a7a0ea6b82dbc64f102f",
      "ko": "「무수한 세계의, 무한한 하늘에서 도래하는"
    },
    {
      "id": "da1502a:R00028",
      "source_sha256": "c83d09288a91cba65388da926999234b69ebe4c1dad3efd7cf413e48f4bdd85e",
      "ko": "자",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00088",
      "source_sha256": "4a558371f938b01d790207375865ed101b0826bdbda2e46b552b7910337d527a",
      "ko": "존재"
    },
    {
      "id": "da1502a:T00089",
      "source_sha256": "2ea285709dea283ee616ded6a5d7244865ae76cd8b6011cdbc72b086174c4f3d",
      "ko": "가 무엇인지를――」"
    },
    {
      "id": "da1502a:T00090",
      "source_sha256": "d6ff57b15b98cd5ff389b3dee9685b6e65dce7aa4df9a9976712aa91c255a20a",
      "ko": "「……읏!?」"
    },
    {
      "id": "da1502a:T00091",
      "source_sha256": "79d99918fb51469ee10e04846c374b8a06e961dae1bcf794a3aa9ec109a90f0a",
      "ko": "그리고, 그것은 왔다."
    },
    {
      "id": "da1502a:T00092",
      "source_sha256": "6e5894c6e2835f8e032d8a2c45f1d4bedddd46d555aced3ca648dd1ecc7ed0fe",
      "ko": "증오로 불타는 하늘 저편――"
    },
    {
      "id": "da1502a:T00093",
      "source_sha256": "cb681d1a02939384cf3ac761f2a65ea5f70963940a3e5cce87204aa79bdd660a",
      "ko": "무한 / 무량 / 무궁한 "
    },
    {
      "id": "da1502a:R00029",
      "source_sha256": "2d6fa57bd3e1c194e96637c1dfdc27413d71128824eb8fb5a90ee117f9f7553a",
      "ko": "하늘",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00094",
      "source_sha256": "eda8157c4c7025af29b9fc0dcf1cde1e4ec3263125eaa4d298e762d127fbb5b9",
      "ko": "우주"
    },
    {
      "id": "da1502a:T00095",
      "source_sha256": "2c3ee056f9e9ffebf4ffd057178046aa52d5d8ef18c4256ea83007c4ef6925b8",
      "ko": " 저편에서.\n\n\n　올바른 분노를 가슴에 품고."
    },
    {
      "id": "da1502a:T00096",
      "source_sha256": "bf60e9f6d72cd84b11ad8c8ba7d856d658bf218b15c86848ae513b20c6fca756",
      "ko": "「……왔는가. 너나 할 것 없이 몰려\n왔군, 『너희』는. "
    },
    {
      "id": "da1502a:R00030",
      "source_sha256": "b34cc9b424270a797f120fcc1c8c497d805f6c5d72257c1d26898321e55548fd",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00097",
      "source_sha256": "081a3f6c063f563051b41145e8624be44c65b18bc6ecb082225fb5b4436e05a7",
      "ko": "끔"
    },
    {
      "id": "da1502a:T00098",
      "source_sha256": "69999085793c14b3bed5ef0fcea4c91934621c9553f70a62fedac0299659f795",
      "ko": "찍할 만큼의\n희망을 "
    },
    {
      "id": "da1502a:R00031",
      "source_sha256": "533176a18733bdb6dd3b7bcd0730749ca1de5058c74fe3c92ae2de8e635fe0e1",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00099",
      "source_sha256": "4232d6f773dc58c6db680d03f90ebe7e7abd6e921145515d80a778b744a3bb70",
      "ko": "품"
    },
    {
      "id": "da1502a:T00100",
      "source_sha256": "b55a15935a0fdf323f7197cf8a9fca0cb18e5986959e40bb8b1f1747addeb807",
      "ko": "은, 『너희』가」"
    },
    {
      "id": "da1502a:T00101",
      "source_sha256": "d3bf248f68ae049a79dfa39c933e8d80df1ab2ce224480a4bf5439e2d84ee593",
      "ko": "그것은, 데몬베인이다."
    },
    {
      "id": "da1502a:T00102",
      "source_sha256": "cb681d1a02939384cf3ac761f2a65ea5f70963940a3e5cce87204aa79bdd660a",
      "ko": "무한 / 무량 / 무궁한 "
    },
    {
      "id": "da1502a:R00032",
      "source_sha256": "2d6fa57bd3e1c194e96637c1dfdc27413d71128824eb8fb5a90ee117f9f7553a",
      "ko": "하늘",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00103",
      "source_sha256": "eda8157c4c7025af29b9fc0dcf1cde1e4ec3263125eaa4d298e762d127fbb5b9",
      "ko": "우주"
    },
    {
      "id": "da1502a:T00104",
      "source_sha256": "c46de4ea9996cc0aafd17a0a598074826ed25b3bbbe1861ba03968c15c3c2ba5",
      "ko": " 저편에서 찾아온,\n　무한 / 무진 / 무구한 데몬베인이다.\n\n　세계의 모든 것을 빈틈없이 메우는, "
    },
    {
      "id": "da1502a:R00033",
      "source_sha256": "ad00a0b322492061745b24d0a27cfeb54340097e166853622a9781f99bd15efb",
      "ko": "・・・・",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00105",
      "source_sha256": "faad4663917e9f697861dd8f8351f4b75876f086445f4735d2e147048b1329b2",
      "ko": "데몬베인"
    },
    {
      "id": "da1502a:R00034",
      "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
      "ko": "・・・・・",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00106",
      "source_sha256": "1858819a4dfae6f9fa663880457632d42cd200b7afc7c0f530a339a26d57b8ad",
      "ko": "의 대군세다"
    },
    {
      "id": "da1502a:T00107",
      "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
      "ko": "."
    },
    {
      "id": "da1502a:T00108",
      "source_sha256": "97794143fb37300b496fccd8215658e8ada7eb8ccdea3b9fd229d9061fa43ea0",
      "ko": "상처 하나 없는, 새로운 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00109",
      "source_sha256": "130d046e4058fcbf4a697284be5f9c8db8ea565ecbfa9a8f9e584b27e10c1ba1",
      "ko": "수많은 격전을 헤쳐 나온, 백전노장 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00110",
      "source_sha256": "4cce14cd54bbffd468dd8b2f8ccb44b12c9ef7214205612ef960d35d5e4bc4a6",
      "ko": "아직 완성되지 않아, "
    },
    {
      "id": "da1502a:R00035",
      "source_sha256": "4d9c2e5034e9e2a5f43c4e3de284a48806e6bee89d22c509a1e23dd941c290a1",
      "ko": "프레임",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00111",
      "source_sha256": "17d9a0f233ecdd7f736f8c694a61772495e8728edef8a32a7659d8da42f826d6",
      "ko": "골격"
    },
    {
      "id": "da1502a:T00112",
      "source_sha256": "fe2d1a62c49a4ab5c19764e7469fcc1d00455e7ceb41886160d94aeae2b79a68",
      "ko": "이 그대로 드러난 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00113",
      "source_sha256": "c89029827d2665d4adb98abd10404b38469b3fe6404b7f03b41f50ac5934797c",
      "ko": "파괴되어, 마지막 마력을 불태우는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00114",
      "source_sha256": "0665846e03c27e0c16332c26ce10743adeb45426f9b8237a39b156838a579a4c",
      "ko": "다른 시간축의 쿠로와 알이 모는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00115",
      "source_sha256": "e7f1d3f4786e438c3f58de7fa0f55ae49941c1a6809088dceaf79ac8cc4fe234",
      "ko": "다른 시간축의 쿠자쿠가 모는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00116",
      "source_sha256": "babfa2f9db7d747fb94b4529b52c556082b18608dd10f3c6f25f204c50096008",
      "ko": "쿠자쿠와 아직 보지 못한 "
    },
    {
      "id": "da1502a:R00036",
      "source_sha256": "a4f44df5bc0e22b95ea0c84e091cd3fdf621995611b6e95ab8dbb9225d12d2fc",
      "ko": "파트너",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00117",
      "source_sha256": "4d212f9c677e44bf91445ea317ca4345b50ca6633f086ef9d1757fcbc3d191ad",
      "ko": "누군가"
    },
    {
      "id": "da1502a:T00118",
      "source_sha256": "7377737bb0ae8ccdc6f7501ecaab92bca443d27d7973191a7284bdfc473c1eef",
      "ko": "가 모는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00119",
      "source_sha256": "73537d4afe5575367dc3b57d6bafaefd3bf7b02bd9d07bf18f3b4b14cf346fd7",
      "ko": "전혀 다른, 낯선 누군가가 모는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00120",
      "source_sha256": "9a6c67926835e2aa6106687beb42f897f9f4c8bcce832ec4f98a4f6d42d959ca",
      "ko": "무인으로 기동하는 데몬베인이 있었다."
    },
    {
      "id": "da1502a:T00121",
      "source_sha256": "2983b57e74b775ff953ed66ecfaaa831598ce755ff830e5b7f20b0d9d4f4b8f2",
      "ko": "인간 이외의 무언가가 모는 데몬베인이 있었다."
    },
    {
