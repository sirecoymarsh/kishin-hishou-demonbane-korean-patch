      "ko": " / 만물의 중추 / "
    },
    {
      "id": "da1502a:R00017",
      "source_sha256": "c549f8da8eae5c90edff653dae2b0ad18b8154c1fa60dfef20a21b67e392b517",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00056",
      "source_sha256": "21b3308f9de4c9f9a2abdafff6d6440453b94bbbb5238c58b4eccb96489c0455",
      "ko": "궁극"
    },
    {
      "id": "da1502a:T00057",
      "source_sha256": "3b2e79bc719379948597cf4be8f8c76f1b3296e6089b0a355b1d9b49e5503647",
      "ko": "의 "
    },
    {
      "id": "da1502a:R00018",
      "source_sha256": "32778b29fea58065310a90200d4724635cfcb412a39c0e13877cd9f349b18b42",
      "ko": "제로",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00058",
      "source_sha256": "9489a4a6f3fbf136816df3dd09583e15303363fc58288d12697ebb5475901f6e",
      "ko": "영"
    },
    {
      "id": "da1502a:T00059",
      "source_sha256": "571e1e3b0f43f89fcb228c6ffb07f58a8a8e67e02212476878ce6020236044c1",
      "ko": "――\n\n　가냘픈 "
    },
    {
      "id": "da1502a:R00019",
      "source_sha256": "77b4c99cf1128de401a89b6c2855490681f5e1c29b8fbbfd624f999fc4bbcce1",
