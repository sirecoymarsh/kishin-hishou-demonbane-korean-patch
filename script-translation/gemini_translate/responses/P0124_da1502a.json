    },
    {
      "id": "da1502a:T00008",
      "source_sha256": "7eb71b9eaecd7e27236a0abf7bf4a88c1d2165d58782de7c4e13783d34edccc3",
      "ko": "북의 "
    },
    {
      "id": "da1502a:R00003",
      "source_sha256": "cb5077b943831678bad5fcbefc19b802dcc052c1bf98201e03f340457f44e4f8",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00009",
      "source_sha256": "81aab7083dccfd63d162c6a75960f08945b9bab87f1530607523bbf36bbc20f8",
      "ko": "메아리"
    },
    {
      "id": "da1502a:T00010",
      "source_sha256": "213b77809a7dea1358f4b1844c2c038fb169b1927cd26d37b3b766ff274dee23",
      "ko": "로 울려 퍼지는 우주."
    },
    {
      "id": "da1502a:T00011",
      "source_sha256": "8a1aa67a4066eff6bfc89a619dd3ab457e23409b5a85bb3f8396e6451d8a62f1",
      "ko": "뇌수에 유폐된 우주."
    },
    {
      "id": "da1502a:T00012",
      "source_sha256": "9ff0646f091e6296433927464f9462b5d0b606523e79546c29ac7c363cb561b1",
      "ko": "츄잉껌 포장지에 싸인 우주――\n\n　우주 밖에 펼쳐지는 우주."
    },
    {
      "id": "da1502a:T00013",
      "source_sha256": "527935036eacda2189cec697450a4ba8fe9b0ab038bdb48a110f58fc90d7c0f9",
      "ko": "우주 안으로 펼쳐지는 우주."
    },
    {
      "id": "da1502a:T00014",
      "source_sha256": "d0a7b8f09d6e87b2194daa61a53686abc2fe09b8cf4023c1466fb5909d72ef17",
      "ko": "영겁을 집어삼킨 찰나."
    },
    {
      "id": "da1502a:T00015",
      "source_sha256": "ed86f75463fb6ec85bbc67a0c50da7f312668d604d32555f0568b458b3a5a15a",
      "ko": "무한대를 가둬 넣은 지극히 작은 티끌.\n\n　우주 밖에 펼쳐지는 우주의, 우주 밖에 펼쳐지는 우주 밖에 펼쳐지는\n　우주의, 우주 밖에 펼쳐지는 우주 밖에 펼쳐지는 우주 밖에 펼쳐지는\n　우주의…… 무한히 이어지는 우주."
    },
    {
      "id": "da1502a:T00016",
      "source_sha256": "c9ff988c63c8334e3fc02222058287fc54fb30b281fb588a18af284b42ccfe2e",
      "ko": "모든 것은 무한이면서 영이라는 이야기."
    },
    {
      "id": "da1502a:T00017",
      "source_sha256": "4a6c95667f01dd72e94516d2916abe0075dbb8712c79ec1cad8b67e39b31f87b",
      "ko": "무한과 영이 녹아들고, 윤회의 뱀이 썩어 문드러져, 끓어"
    },
    {
      "id": "da1502a:R00004",
      "source_sha256": "66375f610acae70cb94950511fa7fdb7f8d055ca6387ec2c2101f481a05eb4cf",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00018",
      "source_sha256": "d9391958404544734d838bd9b0dae5398d90b46721a4b23eca798d55cfa2815f",
      "ko": "오르"
    },
    {
      "id": "da1502a:T00019",
      "source_sha256": "1e6a8f663905d4109497cdd307db39079da45f08301367b1980b7050ee5d220d",
      "ko": "는 혼돈의 수프를 만들어내는 것이다――"
    },
    {
      "id": "da1502a:T00020",
      "source_sha256": "98a4749592ed49fea02920bee7519be039b86bebd55a6d31a673a26eee6ce732",
      "ko": "「빛나는 트라페조헤드론. 그것은 우주의 초점. 성계로 이어지는 문. 이계의 존재에 도달하기 위한 길――」"
    },
    {
      "id": "da1502a:T00021",
      "source_sha256": "a38e04e579ec9e5c044bd6059bc2cfcc56b97a0a6efc20c7fbfd72c7b1595df5",
      "ko": "「빛나는 트라페조헤드론.\n　그것은 치유하는 것.\n　그것은 파괴하는 것.\n　그것은 변용시키는 것――」"
    },
    {
      "id": "da1502a:T00022",
      "source_sha256": "f337d819d9b3df2dc388b1be551a2c97ab93e65c8066dc4da096feadfabf8f32",
      "ko": "「……빛나는 트라페조헤드론!\n　――그래!\n　그것은 유폐된 올바른 우주다!」"
    },
    {
      "id": "da1502a:T00023",
      "source_sha256": "d5d05826f7c0397a0c5b06c49e96f6b8cde17345234e2b82e46230a927b4b46f",
      "ko": "「내 고향인 끓어"
    },
    {
      "id": "da1502a:R00005",
      "source_sha256": "66375f610acae70cb94950511fa7fdb7f8d055ca6387ec2c2101f481a05eb4cf",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00024",
      "source_sha256": "d9391958404544734d838bd9b0dae5398d90b46721a4b23eca798d55cfa2815f",
      "ko": "오르"
    },
    {
      "id": "da1502a:T00025",
      "source_sha256": "d0da7ae0610a3baf06ceb1c7e35ebf7db11fb7936b8f17cf77df963c6f7f7466",
      "ko": "는 혼돈!\n나의 조소해야 마땅할 주인 아자토스의 뜰!」"
    },
    {
      "id": "da1502a:T00026",
      "source_sha256": "72bf630b80f86543f858247540faf8f183336fc5f3815a48e2c4fcb9779d2178",
      "ko": "「알고 있다…… 알고 있어!\n너희가 어떻게, 맹목암우한\n내 아버지를 유폐했는지를 난 알고\n있다고!」"
    },
    {
      "id": "da1502a:T00027",
      "source_sha256": "fd4073c4ecb9690cbeee44e4784a03b5a18d12c7e1cc0d046b1cce3f0f1a36c0",
      "ko": "그리고――"
    },
    {
      "id": "da1502a:R00006",
      "source_sha256": "d173edc543f6299221c76147da6d9b8dbc8bf2c39aa71c21b9eb385ff1825577",
      "ko": "트라페조헤드론",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00028",
      "source_sha256": "f5af3bfcfd95c42faf29ae9e8aa41879bc2c5b26b7bd8a621f83dba1c4edc178",
      "ko": "뒤틀린 다면체"
    },
    {
      "id": "da1502a:T00029",
      "source_sha256": "c726149737b1b3f0a0fbff654e3f4847c72f7fd73b3ac7dcd548005252af9693",
      "ko": "의 스물네 면 중 731면이,\n　무수한 "
    },
    {
      "id": "da1502a:R00007",
      "source_sha256": "a86df34a6f3fd760cd90b6597d0c6936a42c68e4adc46930a700d6cb24302710",
      "ko": "이야기",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00030",
      "source_sha256": "33650a369521ec29f2e26c43d25967535bcb26436755f536735d1ef6e84a1ec5",
      "ko": "세계"
    },
    {
      "id": "da1502a:T00031",
      "source_sha256": "171c4e45ee303b2402be53ee3059f7e3a1f0e467fe86441cc7ddc5ba67fe94ec",
      "ko": "를 비춰낸다."
    },
    {
      "id": "da1502a:T00032",
      "source_sha256": "8d31b96438db6d33659f2314c2684d2fe85e8dd3877e85ab959206cd2003e8c1",
      "ko": "무한한 "
    },
    {
      "id": "da1502a:R00008",
      "source_sha256": "3e7ca97dd222dfece75cc1b0e619438b0296dd7b6db45fe8ff3627464f181e69",
      "ko": "세계",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00033",
      "source_sha256": "846c39b0bcb51f41f7a9b92e4d3452d15b86f3e1cd153f8d3d2ba8ef55219731",
      "ko": "이야기"
    },
    {
      "id": "da1502a:T00034",
      "source_sha256": "aeb91b9a8edfde4fa0ba97575252d7962756e0231e497cc1ef699a1c6f7dca50",
      "ko": "를 자아낸다."
    },
    {
      "id": "da1502a:T00035",
      "source_sha256": "7c4afa977847e52bdecd1d520bc396060f54db07c678f3ca5386e9fc029f6ac6",
      "ko": "「빛나는 트라페조헤드론!"
    },
    {
      "id": "da1502a:R00009",
      "source_sha256": "09fa673682a266196a91d31d5ed99736a1c7d85c250226fb9c9ec5b7006a27ba",
      "ko": "아자토스",
      "ruby_action": "keep"
    },
    {
      "id": "da1502a:T00036",
      "source_sha256": "302de86e473c611a54bdc2063884aa4bc17bdd1ded391a422879cda83fc6423a",
      "ko": "조물주"
    },
    {
      "id": "da1502a:T00037",
      "source_sha256": "254e8af85e33a65f6722170787665674852bb33bb5783213c781068784f614da",
      "ko": "를 봉인하는 이 신기의\n　기본 소재는……」"
    },
    {
      "id": "da1502a:T00038",
      "source_sha256": "1f092f9da32189050a5eed3dce9d432b9d52e2b412c2cf4a8d76fcc82b411991",
      "ko": "무한한 이야기를 내재한, 무수한 세계가, 동시에 평행하게 전개된다."
    },
    {
      "id": "da1502a:T00039",
      "source_sha256": "aff8e4da422c015cccc5f9d072d1b6e3ba31d5e71fa0f6f193f6d05f9d92cd87",
      "ko": "시험관 속 우주가 / 반응로 속 우주가 / 코인 로커 속 우주가 / 북의 "
    },
    {
      "id": "da1502a:R00010",
      "source_sha256": "cb5077b943831678bad5fcbefc19b802dcc052c1bf98201e03f340457f44e4f8",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00040",
      "source_sha256": "81aab7083dccfd63d162c6a75960f08945b9bab87f1530607523bbf36bbc20f8",
      "ko": "메아리"
    },
    {
      "id": "da1502a:T00041",
      "source_sha256": "eb2aa8b7e2f2ee15338e49ce11a0f55565ce060505fe6556ed7808b5b6c84c28",
      "ko": "로 울려 퍼지는 우주가 / 뇌수에 유폐된 우주가 / 츄잉껌 포장지에 싸인 우주가―― 만화경처럼 "
    },
    {
      "id": "da1502a:R00011",
      "source_sha256": "f79689c871eb9126ca631efd7f53aaffd4b0c30b270c7723351a65a18aa88e50",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00042",
      "source_sha256": "d2cfc0f18cdf602e2bcf786fd70465e78caad60de49258f9817d7dce26e64a05",
      "ko": "반짝반짝"
    },
    {
      "id": "da1502a:T00043",
      "source_sha256": "998461b6dac834e39a14c0efb14798371b8ee20b6ca3bf6fe275bae5c51bfd20",
      "ko": " 빛나며, 어지러이 "
    },
    {
      "id": "da1502a:R00012",
      "source_sha256": "0cf0ed09d997fd73f27bdd6a92778a0388d38b4dc12c24b69b152aafa1c24987",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
