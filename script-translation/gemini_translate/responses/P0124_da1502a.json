      "source_sha256": "471b2d253aac6f48f141a5a34fd914885d4c89a1906b55c0ae9d63230a8ae6b6",
      "ko": "비쳐"
    },
    {
      "id": "da1502a:T00047",
      "source_sha256": "8afffa00e4d68542b320a2c35028a1eb513edc1bd2f1125ee1362ea01cb3f176",
      "ko": " 들고 "
    },
    {
      "id": "da1502a:R00014",
      "source_sha256": "0cf0ed09d997fd73f27bdd6a92778a0388d38b4dc12c24b69b152aafa1c24987",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00048",
      "source_sha256": "4f011eaa1b9e20ca17fd35a269197b191e830ad0071fad300db0d7ad572b9856",
      "ko": "덧없이"
    },
    {
      "id": "da1502a:T00049",
      "source_sha256": "af28183c67dd3522b042774d2665d4e134f81986427d25db9c11f312bfb6d8cf",
      "ko": " 스러져 간다."
    },
    {
      "id": "da1502a:T00050",
      "source_sha256": "7013f309235652045047327445d5896dc342c8acc3ad640c1b60cfdaf6c52bb8",
      "ko": "「――우주다! 무한히 존재하는\n평행우주 그 자체를 결계로 삼아,\n혼돈의 뜰을 봉인한 거다!」"
    },
    {
      "id": "da1502a:T00051",
      "source_sha256": "1b6b564e8c4c5bc2af352c51eb35f58a525b5ef652526746818ddba014818495",
      "ko": "우주 안에 "
    },
    {
      "id": "da1502a:R00015",
      "source_sha256": "01e8855e938d5a455078911d78d4c1153e977690a4df6eed3affa0bea10c342d",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00052",
      "source_sha256": "779ef63fafeb4ccae5c9e40021471349972c234fc0d4b70654950e06c66896db",
      "ko": "갇"
    },
    {
      "id": "da1502a:T00053",
      "source_sha256": "dee6af2f22a5fe4e6db7e6385156ff313f94ebe011bbede063098971c9b0acc2",
      "ko": "힌 우주의, 우주 안에 갇힌 우주 안에 갇힌 우주의, 우주 안에 갇힌 우주 안에 갇힌 우주 안에 갇힌 우주의…… 무한의 "
    },
    {
      "id": "da1502a:R00016",
      "source_sha256": "eee8c515d80eb68ae982cdde5ead80e318097cc4930b023ae14a65e7964aa29c",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1502a:T00054",
      "source_sha256": "31b2e9509e4add1d0be9fccb83002f2ab7b8af89f7795ce251e79d517f825811",
      "ko": "아득한 끝"
    },
    {
      "id": "da1502a:T00055",
