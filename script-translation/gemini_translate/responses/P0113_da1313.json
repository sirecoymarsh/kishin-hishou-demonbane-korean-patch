      "source_sha256": "6e3a7f8da5b6f558220fcf851d7f5a141b596b0b12304cac31b145929326aa07",
      "ko": "다가오고 다가오고 밀려드는 기계기계기계기계기계기계기계기계기계기계기"
    },
    {
      "id": "da1313:R00010",
