    },
    {
      "id": "da0606:T00021",
      "source_sha256": "29a5c1e0830fa32c35ece8a434231639b595c77e5b627393aaa4c141cc5ad784",
      "ko": "――데몬베인의 "
    },
    {
      "id": "da0606:R00008",
      "source_sha256": "16f0743d46c22e155e0fc89238475a58824ee7da3dae1b471f1b1b1f7f2e9d07",
      "ko": "콕핏",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00022",
      "source_sha256": "8dc579f738134d3d31e9335b1a315dc0209a159fbbf38881e98c9a5e26d4e552",
      "ko": "조종실"
    },
    {
      "id": "da0606:T00023",
      "source_sha256": "3834e63f2e78ba23d91c670ee491da680bfb248120bba792362626920add9b8b",
      "ko": "에."
    },
    {
      "id": "da0606:T00024",
      "source_sha256": "dda78d4a850a212200c02e246136a213f6ddb8e7275c638d17b401619f029a22",
      "ko": "「갈 수 있겠냐, 알?」"
    },
    {
      "id": "da0606:T00025",
      "source_sha256": "4d3d409bc8ac99ec59a36bc1829936eec0c9532717816f1b19918b9c16800fec",
      "ko": "「그래…… 할 수 있다」"
    },
    {
      "id": "da0606:R00009",
      "source_sha256": "795ea4682715f83fac4782a340277ca62c2c813af33366bfa2dda9939ae8651d",
      "ko": "내비",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00026",
      "source_sha256": "902940b9c6dfae994447b1b46d9971b76bb260524efffa42c3e0a3254790a07e",
      "ko": "마도서용"
    },
    {
      "id": "da0606:T00027",
      "source_sha256": "3b2e79bc719379948597cf4be8f8c76f1b3296e6089b0a355b1d9b49e5503647",
      "ko": "의 "
    },
    {
      "id": "da0606:R00010",
      "source_sha256": "453ba1172e5534742e6f28a5d8bed221fc1939e489e7976ab48c85122944056e",
      "ko": "시트",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00028",
      "source_sha256": "558b79c6c662065e5a267000ab65c0d5fb06a5ab8c75a4d98bec547f2112016b",
      "ko": "조종석"
    },
    {
      "id": "da0606:T00029",
      "source_sha256": "54a6fb13a934aeb76d7be5bda766fcdab796644e2e094293f888d1c65f26d6cd",
      "ko": "에 앉아, 알은 조용히 고개를 끄덕였다."
    },
    {
      "id": "da0606:T00030",
      "source_sha256": "46ba536c490dee0df86df766f81603848db0d317936f8a0b0e3c7be1dc8e94e8",
      "ko": "기분 탓인지, 지금까지보다 더 차분해 보였다."
    },
    {
      "id": "da0606:T00031",
      "source_sha256": "9b1557e1bb789cedefc7b7140945fe44720e5c352b0d341d545481bb2e98d728",
      "ko": "「고통이 가라앉는다…… 힘이 넘쳐흐르는 것 같구나. 역시 싸우는 우리에게는 이곳이 어울려」"
    },
    {
      "id": "da0606:T00032",
      "source_sha256": "a86602d24a21f7716ac06ed28ede829d2bdf41c292fc895674062d0c4f03f71d",
      "ko": "「아아…… 그렇군」"
    },
    {
      "id": "da0606:T00033",
      "source_sha256": "df619c795476097682dfb6be8c10455ce8cfc20876fd2cdc667a5becd4ac20ec",
      "ko": "「이쪽도 준비 완료예요.\n　다이쥬지 씨, 알 아지프!」"
    },
    {
      "id": "da0606:T00034",
      "source_sha256": "6a4bbf149b01ba25a3e87df49ef4dc0bc760dc72ee21d036e0e4ca4abf0781f8",
      "ko": "「아가씨!?」"
    },
    {
      "id": "da0606:T00035",
      "source_sha256": "a73755e6e31d6a22a76ebc2db01f7af0bf02cb27995951db4009e600aee64c88",
      "ko": "「꼬맹이!?」"
    },
    {
      "id": "da0606:T00036",
      "source_sha256": "9f7ac329d480896f31c46974ccef467d86078ddb64b3df62e0c07b31fc90cef9",
      "ko": "돌연 모니터에 끼어든 것은, 사령관 복장을 한 아가씨다."
    },
    {
      "id": "da0606:T00037",
      "source_sha256": "cf8ca95cb66727faeb60980d86d1c85655e78465664e0fa74ad39891ab0fd3fc",
      "ko": "물론, 그것은 본래 있을 수 없을 터인 아가씨의 모습이다."
    },
    {
      "id": "da0606:T00038",
      "source_sha256": "6c0c3d32bb196d57d25c2128b63602332a5e215719ccb23fd435bf8593e18f9f",
      "ko": "「아가씨『도』……인 건가?」\n\n　라이카 씨와 마찬가지로――아가씨 또한 그 싸움의 기억을?\n\n　과연 아가씨는 상냥하게 미소 지었다."
    },
    {
      "id": "da0606:T00039",
      "source_sha256": "d85e0c37014803ec58a67e64a3e491939701d81031c59dfb3ad8ff7df5cbaa3e",
      "ko": "「다이쥬지 씨. 알…… 두 분은 단둘이서, 이렇게나 무거운 『"
    },
    {
      "id": "da0606:R00011",
      "source_sha256": "224189fa92c38c72063b083858e042a3ac2c3ff7030bf34485cd14a47dcb56c5",
      "ko": "메모리",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00040",
      "source_sha256": "0691ee1aaaeb18f7c4c03afbedbb3b3132dd15f96dc88372130bfc48b8ecd4c3",
      "ko": "마음"
    },
    {
      "id": "da0606:T00041",
      "source_sha256": "f519d60ef76140d657aed19ab8d8d786f2e0310c65e4ab8b4ee7ffef56552a99",
      "ko": "』을 품고 계셨던 거군요」"
    },
    {
      "id": "da0606:T00042",
      "source_sha256": "9767bf393484a304cef770464a655b7224f4e97ac99792e0fbff734595e62310",
      "ko": "「하지만 지금의 저희라면,\n　두 분을 서포트할 수 있어요!」"
    },
    {
      "id": "da0606:T00043",
      "source_sha256": "661a1fb03f3703c932d6cb2f3380f0031bef6e3ffbcef2fd19add7473e91d011",
      "ko": "「갑니다, 여러분!」"
    },
    {
      "id": "da0606:T00044",
      "source_sha256": "db5eb99aa2f6ee95c90a70723c869a6e7bac33859de4e246701ee80d089d6176",
      "ko": "「알겠습니다, 아가씨…… 아니, 사령」"
    },
    {
      "id": "da0606:T00045",
      "source_sha256": "d22abb90e7c8848be94ffc339af7ca464ff99fc6ac21ea70b4ffeff240898b4c",
      "ko": "「신기하네…… 처음 보는 "
    },
    {
      "id": "da0606:R00012",
      "source_sha256": "088462f65b7e8bc00db9fd7d87cf33cea200daceb9094dea9dc851b2a1851090",
      "ko": "시스템",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00046",
      "source_sha256": "ae109331ef7728d53f6a4f94c05af52b4c97bc32703b370b4eaaaf3a58bd58b1",
      "ko": "장치"
    },
    {
      "id": "da0606:T00047",
      "source_sha256": "77a06bb193c369b51b869f9eb927cfdc62360e70603547c75a4d24f3f3d43b03",
      "ko": "인데도, 사용법을 "
    },
    {
      "id": "da0606:R00013",
      "source_sha256": "67972a2c8e5ecaca4ffebbe487dfef1e8db028ebd1569d5547e4e96156650b7c",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00048",
      "source_sha256": "5cb53e3de202ecbb3e7fd1e3903cb9bc748413ba5caaf013960008b13708f3f5",
      "ko": "알"
    },
    {
      "id": "da0606:T00049",
      "source_sha256": "b5405c08287756fa3a568a7cf19da5056261a6b5b856161e94fd71b2a117857c",
      "ko": "겠어」"
    },
    {
      "id": "da0606:T00050",
      "source_sha256": "2856c7cb89dc3f702355c49f9dabe1e5e260b8bec4fd16bc4490cc72870ad68f",
      "ko": "「어쨌든, 『저 마더퍼커 같은 촉수 몬스터를 쳐죽여라』라고 지시만 내리면 되는 거죠, 그렇죠?\n라져입니다아~!」"
    },
    {
      "id": "da0606:T00051",
      "source_sha256": "51582899a5000a7e1f040e1d3b298e96235076e8bc885355d1e148ea44fd3365",
      "ko": "「――이쪽도 문제없습니다」"
    },
    {
      "id": "da0606:T00052",
      "source_sha256": "c8e1d478405a327058d7c77a487e9e09f059524c165f9efccf9a5b5de0407d41",
      "ko": "「――보시다시피, 이쪽은 만반의 준비가 끝났어요.\n　마음껏 싸워주세요!」"
    },
    {
      "id": "da0606:T00053",
      "source_sha256": "60caac0f1444172ea5ddf598de1f8690b583e8e99c457f7a67f5b45546075a7f",
      "ko": "「……알!」"
    },
    {
      "id": "da0606:T00054",
      "source_sha256": "ab94bb935862f53cf43bb89b4401e07d24504b0d183c6cbb7f7a6a0c8a8ba476",
      "ko": "「……음!」"
    },
    {
      "id": "da0606:T00055",
      "source_sha256": "ba1ccffae6e255329a4474171505cf680da643a4be8a05bc0dcc7c0dd8a9aaf7",
      "ko": "결여된 것은 아무것도 없다."
    },
    {
      "id": "da0606:T00056",
      "source_sha256": "5027d8fbc5c96e5833022b0fb255d77ea2d5ca2c398024dfc736adc940a18d49",
      "ko": "내가 있고, 알이 있고, 모두가 있다.\n\n　그렇다."
    },
    {
      "id": "da0606:T00057",
      "source_sha256": "4cb9589a4a5ef313b75974c2b0e5c665ef56f52325122ac9c007ccd6ef2e301a",
      "ko": "데몬베인은 변함없이 우리를 맞이해 준 것이다."
    },
    {
      "id": "da0606:T00058",
      "source_sha256": "1d6d4845e47a105d8fcc6d3995b3a165a6242480fdb6acbcb746ea430083eac4",
      "ko": "「가라――――앗!\n　　　　　　　데몬베인!」"
    },
    {
      "id": "da0606:R00014",
      "source_sha256": "3665dae4aa325fd92f5051dc596d6484b7a0ac974ed0c51c6f053c499fb954f2",
      "ko": "마기우스",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00059",
      "source_sha256": "497da8a40b63248877795b608460ea8b429cbb806628acdc355ed560db9990f5",
      "ko": "의지"
    },
    {
      "id": "da0606:T00060",
      "source_sha256": "427566260604d16fb4a900e51400dd5dfac2ef749901179434735f0d0008d100",
      "ko": "와 "
    },
