      "source_sha256": "3673ecbb67987ccd787529d6f0cd014d2193ef8306dc2708308fbb83e8f0e656",
      "ko": "그 "
    },
    {
      "id": "da0606:R00017",
      "source_sha256": "77231c034f8731c6d5cd91a1ff47185a3915290e7c1692cd689f125430a4b7eb",
      "ko": "트리니타스",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00066",
      "source_sha256": "0bc70873212c720e5d68a9838bfce8f9e690665e583de0a4a40b03d8221a6ded",
      "ko": "삼위일체"
    },
    {
      "id": "da0606:T00067",
      "source_sha256": "02b6cece6ebafa3c6619517e0a02cef07064b62e24e37aea26b87331f5832fba",
      "ko": "를 통해, 우리는 『"
    },
    {
      "id": "da0606:R00018",
      "source_sha256": "faad4663917e9f697861dd8f8351f4b75876f086445f4735d2e147048b1329b2",
      "ko": "데몬베인",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00068",
      "source_sha256": "2ac8144e433bacbb2822cf92205a3440a571a127ecf3c67f21ef8798d9f7a27c",
      "ko": "마를 쳐부수는 자"
    },
    {
      "id": "da0606:T00069",
      "source_sha256": "9c1aeb7b67a3866364a48693b268135cf2290cb6076694d98529b8729dd7f2a6",
      "ko": "』가 된다!\n\n　파괴로보를 덮치고 있던 웨이틀리가, 시선을 이쪽으로 돌렸다."
    },
    {
      "id": "da0606:T00070",
      "source_sha256": "0dcb3a3be776d76d7b6ae157d02d7f1f2f49e657da530ec1578fdba3303d1899",
      "ko": "부풀어 오른 거대한 눈동자가, 증오의 "
    },
    {
      "id": "da0606:R00019",
      "source_sha256": "33439ddb0f66823471fcc299d5d5f75aa20a1470e5cc0d7bb310dbe5b1609c6d",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00071",
      "source_sha256": "1f828276b921aa107500f6e9151332285e78eb3c2fd98302107a1970352e1742",
      "ko": "색"
    },
    {
      "id": "da0606:T00072",
      "source_sha256": "5f945f18ef58973201d6df7fc5efda98c57557242b02afb62e8023aacc832b54",
      "ko": "으로 "
    },
    {
      "id": "da0606:R00020",
      "source_sha256": "06ccdf06d7529eb8ab462d5628f9b0cdd5d3cee7ca2b1522ef47f21fdd8f14d2",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00073",
      "source_sha256": "1fddc5a562ee1fbeb4fc6def7d4be4911fcdae4273b02ae3a507b170ba0ea169",
      "ko": "타"
    },
    {
      "id": "da0606:T00074",
      "source_sha256": "b93db20ce337e0e4e4a0331c917b21b3a99ecb7375a3d3237b7c8d0ce73d0f6e",
      "ko": "오른다."
    },
    {
      "id": "da0606:T00075",
      "source_sha256": "0a3df25183841e609f011228ce8c5feb5eae84191e9585e557261ba08a0cd66f",
      "ko": "「그래, 네놈 상대는 이쪽이다. 덤벼봐라, 괴물 녀석」"
    },
    {
      "id": "da0606:T00076",
      "source_sha256": "79331f80b099c37b0fca31301118d59221784de05d983e8b0e07eeceb464de7e",
      "ko": "「ＩＡＡａａａａａａａ！」"
    },
    {
      "id": "da0606:T00077",
      "source_sha256": "0860d0e355810166cfa9ab933553bd71e5d9431060f1e64c7abffe3608328aea",
      "ko": "무수한 촉수가 모든 각도, 있을 수 없는 각도에서 덮쳐왔다."
    },
    {
      "id": "da0606:T00078",
      "source_sha256": "3d9fd6e61866fffe01025fa04f7cb392b467be1d92d3729b4b499d4bc68cace0",
      "ko": "칫, 어설퍼!"
    },
    {
      "id": "da0606:T00079",
      "source_sha256": "c5739476ef667d38376f88450c096bf5c77c18cb68d84ad75d094372a5acf405",
      "ko": "「――――!?」"
    },
    {
      "id": "da0606:T00080",
      "source_sha256": "e286383dc4ab1e01d9b12c08fe051da2e07a1a85fba10196966aa1ed3deac549",
      "ko": "망설임 없이 정면으로 돌진한다."
    },
    {
      "id": "da0606:T00081",
      "source_sha256": "1f25bfaac1f541b90a93647012e476c492e8de2f931694fcc0053cbc8e1e22e9",
      "ko": "그 앞에는 시야를 가득 메울 정도의 촉수."
    },
    {
      "id": "da0606:T00082",
      "source_sha256": "6e12a284fa892bcba9af7fc86489d2b3e3f0c52f151d07d9a85c1c5bb00899e4",
      "ko": "「그런 걸로, 데몬베인을――!」"
    },
    {
      "id": "da0606:T00083",
      "source_sha256": "82af2266860137beddca42502062c9a194f4f749f9f14cb8d4dd14bd35675803",
      "ko": "「막을 수 있을 줄 알았더냐! 가소롭다!」"
    },
    {
      "id": "da0606:T00084",
      "source_sha256": "aac0b6d1775f6541539b13ffe3f45489dc5478b90d4bb5fa9a7901263304284f",
      "ko": "「ＥＥＥＥＥＥｙＡＡａａａａＡＡ――――ａａＡ!?」"
    },
    {
      "id": "da0606:T00085",
      "source_sha256": "7806ae2b76b072021039d7eb36405fe0c931143520413504eb0d0629636250e0",
      "ko": "촉수 무리가 일제히 거품을 일으키며 증발한다."
    },
    {
      "id": "da0606:T00086",
      "source_sha256": "d41c307e52c4f72ad1c9df0a2348642982cdd718b0a24913b89528f47d19edf6",
      "ko": "순식간에 소환된 마총 크투가가 뿜어내는 총탄."
    },
    {
      "id": "da0606:T00087",
      "source_sha256": "bac0737e184f02f246f043163429b4be537c822c87263e42637f3f228246cbc2",
      "ko": "폭렬탄에 봉인된 술식이 "
    },
    {
      "id": "da0606:R00021",
      "source_sha256": "f82ba0b74230562fc2c2c595d971367df84eed2e2861c036af2c6d71381e077f",
      "ko": "플라스마를",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00088",
      "source_sha256": "c720ed7c0f262983f754755d85e763074fa16c9a673ddaa56e96bd814a1b8e9e",
      "ko": "초고열을"
    },
    {
      "id": "da0606:T00089",
      "source_sha256": "31d1ba1d5e7e1878af65b5b4a674dc6e1df9776d3ba6f51e68f7a9e272e2fcbd",
      "ko": " 해방하여, 촉수를 불태운 것이다."
    },
    {
      "id": "da0606:T00090",
      "source_sha256": "1383c89bf4417ed8fa8f04833ca8c6a6142d018607a3fca7e4356529e4ee18da",
      "ko": "「단쇄술식 1호 티마이오스――」"
    },
    {
      "id": "da0606:T00091",
      "source_sha256": "305676180659c842da8f15b1b8152f6e35a9d449107e8be7d0e8e96d6b7d310e",
      "ko": "「2호 크리티아스――」"
    },
    {
      "id": "da0606:T00092",
      "source_sha256": "b398e8c0362f2eb307f3e04cb1da9e4ff2f1140e2ca85c67203524389a0eb58b",
      "ko": "섬광 속으로 곧장 뛰어든다."
    },
    {
      "id": "da0606:T00093",
      "source_sha256": "8c8a06ef755ec31e998b0ec2b7f8b7df20ee20845418c1fd4e92d68be719d811",
      "ko": "하얀 시야를 넘어선 곳에는, 웨이틀리의 흉악하게 맥동하는\n거체가 있다."
    },
    {
      "id": "da0606:T00094",
      "source_sha256": "c6aeffecf932a7facaca060adbce8a1ec139ea5d99cc702fe4b94fc65bd7b8e6",
      "ko": "「「해방!」」"
    },
    {
      "id": "da0606:T00095",
      "source_sha256": "b281019b830375ae2404b291b6cdd565d21b27c12d88d521a63ddea6a870c3d2",
      "ko": "해방된 "
    },
    {
      "id": "da0606:R00022",
      "source_sha256": "8d5605b4122616865962e36f4d11187ccff02b4ffe9b55c62b2a579ed3eb6ba6",
      "ko": "실드가",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00096",
      "source_sha256": "ed1aeb2f2211575f62d7a013a4959bbabe029ced9577a9684338c56cd01bb72d",
      "ko": "기관이"
    },
    {
      "id": "da0606:T00097",
      "source_sha256": "f61baed82d9a4f58cd4d6f76d646cc040b608d2adaf2551f6e32442afbb75655",
      "ko": " 뿜어내는 에너지, 이 사악한 자에게 처박는다!"
    },
    {
      "id": "da0606:T00098",
      "source_sha256": "86a475eefe3f61855ae5d280b0ea35b54f721a5c1d01eea42211bd122d2693c7",
      "ko": "「아틀란티스 스트라이크!」"
    },
    {
      "id": "da0606:T00099",
      "source_sha256": "b79c5ff4f19f9685649853b064adc66b546bbd59b641a89a7ac25b16a1edba23",
      "ko": "「ＡＡ아ＡＡａａ＆아％（’Ｕ아￥ＡＡ!?」"
    },
    {
      "id": "da0606:T00100",
      "source_sha256": "e2370b2f528dc8dcd32519ef81e97f5777e09e20a4a90a717abcc9dc2b28d5eb",
      "ko": "「호와아아아아아아아~~~~~앗!?\n　로보오오~~~~~~~~~~앗!?」"
    },
    {
      "id": "da0606:T00101",
      "source_sha256": "0f2c9fa0de1804a0bb95d4a4c67cfc4d3b8d798169379f6a48a75c966c56a14d",
      "ko": "함께 뭔가 다른 것도 날려버린 것 같은 기분이 들지만,\n지금은 신경 쓰지 않는다."
    },
    {
      "id": "da0606:T00102",
      "source_sha256": "82d898b1c5fc2dadc8b5be0b714eedff0690f96f3abef5ce79a68603e2245539",
      "ko": "「……뭐, 괜찮겠지」"
    },
    {
      "id": "da0606:T00103",
      "source_sha256": "b299afb0241290207a246838eeca30c926d13ea297bed64fa081c491237d939b",
      "ko": "「대사를 앞둔 소사다」"
    },
    {
      "id": "da0606:T00104",
      "source_sha256": "8a88d86db1f46e1ee9b0096745f625672e27b57c85109d05aa0b43e5824cde6d",
      "ko": "그것보다도――"
    },
    {
      "id": "da0606:T00105",
      "source_sha256": "5038bb97c09071ad3034b0ecffd053a69d9d4847efd8954f6883b58ab38183d4",
      "ko": "「위그나위이…… 이그나위이……」"
    },
    {
      "id": "da0606:T00106",
      "source_sha256": "577b6c2b1ec2aa77de139c83d19068f48388fea6c0f6e77a0d28ed750ae2b9fd",
      "ko": "웨이틀리 쪽으로 돌아선다."
    },
    {
      "id": "da0606:T00107",
      "source_sha256": "7b3782eb410b01feaadd5fa4c7d49731fb2cf44cc43f597457b8d6b1cd19d52f",
      "ko": "날아간 웨이틀리는, 거품 이는 점액을 온몸에서 뿜어내며 괴로워하고 있다. 몸부림치는 흉악한 고깃덩어리."
    },
    {
      "id": "da0606:T00108",
      "source_sha256": "c5739476ef667d38376f88450c096bf5c77c18cb68d84ad75d094372a5acf405",
      "ko": "「――――!?」"
    },
    {
      "id": "da0606:T00109",
      "source_sha256": "f5a464fa00de96484122c2cd9e1ad09fa905305738ad3ae31202f7b5ee69c122",
      "ko": "하지만, 내가 보고 있는 바로 앞에서, 웨이틀리는 "
    },
    {
      "id": "da0606:R00023",
      "source_sha256": "7614c4c21215aaafb751bbdca726c2be0e7df42e4c437476947512685c828bb0",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00110",
      "source_sha256": "389a3f1a1da19814193679df29fa9c6643e49e2ced1372ef84ac856a56e6eae7",
      "ko": "안개"
    },
    {
      "id": "da0606:T00111",
      "source_sha256": "fb86ce0aaafff37bb44fbe09a5318835ec30cd7d2b036f55daa20904e004ea17",
      "ko": "처럼 희미해져 간다."
    },
    {
      "id": "da0606:T00112",
      "source_sha256": "cab0f40be4b1a91ea14bc63c3b54e746790fabec5a63075122701dcfeffecfb2",
      "ko": "그 정도의 거체가 흔적도 없이, 소멸했다."
    },
    {
      "id": "da0606:T00113",
      "source_sha256": "142ab238bf04952b07659a15efb84b360719c6363064f6c63799a8cfe04d68b7",
      "ko": "「……사라졌어?」"
    },
    {
      "id": "da0606:T00114",
      "source_sha256": "d3ce71ea9f9b3292972df906b6e599a88da2ec4b4977683841c013ce49fb7564",
      "ko": "「놈은 본래 불가시의 괴물이다.\n　거기에 차원을 넘나드는 힘까지……\n　골치 아프겠구나」"
    },
    {
      "id": "da0606:T00115",
      "source_sha256": "c5739476ef667d38376f88450c096bf5c77c18cb68d84ad75d094372a5acf405",
      "ko": "「――――!?」"
    },
    {
      "id": "da0606:T00116",
      "source_sha256": "e6c8144e9baa9889adc7752f9fe45285e8ea5fc279c7fc510c892ef00a4684f3",
      "ko": "그때, 웨이틀리가 사라진 부근에서 마력의 폭발이 일어났다."
    },
    {
      "id": "da0606:T00117",
      "source_sha256": "b03c744a8a1d3d70cfafe23311bfd3a2f1882166a02cc67d33778b22d5d29f12",
      "ko": "터져 나오는 마력의 파동은 공간으로 퍼져나가, 주문의 문양을 그리며, 현상으로서\n현현한다."
    },
    {
      "id": "da0606:T00118",
      "source_sha256": "07dc241c2f9993d97c5fefc01e2363f4e8a68df2ffc41af5ce03c32ec60830aa",
      "ko": "빛의 입자가 넘쳐흘러, 공간을 가득 채운다."
    },
    {
      "id": "da0606:T00119",
      "source_sha256": "c7885814d569eef03dee2fdff62cf8bf0a01180c3587b3c1a0dd7c0656e15c18",
      "ko": "은은한 빛의 안개 속에, 거대한 그림자가 떠오른다."
    },
    {
      "id": "da0606:T00120",
      "source_sha256": "952183f403a0fee58348cd328efe50f5e7dddbf0909249720ed77839ae441fbb",
      "ko": "「이위위위위이위위위위위……!」"
    },
    {
      "id": "da0606:T00121",
      "source_sha256": "a0bb6f96b7cc527d62e6aa8723f6f65690c5f9a0f9b2e751081af53f9c48299d",
      "ko": "「어이, 또 "
    },
    {
      "id": "da0606:R00024",
      "source_sha256": "2b826478f59c2fee27b95e2947c15a7596908f21671c84c287eaf3dfdfa9128b",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00122",
      "source_sha256": "0a02e0d09dc74cad30d832a411825bc5fbf4b5af04baf6aff8cee8af35cb38dd",
      "ko": "나타"
    },
    {
      "id": "da0606:T00123",
      "source_sha256": "7bcf1444050a196134d441f2ba5f6384d9ed17f5623f5884fdbb3455b210b2ed",
      "ko": "났다고?」\n\n　빛의 안개 속에서, 웨이틀리는 뭍에 올려진 물고기처럼 헐떡이며,\n펄떡거린다.\n\n　마구잡이로 휘둘러지는 촉완이 빌딩을 쓸어 쓰러뜨려 간다."
    },
    {
      "id": "da0606:T00124",
      "source_sha256": "f9a5a240b4af6c44be192dc957f1ec79b9eefbdb9c5c50f3b42a6cc3631025a0",
      "ko": "「이 술식은……!」"
    },
    {
      "id": "da0606:T00125",
      "source_sha256": "baf7e1c4dc91b3cbd22ba75d4708867e510e757ca7f20a4a1dfc8bf5bb149a94",
      "ko": "「이븐 가지의 가루약――영질과\n물질을 결합하는 "
    },
    {
      "id": "da0606:R00025",
      "source_sha256": "b3c2d0ad57639105ec806b0ba5d0251fe5c09f15bf86de3523641fa75b566a12",
      "ko": "파우더지",
      "ruby_action": "keep"
    },
    {
      "id": "da0606:T00126",
      "source_sha256": "c1ea9debcb4ac8df7664a4e5f8817911704eace705defd43ae314634902b5f02",
      "ko": "가루약이지"
    },
    {
      "id": "da0606:T00127",
      "source_sha256": "fce5cc7168b5d499a298a18826be2841a2e88043fccd9a88a1d75fadac9d58ba",
      "ko": ".\n내 술식 앞에서 본질을 끝까지 숨길 수 있는\n이형 따위는 존재하지 않네」"
    },
    {
      "id": "da0606:T00128",
      "source_sha256": "7c847fd5993509f52ea30809d5dc381c35c4e226bf8cf1102aed3eb933ca9286",
      "ko": "「아미티지 영감님!」"
    },
    {
      "id": "da0606:T00129",
      "source_sha256": "b22ac4542fb14ab5300a28b11385931ee5f69f5442a35824554c6e333414c62c",
      "ko": "「……설마 더니치의 괴이와,\n　다시금 "
    },
    {
      "id": "da0606:R00026",
      "source_sha256": "b2cfffd46caf7b91ea98e26404d4b1a667606041b48a0a1fe1d7d8ae871c16b7",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da0606:T00130",
      "source_sha256": "aa7b526258ccf22287414bb35b25964072d9e495fdec0a8c10d93a12fc92cb61",
      "ko": "마주하"
    },
    {
      "id": "da0606:T00131",
      "source_sha256": "d41a8e6d528e1aa3d13c7dede073d386e26f7bb8bb66c21a870a6a0a4b203c6d",
      "ko": "게 될 줄이야」"
    },
    {
      "id": "da0606:T00132",
      "source_sha256": "9c006e8a9757636bf1b0bf21f1acc6dc261a64e0776125082bd2528688043d48",
      "ko": "「헨리 아미티지!」"
    },
    {
