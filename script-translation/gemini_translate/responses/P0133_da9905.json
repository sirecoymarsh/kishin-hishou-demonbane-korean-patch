{
  "schema": "khd-gemini-response-v1",
  "packet_id": "P0133_da9905",
  "model_id": "Gemini 3.8 Flash (High)",
  "records": [
    {
      "id": "da9905:T00001",
      "source_sha256": "2360a51999d1d581001fd43a0cd0225af2294d6bf81b9580307c68465ec30f94",
      "ko": "――이 몸은, 꿈을 꾸고 있었다."
    },
    {
      "id": "da9905:T00002",
      "source_sha256": "5b3409f8113c1bfcfa19cbf4f8bb7ecf625aeafa4d969c069497069087257046",
      "ko": "붉은 소녀에게 집어삼켜졌을 때, 이 몸은 알았다."
    },
    {
      "id": "da9905:T00003",
      "source_sha256": "e03948d6968376d6aea9a5bf2545fca342b0036429226f711182929c9a866152",
      "ko": "소녀가 꾸는 커다란 악몽――소녀를 꿰뚫는 "
    },
    {
      "id": "da9905:R00001",
      "source_sha256": "8d621c5b39c3b3fc1c4421e71d03d95bf11db997394b0b9280a4826168a392f6",
      "ko": "우츠로",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00004",
      "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
      "ko": "공허"
    },
    {
      "id": "da9905:T00005",
      "source_sha256": "9758ee8f9fbe04b6cdd8cbf39368b62bbec99e3879cc5ccb0cc3f5141ea95411",
      "ko": "를."
    },
    {
      "id": "da9905:T00006",
      "source_sha256": "f4b5e43edfe5066c61be0998fd1cc056df55a025b49df8b9184aee67af1c5cf8",
      "ko": "그것은 이 몸의 마음 깊은 곳――"
    },
    {
      "id": "da9905:R00002",
      "source_sha256": "dd49c90c749c0290514ec024f80f8e86f487751b21c7c3e48e0fb8d165f95a7b",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00007",
      "source_sha256": "389bbac1b256d36df12ea23e0ea5db3f3b5a4242c671c915091732e62596b8b4",
      "ko": "어둡"
    },
    {
      "id": "da9905:T00008",
      "source_sha256": "7badd246fe5d5bc8d3eb88705028076330f185cf44cb0e384229a05105c00df1",
      "ko": "게 가라앉은,"
    },
    {
      "id": "da9905:R00003",
      "source_sha256": "d47cdb8e1de285e17ef9cd6ed4b3743a1a9991dafd00df66d1e25c9a9bec676a",
      "ko": "클리포트",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00009",
      "source_sha256": "5b2ac5f8e8337c07ff588fba092bfea092c194b565ea0b1753d197a0bb99eed3",
      "ko": "심연"
    },
    {
      "id": "da9905:T00010",
      "source_sha256": "4cb6a8beb8349ec2497148d9965d4213c10dfc7e39bb1fed00b9788d75ae41f8",
      "ko": "의 기억을 불러일으킨다."
    },
    {
      "id": "da9905:T00011",
      "source_sha256": "f180a60658c85077496e0c090b1bd40e10174566f2958ecc1b1fd927b92d8a49",
      "ko": "시간의 "
    },
    {
      "id": "da9905:R00004",
      "source_sha256": "999ddfa4f4fa7e0c8e6ea05a6567841890f053d61237d248c51ce83feab4475f",
      "ko": "케이지",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00012",
      "source_sha256": "66d804b0e4c062f434582ff17bdfba1c813b279ea479596167185c7462c8fccb",
      "ko": "감옥"
    },
    {
      "id": "da9905:T00013",
      "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
      "ko": "."
    },
    {
      "id": "da9905:T00014",
      "source_sha256": "8fbba0d5a05db12b8bbeca5ade4ece6d82d544d3a18fe0e2987a592b1325b812",
      "ko": "세계의 모든 것은 움직이고, 흘러가고 있다."
    },
    {
      "id": "da9905:T00015",
      "source_sha256": "8040eca338bca867cdaac2638917678f3d1141483e727b13f68088ec3483b62f",
      "ko": "이 몸만을 내버려 둔 채."
    },
    {
      "id": "da9905:T00016",
      "source_sha256": "eba500eb3efee982161d6c3e58fec705c59de474ab5a940e56f6f5672cbb6e85",
      "ko": "손가락으로 어루만진 것은, 모래가 되어 무너져 내렸다."
    },
    {
      "id": "da9905:T00017",
      "source_sha256": "bd302a450a8568d4e7fc2acc1e34194a4c18a306d1f47bc2216148924947d24f",
      "ko": "숨결이 닿은 것은, 티끌이 되어 흩날렸다."
    },
    {
      "id": "da9905:T00018",
      "source_sha256": "8e4f996538883a7811310671451ef00639405b37c63ea50712323e02954274f3",
      "ko": "바라보고 있던 것은, 재가 되어 사라져 갔다."
    },
    {
      "id": "da9905:T00019",
      "source_sha256": "22c272af6b0cbaec01ff5ea4e00856587a64c055dc584e92b204e1b917e8768d",
      "ko": "모든 것이, 이 몸의 곁을 스쳐 지나갔다."
    },
    {
      "id": "da9905:T00020",
      "source_sha256": "969a46562fb4dc9c14afdbcc345392b6a531e21e7cf9e033dd5270d15390f499",
      "ko": "흘러 지나갔다."
    },
    {
      "id": "da9905:T00021",
      "source_sha256": "98f1cb57d7239f1d2914fed7432693bad14f9348858252a1ffd54101eaae80ff",
      "ko": "이 손에는, 아무것도, 남지 않는다.\n\n붉은 소녀／가지지 못한 자로서의 "
    },
    {
      "id": "da9905:R00005",
      "source_sha256": "8d621c5b39c3b3fc1c4421e71d03d95bf11db997394b0b9280a4826168a392f6",
      "ko": "우츠로",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00022",
      "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
      "ko": "공허"
    },
    {
      "id": "da9905:T00023",
      "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
      "ko": "."
    },
    {
      "id": "da9905:T00024",
      "source_sha256": "aaa132c6524de55188c73d75c2ed7cf4ccbcdfe090da7dbd68e7c63c49f509b8",
      "ko": "이 몸    ／얻지 못한 자로서의 "
    },
    {
      "id": "da9905:R00006",
      "source_sha256": "8d621c5b39c3b3fc1c4421e71d03d95bf11db997394b0b9280a4826168a392f6",
      "ko": "우츠로",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00025",
      "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
      "ko": "공허"
    },
    {
      "id": "da9905:T00026",
      "source_sha256": "20407a597727ce8bd25a7f4ec36abbc20c160f3ab21b19e381c610a7f7699c72",
      "ko": ".\n\n　본질이야 다를지언정, 이때 우리는 분명히 하나의 "
    },
    {
      "id": "da9905:R00007",
      "source_sha256": "8d621c5b39c3b3fc1c4421e71d03d95bf11db997394b0b9280a4826168a392f6",
      "ko": "우츠로",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00027",
      "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
      "ko": "공허"
    },
    {
      "id": "da9905:T00028",
      "source_sha256": "026b751cf22bb2582019a9b4f4534726291039fd9f2450994a1dabe635f1eb9d",
      "ko": "로 이어진 모녀였다."
    },
    {
      "id": "da9905:T00029",
      "source_sha256": "0883a320846a92223b34729040bbf719f7d3f6690d6fcd76c42c26a0149de6ac",
      "ko": "그것은 몹시 시리고 괴로운――"
    },
    {
      "id": "da9905:T00030",
      "source_sha256": "47cd3b01ee9e6e85f736cc0ef1ce2034ce2a2aed9b8de6a425ad49e2ca57f8c8",
      "ko": "하지만, 몹시 고요하고 평온한 "
    },
    {
      "id": "da9905:R00008",
      "source_sha256": "3e7ca97dd222dfece75cc1b0e619438b0296dd7b6db45fe8ff3627464f181e69",
      "ko": "세계",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00031",
      "source_sha256": "54235654a51428db8c3b374d475d5ef2e1f214b2001b284005c0eb8cfa33ca64",
      "ko": "일체감"
    },
    {
      "id": "da9905:T00032",
      "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
      "ko": "."
    },
    {
      "id": "da9905:T00033",
      "source_sha256": "72bace88accd599188f3f67c8419f27aa8064639af58d98f49b3fbe7235a48f8",
      "ko": "정적의 허무와, 평온한 절망."
    },
    {
      "id": "da9905:T00034",
      "source_sha256": "69d9269c9620d6c8aef62cbcfdd6272e9d184eff953bf2d51070f9ba3247189a",
      "ko": "그런 것에서 안식을 얻을 수 있다면, 그보다 편한 일은 없으리라."
    },
    {
      "id": "da9905:T00035",
      "source_sha256": "1e777e99359e28f094c36e837d5a1bb761cf17185f4dcd3cc88ea884e3282a28",
      "ko": "그리, 생각한다."
    },
    {
      "id": "da9905:T00036",
      "source_sha256": "0be5c97bac75f2ff3bb2b36f9e4d5e46abd054ec5332b020eddf7d3a3ef7c3b5",
      "ko": "어쩌면 예전의 이 몸이었더라면, 이대로 모든 것을 무 속에 "
    },
    {
      "id": "da9905:R00009",
      "source_sha256": "01e8855e938d5a455078911d78d4c1153e977690a4df6eed3affa0bea10c342d",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00037",
      "source_sha256": "779ef63fafeb4ccae5c9e40021471349972c234fc0d4b70654950e06c66896db",
      "ko": "가두"
    },
    {
      "id": "da9905:T00038",
      "source_sha256": "3193f32eefc7a5b09d72237405d1b5315911fee6f2d2d60d5d75f2164274276b",
      "ko": "었을지도\n모르겠지만――"
    },
    {
      "id": "da9905:T00039",
      "source_sha256": "1feac14ccbfd65666d6321300abd4707888a05d97b8cd98a234f1b3aa07bfe4e",
      "ko": "――그리고, 이 몸은 눈을 떴다."
    },
    {
      "id": "da9905:T00040",
      "source_sha256": "f63e338a9fae446f20ae3d105f2318d7c4d921eff8749a1d9931f4bd94dd5f65",
      "ko": "「…………」"
    },
    {
      "id": "da9905:T00041",
      "source_sha256": "1a8870710722ffeb0f2997fae64348fe1ee1003d451285f49b27f3197aa9d34e",
      "ko": "아무래도, 아직 한밤중인 모양이다."
    },
    {
      "id": "da9905:T00042",
      "source_sha256": "a4dac525b0c663d9d29f3bc86715bdd4b8f395a9a768410a7d5db242ef747f90",
      "ko": "이상한 시간에 눈을 떴군―― 하고 느끼는 것을 보니, 이 몸도 제법 인간의 삶에 물든 모양이로다.\n\n　과거의 이 몸에게 있어, 잠이란 투쟁과 다음 투쟁 사이에 생겨나는 "
    },
    {
      "id": "da9905:R00010",
      "source_sha256": "ba80432f97de9f6a6ec89f04b3c57394720a23de31f53275fb15432cff07dca9",
      "ko": "블랭크",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00043",
      "source_sha256": "f0bf4574ce25c131e712b6ec184d1a8b1d6dc3d3f634f0f8d0deeb261ddd2051",
      "ko": "공백"
    },
    {
      "id": "da9905:T00044",
      "source_sha256": "70aa77065a7a8f0bcce9af868dfdef1883e72d1048b1af589edfddb421293b59",
      "ko": "에 지나지 않았다.\n\n　그것은 오늘과 내일을 잇는 잠―― 하루하루를 살아가는 인간의 잠과는\n거리가 먼 것이었느니라.\n\n　헌데 지금의 이 몸은, 이렇게 오늘과 내일의 틈바구니에서 선잠을 자고, 게다가 옅은 꿈마저 꾸고 있구나――"
    },
    {
      "id": "da9905:T00045",
      "source_sha256": "eb258f79ba31d44d20bf944373616f8f887a9e5b4f48bb5de2fab17287b9909c",
      "ko": "「……읏」"
    },
    {
      "id": "da9905:T00046",
      "source_sha256": "b78abb67ac95115cbd09e9fd854c4b62594c4c1432860c47e1c8c86a701fdecd",
      "ko": "문득, 가슴에 "
    },
    {
      "id": "da9905:R00011",
      "source_sha256": "8b39767716925121d5db3226123f618d5a8c70cd2b3bda53470904929eec1ce7",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00047",
      "source_sha256": "a65e2f92bc8757e8ea9a5f2bce92ee0f3e279f1f5917c4325a1ed86c2efc6f51",
      "ko": "통증"
    },
    {
      "id": "da9905:T00048",
      "source_sha256": "e0dbbdad6cbec26dda0f230467b264fd77a00c12eaf6774f9d2fd2e86af1212c",
      "ko": "이 스쳤다."
    },
    {
      "id": "da9905:T00049",
      "source_sha256": "6629be95d93c2c2b71a77087d6e81374863dfd8e60a15d4b68463dfda976770f",
      "ko": "가슴에 뻥 뚫린 구멍이 난 것만 같은――"
    },
    {
      "id": "da9905:T00050",
      "source_sha256": "36a50b2b00403841a2ec22ec3dadc1d510a87c488a3d74119a162b2c2de0bfcc",
      "ko": "그런 안타까움."
    },
    {
      "id": "da9905:T00051",
      "source_sha256": "7150de7fa20d3febb82eb828519c271a7f6c538e23b62451f422d28a58d8614d",
      "ko": " 쓸쓸함."
    },
    {
      "id": "da9905:T00052",
      "source_sha256": "5a7f0328fceed65e44c3d8e7ebaff7326cd97c303ffcb9502ea3f6771f70ab45",
      "ko": " 허탈함."
    },
    {
      "id": "da9905:T00053",
      "source_sha256": "4aa6462c317812e8d2074fdee0bcc25deba76868dfe29d80c02819352074bd69",
      "ko": "이유는 알 수 없다."
    },
    {
      "id": "da9905:T00054",
      "source_sha256": "2a3f957e7b6eebf8bf5a714f3e622d38d2b6119237b2aed4cc567f9f91059b7a",
      "ko": "꿈의 잔재를 아직 떨쳐내지 못한 것일까."
    },
    {
      "id": "da9905:R00012",
      "source_sha256": "660f16d75d4eaaf3b370867396ddcecd8b4da058c529e6316deff700ecdccafb",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00055",
      "source_sha256": "a9cd525db318f43791bcf8b25adf15fd77187c35be738deeba23766709f41b7c",
      "ko": "공허"
    },
    {
      "id": "da9905:T00056",
      "source_sha256": "d9573f2c8ec0303998d6966eac99a11cbe0c636546d5f63d5e14910038a7fac1",
      "ko": "한 마음을 채우고자, 이 몸은 그 남자의 모습을 찾는다."
    },
    {
      "id": "da9905:R00013",
      "source_sha256": "f061b481065158a52a51b79f9e47bbff13bc3108e8dc0c39d1c05a1f1464e7bc",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00057",
      "source_sha256": "035a97b3b8a6d9af8366314e9ce40a04e3747738aae5e565253e2c6283927c07",
      "ko": "그 녀석"
    },
    {
      "id": "da9905:T00058",
      "source_sha256": "42f590e13a87eb6971d6a1affd1c522f8689e72c399387fa0e5a8a72ae8c0bf8",
      "ko": "은 바로 곁에 있었다.\n\n　알고 있던 일이다."
    },
    {
      "id": "da9905:T00059",
      "source_sha256": "14a9133af9f9bcda6cfc413e09bac4951e02b7277b2006d800705ca2dc8b53e3",
      "ko": "다이쥬지 쿠로는 언제나, 이 몸의 곁에 있느니라."
    },
    {
      "id": "da9905:T00060",
      "source_sha256": "776650ec4fa367f7f3c14846062e508c681a6d981f020bfe0e901aabadc54028",
      "ko": "우리는 언제나 함께 있도다.\n\n　알고 있는 사실이다…… 하지만, 그럼에도."
    },
    {
      "id": "da9905:T00061",
      "source_sha256": "225b43329c968f257d0fcee7c9697cdc7eb0b8c7d08b90203876e31eb58f2397",
      "ko": "「……으음」"
    },
    {
      "id": "da9905:T00062",
      "source_sha256": "2b8e7bb768a53065599707d7f1922208307a2842f0b3de968a5a29a0d81ced44",
      "ko": "이렇게 이 몸의 마음도 모른 채, "
    },
    {
      "id": "da9905:R00014",
      "source_sha256": "c37722083338b384a7f1069d8aab34c8589fa1996b20a1e1e01b317d5e0b0b98",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00063",
      "source_sha256": "baa68833b020ec06886f4d7553d069b9fc503eee14d47df2dda450cb4540c6bd",
      "ko": "태평"
    },
    {
      "id": "da9905:T00064",
      "source_sha256": "158d7d53784f752ef6c54b55ac5b19857ff7f9659c16e3f4fc5d2cbc2da3dc5d",
      "ko": "하게 잠들어 있는 모습을 보고 있자니\n공연히 부화가 치미는구나.\n\n　――벌이다."
    },
    {
      "id": "da9905:T00065",
      "source_sha256": "bdbc428b422040d96997821015113b446aaea0ee0cbbf63bc3f739bb53d9a8b4",
      "ko": "「음…… 으그…… 으음……」"
    },
    {
      "id": "da9905:T00066",
      "source_sha256": "e84f7fbd4b52ff1dd8068dffbbdcb7c38ae7d136ceeb5a08b506c019dedb5fc3",
      "ko": "와락 안겨, 쿠로의 가슴에 머리를 파묻는다."
    },
    {
      "id": "da9905:T00067",
      "source_sha256": "e2bd7952ed38b481de42d2f83ce951610f807e88673be870fb04db768689e226",
      "ko": "무거운 것인지, 숨쉬기 괴로운 듯 "
    },
    {
      "id": "da9905:R00015",
      "source_sha256": "deda529a4dc28501295310054412bc9c14ef911e108166ac7cd1d2bc9c6bbcdc",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00068",
      "source_sha256": "1d4eae53e32d8db026edcee1cf96a94556abaede0858b218a4afb7fb537ff1a1",
      "ko": "가위"
    },
    {
      "id": "da9905:T00069",
      "source_sha256": "42815495c5a855eaeb78d27bd8646fa5c12a023b07ed463242cf515ce0e43f4e",
      "ko": "눌리고 있지만 알 바 아니다."
    },
    {
      "id": "da9905:T00070",
      "source_sha256": "d85f326722a9a5a4d236c8f7e6f1d130df00dca204cc631ff698322780059107",
      "ko": "눈치도 없이 자고 있는 그대가 잘못한 것이니라. 이 몸은 이 몸 마음대로 하겠다."
    },
    {
      "id": "da9905:T00071",
      "source_sha256": "4308e375c947c2fd81b65a801ff4417801126a2d066da8b1dcbb77940f5d7e7f",
      "ko": "「응……」"
    },
    {
      "id": "da9905:T00072",
      "source_sha256": "d2b89198bfa35d1c5b3604683456489e2f1eb5463966efa40e87f15db82e6299",
      "ko": "쿠로의 온기."
    },
    {
      "id": "da9905:T00073",
      "source_sha256": "0758b7f98ebbca2809e0edf921d2cb372a9414762b643740106e1feb9481bbd0",
      "ko": " 쿠로의 숨소리."
    },
    {
      "id": "da9905:T00074",
      "source_sha256": "7d8eff066f6dc9ce104e3ecf358c728726f3ec0a21e9af2eebf69381b42f197c",
      "ko": " 쿠로의 고동."
    },
    {
      "id": "da9905:T00075",
      "source_sha256": "dde1f335fbc1fa83033af0bd9ac1468c5ba8109979c440a443bad51096c6d213",
      "ko": "쿠로의 존재를 강하게, 더없이 강하게 느낀다."
    },
    {
      "id": "da9905:T00076",
      "source_sha256": "daec34842eab314c1e8784c97f857946f9d51d3465b1192a36f0d7625b47270a",
      "ko": "그것을 놓치지 않으려는 듯, 매달리듯이 끌어안는다.\n\n　한동안 그러고 있으면서, 이 몸은 교회에서의 일을 되새기고 있었다."
    },
    {
      "id": "da9905:T00077",
      "source_sha256": "7369beaca16a67c4ff2c44f720f2d5ee8cd678fb1e1ecbbe123b5d8c9216f7a7",
      "ko": "교회 청소는 결국, 해질녘까지 이어졌다."
    },
    {
      "id": "da9905:T00078",
      "source_sha256": "bcaf72aa804b0a03497902e3c0c816825ce9bd2720cc92187e7e65f364ead749",
      "ko": "돌아온 라이카는 우선 놀라워하더니――"
    },
    {
      "id": "da9905:T00079",
      "source_sha256": "3e178fba5a47e1af27861c49d8adce1cb4c9e95dcfa0268cb8edbe83be374ef0",
      "ko": "아이들의 성장을 기뻐하며, 그 행동을 칭찬했다."
    },
    {
      "id": "da9905:T00080",
      "source_sha256": "199eafa8d4363b30b59f67122e3e4e397185ea45891035383c50938873069c82",
      "ko": "아이들은 자랑스럽게, 조금은 쑥스러운 듯 미소 짓고 있었다.\n\n　아이 이상, 어른 미만."
    },
    {
      "id": "da9905:T00081",
      "source_sha256": "16c0507e7dc9171d65b248c8044f7440d7d4a4fefd78bd14ff9faefad48d318a",
      "ko": "그런 모호한 시간을 보내는 자에게만 허락된, 저 특유의 표정.\n\n　그렇다."
    },
    {
      "id": "da9905:T00082",
      "source_sha256": "938fb8430b6e59799daa983a12f028793943df750ce4ac66bf18d88fb5e59d98",
      "ko": "저 아이들은 성장하고 있다.\n\n　머지않아 키도 지금보다 훌쩍 자라,\n　눈 깜짝할 사이에 이 몸을 앞지르겠지.\n\n　그리고 자신의 "
    },
    {
      "id": "da9905:R00016",
      "source_sha256": "24d7ad880d9dd274550d7dc2480caa180cce47c07ed273889cc65934ddc93c74",
      "ko": "힘",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00083",
      "source_sha256": "5c5374dd958bcb79c1fe83a1b7a6c25df36603eec36f15f180a916af2022cee1",
      "ko": "능력"
    },
    {
      "id": "da9905:T00084",
      "source_sha256": "fb374c8f61f5ab341b48062e9f88bf7eeb20d399025b85770944a9e1a0b80206",
      "ko": "을 인정하고, 그것을 다루기 위한 지혜를 익혀, 어른이 되겠지."
    },
    {
      "id": "da9905:T00085",
      "source_sha256": "5fdf43b1fbeea25e5c2f660ef5b831807d1b4041fcc8dae252804869ff13421a",
      "ko": "아이는 자라, 어른이 되고, 언젠가는 아이를 낳는다."
    },
    {
      "id": "da9905:T00086",
      "source_sha256": "9bb59cfec960cc067ca6c7bf26df4b19c5437935ccd17b894953689b86732a9f",
      "ko": "그것이, 섭리."
    },
    {
      "id": "da9905:T00087",
      "source_sha256": "47b6e4e56962ef324926b4103e7b02ad08e20780ef575642ae5d0ef5d900e3f3",
      "ko": "사람의 살아감은 끊어지지 않고, 생명의 "
    },
    {
      "id": "da9905:R00017",
      "source_sha256": "94f5801ec32f7aa6bfc6b59c8e170ecd2cb921827598e0d2456fd34766a40e8b",
      "ko": "링을",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00088",
      "source_sha256": "e2c37ece4e87bd64148ff47558d6d6de38391fce6c45583734688cf4da511300",
      "ko": "고리를"
    },
    {
      "id": "da9905:T00089",
      "source_sha256": "8336e2653d321077685013487d44511ee09080f109b327b8770543a7f67d768c",
      "ko": " 이어 나간다."
    },
    {
      "id": "da9905:T00090",
      "source_sha256": "985c6edc71c01200b2adab93ed3b1c2e49dcde568b4287774f0bb355058ec6e0",
      "ko": "그렇다면, 이 몸은?"
    },
    {
      "id": "da9905:T00091",
      "source_sha256": "0bb05564a87977c06cb0de86a56d289c4ffa714e1d009b6890a2f41a1c3e1558",
      "ko": "쿠로 일행이 그리는 인간의 이야기를,\n　이 몸은 어디에 서서 지켜보게 되는 것일까――"
    },
    {
      "id": "da9905:T00092",
      "source_sha256": "291a64ba64e0a69c50f41e7c04fbc2954f59dda8518cc820835b23136c109af8",
      "ko": "「…………읏」"
    },
    {
      "id": "da9905:T00093",
      "source_sha256": "530bad04f061c2aded6ad87c79065819185450a22386bc1d265edb7a8582d313",
      "ko": "또다시, 아픔으로 가슴이 욱신거린다."
    },
    {
      "id": "da9905:T00094",
      "source_sha256": "dd1ddde49e0c109d70855c738768862452f3f63f85e1ea26538ad129cfc275a9",
      "ko": "이 몸은 더욱 강하게, 쿠로를 껴안으며……"
    },
    {
      "id": "da9905:T00095",
      "source_sha256": "8a5a0b41beb1a5000f706be5ef53a4b19365b2565251535cfb5e35ac0dd08efc",
      "ko": "「알」"
    },
    {
      "id": "da9905:T00096",
      "source_sha256": "9b0aacef283bab669edb30bdab8c9a4da5d56065bb157152aa37ee311b30e9d1",
      "ko": "「햣……!?」"
    },
    {
      "id": "da9905:T00097",
      "source_sha256": "4365b4c7737b838943d7d719a7761fba69583be335dcbc64d61f03d703bf36f7",
      "ko": "갑자기, 쿠로의 팔이 이 몸의 어깨를 둘렀다."
    },
    {
      "id": "da9905:T00098",
      "source_sha256": "dc77da451d3f1c47220b750c5350e1d0be19ec86e073a591fa354b8dd6892a60",
      "ko": "불쑥 품으로 끌어당겨진다."
    },
    {
      "id": "da9905:T00099",
      "source_sha256": "dc54a5bf8574e5961e3227acf590154925a0305ad8054fb35ea250a22e6398ac",
      "ko": "두 사람의 몸이 밀착된다."
    },
    {
      "id": "da9905:T00100",
      "source_sha256": "ad4f4164b529b627d0bd9993c535cba7e33f6c88dd4b1e5da3b14960dfc1aaf7",
      "ko": "「기, 깨어 있었던 것이냐……?」"
    },
    {
      "id": "da9905:T00101",
      "source_sha256": "9a2ab57dd55de469e51cd7c83040f13a10825562de0c5e64c888b912be124a0e",
      "ko": "「방금 막, 눈을 뜬 참이야」"
    },
    {
      "id": "da9905:T00102",
      "source_sha256": "54195e14e969b5264decaf023fa797ede1ad0b54cfc28eb176989e5617c2b7d0",
      "ko": "「……그, 그러냐」"
    },
    {
      "id": "da9905:T00103",
      "source_sha256": "ef25c050fa9b3a9fee15d0a5212f34dcebbe0d73662289ac4d53746b6ecf7579",
      "ko": "「……………………」"
    },
    {
      "id": "da9905:T00104",
      "source_sha256": "ef25c050fa9b3a9fee15d0a5212f34dcebbe0d73662289ac4d53746b6ecf7579",
      "ko": "「……………………」"
    },
    {
      "id": "da9905:T00105",
      "source_sha256": "78a26cc88cf104df7974a5aa7d80b93f62032dfc629ab8652430ff14c44d590a",
      "ko": "그대로 서로, 침묵에 빠지고 만다."
    },
    {
      "id": "da9905:T00106",
      "source_sha256": "63fb31423d801220884d59a0ea2b46bf4bb86845b770b9f08f78edc129c69e49",
      "ko": "어딘가 진정되지 않는, 어색한 듯, 간지러운 듯한 공기."
    },
    {
      "id": "da9905:T00107",
      "source_sha256": "9c7125029e1f16da86213f781e97e158014c67d3a1bdd1c1b437cb3d020924fa",
      "ko": "「……알」"
    },
    {
      "id": "da9905:T00108",
      "source_sha256": "109699adb5c059807d783e3ceba90c40585d9b81720a3eb4f6ff55e4ce048554",
      "ko": "침묵을 먼저 깬 것은, 쿠로 쪽이었다."
    },
    {
      "id": "da9905:T00109",
      "source_sha256": "0847778486e76c24c270314146f3c97aa7a22e4d2f548053c45fcb4ba4a2d8dc",
      "ko": "「……뭐지?」"
    },
    {
      "id": "da9905:T00110",
      "source_sha256": "5968d0737a1d4abcfd4569cff60cbe67181235438daf6cd78f877c7db6f812d4",
      "ko": "「무슨 일 있어?」"
    },
    {
      "id": "da9905:T00111",
      "source_sha256": "26db2f4f1fc59b884a63ef62e4ac46c94c7f65af8d7e6b9a1d5409e6d7cb7bb5",
      "ko": "「무슨 소리를……」"
    },
    {
      "id": "da9905:T00112",
      "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
      "ko": "「"
    },
    {
      "id": "da9905:R00018",
      "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
      "ko": "・・・・・",
      "ruby_action": "keep"
    },
    {
      "id": "da9905:T00113",
      "source_sha256": "7a7677929f7422dd8fe66dd2302cd716a6131350f9a99c71f41316418927e019",
      "ko": "얼버무리지 마"
    },
    {
      "id": "da9905:T00114",
      "source_sha256": "d93a835d0f2787bcb1a759ad3a1b8fbea56d742d0b99720dbbb9ea8ace1926f8",
      "ko": "」"
    },
    {
      "id": "da9905:T00115",
      "source_sha256": "85cbd0c3f325f4aaf0eac7feb3bc8f9f156e08692f0147a09f3c12eae0a2c820",
      "ko": "「……읏」"
    },
    {
      "id": "da9905:T00116",
      "source_sha256": "77f1a412daa7a477d06efb8016873a4257a8c2d8dee2f065c16fd5e9d8794153",
      "ko": "「네 속셈 따위 손바닥 보듯 훤히 다 안다고」"
    },
    {
      "id": "da9905:T00117",
      "source_sha256": "880d029bd51941331e37763088c55b60b85bebebe87f94cf7d4f16629fccaaa3",
      "ko": "「……당해낼 수가 없군」"
    },
    {
      "id": "da9905:T00118",
      "source_sha256": "091f063b9732413bc64dc50d233dad3b6d27b56348bd619561f23950e8f932a9",
      "ko": "「그래, 피차일반이지」"
    },
    {
      "id": "da9905:T00119",
      "source_sha256": "ddcf3996f56ca0e74f15e5e93d18a4e717e1517fb41346e1b9252839f19c3a94",
      "ko": "「………………」"
    },
    {
      "id": "da9905:T00120",
      "source_sha256": "f99fae474369cb9ba3180c9fe6cf617acbb130d2720c27d0f0226b768457f1c7",
      "ko": "「사람이란 변하는 법이로구나」"
    },
    {
      "id": "da9905:T00121",
      "source_sha256": "3496f39532f367ebdb50b0342c8258ac1afd64b436bd4b8805a459b7d988fa93",
      "ko": "「뭐야, 뜬금없이?」"
    },
    {
      "id": "da9905:T00122",
      "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
      "ko": "「"
    },
    {
      "id": "da9905:R00019",
      "source_sha256": "8fd8930d383bb15d73a331e6c5e4d183d33d015c40bcb911aabd42053624bbc2",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00123",
      "source_sha256": "6097acd81ca6fffa661a44092243e8e9a66d50668b64b24de6554969bf6dda22",
      "ko": "아이"
    },
    {
      "id": "da9905:T00124",
      "source_sha256": "dfad131bb737618cb090169f8a7219fe0744e107dde6e2508c3d9f93c19badd4",
      "ko": "들의 생각을 하고 있었느니라」"
    },
    {
      "id": "da9905:T00125",
      "source_sha256": "a107a51baca5a1bbb33ab3400eb8b83e95828128b010026ef680bdb751590651",
      "ko": "「아아, 그렇군…… 그래, 맞네.\n　언제까지나 『꼬맹이』인 건 아니니까」"
    },
    {
      "id": "da9905:T00126",
      "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
      "ko": "「"
    },
    {
      "id": "da9905:R00020",
      "source_sha256": "8fd8930d383bb15d73a331e6c5e4d183d33d015c40bcb911aabd42053624bbc2",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00127",
      "source_sha256": "6097acd81ca6fffa661a44092243e8e9a66d50668b64b24de6554969bf6dda22",
      "ko": "아이"
    },
    {
      "id": "da9905:T00128",
      "source_sha256": "61ec84c300101675c53ed1a791edf3e69755c4aae89711eaaeb06cace5b104f9",
      "ko": "들뿐만이 아니다」"
    },
    {
      "id": "da9905:T00129",
      "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
      "ko": "「……?」"
    },
    {
      "id": "da9905:T00130",
      "source_sha256": "b1af225dc8d63ae1514b5233b3ae2c35e0ca296ba1209eda2902979e6ca8be59",
      "ko": "「라이카도, 하도의 계집아이도 예전과는 다르다」"
    },
    {
      "id": "da9905:T00131",
      "source_sha256": "895dc562f71244cfaf724379a0e0eb8f160bb9ac478fac30d3e2bf4a021a360c",
      "ko": "「……그래.\n　　지난번 사건으로 다들 변했지.\n　　우리는 다시 데몬베인과――」"
    },
    {
      "id": "da9905:T00132",
      "source_sha256": "1ba28ebf07a11a3da9a2188d0ed0a1c02929f2a93261b0c5bae6616593c59cad",
      "ko": "「그대도 마찬가지다, 쿠로」"
    },
    {
      "id": "da9905:T00133",
      "source_sha256": "db1f0d380f2ba20e36506e4807098001294d5166a370ebdc81807c38601c2e2d",
      "ko": "「어?」"
    },
    {
      "id": "da9905:T00134",
      "source_sha256": "1d60b47e2b8c817e1d7d78c3ba51515f7b23f3db896bb1133f8add32d0aa8fa1",
      "ko": "「사람은 변해 가느니라. 인간 세상은 움직이고 있다.\n　머무르는 일 없이, 끊임없이, 줄곧, 계속해서.\n　사람의 삶이 이어지는 한――」"
    },
    {
      "id": "da9905:T00135",
      "source_sha256": "b269e4a0914bdda584d38bae797de9bd901ca4c150034266a3e4f1b22e3ddd7e",
      "ko": "「"
    },
    {
      "id": "da9905:R00021",
      "source_sha256": "a12b45ddd51618c93d318b0b2069c43712e98171f262a3a9b3343f7fdf871223",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00136",
      "source_sha256": "4a7e9a926adb81a1034a66d43be5b106dad8726f418cd43623ed90a3acbecde2",
      "ko": "마찬"
    },
    {
      "id": "da9905:T00137",
      "source_sha256": "d20fb555280556befb86a009f8615e07cf447bb9b4da01da4c3dcaf060ecb532",
      "ko": "가지잖아」"
    },
    {
      "id": "da9905:T00138",
      "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
      "ko": "「……?」"
    },
    {
      "id": "da9905:T00139",
      "source_sha256": "c9386f24ed47159462b6095b24de2054bcd24a73f03fd20ca7f03ae2fb83caae",
      "ko": "「너 역시, "
    },
    {
      "id": "da9905:R00022",
      "source_sha256": "a12b45ddd51618c93d318b0b2069c43712e98171f262a3a9b3343f7fdf871223",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00140",
      "source_sha256": "4a7e9a926adb81a1034a66d43be5b106dad8726f418cd43623ed90a3acbecde2",
      "ko": "마찬"
    },
    {
      "id": "da9905:T00141",
      "source_sha256": "4a98ab46afa799e1120a4cea544048046b2691502504341c00a0fd46250a45ef",
      "ko": "가지잖아」"
    },
    {
      "id": "da9905:T00142",
      "source_sha256": "aef16587241deefec3c728def2c7b0948eadfc0be062358b45b6b7325c8f9910",
      "ko": "「――――――」"
    },
    {
      "id": "da9905:T00143",
      "source_sha256": "455da1a39520f98e79af7a9cedded8aad710499eaab46c3a4008824ac35e5766",
      "ko": "어째서, 이 남자는――"
    },
    {
      "id": "da9905:T00144",
      "source_sha256": "4845911ca7dffea6518bc11864a3c65252c40c86f81dfb1a0e53c24e8721ba27",
      "ko": "「너 역시, 『사람의 삶』 속에 있잖아」"
    },
    {
      "id": "da9905:T00145",
      "source_sha256": "ed0915627eb76acdafc8a02432cf133a282b3090a9756c0b38afc2f878d9c74b",
      "ko": "어찌 이런 말을, 이리도 당연하다는 듯이 내뱉을 수 있는 것인가――"
    },
    {
      "id": "da9905:T00146",
      "source_sha256": "cb5b3b69ff3e48af2799a6b7ea68da25fa1498ea5966e587f1c51a850fb0e09f",
      "ko": "「그렇……구나」"
    },
    {
      "id": "da9905:T00147",
      "source_sha256": "30174c27055dafe0828f7b465a88fc3f0d82ff4de662f52b0e338d4d572d6b1b",
      "ko": "그것은 잔혹한 말이로다.\n\n　어둠의 세계에 살아가는 자를, 빛의 세계로 끌어내려는 말."
    },
    {
      "id": "da9905:T00148",
      "source_sha256": "42391656605fb55025b457b02b259fb7f46ae529f33d3a60983ec98d898fea7a",
      "ko": "사람이 아닌 자를, 사람의 세계에서 끌고 다니려는 말.\n\n　그토록 잔혹하면서도, 더없이 다정한 말이로다."
    },
    {
      "id": "da9905:T00149",
      "source_sha256": "2dd245b73ff945490b913ac6da05bf6b071c2327271f38c18145300876fcd1d8",
      "ko": "「……쿠자쿠 이야기지?」"
    },
    {
      "id": "da9905:T00150",
      "source_sha256": "a0faa5b31b269fc248e6dee648b8dcde59ad4944b2a939e36b0082854a48c974",
      "ko": "「어……?」"
    },
    {
      "id": "da9905:T00151",
      "source_sha256": "9a776ef889bff5ef3033fb911a21e5eaea9a06bbb718e079323b0a3294981d6c",
      "ko": "「네가 이것저것 쓸데없는 생각을 곱씹고 있는 원인」"
    },
    {
      "id": "da9905:T00152",
      "source_sha256": "d282983164512fcc7b272646245f1d235a18451a8ac465a6b54c5df74bed1556",
      "ko": "「…………글쎄, 어떠려나」"
    },
    {
      "id": "da9905:T00153",
      "source_sha256": "79c8b3c4339fdb2fe43a5a22d9cf5442f240b4d4ca3340d22653a72ce8ef9f9a",
      "ko": "깊이 생각해 본 적은 없었다."
    },
    {
      "id": "da9905:T00154",
      "source_sha256": "46b45f8c557fd8918aef46f494d5b1b545d7d380cf4985b1224f4552fd259e00",
      "ko": "아니, 깊이 생각하는 것을 피하고 있었을 뿐인가.\n\n　기사의 소년과 붉은 소녀―― 두 명의 쿠자쿠."
    },
    {
      "id": "da9905:T00155",
      "source_sha256": "75677a7e51f9c4589cd8731480f130d794f09353baf7020007745f24e3dd0899",
      "ko": "미래의 세계에서 찾아온, 이 몸과 쿠로의 아이."
    },
    {
      "id": "da9905:R00023",
      "source_sha256": "b3240903b6495213199662445c04d0df4b438f83cc1cb21bb961409692e6371a",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da9905:T00156",
      "source_sha256": "1df0f52452060e9b83b9cf41cb502beda2e3e5ab2264599c6f6ed417f3fcfe7e",
      "ko": "그"
    },
    {
      "id": "da9905:T00157",
      "source_sha256": "14e2f75c1432b7401f98e72b0fe4902dd450dc0a172cc11df023c9e9c07f3fb7",
      "ko": " 아이들의 일에 관해서는, 지금도 마음이 정리되지 않는다."
    },
    {
      "id": "da9905:T00158",
      "source_sha256": "098bd4dd7d6c41fbf32992eac7e1aad1c51b47d019bd01a0da0d3fb434eec5db",
      "ko": "수많은 마음이 복잡하게 뒤섞이고, 어지러이 소용돌이치고 있다."
    },
    {
      "id": "da9905:T00159",
      "source_sha256": "07c4c0b8bcd5460ca75e04171bc8ad9ba16bc37440a2a7c0d033f7d2ee21f34b",
      "ko": "그것은 아마, 쿠로도 마찬가지리라.\n\n　그 아이는, 우리에게 있어 무엇이었을까."
    },
    {
      "id": "da9905:T00160",
      "source_sha256": "c3bf8df8b8eea73b93856e5cf9c85eb3fd400b614a7051d3f1a1e00ae78a6f01",
      "ko": "무엇을 의미하고 있었던 것일까.\n\n　마음을 헤아리기도 전에, 그 아이는 떠나버리고 말았다."
    },
    {
      "id": "da9905:T00161",
      "source_sha256": "31debb448d524a0deb3a597b8b8941574c625d7c4bce5e22127f0de107fab592",
      "ko": "마치 꿈처럼."
    },
    {
      "id": "da9905:T00162",
      "source_sha256": "258131184a126b3240ee3b9f00882dfdda17ef5fde5aadc644e8d2a4a63dc5bc",
      "ko": "「……그런가. 그런 것이었느냐」"
    },
    {
      "id": "da9905:T00163",
      "source_sha256": "95946b1a5cbbfa29d101296d39e130823f82c9b11523723f295c9e6fe178af5f",
      "ko": "「……?」"
    }
  ],
