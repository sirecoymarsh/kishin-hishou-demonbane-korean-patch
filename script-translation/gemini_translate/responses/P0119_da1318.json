    },
    {
      "id": "da1318:T00058",
      "source_sha256": "c31447b2a5eb1552deefa787cc64e00d84b52a923f5cafaea34cba65ca40bbe3",
      "ko": "수은"
    },
    {
      "id": "da1318:T00059",
      "source_sha256": "38630d5c12e1700059a941e0e743f5d4b2af63c66f379ec73103d9c0ae02297d",
      "ko": "／"
    },
    {
      "id": "da1318:R00017",
      "source_sha256": "008a95982298dde9f1a59cbb4a3c39799cb7453d910d3a392293eddba28e5d02",
      "ko": "솔리드",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00060",
      "source_sha256": "d94ededfdd015613317a5e2d858e7ed49acf3314d52c7f77ae219458fd34ae25",
      "ko": "강철"
    },
    {
      "id": "da1318:T00061",
      "source_sha256": "115d7b7a4c80c31d05a68ce29ccc4082b55fd979f0463b10c8db673417305623",
      "ko": "의 틈바구니를 오가는, 지극히 불안정한 상태에 있었다.\n\n　기신과 사신이, 인간과 사악이, "
    },
    {
