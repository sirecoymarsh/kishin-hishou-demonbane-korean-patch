      "source_sha256": "c115cf42b5ec3be398ef89df64fdf3ff2a76256b484581c3933b4e58a7438a8e",
      "ko": "파손 부위에서는 "
    },
    {
      "id": "da1318:R00005",
      "source_sha256": "0fc256cd359e43981a6ccd05cca823e78bcbc9db7a58d048c6f11d9cc6a430d7",
      "ko": "아조트",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00014",
      "source_sha256": "c31447b2a5eb1552deefa787cc64e00d84b52a923f5cafaea34cba65ca40bbe3",
      "ko": "수은"
    },
    {
      "id": "da1318:T00015",
      "source_sha256": "a2205aba9863137378b6e3009b143ab7fbca96e06f055a9520d513f197a21575",
      "ko": "의 피가 폭포처럼 쏟아져 나온다."
    },
    {
      "id": "da1318:T00016",
      "source_sha256": "5a05180365ba6a8af07128e6b70f28db0d49f1146e6362cc20b5107f8d7bb38c",
      "ko": "「하지만, 어쩐다……? 어떻게 쿠자쿠를 안에서 꺼내지……」"
    },
    {
      "id": "da1318:T00017",
      "source_sha256": "1e591cc951d2d491f52a309af3a4f00ef2b4b46b3be691c8f18b0872e5c9719c",
      "ko": "「쿠로…… 저것을」"
    },
    {
      "id": "da1318:T00018",
      "source_sha256": "9a6e9e44aba556863da533e3b7b4919c5b12feb000e0243bb0d91092850b1375",
      "ko": "「――읏!? 뭐야 저건!?」"
    },
    {
      "id": "da1318:T00019",
      "source_sha256": "e454a369b53a8add0f45c61939881607c827ed75348e28e61c7e2c13dd7c0bed",
      "ko": "「혼돈이……」"
    },
    {
      "id": "da1318:T00020",
      "source_sha256": "5e696371811a8b8b23f1ad51499421321769220ff056b541b3869086e60b94f7",
      "ko": "「……"
    },
    {
      "id": "da1318:R00006",
      "source_sha256": "905b0efb2d86b7b8a5e1a663618fe8fda3615a10bcebe5973ba115f428f9c0e2",
      "ko": "・・・・・",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00021",
      "source_sha256": "b3bccabdaf6835ec9a3cad6bf4e177427292b0a766fc03a654e9c7aec8a4f37e",
      "ko": "무너지고 있다"
    },
    {
      "id": "da1318:T00022",
      "source_sha256": "062a345406a788f4f1ba0555be713fcc7477ace21a879f5ad79be71013968c4f",
      "ko": "?」"
    },
    {
      "id": "da1318:T00023",
      "source_sha256": "d0ea855a19ccea6256a18ded29ca3604c4138d66af48811b9b8c60095e587158",
      "ko": "벗겨져 떨어진다÷흩어져 떨어진다÷무너져 내린다÷나사／톱니바퀴／태엽／배관／철골／도선／장갑――썩어가는 과일처럼, 녹아내리는 설탕과자처럼, 혼돈의 귀계신이 무너져 내린다."
    },
    {
      "id": "da1318:T00024",
      "source_sha256": "c7f307318fd1a3ff6358ed8b3823e6b30c6c63d86db9977445daf85e51ae5d2d",
      "ko": "붕괴할 때마다 귀계신은 새로운 "
    },
    {
      "id": "da1318:R00007",
      "source_sha256": "5461d30a804ce645d1361f44d672265ede0fb36d3602d183a40c5f12c2418cf1",
      "ko": "파츠를",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00025",
      "source_sha256": "c8212ffab25e892cdf92a6097c13a297be6199d50cd2b8023b049027741f729f",
      "ko": "부품을"
    },
    {
      "id": "da1318:T00026",
      "source_sha256": "616aa9996e9b78442e2f4bd8aa6f19a33e35691bd860bcb34082db508249b66d",
      "ko": " 생산한다."
    },
    {
      "id": "da1318:T00027",
      "source_sha256": "9e2fc74837362e1ca08a87b2b0a3e3dacc16422da508a305960cbccacea26e11",
      "ko": "그러나 생산되는 족족 부서지고, 벗겨지고, 무너져 내린다."
    },
    {
      "id": "da1318:T00028",
      "source_sha256": "1919b2d8c148c6c7b383bedcf304e1843afe0d500fe9ebcb11705cc4dda3187d",
      "ko": "『제조』⇔『붕괴』의, 우스꽝스럽고 "
    },
    {
      "id": "da1318:R00008",
      "source_sha256": "de6bcdc6a52a61e8b1eb29ff08aa4aa0c43c037d9392e32ea7d4d132d11129ba",
      "ko": "이디오",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00029",
      "source_sha256": "abea774c66ea2e8fb02b5dc2e0518fc318a7f44de951a2f07e52e3050bd0b21c",
      "ko": "무가치"
    },
    {
      "id": "da1318:T00030",
      "source_sha256": "30decdf4274513937a5295af56ea082925e2c003e616f76156e9dec43f9164c6",
      "ko": "한 "
    },
    {
      "id": "da1318:R00009",
      "source_sha256": "123e12195392672040b621a281ee68cd699a526aa985679701ef0657c5a9bb08",
      "ko": "론도",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00031",
      "source_sha256": "0f7ab8413356592c8d3a842ce4af64517f2dd44b455fa607b050c7f546f8527a",
      "ko": "윤회"
    },
    {
      "id": "da1318:T00032",
      "source_sha256": "eb0d5884569b398e475b89e77a068c6c575a0064ff6a72fafc173102c4cfcd57",
      "ko": "."
    },
    {
      "id": "da1318:T00033",
      "source_sha256": "a2ad43263a78c7164acb0162a9cdf2db445d18bfcfd17eeb3e08155ff859ff9b",
      "ko": "그리고 붕괴의 중심에는, 강철의 거인――클록워크 팬텀의 기체에서 솟아 나온 데몬베인 투 소드의 복제품이 있었다."
    },
    {
      "id": "da1318:T00034",
      "source_sha256": "6ea269ad792143260b025cf0b7c42a2cc3d232113128c9af014a6f22f9a488f7",
      "ko": "「너도냐…… 너도, 내 "
    },
    {
      "id": "da1318:R00010",
      "source_sha256": "d0dbb56faad5a28feaf54af49149bf429425f9f134d6d47ef179e98c8f03f36f",
      "ko": "시나리오",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00035",
      "source_sha256": "ece025dc7fa82225931dd3f1e4f772132117cd2fecaf708a053a12af58a2b7a0",
      "ko": "의도"
    },
    {
      "id": "da1318:T00036",
      "source_sha256": "5574649be3d15900141207e9bb351455668a9408b85c2d4146042c59add4e05c",
      "ko": "를\n　벗어나는 존재란 말이냐……!」"
    },
    {
      "id": "da1318:T00037",
      "source_sha256": "23e3584d11ffff8baa2123e65bdfac41d8a9b1ee406ec56c2141b3550b89ee09",
      "ko": "「너 또한……"
    },
    {
      "id": "da1318:R00011",
      "source_sha256": "01df67e1d7cdbc51809b3a90688de6c6f9f4568cf270f141f3169e5f01fee77a",
      "ko": "・・・・・・・・",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00038",
      "source_sha256": "a572a8f5fc0f58ea937f738fb6a825af59750820c59e0ae1da4850c5c81fab3b",
      "ko": "가장 새롭고 오래된 신"
    },
    {
      "id": "da1318:T00039",
      "source_sha256": "54107fb28f37c7b643dcee9ba0cf8d7c0fa66cf9a7360192ccee43129911811b",
      "ko": "의……!」"
    },
    {
      "id": "da1318:T00040",
      "source_sha256": "8544e9a879c9dac8ad41cfa9394ac8ddb0de13ceba02c83f71db26fbdcf955b6",
      "ko": "절규하는 혼돈의 목소리에는, 분노하는 듯 탄식하는 듯 증오하는 듯 질투하는 듯 갈망하는 듯한…… 그런 울림이 있었다."
    },
    {
      "id": "da1318:T00041",
      "source_sha256": "4e850bdb579a8f2468718a34202c2e6058c257fae5be84e17a1f845b397f3689",
      "ko": "「움직여라 데몬베인!!\n　나의…… "
    },
    {
      "id": "da1318:R00012",
      "source_sha256": "edcd28fa7ea44051f0257ef67461b3825ba660795cc6071fba8ea223214baa1d",
      "ko": "",
      "ruby_action": "omit_redundant"
    },
    {
      "id": "da1318:T00042",
      "source_sha256": "49849adeed075911619a4d015845b4a613e6eb1e9a59c962fa94620d25e988d2",
      "ko": "검"
    },
    {
      "id": "da1318:T00043",
      "source_sha256": "8cde765a07194cf473eb06228b148318d8768e9e3d1da391b1f2a0a58cd24de9",
      "ko": "이여어어어엇!」"
    },
    {
      "id": "da1318:T00044",
      "source_sha256": "b1606b32c63119787921767d1d37e9976ec12e7d2795668687f9db7038de6d19",
      "ko": "그리고, 혼돈이 폭발했다."
    },
    {
      "id": "da1318:T00045",
      "source_sha256": "2bbf7cc5d0719cdd447a5799f8550facc93e5d548126ae9bf9d83f0e9a86922b",
      "ko": "클록워크 팬텀의 내부에서 뿜어져 나오는 진홍의 용권,\n　혈풍이 그리는 나선.\n\n　폭풍을 타고 흩날리는 나사／톱니바퀴／태엽／배관／철골／도선／\n　장갑――강철의 나선."
    },
    {
      "id": "da1318:T00046",
      "source_sha256": "6e81477c7bc6d68030f14e6d094dd8a217048df9c3da3938c996e050d3e80409",
      "ko": "피와 강철의 나선이 서로 얽히며, 거대한 이중나선을――\n　강대한 술식을 그려낸다."
    },
    {
      "id": "da1318:T00047",
      "source_sha256": "bbec1411e07aa881caf0c77be3053c69e212511fbd38e78c9badfeb45510fe84",
      "ko": "기신이 포효했다."
    },
    {
      "id": "da1318:T00048",
      "source_sha256": "c1b83a1bc2c17ec0d999e7faa88bd7cf8f997a61b305a24ef79b18e494358876",
      "ko": "사신이 절규했다."
    },
    {
      "id": "da1318:T00049",
      "source_sha256": "4afe4f4546a34b28e94afc13d0a4e7d0a864a80c1e89f6d48766c98febb05635",
      "ko": "데몬베인 투 소드의 "
    },
    {
      "id": "da1318:R00013",
      "source_sha256": "55d01f56441afd08c9760898746a852ab97611c75cbff4597f1ef853bf921c9f",
      "ko": "하트",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00050",
      "source_sha256": "260cca3889c2a05c9c705f61df0f96b20c3a2ff9ce50c268e52da33ed4b785d0",
      "ko": "심장"
    },
    {
      "id": "da1318:T00051",
      "source_sha256": "42bfa59be839fc6de1ddcb102aaeb347acfa784fe0be62ebcc61788181a330c4",
      "ko": "에서,\n『제조』⇔『붕괴』를 반복하는 클록워크 팬텀에 녹아들어, 데몬베인 투 소드가 재생하려 하고 있다."
    },
    {
      "id": "da1318:T00052",
      "source_sha256": "36291ec0609cdeee6bbc43ec81f8aa39c83bc7c1949dd3c846e89b44f22acd60",
      "ko": "무너지는 "
    },
    {
      "id": "da1318:R00014",
      "source_sha256": "5461d30a804ce645d1361f44d672265ede0fb36d3602d183a40c5f12c2418cf1",
      "ko": "파츠를",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00053",
      "source_sha256": "c8212ffab25e892cdf92a6097c13a297be6199d50cd2b8023b049027741f729f",
      "ko": "부품을"
    },
    {
      "id": "da1318:T00054",
      "source_sha256": "1aecf1ade6cb3d0213073846274b8815810f638cbfd014cf7992b3f0e9028cf5",
      "ko": " 빼앗아, 스스로를 조립해 나간다."
    },
    {
      "id": "da1318:T00055",
      "source_sha256": "a6d5dfa68ac983f57d2167e32aad1c2d6b1e3323f3603f17f894514a3ecb408d",
      "ko": "하지만 그 존재는, "
    },
    {
      "id": "da1318:R00015",
      "source_sha256": "f6173eb5007098bec20e0d1fc8253f393e02e2c32f0c8f1242d462ad3dbe0e22",
      "ko": "베이퍼",
      "ruby_action": "keep"
    },
    {
      "id": "da1318:T00056",
      "source_sha256": "22ae617be31b3309d1be515080bbe8daaf4f3430a718957e7b11d3f6d6d0c140",
      "ko": "혈풍"
    },
    {
      "id": "da1318:T00057",
      "source_sha256": "38630d5c12e1700059a941e0e743f5d4b2af63c66f379ec73103d9c0ae02297d",
      "ko": "／"
    },
